# Hermes's gateway, running as the mind account (#411).
#
# Hermes used to run as the person, from its own `systemctl --user` unit, so its shell, its file
# tools and anything a prompt talked it into could read the person's files and keys with no approval
# card. As `yantrik-mind` it cannot open the person's home or runtime directory, and it reaches the
# desktop only at the mind door (/run/yantrik-minds), where every act is held to the shell's grades
# and approvals. It is the second tenant of the mind account, after yantrik-mind.service, and the
# template for the rest (Pi, OpenClaw, DeepSeek): a harness `<name>` gets /var/lib/yantrik-mind/harness/<name>
# as its HOME, a unit like this one, and `yantrik-update harness install <name>`
# (deploy/yantrik-os/harness-isolation.sh). A new harness copies THIS unit, sandbox block and checks included
# (and every `+` line starts with /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin: see the first ExecStartPre=).
#
# What keeps it apart from the Mind, which shares its uid: two namespaces, together.
#   - the mount namespace hides the Mind's files (TemporaryFileSystem on /var/lib/yantrik-mind, only
#     harness/hermes bound back in);
#   - the PID namespace (PrivatePIDs=yes, systemd 257) closes /proc/<pid>/root, /fd and /environ of
#     the Mind's processes, which walk into the Mind's mount namespace and open files it holds.
#     Without it the first is no separation at all (measured on staging).
# The same line is on yantrik-mind.service, so it holds the other way too. This unit is refused a
# start unless that is so, as loaded and as running (the ExecStartPre= below), because a rollback to
# a build from before this release brings back a Mind unit that does neither.
#
# The sandbox block is the single list of properties for this unit AND for everything else that
# runs as the account with code the account can write (the installer, the plugin refresh, `hermes
# model`): harness-isolation.sh passes the same lines to `systemd-run`, so none of them runs
# outside it.
#
# Installed by yantrik-update (hash-checked, root's) with the other mind units. Enabled by
# `yantrik-update harness install hermes` (the Install button) or `migrate-harnesses` (a machine
# whose Hermes still lives in a person's home), once Hermes is set up under the mind account and
# has been seen to attach and to pass its proofs.
[Unit]
Description=Hermes gateway, attached to the desktop as the mind account
# The same kernel-held way out as the Mind (see yantrik-mind.service): the table holds the whole
# account to the proxy, so Hermes's HTTP clients and anything it runs are counted and, once the
# person turns it to enforce, held to their policy. Those counts, and that policy, are the
# ACCOUNT's, not the Mind's: a rule the person adds for one opens it for the other. Required, not
# wanted: no harness runs unguarded.
After=network-online.target yantrik-egress.service yantrik-mind-egress.service
Wants=network-online.target yantrik-egress.service
Requires=yantrik-mind-egress.service
# Not in the installer's live session, and not before Hermes is set up (the installer made this file).
ConditionKernelCommandLine=!yantrik.install=true
ConditionPathExists=/var/lib/yantrik-mind/harness/hermes/.hermes/config.yaml
# A start that keeps failing stops being retried after five in a minute.
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=yantrik-mind
Group=yantrik-minds
WorkingDirectory=/var/lib/yantrik-mind/harness/hermes
# EVERY `+` line below runs as root, outside the sandbox, and inherits this unit's Environment=PATH,
# whose first entry is the account's own ~/.local/bin. So each starts `/usr/bin/env -i PATH=<root's
# directories>`: it looks commands up only in root-owned places, reads no env var the account could
# set, and uses absolute paths for the rest (harness-scope-selftest.sh fails any `+` line that does
# not, and plants a command in ~/.local/bin to prove it). A new `+` line copies this.
# Never without the table that holds the account to the proxy: a hand `nft flush ruleset` leaves the
# unit above active and the table gone.
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /bin/sh -c '/usr/sbin/nft list table inet yantrik_mind_egress >/dev/null 2>&1 || { echo "Hermes: the egress table (inet yantrik_mind_egress) is not loaded. Run: sudo yantrik-update mind-egress apply" >&2; exit 1; }'
# Fail closed: a systemd older than 257 would ignore PrivatePIDs= below and run this unit with the
# Mind's processes readable through /proc. Refuse to start instead.
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /bin/sh -c 'v=$$(systemctl --version | head -n 1 | cut -d" " -f2); [ "$${v:-0}" -ge 257 ] || { echo "Hermes: systemd $${v:-?} has no PrivatePIDs=, so it is not started (needs 257)" >&2; exit 1; }'
# BindPaths= follows a link: refuse a home that is one, or is not the account's own plain directory.
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /bin/sh -c 'h=/var/lib/yantrik-mind/harness/hermes; [ -d "$$h" ] && [ ! -L "$$h" ] && [ ! -L /var/lib/yantrik-mind/harness ] && [ "$$(stat -c %%U "$$h")" = yantrik-mind ] || { echo "Hermes: $$h is not the account own plain directory; not started" >&2; exit 1; }'
# Hermes is not started beside a Mind that can reach it: the Mind's unit as loaded must mask
# harness/ and have PrivatePIDs, its live main process (if any) must be in a PID namespace of its own
# (not PID 1's), and this unit must have no drop-in. A rollback below this release brings back a
# Mind unit that has neither, and then Hermes's keys at rest are readable by it whatever this unit
# does, so this unit refuses to start (and the updater stops a running one at the next reconcile).
ExecStartPre=+/usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin /bin/sh -c 'u=yantrik-mind.service; { systemctl show -p InaccessiblePaths --value $$u | grep -q /var/lib/yantrik-mind/harness && [ "$$(systemctl show -p PrivatePIDs --value $$u)" = yes ]; } || { echo "Hermes: the Mind unit does not mask harness/ and have its own PID namespace (as a build from before this release does); not started" >&2; exit 1; }; p=$$(systemctl show -p MainPID --value $$u); if [ "$${p:-0}" != 0 ]; then a=$$(readlink /proc/$$p/ns/pid); b=$$(readlink /proc/1/ns/pid); { [ -n "$$a" ] && [ -n "$$b" ] && [ "$$a" != "$$b" ]; } || { echo "Hermes: the running Mind shares PID 1 namespace, or its namespace cannot be read; not started" >&2; exit 1; }; fi; [ -z "$$(systemctl show -p DropInPaths --value hermes-gateway.service)" ] || { echo "Hermes: this unit has a drop-in; not started" >&2; exit 1; }'
# The toolset allowlist is put right before Hermes reads its config (Hermes can rewrite its own file,
# and `hermes model` / `hermes update` do): as the account, in this unit's sandbox. Not started if it
# cannot be (hermes-guard.sh start). Under the same abstract-socket scope as ExecStart: it runs
# Hermes's own Python, which the account can replace, and an unscoped one would reach the person's
# Xwayland and could leave a process behind in the unit's cgroup.
ExecStartPre=/opt/yantrik/bin/yantrik-init --scope-abstract-unix /bin/sh /opt/yantrik/share/harnesses/lib/install/hermes-guard.sh start
# The launcher, not a Python path: a newer Hermes rebuilds its venv as a new generation on an update.
# Under yantrik-init, which is PID 1 of this unit's namespace and reaps what Hermes's tools orphan
# (otherwise they stay zombies, and Hermes warns about it on every start), passes SIGTERM and
# SIGUSR1 on to Hermes, and ends with it.
ExecStart=/opt/yantrik/bin/yantrik-init --scope-abstract-unix /var/lib/yantrik-mind/harness/hermes/.local/bin/hermes gateway run --replace
StandardInput=null
Restart=always
RestartSec=5
# Hermes asks to be restarted with 75 (gateway/restart.py).
RestartForceExitStatus=75
# A reload is Hermes's drain-aware restart (what its own user unit does): SIGUSR1, which yantrik-init
# passes on. The gateway refuses new turns, finishes the running ones within its own cap, and exits 75
# (RestartForceExitStatus) to be started again. The updater uses it to hand Hermes a new bridge (#1102).
ExecReload=/bin/kill -USR1 $MAINPID
KillMode=mixed
KillSignal=SIGTERM
# A stop is SIGTERM to the main process, then the kill after TimeoutStopSec. Hermes handles SIGTERM
# and drains on its own (gateway/restart.py): agent.restart_drain_timeout is how long it lets running
# turns finish, and agent.cron_drain_timeout how long it lets a scheduled job finish. Its default for
# the first is 0 (interrupt at once), so hermes_config.py sets 60 and 50, and this timeout is what
# Hermes's own resolve_systemd_timeout_stop_sec(60, 50) gives: max(60, max(60, 50 + 10) + 30) = 90,
# the drain plus Hermes's 30 s headroom for what it does after (interrupt, kill children, disconnect).
# A turn still running when the drain ends is interrupted by Hermes, which tells the person and marks
# the session to resume (its own comment in gateway/restart.py). Measured on the VM (systemd 257.13,
# a test unit with this PID namespace and a SIGTERM handler that took 3 s): the handler ran and the
# stop took 3.04 s, so a stop under PrivatePIDs does wait for a handler.
TimeoutStopSec=90

# sandbox:begin
# Hermes keeps its model, keys, sessions and memory in ~/.hermes, as it always has: now in the mind
# account's home for it, where only that account (and root) can read them. Its API keys are read by
# Hermes itself from ~/.hermes/.env; no EnvironmentFile (systemd would read it as root through a
# link the account controls), nothing on a command line, nothing in the journal.
Environment=HOME=/var/lib/yantrik-mind/harness/hermes
# Named, so that what Hermes records of itself (gateway_state.json) is this path and never one it
# read out of a file copied from a person's home.
Environment=HERMES_HOME=/var/lib/yantrik-mind/harness/hermes/.hermes
Environment=USER=yantrik-mind LOGNAME=yantrik-mind
Environment=PATH=/var/lib/yantrik-mind/harness/hermes/.local/bin:/usr/local/bin:/usr/bin:/bin
# The door: the harness socket the gateway attaches at, and where `yos` and the desktop's tools
# (yos-mcp, which Hermes starts with this passed on in its config) find the desktop.
Environment=YANTRIK_MIND_RUN=/run/yantrik-minds
# Out through the egress proxy, both spellings (curl reads only the lowercase http one). Loopback
# goes direct.
Environment=HTTPS_PROXY=http://127.0.0.1:7450 https_proxy=http://127.0.0.1:7450
Environment=HTTP_PROXY=http://127.0.0.1:7450 http_proxy=http://127.0.0.1:7450
Environment=ALL_PROXY=http://127.0.0.1:7450 all_proxy=http://127.0.0.1:7450
Environment=NO_PROXY=127.0.0.1,localhost,::1 no_proxy=127.0.0.1,localhost,::1
NoNewPrivileges=yes
ProtectSystem=strict
# The mount namespace's half: the account's home also holds the Mind's memory, settings and keys, so
# it is hidden from this unit except for Hermes's own directory, bound back in.
TemporaryFileSystem=/var/lib/yantrik-mind:ro
BindPaths=/var/lib/yantrik-mind/harness/hermes
ReadWritePaths=/var/lib/yantrik-mind/harness/hermes
ProtectHome=yes
# The desktop's own log, memory and settings are the person's, not a harness's.
InaccessiblePaths=-/opt/yantrik/logs -/opt/yantrik/data -/opt/yantrik/config.yaml
PrivateTmp=yes
PrivateDevices=yes
# /dev/shm stays the host's even with PrivateDevices, and one uid can read the other unit's segments in
# it: a private tmpfs here.
# Abstract AF_UNIX sockets are shared too (no network namespace of its own), and the person's
# Xwayland listens on one, which no file property hides. yantrik-init --scope-abstract-unix puts
# Hermes and everything it runs in a Landlock domain that is refused a connect to an abstract socket
# made outside it (kernel 6.12); on a kernel without that, nothing is started.
TemporaryFileSystem=/dev/shm:mode=1777
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
UMask=0077
# The PID namespace's half, and the one that makes the line above worth anything: the Mind's
# processes (same uid) are not here to open through /proc/<pid>/root, /fd or /environ, or to
# signal. The main process is PID 1 of its namespace. The journal prints "Supervising process ...
# which is not our child" at each start (seen on staging and on the VM); the stop measurement above
# is what to go by for how it ends. Its tool children are reaped by yantrik-init (the selftest runs it
# in a PID namespace against an orphan and a PID 1 that does not reap); on the machine that is for the
# gate to see.
PrivatePIDs=yes
ProtectProc=invisible
ProcSubset=pid
PrivateIPC=yes
SystemCallArchitectures=native
# sandbox:end

[Install]
WantedBy=multi-user.target
