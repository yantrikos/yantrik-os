<?xml version="1.0"?>
<!--
  Yantrik — compositor configuration.

  This file did not exist. labwc ran on its stock defaults under an OS that ships its own
  typeface, its own palette and sixteen apps built against both, which is why every window wore a
  light title bar in a font the rest of the system never uses.

  Installed to /etc/xdg/labwc/rc.xml so it applies to the session whoever is logged in, and the
  theme it names lives at /usr/share/themes/Yantrik/labwc/themerc.
-->
<labwc_config>
  <theme>
    <name>Yantrik</name>
    <!-- Matches the corner radius the app windows and cards already use. -->
    <cornerRadius>10</cornerRadius>
    <dropShadows>yes</dropShadows>

    <!--
      Barlow is the house UI typeface, embedded in every app binary. The compositor cannot read a
      font out of a binary, so the deploy also installs the same TTFs into
      /usr/share/fonts/truetype/yantrik — otherwise this silently falls back to DejaVu and the
      title bar goes on looking like someone else's software.
    -->
    <font place="ActiveWindow">
      <name>Barlow</name>
      <size>10</size>
      <weight>medium</weight>
    </font>
    <font place="InactiveWindow">
      <name>Barlow</name>
      <size>10</size>
    </font>
    <font place="MenuItem">
      <name>Barlow</name>
      <size>10</size>
    </font>
    <font place="OnScreenDisplay">
      <name>Barlow</name>
      <size>10</size>
    </font>
  </theme>

  <!--
    Keep the shell's own furniture visible.

    The status bar and the dock are drawn by yantrik-ui, which is one ordinary fullscreen window
    rather than a wlr-layer-shell panel. So the compositor had no idea they were there: any app
    opening at a decent size was placed straight over them, and the dock simply vanished the
    moment you opened anything — with no way back to it, because the way back was the dock.

    labwc documents <margin> for exactly this case ("a workaround for clients such as panels that
    do NOT support the wlr-layer-shell protocol"). New, maximized and tiled windows keep out of
    these strips. The numbers are the real heights: Theme.status-bar-height is 32px
    (crates/yantrik-design-tokens/slint/theme.slint) and the taskbar is 40px
    (crates/yantrik-ui-slint/ui/components/taskbar.slint). If either changes, change these.

    The proper fix is for the panel to speak layer-shell and declare its own exclusive zone; this
    is the honest workaround until it does, and it is the one labwc recommends.
  -->
  <margin top="32" bottom="40" left="0" right="0" />

  <!-- Focus follows the click, not the pointer: an agent moving the pointer must not change
       which window receives what the person types next. -->
  <focus>
    <followMouse>no</followMouse>
  </focus>

  <!--
    ══ Keyboard ══════════════════════════════════════════════════════════════════════════

    There were none. Not "a short list" — the compositor had zero keybindings, so this desktop
    had no Alt+Tab, no way to close a window from the keyboard, no snapping, no lock, no
    screenshot key and no volume keys. Every one of those is something a person reaches for
    without thinking on Windows, macOS and Ubuntu alike, and finding nothing happens is the
    moment a desktop stops feeling like one.

    The bindings below are the ones those three agree on, using each platform's spelling where
    they differ and preferring the Windows/GNOME one where this OS has a Super key to spend:

      Alt+Tab            cycle windows            (all three)
      Alt+F4             close                    (Windows, GNOME)
      Super+Left/Right   snap to half             (Windows Aero Snap, GNOME)
      Super+Up/Down      maximize / restore       (Windows, GNOME)
      Super+D            show desktop, then back  (Windows)
      Super+E            files                    (Windows Explorer)
      Super+L            lock                     (Windows, GNOME)
      Ctrl+Alt+T         terminal                 (Ubuntu)
      Print              whole screen             (all three)
      Super+Shift+S      region                   (Windows Snip)

    Where labwc has no action of its own — opening the launcher, the lens, locking — the
    binding calls `yos`, the OS's own control surface. That is the same path an agent uses, so
    a key and an instruction reach the shell the same way rather than through two mechanisms
    that have to be kept in step.
  -->
  <keyboard>
    <!-- ── Windows ────────────────────────────────────────────────────────────────────── -->
    <keybind key="A-Tab">
      <action name="NextWindow" />
    </keybind>
    <keybind key="A-S-Tab">
      <action name="PreviousWindow" />
    </keybind>
    <keybind key="A-F4">
      <action name="Close" />
    </keybind>
    <keybind key="W-Up">
      <action name="ToggleMaximize" />
    </keybind>
    <keybind key="W-Down">
      <action name="Iconify" />
    </keybind>
    <keybind key="W-Left">
      <action name="SnapToEdge" direction="left" />
    </keybind>
    <keybind key="W-Right">
      <action name="SnapToEdge" direction="right" />
    </keybind>
    <keybind key="F11">
      <action name="ToggleFullscreen" />
    </keybind>

    <!--
      ── Snap layouts ─────────────────────────────────────────────────────────────────────
      Halves, quarters, thirds and two-thirds, so "left half full, right side split in two" is
      three keys. Super+Alt and a letter, with the letters Rectangle (macOS) made familiar:
      U I J K are the four corners as they sit on the keyboard, D F G the three thirds left to
      right, E and T the two-thirds, C the middle. Super+Alt so nothing an app binds is taken.
      The same layouts are on every window's menu (menu.xml, "Snap") and dragging a window with
      Super held shows them all. The regions are named in <regions> at the end of this file.
    -->
    <keybind key="W-A-Left">
      <action name="SnapToRegion" region="left-half" />
    </keybind>
    <keybind key="W-A-Right">
      <action name="SnapToRegion" region="right-half" />
    </keybind>
    <keybind key="W-A-Up">
      <action name="SnapToRegion" region="top-half" />
    </keybind>
    <keybind key="W-A-Down">
      <action name="SnapToRegion" region="bottom-half" />
    </keybind>
    <keybind key="W-A-u">
      <action name="SnapToRegion" region="top-left" />
    </keybind>
    <keybind key="W-A-i">
      <action name="SnapToRegion" region="top-right" />
    </keybind>
    <keybind key="W-A-j">
      <action name="SnapToRegion" region="bottom-left" />
    </keybind>
    <keybind key="W-A-k">
      <action name="SnapToRegion" region="bottom-right" />
    </keybind>
    <keybind key="W-A-d">
      <action name="SnapToRegion" region="left-third" />
    </keybind>
    <keybind key="W-A-f">
      <action name="SnapToRegion" region="center-third" />
    </keybind>
    <keybind key="W-A-g">
      <action name="SnapToRegion" region="right-third" />
    </keybind>
    <keybind key="W-A-e">
      <action name="SnapToRegion" region="left-two-thirds" />
    </keybind>
    <keybind key="W-A-t">
      <action name="SnapToRegion" region="right-two-thirds" />
    </keybind>
    <keybind key="W-A-c">
      <action name="SnapToRegion" region="center" />
    </keybind>
    <keybind key="W-A-Return">
      <action name="ToggleMaximize" />
    </keybind>

    <!-- ── The shell, through its own control surface ──────────────────────────────────── -->
    <keybind key="W-l">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell lock</command>
      </action>
    </keybind>
    <keybind key="W-e">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell show_screen screen=files</command>
      </action>
    </keybind>
    <keybind key="W-i">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell show_screen screen=settings</command>
      </action>
    </keybind>
    <keybind key="W-d">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell show_desktop</command>
      </action>
    </keybind>
    <keybind key="C-A-t">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell open_app name=terminal</command>
      </action>
    </keybind>

    <!--
      The ask bar, from anywhere.

      The shell handles Ctrl+K itself (app.slint, `global-keys`), but that only works while the
      shell window has the keyboard. labwc gives the keyboard to the focused toplevel, so with
      Notes or a terminal in front, Ctrl+K is that app's key and the shell never sees it. A
      compositor binding is the only thing that works from inside another window, and it is the
      one the desktop advertises: the ask bar hints say "Super K", and a test at the end of
      yantrik-ui's lens.rs fails if this binding and those hints ever name different keys.

      Super+K rather than Ctrl+K, deliberately. A compositor binding is a global grab: binding
      Ctrl+K here would take it away from every application on the machine for good, and Ctrl+K
      is kill-to-end-of-line in a shell and a real shortcut in most editors. Super is the key
      this desktop reserves for itself — the same reason Super+E and Super+L are here — so this
      adds a way in without taking one away.
    -->
    <keybind key="W-k">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell open_lens</command>
      </action>
    </keybind>

    <!-- ── Screenshots ────────────────────────────────────────────────────────────────── -->
    <!--
      Into ~/Pictures with a sortable name, which is what every desktop does. `slurp` draws the
      region selector; without it the second binding does nothing, so it ships in the package
      set beside grim rather than being assumed.
    -->
    <keybind key="Print">
      <action name="Execute">
        <command>sh -c 'mkdir -p ~/Pictures &amp;&amp; grim ~/Pictures/Screenshot-$(date +%Y%m%d-%H%M%S).png'</command>
      </action>
    </keybind>
    <keybind key="W-S-s">
      <action name="Execute">
        <command>sh -c 'mkdir -p ~/Pictures &amp;&amp; grim -g "$(slurp)" ~/Pictures/Screenshot-$(date +%Y%m%d-%H%M%S).png'</command>
      </action>
    </keybind>

    <!-- ── Media and hardware keys ────────────────────────────────────────────────────── -->
    <keybind key="XF86AudioRaiseVolume">
      <action name="Execute">
        <command>wpctl set-volume -l 1.0 @DEFAULT_AUDIO_SINK@ 5%+</command>
      </action>
    </keybind>
    <keybind key="XF86AudioLowerVolume">
      <action name="Execute">
        <command>wpctl set-volume @DEFAULT_AUDIO_SINK@ 5%-</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle</command>
      </action>
    </keybind>
    <keybind key="XF86AudioMicMute">
      <action name="Execute">
        <command>wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessUp">
      <action name="Execute">
        <command>brightnessctl set 5%+</command>
      </action>
    </keybind>
    <keybind key="XF86MonBrightnessDown">
      <action name="Execute">
        <command>brightnessctl set 5%-</command>
      </action>
    </keybind>

    <!-- ── Workspaces (#402) ──────────────────────────────────────────────────────────── -->
    <!--
      Four, as a keyboard-driven desktop has them: Super+1…4 goes to one, Super+Shift+1…4 sends
      the focused window there and stays, Super+Ctrl+Left/Right steps between them. The shell's
      own window — desktop, taskbar, status bar — is on every one (the windowRule below), so a
      workspace holds apps, never a desktop without its taskbar.
    -->
    <keybind key="W-1">
      <action name="GoToDesktop" to="1" />
    </keybind>
    <keybind key="W-S-1">
      <action name="SendToDesktop" to="1" follow="no" />
    </keybind>
    <keybind key="W-2">
      <action name="GoToDesktop" to="2" />
    </keybind>
    <keybind key="W-S-2">
      <action name="SendToDesktop" to="2" follow="no" />
    </keybind>
    <keybind key="W-3">
      <action name="GoToDesktop" to="3" />
    </keybind>
    <keybind key="W-S-3">
      <action name="SendToDesktop" to="3" follow="no" />
    </keybind>
    <keybind key="W-4">
      <action name="GoToDesktop" to="4" />
    </keybind>
    <keybind key="W-S-4">
      <action name="SendToDesktop" to="4" follow="no" />
    </keybind>
    <keybind key="W-C-Left">
      <action name="GoToDesktop" to="left" wrap="yes" />
    </keybind>
    <keybind key="W-C-Right">
      <action name="GoToDesktop" to="right" wrap="yes" />
    </keybind>

    <!--
      The launcher from anywhere (#402). Like Super+K, a compositor binding, so it works with
      another app in front; the shell's own keys only work while its window has the keyboard.
    -->
    <keybind key="W-space">
      <action name="Execute">
        <command>/opt/yantrik/bin/yos act shell show_screen screen=launchpad</command>
      </action>
    </keybind>
  </keyboard>

  <!--
    Dragging a window to a screen edge snaps it: left or right to that half, the top to fill the
    screen, with the outline shown first. labwc's default range is 1px, which a person almost
    never hits with a moving pointer; 12 is what makes the edge feel like it pulls.
  -->
  <snapping>
    <range>12</range>
    <overlay>
      <enabled>yes</enabled>
      <delay>
        <inner>350</inner>
        <outer>350</outer>
      </delay>
    </overlay>
    <topMaximize>yes</topMaximize>
    <notifyClient>always</notifyClient>
  </snapping>

  <!--
    The snap layouts, in percent of the usable screen (inside the margins above, so never over
    the status bar or the taskbar). Named for the keys above and the window menu's "Snap"; drag
    a window with Super held and the one under the pointer lights up. A test in yantrik-ui
    (snap_layouts) fails if a key or a menu row names a region that is not here.
  -->
  <regions>
    <region name="left-half" x="0%" y="0%" width="50%" height="100%" />
    <region name="right-half" x="50%" y="0%" width="50%" height="100%" />
    <region name="top-half" x="0%" y="0%" width="100%" height="50%" />
    <region name="bottom-half" x="0%" y="50%" width="100%" height="50%" />
    <region name="top-left" x="0%" y="0%" width="50%" height="50%" />
    <region name="top-right" x="50%" y="0%" width="50%" height="50%" />
    <region name="bottom-left" x="0%" y="50%" width="50%" height="50%" />
    <region name="bottom-right" x="50%" y="50%" width="50%" height="50%" />
    <region name="left-third" x="0%" y="0%" width="33%" height="100%" />
    <region name="center-third" x="33%" y="0%" width="34%" height="100%" />
    <region name="right-third" x="67%" y="0%" width="33%" height="100%" />
    <region name="left-two-thirds" x="0%" y="0%" width="67%" height="100%" />
    <region name="right-two-thirds" x="33%" y="0%" width="67%" height="100%" />
    <region name="center" x="15%" y="5%" width="70%" height="90%" />
  </regions>

  <desktops>
    <number>4</number>
    <popupTime>600</popupTime>
  </desktops>

  <windowRules>
    <!-- The shell is the desktop itself: present on every workspace, never switched away from. -->
    <windowRule title="Yantrik OS">
      <action name="ToggleOmnipresent" />
    </windowRule>
  </windowRules>
</labwc_config>
