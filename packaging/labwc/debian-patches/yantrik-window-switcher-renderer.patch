--- labwc-0.8.3.orig/src/window-switcher-renderer.c
+++ labwc-0.8.3/src/window-switcher-renderer.c
@@ -0,0 +1,798 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * An external client that draws the window switcher session.
+ *
+ * labwc keeps the session: the chord, the order, the selection and the
+ * commit on modifier release all stay in osd.c and keyboard.c. The renderer
+ * is told the session and may only ask to move the selection. labwc launches
+ * the renderer itself on a pre-connected socket (WAYLAND_SOCKET) and offers
+ * the global to that wl_client only, so no other client can bind it, whatever
+ * its pid or name. The renderer acks a session once it has drawn it; if it has
+ * not within ACK_TIMEOUT_MS, or is gone, labwc draws its own OSD for that
+ * session. A session over before the renderer draws (a quick Alt+Tab) shows
+ * nothing at all.
+ *
+ * From version 2 the renderer may ask for a picture of a listed window
+ * (capture). labwc renders the window's own scene subtree into an offscreen
+ * buffer, as upstream labwc's thumbnail switcher does (src/cycle/
+ * osd-thumbnail.c, render_thumb), reads it back and hands it over in a sealed
+ * memory file. Only the renderer labwc launched can ask, only for windows in
+ * the session's list, at most CAPTURES_PER_SECOND a second.
+ */
+#define _GNU_SOURCE
+#include <assert.h>
+#include <drm_fourcc.h>
+#include <fcntl.h>
+#include <math.h>
+#include <glib.h>
+#include <signal.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/mman.h>
+#include <sys/socket.h>
+#include <time.h>
+#include <unistd.h>
+#include <wayland-server-core.h>
+#include <wlr/render/allocator.h>
+#include <wlr/render/swapchain.h>
+#include <wlr/render/wlr_renderer.h>
+#include <wlr/render/wlr_texture.h>
+#include <wlr/types/wlr_buffer.h>
+#include <wlr/types/wlr_output.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/util/log.h>
+#include "common/array.h"
+#include "common/fd-util.h"
+#include "common/mem.h"
+#include "config/rcxml.h"
+#include "labwc.h"
+#include "session-lock.h"
+#include "osd.h"
+#include "view.h"
+#include "workspaces.h"
+#include "window-switcher-renderer.h"
+#include "labwc-window-switcher-renderer-unstable-v1-protocol.h"
+
+#define RENDERER_VERSION 2
+#define ACK_TIMEOUT_MS 300
+#define RESPAWN_MIN_MS 5000
+#define TEXT_MAX 512
+#define THUMB_MIN 16
+#define THUMB_MAX 1024
+#define CAPTURES_PER_SECOND 15
+#define SWITCHER_REPEAT_MS 700
+
+struct switcher_renderer {
+	struct server *server;
+	struct wl_global *global;
+	struct wl_client *client;
+	struct wl_listener client_destroy;
+	struct wl_resource *resource;
+	struct wl_event_source *ack_timer;
+	struct wl_event_source *respawn_timer;
+	uint64_t last_spawn_ms;
+	uint32_t session;
+	uint32_t next_view_id;
+	struct view *focused_at_start;
+	struct wl_array sent; /* struct view *: the list as last sent this session */
+	bool active;
+	bool acked;
+	bool fallback;
+	bool committing;
+	uint64_t capture_window_ms; /* the second the captures below are counted in */
+	int captures_in_window;
+};
+
+static uint64_t
+now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+/* Fall back to labwc's own OSD for the current session */
+static void
+fall_back(struct switcher_renderer *r)
+{
+	if (!r->active || r->fallback) {
+		return;
+	}
+	r->fallback = true;
+	wl_event_source_timer_update(r->ack_timer, 0);
+	if (r->server->input_mode == LAB_INPUT_STATE_WINDOW_SWITCHER
+			&& r->server->osd_state.cycle_view) {
+		osd_update(r->server);
+	}
+}
+
+static int
+handle_ack_timeout(void *data)
+{
+	struct switcher_renderer *r = data;
+	if (r->active && !r->acked) {
+		wlr_log(WLR_INFO, "window switcher renderer did not acknowledge "
+			"session %u in %d ms; drawing the OSD", r->session, ACK_TIMEOUT_MS);
+		fall_back(r);
+	}
+	return 0;
+}
+
+static void spawn(struct switcher_renderer *r);
+
+static int
+handle_respawn(void *data)
+{
+	spawn(data);
+	return 0;
+}
+
+static void
+handle_client_destroy(struct wl_listener *listener, void *data)
+{
+	struct switcher_renderer *r = wl_container_of(listener, r, client_destroy);
+	wl_list_remove(&r->client_destroy.link);
+	r->client = NULL;
+	r->resource = NULL;
+	fall_back(r);
+	/*
+	 * Launched again now, not at the next session: a session that finds no renderer is
+	 * drawn as labwc's OSD, so waiting for one made the first Alt+Tab after a crash (or an
+	 * update) the old list. At most once per RESPAWN_MIN_MS, so one that keeps dying
+	 * cannot keep labwc forking.
+	 */
+	uint64_t t = now_ms();
+	uint64_t since = r->last_spawn_ms ? t - r->last_spawn_ms : RESPAWN_MIN_MS;
+	int wait = since >= RESPAWN_MIN_MS ? 1 : (int)(RESPAWN_MIN_MS - since) + 10;
+	wl_event_source_timer_update(r->respawn_timer, wait);
+}
+
+extern char **environ;
+
+/*
+ * The environment for the renderer: labwc's own plus WAYLAND_SOCKET, built before fork so the
+ * child only closes, resets and execs (no allocation between fork and exec: another thread may
+ * hold the malloc lock at fork time).
+ */
+static char **
+renderer_env(int fd)
+{
+	size_t n = 0;
+	while (environ[n]) {
+		n++;
+	}
+	char **envp = calloc(n + 2, sizeof(char *));
+	if (!envp) {
+		return NULL;
+	}
+	size_t j = 0;
+	for (size_t i = 0; i < n; i++) {
+		if (strncmp(environ[i], "WAYLAND_SOCKET=", 15)) {
+			envp[j++] = environ[i];
+		}
+	}
+	char *ours = NULL;
+	if (asprintf(&ours, "WAYLAND_SOCKET=%d", fd) < 0) {
+		free(envp);
+		return NULL;
+	}
+	envp[j++] = ours;
+	envp[j] = NULL;
+	return envp;
+}
+
+static void
+free_renderer_env(char **envp)
+{
+	if (!envp) {
+		return;
+	}
+	for (size_t i = 0; envp[i]; i++) {
+		if (!strncmp(envp[i], "WAYLAND_SOCKET=", 15)) {
+			free(envp[i]);
+		}
+	}
+	free(envp);
+}
+
+static void
+spawn(struct switcher_renderer *r)
+{
+	const char *command = rc.window_switcher.renderer;
+	if (!command || !*command || r->client) {
+		return;
+	}
+	uint64_t t = now_ms();
+	if (r->last_spawn_ms && t - r->last_spawn_ms < RESPAWN_MIN_MS) {
+		return;
+	}
+	r->last_spawn_ms = t;
+
+	GError *err = NULL;
+	gchar **argv = NULL;
+	if (!g_shell_parse_argv(command, NULL, &argv, &err)) {
+		wlr_log(WLR_ERROR, "window switcher renderer: %s", err->message);
+		g_error_free(err);
+		return;
+	}
+	int sv[2];
+	if (socketpair(AF_UNIX, SOCK_STREAM | SOCK_CLOEXEC, 0, sv) < 0) {
+		wlr_log_errno(WLR_ERROR, "window switcher renderer: socketpair");
+		g_strfreev(argv);
+		return;
+	}
+	/*
+	 * The renderer's end crosses exec: it is the only fd made inheritable here. labwc
+	 * spawns from the event loop, one at a time, and closes it right after fork.
+	 */
+	char **envp = renderer_env(sv[1]);
+	if (!envp || fcntl(sv[1], F_SETFD, 0) < 0) {
+		wlr_log(WLR_ERROR, "window switcher renderer: could not prepare its environment");
+		free_renderer_env(envp);
+		close(sv[0]);
+		close(sv[1]);
+		g_strfreev(argv);
+		return;
+	}
+	pid_t pid = fork();
+	if (pid < 0) {
+		wlr_log_errno(WLR_ERROR, "window switcher renderer: fork");
+		free_renderer_env(envp);
+		close(sv[0]);
+		close(sv[1]);
+		g_strfreev(argv);
+		return;
+	}
+	if (pid == 0) {
+		/* As labwc's own spawn helpers: limits, signals, its own session */
+		restore_nofile_limit();
+		sigset_t set;
+		sigemptyset(&set);
+		sigprocmask(SIG_SETMASK, &set, NULL);
+		signal(SIGPIPE, SIG_DFL);
+		setsid();
+		execvpe(argv[0], argv, envp);
+		_exit(127);
+	}
+	close(sv[1]);
+	free_renderer_env(envp);
+	g_strfreev(argv);
+
+	r->client = wl_client_create(r->server->wl_display, sv[0]);
+	if (!r->client) {
+		wlr_log(WLR_ERROR, "window switcher renderer: wl_client_create failed");
+		close(sv[0]);
+		kill(pid, SIGTERM);
+		return;
+	}
+	r->client_destroy.notify = handle_client_destroy;
+	wl_client_add_destroy_listener(r->client, &r->client_destroy);
+	wlr_log(WLR_INFO, "window switcher renderer started (pid %d)", (int)pid);
+}
+
+static struct view *
+find_view(struct switcher_renderer *r, uint32_t id)
+{
+	struct view *view;
+	wl_list_for_each(view, &r->server->views, link) {
+		if (view->switcher_id == id) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+static void
+handle_ack(struct wl_client *client, struct wl_resource *resource, uint32_t session)
+{
+	struct switcher_renderer *r = wl_resource_get_user_data(resource);
+	if (!r || !r->active || session != r->session || r->fallback) {
+		return;
+	}
+	r->acked = true;
+	wl_event_source_timer_update(r->ack_timer, 0);
+}
+
+/* The window with this id, if it is in the current session's own list; else NULL */
+static struct view *
+listed_view(struct switcher_renderer *r, uint32_t session, uint32_t id)
+{
+	/* Never a window behind a lock (a lock also ends the session: session-lock.c) */
+	if (!r->active || session != r->session || id == 0
+			|| r->server->input_mode != LAB_INPUT_STATE_WINDOW_SWITCHER
+			|| r->server->session_lock_manager->locked) {
+		return NULL;
+	}
+	struct view *target = find_view(r, id);
+	if (!target) {
+		return NULL;
+	}
+	struct wl_array views;
+	wl_array_init(&views);
+	view_array_append(r->server, &views, rc.window_switcher.criteria);
+	bool listed = false;
+	struct view **v;
+	wl_array_for_each(v, &views) {
+		if (*v == target) {
+			listed = true;
+			break;
+		}
+	}
+	wl_array_release(&views);
+	return listed ? target : NULL;
+}
+
+static void
+handle_select(struct wl_client *client, struct wl_resource *resource,
+		uint32_t session, uint32_t id)
+{
+	struct switcher_renderer *r = wl_resource_get_user_data(resource);
+	if (!r) {
+		return;
+	}
+	/* Only a window in the session's own list may be selected */
+	struct view *target = listed_view(r, session, id);
+	if (!target) {
+		return;
+	}
+	r->server->osd_state.cycle_view = target;
+	osd_update(r->server);
+}
+
+/*
+ * One scene node and what is under it, into the pass: surfaces' textures at their place,
+ * scaled by `scale`. Rects are the compositor's own decoration and are left out.
+ */
+static void
+render_node(struct wlr_render_pass *pass, struct wlr_scene_node *node, int x, int y, double scale)
+{
+	if (!node->enabled) {
+		return;
+	}
+	x += node->x;
+	y += node->y;
+	switch (node->type) {
+	case WLR_SCENE_NODE_TREE: {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		struct wlr_scene_node *child;
+		wl_list_for_each(child, &tree->children, link) {
+			render_node(pass, child, x, y, scale);
+		}
+		break;
+	}
+	case WLR_SCENE_NODE_BUFFER: {
+		struct wlr_scene_buffer *scene_buffer = wlr_scene_buffer_from_node(node);
+		if (!scene_buffer->buffer) {
+			break;
+		}
+		struct wlr_client_buffer *client_buffer = wlr_client_buffer_get(scene_buffer->buffer);
+		struct wlr_texture *texture = client_buffer ? client_buffer->texture : NULL;
+		if (!texture) {
+			break;
+		}
+		int w = scene_buffer->dst_width ? scene_buffer->dst_width : (int)texture->width;
+		int h = scene_buffer->dst_height ? scene_buffer->dst_height : (int)texture->height;
+		int x0 = (int)lround(x * scale), y0 = (int)lround(y * scale);
+		wlr_render_pass_add_texture(pass, &(struct wlr_render_texture_options){
+			.texture = texture,
+			.src_box = scene_buffer->src_box,
+			.dst_box = {
+				.x = x0,
+				.y = y0,
+				.width = (int)lround((x + w) * scale) - x0,
+				.height = (int)lround((y + h) * scale) - y0,
+			},
+			.transform = scene_buffer->transform,
+			.filter_mode = WLR_SCALE_FILTER_BILINEAR,
+		});
+		break;
+	}
+	default:
+		break;
+	}
+}
+
+/*
+ * A picture of the view, w x h, in a new sealed memory file; -1 on any failure. Rendered
+ * offscreen from the view's content tree (as upstream's render_thumb) and read back.
+ */
+/*
+ * Shrink a premultiplied ARGB8888 picture by 2 in each direction, each output pixel the mean of
+ * its 2x2 block: an area filter, so a window drawn at a third of its size stays crisp instead of
+ * the one-pass bilinear smear.
+ */
+static void
+halve(const uint8_t *src, uint32_t src_stride, uint8_t *dst, uint32_t dst_stride, int w, int h)
+{
+	for (int y = 0; y < h; y++) {
+		const uint8_t *a = src + (size_t)(2 * y) * src_stride;
+		const uint8_t *b = a + src_stride;
+		uint8_t *o = dst + (size_t)y * dst_stride;
+		for (int x = 0; x < w; x++) {
+			for (int c = 0; c < 4; c++) {
+				unsigned sum = a[8 * x + c] + a[8 * x + 4 + c] + b[8 * x + c] + b[8 * x + 4 + c];
+				o[4 * x + c] = (uint8_t)((sum + 2) / 4);
+			}
+		}
+	}
+}
+
+static int
+render_thumbnail(struct server *server, struct view *view, int w, int h, double scale)
+{
+	/* Twice the size and halved when the window shrinks by 2 or more; at once otherwise */
+	int ss = scale * 2.0 <= 1.0 ? 2 : 1;
+	int rw = w * ss, rh = h * ss;
+	scale *= ss;
+	struct wlr_drm_format fallback = {
+		.format = DRM_FORMAT_ARGB8888,
+		.len = 1,
+		.capacity = 1,
+		.modifiers = (uint64_t[]){ DRM_FORMAT_MOD_INVALID },
+	};
+	const struct wlr_drm_format *format = &fallback;
+	if (view->output && view->output->wlr_output && view->output->wlr_output->swapchain) {
+		format = &view->output->wlr_output->swapchain->format;
+	}
+	struct wlr_buffer *buffer = wlr_allocator_create_buffer(server->allocator, rw, rh, format);
+	if (!buffer) {
+		wlr_log(WLR_ERROR, "window switcher thumbnail: no buffer");
+		return -1;
+	}
+	struct wlr_render_pass *pass = wlr_renderer_begin_buffer_pass(server->renderer, buffer, NULL);
+	if (!pass) {
+		wlr_buffer_drop(buffer);
+		return -1;
+	}
+	wlr_render_pass_add_rect(pass, &(struct wlr_render_rect_options){
+		.box = { .width = rw, .height = rh },
+		.color = { 0, 0, 0, 0 },
+		.blend_mode = WLR_RENDER_BLEND_MODE_NONE,
+	});
+	struct wlr_scene_node *content = &view->content_tree->node;
+	/* The content tree's own place in the view is taken back out: the picture starts at 0,0 */
+	render_node(pass, content, -content->x, -content->y, scale);
+	if (!wlr_render_pass_submit(pass)) {
+		wlr_buffer_drop(buffer);
+		return -1;
+	}
+	struct wlr_texture *texture = wlr_texture_from_buffer(server->renderer, buffer);
+	if (!texture) {
+		wlr_buffer_drop(buffer);
+		return -1;
+	}
+	uint32_t stride = (uint32_t)w * 4;
+	size_t size = (size_t)stride * (size_t)h;
+	uint32_t rstride = (uint32_t)rw * 4;
+	uint8_t *rendered = ss > 1 ? malloc((size_t)rstride * (size_t)rh) : NULL;
+	int fd = memfd_create("labwc-switcher-thumbnail", MFD_CLOEXEC | MFD_ALLOW_SEALING);
+	void *map = MAP_FAILED;
+	bool ok = (ss == 1 || rendered) && fd >= 0 && ftruncate(fd, (off_t)size) == 0
+		&& (map = mmap(NULL, size, PROT_READ | PROT_WRITE, MAP_SHARED, fd, 0)) != MAP_FAILED;
+	if (ok) {
+		ok = wlr_texture_read_pixels(texture, &(struct wlr_texture_read_pixels_options){
+			.data = ss > 1 ? (void *)rendered : map,
+			.format = DRM_FORMAT_ARGB8888,
+			.stride = ss > 1 ? rstride : stride,
+		});
+		if (ok && ss > 1) {
+			halve(rendered, rstride, map, stride, w, h);
+		}
+		munmap(map, size);
+	}
+	free(rendered);
+	wlr_texture_destroy(texture);
+	wlr_buffer_drop(buffer);
+	/* Sealed: the size and the bytes stay as sent */
+	if (ok && fcntl(fd, F_ADD_SEALS, F_SEAL_SHRINK | F_SEAL_GROW | F_SEAL_WRITE | F_SEAL_SEAL) < 0) {
+		ok = false;
+	}
+	if (!ok) {
+		if (fd >= 0) {
+			close(fd);
+		}
+		return -1;
+	}
+	return fd;
+}
+
+static void
+handle_capture(struct wl_client *client, struct wl_resource *resource,
+		uint32_t session, uint32_t id, uint32_t max_width, uint32_t max_height)
+{
+	struct switcher_renderer *r = wl_resource_get_user_data(resource);
+	if (!r || !r->resource || r->fallback) {
+		return;
+	}
+	struct view *view = listed_view(r, session, id);
+	if (!view || !view->mapped || !view->content_tree) {
+		return;
+	}
+	/* Bounded: a busy renderer cannot keep the compositor rendering pictures */
+	uint64_t t = now_ms();
+	if (t - r->capture_window_ms >= 1000) {
+		r->capture_window_ms = t;
+		r->captures_in_window = 0;
+	}
+	if (r->captures_in_window >= CAPTURES_PER_SECOND) {
+		return;
+	}
+	r->captures_in_window++;
+
+	int vw = view->current.width, vh = view->current.height;
+	if (vw <= 0 || vh <= 0) {
+		return;
+	}
+	double mw = max_width < THUMB_MIN ? THUMB_MIN : max_width > THUMB_MAX ? THUMB_MAX : max_width;
+	double mh = max_height < THUMB_MIN ? THUMB_MIN : max_height > THUMB_MAX ? THUMB_MAX : max_height;
+	double scale = fmin(1.0, fmin(mw / vw, mh / vh));
+	int w = (int)lround(vw * scale), h = (int)lround(vh * scale);
+	if (w < 1 || h < 1) {
+		return;
+	}
+	int fd = render_thumbnail(r->server, view, w, h, scale);
+	if (fd < 0) {
+		return;
+	}
+	zlabwc_window_switcher_renderer_v1_send_thumbnail(r->resource, session, id, fd,
+		(uint32_t)w, (uint32_t)h, (uint32_t)w * 4);
+	close(fd);
+}
+
+static void
+handle_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static const struct zlabwc_window_switcher_renderer_v1_interface renderer_impl = {
+	.ack = handle_ack,
+	.select = handle_select,
+	.capture = handle_capture,
+	.destroy = handle_destroy,
+};
+
+static void
+handle_resource_destroy(struct wl_resource *resource)
+{
+	struct switcher_renderer *r = wl_resource_get_user_data(resource);
+	if (r && r->resource == resource) {
+		r->resource = NULL;
+		fall_back(r);
+	}
+}
+
+static void
+handle_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+	struct switcher_renderer *r = data;
+	struct wl_resource *resource = wl_resource_create(client,
+		&zlabwc_window_switcher_renderer_v1_interface, version, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	/* The global filter already hides it from everyone else; this is the second lock */
+	if (client != r->client || r->resource) {
+		wl_resource_set_implementation(resource, &renderer_impl, NULL, NULL);
+		wl_resource_post_error(resource, 0, "not the window switcher renderer");
+		return;
+	}
+	wl_resource_set_implementation(resource, &renderer_impl, r, handle_resource_destroy);
+	r->resource = resource;
+}
+
+void
+switcher_renderer_init(struct server *server)
+{
+	if (!rc.window_switcher.renderer || !*rc.window_switcher.renderer) {
+		return;
+	}
+	struct switcher_renderer *r = znew(*r);
+	r->server = server;
+	wl_array_init(&r->sent);
+	r->global = wl_global_create(server->wl_display,
+		&zlabwc_window_switcher_renderer_v1_interface, RENDERER_VERSION, r, handle_bind);
+	r->ack_timer = wl_event_loop_add_timer(server->wl_event_loop, handle_ack_timeout, r);
+	r->respawn_timer = wl_event_loop_add_timer(server->wl_event_loop, handle_respawn, r);
+	server->switcher_renderer = r;
+	spawn(r);
+}
+
+void
+switcher_renderer_finish(struct server *server)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (!r) {
+		return;
+	}
+	/* On the way out nothing is drawn: no fallback to an OSD whose config is gone */
+	r->active = false;
+	if (r->resource) {
+		wl_resource_set_user_data(r->resource, NULL);
+		r->resource = NULL;
+	}
+	if (r->client) {
+		wl_list_remove(&r->client_destroy.link);
+		wl_client_destroy(r->client);
+	}
+	wl_array_release(&r->sent);
+	wl_event_source_remove(r->ack_timer);
+	wl_event_source_remove(r->respawn_timer);
+	wl_global_destroy(r->global);
+	server->switcher_renderer = NULL;
+	free(r);
+}
+
+bool
+switcher_renderer_global_allowed(struct server *server,
+		const struct wl_client *client, const struct wl_global *global)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (!r || global != r->global) {
+		return true;
+	}
+	return r->client && client == r->client;
+}
+
+void
+switcher_renderer_session_begin(struct server *server)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (!r) {
+		return;
+	}
+	spawn(r);
+	r->active = false;
+	if (!r->resource) {
+		return;
+	}
+	r->session++;
+	if (r->session == 0) {
+		r->session = 1;
+	}
+	r->active = true;
+	r->acked = false;
+	r->fallback = false;
+	r->committing = false;
+	r->focused_at_start = server->active_view;
+	wl_array_release(&r->sent);
+	wl_array_init(&r->sent);
+	zlabwc_window_switcher_renderer_v1_send_session_start(r->resource, r->session);
+	wl_event_source_timer_update(r->ack_timer, ACK_TIMEOUT_MS);
+}
+
+static const char *
+text(const char *s)
+{
+	return s ? s : "";
+}
+
+void
+switcher_renderer_update(struct server *server, struct wl_array *views)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (!r || !r->active || !r->resource) {
+		return;
+	}
+	/* The list again only when it changed; a Tab is just `selected` */
+	bool same = r->sent.size == views->size
+		&& !memcmp(r->sent.data, views->data, views->size);
+	if (same) {
+		goto selected;
+	}
+	wl_array_release(&r->sent);
+	wl_array_init(&r->sent);
+	if (views->size && wl_array_add(&r->sent, views->size)) {
+		memcpy(r->sent.data, views->data, views->size);
+	}
+	uint64_t t = now_ms();
+	struct view **v;
+	wl_array_for_each(v, views) {
+		struct view *view = *v;
+		if (!view->switcher_id) {
+			if (++r->next_view_id == 0) {
+				r->next_view_id = 1;
+			}
+			view->switcher_id = r->next_view_id;
+		}
+		uint32_t flags = 0;
+		if (view->workspace == server->workspaces.current) {
+			flags |= ZLABWC_WINDOW_SWITCHER_RENDERER_V1_WINDOW_FLAGS_CURRENT_WORKSPACE;
+		}
+		if (view->minimized) {
+			flags |= ZLABWC_WINDOW_SWITCHER_RENDERER_V1_WINDOW_FLAGS_MINIMIZED;
+		}
+		if (view == r->focused_at_start) {
+			flags |= ZLABWC_WINDOW_SWITCHER_RENDERER_V1_WINDOW_FLAGS_FOCUSED;
+		}
+		uint64_t idle = view->last_focus_ms ? t - view->last_focus_ms : 0;
+		if (idle > UINT32_MAX) {
+			idle = UINT32_MAX;
+		}
+		/* Bounded: a client's title must not make one event arbitrarily large */
+		char title[TEXT_MAX], app_id[TEXT_MAX];
+		snprintf(title, sizeof(title), "%s", text(view_get_string_prop(view, "title")));
+		snprintf(app_id, sizeof(app_id), "%s", text(view_get_string_prop(view, "app_id")));
+		zlabwc_window_switcher_renderer_v1_send_window(r->resource, r->session,
+			view->switcher_id, app_id, title,
+			view->workspace ? text(view->workspace->name) : "",
+			flags, (uint32_t)idle);
+	}
+	zlabwc_window_switcher_renderer_v1_send_windows_done(r->resource, r->session);
+selected:;
+	struct view *cycle_view = server->osd_state.cycle_view;
+	if (cycle_view && cycle_view->switcher_id) {
+		zlabwc_window_switcher_renderer_v1_send_selected(r->resource,
+			r->session, cycle_view->switcher_id);
+	}
+}
+
+bool
+switcher_renderer_draws(struct server *server)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	return r && r->active && r->resource && !r->fallback;
+}
+
+int
+switcher_renderer_repeat_ms(struct server *server)
+{
+	if (server->input_mode != LAB_INPUT_STATE_WINDOW_SWITCHER
+			|| !switcher_renderer_draws(server)) {
+		return 0;
+	}
+	return SWITCHER_REPEAT_MS;
+}
+
+void
+switcher_renderer_note_commit(struct server *server)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (r && r->active) {
+		r->committing = true;
+	}
+}
+
+void
+switcher_renderer_session_end(struct server *server)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (!r || !r->active) {
+		return;
+	}
+	wl_event_source_timer_update(r->ack_timer, 0);
+	if (r->resource) {
+		zlabwc_window_switcher_renderer_v1_send_ended(r->resource, r->session,
+			r->committing
+				? ZLABWC_WINDOW_SWITCHER_RENDERER_V1_END_REASON_COMMITTED
+				: ZLABWC_WINDOW_SWITCHER_RENDERER_V1_END_REASON_CANCELLED);
+	}
+	r->active = false;
+	r->committing = false;
+	r->focused_at_start = NULL;
+}
+
+bool
+switcher_renderer_key(struct server *server, xkb_keysym_t sym)
+{
+	struct switcher_renderer *r = server->switcher_renderer;
+	if (!r || !r->active || !r->resource || r->fallback || !r->acked) {
+		return false;
+	}
+	char utf8[16];
+	int n = xkb_keysym_to_utf8(sym, utf8, sizeof(utf8));
+	/* Text-producing keys only; Tab, Return, Escape and the like stay labwc's */
+	if (n <= 1 || (unsigned char)utf8[0] < 0x20 || utf8[0] == 0x7f) {
+		return false;
+	}
+	zlabwc_window_switcher_renderer_v1_send_key(r->resource, r->session, sym, utf8);
+	return true;
+}
+
+void
+switcher_renderer_note_focus(struct view *view)
+{
+	view->last_focus_ms = now_ms();
+}
