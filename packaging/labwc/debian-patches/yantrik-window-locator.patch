--- labwc-0.8.3.orig/src/window-locator.c
+++ labwc-0.8.3/src/window-locator.c
@@ -0,0 +1,687 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * The window locator (zyantrik_window_locator_v1): which window is at a point, which has
+ * focus, and a picture of one, for the one client labwc launches itself from
+ * <yantrik locator="command">. Built for Yantrik OS's Y: the person drags it onto a window, or
+ * presses Super+Y, and asks about that window.
+ *
+ * The rules are the window switcher renderer's. labwc launches the client on a pre-connected
+ * socket (launch-client.c) and offers the global to that wl_client only. Nothing is answered
+ * behind a session lock. A picture is rendered from the window's own scene subtree
+ * (scene-capture.c), never what overlaps it. On top of those:
+ *
+ *  - the person's gesture is checked here, not left to the client: `focused` is answered only
+ *    within ARM_MS after the YantrikLocate action ran (Super+Y), once; `at` only while a
+ *    pointer button is held and the point is within NEAR_CURSOR_PX of the cursor (the drag);
+ *  - every event answers a request or the person's YantrikLocate, so the client never learns
+ *    about a window the person did not point at;
+ *  - a picture is only taken of the window the most recent answer named, within
+ *    CAPTURE_AFTER_LOCATE_MS of it, and once per answer, so it inherits the gesture;
+ *  - windows whose app id is on <yantrik private=""> are named without their title and
+ *    never pictured, and the locator does not start without that list;
+ *  - the locator starts only when every rc.xml labwc read, the directory each is in, and the
+ *    locator program are root's and writable by no one else, so nothing the person's own
+ *    programs can write decides which program gets this;
+ *  - at most LOCATES_PER_SECOND answers and CAPTURES_PER_SECOND pictures a second.
+ *
+ * What this does not do: labwc offers virtual pointer and keyboard (and screencopy) to every
+ * client outside a security context, so a program running as the person can fake both
+ * gestures. The gesture rule holds the launched client to the person's action; it is not a
+ * boundary against code running as the person (yantrikos/yantrik-os#414, #476).
+ */
+#define _GNU_SOURCE
+#include <glib.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <sys/stat.h>
+#include <time.h>
+#include <unistd.h>
+#include <wayland-server-core.h>
+#include <wlr/types/wlr_compositor.h>
+#include <wlr/types/wlr_cursor.h>
+#include <wlr/types/wlr_scene.h>
+#include <wlr/types/wlr_seat.h>
+#include <wlr/util/log.h>
+#include <wlr/util/transform.h>
+#include "common/dir.h"
+#include "common/list.h"
+#include "common/mem.h"
+#include "config/rcxml.h"
+#include "labwc.h"
+#include "launch-client.h"
+#include "node.h"
+#include "scene-capture.h"
+#include "session-lock.h"
+#include "ssd.h"
+#include "view.h"
+#include "window-locator.h"
+#include "yantrik-window-locator-unstable-v1-protocol.h"
+
+#define LOCATOR_VERSION 1
+#define RESPAWN_MIN_MS 5000
+#define TEXT_MAX 512
+#define PICTURE_MIN 16
+#define PICTURE_MAX 2048
+#define LOCATES_PER_SECOND 120
+#define CAPTURES_PER_SECOND 2
+#define CAPTURE_AFTER_LOCATE_MS 2000
+#define ARM_MS 2000
+#define NEAR_CURSOR_PX 8
+
+struct window_locator {
+	struct server *server;
+	struct wl_global *global;
+	struct wl_client *client;
+	struct wl_listener client_destroy;
+	struct wl_resource *resource;
+	struct wl_event_source *respawn_timer;
+	uint64_t last_spawn_ms;
+	uint32_t next_view_id;
+	/* Taken from rc.xml when labwc starts; a later --reconfigure does not change them */
+	char *command;
+	gchar **private_app_ids;
+	/* YantrikLocate ran at armed_ms and `focused` has not answered since */
+	bool armed;
+	uint64_t armed_ms;
+	/* The window the most recent answer named (0: none, or used up), and when */
+	uint32_t located_id;
+	uint64_t located_ms;
+	/* The second the answers and pictures below are counted in */
+	uint64_t locate_window_ms;
+	int locates_in_window;
+	uint64_t capture_window_ms;
+	int captures_in_window;
+};
+
+static uint64_t
+now_ms(void)
+{
+	struct timespec ts;
+	clock_gettime(CLOCK_MONOTONIC, &ts);
+	return (uint64_t)ts.tv_sec * 1000 + (uint64_t)ts.tv_nsec / 1000000;
+}
+
+/* Whether one more falls in the current second's allowance of `limit` */
+static bool
+within_rate(uint64_t *window_ms, int *count, int limit)
+{
+	uint64_t t = now_ms();
+	if (t - *window_ms >= 1000) {
+		*window_ms = t;
+		*count = 0;
+	}
+	if (*count >= limit) {
+		return false;
+	}
+	(*count)++;
+	return true;
+}
+
+static bool
+locked(struct window_locator *l)
+{
+	return l->server->session_lock_manager->locked;
+}
+
+static void spawn(struct window_locator *l);
+
+static int
+handle_respawn(void *data)
+{
+	spawn(data);
+	return 0;
+}
+
+static void
+handle_client_destroy(struct wl_listener *listener, void *data)
+{
+	struct window_locator *l = wl_container_of(listener, l, client_destroy);
+	wl_list_remove(&l->client_destroy.link);
+	l->client = NULL;
+	l->resource = NULL;
+	l->located_id = 0;
+	/* Launched again, at most once per RESPAWN_MIN_MS (as the switcher renderer) */
+	uint64_t t = now_ms();
+	uint64_t since = l->last_spawn_ms ? t - l->last_spawn_ms : RESPAWN_MIN_MS;
+	int wait = since >= RESPAWN_MIN_MS ? 1 : (int)(RESPAWN_MIN_MS - since) + 10;
+	wl_event_source_timer_update(l->respawn_timer, wait);
+}
+
+static void
+spawn(struct window_locator *l)
+{
+	if (l->client) {
+		return;
+	}
+	uint64_t t = now_ms();
+	if (l->last_spawn_ms && t - l->last_spawn_ms < RESPAWN_MIN_MS) {
+		return;
+	}
+	l->last_spawn_ms = t;
+	l->client = launch_client(l->server, l->command, "window locator");
+	if (!l->client) {
+		return;
+	}
+	l->client_destroy.notify = handle_client_destroy;
+	wl_client_add_destroy_listener(l->client, &l->client_destroy);
+}
+
+/* Whether `path` is of this type, root's, and writable by neither group nor others */
+static bool
+root_only(const char *path, mode_t type)
+{
+	struct stat st;
+	return stat(path, &st) == 0 && (st.st_mode & S_IFMT) == type && st.st_uid == 0
+		&& !(st.st_mode & (S_IWGRP | S_IWOTH));
+}
+
+/* root_only() for an absolute file and the directory it is in (which could otherwise swap it) */
+static bool
+root_only_file(const char *path)
+{
+	if (path[0] != '/' || !root_only(path, S_IFREG)) {
+		return false;
+	}
+	char *dir = xstrdup(path);
+	char *slash = strrchr(dir, '/');
+	if (slash == dir) {
+		slash[1] = '\0';
+	} else {
+		*slash = '\0';
+	}
+	bool ok = root_only(dir, S_IFDIR);
+	free(dir);
+	return ok;
+}
+
+/*
+ * Whether every rc.xml labwc read this time is root_only_file(): the same files, in the same
+ * way, as rcxml_read() (-c, or the first in the search path, or all of them when merging).
+ * False when it read none.
+ */
+static bool
+config_is_roots(void)
+{
+	struct wl_list paths;
+	if (rc.config_file) {
+		wl_list_init(&paths);
+		struct path *path = znew(*path);
+		path->string = xstrdup(rc.config_file);
+		wl_list_append(&paths, &path->link);
+	} else {
+		paths_config_create(&paths, "rc.xml");
+	}
+	bool read_any = false, ok = true;
+	struct path *path;
+	wl_list_for_each(path, &paths, link) {
+		if (access(path->string, R_OK) != 0) {
+			continue;
+		}
+		read_any = true;
+		if (!root_only_file(path->string)) {
+			wlr_log(WLR_ERROR, "window locator: %s is not root's alone", path->string);
+			ok = false;
+		}
+		if (!rc.merge_config) {
+			break;
+		}
+	}
+	paths_destroy(&paths);
+	return read_any && ok;
+}
+
+/* The locator command, if its program is given by absolute path and root_only_file() */
+static bool
+command_is_roots(const char *command)
+{
+	gchar **argv = NULL;
+	if (!g_shell_parse_argv(command, NULL, &argv, NULL)) {
+		return false;
+	}
+	bool ok = argv[0] && root_only_file(argv[0]);
+	g_strfreev(argv);
+	return ok;
+}
+
+/* Whether the view's app id is on <yantrik private="">: named without its title, never pictured */
+static bool
+is_private(struct window_locator *l, struct view *view)
+{
+	const char *app_id = view_get_string_prop(view, "app_id");
+	if (!app_id || !*app_id) {
+		return false;
+	}
+	for (gchar **p = l->private_app_ids; *p; p++) {
+		if (**p && !strcmp(*p, app_id)) {
+			return true;
+		}
+	}
+	return false;
+}
+
+/* The handlers' locator, if this resource is the one bound by the launched client */
+static struct window_locator *
+locator_of(struct wl_resource *resource)
+{
+	struct window_locator *l = wl_resource_get_user_data(resource);
+	return l && l->resource == resource ? l : NULL;
+}
+
+/* Whether this buffer shows one of the locator client's own surfaces (looked through) */
+static bool
+own_surface(struct window_locator *l, struct wlr_scene_buffer *buffer)
+{
+	struct wlr_scene_surface *scene_surface = wlr_scene_surface_try_from_buffer(buffer);
+	return scene_surface && scene_surface->surface && scene_surface->surface->resource
+		&& wl_resource_get_client(scene_surface->surface->resource) == l->client;
+}
+
+/*
+ * The topmost node under `node` drawn at layout point (lx, ly), children top first as
+ * wlr_scene_node_at() walks them, except that the locator client's own surfaces are looked
+ * through and no surface's input region is consulted (a surface that lets clicks through is
+ * still drawn over what is under it). (px, py) is the layout
+ * position of node's parent.
+ */
+static struct wlr_scene_node *
+node_at(struct window_locator *l, struct wlr_scene_node *node, int px, int py,
+		double lx, double ly)
+{
+	if (!node->enabled) {
+		return NULL;
+	}
+	int x = px + node->x, y = py + node->y;
+	switch (node->type) {
+	case WLR_SCENE_NODE_TREE: {
+		struct wlr_scene_tree *tree = wlr_scene_tree_from_node(node);
+		struct wlr_scene_node *child;
+		/* Children are kept bottom to top: the last is drawn on top */
+		wl_list_for_each_reverse(child, &tree->children, link) {
+			struct wlr_scene_node *hit = node_at(l, child, x, y, lx, ly);
+			if (hit) {
+				return hit;
+			}
+		}
+		return NULL;
+	}
+	case WLR_SCENE_NODE_RECT: {
+		struct wlr_scene_rect *rect = wlr_scene_rect_from_node(node);
+		double rx = lx - x, ry = ly - y;
+		return rx >= 0 && ry >= 0 && rx < rect->width && ry < rect->height ? node : NULL;
+	}
+	case WLR_SCENE_NODE_BUFFER: {
+		struct wlr_scene_buffer *buffer = wlr_scene_buffer_from_node(node);
+		if (own_surface(l, buffer)) {
+			return NULL;
+		}
+		int w = buffer->dst_width, h = buffer->dst_height;
+		if (w <= 0 || h <= 0) {
+			w = buffer->buffer_width;
+			h = buffer->buffer_height;
+			wlr_output_transform_coords(buffer->transform, &w, &h);
+		}
+		/*
+		 * Anyone else's surface stops the lookup wherever it is drawn, whether or not it
+		 * takes input there: a click-through overlay is still on top of what is under it.
+		 */
+		double rx = lx - x, ry = ly - y;
+		if (rx < 0 || ry < 0 || rx >= w || ry >= h) {
+			return NULL;
+		}
+		return node;
+	}
+	}
+	return NULL;
+}
+
+/*
+ * The window a hit node belongs to: its surface, decorations or popups. NULL when the node is
+ * something else (a layer surface such as a panel or dock, a menu, the lock screen, an input
+ * method popup, an X11 override-redirect window).
+ */
+static struct view *
+view_of(struct wlr_scene_node *node)
+{
+	for (; node; node = node->parent ? &node->parent->node : NULL) {
+		struct node_descriptor *desc = node->data;
+		if (!desc) {
+			continue;
+		}
+		switch (desc->type) {
+		case LAB_NODE_DESC_VIEW:
+		case LAB_NODE_DESC_XDG_POPUP:
+			return desc->data;
+		case LAB_NODE_DESC_SSD_BUTTON:
+			return ssd_button_get_view(node_ssd_button_from_node(node));
+		case LAB_NODE_DESC_NODE:
+		case LAB_NODE_DESC_TREE:
+		case LAB_NODE_DESC_SCALED_SCENE_BUFFER:
+			break;
+		default:
+			return NULL;
+		}
+	}
+	return NULL;
+}
+
+static struct view *
+find_view(struct window_locator *l, uint32_t id)
+{
+	struct view *view;
+	wl_list_for_each(view, &l->server->views, link) {
+		if (view->locator_id == id) {
+			return view;
+		}
+	}
+	return NULL;
+}
+
+/*
+ * `s` into `out` (TEXT_MAX bytes), cut short at a character boundary when it is longer:
+ * bounded, so a client's title cannot make one event arbitrarily large, and still UTF-8.
+ */
+static void
+bounded_text(char out[TEXT_MAX], const char *s)
+{
+	size_t n = s ? strlen(s) : 0;
+	if (n >= TEXT_MAX) {
+		n = TEXT_MAX - 1;
+		/* Back off over continuation bytes (10xxxxxx) to the start of a character */
+		while (n > 0 && ((unsigned char)s[n] & 0xc0) == 0x80) {
+			n--;
+		}
+	}
+	if (n) {
+		memcpy(out, s, n);
+	}
+	out[n] = '\0';
+}
+
+/* A window the person can see: mapped, and on the workspace they are on */
+static bool
+on_screen(struct window_locator *l, struct view *view)
+{
+	return view && view->mapped && !view->minimized
+		&& (view->visible_on_all_workspaces
+			|| view->workspace == l->server->workspaces.current);
+}
+
+/* Answer a request: the window, or none for `reason`. Either replaces what may be captured. */
+static void
+answer(struct window_locator *l, uint32_t serial, struct view *view, uint32_t reason)
+{
+	if (!on_screen(l, view)) {
+		l->located_id = 0;
+		zyantrik_window_locator_v1_send_none(l->resource, serial, reason);
+		return;
+	}
+	if (!view->locator_id) {
+		if (++l->next_view_id == 0) {
+			l->next_view_id = 1;
+		}
+		view->locator_id = l->next_view_id;
+	}
+	l->located_id = view->locator_id;
+	l->located_ms = now_ms();
+	bool private = is_private(l, view);
+	char title[TEXT_MAX], app_id[TEXT_MAX];
+	bounded_text(title, private ? NULL : view_get_string_prop(view, "title"));
+	bounded_text(app_id, view_get_string_prop(view, "app_id"));
+	int w = view->current.width > 0 ? view->current.width : 0;
+	int h = view->current.height > 0 ? view->current.height : 0;
+	zyantrik_window_locator_v1_send_window(l->resource, serial, view->locator_id, app_id,
+		title, view->current.x, view->current.y, (uint32_t)w, (uint32_t)h,
+		private ? ZYANTRIK_WINDOW_LOCATOR_V1_WINDOW_FLAGS_PRIVATE : 0);
+}
+
+/* Whether the request may be answered with a window; if not, it is answered with none */
+static bool
+may_locate(struct window_locator *l, uint32_t serial)
+{
+	if (locked(l)) {
+		answer(l, serial, NULL, ZYANTRIK_WINDOW_LOCATOR_V1_NONE_REASON_LOCKED);
+		return false;
+	}
+	if (!within_rate(&l->locate_window_ms, &l->locates_in_window, LOCATES_PER_SECOND)) {
+		answer(l, serial, NULL, ZYANTRIK_WINDOW_LOCATOR_V1_NONE_REASON_THROTTLED);
+		return false;
+	}
+	return true;
+}
+
+/* The drag: a pointer button is held and (x, y) is where the cursor is, give or take */
+static bool
+pointer_gesture_at(struct window_locator *l, int32_t x, int32_t y)
+{
+	struct seat *seat = &l->server->seat;
+	if (seat->seat->pointer_state.button_count == 0) {
+		return false;
+	}
+	double dx = x - seat->cursor->x, dy = y - seat->cursor->y;
+	return dx >= -NEAR_CURSOR_PX && dx <= NEAR_CURSOR_PX
+		&& dy >= -NEAR_CURSOR_PX && dy <= NEAR_CURSOR_PX;
+}
+
+static void
+handle_at(struct wl_client *client, struct wl_resource *resource, uint32_t serial,
+		int32_t x, int32_t y)
+{
+	struct window_locator *l = locator_of(resource);
+	if (!l || !may_locate(l, serial)) {
+		return;
+	}
+	if (!pointer_gesture_at(l, x, y)) {
+		answer(l, serial, NULL, ZYANTRIK_WINDOW_LOCATOR_V1_NONE_REASON_NO_GESTURE);
+		return;
+	}
+	struct wlr_scene_node *node = node_at(l, &l->server->scene->tree.node, 0, 0, x, y);
+	answer(l, serial, node ? view_of(node) : NULL,
+		ZYANTRIK_WINDOW_LOCATOR_V1_NONE_REASON_NOTHING);
+}
+
+static void
+handle_focused(struct wl_client *client, struct wl_resource *resource, uint32_t serial)
+{
+	struct window_locator *l = locator_of(resource);
+	if (!l || !may_locate(l, serial)) {
+		return;
+	}
+	/* Super+Y: only soon after YantrikLocate ran, and once */
+	bool armed = l->armed && now_ms() - l->armed_ms <= ARM_MS;
+	l->armed = false;
+	if (!armed) {
+		answer(l, serial, NULL, ZYANTRIK_WINDOW_LOCATOR_V1_NONE_REASON_NO_GESTURE);
+		return;
+	}
+	answer(l, serial, l->server->active_view, ZYANTRIK_WINDOW_LOCATOR_V1_NONE_REASON_NOTHING);
+}
+
+static void
+capture_failed(struct window_locator *l, uint32_t id, uint32_t reason)
+{
+	zyantrik_window_locator_v1_send_capture_failed(l->resource, id, reason);
+}
+
+static void
+handle_capture(struct wl_client *client, struct wl_resource *resource, uint32_t id,
+		uint32_t max_width, uint32_t max_height)
+{
+	struct window_locator *l = locator_of(resource);
+	if (!l) {
+		return;
+	}
+	if (locked(l)) {
+		l->located_id = 0;
+		capture_failed(l, id, ZYANTRIK_WINDOW_LOCATOR_V1_CAPTURE_FAILURE_LOCKED);
+		return;
+	}
+	/* Only the window the most recent answer named, soon after, once */
+	if (id == 0 || id != l->located_id
+			|| now_ms() - l->located_ms > CAPTURE_AFTER_LOCATE_MS) {
+		capture_failed(l, id, ZYANTRIK_WINDOW_LOCATOR_V1_CAPTURE_FAILURE_NOT_LOCATED);
+		return;
+	}
+	if (!within_rate(&l->capture_window_ms, &l->captures_in_window, CAPTURES_PER_SECOND)) {
+		capture_failed(l, id, ZYANTRIK_WINDOW_LOCATOR_V1_CAPTURE_FAILURE_THROTTLED);
+		return;
+	}
+	l->located_id = 0;
+	struct view *view = find_view(l, id);
+	if (!on_screen(l, view) || !view->content_tree) {
+		capture_failed(l, id, ZYANTRIK_WINDOW_LOCATOR_V1_CAPTURE_FAILURE_GONE);
+		return;
+	}
+	if (is_private(l, view)) {
+		capture_failed(l, id, ZYANTRIK_WINDOW_LOCATOR_V1_CAPTURE_FAILURE_PRIVATE);
+		return;
+	}
+	int w, h;
+	double scale;
+	int fd = -1;
+	if (scene_capture_fit(view, max_width, max_height, PICTURE_MIN, PICTURE_MAX, &w, &h,
+			&scale)) {
+		fd = scene_capture_view(l->server, view, w, h, scale, "labwc-window-locator");
+	}
+	if (fd < 0) {
+		capture_failed(l, id, ZYANTRIK_WINDOW_LOCATOR_V1_CAPTURE_FAILURE_FAILED);
+		return;
+	}
+	/*
+	 * Every picture in labwc's own log, which the client cannot skip; the title stays out.
+	 * At the error level because that is the only level labwc writes by default (it runs
+	 * without -V in the session), and this line must be there whatever the verbosity.
+	 */
+	char app_id[TEXT_MAX];
+	bounded_text(app_id, view_get_string_prop(view, "app_id"));
+	wlr_log(WLR_ERROR, "window locator: picture of window %u (app_id %s), %dx%d", id, app_id,
+		w, h);
+	zyantrik_window_locator_v1_send_picture(l->resource, id, fd, (uint32_t)w, (uint32_t)h,
+		(uint32_t)w * 4);
+	close(fd);
+}
+
+static void
+handle_destroy(struct wl_client *client, struct wl_resource *resource)
+{
+	wl_resource_destroy(resource);
+}
+
+static const struct zyantrik_window_locator_v1_interface locator_impl = {
+	.at = handle_at,
+	.focused = handle_focused,
+	.capture = handle_capture,
+	.destroy = handle_destroy,
+};
+
+static void
+handle_resource_destroy(struct wl_resource *resource)
+{
+	struct window_locator *l = wl_resource_get_user_data(resource);
+	if (l && l->resource == resource) {
+		l->resource = NULL;
+		l->located_id = 0;
+	}
+}
+
+static void
+handle_bind(struct wl_client *client, void *data, uint32_t version, uint32_t id)
+{
+	struct window_locator *l = data;
+	struct wl_resource *resource = wl_resource_create(client,
+		&zyantrik_window_locator_v1_interface, version, id);
+	if (!resource) {
+		wl_client_post_no_memory(client);
+		return;
+	}
+	/* The global filter already hides it from everyone else; this is the second lock */
+	if (client != l->client || l->resource) {
+		wl_resource_set_implementation(resource, &locator_impl, NULL, NULL);
+		wl_resource_post_error(resource, 0, "not the window locator");
+		return;
+	}
+	wl_resource_set_implementation(resource, &locator_impl, l, handle_resource_destroy);
+	l->resource = resource;
+}
+
+void
+window_locator_init(struct server *server)
+{
+	const char *command = rc.yantrik.locator;
+	if (!command || !*command) {
+		return;
+	}
+	/* Fail closed: each of these leaves the locator off for this run of labwc */
+	if (!rc.yantrik.locator_private || !*rc.yantrik.locator_private) {
+		wlr_log(WLR_ERROR, "window locator: not started: <yantrik private=\"\"> "
+			"(the app ids never to picture) is not set");
+		return;
+	}
+	if (!config_is_roots()) {
+		wlr_log(WLR_ERROR, "window locator: not started: the rc.xml it is set in "
+			"is not root's alone");
+		return;
+	}
+	if (!command_is_roots(command)) {
+		wlr_log(WLR_ERROR, "window locator: not started: %s is not an absolute path to "
+			"a program that is root's alone", command);
+		return;
+	}
+	struct window_locator *l = znew(*l);
+	l->server = server;
+	l->command = xstrdup(command);
+	l->private_app_ids = g_strsplit_set(rc.yantrik.locator_private, " ,", -1);
+	l->global = wl_global_create(server->wl_display,
+		&zyantrik_window_locator_v1_interface, LOCATOR_VERSION, l, handle_bind);
+	l->respawn_timer = wl_event_loop_add_timer(server->wl_event_loop, handle_respawn, l);
+	server->window_locator = l;
+	spawn(l);
+}
+
+void
+window_locator_finish(struct server *server)
+{
+	struct window_locator *l = server->window_locator;
+	if (!l) {
+		return;
+	}
+	if (l->resource) {
+		wl_resource_set_user_data(l->resource, NULL);
+		l->resource = NULL;
+	}
+	if (l->client) {
+		wl_list_remove(&l->client_destroy.link);
+		wl_client_destroy(l->client);
+	}
+	wl_event_source_remove(l->respawn_timer);
+	wl_global_destroy(l->global);
+	server->window_locator = NULL;
+	free(l->command);
+	g_strfreev(l->private_app_ids);
+	free(l);
+}
+
+void
+window_locator_arm(struct server *server)
+{
+	struct window_locator *l = server->window_locator;
+	if (!l || locked(l)) {
+		return;
+	}
+	l->armed = true;
+	l->armed_ms = now_ms();
+	if (l->resource) {
+		zyantrik_window_locator_v1_send_armed(l->resource);
+	}
+}
+
+bool
+window_locator_global_allowed(struct server *server,
+		const struct wl_client *client, const struct wl_global *global)
+{
+	struct window_locator *l = server->window_locator;
+	if (!l || global != l->global) {
+		return true;
+	}
+	return l->client && client == l->client;
+}
