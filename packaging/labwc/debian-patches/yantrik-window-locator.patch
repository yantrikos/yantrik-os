+/* SPDX-License-Identifier: GPL-2.0-only */
+#ifndef LABWC_WINDOW_LOCATOR_H
+#define LABWC_WINDOW_LOCATOR_H
+
+#include <stdbool.h>
+
+struct server;
+struct wl_client;
+struct wl_global;
+
+/*
+ * The window locator (zyantrik_window_locator_v1): which window is at a point, which has
+ * focus, and a picture of one, for the one client labwc launches itself from
+ * <yantrik locator="command">.
+ */
+
+/* Create the global and launch the locator, if <yantrik locator=""> is set */
+void window_locator_init(struct server *server);
+void window_locator_finish(struct server *server);
+
+/* action.c: YantrikLocate (Super+Y) ran: `focused` may be answered for a moment, once */
+void window_locator_arm(struct server *server);
+
+/*
+ * rcxml.c: whether the rc.xml just opened as `fd` (at `path`) is root's and writable by no one
+ * else, in a folder that is too: checked on the file as read, so it cannot be swapped after
+ */
+bool window_locator_config_file_ok(int fd, const char *path);
+
+/* Whether the global may be bound by this client (server_global_filter) */
+bool window_locator_global_allowed(struct server *server,
+	const struct wl_client *client, const struct wl_global *global);
+
+#endif /* LABWC_WINDOW_LOCATOR_H */
