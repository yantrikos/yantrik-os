#!/bin/bash
# Load the egress filter (/etc/yantrik-ci/egress.nft) inside this container. Run by
# yantrik-ci-launch as root, before the job's user exists. Fails closed: if the rules are not
# loaded and verified, the launcher stops and no runner starts.
set -euo pipefail

rules=/etc/yantrik-ci/egress.nft
[ -f "$rules" ] || { echo "yantrik-ci-egress: $rules missing" >&2; exit 1; }

# The container's resolvers: the nameservers it is configured with. The systemd-resolved
# stub (127.0.0.53) is not one; its upstream servers are listed in the other file.
resolvers() {
  awk '/^nameserver[ \t]/ {print $2}' /etc/resolv.conf /run/systemd/resolve/resolv.conf 2> /dev/null |
    grep -E '^[0-9]+\.[0-9]+\.[0-9]+\.[0-9]+$' | grep -v '^127\.' | sort -u | paste -sd, -
}

ns=
for _ in $(seq 1 60); do
  ns=$(resolvers)
  [ -n "$ns" ] && break
  sleep 1
done
[ -n "$ns" ] || { echo "yantrik-ci-egress: no resolver found" >&2; exit 1; }

prelude=$(mktemp)
trap 'rm -f "$prelude"' EXIT
printf 'define resolvers = { %s }\ninclude "%s"\n' "${ns//,/, }" "$rules" > "$prelude"
nft -f "$prelude"

nft list chain ip yantrik_ci output | grep -q 'policy drop'
nft list chain ip yantrik_ci input | grep -q 'policy drop'
nft list chain ip6 yantrik_ci output | grep -q 'policy drop'
echo "yantrik-ci-egress: filter loaded (resolvers: $ns)"
