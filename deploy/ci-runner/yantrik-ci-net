#!/usr/bin/env bash
# The CI clones' network by hand (#1252): `yantrik-ci-net up|down|status|pin ID|lock ID|unpin ID|cleanup`. It is the same
# code the controller runs (lib/net.sh): the bridge yci0 (no physical port) and the table
# `inet yantrik_ci` and `netdev yantrik_ci_l2`, made at runtime and removed by `down`. Run as root on the node. `down` is what
# the operator runs to stop CI from using the node, after the controller is stopped and no VM in
# 9541-9549 is left; it refuses while a clone's port is still on the bridge.
set -uo pipefail
LIB_DIR=${YANTRIK_CI_LIB:-/usr/local/lib/yantrik-ci}
RUN_DIR=${YANTRIK_CI_RUN_DIR:-/run/yantrik-ci}
OWN_PUBLIC_FILE=${YANTRIK_CI_OWN_PUBLIC:-/etc/yantrik-ci/own-public-ips}
[ "$(id -u)" -eq 0 ] || { echo "yantrik-ci-net: run as root" >&2; exit 1; }
mkdir -p "$RUN_DIR"
chmod 700 "$RUN_DIR"
log() { printf '%s\n' "$*"; }
for f in "$LIB_DIR" "$LIB_DIR/trust.sh"; do
  m=$(stat -c '%u %a' "$f" 2> /dev/null) || { log "cannot stat $f"; exit 1; }
  if [ "${m%% *}" != 0 ] || [ $((8#${m#* } & 8#022)) -ne 0 ]; then log "REFUSING to use $f: owner/mode '$m'"; exit 1; fi
done
# shellcheck source=lib/trust.sh
. "$LIB_DIR/trust.sh"
for f in "$LIB_DIR/host.sh" "$LIB_DIR/net.sh"; do trusted_path "$f" || exit 1; done
ID_MIN=9541
ID_MAX=9549
TEMPLATE_ID=9540
POOL=pve/data
# shellcheck source=lib/host.sh
. "$LIB_DIR/host.sh"
# shellcheck source=lib/net.sh
. "$LIB_DIR/net.sh"

case "${1:-}" in
  up) net_up && log "up: $NET_BRIDGE $NET_GW/$NET_LEN, table inet $NET_TABLE and netdev $NET_TABLE_L2" ;;
  down) net_down && log "down: $NET_BRIDGE and tables inet $NET_TABLE, netdev $NET_TABLE_L2 removed" ;;
  pin) net_pin "${2:?id}" && log "pinned $(net_port "$2")" ;;
  lock) net_lock "${2:?id}" && log "isolated and locked $(net_port "$2")" ;;
  unpin) net_unpin "${2:?id}" && log "unpinned $(net_port "$2")" ;;
  # The unit's ExecStopPost=: whatever way the controller ended (SIGTERM, a lost SIGTERM, SIGKILL, an OOM kill),
  # no clone is left running with its pin. A clone that cannot be destroyed is unpinned (its port is dropped);
  # `net_down` then refuses and the bridge and the table stay.
  #
  # It takes the controller's own lock (N2), so it cannot run beside a controller that is starting or running (a
  # unit whose ExecStart lost the lock to one started by hand must not destroy that one's clone), nor beside a second
  # cleanup. It waits a little for a lock that is about to be freed (a second cleanup, a controller on its way out);
  # a lock still held after that is a live controller's, and nothing is touched. Nothing a child of the controller
  # holds can keep it: the controller starts QEMU and its watcher with the lock's descriptor closed.
  cleanup)
    exec 8> "$RUN_DIR/controller.lock"
    flock -w "${YANTRIK_CI_CLEANUP_WAIT:-20}" 8 || { log "a controller or another cleanup holds the lock: no cleanup"; exit 0; }
    rc=0
    destroy_all_clones || rc=1
    net_down || rc=1
    exit $rc
    ;;
  status)
    if net_present; then ip -br addr show dev "$NET_BRIDGE"; else log "no bridge $NET_BRIDGE"; fi
    nft list table inet "$NET_TABLE" 2> /dev/null || log "no table inet $NET_TABLE"
    nft list table netdev "$NET_TABLE_L2" 2> /dev/null || log "no table netdev $NET_TABLE_L2"
    ;;
  *) echo "usage: yantrik-ci-net up|down|status|pin ID|lock ID|unpin ID|cleanup" >&2; exit 2 ;;
esac
