#!/bin/bash
# A stand-in for `pct` in controller-test.sh. Everything goes to the real pct, except:
#  - FAKE_PCT=exec-sleeps: the launcher's `pct exec` never returns by itself (it ends when the CT stops,
#    as the real one does), so the controller has to end a CT whose runner is still "running";
#  - FAKE_PCT=no-destroy: `pct stop` and `pct destroy` fail, so a CT survives its job.
if [ "${FAKE_PCT:-}" = exec-sleeps ] && [ "$1" = exec ] && [ "${4:-}" = /usr/local/sbin/yantrik-ci-launch ]; then
  while /usr/sbin/pct status "$2" 2> /dev/null | grep -q running; do sleep 1; done
  exit 143
fi
if [ "${FAKE_PCT:-}" = no-destroy ] && { [ "$1" = stop ] || [ "$1" = destroy ]; }; then
  echo "fake pct: $1 refused" >&2
  exit 1
fi
exec /usr/sbin/pct "$@"
