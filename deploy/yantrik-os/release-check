#!/usr/bin/env python3
"""release-check — what a Yantrik OS build must pass before it is tagged.

    release-check [--tier ci|rc] [--interactive] [--json FILE] [--only WORD] [--skip WORD]

Runs ON the machine under test, as the person's user, inside their session, and talks to the
desktop the way everything else does: through the control surfaces, via `yos`.

  ci   needs no network and no minds. It is what the nightly's QEMU boot can run: every app opens
       and answers, every surface a shipped .desktop file declares is listed and answers to its
       aliases, every screen shows, the permission gate refuses on every door, the ceiling
       holds, nothing crashed, and the shell is idle when idle.
  rc   a release candidate, on a real machine with its minds attached: adds every mind answering,
       the browser being drivable, and — with --interactive — the checks a person must take part
       in (press Allow on a card; watch a mind's command run in its own pane).

Every check says what it saw. PASS and SKIP (with the reason) do not fail a run; FAIL does.
Exit 0: nothing failed. 1: something failed. The last lines are the manual checklist for rc.
"""
import argparse
import importlib.machinery
import importlib.util
import json
import os
import shutil
import socket
import subprocess
import sys
import threading
import time
import http.server

os.environ.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
os.environ["PATH"] = "/opt/yantrik/bin:" + os.environ.get("PATH", "")
_loader = importlib.machinery.SourceFileLoader("yos", "/opt/yantrik/bin/yos")
_spec = importlib.util.spec_from_loader("yos", _loader)
yos = importlib.util.module_from_spec(_spec)
_loader.exec_module(yos)

GRADES = ("safe", "standard", "sensitive", "dangerous")
SLOW_APPS = {"blender": 120}          # seconds to wait for a socket; everything else gets 30
RESULTS = []
CHECKS = []


# ── plumbing ──────────────────────────────────────────────────────────────────────────────

class Failed(Exception):
    pass


class Skipped(Exception):
    pass


def check(name, tier="ci", interactive=False):
    def wrap(fn):
        CHECKS.append({"name": name, "tier": tier, "interactive": interactive, "fn": fn})
        return fn
    return wrap


def rpc(target, method, params=None, timeout=40):
    """A call that raises with the surface's own words, instead of exiting."""
    try:
        return yos.request(target, method, params, timeout)
    except SystemExit as e:
        raise RuntimeError("yos exited (%s)" % e) from None


def act(target, action, timeout=40, **args):
    return rpc(target, "app.act", {"action": action, "args": args}, timeout)


def shell():
    return rpc("shell", "app.describe")


def state():
    return shell().get("state", {})


def sh(cmd, timeout=180):
    p = subprocess.run(cmd, shell=True, capture_output=True, text=True, timeout=timeout)
    return p.returncode, (p.stdout + p.stderr).strip()


def wait(cond, timeout, step=1.0):
    end = time.time() + timeout
    while time.time() < end:
        try:
            v = cond()
            if v:
                return v
        except Exception:  # noqa: BLE001 — not ready yet
            pass
        time.sleep(step)
    return None


def shell_pid():
    code, out = sh("pidof yantrik-ui")
    return int(out.split()[0]) if code == 0 and out else None


def mind_switch_gate():
    """Whether this run may switch minds at all.

    `use_harness` is sensitive (#48): it writes the preferred-mind setting, which stands
    after a restart. In plan mode the doors that raise cards refuse it outright, and in ask
    mode it is a card a person has to answer — only auto and bypass run it unasked, the way
    every mode used to. Called at the top of a check, before its loop, so a Skipped lands as
    a SKIP verdict rather than being caught as one more dead mind.
    """
    mode = BASELINE.get("mode")
    if mode == "plan":
        raise Skipped("plan mode refuses use_harness, which is sensitive (#48)")
    if mode not in ("auto", "bypass") and not ARGS.interactive:
        raise Skipped("mode %s makes switching minds a card a person answers; "
                      "run with --interactive" % mode)


_MIND_CARD_ANNOUNCED = []


def switch_mind(mid):
    """One mind switch, through the door that can ask.

    `yos act` puts the approval card up, waits for the person, and acts again with the
    grant; a raw `app.act` cannot, and in ask mode it is refused with GRANT before the
    handler runs. "Allow for this session" on the first card covers the switches after it,
    so the run asks a person at most once.
    """
    mind_switch_gate()
    if BASELINE.get("mode") not in ("auto", "bypass") and not _MIND_CARD_ANNOUNCED:
        _MIND_CARD_ANNOUNCED.append(mid)
        print("\n   >>> A card is going up for shell.use_harness — sensitive, because it writes the "
              "preferred-mind setting (#48). Press ALLOW FOR THIS SESSION on the VM and the "
              "switches after this one run unasked.", flush=True)
    code, out = sh("yos act shell use_harness id=%s" % mid, timeout=200)
    if "accepted: True" not in out:
        raise Failed("could not switch to mind %s: %s" % (mid, out[-200:]))


# ── ci: the desktop answers for itself ──────────────────────────────────────────────────────

BASELINE = {}


@check("the shell answers, and says which build it is")
def _shell():
    d = shell()
    st = d.get("state", {})
    if not st.get("version"):
        raise Failed("describe shell has no version")
    build = open("/opt/yantrik/BUILD").read() if os.path.exists("/opt/yantrik/BUILD") else ""
    recorded = next((l.split("=", 1)[1].strip() for l in build.splitlines() if l.startswith("version=")), "")
    if recorded and recorded != st.get("version"):
        raise Failed("the shell says %s but this machine's BUILD says %s — the shell read it before the "
                     "last install and has not restarted, or the install did not record itself"
                     % (st.get("version"), recorded))
    BASELINE["windows"] = {w.get("title") for w in st.get("windows", [])}
    BASELINE["problems"] = {p.get("id") or json.dumps(p) for p in st.get("problems", [])}
    BASELINE["mind"] = next((m.get("id") for m in st.get("minds", []) if m.get("active")), None)
    return "version %s, %d actions, screen %s" % (st.get("version"), len(d.get("actions", [])), st.get("screen"))


@check("the mind mode is published for every app to read")
def _mode_file():
    path = os.path.expanduser("~/.config/yantrik/mind-mode.json")
    if not os.path.exists(path):
        raise Failed("%s is missing: apps would all read Ask, whatever the person chose" % path)
    doc = json.load(open(path))
    if doc.get("mode") not in ("plan", "ask", "auto", "bypass"):
        raise Failed("mode %r is not one this OS defines" % doc.get("mode"))
    # The mode alone proves nothing: the apps trust the file only while the shell it names is
    # running, in this boot, and read any other file as Ask whatever mode it says (#154,
    # #333). So the name is checked against the shell that is actually running — a stale file
    # here means every dispatch on this machine is enforcing Ask while the chip shows
    # something else.
    pid = shell_pid()
    if pid is None:
        raise Failed("no yantrik-ui process is running for the mode file to name")
    stat = open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()
    boot = open("/proc/sys/kernel/random/boot_id").read().strip()
    problems = []
    if doc.get("shell_pid") != pid:
        problems.append("names shell_pid %r, and the shell running is pid %d"
                        % (doc.get("shell_pid"), pid))
    if doc.get("shell_start_ticks") != int(stat[19]):
        problems.append("names shell_start_ticks %r, and the kernel gives pid %d %s"
                        % (doc.get("shell_start_ticks"), pid, stat[19]))
    if doc.get("boot_id") != boot:
        problems.append("names boot_id %r, and this boot is %s" % (doc.get("boot_id"), boot))
    if problems:
        raise Failed("mind-mode.json does not name the running shell: %s — apps would all "
                     "read Ask, whatever the person chose" % "; ".join(problems))
    BASELINE["mode"] = doc["mode"]
    return "mode %s, and the file names the shell that is running (pid %d, this boot)" % (
        doc["mode"], pid)


# The commands the image is built to ship, and what each one is for on a Yantrik machine.
# An installed machine is kept current by yantrik-update, which replaces /opt/yantrik and
# nothing else, so a package the image gained after an install never reaches the base system
# until the updater reconciles it (#210: VM 520 had no `ip`, `ss` or `ping`). The names here
# are commands, not packages — they are what the shipped code and the person at the keyboard
# actually run — and they must stay in step with REQUIRED_PACKAGES in yantrik-update.
IMAGE_COMMANDS = {
    "ip": "the network tools and every `ip addr` a person types (iproute2)",
    "ss": "socket listings the mind runs (iproute2)",
    "ping": "the reachability check, and the first thing anyone tries on a broken network (iputils-ping)",
    "grim": "every screenshot the desktop takes",
    "curl": "the updater's downloads and the mind's fetches",
    "python3": "yos itself is a python3 script",
    "nano": "EDITOR, exported by yantrik-session",
    "htop": "the process view beside the System Monitor app",
}


@check("every command the image ships is installed and answers on PATH")
def _image_commands():
    missing = [name for name in IMAGE_COMMANDS if not shutil.which(name)]
    if missing:
        raise Failed("not on PATH: %s — a machine from an older image is drifted; yantrik-update "
                     "reconcile installs the packages behind them (%s)"
                     % (", ".join(missing), "; ".join(IMAGE_COMMANDS[m] for m in missing)))
    return "%d/%d present: %s" % (len(IMAGE_COMMANDS), len(IMAGE_COMMANDS), " ".join(sorted(IMAGE_COMMANDS)))


@check("every action on every surface declares a grade")
def _grades():
    bad, n = [], 0
    for a in shell().get("actions", []):
        n += 1
        if a.get("permission") not in GRADES:
            bad.append("shell.%s=%r" % (a.get("name"), a.get("permission")))
    if bad:
        raise Failed("; ".join(bad[:8]))
    return "%d shell actions graded" % n


@check("every app opens, answers on its surface, and grades its actions")
def _apps():
    apps = [a for a in state().get("apps", []) if a.get("opens") == "app" and a.get("describe_as")]
    only = [a for a in apps if not any(s in a["name"] for s in ARGS.skip)]
    opened, problems, counts = [], [], []
    for a in only:
        surface = a["describe_as"]
        try:
            act("shell", "open_app", name=a["name"])
        except Exception as e:  # noqa: BLE001
            # No carve-out for "not installed": an app whose program is not on this machine has
            # no row in the listing at all (#214), so everything listed here opens. A refusal is
            # this build's fault and fails this check like any other.
            problems.append("%s: open_app refused: %s" % (a["name"], e))
            continue
        d = wait(lambda: rpc(surface, "app.describe", timeout=10), SLOW_APPS.get(a["name"], 30), 2)
        if not d:
            problems.append("%s: no answer on `%s` within %ds" % (a["name"], surface, SLOW_APPS.get(a["name"], 30)))
            continue
        opened.append(a["name"])
        acts = d.get("actions", [])
        ungraded = [x.get("name") for x in acts if x.get("permission") not in GRADES]
        if ungraded:
            problems.append("%s: ungraded %s" % (a["name"], ungraded[:5]))
        counts.append("%s %d" % (a["name"], len(acts)))
    time.sleep(5)  # past the shell's launch grace, so closing is not read as a failed launch
    close_test_windows()
    if problems:
        raise Failed("; ".join(problems))
    if not opened:
        raise Failed("no app opened at all")
    return "%d apps: %s" % (len(opened), ", ".join(counts))


SHIPPED_APPLICATIONS = "/opt/yantrik/share/applications"


@check("every surface a shipped .desktop file declares is listed, and answers to its aliases")
def _declared():
    """The apps are found by their .desktop files now (X-Yantrik-Surface / -Purpose / -Aliases), so
    a machine that got the binaries and not the files has apps nobody can find while they are
    closed, and names nothing answers to. Checked against the files this OS installs, not the
    repository: what is on this machine is what the shell reads."""
    declared = getattr(yos, "declared_surfaces", None)
    if declared is None:
        raise Failed("the installed yos cannot read .desktop declarations; it is older than the shell")
    surfaces = declared([SHIPPED_APPLICATIONS])
    if not surfaces:
        raise Failed("no entry in %s declares X-Yantrik-Surface: the .desktop files are missing or "
                     "from an older release, so no app of ours is listed while closed"
                     % SHIPPED_APPLICATIONS)
    listed = {a.get("describe_as"): a for a in state().get("apps", [])
              if a.get("opens") == "app" and a.get("describe_as")}
    socket_dir = yos.SOCKET_DIRS[0]
    problems = []
    for s in surfaces:
        row = listed.get(s["id"])
        if row is None:
            # The first directory in the search order wins, so an older copy of the same entry
            # earlier on XDG_DATA_DIRS hides this one — the likeliest cause after a missing program.
            name = s["entry"] + ".desktop"
            first = next((d for d in yos.application_dirs()
                          if os.path.exists(os.path.join(d, name))), SHIPPED_APPLICATIONS)
            why = ("an older %s in %s shadows it" % (name, first) if first != SHIPPED_APPLICATIONS
                   else "is its program installed?")
            problems.append("%s: declared by %s and not in describe shell -> apps (%s)"
                            % (s["id"], name, why))
            continue
        missing = [a for a in s["aliases"] if a not in (row.get("aliases") or [])]
        if missing:
            problems.append("%s: the shell does not list its aliases %s" % (s["id"], missing))
        # The shell links every alias at the surface's socket, running or not.
        for alias in s["aliases"]:
            link = os.path.join(socket_dir, "app-%s.sock" % alias)
            if os.path.islink(link) and os.readlink(link) == "app-%s.sock" % s["id"]:
                continue
            problems.append("%s: %s is not a link to app-%s.sock" % (s["id"], link, s["id"]))
    if problems:
        raise Failed("; ".join(problems[:8]))

    # And `open_app` by an alias opens the app it names and says what to describe it by. One app,
    # a light one: every app was already opened by name above.
    pick = next((s for s in surfaces if s["id"] == "system-monitor" and s["aliases"]), None) \
        or next((s for s in surfaces if s["aliases"]), None)
    if pick is None:
        return "%d declared surfaces listed; none has an alias to open by" % len(surfaces)
    alias = pick["aliases"][0]
    answer = act("shell", "open_app", name=alias)
    said = (answer.get("result") or {}).get("describe_as")
    if said != pick["id"]:
        raise Failed("open_app name=%s answered describe_as=%r, not %r" % (alias, said, pick["id"]))
    d = wait(lambda: rpc(alias, "app.describe", timeout=10), 30, 2)
    time.sleep(5)  # past the shell's launch grace, so closing is not read as a failed launch
    close_test_windows()
    if not d or d.get("app") != pick["id"]:
        raise Failed("opened as `%s`, and describing `%s` answered %r"
                     % (alias, alias, (d or {}).get("app")))
    return "%d declared surfaces listed with their aliases linked; open_app %s -> %s" % (
        len(surfaces), alias, pick["id"])


def extra_windows():
    return [w.get("title") for w in state().get("windows", [])
            if w.get("title") and w.get("title") not in BASELINE.get("windows", set())]


def close_test_windows():
    """Close what the checks opened, and wait until the window list agrees. The list is read from
    the compositor at most every nine seconds (COMPOSITOR_TTL), so a window asked to close stays in
    it for a while; a check that ran straight after would count windows that are already going."""
    for t in extra_windows():
        try:
            act("shell", "close_window", title=t, timeout=10)
        except Exception:  # noqa: BLE001 — a window that asks to save may stay; that is its right
            pass
    wait(lambda: not extra_windows(), 30, 2)


@check("every screen of the desktop shows when asked")
def _screens():
    entries = [a for a in state().get("apps", [])
               if a.get("describe_as") == "shell"
               and (str(a.get("opens", "")).startswith("a screen") or a.get("show_with"))]
    screens = [a["name"] for a in entries]
    wrong = []
    for a in entries:
        s = a["name"]
        how = a.get("show_with") or {"screen": s}
        want = how.get("screen", s)
        try:
            act("shell", "show_screen", timeout=15, **{k: v for k, v in how.items() if k != "action"})
        except Exception as e:  # noqa: BLE001
            wrong.append("%s refused: %s" % (s, str(e)[:80]))
            continue
        seen = wait(lambda: state().get("screen"), 5)
        if seen != want:
            wrong.append("%s showed %r" % (s, seen))
    act("shell", "show_screen", screen="desktop", timeout=15)
    if wrong:
        raise Failed("; ".join(wrong))
    return "%d screens: %s" % (len(screens), ", ".join(screens))


@check("a sensitive act without a grant is refused on every door")
def _gate():
    mode = BASELINE.get("mode", "ask")
    if mode in ("auto", "bypass"):
        raise Skipped("the machine is in %s mode, where sensitive acts run unasked by design" % mode)
    act("shell", "open_app", name="studio")
    if not wait(lambda: rpc("studio", "app.describe", timeout=10), 30, 2):
        raise Failed("Studio did not open, so there was nothing to test the gate on")
    seen = []
    code, out = sh("yos act --no-ask studio set_backend kind=fake")
    seen.append(("yos --no-ask", "GRANT:" in out, out[:90]))
    try:
        rpc("studio", "app.act", {"action": "set_backend", "args": {"kind": "fake"}})
        seen.append(("raw socket", False, "it ran"))
    except Exception as e:  # noqa: BLE001
        seen.append(("raw socket", "GRANT:" in str(e), str(e)[:90]))
    time.sleep(5)
    close_test_windows()
    open_doors = [d for d, refused, _ in seen if not refused]
    if open_doors:
        raise Failed("ran without a grant through: %s — %s" % (open_doors, seen))
    return "refused on %s" % ", ".join(d for d, _, _ in seen)


@check("the machine ceiling holds, on a service as well as an app")
def _ceiling():
    victim = subprocess.Popen(["sleep", "300"])
    try:
        try:
            r = rpc("system-monitor", "app.act", {"action": "kill_process", "args": {"pid": victim.pid}})
            answer = json.dumps(r)[:120]
        except Exception as e:  # noqa: BLE001
            answer = str(e)[:120]
        time.sleep(1)
        alive = victim.poll() is None
        if not alive:
            raise Failed("system-monitor.kill_process ended pid %d with no grant: %s" % (victim.pid, answer))
        return "kill_process refused, the process lives: %s" % answer
    finally:
        victim.kill()


@check("a notification is filed under who sent it, not under the desktop's name")
def _notify():
    code, out = sh("yos notify 'release-check' 'provenance probe'")
    if code != 0:
        raise Failed(out[:200])
    frm = out.split("(from", 1)[-1].split(")", 1)[0].strip() if "(from" in out else ""
    nid = out.split()[0] if out else ""
    try:
        act("notifications", "dismiss", id=nid, timeout=10)
    except Exception:  # noqa: BLE001
        pass
    if not frm or frm.lower() == "yantrik":
        raise Failed("filed as %r: %s" % (frm, out[:120]))
    return "filed as %r" % frm


@check("the Agents workspace is wired in")
def _agents_wired():
    st = state()
    missing = [k for k in ("agent_jobs",) if k not in st]
    act("shell", "show_screen", screen="agents", timeout=15)
    seen = wait(lambda: state().get("screen"), 5)
    act("shell", "show_screen", screen="desktop", timeout=15)
    if missing or seen != "agents":
        raise Failed("describe lacks %s; show_screen agents showed %r" % (missing, seen))
    return "agents screen shows; agent_jobs published"


@check("the build carries its changelog")
def _changelog():
    path = "/opt/yantrik/share/CHANGELOG.md"
    if not os.path.exists(path):
        build = open("/opt/yantrik/BUILD").read() if os.path.exists("/opt/yantrik/BUILD") else ""
        if not build or "name=dev-deploy" in build or "-dev" in build:
            raise Skipped("a developer deploy (BUILD: %s), not a release bundle"
                          % (build.replace(chr(10), " ")[:80] or "none"))
        raise Failed("%s is missing from a release bundle" % path)
    lines = [l for l in open(path, encoding="utf-8") if l.startswith("- ")]
    return "%d changes listed" % len(lines)


@check("the shell is idle when nothing is happening")
def _idle():
    close_test_windows()
    pid = shell_pid()
    if not pid:
        raise Failed("no yantrik-ui process")
    tick = os.sysconf("SC_CLK_TCK")

    def cpu():
        f = open("/proc/%d/stat" % pid).read().rsplit(")", 1)[1].split()
        return int(f[11]) + int(f[12])
    time.sleep(3)
    a, t0 = cpu(), time.time()
    time.sleep(10)
    pct = 100.0 * (cpu() - a) / tick / (time.time() - t0)
    rss = int(open("/proc/%d/status" % pid).read().split("VmRSS:")[1].split()[0]) // 1024
    msg = "%.1f%% of one core over 10 s, %d MB resident, %d windows open" % (pct, rss, len(state().get("windows", [])))
    if pct > 25 or rss > 800:
        raise Failed(msg)
    return msg


@check("nothing crashed while the checks ran")
def _problems():
    now = {p.get("id") or json.dumps(p) for p in state().get("problems", [])}
    new = now - BASELINE.get("problems", set())
    if new:
        raise Failed("new problem records: %s" % sorted(new)[:5])
    return "no new problem records (%d on file)" % len(now)


# ── rc: a real machine, with its minds ──────────────────────────────────────────────────────

@check("every attached mind answers", tier="rc")
def _minds():
    mind_switch_gate()
    minds = [m for m in state().get("minds", []) if m.get("id")]
    report, dead = [], []
    base_active = BASELINE.get("mind")
    for m in minds:
        mid = m["id"]
        t0 = time.time()
        try:
            switch_mind(mid)
            conv = state().get("conversation", [])
            base = max((c.get("index", -1) for c in conv), default=-1)
            act("shell", "send_message", text="Release check: reply with exactly one word, READY.")

            def reply():
                c = [x for x in state().get("conversation", []) if x.get("index", -1) > base and x.get("role") != "user"]
                return c[-1] if c and not c[-1].get("streaming") else None
            r = wait(reply, 150, 3)
            text = (r or {}).get("text", "")
            secs = time.time() - t0
            ok = "READY" in text.upper()
            report.append("%s %s %.0fs" % (mid, "ok" if ok else "BAD", secs))
            if not ok:
                dead.append("%s: %r" % (mid, text[:100] or "no answer in 150 s"))
        except Exception as e:  # noqa: BLE001
            dead.append("%s: %s" % (mid, str(e)[:100]))
    if base_active:
        try:
            switch_mind(base_active)
        except Exception:  # noqa: BLE001
            pass
    if dead:
        raise Failed("; ".join(dead) + " | " + ", ".join(report))
    return ", ".join(report)


def cdp(path, method="GET", timeout=5):
    """One request to the browser's DevTools endpoint: its JSON, its text, or None when no
    drivable browser answers."""
    import urllib.error
    import urllib.request
    try:
        with urllib.request.urlopen(urllib.request.Request(yos.CDP + path, method=method),
                                    timeout=timeout) as reply:
            body = reply.read().decode("utf-8", "replace")
    except (urllib.error.URLError, OSError):
        return None
    try:
        return json.loads(body)
    except ValueError:
        return body  # /json/close answers in words


def pages():
    return [t for t in (cdp("/json/list") or []) if isinstance(t, dict) and t.get("type") == "page"]


def close_own_tabs(own, started_here):
    """Close the tabs this run made, and let the browser go if it came up for this run.

    Returns what is left, in words, and whether the browser this run started is still running
    with nothing of anyone's in it — which is a failure: the run left something open."""
    for tab in own:
        cdp("/json/close/%s" % tab)
    if not started_here:
        return "closed its own tab; the browser that was already open is as it was", True
    # The browser came up for this run. With its last tab gone it closes its window and exits —
    # unless somebody opened a tab in it meanwhile, and then that tab is theirs and it stays.
    if wait(lambda: cdp("/json/version") is None, 15, 1):
        return "closed its tabs, and the browser it opened has exited", True
    others = [t for t in pages() if t.get("id") not in own]
    if others:
        return ("closed its own tabs; the browser it opened stays for %d tab(s) opened in it "
                "meanwhile" % len(others)), True
    # Nobody's tab is left and it has not gone: ask it to.
    try:
        from websocket import create_connection
        ws = create_connection(cdp("/json/version")["webSocketDebuggerUrl"], origin=yos.CDP, timeout=10)
        ws.send(json.dumps({"id": 1, "method": "Browser.close"}))
        ws.close()
    except Exception:  # noqa: BLE001 — what is left is said below
        pass
    if wait(lambda: cdp("/json/version") is None, 15, 1):
        return "closed its tabs, and asked the browser it opened to close, which it did", True
    return "closed its tabs, but the browser it opened is still running with no tab in it", False


@check("the browser can be driven: go to a page and read it back", tier="rc")
def _browser():
    """Drive the desktop's browser through `yos web`, in a tab of the run's own, and close what the
    run opened — and nothing a person had open.

    Tabs are told apart by their DevTools target id. The tab driven is one this check asks the
    browser for (`/json/new`), so its id is known; `YOS_WEB_TAB` points `yos web` at that tab and
    no other, and it is the tab closed after (`/json/close/<id>`). The browser is this run's when
    nothing answered on the DevTools port before the check opened one: then the tabs it came up
    with are the run's too, and once they are closed it exits. A browser that was already open is
    left as it was. The window list is no use for this — a browser window is titled after its
    front tab, so a person's window with the run's tab in front reads like one the run opened —
    which is why `close_test_windows` is not called here; the last check looks for anything titled
    after the run's page (`release-check page …`) that is still open."""
    if "YOS_WEB_TAB" not in (yos.__doc__ or ""):
        raise Failed("the installed yos cannot drive one tab (YOS_WEB_TAB); it would drive the "
                     "browser's front page, which may be somebody's, so nothing was driven")
    phrase = "release-check page %d" % os.getpid()

    class Page(http.server.BaseHTTPRequestHandler):
        def do_GET(self):  # noqa: N802
            # Titled with the phrase, so the window it is in is recognisably the run's.
            body = ("<html><head><title>%s</title></head><body><h1>%s</h1><button>Harmless</button>"
                    "</body></html>" % (phrase, phrase)).encode()
            self.send_response(200)
            self.send_header("Content-Type", "text/html")
            self.end_headers()
            self.wfile.write(body)

        def log_message(self, *a):
            pass
    srv = http.server.ThreadingHTTPServer(("127.0.0.1", 0), Page)
    threading.Thread(target=srv.serve_forever, daemon=True).start()
    own, started_here, closed = [], False, None
    try:
        if cdp("/json/version") is None:
            started_here = True
            act("shell", "open_app", name="browser")
            if not wait(lambda: cdp("/json/version"), 30, 1):
                raise Failed("the browser did not come up drivable on %s within 30 s" % yos.CDP)
            # What it opened with — a new-tab page — is the run's, like the browser.
            wait(lambda: pages(), 10, 0.5)
            own.extend(t["id"] for t in pages())
        # PUT since Chromium 111; a GET on an older one.
        tab = cdp("/json/new?about:blank", method="PUT")
        if not isinstance(tab, dict):
            tab = cdp("/json/new?about:blank")
        if not isinstance(tab, dict) or not tab.get("id"):
            raise Failed("the browser would not open a tab for the check: %r" % (tab,))
        own.append(tab["id"])
        mine = "YOS_WEB_TAB=%s " % tab["id"]
        code, out = sh(mine + "yos web go http://127.0.0.1:%d/" % srv.server_address[1])
        text = wait(lambda: (lambda t: t if phrase in t else None)(sh(mine + "yos web text")[1]), 20, 2)
        if not text:
            raise Failed("the page did not read back within 20 s: go=%r last text=%r"
                         % (out[:100], sh(mine + "yos web text")[1][:160]))
        closed, ok = close_own_tabs(own, started_here)
        if not ok:
            raise Failed("went to a local page and read %r back, but %s" % (phrase, closed))
        return "went to a local page in a tab of its own and read %r back; %s" % (phrase, closed)
    finally:
        srv.shutdown()
        if closed is None:
            close_own_tabs(own, started_here)


@check("a sensitive act through `yos` asks, and runs once a person allows it", tier="rc", interactive=True)
def _allow():
    if BASELINE.get("mode") in ("auto", "bypass"):
        raise Skipped("mode %s runs it unasked" % BASELINE.get("mode"))
    act("shell", "open_app", name="studio")
    wait(lambda: rpc("studio", "app.describe", timeout=10), 30, 2)
    print("\n   >>> A card is going up for studio.set_backend kind=fake. Press ALLOW ONCE on the VM (120 s).",
          flush=True)
    code, out = sh("yos act studio set_backend kind=fake", timeout=200)
    close_test_windows()
    if "accepted: True" not in out:
        raise Failed("after asking: %s" % out[-200:])
    return "asked, was allowed, ran"


@check("a mind's command runs in its own pane with its exit code", tier="rc", interactive=True)
def _agent_command():
    minds = [m.get("id") for m in state().get("minds", [])]
    if "pi" not in minds:
        raise Skipped("pi is not attached; this check drives pi's own bash tool")
    switch_mind("pi")
    print("\n   >>> pi will ask to run a command: press ALLOW ONCE on the card (180 s).", flush=True)
    act("shell", "send_message",
        text="Release check: use your bash tool to run exactly this command and nothing else: "
             "echo release-check-ok; exit 3 — then tell me the exit code.")

    def seen():
        for a in state().get("agents", []):
            for job in a.get("jobs", []) + a.get("finished_jobs", []):
                if "release-check-ok" in json.dumps(job):
                    return a, job
        return None
    found = wait(seen, 180, 3)
    if not found:
        raise Failed("no agent ran the command in its own terminal within 180 s "
                     "(describe shell agents: %s)" % json.dumps(state().get("agents", []))[:300])
    agent, job = found
    return "%s ran it: %s" % (agent.get("id"), json.dumps(job)[:160])


# ── last: what the run leaves behind ────────────────────────────────────────────────────────

# Last of every check that runs on an unlocked machine, in every tier, so it sees what every
# check before it left. It ran in the middle of ci, and the rc browser check that came later
# left its own page open in Chromium where nothing looked (#190). Only the locked-desktop check
# comes after, and only because it must: it leaves the machine locked and nothing on this socket
# can undo that, so anything that looked at the machine afterwards would see it through the lock.
@check("no launch failed, no window is listed twice, and no window of the run's is left open")
def _windows():
    def left_open():
        return [t for t in (w.get("title") or "" for w in state().get("windows", []))
                if "release-check page" in t]
    # The window list is up to nine seconds old (COMPOSITOR_TTL): a window closed a moment ago
    # may still be in it, so its going is waited for before it is called left open.
    wait(lambda: not left_open(), 30, 3)
    st = state()
    failed = st.get("failed_launches", [])
    titles = [w.get("title") for w in st.get("windows", [])]
    dupes = sorted({t for t in titles if titles.count(t) > 1})
    msgs = []
    if failed:
        msgs.append("failed launches: %s" % json.dumps(failed)[:300])
    if dupes:
        msgs.append("listed twice: %s (%s)" % (dupes, [(w.get("app"), w.get("title")[:30]) for w in st.get("windows", []) if w.get("title") in dupes]))
    left = left_open()
    if left:
        msgs.append("left open by this run: %s" % left)
    if msgs:
        raise Failed("; ".join(msgs))
    return "%d windows, none twice, none of the run's left open, no failed launch" % len(titles)


@check("a locked desktop refuses to be taken anywhere")
def _locked():
    # #203: the login screen could be walked straight past — `yos act shell open_lens` took the
    # desktop to the Lens with no credentials. Locked is a state now, held at the dispatch, and
    # this is the check that it holds on a shipped machine. It runs last because it leaves the
    # machine locked and nothing on this socket can undo that — which is the fix. The boottest's
    # QEMU is thrown away afterwards; on a real machine a person unlocks at the keyboard, and the
    # manual list already says so.
    if state().get("screen") not in ("lock", "login"):
        act("shell", "lock", timeout=15)
        if not wait(lambda: state().get("screen") == "lock", 15):
            raise Failed("shell.lock did not lock: screen is %r" % state().get("screen"))
    st = state()
    if st.get("locked") is not True:
        raise Failed("a locked desktop does not say locked: true: %s" % json.dumps(st)[:200])
    seen = []
    for action, args in (("open_lens", {}), ("show_screen", {"screen": "desktop"})):
        try:
            act("shell", action, timeout=15, **args)
            seen.append(("raw socket %s" % action, False, "it ran"))
        except Exception as e:  # noqa: BLE001
            seen.append(("raw socket %s" % action, "LOCKED:" in str(e), str(e)[:90]))
        code, out = sh("yos act --no-ask shell %s%s"
                       % (action, "".join(" %s=%s" % kv for kv in args.items())), timeout=30)
        seen.append(("yos %s" % action, "LOCKED:" in out, out[:90]))
    screen = state().get("screen")
    open_doors = [d for d, refused, _ in seen if not refused]
    if screen not in ("lock", "login"):
        open_doors.append("the refusals did not hold the screen: %r" % screen)
    if open_doors:
        raise Failed("on a locked desktop: %s — %s" % (open_doors, seen))
    return "open_lens and show_screen refused with LOCKED: over the socket and the CLI; the screen is still %s" % screen


