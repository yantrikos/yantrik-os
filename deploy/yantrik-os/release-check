# ── run ─────────────────────────────────────────────────────────────────────────────────────

def main():
    started = time.time()
    tiers = ("ci",) if ARGS.tier == "ci" else ("ci", "rc")
    print("release-check — tier %s%s" % (ARGS.tier, ", interactive" if ARGS.interactive else ""), flush=True)
    for c in CHECKS:
        if c["tier"] not in tiers or (c["interactive"] and not ARGS.interactive):
            continue
        if ARGS.only and not any(w in c["name"] for w in ARGS.only):
            continue
        t0 = time.time()
        try:
            evidence, verdict = c["fn"](), "PASS"
        except Skipped as e:
            evidence, verdict = str(e), "SKIP"
        except Failed as e:
            evidence, verdict = str(e), "FAIL"
        except Exception as e:  # noqa: BLE001 — a check that broke is a failure, with its error
            evidence, verdict = "%s: %s" % (type(e).__name__, e), "FAIL"
        RESULTS.append({"check": c["name"], "tier": c["tier"], "verdict": verdict,
                        "evidence": evidence, "seconds": round(time.time() - t0, 1)})
        print("%-4s %s  (%.0fs)\n     %s" % (verdict, c["name"], time.time() - t0, evidence), flush=True)
    failed = [r for r in RESULTS if r["verdict"] == "FAIL"]
    print("\n%d passed, %d skipped, %d failed in %.0f s" % (
        sum(r["verdict"] == "PASS" for r in RESULTS), sum(r["verdict"] == "SKIP" for r in RESULTS),
        len(failed), time.time() - started))
    if ARGS.tier == "rc":
        print("\nBy hand, before tagging:")
        for i, m in enumerate(MANUAL, 1):
            print("  [ ] %d. %s" % (i, m))
    if ARGS.json:
        json.dump({"tier": ARGS.tier, "results": RESULTS, "manual": MANUAL if ARGS.tier == "rc" else []},
                  open(ARGS.json, "w"), indent=1)
    sys.exit(1 if failed else 0)


if __name__ == "__main__":
    ap = argparse.ArgumentParser(description=__doc__.split("\n\n")[0])
    ap.add_argument("--tier", choices=("ci", "rc"), default="ci")
    ap.add_argument("--interactive", action="store_true", help="include the checks a person takes part in")
    ap.add_argument("--json")
    ap.add_argument("--only", action="append", default=[])
    ap.add_argument("--skip", action="append", default=[], help="skip apps whose id contains this")
    ARGS = ap.parse_args()
    main()
