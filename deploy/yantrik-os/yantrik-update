    "$(cmp -s "$gd/hand" "$gd/default/grub" && echo yes || echo no)|$([ -e "$gd/calls" ] && echo yes || echo no)"
  t "console arguments: ... and said so" "sets GRUB_CMDLINE_LINUX_DEFAULT itself" "$out"
  # A LUKS machine's own lines beside the old one: the kernel line and the cryptodisk line stay
