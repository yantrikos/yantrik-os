  t "theme: ... and said so" "not root's alone to write" "$out"
  ga_old; printf 'GRUB_THEME="/boot/grub/themes/other/theme.txt"\n' >> "$gd/default/grub"; gr_run ok >/dev/null
  is "theme: a theme the file names already: kept, none added, the terminals still moved" \
