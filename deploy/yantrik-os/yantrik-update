  grub_defaults_rewrite 0 0 "$gd/default/grub.before-20261016T000000Z" 0 1 > "$gd/default/grub"
  out="$(gr_run ok)"
  is "console arguments: an interrupted run is finished by the next one" "regenerate|yes|yes" \
    "$(cat "$gd/calls" 2>/dev/null)|$(grep -qF " $GRUB_DEFAULT_CONSOLE" "$gd/boot/grub.cfg" && echo yes || echo no)|$([ -f "$gcur" ] && echo yes || echo no)"
  is "console arguments: ... and a run after that does nothing" "" "$(rm -f "$gd/calls"; gr_run ok; cat "$gd/calls" 2>/dev/null)"
  gc_old 'quiet splash'; grub_defaults_rewrite 0 0 "$gd/default/grub" 0 1 > "$gd/one"; mv "$gd/one" "$gd/default/grub"
  out="$(gr_run ok)"
  is "console arguments: the new line with no copy of ours beside it is not regenerated" "" "$(cat "$gd/calls" 2>/dev/null)$out"

  # The theme from this build's share/grub-theme (#835's 541 retest: the 12 Oct image has none):
  # copied when every file is one the build lists with its hash, and only then.
  local gsh="$gd/share/grub-theme"
  gb_make() { # a bundle's theme and the root-files list naming it
    rm -rf "${gd:?}/share" "${gd:?}/bin"; mkdir -p "$gsh" "$gd/bin" "$gd/share/root-helpers"
    printf 'title-text: ""\ndesktop-color: "#0e1018"\n' > "$gsh/theme.txt"; printf 'png\n' > "$gsh/icon.png"; printf 'pf2\n' > "$gsh/dejavusans_16.pf2"
    printf 'helper\n' > "$gd/share/root-helpers/yantrik-pkg"
    chmod 0755 "$gd/share" "$gsh"; chmod 0644 "$gsh"/*
    (cd "$gd/share" && sha256sum root-helpers/* grub-theme/*) > "$gd/bin/yantrik-root-files.sha256"
  }
  gb_make; rm -rf "${gd:?}/theme-src" "${gd:?}/boot/themes"
  GA_DEFAULT='quiet splash loglevel=3 plymouth.use-simpledrm plymouth.ignore-serial-consoles'
  ga_old; cp -p "$gd/default/grub" "$gd/hand"; out="$(gr_run ok)"
  is "541 as it was: the terminals, the console arguments and the build's theme, all in one rewrite" \
    "$(GA_DEFAULT='' ga_new; printf '%s\n' "$GRUB_THEME_LINE")" "$(cat "$gd/default/grub")"
  is "541 as it was: ... one copy as it was, one regeneration, gfxterm alone, the console arguments on the normal entry" \
    "1|yes|regenerate|terminal_output gfxterm|yes" \
    "$(find "$gd/default" -name 'grub.before-*' | wc -l)|$(cmp -s "$gd/hand" "$gd/default"/grub.before-* && echo yes || echo no)|$(cat "$gd/calls")|$(grep terminal_output "$gd/boot/grub.cfg")|$(grep -qF " $GRUB_DEFAULT_CONSOLE" "$gd/boot/grub.cfg" && echo yes || echo no)"
  is "541 as it was: ... the build's theme copied into /boot as it shipped, root's, and the cursor line" "same|0|yes" \
    "$(diff -r "$gsh" "$gth" >/dev/null 2>&1 && echo same || echo differs)|$(find "$gth" ! -user "$(id -u)" | wc -l)|$([ -f "$gcur" ] && echo yes || echo no)"
  t "541 as it was: ... and it says all three: the terminal" "drawn on the screen alone" "$out"
  t "541 as it was: ... the theme" "the menu has the Yantrik theme" "$out"
  t "541 as it was: ... the console" "the splash's ground with no cursor" "$out"
  is "541 as it was: ... and a second run does nothing" "" "$(rm -f "$gd/calls"; gr_run ok; cat "$gd/calls" 2>/dev/null)"
  ga_old "$GRUB_CMDLINE_OLD"; rm -rf "${gd:?}/boot/themes"; cp -p "$gd/default/grub" "$gd/hand"; out="$(gr_run ok)"
  is "541 before 16 Oct, with #829's kernel line too: all four changes, one copy, one regeneration" \
    "$(GA_DEFAULT='' ga_new; printf '%s\n' "$GRUB_THEME_LINE")|1|yes|regenerate" \
    "$(cat "$gd/default/grub")|$(find "$gd/default" -name 'grub.before-*' | wc -l)|$(cmp -s "$gd/hand" "$gd/default"/grub.before-* && echo yes || echo no)|$(cat "$gd/calls")"
  for gm in fail by-device; do
    ga_old; rm -rf "${gd:?}/boot/themes" "${gd:?}/tmpfiles.d"; cp -p "$gd/default/grub" "$gd/hand"; gcfg="$(cat "$gd/boot/grub.cfg")"; out="$(gr_run "$gm")"
    is "541 as it was: regeneration $gm: file and menu put back, the theme and cursor line this run made taken away, nothing else" "yes|$gcfg|no|no|yes" \
      "$(cmp -s "$gd/hand" "$gd/default/grub" && echo yes || echo no)|$(cat "$gd/boot/grub.cfg")|$([ -e "$gth" ] && echo yes || echo no)|$([ -e "$gcur" ] && echo yes || echo no)|$([ -f "$gsh/theme.txt" ] && echo yes || echo no)"
  done
  rmdir "$gd/efi"; ga_old; rm -rf "${gd:?}/boot/themes"; out="$(gr_run ok)"; mkdir -p "$gd/efi"
  is "541 as it was, on BIOS: the terminals and the console arguments, and no theme" \
    "$(GA_DEFAULT='' ga_new)|no" "$(cat "$gd/default/grub")|$([ -e "$gth" ] && echo yes || echo no)"
  # What the build's tree must be before root copies it.
  gb_try() { # the number of theme lines and whether /boot has a theme, after a run; what it said in $gd/said
    rm -rf "${gd:?}/boot/themes"; ga_old; gr_run ok > "$gd/said"
    printf '%s|%s' "$(grep -c '^GRUB_THEME=' "$gd/default/grub")" "$([ -e "$gth" ] && echo yes || echo no)"
  }
  gb_make; printf 'other\n' > "$gsh/icon.png"
  is "theme from the build: a file that is not what the build shipped: not copied" "0|no" "$(gb_try)"
  t "theme from the build: ... and said so" "is not what this build ships" "$(cat "$gd/said")"
  gb_make; printf 'x\n' > "$gsh/extra.png"; chmod 0644 "$gsh/extra.png"
  is "theme from the build: a file the build does not list: not copied" "0|no" "$(gb_try)"
  gb_make; rm -f "$gsh/dejavusans_16.pf2"
  is "theme from the build: a file the build lists is missing: not copied" "0|no" "$(gb_try)"
  t "theme from the build: ... and said so" "lacks files this build ships" "$(cat "$gd/said")"
  gb_make; rm -f "$gsh/icon.png"; ln -s /etc/hostname "$gsh/icon.png"
  is "theme from the build: a link in it: not copied" "0|no" "$(gb_try)"
  for gdot in .hidden ..hidden; do
    gb_make; printf 'x\n' > "$gsh/$gdot"; chmod 0644 "$gsh/$gdot"
    is "theme from the build: a file named $gdot the build does not list: not copied" "0|no" "$(gb_try)"
  done
  gb_make; mkdir "$gsh/sub"
  is "theme from the build: a directory in it: not copied" "0|no" "$(gb_try)"
  gb_make; chmod g+w "$gd/share"
  is "theme from the build: a share/ others could write: not copied" "0|no" "$(gb_try)"
  gb_make; rm -f "$gd/bin/yantrik-root-files.sha256"
  is "theme from the build: no root-files list: not copied" "0|no" "$(gb_try)"
  # Only root can give a file away; as an ordinary user (CI) the case cannot be built.
  if [ "$(id -u)" = 0 ]; then
    gb_make; chown 1000 "$gsh/icon.png"
    is "theme from the build: a file not root's: not copied" "0|no" "$(gb_try)"
  fi
  # The image's theme stands in when the build's is refused, and one already in /boot that is the
  # image's (an install of 14 to 16 Oct) is used as it is, though the build's differs.
  gb_make; printf 'other\n' > "$gsh/icon.png"
  mkdir -p "$gd/theme-src"; chmod 0755 "$gd/theme-src"; printf 'title-text: "image"\n' > "$gd/theme-src/theme.txt"; chmod 0644 "$gd/theme-src/theme.txt"
  is "theme from the build refused: the image's is used" "1|yes|same" \
    "$(gb_try)|$(diff -r "$gd/theme-src" "$gth" >/dev/null 2>&1 && echo same || echo differs)"
  gb_make; ga_old; rm -rf "${gd:?}/boot/themes"; mkdir -p "${gth%/*}"; cp -a "$gd/theme-src" "$gth"; gr_run ok >/dev/null
  is "theme: the image's already in /boot, the build's different: used as it is" "1|same" \
    "$(grep -c '^GRUB_THEME=' "$gd/default/grub")|$(diff -r "$gd/theme-src" "$gth" >/dev/null 2>&1 && echo same || echo differs)"
  gb_make
  is "theme from the build: preferred to the image's when both are there" "1|yes|same" \
    "$(gb_try)|$(diff -r "$gsh" "$gth" >/dev/null 2>&1 && echo same || echo differs)"
  # The installers' own steps are Rust in the target's chroot (install_grub_theme) and a live-ISO
  # script (yantrik-install.sh), so they share with this the place and the line, held here.
  is "theme: the place and the line are the installers'" "yes" \
    "$(! [ -f "$here/../../crates/yantrik-ui/src/wire/installer.rs" ] \
       || { grep -qxF 'const GRUB_THEME_DIR: &str = "/boot/grub/themes/yantrik";' "$here/../../crates/yantrik-ui/src/wire/installer.rs" \
            && grep -qF -- "echo '$GRUB_THEME_LINE' >>" "$here/yantrik-install.sh" \
            && [ "$GRUB_THEME_LINE" = "GRUB_THEME=\"/boot/grub/themes/yantrik/theme.txt\"" ]; } && echo yes || echo no)"
  is "theme: the build ships the theme the image has, hash-listed" "yes" \
    "$(! [ -f "$here/build-release.sh" ] \
       || { grep -qF 'sh "$SCRIPT_DIR/stage-grub-theme.sh" "$ROOT/share/grub-theme"' "$here/build-release.sh" \
            && grep -qE 'sha256sum .* grub-theme/\*\)' "$here/build-release.sh"; } && echo yes || echo no)"
  unset GA_DEFAULT
  rm -rf "${gd:?}/share" "${gd:?}/bin" "${gd:?}/theme-src" "${gd:?}/boot/themes" "${gd:?}/tmpfiles.d"
  rm -f "${gd:?}/said"

  # The loop running now: stopped only when the port gives the I/O error agetty fails on.
  # stty is a program on PATH here, not a function, because the probe runs it under timeout.
  mkdir -p "$gd/bin"
  # shellcheck disable=SC2016  # the stub's own script, expanded when it runs
  printf '%s\n' '#!/bin/sh' '[ -z "$SG_SLEEP" ] || sleep "$SG_SLEEP"' \
    '[ -z "$SG_ERR" ] || { printf "stty: /dev/ttyS0: %s\n" "$SG_ERR" >&2; exit 1; }' > "$gd/bin/stty"
  chmod +x "$gd/bin/stty"
  sg_run() { # sg_run <is-active answer> <stty's error, empty when it answers> [seconds stty hangs]: the systemctl stop made
    ( SG_STATE="$1"; export SG_ERR="$2" SG_SLEEP="${3:-}"; PATH="$gd/bin:$PATH"; SERIAL_PROBE_SECS=1
      systemctl() { if [ "$1" = is-active ]; then printf '%s\n' "$SG_STATE"; else printf '%s\n' "$*" >> "$gd/sg"; fi; }
      rm -f "$gd/sg"; stop_serial_getty_loop >/dev/null 2>&1; cat "$gd/sg" 2>/dev/null )
  }
  is "serial getty: restarting on a port with no UART: stopped" "stop serial-getty@ttyS0.service" \
    "$(sg_run activating 'Input/output error')"
  is "serial getty: ... running: stopped" "stop serial-getty@ttyS0.service" "$(sg_run active 'Input/output error')"
  is "serial getty: a port that answers: left running" "" "$(sg_run active '')"
  is "serial getty: another error: left running" "" "$(sg_run active 'No such file or directory')"
  is "serial getty: not running: nothing to stop" "" "$(sg_run inactive 'Input/output error')"
  # A probe that hangs (#829 review, item 4): given up on after SERIAL_PROBE_SECS, port left running.
  local sg_t0; sg_t0="$(date +%s)"
  is "serial getty: a port whose probe hangs: left running" "" "$(sg_run active 'Input/output error' 10)"
  is "serial getty: ... and the update is not held up" "yes" "$([ $(( $(date +%s) - sg_t0 )) -lt 6 ] && echo yes || echo no)"
  is "serial getty: never masked" "no" "$(declare -f stop_serial_getty_loop | grep -q mask && echo yes || echo no)"
  is "serial console: reconcile and an up-to-date apply both run it" "yes" \
    "$(declare -f cmd_reconcile | grep -q reconcile_serial_console && declare -f cmd_apply | grep -q reconcile_serial_console && echo yes || echo no)"

  if [ "$fails" = 0 ]; then
    printf '%sall selftest checks passed%s\n' "$c_grn" "$c_off"
    return 0
  fi
  printf '%s%s selftest check(s) failed%s\n' "$c_red" "$fails" "$c_off"
  return 1
}
# YANTRIK-SELFTEST-END

usage() {
  printf '%s\n' \
    "yantrik-update — check for, apply and roll back Yantrik OS updates" \
    "" \
    "  check       [--channel C] [--porcelain]   installed vs what the channel has" \
    "  apply       [--channel C] [--force] [--allow-downgrade] [--reboot] [--no-restart]" \
    "  rollback                                  restore the most recent backup" \
    "  status      [--porcelain]                 channel, host, build, backups" \
    "  set-channel nightly|beta|stable           change the channel (writes $CONF)" \
    "  reconcile                                 install packages from share/packages.list this machine lacks" \
    "  package-list FILE                         the package names in FILE, checked (the image build reads it)" \
    "  install-mind BUNDLE SHA256                put a Yantrik Mind bundle in place, and prove it attaches" \
    "  mind-egress apply                         hold the mind account to its egress proxy (root; its units run it)" \
    "  selftest                                  offline checks, no network" \
    "" \
    "check exits 0 up to date · 10 update available · 11 channel not published ·" \
    "12 server unreachable · 13 this machine is ahead of the channel · 1 anything else."
}

# ── dispatch ────────────────────────────────────────────────────────────────────────────
CMD="${1:-check}"; shift || true
case "$CMD" in
  check)    cmd_check "$@" ;;
  apply)    cmd_apply "$@" ;;
  rollback) cmd_rollback "$@" ;;
  status)   cmd_status "$@" ;;
  # Both spellings, because the control surface names its action set_update_channel and a
  # person at a terminal types the hyphen.
  set-channel|set_channel) cmd_set_channel "$@" ;;
  reconcile) cmd_reconcile ;;
  # The names in a package list, validated, one per line: what build-debian-iso.sh installs, read
  # by the same parser that reads the installed copy here (#854). Reads only the file it is given.
  package-list) [ "$#" = 1 ] || fail "usage: yantrik-update package-list FILE"; read_package_list "$1" ;;
  migrate-minds) cmd_migrate_minds "$@" ;;
  install-mind) cmd_install_mind "$@" ;;
  mind-egress) cmd_mind_egress "$@" ;;
  migrate-ownership) cmd_migrate_ownership ;;
  selftest) cmd_selftest ;;
  # Printed from a function rather than `sed -n '20,30p' "$0"`, which quietly printed whatever
  # happened to be on those lines after anyone edited the header.
  -h|--help|help) usage ;;
  *) fail "unknown command '$CMD' (check | apply | rollback | status | set-channel | reconcile | selftest)" ;;
esac
