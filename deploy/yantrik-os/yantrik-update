    [ "$(grub_defaults_rewrite 1 2 "$gd/one" 1 0 | head -n 1)" = "$(cat "$gd/one")" ] || gbad="$gbad [$gform]"
    printf 'GRUB_CMDLINE_LINUX_DEFAULT="%s cryptdevice=UUID=0f0f:root"\n' "$gform" > "$gd/one"
