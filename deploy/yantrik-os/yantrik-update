  gt_old; cp -p "$gd/default/grub" "$gd/hand"; out="$(gr_run ok)"
  is "serial terminal: BIOS with a theme: left as it is" "yes|no|none" \
    "$(cmp -s "$gd/hand" "$gd/default/grub" && echo yes || echo no)|$([ -e "$gd/calls" ] && echo yes || echo no)|$(ls "$gd/default"/grub.before-* 2>/dev/null || echo none)"
  t "serial terminal: ... and said so" "starts by BIOS" "$out"
  is "serial terminal: ... once" "" "$(gr_run ok)"
  # A theme set in grub.d counts as much as one in the file (#835 review, item 1).
  gt_old; sed -i '/^GRUB_THEME=/d' "$gd/default/grub"; cp -p "$gd/default/grub" "$gd/hand"; mkdir -p "$gd/default/grub.d"
  printf 'GRUB_THEME="/boot/grub/themes/other/theme.txt"\n' > "$gd/default/grub.d/theme.cfg"
  out="$(gr_run ok)"; rm -rf "$gd/default/grub.d"
  is "serial terminal: BIOS with a theme in grub.d: left as it is" "yes|no|none" \
    "$(cmp -s "$gd/hand" "$gd/default/grub" && echo yes || echo no)|$([ -e "$gd/calls" ] && echo yes || echo no)|$(ls "$gd/default"/grub.before-* 2>/dev/null || echo none)"
  t "serial terminal: ... and said so" "starts by BIOS" "$out"
  gt_old; sed -i '/^GRUB_THEME=/d' "$gd/default/grub"; gr_run ok >/dev/null
  is "serial terminal: BIOS with no theme: gfxterm alone, as the installer writes it there" \
