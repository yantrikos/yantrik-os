    "mine|GRUB_CMDLINE_LINUX_DEFAULT=\"quiet splash $GRUB_DEFAULT_CONSOLE\"" "$(cat "$gcur")|$(grep '^GRUB_CMDLINE_LINUX_DEFAULT=' "$gd/default/grub")"
