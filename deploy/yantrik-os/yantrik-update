#!/usr/bin/env bash
# ═══════════════════════════════════════════════════════════════════════════════════════
# yantrik-update — check for, apply, and roll back OS updates on an installed Yantrik system.
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# The release server already publishes everything an update needs: one `.tar.zst` bundle per
# channel, its sha256, and a manifest saying which build each channel points at
# (build-release.sh --publish). Until now nothing on the installed side could *read* that and
# act — `version.rs` checks the manifest and lights a button, and the button did nothing. So
# updating a machine meant what it meant all through this project's bring-up: hand-copying
# binaries over ssh and restarting the shell by hand. This is that, done properly and safely.
#
# The safety it adds over a hand-copy is the part that matters:
#   * the bundle is verified against the manifest's sha256 before a single file is touched,
#   * the current binaries are backed up before they are replaced, and
#   * if the new shell does not answer its control socket after the restart, the update is
#     rolled back to the backup automatically — a bad build cannot leave the machine dark.
#
# Usage:
#   yantrik-update check       [--channel C] [--porcelain]  installed vs what the channel has
#   yantrik-update apply       [--channel C] [--force] [--allow-downgrade] [--reboot] [--no-restart]
#   yantrik-update rollback                                  restore the most recent backup
#   yantrik-update status      [--porcelain]                 channel, host, build, backups
#   yantrik-update set-channel nightly|beta|stable           change the channel, once, here
#   yantrik-update reconcile                                 base packages the image ships and this machine lacks
#   yantrik-update selftest                                  offline checks of the two above
#
# It reads its defaults from /opt/yantrik/update.conf (CHANNEL=, HOST=, SCHEME=) when present.
#
# ── The two output formats, and why there are two ──
#
# Everything a person reads is the coloured prose below. Everything a *program* reads comes
# from --porcelain: one `key=value` per line, no colour, no sentences that a rewording breaks.
# The desktop's About screen parses that, so "up to date" and "could not check" can never again
# be the same string — see design/updates-2026-09-21.md for the checker that could only ever
# answer "up to date" because every failure path in it returned the success value.
#
# check exits: 0 up to date · 10 update available · 11 channel not published · 12 server
# unreachable · 13 this machine is ahead of the channel · 1 anything else. The porcelain
# `result=` line says the same thing in words; both are emitted so neither has to be inferred
# from the other.
#
# 13 is not a failure and not 0 either: there is nothing to install, but "up to date" would say
# this machine is on the channel's build, and it is not — it is past it. A caller that only
# reads exit codes sees "no update to apply", which is the true part.

set -uo pipefail

# ── Where things live ───────────────────────────────────────────────────────────────────
PREFIX="${YANTRIK_PREFIX:-/opt/yantrik}"
BIN_DIR="$PREFIX/bin"
# Everything a release ships that is not a binary: the compositor config and window theme, the
# house typeface, the session autostart, and the .desktop entry for every app.
SHARE_DIR="$PREFIX/share"
BUILD_FILE="$PREFIX/BUILD"
UPDATES_DIR="$PREFIX/updates"
BACKUP_DIR="$PREFIX/backups"
CONF="$PREFIX/update.conf"
# The systemd unit that owns the desktop session.
SESSION_UNIT="${YANTRIK_SESSION_UNIT:-yantrik-session.service}"
LOG_DIR="$PREFIX/logs"
LOG_FILE="$LOG_DIR/yantrik-os.log"

# Read a KEY from the installed BUILD marker, or empty if absent.
#
# Defined up here, above the channel resolution, because BUILD is one of the places the channel
# can come from: `apply` records `channel=` into it when it installs, so a machine that has ever
# updated itself knows which channel its software came from even if update.conf is gone.
build_field() {
  [ -f "$BUILD_FILE" ] || return 0
  sed -n "s/^$1=//p" "$BUILD_FILE" | head -1
}

installed_git()     { build_field git; }
installed_version() { build_field version; }

# The one-line copy of the version, beside the marker that owns it.
#
# `$PREFIX/.version` is a convenience file — one line, no keys — that a person reads with `cat`
# and nothing on the machine depends on. That is exactly how it came to be wrong and stay wrong:
# a machine held `.version` = 0.3.0 next to `BUILD` = version=v0.1.0-179-g6fc8b13 and answered
# whichever one you happened to ask, because the ISO build wrote it once, back when that script
# had 0.3.0 typed into it, and no update since had touched it. So every path here that writes
# BUILD writes this from the same string, and the two cannot drift apart again.
#
# Failing to write it is not a failed update. An empty version is not written at all: keeping
# the last string that was true beats replacing it with a blank line.
stamp_version_file() { # <prefix> <version>
  [ -n "${2:-}" ] || return 0
  printf '%s\n' "$2" > "$1/.version" 2>/dev/null && return 0
  printf '%s\n' "$2" | sudo -n tee "$1/.version" >/dev/null 2>&1 || true
}

# Config file may set CHANNEL, HOST and SCHEME. Plain KEY=value, sourced only for those.
#
# ── One host, and no second address ──
#
# This script used to carry a hardcoded fallback to a private address on the author's home
# network, tried for both the manifest read and the bundle download whenever HOST did not
# answer. The sha256 check did not make that safe: the checksum comes out of the same
# manifest, from the same host, over the same connection, so it verified nothing. The full
# account is in design/iso-release-2026-09-20.md §3 — deliberately there and not here,
# because this file is installed on every machine and a postmortem naming somebody's LAN is
# not something to ship a copy of to strangers.
#
# A machine that wants a different server, private or otherwise, sets HOST in
# /opt/yantrik/update.conf. That is the supported way, and it is the only way.
#
# ── One answer to "which channel is this machine on" ──
#
# There were three, and they disagreed. update.conf said one thing and exists only on machines
# installed from an ISO or provisioned by cloud-init; config.yaml carried `updates.channel:
# beta` that NO program on the machine has ever read; and this script's own default said
# `stable`. So a machine installed from a release bundle asked the server for `stable` — a
# channel that has never had a build published to it — and was told its channel was not
# published, on a machine that was perfectly current.
#
# The order below is the single answer, most specific first. Nothing else on the machine gets
# to hold an opinion about this, and config.yaml no longer carries one to be out of date with.
#
#   1. CHANNEL in update.conf   what this machine has been told to follow (set-channel writes
#                               it; the ISO build and cloud-init lay it down at install time)
#   2. channel= in BUILD        the channel the installed build actually came from, recorded
#                               by `apply` when it installs
#   3. CHANNEL_DEFAULT          below
CHANNEL_DEFAULT="nightly"
# nightly is the hard default because it is the only channel that has ever had a build
# published to it: the pipeline in .github/workflows/iso.yml publishes nightly and nothing
# else. When stable starts receiving builds, change this one line — every other reader on the
# machine takes its answer from here rather than carrying its own copy.
HOST_DEFAULT="releases.yantrikos.com"
# https by default, because the manifest is what decides which bytes get installed and a
# plaintext manifest is modifiable by anyone on the path. update.conf may set SCHEME=http for
# a server that has no certificate; that is a choice someone makes about their own machine.
SCHEME_DEFAULT="https"
if [ -f "$CONF" ]; then
  # shellcheck disable=SC1090
  . "$CONF"
fi
# Where the answer came from, carried so `status` can say it. "The channel is nightly" and
# "the channel is nightly because nobody has ever said otherwise" are different facts, and the
# second one is the one that explains a surprise.
CHANNEL_SOURCE="update.conf"
if [ -z "${CHANNEL:-}" ]; then
  CHANNEL="$(build_field channel)"
  CHANNEL_SOURCE="BUILD"
fi
if [ -z "${CHANNEL:-}" ]; then
  CHANNEL="$CHANNEL_DEFAULT"
  CHANNEL_SOURCE="default"
fi
HOST="${HOST:-$HOST_DEFAULT}"
SCHEME="${SCHEME:-$SCHEME_DEFAULT}"
# Checked here with a bare echo rather than fail(): the helpers are defined below this point.
case "$SCHEME" in
  http|https) ;;
  *) echo "SCHEME in $CONF must be http or https, not '$SCHEME'" >&2; exit 2 ;;
esac

# ── Small helpers ───────────────────────────────────────────────────────────────────────
c_bold=$'\033[1m'; c_red=$'\033[31m'; c_grn=$'\033[32m'; c_dim=$'\033[2m'; c_off=$'\033[0m'
say()  { printf '%s%s%s\n' "$c_bold" "$*" "$c_off"; }
info() { printf '  %s\n' "$*"; }
warn() { printf '%s  %s%s\n' "$c_red" "$*" "$c_off" >&2; }
fail() { printf '%sFAIL: %s%s\n' "$c_red" "$*" "$c_off" >&2; exit 1; }

need() { command -v "$1" >/dev/null 2>&1 || fail "need '$1' but it is not installed"; }

# Pull a `--channel X` out of the argument list and let it override the configured channel. Both
# `check` and `apply` take it, so it is parsed in one place rather than two that could disagree.
parse_channel() {
  local prev=""
  for a in "$@"; do
    if [ "$prev" = "--channel" ]; then CHANNEL="$a"; CHANNEL_SOURCE="--channel"; fi
    prev="$a"
  done
}

# Is --porcelain in the argument list? Same reasoning as parse_channel: parsed once.
has_porcelain() {
  for a in "$@"; do [ "$a" = "--porcelain" ] && return 0; done
  return 1
}

# Ask the manifest about one channel, once, and distinguish the three things that can happen.
#
# This was `manifest_field CHANNEL FIELD`: one HTTP request per field, four of them in `apply`,
# and every failure of any kind collapsed into exit 1. The only sentence it could produce was
# "cannot reach the release server or channel 'X' is not published" — one message for two
# problems that call for opposite actions. A machine that cannot reach the server has a network
# to fix; a machine on an unpublished channel has a channel to change, and the desktop now
# offers to change it, so the difference has to survive the trip to the UI.
#
# Parsed with python because the manifest is JSON, and grepping JSON is how you ship the wrong
# build. HOST and SCHEME come through the environment so the heredoc below stays literal —
# expanding a shell variable inside it is how you ship a malformed request.
#
# Prints KEY=value lines, `status=` first, and exits 0 ok / 11 not published / 12 unreachable.
channel_probe() {
  YANTRIK_UPDATE_HOST="$HOST" YANTRIK_UPDATE_SCHEME="$SCHEME" \
  python3 - "$1" <<'PY'
import sys, os, json, urllib.request
channel = sys.argv[1]
host = os.environ.get("YANTRIK_UPDATE_HOST", "releases.yantrikos.com")
scheme = os.environ.get("YANTRIK_UPDATE_SCHEME", "https")
# One URL. The second entry here used to be a literal private address on the author's LAN,
# tried on every machine this OS was ever installed on; see the note beside HOST_DEFAULT.
try:
    with urllib.request.urlopen(f"{scheme}://{host}/manifest.json", timeout=10) as r:
        m = json.load(r)
except Exception as e:
    print("status=unreachable")
    print(("detail=" + str(e).replace("\n", " "))[:200])
    sys.exit(12)
channels = m.get("channels") or {}
ch = channels.get(channel)
if not isinstance(ch, dict) or not ch:
    print("status=not_published")
    print("published=" + ",".join(sorted(str(k) for k in channels)))
    sys.exit(11)
print("status=ok")
for f in ("version", "git", "artifact", "sha256", "date"):
    v = ch.get(f, "")
    if v != "":
        print(f"{f}={str(v)}")
sys.exit(0)
PY
}

# One field out of a channel_probe result. $1 = the whole result, $2 = the key.
probe_field() { printf '%s\n' "$1" | sed -n "s/^$2=//p" | head -1; }

# Keep the newest RETAIN_BACKUPS rollback copies and delete the rest.
#
# Also clears the downloaded tarballs: they are ~230 MB each, they are re-downloadable, and
# keeping them is how /opt/yantrik/updates reached 823 MB of things nobody would ever read.
RETAIN_BACKUPS="${YANTRIK_RETAIN_BACKUPS:-2}"
prune_backups() {
  [ -d "$BACKUP_DIR" ] || return 0
  local old
  old="$(ls -1t "$BACKUP_DIR" 2>/dev/null | tail -n +$((RETAIN_BACKUPS + 1)))"
  if [ -n "$old" ]; then
    local n; n="$(printf '%s\n' "$old" | wc -l | tr -d ' ')"
    info "removing $n old backup(s), keeping the newest $RETAIN_BACKUPS"
    printf '%s\n' "$old" | while IFS= read -r d; do
      [ -n "$d" ] && rm -rf -- "$BACKUP_DIR/$d"
    done
  fi
  rm -f "$UPDATES_DIR"/*.tar.* 2>/dev/null || true
}

# build_field / installed_git / installed_version are defined above the channel resolution,
# because the channel is one of the things BUILD can answer.

# Can two builds be proven to be the same build?
#
# The test was `local_git = remote_git` alone, and a build from a modified tree publishes the
# hash of the commit it started from -- so `apply` answered "already on 648ac85, nothing to do"
# about a bundle whose contents had never been installed anywhere. Every iteration then needed
# --force, and --force is the flag that means "I know this is the same build, install it
# anyway": using it to work around a wrong answer is how it stops being a safety net.
#
# Two dirty trees with the same parent commit are not comparable, so the honest answer for
# anything carrying -dirty is "no".
same_build() {
  local a="$1" b="$2" av="$3" bv="$4"
  [ -n "$a" ] && [ "$a" = "$b" ] || return 1
  case "$av$bv" in *-dirty*) return 1 ;; esac
  return 0
}

# ── Ordering two builds, not only comparing them ──────────────────────────────────────────
#
# Both sides of a check carry a `git describe` string: the tag, the number of commits since
# that tag, and the commit -- v0.1.0-456-gca376be, with -dev or -dirty appended when the build
# says anything about the tree it came from. That is an ordering, and `check` used to throw it
# away: it compared the two git hashes for EQUALITY and called any difference an update. So a
# machine that was AHEAD of its channel -- a developer deploy from main, a beta tester moved
# back to nightly, a nightly that arrived from a mirror behind the one this machine followed --
# was offered the channel's older build as an update, and one click on Install rolled it back a
# day of fixes and called that an update. On the machine this was found on: v0.1.0-456-gca376be
# installed, v0.1.0-304 on the channel, and the screen said "Update available — ca376be →
# 7bc7d6b" with the Install button under it.
#
# The four functions below are that ordering. They read nothing and write nothing, so the
# selftest can put a whole table of version pairs through them.

# Drop the leading `v` and the tree qualifiers a build appends after the commit. Those say what
# the tree looked like when it was built, not where the build sits in history.
version_core() {
  local s="$1"
  s="${s#v}"
  while :; do
    case "$s" in
      *-dev)   s="${s%-dev}" ;;
      *-dirty) s="${s%-dirty}" ;;
      *) break ;;
    esac
  done
  printf '%s' "$s"
}

# Compare two dotted-number strings: prints -1, 0 or 1. Returns 1, printing nothing, when
# either side is not dotted numbers -- so a caller cannot mistake "cannot compare" for "equal",
# which is the mistake this whole section exists to stop making.
cmp_dotted() {
  local a="$1" b="$2"
  case "$a" in ''|*[!0-9.]*) return 1 ;; esac
  case "$b" in ''|*[!0-9.]*) return 1 ;; esac
  local -a ap bp
  IFS=. read -r -a ap <<< "$a"
  IFS=. read -r -a bp <<< "$b"
  local n=${#ap[@]} i x y
  [ "${#bp[@]}" -gt "$n" ] && n="${#bp[@]}"
  for ((i = 0; i < n; i++)); do
    x="${ap[i]:-0}"; y="${bp[i]:-0}"
    case "$x" in ''|*[!0-9]*) return 1 ;; esac
    case "$y" in ''|*[!0-9]*) return 1 ;; esac
    if ((10#$x < 10#$y)); then printf '%s' -1; return 0; fi
    if ((10#$x > 10#$y)); then printf '%s' 1; return 0; fi
  done
  printf '%s' 0
}

# The describe count: the number between the tag and the -g<hash>. A version with no count is
# the tag itself, which sits zero commits past it. Returns 1 when what follows the tag is not a
# number, because inventing a count is how an ordering becomes a lie.
describe_count() {
  local v="$1" rest
  rest="${v#*-}"
  [ "$rest" = "$v" ] && { printf '%s' 0; return 0; }
  rest="${rest%%-*}"
  case "$rest" in ''|*[!0-9]*) return 1 ;; esac
  printf '%s' "$((10#$rest))"
}

# Where build $1 sits against build $2: newer, older, same or unknown.
#
# "unknown" is the honest answer for anything that is not a describe of a tagged commit -- a
# bare hash from a tree with no tags, an empty version, a string somebody typed into a BUILD
# file -- and a caller must not read it as either order. "same" means the same tag the same
# number of commits past it, which two different commits can both be: a force-pushed main, or a
# build off a branch. Neither is provably newer, and neither is called one.
version_order() {
  local a b c an bn
  a="$(version_core "$1")"; b="$(version_core "$2")"
  [ -n "$a" ] && [ -n "$b" ] || { printf 'unknown'; return 0; }
  c="$(cmp_dotted "${a%%-*}" "${b%%-*}")" || { printf 'unknown'; return 0; }
  if [ "$c" != 0 ]; then
    [ "$c" = 1 ] && printf 'newer' || printf 'older'
    return 0
  fi
  an="$(describe_count "$a")" && bn="$(describe_count "$b")" || { printf 'unknown'; return 0; }
  if ((an > bn)); then printf 'newer'
  elif ((an < bn)); then printf 'older'
  else printf 'same'
  fi
}

# ── check ───────────────────────────────────────────────────────────────────────────────
#
# One decision, two renderings. The result is worked out once into $result/$reason and then
# printed either as prose or as porcelain — so the About screen and the terminal cannot reach
# different conclusions about the same machine, which is exactly what they did before: the
# desktop had a second checker of its own that answered "up to date" on every failure.

# The decision itself, apart from the probe that feeds it and the two renderings of it: given
# what this machine has and what the channel has, say which of the three answers applies — up to
# date, an update, or a channel this machine is ahead of. It reads no file and opens no socket,
# so the selftest can hold a table of version pairs against it, including the one this machine
# got wrong: a channel behind the build installed here.
#
# Prints three key=value lines: result=, code=, reason=.
decide_check() { # <local_git> <local_ver> <remote_git> <remote_ver> <channel>
  local local_git="$1" local_ver="$2" remote_git="$3" remote_ver="$4" channel="$5"

  if [ -z "$local_git" ]; then
    printf 'result=update_available\ncode=10\nreason=this machine has no build marker, so it cannot prove it is current\n'
    return 0
  fi
  if [ "$local_git" = "$remote_git" ]; then
    if same_build "$local_git" "$remote_git" "$local_ver" "$remote_ver"; then
      printf "result=up_to_date\ncode=0\nreason=installed build matches channel '%s'\n" "$channel"
    else
      # Same commit, one of the two built from a modified tree. This branch used to `return 0`,
      # and 0 is the code every caller reads as "up to date" — so the one case the dirty-tree
      # check exists to catch printed "update available" and reported success.
      printf 'result=update_available\ncode=10\nreason=same commit, but one of the two was built from a modified tree\n'
    fi
    return 0
  fi

  case "$(version_order "$remote_ver" "$local_ver")" in
    older)
      # The channel is behind this machine. That is not an update and there is nothing to
      # install; saying so is the whole fix, and the sentence names both builds so a person can
      # see the distance rather than take it on trust.
      local gloss=""
      case "$local_ver" in *-dev*) gloss=" (a developer deploy)" ;; esac
      printf "result=ahead_of_channel\ncode=13\nreason=installed %s%s is ahead of channel '%s' (%s)\n" \
        "${local_ver:-unknown}" "$gloss" "$channel" "${remote_ver:-unknown}"
      ;;
    newer)
      printf 'result=update_available\ncode=10\nreason=%s → %s\n' \
        "${local_git:-unknown}" "${remote_git:-unknown}"
      ;;
    *)
      # Two builds this script cannot put in order: a bare hash on one side, a version nobody
      # described from a tag, or the same describe count with different commits behind it.
      # Offered, because refusing every build it cannot order would strand a machine that has
      # no tags — but the reason says the order is not proven rather than implying it is.
      printf 'result=update_available\ncode=10\nreason=%s → %s (neither build is provably newer: %s vs %s)\n' \
        "${local_git:-unknown}" "${remote_git:-unknown}" "${local_ver:-unknown}" "${remote_ver:-unknown}"
      ;;
  esac
}

cmd_check() {
  need python3
  parse_channel "$@"

  local probe rc pstatus remote_ver remote_git local_ver local_git published detail
  probe="$(channel_probe "$CHANNEL")"; rc=$?
  pstatus="$(probe_field "$probe" status)"
  remote_ver="$(probe_field "$probe" version)"
  remote_git="$(probe_field "$probe" git)"
  published="$(probe_field "$probe" published)"
  detail="$(probe_field "$probe" detail)"
  local_ver="$(installed_version)"; local_git="$(installed_git)"

  local result reason code decision
  case "$pstatus" in
    unreachable)
      result="unreachable"; code=12
      reason="cannot reach $HOST over $SCHEME${detail:+ ($detail)}"
      ;;
    not_published)
      result="not_published"; code=11
      reason="channel '$CHANNEL' is not published — the server has nothing on it"
      [ -n "$published" ] && reason="$reason (published: $published)"
      ;;
    ok)
      decision="$(decide_check "$local_git" "$local_ver" "$remote_git" "$remote_ver" "$CHANNEL")"
      result="$(probe_field "$decision" result)"
      code="$(probe_field "$decision" code)"
      reason="$(probe_field "$decision" reason)"
      # No decision at all is an error, not an answer to render: an empty $code would also make
      # the `return` below fail, and the caller would read the exit status of the last command.
      if [ -z "$result" ] || [ -z "$code" ]; then
        result="error"; code=1
        reason="the updater could not work out an answer for channel '$CHANNEL'"
      fi
      ;;
    *)
      result="error"; code=1
      reason="the updater could not read a result from $HOST (probe exit $rc)"
      ;;
  esac

  if has_porcelain "$@"; then
    printf 'result=%s\n' "$result"
    printf 'channel=%s\n' "$CHANNEL"
    printf 'channel_source=%s\n' "$CHANNEL_SOURCE"
    printf 'host=%s\n' "$HOST"
    printf 'scheme=%s\n' "$SCHEME"
    printf 'installed_version=%s\n' "$local_ver"
    printf 'installed_git=%s\n' "$local_git"
    printf 'channel_version=%s\n' "$remote_ver"
    printf 'channel_git=%s\n' "$remote_git"
    [ -n "$published" ] && printf 'published=%s\n' "$published"
    printf 'reason=%s\n' "$reason"
    return "$code"
  fi

  say "Checking channel '$CHANNEL' on $HOST"
  case "$result" in
    unreachable|not_published|error)
      warn "$reason"
      return "$code"
      ;;
  esac
  info "installed: ${local_ver:-unknown}${local_git:+ ($local_git)}"
  info "channel:   ${remote_ver:-unknown}${remote_git:+ ($remote_git)}"
  case "$result" in
    up_to_date)
      printf '%sup to date%s\n' "$c_grn" "$c_off"
      ;;
    ahead_of_channel)
      printf '%snothing to update%s — %s\n' "$c_grn" "$c_off" "$reason"
      # Named here rather than left to be discovered: the only way this machine moves to the
      # channel's build is a downgrade, and a downgrade is something you ask for by name.
      info "installing the channel's older build would roll this machine back. On purpose:"
      info "  yantrik-update apply --allow-downgrade"
      ;;
    *)
      printf '%supdate available%s — %s\n' "$c_bold" "$c_off" "$reason"
      ;;
  esac
  return "$code"
}

# ── apply ───────────────────────────────────────────────────────────────────────────────
# Everything under $PREFIX belongs to the person whose desktop it is, and this script runs as
# them: the shell's "Install update" runs it that way, and so does a mind. Run ONCE under sudo —
# over ssh, by someone being careful — and the directories it creates (updates/, backups/)
# belong to root from then on, so every later update as the user fails. That is what the first
# public update on a real machine hit: "Permission denied" writing the download, three days
# after a sudo run nobody remembered. Two halves, so it cannot be left that way again:
#
#   ensure_writable_tree   before touching anything, find what this user cannot write, repair
#                          it with `sudo -n chown` when that is allowed, and otherwise stop
#                          with the one command that fixes it.
#   give_back_to_owner     when this IS root, hand what it made back to whoever owns $PREFIX.
prefix_owner() { stat -c %U "$PREFIX" 2>/dev/null || id -un; }

ensure_writable_tree() {
  local d bad=""
  for d in "$PREFIX" "$BIN_DIR" "$SHARE_DIR" "$UPDATES_DIR" "$BACKUP_DIR"; do
    [ -e "$d" ] || continue
    [ -w "$d" ] || bad="$bad $d"
  done
  [ -n "$bad" ] || return 0
  local me; me="$(id -un)"
  if sudo -n true 2>/dev/null; then
    # shellcheck disable=SC2086  # a list of directories, split on purpose
    if sudo -n chown -R "$me" $bad; then
      info "took back$bad (left owned by someone else, probably by an earlier run as root)"
      return 0
    fi
  fi
  fail "cannot write to:$bad. They were probably left owned by root by an earlier 'sudo yantrik-update'. Fix it once with: sudo chown -R $me$bad   Nothing was changed."
}

give_back_to_owner() {
  [ "$(id -u)" = 0 ] || return 0
  local owner; owner="$(prefix_owner)"
  [ -n "$owner" ] && [ "$owner" != root ] || return 0
  chown -R "$owner" "$UPDATES_DIR" "$BACKUP_DIR" "$BIN_DIR" "$SHARE_DIR" "$BUILD_FILE" \
    "$PREFIX/.version" 2>/dev/null || true
}

cmd_apply() {
  trap give_back_to_owner EXIT
  need python3; need curl; need sha256sum; need tar
  parse_channel "$@"
  local force=0 reboot=0 restart=1 allow_downgrade=0
  for a in "$@"; do
    case "$a" in
      --force) force=1 ;;
      --allow-downgrade) allow_downgrade=1 ;;
      --reboot) reboot=1 ;;
      --no-restart) restart=0 ;;
    esac
  done

  say "Preparing update from channel '$CHANNEL'"
  # One request for the whole channel entry, rather than four requests for four fields of it.
  # Four requests could also see four different manifests if the publisher was mid-upload.
  local probe pstatus remote_git remote_ver artifact remote_sha
  probe="$(channel_probe "$CHANNEL")"
  pstatus="$(probe_field "$probe" status)"
  case "$pstatus" in
    ok) ;;
    not_published) fail "channel '$CHANNEL' is not published — there is nothing to install \
from it. Change it with: yantrik-update set-channel nightly" ;;
    *) fail "cannot reach $HOST over $SCHEME — $(probe_field "$probe" detail)" ;;
  esac
  remote_ver="$(probe_field "$probe" version)"
  remote_git="$(probe_field "$probe" git)"
  artifact="$(probe_field "$probe" artifact)"
  remote_sha="$(probe_field "$probe" sha256)"
  [ -n "$artifact" ] || fail "channel '$CHANNEL' publishes no artifact — nothing to download"
  [ -n "$remote_sha" ] || fail "channel '$CHANNEL' publishes no sha256 — refusing to install an unverifiable build"

  local local_git local_ver
  local_git="$(installed_git)"; local_ver="$(installed_version)"
  if [ "$force" = 0 ] && same_build "$local_git" "$remote_git" "$local_ver" "$remote_ver"; then
    say "Already on $remote_git — nothing to do (use --force to reinstall)"
    # "Nothing to do" is about the binaries. The base system is the half an up-to-date
    # machine can still be missing — a 520 has every current Yantrik file and no `ip` —
    # so a run that found no new build is exactly the moment to look (#210).
    reconcile_packages || true
    return 0
  fi

  # ── An older build is a downgrade, and a downgrade is asked for by name ──
  #
  # `check` no longer offers one as an update, but `apply` is reachable without a check — from a
  # terminal, and from the control surface's apply_update — so the guard lives here too, or the
  # door the About screen closed stays open behind it.
  #
  # --force does not open it. That flag means "I know this is the SAME build, install it
  # anyway", and a flag that also means "roll this machine back" is a flag nobody can read.
  local order; order="$(version_order "$remote_ver" "$local_ver")"
  if [ "$order" = older ]; then
    if [ "$allow_downgrade" = 0 ]; then
      fail "channel '$CHANNEL' has ${remote_ver:-unknown}, which is OLDER than the \
${local_ver:-unknown} installed here. Installing it would roll this machine back, so it is not \
done by accident — to do it on purpose: yantrik-update apply --allow-downgrade"
    fi
    warn "downgrading on purpose: ${local_ver:-unknown} → ${remote_ver:-unknown}"
  fi

  ensure_writable_tree
  mkdir -p "$UPDATES_DIR"
  local dl="$UPDATES_DIR/$artifact"

  say "Downloading $artifact"
  local url="$SCHEME://$HOST/$CHANNEL/$artifact"
  # One host, and a failure is a failure. This used to fall back to a hardcoded private
  # address when $HOST did not answer — so the way to get this machine to install your
  # tarball was to make its usual server unreachable and answer at that address instead.
  local curl_rc=0
  curl -fL --retry 3 --connect-timeout 15 -o "$dl" "$url" || curl_rc=$?
  # curl's 23 is "could not write what I received". It was reported as "could not download the
  # update bundle from <url>", which sent the first person to see it looking at a server that
  # had answered perfectly.
  case "$curl_rc" in
    0) ;;
    23) fail "the bundle downloaded but could not be written to $dl ($(df -h "$UPDATES_DIR" | awk 'NR==2{print $4}') free; directory owned by $(stat -c %U "$UPDATES_DIR")). Nothing was changed." ;;
    *) fail "could not download the update bundle from $url (curl exit $curl_rc). Nothing was changed." ;;
  esac

  say "Verifying"
  local got; got="$(sha256sum "$dl" | awk '{print $1}')"
  if [ "$got" != "$remote_sha" ]; then
    rm -f "$dl"
    fail "sha256 mismatch — expected $remote_sha, got $got. The download is corrupt or tampered; nothing was changed."
  fi
  info "sha256 ok ($got)"

  say "Unpacking"
  local stage="$UPDATES_DIR/staging"
  rm -rf "$stage"; mkdir -p "$stage"
  tar --use-compress-program='zstd -d' -xf "$dl" -C "$stage" 2>/dev/null \
    || tar -xf "$dl" -C "$stage" \
    || fail "could not unpack the bundle (need zstd for .tar.zst)"
  # The bundle holds one top directory <NAME>/ with bin/ under it.
  local root; root="$(find "$stage" -maxdepth 1 -mindepth 1 -type d | head -1)"
  [ -n "$root" ] && [ -d "$root/bin" ] || fail "the bundle has no bin/ directory — it is not a Yantrik release"

  # A release that does not contain the shell is not a release; refuse before touching anything.
  [ -f "$root/bin/yantrik-ui" ] || fail "the bundle has no yantrik-ui — refusing to install it"
  local n; n="$(find "$root/bin" -maxdepth 1 -type f | wc -l)"
  [ "$n" -ge 10 ] || fail "the bundle has only $n binaries — that is not a whole OS, refusing"
  info "$n binaries staged"

  # ── Back up what is there now, so a bad build is recoverable ──
  #
  # And throw the old ones away, which this did not do.
  #
  # A backup is a full copy of bin/ and share/ -- about 570 MB. Thirty-five of them
  # accumulated on a 24 GB disk: 20 GB of backups, no free space, and then the install loop's
  # `cp` wrote THIRTY-FOUR ZERO-BYTE FILES over the binaries it was replacing, including
  # yantrik-update itself. An empty script exits 0, so every subsequent `apply` reported
  # success and did nothing at all. The machine could no longer update itself and said the
  # update had worked.
  #
  # Two is enough: the build you are replacing, and the one before it. The publisher has
  # pruned its channel to three since the day it was written; the installer pruned nothing.
  prune_backups

  # Refuse rather than half-install.
  #
  # `cp` onto a full disk is how the zero-byte binaries happened, and the install loop's
  # `&&` chain did not catch it -- a short write can still exit 0. The cheapest guard is to
  # not start: a release is ~600 MB unpacked and the backup is another ~600 MB.
  local need_kb=1500000
  local free_kb; free_kb="$(df -Pk "$PREFIX" | awk 'NR==2 {print $4}')"
  if [ -n "$free_kb" ] && [ "$free_kb" -lt "$need_kb" ]; then
    fail "only $((free_kb / 1024)) MB free on $PREFIX; need $((need_kb / 1024)) MB to install \
safely. Old backups live in $BACKUP_DIR."
  fi

  local ts; ts="$(date -u +%Y%m%d-%H%M%S)"
  local backup="$BACKUP_DIR/$ts"
  say "Backing up current build to $backup"
  mkdir -p "$backup"
  cp -a "$BIN_DIR" "$backup/bin"
  [ -d "$SHARE_DIR" ] && cp -a "$SHARE_DIR" "$backup/share"
  [ -f "$BUILD_FILE" ] && cp -a "$BUILD_FILE" "$backup/BUILD"
  echo "$backup" > "$UPDATES_DIR/last-backup"

  # ── Swap: install each new binary over the old, atomically per file ──
  say "Installing"
  local installed=0
  while IFS= read -r f; do
    local base; base="$(basename "$f")"
    local tmp="$BIN_DIR/.$base.new"
    if cp "$f" "$tmp" 2>/dev/null \
       && [ "$(stat -c%s "$tmp" 2>/dev/null || echo 0)" = "$(stat -c%s "$f")" ] \
       && chmod 755 "$tmp" && mv -f "$tmp" "$BIN_DIR/$base"; then
      installed=$((installed + 1))
    else
      # A single file failing to install is a failed update; put everything back.
      rm -f "$tmp"
      warn "could not install $base — rolling back"
      restore_backup "$backup"
      fail "install failed at $base; rolled back to the previous build"
    fi
  done < <(find "$root/bin" -maxdepth 1 -type f)
  info "installed $installed binaries"

  # The one binary that needs privilege gets it back after the swap. `cp` and `mv` do not carry
  # file capabilities, so an update that forgot this would silently downgrade perception to PSI
  # alone - the service says so in its own status, but a person has to look. The ISO and the
  # dev deploy set the same two, and the service drops them before it serves (see
  # services/perception-service/src/main.rs).
  if [ -x "$BIN_DIR/perception-service" ]; then
    if command -v setcap >/dev/null 2>&1; then
      setcap cap_sys_admin,cap_net_admin=ep "$BIN_DIR/perception-service" \
        || warn "could not set file capabilities on perception-service; it will watch with PSI only"
    else
      warn "setcap is not installed (libcap2-bin); perception-service will watch with PSI only"
    fi
  fi

  # ── And everything that is not a binary ──
  #
  # The updater installed bin/ and nothing else, so half of every release since this script
  # was written went in the bin and stayed there. share/ carries the compositor config, the
  # window theme, the house typeface, the autostart file and the .desktop entries for all
  # sixteen apps — none of which ever reached an installed machine.
  #
  # It was invisible because each piece had an innocent explanation. The keyboard shortcuts
  # "had not been deployed yet". The launcher "did not know about our apps". The desktop
  # "needed a reboot to pick up the theme". They were all the same missing copy.
  #
  # Mirrored rather than merged: a file dropped from a release should disappear from the
  # machine too, and --delete is what makes the installed tree equal the shipped one.
  if [ -d "$root/share" ]; then
    mkdir -p "$SHARE_DIR"
    if command -v rsync >/dev/null 2>&1; then
      rsync -a --delete "$root/share/" "$SHARE_DIR/" || fail "could not install share/"
    else
      rm -rf "$SHARE_DIR" && mkdir -p "$SHARE_DIR"
      cp -a "$root/share/." "$SHARE_DIR/" || fail "could not install share/"
    fi
    info "installed $(find "$SHARE_DIR" -type f | wc -l) shared files"

    # ── The app icon ──
    #
    # There is deliberately no separate copy step for it. It ships inside share/ as
    # share/icons/hicolor/{scalable,48x48,128x128,256x256}/apps/yantrik.{svg,png}, the mirror
    # above carries it, and `Icon=yantrik` in all sixteen .desktop entries resolves through
    # XDG_DATA_DIRS — which yantrik-session puts $SHARE_DIR on. Said out loud here because
    # the obvious next move, when someone goes looking for where icons get installed, is to
    # add a second copy into /usr/share and end up with two that can disagree.
    #
    # Checked rather than assumed: an update that quietly drops the icon turns every tile in
    # the launcher blank, and the .desktop entries would still be perfectly correct.
    if [ -f "$SHARE_DIR/icons/hicolor/scalable/apps/yantrik.svg" ]; then
      info "app icon in place (hicolor 'yantrik')"
    else
      warn "this build ships no app icon — launcher tiles will be blank."
      warn "  the release is built without it: see build-release.sh and brand/render.py"
    fi
  fi

  # Record the new build so `check` can prove currency next time.
  cat > "$BUILD_FILE" <<EOF
name=${artifact%.tar.zst}
version=$remote_ver
git=$remote_git
channel=$CHANNEL
installed=$(date -u +%Y-%m-%dT%H:%M:%SZ)
binaries=$installed
EOF
  stamp_version_file "$PREFIX" "$remote_ver"

  rm -rf "$stage"; rm -f "$dl"
  say "Installed $remote_ver ($remote_git)"
  # The binaries are current; the base system may not be. Never fails the update over it —
  # reconcile_packages says in words what it could not do and how to finish it.
  reconcile_packages || true

  if [ "$reboot" = 1 ]; then
    say "Rebooting"
    exec sudo reboot
  fi
  if [ "$restart" = 1 ]; then
    restart_and_verify "$backup"
  else
    info "not restarting (--no-restart); the new build takes effect on next session start"
  fi
}

# Restart the shell in the current session, then confirm it answers its control socket. If it
# does not come up, roll back and restart the old one — the machine must never be left dark.
# Remember the environment the RUNNING shell has, before killing it.
#
# An update restarts the shell, and the restarted shell must be the same program in the same
# session -- not a similar one started by hand with three variables someone thought of.
#
# The version of this that listed variables explicitly passed XDG_RUNTIME_DIR, WAYLAND_DISPLAY
# and SLINT_BACKEND. It did not pass SLINT_FULLSCREEN, which the session sets (cloud-init
# exports it before launching labwc). So after every update the OS came back as an 800-pixel
# DECORATED WINDOW floating on a black root, with a title bar and a close button. An operating
# system. The binaries were right and the desktop looked broken.
#
# Copying the live process's environment is the only version of this that stays correct when
# someone adds a variable to the session and does not think about the updater.
SHELL_ENV=()
capture_shell_env() {
  local pid
  pid="$(pgrep -x yantrik-ui 2>/dev/null | head -1)"
  [ -n "$pid" ] || return 1
  [ -r "/proc/$pid/environ" ] || return 1
  mapfile -d '' -t SHELL_ENV < "/proc/$pid/environ" || return 1
  [ "${#SHELL_ENV[@]}" -gt 0 ]
}

# Start the shell, detached, so it outlives this script.
#
# `mkdir -p` on the log directory is the other half of why this function exists. Without it the
# append redirect fails, the shell never launches at all, and the update rolls back a perfectly
# healthy build with a message about a timeout. Worse: the rollback ran the same redirect, so
# it could not restart the OLD shell either -- one absent directory took a machine dark and
# reported it as "the previous build is running again".
start_shell() {
  local runtime="$1"
  mkdir -p "$PREFIX/logs" 2>/dev/null || true

  if [ "${#SHELL_ENV[@]}" -gt 0 ]; then
    # The session's own environment, verbatim.
    setsid env "${SHELL_ENV[@]}" \
      "$BIN_DIR/yantrik-ui" "$PREFIX/config.yaml" >> "$LOG_FILE" 2>&1 &
  else
    # Nothing was running to copy from. SLINT_FULLSCREEN is named here on purpose: a shell
    # without it is a window, and a window is the one thing this is not.
    setsid env \
      XDG_RUNTIME_DIR="$runtime" WAYLAND_DISPLAY="${WAYLAND_DISPLAY:-wayland-0}" \
      SLINT_BACKEND="${SLINT_BACKEND:-winit}" SLINT_FULLSCREEN="${SLINT_FULLSCREEN:-1}" \
      "$BIN_DIR/yantrik-ui" "$PREFIX/config.yaml" >> "$LOG_FILE" 2>&1 &
  fi
}

# What is still running the build that was just replaced.
#
# An update swaps files and restarts the shell. It does not restart the apps a person has open,
# or the bridges a harness holds for days: the first update delivered from the public host left
# Notes describing itself with the old build's one-word summary, and left Hermes talking to a
# `yos-mcp` it had started three days earlier — so the mind was shown the old tool descriptions
# and had none of the new build's behaviour, on a machine whose BUILD file said otherwise. Nothing
# said so. A binary replaced by rename leaves its running process pointing at "… (deleted)", and
# a script replaced the same way keeps the old text in memory, so both are findable. They are
# named, not killed: an open note or a conversation is not this script's to end.
stale_processes() {
  local pid exe cmd name out="" started installed
  installed="$(stat -c %Y "$BUILD_FILE" 2>/dev/null || echo 0)"
  for pid in $(pgrep -u "$(id -u)" 2>/dev/null); do
    exe="$(readlink "/proc/$pid/exe" 2>/dev/null)" || continue
    case "$exe" in
      "$BIN_DIR"/*" (deleted)")
        name="$(basename "${exe% (deleted)}")"
        [ "$name" = yantrik-ui ] && continue
        out="$out $name" ;;
      *python*)
        cmd="$(tr '\0' ' ' < "/proc/$pid/cmdline" 2>/dev/null)"
        case "$cmd" in
          *"$BIN_DIR/yos-mcp"*)
            started="$(stat -c %Y "/proc/$pid" 2>/dev/null || echo 0)"
            [ "$started" -lt "$installed" ] && out="$out yos-mcp(pid-$pid)" ;;
        esac ;;
    esac
  done
  printf '%s' "$out" | tr ' ' '\n' | sort -u | tr '\n' ' ' | sed 's/^ *//; s/ *$//'
}

report_stale() {
  local stale; stale="$(stale_processes)"
  [ -n "$stale" ] || return 0
  warn "still running the previous build until they are reopened: $stale"
  case "$stale" in
    *yos-mcp*) info "a harness holds that bridge; restart the harness to give the mind the new tools (Hermes: systemctl --user restart hermes-gateway)" ;;
  esac
}

# Wait for the shell to answer its control socket. The socket existing is not enough: it is
# created before the shell is ready to be asked anything.
wait_for_shell() {
  local runtime="$1"
  local sock="$runtime/yantrik/app-shell.sock"
  say "Waiting for the shell to answer"
  for _ in $(seq 1 30); do
    if [ -S "$sock" ] \
       && XDG_RUNTIME_DIR="$runtime" "$BIN_DIR/yos" describe shell >/dev/null 2>&1; then
      printf '%shealthy — update complete%s\n' "$c_grn" "$c_off"
      report_stale
      return 0
    fi
    sleep 1
  done
  return 1
}

# Which runtime dir the SESSION lives in -- not the one this process happens to have inherited.
#
# The unit says who it runs as; that user's uid is the only thing that decides where the
# Wayland socket and the shell's control socket are.
session_runtime_dir() {
  local u uid
  u="$(systemctl show "$SESSION_UNIT" -p User --value 2>/dev/null)"
  [ -n "$u" ] || u="$(id -un)"
  uid="$(id -u "$u" 2>/dev/null)" || uid="$(id -u)"
  printf '/run/user/%s' "$uid"
}

restart_and_verify() {
  local backup="$1"
  say "Restarting the shell"

  # Ask the session manager to restart the session, rather than respawning the shell by hand.
  #
  # This is the correction to a whole class of damage. Hand-spawning looked fine and was not:
  # the replacement shell is a child of whatever ran the updater — an ssh login, in practice —
  # so it inherits that environment instead of the session's, and it is no longer a startup
  # child of the compositor. It came back with XDG_SESSION_TYPE=tty, no DISPLAY, and
  # SSH_CONNECTION set, running outside labwc's supervision.
  #
  # The visible result was a desktop that tore and flickered whenever a second client was on
  # screen, and an OS that had to be told SLINT_FULLSCREEN or it drew itself as a window. Both
  # were blamed on the compositor and on rendering. Neither was: a clean boot of the same build
  # renders Chromium perfectly, with two successive frames byte-identical.
  #
  # Every desktop does this with its session manager. So do we now: systemd started this
  # session and knows exactly how to start it again — the unit carries XDG_SESSION_TYPE,
  # the seat, the tty and the renderer settings, and labwc re-exports DISPLAY,
  # XDG_CURRENT_DESKTOP and the rest to its children. Restarting it reproduces the boot path
  # exactly, which is the only restart worth trusting.
  #
  # Asked FIRST, and asked about the session rather than about this shell's environment.
  #
  # The old order checked $XDG_RUNTIME_DIR before anything else, so running the updater the way
  # it is meant to be run -- over ssh, under sudo -- landed on /run/user/0, found no session
  # there, and printed "cannot restart from here" about a session systemd was perfectly able to
  # restart. Every upgrade then needed a manual `systemctl restart` afterwards, which is the
  # exact step the session unit exists to remove, and an upgrade whose last line says the new
  # build is not running yet is not an upgrade.
  local runtime
  if command -v systemctl >/dev/null 2>&1 \
     && systemctl cat "$SESSION_UNIT" >/dev/null 2>&1; then
    runtime="$(session_runtime_dir)"
    info "restarting $SESSION_UNIT"
    if sudo -n systemctl restart "$SESSION_UNIT" 2>/dev/null; then
      wait_for_shell "$runtime" && return 0
      warn "the session restarted but the shell did not answer"
      restore_backup "$backup"
      sudo -n systemctl restart "$SESSION_UNIT" 2>/dev/null
      wait_for_shell "$runtime" \
        && fail "update rolled back — the previous build is running again"
      fail "update rolled back, but the session did not come back. Start it with: \
sudo systemctl restart $SESSION_UNIT"
    fi
    warn "could not restart $SESSION_UNIT without a password; starting the shell directly"
  fi

  # No session unit, or no privilege to restart it: a development machine where somebody
  # started the shell by hand. NOW the caller's own runtime dir is the right question, because
  # the shell they started is a child of their session.
  runtime="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if [ ! -S "$runtime/yantrik/app-shell.sock" ] && [ ! -d "$runtime/yantrik" ]; then
    warn "no session unit, and no Yantrik session on this runtime dir ($runtime)."
    info "the new build will take effect the next time the desktop session starts."
    return 0
  fi

  # Before the kill, or there is nothing left to read the environment from.
  capture_shell_env || warn "no running shell to copy the session environment from"

  pkill -x yantrik-ui 2>/dev/null
  sleep 3
  pkill -9 -x yantrik-ui 2>/dev/null
  sleep 1
  start_shell "$runtime"

  say "Waiting for the shell to answer"
  local sock="$runtime/yantrik/app-shell.sock"
  for _ in $(seq 1 20); do
    if [ -S "$sock" ] && "$BIN_DIR/yos" describe shell >/dev/null 2>&1; then
      printf '%shealthy — update complete%s\n' "$c_grn" "$c_off"
      report_stale
      return 0
    fi
    sleep 1
  done

  warn "the new shell did not answer within 20s — rolling back"
  # Say WHY before rolling back. A rollback with no reason attached turns a five-minute fix
  # into an afternoon, and the log is the only witness the new shell leaves behind.
  if [ -s "$LOG_FILE" ]; then
    warn "last lines from $LOG_FILE:"
    tail -n 15 "$LOG_FILE" | sed 's/^/    /'
  else
    warn "$LOG_FILE is empty — the new shell wrote nothing before it stopped"
  fi

  restore_backup "$backup"
  pkill -9 -x yantrik-ui 2>/dev/null
  sleep 1
  start_shell "$runtime"

  # Verify the ROLLBACK, rather than announcing one that did not happen. The restore used to
  # print "the previous build is running again" without ever checking, and on the day the log
  # directory was missing it said exactly that while the machine sat dark.
  local sock_rb="$runtime/yantrik/app-shell.sock"
  for _ in $(seq 1 20); do
    if [ -S "$sock_rb" ] && "$BIN_DIR/yos" describe shell >/dev/null 2>&1; then
      fail "update rolled back — the previous build is running again"
    fi
    sleep 1
  done
  fail "update rolled back, but the previous build did not answer either — this machine has \
no shell running. Start one with: $BIN_DIR/yantrik-ui $PREFIX/config.yaml"
}

# Copy a backup's binaries back over the live ones, and restore its build marker.
restore_backup() {
  local backup="$1"
  [ -d "$backup/bin" ] || { warn "backup $backup has no bin/ — cannot restore"; return 1; }
  while IFS= read -r f; do
    local base; base="$(basename "$f")"
    cp "$f" "$BIN_DIR/.$base.rb" 2>/dev/null && chmod 755 "$BIN_DIR/.$base.rb" && mv -f "$BIN_DIR/.$base.rb" "$BIN_DIR/$base"
  done < <(find "$backup/bin" -maxdepth 1 -type f)
  if [ -d "$backup/share" ]; then
    rm -rf "$SHARE_DIR"
    cp -a "$backup/share" "$SHARE_DIR"
  fi
  [ -f "$backup/BUILD" ] && cp -a "$backup/BUILD" "$BUILD_FILE"
  # A rollback moves the version backwards, so the one-line copy has to move with it.
  stamp_version_file "$PREFIX" "$(installed_version)"
  info "restored from $backup"
}

# ── rollback ────────────────────────────────────────────────────────────────────────────
cmd_rollback() {
  local backup
  backup="$(cat "$UPDATES_DIR/last-backup" 2>/dev/null)"
  [ -n "$backup" ] && [ -d "$backup" ] || {
    backup="$(find "$BACKUP_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | sort | tail -1)"
  }
  [ -n "$backup" ] && [ -d "$backup" ] || fail "no backup to roll back to"
  say "Rolling back to $backup"
  restore_backup "$backup"
  restart_and_verify "$backup"
}

# ── status ──────────────────────────────────────────────────────────────────────────────
#
# --porcelain exists because the About screen needs to state the channel and host this machine
# is ACTUALLY configured for, and the only way to be sure it agrees with the updater is to ask
# the updater. The shell has no business parsing update.conf itself: two parsers of one file is
# how the machine got three answers to this question in the first place.
cmd_status() {
  local can_write="no"
  if [ -f "$CONF" ]; then
    [ -w "$CONF" ] && can_write="yes"
  elif [ -w "$(dirname "$CONF")" ]; then
    can_write="yes"
  fi

  if has_porcelain "$@"; then
    printf 'channel=%s\n' "$CHANNEL"
    printf 'channel_source=%s\n' "$CHANNEL_SOURCE"
    printf 'host=%s\n' "$HOST"
    printf 'scheme=%s\n' "$SCHEME"
    printf 'conf=%s\n' "$CONF"
    printf 'conf_present=%s\n' "$([ -f "$CONF" ] && echo yes || echo no)"
    printf 'conf_writable=%s\n' "$can_write"
    printf 'version=%s\n' "$(build_field version)"
    printf 'git=%s\n' "$(build_field git)"
    printf 'name=%s\n' "$(build_field name)"
    printf 'installed=%s\n' "$(build_field installed)"
    printf 'backups=%s\n' "$(find "$BACKUP_DIR" -maxdepth 1 -mindepth 1 -type d 2>/dev/null | wc -l | tr -d ' ')"
    return 0
  fi

  say "Yantrik build"
  if [ -f "$BUILD_FILE" ]; then
    sed 's/^/  /' "$BUILD_FILE"
  else
    info "no build marker at $BUILD_FILE"
  fi
  info "channel: $CHANNEL (from $CHANNEL_SOURCE)   host: $HOST   scheme: $SCHEME"
  say "Backups"
  if [ -d "$BACKUP_DIR" ] && [ -n "$(ls -A "$BACKUP_DIR" 2>/dev/null)" ]; then
    for b in "$BACKUP_DIR"/*/; do
      printf '  %s  (%s binaries)\n' "$(basename "$b")" "$(find "$b/bin" -maxdepth 1 -type f 2>/dev/null | wc -l)"
    done
  else
    info "none"
  fi
}

# ── set-channel ─────────────────────────────────────────────────────────────────────────
#
# The one writer of CHANNEL. Nothing else on an installed machine writes update.conf after
# install time, and nothing else should: a second writer is a second opinion, and this file
# exists to end the argument. The desktop's channel picker calls this through the control
# surface (`set_update_channel`), so the button and the command line take the same path.
#
# No network. `check` is what talks to the server, and the caller runs it afterwards — that
# way changing the channel to one with nothing on it reports "not published" as a real answer
# instead of failing the write.

# The new contents of update.conf, on stdout. Only the CHANNEL line is touched: HOST, SCHEME,
# comments and anything else somebody put in this file are theirs and pass through unchanged.
conf_body() {
  local new="$1"
  if [ -f "$CONF" ]; then
    if grep -qE '^[[:space:]]*CHANNEL=' "$CONF"; then
      sed -E "s|^[[:space:]]*CHANNEL=.*|CHANNEL=$new|" "$CONF"
    else
      cat "$CONF"
      printf 'CHANNEL=%s\n' "$new"
    fi
  else
    printf '%s\n' \
      "# Read by yantrik-update. This file is the single owner of which channel this machine" \
      "# follows, which server it follows it on, and over which scheme. Written at install" \
      "# time by the ISO build and by cloud-init, and changed afterwards only by" \
      "# 'yantrik-update set-channel'." \
      "CHANNEL=$new" \
      "HOST=$HOST" \
      "SCHEME=$SCHEME"
  fi
}

cmd_set_channel() {
  local new="${1:-}"
  case "$new" in
    nightly|beta|stable) ;;
    "") fail "set-channel needs a channel name: nightly, beta or stable" ;;
    --*) fail "set-channel takes a channel name, not an option (nightly, beta or stable)" ;;
    *) fail "'$new' is not a channel this build knows about (nightly, beta or stable)" ;;
  esac

  local body tmp
  body="$(conf_body "$new")" || fail "could not read $CONF"
  tmp="$CONF.new.$$"

  # temp + rename, so a machine that loses power mid-write still has a whole update.conf and
  # not half of one. Both branches below rename; the difference is only who does the writing.
  #
  # Written directly first, because /opt/yantrik belongs to the desktop user on every machine
  # this project installs — the ISO chowns the tree to uid 1000 and cloud-init chowns it to
  # yantrik. `apply` takes the same line: it replaces binaries in $PREFIX with no privilege at
  # all and only reaches for `sudo -n` to ask systemd for a restart. So this does too.
  if printf '%s\n' "$body" > "$tmp" 2>/dev/null && mv -f "$tmp" "$CONF" 2>/dev/null; then
    :
  elif sudo -n true 2>/dev/null \
       && printf '%s\n' "$body" | sudo -n tee "$tmp" >/dev/null 2>&1 \
       && sudo -n mv -f "$tmp" "$CONF" 2>/dev/null; then
    :
  else
    rm -f "$tmp" 2>/dev/null; sudo -n rm -f "$tmp" 2>/dev/null
    fail "cannot write $CONF — it is owned by $(stat -c '%U' "$CONF" 2>/dev/null || stat -c '%U' "$(dirname "$CONF")" 2>/dev/null || echo root) \
and this is running as $(id -un). Run: sudo yantrik-update set-channel $new"
  fi

  CHANNEL="$new"
  CHANNEL_SOURCE="update.conf"
  say "Channel set to '$new' in $CONF"
  info "run 'yantrik-update check' to see what that channel has"
}

# ── reconcile ─────────────────────────────────────────────────────────────────────────
#
# An update replaces /opt/yantrik and nothing else, so a machine installed from an older image
# keeps that older base system forever: VM 520 was "current" on every deploy and had no `ip`,
# no `ss`, no `ping`, no editor and no htop, because the ISO gained those packages after 520
# was installed and no update path ever looked at a Debian package (#210). The fix is not to
# reinstall the machine every time a package list moves — it is for the updater, which is what
# the machine trusts to keep it current, to also reconcile the small list below: every package
# whose command the shipped code shells out to or tells a person to run. release-check
# (tier ci) asserts the same commands on a booted image, so the two lists cannot drift apart
# without a nightly turning red.

# Package names, not command names: `ip` and `ss` are both in iproute2, `ping` is in
# iputils-ping. A package the image's own lists all install.
REQUIRED_PACKAGES="iproute2 iputils-ping grim curl python3 nano htop"

# Is this package installed, per dpkg? Prints dpkg's own status word, or nothing.
pkg_installed() {
  dpkg-query -W -f='${db:Status-Status}' "$1" 2>/dev/null || true
}

# The REQUIRED_PACKAGES that the status command $1 does not report installed. Split from the
# apt run and from dpkg itself so the selftest can hand it a whole machine that is missing
# things and check, package by package, which ones it names — the one decision here that can
# be wrong in a way a person feels.
missing_packages() { # <status-command>
  local pkg missing=""
  for pkg in $REQUIRED_PACKAGES; do
    [ "$("$1" "$pkg")" = "installed" ] || missing="$missing $pkg"
  done
  printf '%s' "${missing# }"
}

# Install what this machine drifted from, and never fail the caller over it: a good build is
# already installed by the time this runs, and a missing `ping` must not read as a failed
# update. On machines this cannot sudo, it prints the one command that finishes the job.
reconcile_packages() {
  # dpkg is the Debian answer. A machine without it (a dev box on another distro, an Alpine
  # deploy) is not this list's machine, and `apply` must not die asking.
  command -v dpkg-query >/dev/null 2>&1 || {
    info "no dpkg-query here — the package reconcile is for Debian machines"
    return 0
  }
  local missing; missing="$(missing_packages pkg_installed)"
  [ -n "$missing" ] || return 0
  say "this machine is missing packages the image ships: $missing"
  # shellcheck disable=SC2086  # a package list, split on purpose
  if sudo -n env DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends $missing; then
    missing="$(missing_packages pkg_installed)"
    if [ -z "$missing" ]; then
      info "base system reconciled"
      return 0
    fi
    warn "still missing after apt-get: $missing"
    return 1
  fi
  warn "could not run apt-get without a password. Finish it once with: sudo apt-get install -y --no-install-recommends $missing"
  return 1
}

cmd_reconcile() {
  say "Reconciling the base system against what the image ships"
  info "required: $REQUIRED_PACKAGES"
  reconcile_packages
}

# ── selftest ────────────────────────────────────────────────────────────────────────────
#
# No network, no /opt, no machine. It runs THIS script against a scratch $YANTRIK_PREFIX and
# checks the things that had more than one answer between them: where the channel comes from
# when update.conf is silent, that set-channel rewrites only the line it owns, that the
# one-line `.version` file is written from the same string as the BUILD marker, and which of
# two builds is newer — the last one against a table of version pairs, because the decision
# `check` makes is a pure function of them and a wrong one installs an older OS.
cmd_selftest() {
  local fails=0 root
  # Not `local`: the EXIT trap runs after this function has returned, in global scope, and
  # under `set -u` a trap naming a variable that no longer exists is itself an error message.
  SELFTEST_ROOT="$(mktemp -d)"
  root="$SELFTEST_ROOT"
  trap 'rm -rf "${SELFTEST_ROOT:-}"' EXIT

  t() { # t <name> <expected substring> <actual>
    if printf '%s' "$3" | grep -qF -- "$2"; then
      printf '  %sok%s   %s\n' "$c_grn" "$c_off" "$1"
    else
      printf '  %sFAIL%s %s\n       wanted: %s\n       got:    %s\n' \
        "$c_red" "$c_off" "$1" "$2" "$(printf '%s' "$3" | tr '\n' ' ')"
      fails=$((fails + 1))
    fi
  }

  say "yantrik-update selftest"

  # 1. Nothing at all: the hard default, and it says so.
  local p1="$root/empty"; mkdir -p "$p1"
  local out
  out="$(YANTRIK_PREFIX="$p1" "$0" status --porcelain)"
  t "bare machine falls back to the hard default" "channel=nightly" "$out"
  t "and says the answer came from the default"   "channel_source=default" "$out"

  # 2. A BUILD marker from a bundle install: the channel the build came from wins over the
  #    hard default. This is the case that used to ask the server for 'stable'.
  local p2="$root/build"; mkdir -p "$p2"
  printf 'name=yantrik-os\nversion=0.4.0\ngit=abc1234\nchannel=beta\n' > "$p2/BUILD"
  out="$(YANTRIK_PREFIX="$p2" "$0" status --porcelain)"
  t "BUILD's channel beats the hard default" "channel=beta" "$out"
  t "and says it came from BUILD"            "channel_source=BUILD" "$out"

  # 3. set-channel with no update.conf creates one, with HOST and SCHEME in it.
  local p3="$root/fresh"; mkdir -p "$p3"
  YANTRIK_PREFIX="$p3" "$0" set-channel stable >/dev/null 2>&1
  out="$(cat "$p3/update.conf" 2>/dev/null)"
  t "set-channel creates update.conf"        "CHANNEL=stable" "$out"
  t "with the public host"                   "HOST=releases.yantrikos.com" "$out"
  t "over https"                             "SCHEME=https" "$out"
  out="$(YANTRIK_PREFIX="$p3" "$0" status --porcelain)"
  t "and update.conf then owns the answer"   "channel_source=update.conf" "$out"

  # 4. set-channel on an existing file rewrites CHANNEL and nothing else.
  local p4="$root/existing"; mkdir -p "$p4"
  printf '# hand-written\nCHANNEL=nightly\nHOST=mirror.example.invalid\nSCHEME=http\n' \
    > "$p4/update.conf"
  YANTRIK_PREFIX="$p4" "$0" set-channel beta >/dev/null 2>&1
  out="$(cat "$p4/update.conf")"
  t "the channel changes"          "CHANNEL=beta" "$out"
  t "the host is preserved"        "HOST=mirror.example.invalid" "$out"
  t "the scheme is preserved"      "SCHEME=http" "$out"
  t "the comment is preserved"     "# hand-written" "$out"

  # 5. .version is stamped from the same string as BUILD, by whatever writes BUILD.
  #
  #    This is the check that would have caught the machine reporting `.version` 0.3.0 beside
  #    `BUILD` version=v0.1.0-179-g6fc8b13: nothing wrote the one-line file after the install,
  #    so it stayed at whatever the ISO builder had typed into it months earlier.
  local p5="$root/stamp"; mkdir -p "$p5"
  stamp_version_file "$p5" "v0.1.0-258-g64165ad"
  out="$(cat "$p5/.version" 2>/dev/null)"
  t ".version carries the version that was installed" "v0.1.0-258-g64165ad" "$out"
  stamp_version_file "$p5" ""
  out="$(cat "$p5/.version" 2>/dev/null)"
  t "and a version nobody knows leaves the last true one" "v0.1.0-258-g64165ad" "$out"

  # 6. A name that is not a channel changes nothing.
  local rc
  YANTRIK_PREFIX="$p4" "$0" set-channel hourly >/dev/null 2>&1
  rc=$?
  out="$(cat "$p4/update.conf")"
  t "a bogus channel leaves the file alone" "CHANNEL=beta" "$out"
  if [ "$rc" = 0 ]; then
    printf '  %sFAIL%s a bogus channel exited 0\n' "$c_red" "$c_off"; fails=$((fails + 1))
  else
    printf '  %sok%s   a bogus channel is an error\n' "$c_grn" "$c_off"
  fi

  # 7. Which of two builds is newer — the table `check` walks, and the row it used to get wrong.
  #
  #    The comparison was equality of two git hashes, so ANY difference read as "the channel has
  #    something you do not". A machine ahead of its channel — a developer deploy from main, a
  #    beta tester moved back to nightly — was offered the channel's older build as an update:
  #    v0.1.0-456-gca376be installed, v0.1.0-304 published, and the screen said "Update
  #    available — ca376be → 7bc7d6b" with an Install button that would have rolled it back a
  #    day of fixes and called that an update.
  local d
  d="$(decide_check 7bc7d6b v0.1.0-304 67c52cb v0.1.0-468-g67c52cb nightly)"
  t "a newer channel build is an update"  "result=update_available" "$d"
  t "and exits 10"                        "code=10"                 "$d"

  d="$(decide_check ca376be v0.1.0-456-gca376be 7bc7d6b v0.1.0-304 nightly)"
  t "an older channel build is not an update" "result=ahead_of_channel" "$d"
  t "and exits 13"                            "code=13"                 "$d"
  t "and says which side is ahead"            "is ahead of channel"     "$d"

  d="$(decide_check deadbee 0.4.2 deadbee 0.4.2 nightly)"
  t "the same build on both sides is up to date" "result=up_to_date" "$d"
  t "and exits 0"                                "code=0"           "$d"

  #    A developer deploy: the -dev suffix says what the tree was, not where the build sits, so
  #    it must not change the ordering in either direction.
  d="$(decide_check ca376be v0.1.0-456-gca376be-dev 7bc7d6b v0.1.0-304 nightly)"
  t "a dev deploy ahead of the channel is still ahead" "result=ahead_of_channel" "$d"
  t "and says it is a developer deploy"                "a developer deploy"      "$d"
  d="$(decide_check ca376be v0.1.0-456-gca376be-dev 67c52cb v0.1.0-468-g67c52cb nightly)"
  t "a dev deploy behind the channel is still an update" "result=update_available" "$d"
  d="$(decide_check deadbee v0.1.0-456-gdeadbee-dirty deadbee v0.1.0-456-gdeadbee nightly)"
  t "a dirty tree is still not the same build" "result=update_available" "$d"

  #    A different channel's builds sit on a different tag, so the tag is compared first and the
  #    commits past it second: 3 commits past v0.2.0 is later than 468 past v0.1.0.
  d="$(decide_check aaa1111 v0.2.0-3-gaaa1111 bbb2222 v0.1.0-468-gbbb2222 nightly)"
  t "a build past a later tag is ahead of an earlier tag's channel" "result=ahead_of_channel" "$d"
  d="$(decide_check aaa1111 v0.1.0-468-gaaa1111 bbb2222 v0.2.0-3-gbbb2222 beta)"
  t "and behind a later tag is an update" "result=update_available" "$d"

  #    Nothing to order by. Offered rather than refused — a machine with no tags must still be
  #    able to update — but never told that the channel's build is newer than it is.
  d="$(decide_check '' '' 7bc7d6b v0.1.0-304 nightly)"
  t "no build marker cannot prove it is current" "result=update_available" "$d"
  d="$(decide_check ca376be ca376be 7bc7d6b 7bc7d6b nightly)"
  t "two bare hashes claim no order" "neither build is provably newer" "$d"

  #    The ordering every row above rests on.
  t "468 commits past a tag is newer than 456" "newer" \
    "$(version_order v0.1.0-468-g67c52cb v0.1.0-456-gca376be)"
  t "a channel at 304 is older than a machine at 456" "older" \
    "$(version_order v0.1.0-304 v0.1.0-456-gca376be)"
  t "a tag is older than any commit past it" "older" \
    "$(version_order v0.1.0 v0.1.0-1-gaaaaaaa)"
  t "0.10.0 is newer than 0.9.0, numerically not as text" "newer" \
    "$(version_order v0.10.0 v0.9.0)"
  t "the same distance past the same tag is same, whatever the commit" "same" \
    "$(version_order v0.1.0-456-gca376be v0.1.0-456-gfffffff)"
  t "a version that is not a describe is unknown" "unknown" \
    "$(version_order nightly-2026-09-23 v0.1.0-456-gca376be)"
  t "and so is no version at all" "unknown" "$(version_order '' v0.1.0-456-gca376be)"

  # 8. The base packages a machine can drift from while every Yantrik file on it is current (#210).
  #
  #    VM 520 was installed from an older image and kept "current" by deploys, which replace
  #    /opt/yantrik and never a Debian package, so it had no ip, ss, ping, nano or htop. The
  #    decision under test is which packages a given machine lacks — that one is pure, and a
  #    fake status command stands in for dpkg. The apt run itself is only a caller of it and
  #    needs a Debian machine, so nothing here touches apt.
  local old; old="$root/dpkg-520"
  printf '#!/bin/sh\ncase "$1" in iproute2|curl|python3|grim) echo installed ;; esac\n' > "$old"
  chmod +x "$old"
  out="$(missing_packages "$old")"
  if [ "$out" = "iputils-ping nano htop" ]; then
    printf '  %sok%s   a 520-style machine is named package by package\n' "$c_grn" "$c_off"
  else
    printf '  %sFAIL%s a 520-style machine: wanted %s, got %s\n' \
      "$c_red" "$c_off" "iputils-ping nano htop" "${out:-nothing}"
    fails=$((fails + 1))
  fi

  local whole; whole="$root/dpkg-whole"
  printf '#!/bin/sh\necho installed\n' > "$whole"
  chmod +x "$whole"
  out="$(missing_packages "$whole")"
  if [ -z "$out" ]; then
    printf '  %sok%s   a machine built from the current image is missing nothing\n' "$c_grn" "$c_off"
  else
    printf '  %sFAIL%s a current machine was told it lacks: %s\n' "$c_red" "$c_off" "$out"
    fails=$((fails + 1))
  fi

  if [ "$fails" = 0 ]; then
    printf '%sall selftest checks passed%s\n' "$c_grn" "$c_off"
    return 0
  fi
  printf '%s%s selftest check(s) failed%s\n' "$c_red" "$fails" "$c_off"
  return 1
}

usage() {
  printf '%s\n' \
    "yantrik-update — check for, apply and roll back Yantrik OS updates" \
    "" \
    "  check       [--channel C] [--porcelain]   installed vs what the channel has" \
    "  apply       [--channel C] [--force] [--allow-downgrade] [--reboot] [--no-restart]" \
    "  rollback                                  restore the most recent backup" \
    "  status      [--porcelain]                 channel, host, build, backups" \
    "  set-channel nightly|beta|stable           change the channel (writes $CONF)" \
    "  reconcile                                 install base packages the image ships and this lacks" \
    "  selftest                                  offline checks, no network" \
    "" \
    "check exits 0 up to date · 10 update available · 11 channel not published ·" \
    "12 server unreachable · 13 this machine is ahead of the channel · 1 anything else."
}

# ── dispatch ────────────────────────────────────────────────────────────────────────────
CMD="${1:-check}"; shift || true
case "$CMD" in
  check)    cmd_check "$@" ;;
  apply)    cmd_apply "$@" ;;
  rollback) cmd_rollback "$@" ;;
  status)   cmd_status "$@" ;;
  # Both spellings, because the control surface names its action set_update_channel and a
  # person at a terminal types the hyphen.
  set-channel|set_channel) cmd_set_channel "$@" ;;
  reconcile) cmd_reconcile ;;
  selftest) cmd_selftest ;;
  # Printed from a function rather than `sed -n '20,30p' "$0"`, which quietly printed whatever
  # happened to be on those lines after anyone edited the header.
  -h|--help|help) usage ;;
  *) fail "unknown command '$CMD' (check | apply | rollback | status | set-channel | reconcile | selftest)" ;;
esac
