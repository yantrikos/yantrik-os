  is "theme: BIOS: never given one" "$(ga_new)|no" "$(cat "$gd/default/grub")|$([ -e "$gth" ] && echo yes || echo no)"
  # Killed after the theme was copied and the file rewritten: the next run finishes it.
  ga_old; cp -p "$gd/default/grub" "$gd/default/grub.before-20261016T000000Z"
  mkdir -p "${gth%/*}"; cp -a "$gd/theme-src" "$gth"
  grub_defaults_rewrite 0 2 "$gd/default/grub.before-20261016T000000Z" 1 > "$gd/default/grub"
  out="$(gr_run ok)"
  is "theme: an interrupted run is finished by the next one" "regenerate|terminal_output gfxterm" \
    "$(cat "$gd/calls" 2>/dev/null)|$(grep terminal_output "$gd/boot/grub.cfg")"
  is "theme: ... the copied theme is still the image's, and nothing is left beside it" "same|" \
    "$(diff -r "$gd/theme-src" "$gth" >/dev/null 2>&1 && echo same || echo differs)|$(find "$gd/default" "$gd/boot" -name '*.yantrik-*')"
  # The image tree's parent writable by others: not copied either (#835 delta review, item 4).
  rm -rf "$gd/boot/themes"; chmod g+w "$gd"; ga_old; out="$(gr_run ok)"; chmod g-w "$gd"
  is "theme: an image tree whose parent others could write is not copied as root" "$(ga_new)|no" \
