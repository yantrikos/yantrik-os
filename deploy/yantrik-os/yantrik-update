  printf '%s\n' '#!/bin/sh' 'cat <<EOF' 'terminal_output gfxterm serial' 'EOF' > "$gd/grub.d/40_custom"
  out="$(gr_run ok)"; rm -rf "$gd/grub.d"
  is "serial terminal: ... nor one whose 40_custom puts a serial terminal in the menu (#835 review, item 4)" "" "$(cat "$gd/calls" 2>/dev/null)"
  is "serial terminal: the new lines are the installer's" "yes" \
    "$(! [ -f "$here/../../crates/yantrik-ui/src/wire/installer.rs" ] \
       || grep -qF -- "$(printf '%s\\n%s' "$GRUB_TERMINAL_INPUT_NEW" "$GRUB_TERMINAL_OUTPUT_NEW" | sed 's/"/\\"/g')" "$here/../../crates/yantrik-ui/src/wire/installer.rs" && echo yes || echo no)"
  # The rewrite changes GRUB_CMDLINE_LINUX_DEFAULT only when asked to, and then only on an old
  # installer's exact line: with console 0 every form, and with console 1 a line carrying a disk's
  # LUKS arguments, come out as they went in.
  local gform gbad="" gcase
