printf 'XKB_DEFAULT_LAYOUT=fr\n' > "$V/home/.config/labwc/environment"
YANTRIK_SESSION_AS_ME=1 $SH "$HERE/../yantrik-session-reconcile" --root "$V" --home "$V/home" >/dev/null 2>&1
check "a --vm install then a reconcile still has vm.conf" '[ -f "$V/etc/systemd/system/yantrik-session.service.d/vm.conf" ]'
check "an install with no --env-from, a home file with another layout, then a reconcile leaves the installer's layout" 'grep -qx "XKB_DEFAULT_LAYOUT=us" "$V/etc/yantrik/session.env" && ! grep -q "=fr" "$V/etc/yantrik/session.env"'
check "the PAM auth stack is closed" 'grep -qx "auth     required   pam_deny.so" "$HERE/../session/yantrik-session.pam"'

# The machine check, on a test VM after `sudo yantrik-update` and a reboot (spec of #548, section 4):
#   YANTRIK_SESSION_MACHINE=<the person's account> sh deploy/yantrik-os/boot-unlock/selftest
# It plants a canary and an LD_PRELOAD in the person's old files, a fresh crash stamp, and kills the
# person's labwc, then reads the restarted shell's environment, the lock and tty1. Nothing here runs
# without that variable: it kills a desktop. Every wait has a deadline.
if [ -n "${YANTRIK_SESSION_MACHINE:-}" ]; then
    P="$YANTRIK_SESSION_MACHINE"; PH="$(getent passwd "$P" | cut -d: -f6)"
    check "the unit, its environment and the compositor's directory are root's, with no group or other write bit" \
        '[ "$(stat -c "%U %a" /etc/systemd/system/yantrik-session.service /etc/yantrik/session.env /etc/yantrik/labwc | grep -cE "^root [0-7][0-7][0-5]$")" = 3 ]'
    check "getty@tty1 is masked" '[ "$(systemctl is-enabled getty@tty1 2>/dev/null)" = masked ]'
    for f in "$PH/.config/labwc/environment" "$PH/.bash_profile"; do
        printf 'YANTRIK_548_CANARY=1\nLD_PRELOAD=/nonexistent/canary.so\n' | sudo -u "$P" tee -a "$f" >/dev/null
    done
    date +%s | sudo -u "$P" tee "$PH/.cache/yantrik-labwc-crash" >/dev/null
    wait_up() { n=0; while [ "$n" -lt 60 ]; do pgrep -u "$P" -x yantrik-ui >/dev/null && return 0; n=$((n + 1)); sleep 1; done; return 1; }
    sudo -u "$P" pkill -x labwc; sleep 5; wait_up
    check "the restarted shell has neither the canary nor LD_PRELOAD from the person's files" \
        '[ "$(tr "\0" "\n" < /proc/$(pgrep -u "$P" -x yantrik-ui | head -n 1)/environ | grep -cE "YANTRIK_548_CANARY|LD_PRELOAD")" = 0 ]'
    check "the lock screen is up (boot_unlock answers no) and tty1 has no shell" \
        '[ "$(yos act shell boot_unlock 2>/dev/null | tr -d "\n ")" != "yes" ] && ! ps -t tty1 -o comm= | grep -qE "^(bash|sh|zsh)$"'
    i=0; while [ "$i" -lt 4 ]; do sudo pkill -x labwc; sleep 2; i=$((i + 1)); done
    n=0; while [ "$n" -lt 30 ] && ! ps -o args= -C agetty | grep -q tty1; do n=$((n + 1)); sleep 1; done
    check "after four kills in a minute tty1 shows a password prompt, with no --autologin" \
        'ps -o args= -C agetty | grep -q tty1 && ! ps -o args= -C agetty | grep -q -- --autologin'
    sudo systemctl reset-failed yantrik-session.service; sudo systemctl restart yantrik-session.service
fi

[ "$FAILS" = 0 ] && echo "boot-unlock selftest: all passed" || { echo "boot-unlock selftest: $FAILS failed"; exit 1; }
