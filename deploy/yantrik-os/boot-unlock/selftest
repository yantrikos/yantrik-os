# ── the desktop starts from root-owned files (#548) ──
# The scripts that write the start, run against a scratch root: what they leave is root's alone (the
# owner is whoever ran this, so it holds without root), and holds only what the rule names.
S="$T/session-root"; SH_HOME="$T/home/ada"
mkdir -p "$S/etc/default" "$S/etc/systemd/system/getty@tty1.service.d" "$SH_HOME/.config/labwc" "$S/opt/yantrik/share"
cp -R "$HERE/../session" "$S/opt/yantrik/share/session"; cp -R "$HERE/../../../config/labwc" "$S/opt/yantrik/share/labwc"
printf '[Service]\nExecStart=\nExecStart=-/sbin/agetty --autologin ada --skip-login %%I $TERM\n' > "$S/etc/systemd/system/getty@tty1.service.d/autologin.conf"
printf 'XKBLAYOUT="de"\n' > "$S/etc/default/keyboard"
printf 'WLR_RENDERER=pixman\nYANTRIK_548_CANARY=secretvalue\nLD_PRELOAD=/tmp/evil.so\nXKB_DEFAULT_LAYOUT=fr\n' > "$SH_HOME/.config/labwc/environment"
# The three .bash_profile texts the writers shipped (fixtures/, kept so the migration's hash list is
# held to them): each is renamed, wherever it is found.
export YANTRIK_SESSION_AS_ME=1
N="$($SH "$HERE/../yantrik-session-reconcile" --root "$S" --home "$SH_HOME" --notice "$S/notice" 2>&1)"
ME="$(id -un)"
check "the session unit, its environment and the compositor's directory are the installer's alone, with no group or other write" \
    'for f in etc/systemd/system/yantrik-session.service etc/yantrik/session.env etc/yantrik/labwc etc/yantrik/labwc/rc.xml etc/yantrik/labwc/autostart etc/pam.d/yantrik-session; do [ "$(stat -c %U "$S/$f")" = "$ME" ] && [ -z "$(find "$S/$f" -maxdepth 0 -perm /022)" ] || exit 1; done'
check "session.env holds only the named keys: the layout, the renderer, and none of the person's other lines" \
    '! grep -vE "^(XKB_DEFAULT_(LAYOUT|VARIANT|OPTIONS|MODEL)|WLR_RENDERER|WLR_RENDERER_ALLOW_SOFTWARE|LIBGL_ALWAYS_SOFTWARE|SLINT_BACKEND|XDG_SESSION_TYPE|QT_QPA_PLATFORM|MOZ_ENABLE_WAYLAND)=[A-Za-z0-9_.,:+/@-]*$" "$S/etc/yantrik/session.env" && grep -qx "XKB_DEFAULT_LAYOUT=fr" "$S/etc/yantrik/session.env" && ! grep -q "LD_PRELOAD\|CANARY" "$S/etc/yantrik/session.env" "$S/etc/yantrik/labwc/environment"'
check "the unit refuses to start on a file that holds another key" \
    '! YANTRIK_SELFTEST=1 $SH "$HERE/../yantrik-session-install" --check-env "$SH_HOME/.config/labwc/environment" 2>/dev/null && YANTRIK_SELFTEST=1 $SH "$HERE/../yantrik-session-install" --check-env "$S/etc/yantrik/session.env"'
check "tty1 has no autologin: its drop-in is gone and getty@tty1 is masked" \
    '[ ! -e "$S/etc/systemd/system/getty@tty1.service.d/autologin.conf" ] && [ "$(readlink "$S/etc/systemd/system/getty@tty1.service")" = /dev/null ]'
check "the session is started by the unit: no shell in it, the pinned PAM file, the environment file, a failure unit with no autologin" \
    'U="$S/etc/systemd/system/yantrik-session.service"; grep -qx "User=ada" "$U" && grep -qx "PAMName=yantrik-session" "$U" && grep -qx "EnvironmentFile=/etc/yantrik/session.env" "$U" && grep -qx "ExecStart=/opt/yantrik/bin/yantrik-session" "$U" && ! grep -vE "^#" "$U" | grep -qE "bash|--autologin" && grep -q "user_readenv=0" "$S/etc/pam.d/yantrik-session" && ! grep -qE "^ExecStart=.*--autologin" "$S/etc/systemd/system/yantrik-session-fallback.service" && [ -L "$S/etc/systemd/system/multi-user.target.wants/yantrik-session.service" ]'
check "labwc starts from /etc/yantrik/labwc" \
    'grep -qF -- "-C /etc/yantrik/labwc" "$HERE/../yantrik-session"'
check "and nothing of the session reads a file in the home before the lock" \
    '! grep -nE "^[^#]*(\\\$HOME|~)/" "$HERE/../yantrik-session" | grep -v "XDG_STATE_HOME\|\.local/state"'
for w in installer live-image text-installer; do
    mkdir -p "$T/w-$w/home" "$T/w-$w/etc/systemd/system/getty@tty1.service.d"
    cp -R "$S/opt" "$T/w-$w/opt"; cp "$S/etc/systemd/system/getty@tty1.service.d/"* "$T/w-$w/etc/systemd/system/getty@tty1.service.d/" 2>/dev/null
    printf '[Service]\nExecStart=-/sbin/agetty --autologin ada %%I\n' > "$T/w-$w/etc/systemd/system/getty@tty1.service.d/autologin.conf"
