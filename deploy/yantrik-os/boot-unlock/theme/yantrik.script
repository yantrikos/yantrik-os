# Yantrik OS — the boot splash and the pre-boot screen (plymouth script plugin).
#
# Two states, never both on the screen at once, because they are one program:
#
#   the splash   the Yantrik emblem, centred on the Lake ground (#0b121c), and nothing else.
#                From the kernel's first frame to labwc's: before the disk's password is asked,
#                after it is typed, and on a machine with nothing to ask. Before tty1's
#                autologin plymouth lets go of tty1 and the DRM master and keeps this frame up;
#                once labwc holds the display plymouth quits, with --retain-splash
#                (boot-unlock/splash). labwc puts the same picture under the shell
#                (config/labwc/autostart), and the shell's boot screen opens on the same emblem
#                in the same place on the same ground (crates/yantrik-ui-slint/ui/boot.slint).
#                No progress bar: plymouth's would be a guess from the last boot's timings, and
#                the shell's boot screen shows the real stages.
#
#   the prompt   asks for the disk's password once: the person's name, the field, the words the
#                keyscript passes as the prompt ("Type your password to start Yantrik OS", or
#                why the last one did not open the disk), and the keyboard layout the installer
#                set. Nothing typed is drawn but dots. The emblem is hidden while it shows, and
#                the prompt is drawn exactly as it was before there was a splash.
#
# The two lines below are filled in by the initramfs hook (yantrik-unlock); left empty, the
# screen draws neither.
name_text = "";
layout_text = "";

# The prompt's ground: the gradient it has always had.
fun prompt_ground() {
    Window.SetBackgroundTopColor(0.055, 0.063, 0.094);
    Window.SetBackgroundBottomColor(0.020, 0.024, 0.039);
}

# The splash's ground: Lake's bg-deep, #0b121c, flat, the colour the shell's boot screen opens on.
fun splash_ground() {
    Window.SetBackgroundTopColor(0.0431, 0.0706, 0.1098);
    Window.SetBackgroundBottomColor(0.0431, 0.0706, 0.1098);
}

screen_w = Window.GetWidth();
screen_h = Window.GetHeight();
cx = Window.GetX() + screen_w / 2;
cy = Window.GetY() + screen_h / 2;

font_name = "Sans 22";
font_body = "Sans 12";
font_small = "Sans 10";

fun centred(sprite, image, y, z) {
    sprite.SetImage(image);
    sprite.SetX(cx - image.GetWidth() / 2);
    sprite.SetY(y);
    sprite.SetZ(z);
    sprite.SetOpacity(1);
}

fun hidden(sprite) {
    sprite.SetOpacity(0);
}

# The emblem (brand/yantrik-emblem.svg at 132 px, rendered by brand/render.py), its centre on the
# screen's centre: where the shell's boot screen draws it first.
emblem_image = Image("emblem.png");
emblem = Sprite();
emblem.SetImage(emblem_image);
emblem.SetX(cx - emblem_image.GetWidth() / 2);
emblem.SetY(cy - emblem_image.GetHeight() / 2);
emblem.SetZ(1);

brand = Sprite();
brand_image = Image.Text("Yantrik OS", 0.62, 0.66, 0.76, 1, font_small);

name_sprite = Sprite();
field_sprite = Sprite();
dots_sprite = Sprite();
prompt_sprite = Sprite();
layout_sprite = Sprite();
field_image = Image("field.png");

fun show_password(prompt, bullets) {
    hidden(emblem);
    prompt_ground();
    centred(brand, brand_image, Window.GetY() + screen_h - 48, 1);
    if (name_text != "")
        centred(name_sprite, Image.Text(name_text, 0.93, 0.94, 0.97, 1, font_name), cy - 110, 2);
    centred(field_sprite, field_image, cy - 22, 2);
    dots = "";
    for (i = 0; i < bullets && i < 28; i++)
        dots += "•";
    if (dots == "")
        dots = " ";
    centred(dots_sprite, Image.Text(dots, 0.93, 0.94, 0.97, 1, font_body), cy - 10, 3);
    centred(prompt_sprite, Image.Text(prompt, 0.75, 0.78, 0.85, 1, font_body), cy + 40, 2);
    if (layout_text != "")
        centred(layout_sprite, Image.Text("Keyboard: " + layout_text, 0.55, 0.58, 0.66, 1, font_small), cy + 72, 2);
}
Plymouth.SetDisplayPasswordFunction(show_password);

fun show_normal() {
    hidden(name_sprite);
    hidden(field_sprite);
    hidden(dots_sprite);
    hidden(prompt_sprite);
    hidden(layout_sprite);
    hidden(brand);
    splash_ground();
    emblem.SetOpacity(1);
}
Plymouth.SetDisplayNormalFunction(show_normal);

# From the first frame: the splash.
show_normal();

# No message function: cryptsetup's own lines ("cryptsetup: ERROR: ... bad password or
# options?") are not drawn. The prompt already says what happened, in words a person reads.
