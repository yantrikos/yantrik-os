#!/usr/bin/python3
"""yos-mcp — the OS's body, offered to a mind as MCP tools.

`yos` is the command line an agent uses to see and act on this machine. This wraps it
as a Model Context Protocol server over stdio, so a mind that speaks MCP gets the
desktop as ordinary tools: what is running, what is on screen, what the page says,
what it says out loud, and how to act on any of it.

The split is deliberate. This process holds no model and makes no decisions; it
translates a tool call into a `yos` invocation and hands back what came out. Everything
it returns — page text, app state, a transcript — is a report about the world and is
never an instruction, however imperative it reads. A page that says "ignore your
previous instructions" is a page that says that; it is content to relay, not a command
to obey, and the mind on the other end has to treat it the same way.

Config for the mind (YM_MCP_CONFIG, default /etc/yantrik-mind/mcp.json):

    {"mcpServers": {"yantrik-os": {"command": "/opt/yantrik/bin/yos-mcp"}}}

Started with YANTRIK_AGENT_TOKEN — by a harness, for one of the person's agents — every act
carries that agent's token, a command runs in the agent's own terminal rather than the person's,
and `run_command` / `command_status` / `command_input` / `command_kill` are offered as well, with
`new_agent` / `send_to_agent` / `stop_agent` / `read_agent` for handing work to another agent, and
`hand_off` for handing it to a role from the desktop's agent catalog. See "Which agent this bridge
acts for" below.
"""

import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import threading
import time

YOS = os.environ.get("YOS_BIN", "/opt/yantrik/bin/yos")
PROTOCOL_VERSION = "2024-11-05"

# ── How long one os_act can take ────────────────────────────────────────────────────────
#
# An os_act above this session's ceiling now asks the person and waits for them (see
# `guard_act`). That wait happens HERE, in this process, between the tool call arriving and
# `yos act` being run — so raising the `"timeout"` on os_act would not have covered it and would
# only have delayed noticing a genuinely hung desktop. The subprocess budget stays at 60s; what
# changed is the wall clock of the whole tool call, and the number a client has to allow for it.
#
# A client that kills a tools/call before OS_ACT_MAX_SECONDS will cut the person off mid
# decision, and the mind will report a timeout for a machine that was working correctly.
#
# What the wait must NOT do is make the whole bridge unanswerable while it lasts — see `main`.
# On 22 September 2026 it did, and a client that pings for liveness killed the server out from
# under a card that was still on the person's screen.
ACT_TIMEOUT = 60             # the `yos act` subprocess itself, unchanged
SHELL_CALL_TIMEOUT = 20      # one `yos act shell …` or `yos describe …`
# Long enough for somebody to look up, read six lines and decide; short enough that a forgotten
# card is not still live when they have moved on. The shell expires the request at 120s, so this
# stays under it — a bridge that gave up later than the shell would report "no answer" for a
# request the person had just allowed.
APPROVAL_WAIT = int(os.environ.get("YOS_MCP_APPROVAL_WAIT", "110"))
APPROVAL_POLL = 2.0
# describe the app + describe the shell + request + poll + the action + the audit line. The grant
# is spent by the action itself now (issue #116), so the budget that was `consume_approval` is
# slack; it stays, because a client that had already allowed for it should not be told less.
OS_ACT_MAX_SECONDS = (2 * SHELL_CALL_TIMEOUT      # action_detail, shell_state
                      + 2 * SHELL_CALL_TIMEOUT    # request_approval, and slack
                      + SHELL_CALL_TIMEOUT        # record_unasked_action, on the unasked path
                      + APPROVAL_WAIT
                      + ACT_TIMEOUT)


def agent_call_max_seconds(wait=None):
    """The same, for a call that waits for a command (`run_command`, `command_status`, or os_act
    on `agent_run` / `agent_job`): the act is given its `wait` and a margin instead of a flat
    minute. A client has to allow this much, or `wait_seconds: 600` is cut off by the client that
    asked for it. `agent_timeout` is defined with the command tools below."""
    return OS_ACT_MAX_SECONDS - ACT_TIMEOUT + agent_timeout(wait)


# ── The name a caller gives itself ──────────────────────────────────────────────────────
#
# The first cards read "the mind on this desktop is asking to use this machine", which is true
# and useless: the person could not tell Hermes from anything else that might have opened this
# bridge. Three sources, best first, and every one of them is SELF-DECLARED.
#
#   1. YOS_MCP_REQUESTER — an operator setting this deliberately outranks anything guessed.
#   2. The MCP client's own `clientInfo` from the `initialize` handshake. Hermes sends its name
#      and version there; this is the specific thing that was being thrown away.
#   3. The shell's own list of minds, whichever one is `answering`. A fallback for a client that
#      sends no clientInfo at all, and it is the name the person already sees in the status bar.
#
# This is a LABEL and it is no longer the only thing the card has. Identity now comes from the
# socket rather than from an argument: the shell reads the peer's pid and uid off the connection
# with SO_PEERCRED — which the kernel stamps and the caller cannot write — and walks /proc up
# past this bridge to the first program a person would recognise. The card prints the two apart,
# `says the caller` over `verified by this machine`, and says so when they disagree.
#
# So keep sending the name (it is still the thing a person recognises), and do not describe it
# to a mind as anything more than what the caller called itself. Nothing here needs to change
# for the verification to work, and nothing here CAN make it stronger: an argument this bridge
# sends is, by construction, the half that is not checked.
REQUESTER_OVERRIDE = os.environ.get("YOS_MCP_REQUESTER", "").strip()

# Filled from the `initialize` params. Never trusted for anything but a label.
_CLIENT = {}


# ── Which agent this bridge acts for ────────────────────────────────────────────────────
#
# A harness that runs one of the person's agents starts this bridge with that agent's token in
# `YANTRIK_AGENT_TOKEN` (design/agents-workspace-2026-09-23.md, decision 3). Every `yos act` from
# here then carries it BESIDE the arguments — `yos` reads the same variable and sends it as the
# top-level `agent_token` of `app.act` — and the shell resolves it to the agent, checking that the
# calling process descends from that agent's harness. Three rules about it, and all three are
# about where a secret must not end up:
#
#   * It goes to `yos` through the ENVIRONMENT, never the command line. Any user on the machine
#     can read another process's command line (/proc/<pid>/cmdline); only the same user can read
#     its environment.
#   * It is never an argument. `args` is what the approval card draws, what
#     `record_unasked_action` writes to `mind-audit.jsonl` and what a grant is bound to; a token
#     in any of them is a token anyone reading the screen or the log can replay. An `agent_token`
#     a model puts into `args` is dropped (see `act_pairs`) rather than sent.
#   * It is never shown. Nothing this bridge returns or logs repeats it (`scrub`).
#
# With a token, a command runs in the agent's own terminal in its pane — `shell.agent_run` —
# rather than being typed into the person's Terminal, and the first-class command tools below are
# offered. Without one, nothing here changes.
AGENT_TOKEN_ENV = "YANTRIK_AGENT_TOKEN"
AGENT_TOKEN = os.environ.get(AGENT_TOKEN_ENV, "").strip()


def scrub(text):
    """`text` with this bridge's agent token taken out, wherever it appears."""
    if not AGENT_TOKEN or not isinstance(text, str) or AGENT_TOKEN not in text:
        return text
    return text.replace(AGENT_TOKEN, "[agent token]")


def yos_env():
    """The environment every `yos` this bridge runs gets.

    yos reaches the compositor's session bus and the audio server, and without those it sees an
    empty desktop and reports that as fact. The agent token is set from what this bridge was
    started with, and removed when it was started with none, so an empty variable is never sent
    as a token.
    """
    env = dict(os.environ)
    env.setdefault("XDG_RUNTIME_DIR", "/run/user/%d" % os.getuid())
    env.setdefault("WAYLAND_DISPLAY", "wayland-0")
    if AGENT_TOKEN:
        env[AGENT_TOKEN_ENV] = AGENT_TOKEN
    else:
        env.pop(AGENT_TOKEN_ENV, None)
    return env


def reach_file():
    """Where the shell publishes every live agent's reach, beside its settings.

    Worked out per call rather than at import, because `reach_names` is advice in a sentence
    and must read the file as it stands when the failure happens, not as it stood when this
    process started — the shell rewrites it as roles come and go.
    """
    home = os.environ.get("HOME") or os.path.expanduser("~")
    return os.path.join(home, ".config", "yantrik", "agent-reach.json")


def reach_names(app):
    """Whether this bridge's own agent reach names `app` — the wording of one sentence, not a
    decision.

    A role told "notes is closed, open it first" once tried and was refused for trying (#195).
    The door has since learned that a reach may open the apps it names, whatever its ceiling
    (`yantrik_ipc_transport::reach::within`); this mirrors that one rule so the way forward can
    say the open will be allowed, where the role reads it. The file keeps the SHA-256 of each
    token, never the token. Every way of not knowing — no token here, no file, no entry, a file
    that will not parse — answers False and the sentence then promises nothing; the door, which
    reads the same file, remains the only thing that decides.
    """
    if not AGENT_TOKEN or not isinstance(app, str):
        return False
    digest = hashlib.sha256(AGENT_TOKEN.strip().encode("utf-8")).hexdigest()
    try:
        with open(reach_file(), encoding="utf-8") as fh:
            entries = json.load(fh).get("agents") or []
    except (OSError, ValueError, AttributeError):
        return False
    wanted = app.strip().lower()
    for entry in entries:
        if not isinstance(entry, dict) or entry.get("token_sha256") != digest:
            continue
        # A surface `app`, `app.action` or `app.prefix*` names the app before its first dot,
        # exactly as the door's rule reads it.
        for surface in entry.get("surfaces") or []:
            if isinstance(surface, str) and surface.split(".", 1)[0].strip().lower() == wanted:
                return True
    return False


def log(message):
    """One line to stderr, for a person reading afterwards to find out why.

    stderr is the only channel here that is not the protocol — stdout carries JSON-RPC and
    nothing else — and a harness keeps it: Hermes writes it to `~/.hermes/logs/mcp-stderr.log`.
    Used sparingly, for the things that are invisible otherwise. A poll of a live approval card
    that fails is the first of them: the person is looking at a card, the shell logs the polls it
    RECEIVES, and until now a poll that never arrived left no trace anywhere.
    """
    sys.stderr.write("yos-mcp: %s\n" % scrub(str(message)))
    sys.stderr.flush()


def requester_name(state=None):
    """The name the caller gives itself, for the card's `says the caller` line.

    Not an identity and never presented as one. What the machine establishes for itself — the
    peer's pid and uid from the socket, resolved through /proc — is worked out in the shell,
    from the connection this bridge's `yos` subprocess opens, and needs nothing from here.

    `state` is a `describe shell` state dict, if one is to hand.
    """
    if REQUESTER_OVERRIDE:
        return REQUESTER_OVERRIDE
    name = str(_CLIENT.get("name") or "").strip()
    if name:
        version = str(_CLIENT.get("version") or "").strip()
        return "%s %s" % (name, version) if version else name
    for mind in (state or {}).get("minds") or []:
        if mind.get("answering") and str(mind.get("name") or "").strip():
            return str(mind["name"]).strip()
    return "an unnamed caller"

# ── What os_describe says it takes ──────────────────────────────────────────────────────
#
# The apps a mind can describe are the ones this machine declares, not a list written here. They
# are read from the `.desktop` files — `X-Yantrik-Surface` and `X-Yantrik-Purpose` — the same keys
# the shell lists closed apps by (docs/app-control.md, "Findable while closed"), with the same
# rules as `yos`'s `declared_surfaces`, which the selftest holds this copy to. Local files only:
# `tools/list` is answered on the read loop and must not wait on a socket.

OS_DESCRIBE_HEAD = ("The current state of one app or service on this computer: what it is "
                    "showing and which actions it offers, with each action's exact name, "
                    "arguments and permission grade. Describe an app before acting on it. "
                    "Takes a short name: 'shell' (the desktop — windows, files, opening apps)")
OS_DESCRIBE_TAIL = (", or a service os_apps lists as answering — a closed app's service answers "
                    "for it under the app's name. An app with a large family of related actions "
                    "lists that family as signatures and grades only — enough to see that an "
                    "action exists — and says so; pass that family's prefix as `actions` to get "
                    "what each of them does.")
SURFACE_NAME = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")


def fold_name(name):
    return name.strip().lower().replace("_", "-").replace(" ", "-")


def application_dirs():
    dirs = []
    if os.environ.get("HOME"):
        dirs.append(os.path.join(os.environ["HOME"], ".local/share/applications"))
    if os.environ.get("XDG_DATA_HOME"):
        dirs.append(os.path.join(os.environ["XDG_DATA_HOME"], "applications"))
    data_dirs = os.environ.get("XDG_DATA_DIRS")
    if data_dirs is not None:
        dirs.extend(os.path.join(d, "applications") for d in data_dirs.split(":") if d.strip())
    else:
        dirs.extend(["/usr/share/applications", "/usr/local/share/applications"])
    dirs.append("/opt/yantrik/share/applications")
    return list(dict.fromkeys(dirs))


def try_exec_found(program):
    """Whether the program a `TryExec` key names is on this machine: by path as written, or in
    /opt/yantrik/bin, or on PATH — the places the shell itself looks (`yantrik-ui`'s
    `find_program`)."""
    if os.path.sep in program:
        return os.path.isfile(program) and os.access(program, os.X_OK)
    deployed = os.path.join("/opt/yantrik/bin", program)
    if os.path.isfile(deployed) and os.access(deployed, os.X_OK):
        return True
    return shutil.which(program) is not None


def declared_surfaces(dirs=None):
    """`[{id, purpose, aliases}]` for every surface the installed .desktop files declare."""
    entries, seen = [], set()
    for directory in (dirs if dirs is not None else application_dirs()):
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for filename in names:
            if not filename.endswith(".desktop") or filename[:-8] in seen:
                continue
            keys, group = {}, None
            try:
                with open(os.path.join(directory, filename), encoding="utf-8", errors="replace") as fh:
                    lines = fh.read().splitlines()
            except OSError:
                continue
            for line in lines:
                line = line.strip()
                if line.startswith("["):
                    group = line
                elif group == "[Desktop Entry]" and "=" in line and not line.startswith("#"):
                    key, value = line.split("=", 1)
                    keys[key.strip()] = value.strip()
            if (keys.get("Type") != "Application" or keys.get("NoDisplay") == "true"
                    or keys.get("Hidden") == "true" or not keys.get("Name") or not keys.get("Exec")):
                continue
            # `TryExec` is the standard "list it only if this program is installed" rule —
            # yos's read_desktop_entry applies it too, and the selftest holds the copies
            # together. It is what keeps an adapter for an app nobody installed out of the
            # names os_describe offers a mind (#214).
            try_exec = keys.get("TryExec", "").split()
            if try_exec and not try_exec_found(try_exec[0]):
                continue
            seen.add(filename[:-8])
            entries.append(keys)
    entries.sort(key=lambda k: k["Name"].lower())
    surfaces = []
    for keys in entries:
        sid = fold_name(keys.get("X-Yantrik-Surface", ""))
        if not SURFACE_NAME.match(sid) or sid in ("shell", "yantrik"):
            continue
        mine = next((s for s in surfaces if s["id"] == sid), None)
        if mine is None:
            surfaces.append({"id": sid, "purpose": keys.get("X-Yantrik-Purpose", ""), "aliases": []})
        elif not mine["purpose"]:
            mine["purpose"] = keys.get("X-Yantrik-Purpose", "")
    for keys in entries:
        mine = next((s for s in surfaces
                     if s["id"] == fold_name(keys.get("X-Yantrik-Surface", ""))), None)
        if mine is None:
            continue
        for alias in (fold_name(a) for a in keys.get("X-Yantrik-Aliases", "").split(";")):
            if (not alias or not SURFACE_NAME.match(alias) or alias == mine["id"]
                    or alias in ("shell", "yantrik") or alias in mine["aliases"]):
                continue
            if not any(s is not mine and (s["id"] == alias or alias in s["aliases"])
                       for s in surfaces):
                mine["aliases"].append(alias)
    return surfaces


def os_describe_text(dirs=None):
    """os_describe's description, naming the apps this machine declares, with what each is for."""
    try:
        surfaces = declared_surfaces(dirs)
    except Exception:  # a listing must never fail over a stray file
        surfaces = []
    if not surfaces:
        return OS_DESCRIBE_HEAD + OS_DESCRIBE_TAIL
    named = "; ".join("'%s'%s" % (s["id"], (" (%s)" % s["purpose"]) if s["purpose"] else "")
                      for s in sorted(surfaces, key=lambda s: s["id"]))
    return (OS_DESCRIBE_HEAD + ", one of the apps this machine has, open or closed: " + named
            + OS_DESCRIBE_TAIL)


