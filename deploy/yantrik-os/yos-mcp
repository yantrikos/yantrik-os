def offered():
    """The tools this bridge offers: the desktop's, and an agent's own when it runs as one."""
    return TOOLS + (AGENT_TOOLS if AGENT_TOKEN else [])


def listing(tool):
    """One tool as `tools/list` publishes it."""
    entry = {k: tool[k] for k in ("name", "description", "inputSchema", "annotations") if k in tool}
    if tool["name"] == "os_describe":
        entry["description"] = os_describe_text()
    if AGENT_TOKEN and tool["name"] == "os_act":
        entry["description"] = entry["description"] + OS_ACT_WITH_AGENT
    return entry


def agent_timeout(wait):
    """How long a `yos act` that waits `wait` seconds for a command is given before giving up."""
    try:
        wait = AGENT_WAIT_DEFAULT if wait is None else float(wait)
    except (TypeError, ValueError):
        wait = AGENT_WAIT_DEFAULT
    wait = min(max(wait, 0.0), float(AGENT_WAIT_MOST))
    return max(ACT_TIMEOUT, int(wait + AGENT_WAIT_MARGIN))


def hand_off_timeout(wait):
    """How long a `yos act shell hand_off` is given: an ordinary act's minute, or — when it waits
    for the role's answer — that wait and a margin, as a command's wait is given."""
    try:
        waiting = wait not in (None, "") and float(wait) > 0
    except (TypeError, ValueError):
        waiting = False
    return agent_timeout(wait) if waiting else ACT_TIMEOUT


def agent_route(args):
    """`os_act terminal.run`, as the agent's own terminal would take it — or None to leave it be.

    Only with a token. The person's Terminal stays the person's: a command an agent runs gets a
    terminal of its own, and nobody's window is opened or raised for it. The arguments keep their
    meaning — `command`, and `cwd` and `wait` if a mind sent them — and a bare string is the
    command, as the Terminal's one-parameter `run` would have read it.
    """
    if not AGENT_TOKEN:
        return None
    app = str(args.get("app") or "").strip()
    if app not in ("terminal", "app-terminal") or args.get("action") != "run":
        return None
    given = args.get("args")
    if isinstance(given, str):
        try:
            parsed = json.loads(given)
        except ValueError:
            parsed = None
        given = parsed if isinstance(parsed, dict) else {"command": given}
    given = given if isinstance(given, dict) else {}
    routed = {k: given[k] for k in ("command", "cwd", "wait") if given.get(k) not in (None, "")}
    return {"app": "shell", "action": "agent_run", "args": routed}


def agent_args(name, args):
    """A command tool's arguments, as the shell's action names them."""
    passed = AGENT_BY_NAME.get(name, {}).get("pass")
    if passed is not None:
        # The other-agent tools take the shell's own names, and nothing else — an `agent_token`
        # among them included, which never leaves this process as an argument.
        return {k: args[k] for k in passed if args.get(k) not in (None, "")}
    out = {}
    if name == "run_command":
        out["command"] = args.get("command")
        if args.get("cwd") not in (None, ""):
            out["cwd"] = args.get("cwd")
    else:
        out["job"] = args.get("job")
    if name == "command_input":
        out["text"] = args.get("text")
    if name in ("run_command", "command_status") and args.get("wait_seconds") is not None:
        out["wait"] = args.get("wait_seconds")
    return out


def seconds(ms):
    """`1.2 s`, `47 s`, `2m 14s` — how long a command ran, for a sentence."""
    try:
        secs = float(ms) / 1000.0
    except (TypeError, ValueError):
        return "a while"
    if secs < 10:
        return "%.1f s" % secs
    if secs < 60:
        return "%d s" % secs
    if secs < 3600:
        return "%dm %02ds" % (secs // 60, secs % 60)
    return "%dh %02dm" % (secs // 3600, (secs % 3600) // 60)


def command_text(result, names):
    """The shell's answer about a command, as a mind reads it: one line on how it stands, then
    what the terminal showed.

    `names` is what to call the follow-up tools — the command tools' names, or `os_act shell`
    actions for a mind that came through `os_act`.
    """
    job = result.get("job")
    if result.get("running"):
        if result.get("waiting_for_input"):
            head = ("still running after %s, and it looks like it is waiting for input (job %s). "
                    "The person can answer in its card on the desktop; %s sends it text (end with "
                    "\\n to press Return); %s stops it."
                    % (seconds(result.get("elapsed_ms")), job, names["input"], names["kill"]))
        else:
            head = ("still running after %s (job %s). %s waits for it again; %s stops it; if it "
                    "ends before you ask, you are told at the start of your next turn."
                    % (seconds(result.get("elapsed_ms")), job, names["status"], names["kill"]))
    else:
        if "exit_code" in result:
            how = "exit code %s" % result["exit_code"]
        elif "signal" in result:
            how = "ended by %s" % (result.get("signal_name") or "signal %s" % result["signal"])
        else:
            how = "ended"
        if result.get("killed"):
            how += " (it was stopped)"
        head = "%s after %s, in %s." % (how, seconds(result.get("elapsed_ms")),
                                        result.get("cwd_after") or result.get("cwd"))
        if result.get("note"):
            head += " " + str(result["note"]) + "."
    tail = str(result.get("tail") or "").rstrip("\n")
    body = tail if tail else "(no output)"
    if result.get("tail_clipped"):
        body = ("[the whole output is in your pane on the desktop; these are its last lines]\n"
                + body)
    return head + "\n\n" + body


COMMAND_TOOL_NAMES = {"status": "command_status", "input": "command_input",
                      "kill": "command_kill"}
OS_ACT_NAMES = {"status": "os_act shell agent_job", "input": "os_act shell agent_input",
                "kill": "os_act shell agent_kill"}


def routed_text(out):
    """What an `os_act terminal.run` that went to the agent's own terminal answers: where it ran,
    then the command's end — named for a mind that knows `os_act`."""
    result = result_object(out)
    said = (command_text(result, OS_ACT_NAMES)
            if isinstance(result, dict) and "job" in result else out)
    return ("(ran in a terminal of your own, in your pane on the desktop — shell.agent_run — not "
            "in the person's Terminal)\n\n" + said)


def run_agent_tool(tool, args):
    """One of the command tools, as an `os_act` on the shell. Returns (text, is_error, meta).

    `meta` is the shell's answer as it came, for a client that wants the exit code as a number
    rather than a sentence — pi's `bash`, which is made from `run_command`.
    """
    missing = [k for k in tool["inputSchema"].get("required", [])
               if args.get(k) is None or (k != "text" and args.get(k) == "")]
    if missing:
        return "%s needs %s." % (tool["name"], " and ".join(repr(k) for k in missing)), True, None
    seen = {}

    def present(out):
        result = result_object(out)
        if not isinstance(result, dict) or "job" not in result:
            return out
        seen["result"] = result
        return command_text(result, COMMAND_TOOL_NAMES)

    def present_agent(out):
        # The shell's own sentence, or — for read_agent — the session as text. Never the JSON.
        result = result_object(out)
        if not isinstance(result, dict):
            return out
        return str(result.get("text") or result.get("said") or out)

    act = {"app": "shell", "action": tool["agent_action"], "args": agent_args(tool["name"], args)}
    if "pass" in tool:
        text, is_error = run_tool(BY_NAME["os_act"], act, present=present_agent)
        # A hand-off that waited hands back what the role said — whatever it read on the way.
        read_another = (tool["name"] in PRIVATE_READS
                        or (tool["name"] == "hand_off" and act["args"].get("wait_seconds")))
        if read_another and not is_error and not text.startswith("REFUSED"):
            # Another agent's session holds whatever it read: this session has now seen it too.
            _SAW_PRIVATE.append(tool["name"])
        return text, is_error, None
    text, is_error = run_tool(BY_NAME["os_act"], act, present=present)
    return text, is_error, seen.get("result")


def call_tool(tool, args):
    """Any tool this bridge offers. Returns (text, is_error, meta)."""
    if tool["name"] in AGENT_BY_NAME:
        return run_agent_tool(tool, args)
    text, is_error = run_tool(tool, args)
    return text, is_error, None


# The OS grades every action it publishes: safe < standard < sensitive < dangerous. Of the
# 46 actions on this desktop, 40 are `standard` — open a note, save, append, search — and
# six are not: killing a process, removing a container, locking the session.
#
# That grade is the OS's own judgement about its own surface, and it is finer than anything
# this bridge could infer, so it is what decides. Everything at or below the ceiling runs;
# anything above it is refused HERE, in the process that would otherwise make the call.
# A caller cannot argue with it, because the refusal is not advice passed upstream — it is
# the absence of an invocation.
def act_pairs(a):
    """Turn an os_act call's arguments into the key=value pairs `yos act` expects.

    A model asked to append a line will often send the line itself where an object was
    specified — `"args": "the text"` rather than `{"text": "the text"}`. That is a
    reasonable thing to have meant, and refusing it teaches nothing: the caller cannot see
    which parameter name it should have used without another round trip. So a bare string
    is resolved against the action's own schema, and only genuinely ambiguous cases fail.
    """
    args = a.get("args")
    if not args:
        return []

    if isinstance(args, str):
        # It may simply be JSON that arrived as text.
        try:
            parsed = json.loads(args)
        except ValueError:
            parsed = None
        if isinstance(parsed, dict):
            args = parsed
        else:
            names = list(action_parameters(a.get("app"), a.get("action")))
            if len(names) == 1:
                args = {names[0]: args}
            else:
                raise ValueError(
                    "args arrived as a bare value but %s.%s takes %s. Send an object, e.g. "
                    '{"%s": ...}.' % (a.get("app"), a.get("action"),
                                      ("no parameters" if not names else "parameters " + ", ".join(names)),
                                      names[0] if names else "param")
                )

    if not isinstance(args, dict):
        raise ValueError("args must be an object of parameter names to values, got %s"
                         % type(args).__name__)

    # Values are stringified rather than json-dumped so a plain string arrives as
    # `text=hello`, not `text="hello"` with the quotes becoming part of the note.
    #
    # An `agent_token` among the arguments is dropped, never sent: which agent a call is for rides
    # beside the arguments, from this bridge's own environment (see AGENT_TOKEN), and `yos` would
    # otherwise lift an `agent_token=` pair out and use it in place of the real one.
    return ["%s=%s" % (k, v if isinstance(v, str) else json.dumps(v)) for k, v in args.items()
            if k != "agent_token"]


def yos(args, timeout):
    """Run `yos` and hand back the completed process, or None if it could not run at all.

    One place, because five callers now need the same environment (`yos_env`): yos reaches the
    compositor's session bus and the audio server, and without those it sees an empty desktop and
    reports that as fact — and an act for one of the person's agents carries its token.
    """
    try:
        # stdin is closed to the child on purpose. This process's own stdin is the client's
        # JSON-RPC stream, and a `yos` that inherited it could read a request meant for the
        # bridge — bytes that are then simply gone. Nothing `yos` does today reads stdin; this
        # is so that nothing it does later can.
        return subprocess.run([YOS] + list(args), capture_output=True, text=True,
                              timeout=timeout, env=yos_env(), stdin=subprocess.DEVNULL)
    except (subprocess.TimeoutExpired, FileNotFoundError, OSError):
        return None


def action_parameters(app, action):
    """What one action takes: parameter name → published type, in the order the app lists them.

    Read from the OS's own description of itself rather than guessed. `describe` prints the
    signature and then, indented under it, one line per parameter — `id: string — the
    notification id` — which is where the type comes from. A parameter with no type line (an
    older app, or a folded family) maps to None, and every caller here treats that as "nothing
    was said" rather than as a type.
    """
    if not app or not action:
        return {}
    p = yos(["describe", app], SHELL_CALL_TIMEOUT)
    if p is None or p.returncode != 0:
        return {}
    lines = (p.stdout or "").splitlines()
    for i, line in enumerate(lines):
        m = re.match(r"^\s*act:\s*([A-Za-z0-9_]+)\(([^)]*)\)", line)
        if not m or m.group(1) != action:
            continue
        found = {n.strip().rstrip("?"): None
                 for n in m.group(2).split(",") if n.strip()}
        # The argument lines belong to this action until the next `act:` starts another one.
        for rest in lines[i + 1:]:
            if re.match(r"^\s*act:\s", rest):
                break
            arg = re.match(r"^ {8,}([A-Za-z0-9_]+)\??:\s*(.+?)\s*(?:[-—]\s.*)?$", rest)
            if arg and arg.group(1) in found:
                declared = arg.group(2).strip()
                if declared.startswith("one of "):
                    # `yos` renders an enum parameter as `mode: one of a | b`, but what the app
                    # publishes is `{"type": "string", "enum": [...]}`, and the CLI's own
                    # `declared_types` reads that JSON and says "string". Saying the same here
                    # keeps an enum value like "1" the text the CLI will hand the app; the
                    # rendered words would make `read_value` parse it as JSON instead, and the
                    # card would bind a number no app ever receives.
                    declared = "string"
                found[arg.group(1)] = declared
        return found
    return {}


def read_value(text, declared):
    """One `key=value` value, read the way the parameter it is bound for wants it.

    `yos`'s own rule, and deliberately a copy of it rather than an import: this bridge reaches
    `yos` by running it, and cannot load it as a module. The two are pinned together in
    `yos-mcp-selftest.py`, which loads both files and drives this function and `yos.read_value`
    through the same table — because a bridge that predicted a different value than the CLI
    produces would bind an approval to something the machine never ran.
    """
    try:
        parsed = json.loads(text)
    except ValueError:
        return text
    if isinstance(parsed, str):
        return parsed
    if declared == "string":
        return text
    return parsed


# `yos.GUARD_TYPES`: the guard around the call rather than an argument to the action, so no app
# declares it and the CLI knows it on its own. Kept here for the same reason as `read_value` —
# the two have to predict the same value.
GUARD_TYPES = {"expect_revision": "string"}


def effective_args(a):
    """The arguments as the app will actually receive them.

    This matters because a grant is bound to exact values. os_act renders every value to text
    for `yos act k=v` and `yos` reads each one back against the type the app published — a
    round trip that changes a value in a specific way: for a `number` parameter "3" arrives as
    3, for a `boolean` "true" as True. Binding the approval to what the model typed rather than
    to what the app will run with would mean the card showed one thing and the machine did
    another, which is the whole failure this feature exists to prevent. So the round trip
    happens once, here, and the same dict is what the card shows, what the grant binds, and
    what the call sends.

    Raises ValueError for arguments that cannot be resolved — the same error, from the same
    helper, that building the command line would have raised a moment later.
    """
    pairs = act_pairs(a)
    types = dict(GUARD_TYPES)
    # A second describe is only worth it when some value would read as something other than
    # text. `{"title": "Dentist"}` means the same thing however the parameter is declared, and
    # `yos` skips the same lookup on the same test, so the two stay in step on the cheap path.
    if any(ambiguous(pair) for pair in pairs):
        types.update({k: v for k, v in action_parameters(a.get("app"), a.get("action")).items()
                      if k not in GUARD_TYPES})
    out = {}
    for pair in pairs:
        key, value = pair.split("=", 1)
        out[key] = read_value(value, types.get(key))
    return out


def ambiguous(pair):
    """Whether this `key=value` needs the app's declaration to be read correctly."""
    key, _, text = pair.partition("=")
    if key in GUARD_TYPES:
        return False
    try:
        return not isinstance(json.loads(text), str)
    except ValueError:
        return False


# ── Keeping private data from walking out ───────────────────────────────────────────────
#
# A leak needs three things at once: reach into private data, exposure to content someone
# else wrote, and a way to send outward. An agent on this desktop has all three, so one of
# them has to be broken.
#
# The naive break — taint on reading a web page — makes the browser useless: read a search
# page, and you can no longer type in its search box. So the taint tracks the leg that is
# actually diagnostic: has this session looked at anything PRIVATE? Browsing stays free for
# a session that has only ever seen the open web, because a session that has seen no secrets
# has none to spend. The moment it reads app state, machine events or machine audio, putting
# data into a page stops being free.
#
# Scope is the process. A harness spawns this bridge once and keeps it, so process lifetime
# is session lifetime. There is deliberately NO tool to clear the taint — a caller that can
# untaint itself is not constrained, and the only way back is a new session, which is a
# person's decision rather than an agent's.
PRIVATE_READS = {"os_describe", "os_perception", "web_listen",
                 # Another agent's session: what it read, its commands' output.
                 "read_agent"}
OUTBOUND = {"web_type", "web_go"}

_SAW_PRIVATE = []          # what tainted this session, in order, for the refusal message
TAINT_OFF = os.environ.get("YOS_MCP_NO_TAINT") == "1"


def payload_in_url(url):
    """Does this URL carry data, as opposed to just naming a place?

    A query string, a fragment, or userinfo can carry anything. Those are the shapes a
    secret leaves in; a bare path is navigation. Length alone is not the test — a long
    article path is innocent and a short ?k= is not.
    """
    try:
        from urllib.parse import urlsplit
        u = urlsplit(url)
    except Exception:
        return True  # unparseable is not a reason to allow it
    if u.query or u.fragment:
        return True
    if "@" in (u.netloc or ""):
        return True
    return False


def taint_refusal(name, args):
    """Refuse an outbound call once this session has seen private data. None = allow."""
    if TAINT_OFF or not _SAW_PRIVATE or name not in OUTBOUND:
        return None
    if name == "web_go" and not payload_in_url(args.get("url", "")):
        # Plain navigation carries nothing out; going somewhere is not saying something.
        return None
    saw = ", ".join(dict.fromkeys(_SAW_PRIVATE))
    what = "type into a page" if name == "web_type" else "open a URL carrying data in it"
    return ("this session has already read private state (%s), so it will not %s. "
            "Whatever is on this machine could be carried out that way, and nothing here "
            "can tell an innocent string from a secret. A person has to do this part, or "
            "start a fresh session that has not read anything private." % (saw, what))



LADDER = ["safe", "standard", "sensitive", "dangerous"]

# A cap this SESSION puts on itself, set by whoever started the bridge. It bounds what may run
# without a person being asked, so a harness that wants to be careful on a machine in `auto`
# sets it to `standard` and gets cards back instead of silent runs.
#
# It binds only when it is actually SET, and that is the whole of why: the desktop now has a
# real policy — the mode the person chose — and a default sitting here would quietly overrule
# it. The historical default was `standard`, which is exactly what `ask` mode already does, so
# leaving it unset changes nothing for the desktop this bridge shipped against and stops `auto`
# from being neutered by a value nobody set.
#
# It can only ever TIGHTEN. The mode and the machine ceiling both outrank it, so setting it to
# `dangerous` on a desktop in `ask` mode does not stop the asking. A value that is not on the
# ladder is not a permission to do anything, so it is treated as unset rather than left to
# whatever `LADDER.index` would have raised.
CEILING = os.environ.get("YOS_MCP_MAX_PERMISSION", "").strip()
CEILING_SET = CEILING in LADDER
if not CEILING_SET:
    CEILING = "standard"


# Why the last attempt to grade (app, action) came back empty, in words for the caller.
#
# Per thread, because this bridge answers several calls at once now (see `main`): two tool calls
# asking about the same shut app would otherwise write each other's reason, and the explanation a
# mind is given would be the one belonging to somebody else's call.
_LOCAL = threading.local()


def ungraded_because(app, action, why=None):
    """Remember, or recall, why grading one action came back empty — for THIS call."""
    seen = getattr(_LOCAL, "ungraded", None)
    if seen is None:
        seen = _LOCAL.ungraded = {}
    if why is not None:
        seen[(app, action)] = why
    return seen.get((app, action), "")


def action_detail(app, action):
    """How the OS grades one of its own actions, and what the app says the action is for.

    Returns `(grade, purpose)`. The grade is None when it cannot be established — a missing
    app, a renamed action, a describe that would not answer. None is not "safe": an ungradeable
    action is refused, because the failure that matters here is running something whose cost was
    never read.

    It returns the purpose as well as the grade because the purpose is what a person is actually
    shown when they are asked. The app publishes it for every action ("Delete an event from the
    calendar. It is not recoverable."), `yos describe` prints it under the signature since
    d73760d, and a card that showed `calendar.delete_event` and six arguments without that
    sentence would be asking somebody to authorise a name.

        `  act: delete_event(id)  [sensitive, settles on return]`
        `       Delete an event from the calendar. It is not recoverable.`
        `         id: string — the event's id, as list_events reports it`

    Two-space signature, seven-space purpose, nine-space arguments — so the purpose is the line
    under the signature indented past it but not as far as an argument.

    **Not `--fold`.** The folded form is for a mind reading a describe, and it prints a large
    family of actions as signatures only — no purpose lines. This function's whole job is to
    recover the purpose line, because it is what the approval card shows the person. Folding here
    would produce cards that named an action and gave no reason for it, for exactly the apps with
    the most actions.
    """
    p = yos(["describe", app], SHELL_CALL_TIMEOUT)
    if p is None or p.returncode != 0:
        # Why it could not be read is the useful half. The first mind to use this bridge on a
        # real machine asked for `calendar add_event` while Calendar was closed and was told
        # "cannot establish how 'calendar' grades 'add_event' … check the name" — the name was
        # right, the app was shut, and it cost a minute of a small model's time to work that
        # out. `yos` already says which it is; keep what it said.
        ungraded_because(app, action, (p.stderr or "").strip() if p is not None else
                         "the desktop did not answer in time")
        return None, ""
    lines = (p.stdout or "").splitlines()
    offered = re.findall(r"^\s*act:\s*([A-Za-z0-9_]+)\(", p.stdout or "", re.M)
    if offered:
        ungraded_because(app, action,
                         "%s is open and offers no action called %s. It offers: %s"
                         % (app, action, ", ".join(offered)))
    else:
        # A describe that answers and lists no actions at all is not an app with nothing to
        # offer: it is the SERVICE of the same name answering for a window that is shut. `yos`
        # falls through from `app-calendar` to `calendar` on purpose, so that a closed window
        # never hides what is stored. A mind asked for `calendar add_event` that way, was told
        # "calendar is open and offers no action called add_event. It offers: nothing" — three
        # statements, all false — and worked out by itself that the window had to be opened.
        # Said as what it is, it takes the same road as an app with no socket.
        ungraded_because(app, action,
                         "%s is not open: only its background service answered, which "
                         "reports what is stored and takes no actions" % app)
    for i, line in enumerate(lines):
        m = re.match(r"^\s*act:\s*([A-Za-z0-9_]+)\([^)]*\)\s*\[([a-z]+),", line)
        if not m or m.group(1) != action:
            continue
        purpose = ""
        if i + 1 < len(lines):
            after = lines[i + 1]
            if after.startswith("       ") and not after.startswith("         "):
                purpose = after.strip()
        return m.group(2), purpose
    return None, ""


def shell_state():
    """The shell's own state object out of `yos describe shell`, or None.

    One read, four answers: this machine's standing ceiling, what the mind may do without being
    asked, the session rules a person has granted, and which mind the desktop says is answering.
    Each of those used to be — or would have been — its own `yos describe shell`, and asking the
    same question twice on the path to putting a card up is two chances for them to disagree.

    `--fold` because this is read by a program, not by a mind: it prints the same state object,
    still parseable from the first `{`, without the pretty-printing. The one thing folding leaves
    out of the SHELL's state is its `apps` list — nothing here needs it, and anything added later
    that does must drop the flag rather than reach for a missing key.
    """
    p = yos(["describe", "shell", "--fold"], SHELL_CALL_TIMEOUT)
    if p is None or p.returncode != 0:
        return None
    return result_object(p.stdout or "")


# ── What the mind may do without being asked ────────────────────────────────────────────
#
# One fixed policy — ask about everything sensitive — is wrong at both ends of a day's work. A
# long trusted job becomes forty cards, and a person trained to click Allow forty times will
# click it on the forty-first without reading; "just look, don't touch" had no expression at all.
# So the desktop has a mode, the person sets it, and this bridge reads it.
#
# The decision table below is a SECOND implementation of `mind_mode::Modes::decide` in
# `crates/yantrik-ui/src/mind_mode.rs`, which is the definition and the one with the unit tests.
# It is duplicated deliberately: the alternative is a second round trip per `os_act` to ask the
# shell to decide, and the mode already arrives on the read this bridge was making anyway. The
# cost is that the two can drift; the selftest checks this copy against the same table.
MODES = ["plan", "ask", "auto", "bypass"]


def mind_mode(state):
    """`(mode, rules)` as the desktop publishes them, or `(None, [])` if it did not say.

    `None` is not a mode and is never treated as one: the caller falls back to `ask` with no
    rules, which is the strictest thing that still lets ordinary work happen.
    """
    block = (state or {}).get("mind_mode") or {}
    mode = str(block.get("mode") or "")
    if mode not in MODES:
        return None, []
    rules = []
    for rule in block.get("session_rules") or []:
        app, action = str(rule.get("app") or ""), str(rule.get("action") or "")
        if app and action:
            rules.append((app, action))
    return mode, rules


# Every answer the table can give, and the only vocabulary the two implementations share.
#
# The three refusals are NAMED rather than lumped together as one word, because this table is
# written twice — here and in `mind_mode::Modes::decide` in the shell — and two copies drift
# silently in the direction nobody tests. `deploy/yantrik-os/mind-mode-vectors.json` is generated
# from the shell's copy, and `yos-mcp-selftest.py` drives this one through every vector in it;
# that only works if both sides can name the same outcome rather than comparing two paragraphs.
OUTCOMES = ("run", "run_logged", "ask", "refuse_grade", "refuse_ceiling", "refuse_mode")


# The same seven phrases, in the same order, as `approvals::unrecoverable` in
# `crates/yantrik-ui/src/approvals.rs`. Kept as a named constant beside the function rather than
# inlined, so the two lists can be read side by side without reading two functions.
UNRECOVERABLE_PHRASES = (
    "not recoverable",
    "cannot be undone",
    "can't be undone",
    "irreversible",
    "permanently",
    "permanent",
    "no undo",
)


def unrecoverable(purpose):
    """Does the app's own sentence about this action say it cannot be taken back?

    A port of `approvals::unrecoverable`, phrase for phrase: lowercase the purpose, then look
    for any of them as a substring. Not a paraphrase and not a regex — the shell draws the
    card's red warning line from that function and refuses to offer a session rule on the
    strength of it, and this decides whether the bridge asks at all. Two readings of the same
    sentence that disagreed would be a desktop that showed a warning about something it had
    already run, or asked about something the card would not warn about.

    `mind-mode-vectors.json` carries the ANSWER rather than the sentence, so the vectors check
    the table and not this; the selftest checks this against the same phrases directly.
    """
    lower = (purpose or "").lower()
    return any(phrase in lower for phrase in UNRECOVERABLE_PHRASES)


def decide(level, app, action, cannot_undo, mode, rules, machine, cap=None, tool="os_act"):
    """Run it, ask about it, or refuse it — the whole table, as one pure function.

    Returns `(verdict, detail)`:

        ("run", unasked)        `unasked` is True when `ask` mode would have raised a card and
                                this mode did not — exactly the set the audit log exists for.
                                A person who loosened the mode is owed a record of what that
                                bought.
        ("ask", None)           a card in front of the person, and a wait.
        ("refuse_grade", why)   the grade is not one this OS defines. None is not `safe`.
        ("refuse_ceiling", why) above the machine's own `tool_permission`.
        ("refuse_mode", why)    plan mode.

    `cannot_undo` is `unrecoverable()` over the action's own published purpose — the second
    input, and the one that is not a grade. In `auto` it turns a quiet run into a card, exactly
    as `dangerous` does, and in no mode does a session rule cover it. See the 21 September entry
    in `design/mind-modes-2026-09-21.md`; the shell's `Modes::decide` takes the same flag in the
    same position.

    `why` is written to be relayed to a person as it stands.

    Order is the security argument. The machine's ceiling is consulted FIRST, so no mode — not
    even bypass — reaches past the owner's standing policy, and nothing above it is ever put in
    front of a person either: a card no answer of theirs could satisfy teaches them that the card
    is noise.

    Everything the table decides is in here, so there is one function to check against the
    vectors and no second copy for the selftest to agree with by accident. What is deliberately
    NOT in here is everything that needs the world: reading the desktop (`shell_state`), grading
    the action (`action_detail`), and putting the card up (`ask_the_person`).
    """
    # The browser tools carry no grade and never meet the machine ceiling — `yos web` refuses any
    # control whose label reads as a commitment, which is a different question and is enforced
    # inside the same evaluation that would have pressed it. All the mode decides here is whether
    # putting something INTO a page counts as looking. It does not; reading one does, which is
    # why a plan a nobody could research would be worthless. WEB_WRITES is defined below, beside
    # the guard that calls this for them.
    if tool != "os_act":
        if tool in WEB_WRITES and mode == "plan":
            return "refuse_mode", (
                "the desktop is in plan mode, so %s was not run and nothing was changed. Reading "
                "the page — web_read, web_text, web_find — still works. Say what you WOULD click "
                "or type and let the person decide; they switch the mode from the chip in the "
                "status bar." % tool)
        return "run", False

    # `None` is not `safe`. An action whose cost was never read is refused before anything else
    # is consulted, in every mode, because running it is the failure that matters here.
    if level not in LADDER:
        return "refuse_grade", (
            "%s.%s is graded %r, which is not a level this OS defines. Refusing."
            % (app, action, level))

    rank = LADDER.index(level)

    # `in LADDER` rather than `is not None`: a ceiling this OS does not define is not a
    # permission to do anything either, and it must not raise out of an index lookup.
    if machine in LADDER and rank > LADDER.index(machine):
        return "refuse_ceiling", (
            "%s.%s is graded %s, and this machine does not allow callers like this past %s "
            "(`tool_permission`, on the AI page in Settings). The person was NOT asked, because "
            "nothing they could answer would let it run — this limit is the machine's standing "
            "policy, and no mode changes it. Say what you were trying to do; only someone at the "
            "keyboard can change that setting." % (app, action, level, machine))

    # The app's own sentence about the action, and the one input here that is not a grade.
    #
    # Found live on 21 September 2026: `calendar.delete_event` is graded `sensitive` and says
    # "It is not recoverable", and in `auto` it ran with nobody asked — while the mode menu
    # promised "You are still asked about the destructive ones". `safe` is excluded, because a
    # read destroys nothing and wording that happens to match must not turn a look into a card.
    irreversible = bool(cannot_undo) and rank > 0

    # What `ask` mode would have done, which is what the audit exists to record. It carries
    # `irreversible` so an action `ask` would now stop for is still written down when a looser
    # mode runs it anyway.
    would_ask = rank >= LADDER.index("sensitive") or irreversible

    # A session rule turns an ask into a run, and never covers what the app says cannot be
    # undone. The card refuses to OFFER one for such an action, which is checked once at the
    # press; this is checked on every call, so an app that rewords its own purpose after a rule
    # was made cannot leave a standing yes over an action that has since become irreversible —
    # and so that the `auto` rule above means something rather than being answerable by a rule
    # the card would never have made.
    covered = (app, action) in rules and not irreversible

    if mode == "plan":
        if rank == 0:
            verdict, detail = "run", False
        else:
            return "refuse_mode", (
                "the desktop is in plan mode, so %s.%s was NOT run and nothing on this machine "
                "was changed. This is a setting, not a failure, and not something to work "
                "around: os_describe, os_apps, os_perception and reading the web are all still "
                "open to you. Say what you WOULD do — the exact actions and arguments, in order "
                "— and let the person decide. They switch the mode from the chip in the status "
                "bar." % (app, action))
    elif mode == "bypass":
        # Unchanged, and the one mode that is. Bypass does not ask, by definition and by what
        # its confirmation says; a card after "Stop asking me anything" would make that panel a
        # lie. It is written down instead — `would_ask` is true here, so it lands in the audit.
        verdict, detail = "run", would_ask
    elif mode == "auto":
        if rank >= LADDER.index("dangerous") or irreversible:
            verdict, detail = ("run", True) if covered else ("ask", None)
        else:
            verdict, detail = "run", would_ask
    else:
        # `ask`, and anything unrecognised, which the caller has already folded into `ask`.
        if would_ask:
            verdict, detail = ("run", True) if covered else ("ask", None)
        else:
            verdict, detail = "run", False

    # YOS_MCP_MAX_PERMISSION, which a harness sets on ITS side, can only ever be STRICTER than
    # the desktop's mode. It bounds what may run without asking; anything above it that the mode
    # would have run quietly becomes a question instead. It can never loosen anything: a desktop
    # in `ask` mode asks whatever this is set to, and a desktop in `plan` mode has already
    # refused above. A value that is not on the ladder is not a permission to do anything, so it
    # is treated as unset rather than left to whatever an index lookup would have raised.
    #
    # Last, because it is the one layer that is not the desktop's policy — the person's mode
    # decides, and then the harness may hold itself back further.
    if cap in LADDER and verdict == "run" and rank > LADDER.index(cap):
        return "ask", None
    return verdict, detail


def decide_outcome(vector):
    """The table's answer to one vector of `mind-mode-vectors.json`, as one of `OUTCOMES`.

    The same `decide` `guard_act` runs. There is deliberately no second reading of the rules
    here: a selftest that reimplemented the table would only prove that two copies of a mistake
    agree.
    """
    verdict, detail = decide(
        vector.get("grade"),
        vector.get("app"),
        vector.get("action"),
        # The ANSWER, not the sentence. The vectors carry what `unrecoverable()` decided rather
        # than a purpose for each side to read for itself, because then a difference in the
        # phrase lists would show up as a table disagreement over a hundred vectors instead of
        # as the one thing it is. The phrase lists are checked against each other separately.
        vector.get("unrecoverable"),
        vector.get("mode"),
        [tuple(rule) for rule in vector.get("rules") or []],
        vector.get("ceiling"),
        cap=vector.get("env_cap"),
        tool=vector.get("tool") or "os_act",
    )
    if verdict == "run":
        return "run_logged" if detail else "run"
    return verdict


def machine_ceiling(state):
    """This machine's standing policy for callers on the socket, or None if it cannot be read.

    Published by the shell in `describe shell` as `tool_permission` — the same value
    `yantrik-app-runtime::control` enforces inside every `app.act`, read from the same settings
    file, not the Settings screen's copy of it.

    Read rather than guessed, and read rather than provoked. The other way to learn this limit is
    to attempt the action and read the `CEILING:` refusal that comes back, which means doing the
    thing we are deciding about. An approval must not be able to exceed the owner's standing
    policy, and a person asked a question no answer of theirs could satisfy learns that the card
    is noise.
    """
    level = str((state or {}).get("tool_permission") or "")
    return level if level in LADDER else None


def result_object(text):
    """The `result` object out of what `yos act` printed, or None.

    `yos act` prints a summary line, an `accepted:` line, a revision, and then the action's own
    result as `json.dumps(..., indent=2)` — which starts with a bare `{` in column zero. That is
    the anchor; everything before it is prose for a person.
    """
    lines = text.splitlines()
    for i, line in enumerate(lines):
        if line == "{":
            try:
                return json.JSONDecoder().raw_decode("\n".join(lines[i:]))[0]
            except ValueError:
                return None
    return None


def shell_call(action, args, timeout=None):
    """One action on the shell's own control surface. Returns `(result, error)`.

    Values are passed the way `yos act` expects them and `yos` parses each back with
    `json.loads`, so `args_json` — a dict here — arrives at the shell as an object rather than
    as a string. The shell accepts both shapes and canonicalises in one place, so a grant
    requested through this path and consumed through it bind to the same bytes.

    `timeout` is SHELL_CALL_TIMEOUT unless the caller has less than that to spend. The approval
    poll does: it is working to a deadline the mind was promised, and a poll that took the full
    20s would carry the whole call past it.
    """
    if timeout is None:
        timeout = SHELL_CALL_TIMEOUT
    argv = ["act", "shell", action]
    for key, value in args.items():
        argv.append("%s=%s" % (key, value if isinstance(value, str) else json.dumps(value)))
    p = yos(argv, timeout)
    if p is None:
        return None, "the desktop did not answer within %ss" % round(timeout, 1)
    if p.returncode != 0:
        return None, ((p.stderr or "").strip() or (p.stdout or "").strip()
                      or "the desktop refused it and said nothing")
    result = result_object(p.stdout or "")
    if result is None:
        return None, "the desktop answered but %s printed nothing that could be read" % action
    return result, None


def ask_the_person(app, action, grade, purpose, args, requester):
    """Put one action in front of the person, wait, and report exactly what happened.

    Returns `(allowed, message, grant)`. The message is the whole account the mind gets, and it
    is written to be reported onwards as-is: a person who asked for something ordinary should
    hear what their machine did, not a paraphrase of a status code. The grant is the request id
    the person allowed, to be carried on the `yos act` that follows.

    The steps are the shell's, and none of them decides anything: `request_approval` puts a card
    up, `approval_status` reads an answer somebody else gave. The grant is SPENT by the app's own
    dispatch when the action runs (issue #116) — this bridge used to call `consume_approval`
    itself, which put the check in the caller; now every door's call is checked the same way,
    and this bridge's part is to carry the grant it was given. There is no action anywhere on
    this desktop that grants.
    """
    request, err = shell_call("request_approval", {
        "app": app,
        "action": action,
        "grade": grade,
        "purpose": purpose,
        "args_json": args,
        "requester": requester,
    })
    if request is None and "REACH:" in (err or ""):
        # This agent was started as a catalog role, and the act is outside its reach: the shell
        # will not put that question in front of the person. Its own words, naming the role.
        return False, re.sub(r"^yos: ", "", err.strip()), None
    if request is None:
        return False, (
            "%s.%s is graded %s, above this session's %s ceiling, so it needs the person at the "
            "machine to allow it — and they could not be asked: %s. Nothing was run and nothing "
            "was changed. Tell them what you were trying to do and let them decide."
            % (app, action, grade, CEILING, err)), None

    # The desktop decided nobody needed asking. That is not a refusal and not a failure: it
    # happens when this bridge's OWN cap (YOS_MCP_MAX_PERMISSION) is stricter than the desktop's
    # mode, so the bridge wanted a card for something the desktop would have run quietly. The
    # shell will not put a question on screen that its own mode already answers — a person shown
    # one learns that cards are noise — so it says so and the action goes ahead.
    if request.get("status") == "not_needed":
        return True, (
            "This bridge would have asked about %s.%s, because YOS_MCP_MAX_PERMISSION caps it at "
            "%s — but the desktop's current mode (%s) runs this without asking anybody, so no "
            "card was put in front of the person and nobody was disturbed. Report it as "
            "something you did."
            % (app, action, CEILING, request.get("mode", "its current mode"))), None

    request_id = request.get("request_id")
    if not request_id:
        return False, (
            "the desktop was asked to put an approval card up for %s.%s and did not say which "
            "request it was, so there is nothing to wait on. Nothing was run." % (app, action)), None

    # Polled rather than pushed: this bridge has no way to be called back, and a person cannot
    # answer inside the first poll interval anyway.
    #
    # Two things about this loop are the 22 September defect, and both are about a card that is
    # ALREADY on somebody's screen:
    #
    #   * A poll that fails no longer ends the wait. It used to return "the desktop stopped
    #     answering" on the first failure — while the card was still up and the person could
    #     still press Allow, leaving a grant nobody would ever spend. One `yos` that took too
    #     long, one transient non-zero exit, and a live question was abandoned. Now it is asked
    #     again, until the wait is up, and each failure is written to stderr with why.
    #   * Every poll is inside the budget. The wait is a promise to the mind — and to whatever
    #     is counting seconds on the other end of it — so the sleep and the poll's own subprocess
    #     timeout are both cut to what is left of it. The whole wait ends within APPROVAL_WAIT
    #     plus the spawn of one last `yos`, whatever the desktop does.
    #
    # Nothing in here may raise. A wait that ends in an exception is a card in front of a person
    # with nobody left waiting for their answer, so the poll is wrapped and the reason is kept.
    deadline = time.monotonic() + APPROVAL_WAIT
    status = "pending"
    heard = False            # did the desktop answer a poll at all?
    silence = "it stopped answering"
    while True:
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        time.sleep(min(APPROVAL_POLL, remaining))
        remaining = deadline - time.monotonic()
        if remaining <= 0:
            break
        try:
            poll, err = shell_call("approval_status", {"request_id": request_id},
                                   timeout=min(SHELL_CALL_TIMEOUT, remaining))
        except Exception as e:
            poll, err = None, "%s: %s" % (type(e).__name__, e)
        if poll is None:
            silence = err
            log("approval poll failed for %s.%s (%s), %ds of %ds left: %s"
                % (app, action, request_id, max(0, deadline - time.monotonic()),
                   APPROVAL_WAIT, err))
            continue
        heard = True
        status = poll.get("status", "pending")
        if status != "pending":
            break

    if status == "granted":
        # Not spent here. The action's own dispatch spends it — bound to this app, this action
        # and these exact arguments — and refuses if any of that differs from what the person
        # was shown; `run_tool` turns that refusal into the "could not be spent" account.
        return True, (
            "The person at the machine was asked and allowed this once, just now, for exactly "
            "these arguments. The grant is spent by the action and cannot be used again — a "
            "further call at this grade will ask them again."), request_id

    if status == "denied":
        return False, (
            "the person at the machine was asked to allow %s.%s and said no. Nothing was run "
            "and nothing was changed. This is an answer, not an error: do not ask again and do "
            "not look for another route to the same effect. Say what you were going to do and "
            "leave it with them." % (app, action)), None

    if status == "consumed":
        return False, (
            "the grant for %s.%s had already been spent, so nothing was run. A grant covers one "
            "action once; ask again if it still needs doing." % (app, action)), None

    if not heard:
        # The card went up and then not one poll came back, for the whole wait. This is the only
        # ending that is genuinely a fault, and it is NOT "they did not answer": nobody here
        # knows whether they answered. Reported after the full wait rather than on the first
        # failure, so a desktop that is merely slow gets every chance to speak.
        return False, (
            "the person was shown a card asking them to allow %s.%s, and then the desktop "
            "stopped answering: %s. It was asked again every %gs for %ds and never replied. "
            "Nothing was run here. They may have allowed it; this bridge cannot tell, and it "
            "will not run it on a guess."
            % (app, action, silence, APPROVAL_POLL, APPROVAL_WAIT)), None

    # `expired`, or still `pending` when the wait ran out. From the person's side these are the
    # same thing — they did not answer — and saying so is better than reporting a timeout that
    # sounds like a fault.
    return False, (
        "the person at the machine was asked to allow %s.%s and did not answer within %ds, so "
        "nothing was run. They were probably away from the keyboard. Tell them what you were "
        "trying to do; they can ask you to try it again."
        % (app, action, APPROVAL_WAIT)), None


def guard_act(args):
    """Decide whether this action runs, asking the person when the desktop's mode says to.

    Returns `(refusal, note, audit, grant)`: a refusal to hand back instead of running; or no
    refusal, a note to carry back beside the action's own output, — when it ran without anybody
    being asked — the record to report to the shell once the outcome is known, and — when the
    person was asked and said yes — the grant to carry on the `yos act`, which the app's own
    dispatch spends.

    This used to be a wall. `delete_event` is graded `sensitive`, this bridge's ceiling is
    `standard`, and somebody who typed "delete the dentist appointment from my calendar" was told
    to raise an environment variable. Then it became a question. It is now a question the PERSON
    has already answered in general — plan, ask, auto or bypass — and this reads their answer per
    call rather than applying one policy to a whole day's work.
    """
    app, action = args.get("app"), args.get("action")
    if not app or not action:
        return ("os_act needs both an app and an action — see os_describe for what an app "
                "offers."), None, None, None

    level, purpose = action_detail(app, action)
    if level is None:
        why = ungraded_because(app, action)
        if "is not open" in why:
            return ("%s is not open, so %s was not run — nothing is wrong with the request. "
                    "Open it with os_act on shell: open_app name=%s (os_apps lists the exact "
                    "name to open each app by), then call this again."
                    % (app, action, app)), None, None, None
        return ("%s.%s was not run, because how the OS grades it could not be read: %s"
                % (app, action, why or "os_describe %s would not answer." % app)), None, None, None
    if level not in LADDER:
        # The table's own words, and no read of the desktop first: nothing it could say would
        # make a grade this OS does not define into one it does.
        return decide(level, app, action, False, "ask", [], None)[1], None, None, None

    # One read of the shell, before every action, answers all of it: the machine's standing
    # ceiling, the mode the person set, the rules they granted this session, and the name to put
    # on a card. The read used to happen only above the fixed ceiling, because there was nothing
    # else to ask about; now the mode decides every call, so it happens every call.
    state = shell_state()
    machine = machine_ceiling(state)
    mode, rules = mind_mode(state)
    unreadable = ""
    if mode is None:
        # Fail closed and say so. `ask` with no rules is the strictest mode that still lets
        # ordinary work happen, and a bridge that guessed `auto` from a desktop it could not
        # read would be inventing permission out of a failure.
        mode, rules = "ask", []
        unreadable = ("(this bridge could not read the desktop's mind-mode, so it fell back to "
                      "`ask` — the strict default — and nothing was assumed.)")

    try:
        bound = effective_args(args)
    except ValueError as e:
        return str(e), None, None, None

    # The app's own sentence about the action, read off the same `describe` the grade came from.
    # It is an input to the table now: in `auto`, something the app says cannot be undone is
    # asked about exactly as a `dangerous` action is. `action_detail` already returned it — it
    # has always been read for the card's own words — so this costs nothing new.
    cannot_undo = unrecoverable(purpose)
    cap = CEILING if CEILING_SET else None

    # One call, one table — the harness's own cap included, so there is nothing here that the
    # vectors do not cover. See `decide`; `CEILING` is only a cap when somebody set it.
    verdict, detail = decide(level, app, action, cannot_undo, mode, rules, machine, cap=cap)

    if verdict.startswith("refuse"):
        return join(unreadable, detail), None, None, None

    if verdict == "run":
        unasked = bool(detail)
        if not unasked:
            return None, (unreadable or None), None, None
        # The same test the table made. A rule does not cover what the app says cannot be
        # undone, so it must not be NAMED as the thing that let this through either: here that
        # can only be a bypass, and "Bypass ended" counts what the bypass itself bought. (Only
        # `unasked` actions reach this line, so `cannot_undo` and the table's `irreversible`
        # cannot differ — a `safe` action is never unasked.)
        covered = (app, action) in rules and not cannot_undo
        audit = {
            "app": app, "action": action, "grade": level,
            "mode": "rule" if covered else mode,
            "args_json": bound,
            "requester": requester_name(state),
        }
        note = ("Nobody was asked about this. The desktop is in `%s` mode%s, so it ran straight "
                "away; in `ask` mode this would have put a card in front of the person. It has "
                "been written into the machine's record of unasked actions, which they can read "
                "from the mode chip in the status bar. Report it as something you did, not as "
                "something you were permitted."
                % (mode, " and they have allowed %s.%s for this session" % (app, action)
                   if covered else ""))
        return None, join(unreadable, note), audit, None

    # Why there is a card at all, when the mode the person chose would otherwise have run this.
    #
    # Without it the honest report a mind can make is "the desktop is in auto and it asked me
    # anyway", which reads as a fault and is the shape of a thing somebody tries to work around.
    # Asked of the table rather than restated here: run the same decision with the sentence
    # taken away and see whether it would have gone through. One extra call to a pure function,
    # and no second copy of the rule to drift.
    asked_anyway = ""
    if cannot_undo and decide(level, app, action, False, mode, rules, machine, cap=cap)[0] == "run":
        asked_anyway = (
            "The desktop is in `%s` mode, which would normally have run a `%s` action without "
            "asking — but %s.%s publishes a purpose that says it cannot be undone, and this "
            "machine always asks about those. That is a setting working, not a fault: do not "
            "look for another route to the same effect."
            % (mode, level, app, action))

    allowed, message, grant = ask_the_person(
        app, action, level, purpose, bound, requester_name(state))
    if allowed:
        return None, join(unreadable, join(asked_anyway, message)), None, grant
    return join(unreadable, join(asked_anyway, message)), None, None, None


def join(prefix, text):
    """Two sentences, or whichever of them there is."""
    if not prefix:
        return text
    if not text:
        return prefix
    return prefix + " " + text


# The three tools that put something INTO the world through the browser. Plan mode refuses them
# for the same reason it refuses an `os_act`: it is the mode for looking, and typing into a page
# or opening a URL that carries data is not looking. Reading — web_read, web_text, web_find —
# stays open, because a plan nobody could research would be worthless.
WEB_WRITES = {"web_go", "web_click", "web_type"}


def plan_refusal(name):
    """Refuse a browser write while the desktop is in plan mode. None = allow.

    Its own read of the shell, because these tools do not go through `guard_act`. That is one
    `yos describe shell` per browser write, which is the honest cost of the mode being a fact
    about the desktop rather than a flag this process cached and stopped checking.

    The decision itself is `decide`'s, not this function's, so the browser row of the table is
    checked by the same vectors as every other row.
    """
    if name not in WEB_WRITES:
        return None
    mode, _ = mind_mode(shell_state())
    if mode is None:
        # Fail closed is `ask`, and `ask` does not block a browser write — the taint rule and
        # `yos web`'s own commitment check still do.
        mode = "ask"
    # `False`: a page element is not an action an app publishes a purpose for, so there is no
    # sentence to read and the browser row of the table never consults one.
    verdict, why = decide(None, "the browser", name, False, mode, [], None, tool=name)
    return why if verdict == "refuse_mode" else None


def report_unasked(audit, outcome):
    """Write one unasked action into the machine's record. Returns a warning, or None.

    It records; it authorises nothing, and failing to record does not undo anything — the action
    has already run by the time this is called, because the outcome is half of what is worth
    writing down. A failure is reported to the caller rather than swallowed: "everything it does
    without being asked is written down" stops being true the moment this fails silently.
    """
    if not audit:
        return None
    _, err = shell_call("record_unasked_action", dict(audit, outcome=outcome))
    if err is None:
        return None
    return ("(this ran without anybody being asked and could NOT be written into the machine's "
            "record of that: %s. Tell the person what you did.)" % err)


def run_tool(tool, args, present=None):
    """Invoke yos and return (text, is_error), whatever the outcome.

    `present`, when given, turns a successful act's printed output into the text a mind reads —
    the command tools use it to say "exit code 0 after 1.2 s" rather than print the shell's JSON.
    What the person decided, and any audit warning, still go in front of it.

    A tool that raises loses the detail the mind needs to recover, so a failure comes
    back as content that says what failed. The distinction that matters downstream is
    "the machine answered and the answer was no" versus "nothing answered at all", and
    both are reported in words rather than as an empty string.

    And flagged, not only worded. Every refusal and failure used to go back as ordinary
    content, which a client cannot tell from success: on the first live drive a refused
    action was reported to the person as "Done — refused: …". MCP marks a tool that ran
    and failed with isError; that is what the flag is for.

    With one exception, learned from a real client. A POLICY answer — the person said no, the
    desktop is in plan mode, the ceiling forbids it, this session has read private state — is
    not a failure of this server: it ran, it is healthy, and it answered. Hermes counts isError
    results and after three in a row declares the whole MCP server "unreachable" for a minute.
    So three refused writes in plan mode took `os_describe` away as well, and a research
    sub-agent that was refused three URLs lost the desktop entirely and spent its remaining
    forty-seven turns being told to wait. Those answers go back unflagged, and say REFUSED in
    their first word instead, where a model cannot read them as success. Failures — a timeout,
    a non-zero exit, an app that is not running, a missing argument — stay flagged.
    """
    # Required arguments, said plainly. A call without one used to fail inside argv as a bare
    # KeyError — "could not run os_describe: 'app'" — which tells a model nothing it can act on.
    missing = [k for k in tool.get("inputSchema", {}).get("required", []) if not args.get(k)]
    if missing:
        return ("%s needs %s. %s" % (
            tool["name"], " and ".join(repr(k) for k in missing),
            "Say which app, e.g. {\"app\": \"shell\"} for the desktop." if "app" in missing else "",
        )).strip(), True

    # What the person said, when they were asked — or that they were not asked at all. Carried
    # back on the successful path too, so a mind reporting "done" also reports how it was allowed
    # to: the difference between "I deleted it", "you allowed it and I deleted it" and "nobody
    # was asked and I deleted it" is the whole point of all of this.
    note = None
    # Set when this ran without anybody being asked, and reported to the shell after it has run,
    # because the outcome is half of what is worth writing down.
    audit = None
    # Set when the person was asked and allowed it: the request id, carried on the call for the
    # app's dispatch to spend.
    grant = None
    # Set when a command is going to the agent's own terminal: no window is raised for it.
    agent_call = False

    if tool["name"] == "os_act":
        # os_describe lists actions as `act: new_note()`, and a model copying that sends
        # "new_note()". The name is the part before the parenthesis; refusing the call over the
        # punctuation cost a whole confirmed turn on the third live drive.
        args = dict(args)
        args["action"] = str(args["action"]).strip().split("(", 1)[0].strip()
        # With an agent token, the Terminal's `run` is the agent's own terminal instead — graded,
        # asked about and recorded as `shell.agent_run`, which is what will actually run.
        routed = agent_route(args)
        if routed is not None:
            args, agent_call = routed, True
            present = present or routed_text
        agent_call = agent_call or (str(args.get("app")) in ("shell", "app-shell")
                                    and args.get("action", "").startswith("agent_"))
        refusal, note, audit, grant = guard_act(args)
        if refusal is not None:
            return policy_answer(refusal), False

    refusal = plan_refusal(tool["name"])
    if refusal is not None:
        return policy_answer(refusal), False

    # The taint rule is not a permission grade and no mode turns it off — not even bypass. A
    # mode says how much the person trusts the mind; the taint says what this session has
    # already read, which is a fact about the session rather than a policy anybody set.
    refusal = taint_refusal(tool["name"], args)
    if refusal is not None:
        return policy_answer(refusal), False

    try:
        argv = [YOS] + tool["argv"](args)
    except ValueError as e:
        return "refused: %s" % e, True
    if tool["name"] == "os_act":
        # This bridge has already asked, or decided nobody needed asking. `yos act` would
        # otherwise raise a card of its own on a refusal — the same card, but with nobody's name
        # on it and a wait longer than this call's budget — so it is told not to, and the
        # refusal comes back here to be reported in words. The grant, when there is one, rides
        # on the call for the app's own dispatch to spend.
        argv.append("--no-ask")
        if grant:
            argv += ["--grant", grant]
    timeout = tool["timeout"]
    if callable(timeout):
        timeout = timeout(args)
    if agent_call and args.get("action") in AGENT_WAITING:
        # The shell answers these when the command ends or its `wait` runs out, so the act is
        # given that long and a margin, not a flat minute: `yos` itself allows `wait + 20`.
        given = args.get("args") if isinstance(args.get("args"), dict) else {}
        timeout = agent_timeout(given.get("wait"))
    if (tool["name"] == "os_act" and str(args.get("app")) in ("shell", "app-shell")
            and args.get("action") == "hand_off"):
        # Answered when the role's first turn ends, or its `wait_seconds` runs out.
        given = args.get("args") if isinstance(args.get("args"), dict) else {}
        timeout = hand_off_timeout(given.get("wait_seconds"))

    try:
        # stdin closed to the child, for the reason in `yos`: this process's stdin belongs to
        # the client's JSON-RPC stream and nothing else may read from it. The environment is
        # `yos_env`'s: the desktop's session, and the agent token when this bridge has one.
        p = subprocess.run(argv, capture_output=True, text=True, timeout=timeout, env=yos_env(),
                           stdin=subprocess.DEVNULL)
    except subprocess.TimeoutExpired:
        note = join(note, report_unasked(audit, "timed out"))
        return (prefix(note, "timed out after %ss — the desktop did not answer. It may be busy "
                            "rather than broken; nothing was rolled back." % timeout)), True
    except FileNotFoundError:
        return "%s is not installed on this machine, so the desktop cannot be reached." % YOS, True

    # What actually happened goes into the machine's record, for every action nobody was asked
    # about. Written after the run rather than before it, because "it was attempted" is a much
    # weaker thing for a person to read than "it was done" or "it failed".
    note = join(note, report_unasked(audit, "ok" if p.returncode == 0 else "failed"))

    out = (p.stdout or "").strip()
    err = (p.stderr or "").strip()
    app = args.get("app")
    if p.returncode != 0 and app and "no socket for" in err and tool["name"] in ("os_describe", "os_act"):
        # The second live drive: told the app was not running ("no socket for 'notes'"), the
        # model described it twice more and gave up. The way forward belongs in the failure
        # itself, where it is read, rather than only in a tool description read turns earlier.
        #
        # A role held to a reach followed this sentence and was then refused for the very open
        # it advised (#195). The door now lets a reach open the apps it names, and when this
        # bridge acts for such a role and the app is one of them, the sentence says the open is
        # within the reach — the reassurance the role actually needed before it dared try.
        may = " Your reach names %s, so you may open it." % app if reach_names(app) else ""
        return (prefix(note, "%s is not running, so it cannot be described or acted on yet. "
                            "Open it first with os_act: app \"shell\", action \"open_app\", "
                            "args {\"name\": \"%s\"}; then describe it.%s" % (app, app, may))), True
    if p.returncode != 0 and tool["name"] == "os_act" and "GRANT:" in err:
        # The app's own dispatch refused: the grant did not hold, or — when this bridge had
        # decided nobody needed asking — the desktop's mode as the app read it disagreed. A
        # policy answer, not a fault: the machine is healthy and said no, in words.
        why = re.sub(r"^yos: ", "", err.strip())
        if grant:
            # Not running is the only safe reading: the refusal may be precisely that the
            # arguments do not match what the person was shown.
            return policy_answer(
                "the person allowed %s.%s, but the grant could not be spent: %s Nothing was "
                "run. Tell them it did not go through." % (app, args.get("action"), why)), False
        return policy_answer(why), False
    if p.returncode != 0 and tool["name"] == "os_act" and "REACH:" in err:
        # This agent was started as a catalog role, and the act is outside the role's reach. A
        # policy answer, as GRANT is: the desktop is healthy and said no, naming the role.
        return policy_answer(re.sub(r"^yos: ", "", err.strip())), False
    if p.returncode != 0:
        # The note goes on a failure as well. A person who has just pressed Allow and then hears
        # only "failed (exit 1)" has been told the wrong half of what happened — and worse, the
        # grant is spent, so the retry will ask them again.
        return prefix(note, "failed (exit %d)%s%s" % (
            p.returncode,
            ("\n" + out) if out else "",
            ("\n" + err) if err else "",
        )), True
    if tool["name"] == "os_act" and p.returncode == 0 and not agent_call:
        # Not for a command in the agent's own terminal: it is drawn in the agent's pane, and
        # raising a window for it — the Terminal's, or anyone's — is what that pane replaces.
        follow(app)
    if tool["name"] in PRIVATE_READS and p.returncode == 0:
        # Recorded after the call, not before: a read that failed saw nothing.
        _SAW_PRIVATE.append(tool["name"])

    if not out:
        return prefix(note, "(the command succeeded and printed nothing)"
                      + (("\n" + err) if err else "")), False
    if present is not None:
        return prefix(note, present(out) + (("\n" + err) if err else "")), False
    if (tool["name"] == "os_describe" and app and app != "shell"
            and not re.search(r"^\s*act:\s", out, re.M)):
        # The service answered for a window that is shut (see `action_detail`). What it says is
        # true and worth having — what is stored — but a mind reading it has no way to tell it
        # from the app, and goes on to call an action the service does not have.
        out += ("\n\nThis is %s's background service: it reports what is stored and takes no "
                "actions. The %s app itself is not open — to change anything, open it (os_act "
                "on shell: open_app name=%s) and describe it again." % (app, app, app))
    return prefix(note, out + (("\n" + err) if err else "")), False


# ── The person can see what the mind is doing ──────────────────────────────────────────
#
# Acting on an app's surface does nothing to its window. A mind asked to build slides, book the
# calendar and start the slideshow did all of it behind whichever window had been opened last,
# and the slideshow ran where nobody could watch. When a mind starts acting on a different app,
# that app is brought forward — once per change of app, not once per action, so ten `add_slide`
# calls are one raise and a person reading something else is interrupted when the work moves,
# not continuously. `YOS_MCP_FOLLOW=0` turns it off for a mind that works in the background.
FOLLOW = os.environ.get("YOS_MCP_FOLLOW", "1").strip() not in ("0", "false", "no", "off")
_FOLLOWING = [None]


def follow(app):
    """Bring `app` forward if the mind has just moved to it. Never fails the action it follows."""
    if not FOLLOW or not app or app == "shell" or _FOLLOWING[0] == app:
        return
    _FOLLOWING[0] = app
    try:
        yos(["act", "shell", "show_app", "name=%s" % app], 5)
    except Exception:
        pass


def policy_answer(refusal):
    """A "no" from the desktop's rules, worded so that it cannot be read as a result.

    Not flagged isError — see `run_tool` — so the wording carries all of it. `refused:` stays in
    the text because minds, graders and the self-test already look for it.
    """
    return "REFUSED — nothing was run. refused: " + refusal


def prefix(note, text):
    """Put what the person decided in front of what the machine did, or leave the text alone."""
    return text if not note else note + "\n\n" + text


# Several calls can be in flight at once now, and they all answer down one pipe. Two threads
# writing a line each would interleave halfway through and hand the client two broken messages.
_WRITING = threading.Lock()


def reply(msg_id, result=None, error=None):
    m = {"jsonrpc": "2.0", "id": msg_id}
    if error is not None:
        m["error"] = error
    else:
        m["result"] = result
    # One message per line, no embedded newlines — the transport is line-delimited, and a
    # transcript full of newlines is exactly the payload that would break it.
    with _WRITING:
        sys.stdout.write(json.dumps(m) + "\n")
        sys.stdout.flush()


def serve_call(msg_id, tool, arguments):
    """Run one tools/call and answer it. The body of a worker thread; must not raise.

    A command tool's answer also carries the shell's own account of the command under `_meta`
    (`yantrik/command`: exit code, signal, job, tail…), which MCP lets a result carry for a
    client that knows to look — pi's `bash` reads the exit code from it rather than from prose.
    Nothing this returns, in either place, repeats the agent token.
    """
    meta = None
    try:
        text, is_error, meta = call_tool(tool, arguments)
    except Exception as e:  # a malformed argument must not take the server down
        text, is_error = "could not run %s: %s" % (tool["name"], e), True
    result = {"content": [{"type": "text", "text": scrub(text)}], "isError": is_error}
    if meta is not None:
        result["_meta"] = {"yantrik/command": json.loads(scrub(json.dumps(meta)))}
    reply(msg_id, result)


# ── Reading the next request while the last one is still working ───────────────────────
#
# This loop used to run each request to completion before reading the next line, which is fine
# for a bridge whose calls are a `yos` invocation and back — and wrong the moment one of them
# waits for a PERSON. An os_act that raises an approval card sits here for up to APPROVAL_WAIT,
# and for that whole time nothing else on this pipe was being read: not another tool call, and
# not the client's own liveness check.
#
# On 22 September 2026 that cost somebody four minutes. A card went up at 06:48:18Z; 59 seconds
# into the wait Hermes' keepalive gave up on a server that was simply busy ("keepalive failed,
# triggering reconnect"), replaced the process two seconds later, and the os_act died with it —
# unanswered, so Hermes waited out its own 300s timeout before reporting a machine that had been
# working correctly the entire time. The card was still on the screen; nobody was left waiting
# for the answer.
#
# So the read loop now does nothing but read. `initialize`, `ping` and `tools/list` are answered
# here because they are instant and cannot block; every tools/call goes to a thread of its own.
# JSON-RPC ids are what pair a reply to its request, so answering out of order is what the
# protocol is for. Threads are not pooled or capped: the concurrency is whatever the client asks
# for, which for a stdio client is the tool calls of one turn, and a cap would only rebuild the
# queue this exists to remove.
def main():
    workers = []
    for line in sys.stdin:
        line = line.strip()
        if not line:
            continue
        try:
            msg = json.loads(line)
        except ValueError:
            continue

        method, msg_id = msg.get("method"), msg.get("id")

        if method == "initialize":
            # The client's own account of itself, kept for the one place it is worth having: the
            # name on an approval card, so a person is asked by "Hermes Agent 0.9.2" rather than
            # by "the mind on this desktop". Self-declared and treated as such — it is a label,
            # never a permission. See `requester_name`.
            info = (msg.get("params") or {}).get("clientInfo")
            if isinstance(info, dict):
                _CLIENT["name"] = info.get("name")
                _CLIENT["version"] = info.get("version")
            reply(msg_id, {
                "protocolVersion": PROTOCOL_VERSION,
                "capabilities": {"tools": {}},
                "serverInfo": {"name": "yantrik-os", "version": "1.0.0"},
            })
        elif method == "ping":
            # "Are you still there?", and the one question this server must always be able to
            # answer. MCP defines it as an empty result; it used to fall through to "unknown
            # method" and come back as a JSON-RPC error, which is a strange thing for a healthy
            # server to say about itself. What a client does with a keepalive it does not like
            # is kill the process — see above.
            reply(msg_id, {})
        elif method == "tools/list":
            # annotations tell a client what a tool does to the world, so it can run reads
            # freely and gate the rest. A client that has to guess from the name gets it
            # wrong: "os_apps" looks like a mutation to every heuristic worth writing.
            #
            # The command tools are listed only to a bridge that runs as one of the person's
            # agents: without a token there is no terminal of one's own to offer.
            reply(msg_id, {"tools": [listing(t) for t in offered()]})
        elif method == "tools/call":
            params = msg.get("params") or {}
            tool = {t["name"]: t for t in offered()}.get(params.get("name"))
            if tool is None:
                reply(msg_id, error={"code": -32602,
                                     "message": "no such tool: %s" % params.get("name")})
                continue
            worker = threading.Thread(
                target=serve_call, args=(msg_id, tool, params.get("arguments") or {}),
                name="tools/call %s" % tool["name"], daemon=True)
            workers = [w for w in workers if w.is_alive()]
            workers.append(worker)
            worker.start()
        elif msg_id is not None:
            reply(msg_id, error={"code": -32601, "message": "unknown method: %s" % method})
        # Notifications (no id) get no reply, per JSON-RPC.

    # End of stdin: the client has gone. Anything still running is finished off rather than cut
    # short — an os_act that is mid-`yos act` has already changed the machine, and the audit line
    # saying what it did is written after it, not before.
    for worker in workers:
        worker.join()


if __name__ == "__main__":
    main()
