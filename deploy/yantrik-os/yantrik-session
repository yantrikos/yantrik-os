#!/bin/sh
# ═══════════════════════════════════════════════════════════════════════════════════════
# yantrik-session — the desktop session
# ═══════════════════════════════════════════════════════════════════════════════════════
#
# Started by yantrik-session.service on tty1. labwc runs yantrik-shell, which runs the shell and
# starts it again when it dies (#247). labwc's `-s` runs its command once, and this header used
# to say labwc supervised the shell; nothing did, and a crash left a blank screen. The shell is
# the thing the user sees and the thing an agent acts on, and they are two views of one state
# rather than two programs that happen to agree.
#
# This file used to exist only inside cloud-init's write_files, which meant it could be
# written once at provision time and never corrected again: a machine deployed with a bad
# session script stayed that way for life, because nothing in the update path could replace
# it. It ships in the release payload now, so `yantrik-update` refreshes it like anything
# else, and cloud-init no longer carries a copy to drift from.
set -eu

export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
mkdir -p "$XDG_RUNTIME_DIR"

# ── The shell ───────────────────────────────────────────────────────────────────────────
# Without this the shell opens as an ordinary labwc window, title bar and all, sitting in the
# middle of the screen. An OS is not a window on something else.
export SLINT_FULLSCREEN=1

# ── What every program in this session inherits ─────────────────────────────────────────
#
# labwc already exports the identity of the session to its children — WAYLAND_DISPLAY, and
# once Xwayland starts, DISPLAY, XDG_CURRENT_DESKTOP and _JAVA_AWT_WM_NONREPARENTING. The
# systemd unit adds XDG_SESSION_TYPE and the seat. What neither sets is which BACKEND a
# toolkit should prefer, and that omission has a visible cost: with DISPLAY set and no hint,
# a Wayland-capable GTK or Qt application quietly picks X11 and runs through Xwayland, where
# it is scaled by a translation layer instead of drawing natively.
#
# Every desktop session sets these. The values are preference LISTS, not commands: a program
# that cannot do Wayland falls back to X11 by itself, so nothing is forced and nothing that
# used to work stops working.
export GDK_BACKEND="${GDK_BACKEND:-wayland,x11}"
export QT_QPA_PLATFORM="${QT_QPA_PLATFORM:-wayland;xcb}"
export CLUTTER_BACKEND="${CLUTTER_BACKEND:-wayland}"
export MOZ_ENABLE_WAYLAND="${MOZ_ENABLE_WAYLAND:-1}"
# Electron reads this and picks Wayland when the session offers it.
export ELECTRON_OZONE_PLATFORM_HINT="${ELECTRON_OZONE_PLATFORM_HINT:-auto}"
# labwc draws the window frames, and this OS themes them. Without this Qt draws a second set
# of its own inside ours.
export QT_WAYLAND_DISABLE_WINDOWDECORATION="${QT_WAYLAND_DISABLE_WINDOWDECORATION:-1}"

# Which desktop this is, by name. xdg-desktop-portal reads it to choose a backend, and
# applications read it to decide how to behave. labwc sets XDG_CURRENT_DESKTOP to
# "labwc:wlroots"; this says whose desktop it is as well as what it is built on.
export XDG_SESSION_DESKTOP="${XDG_SESSION_DESKTOP:-yantrik}"
export XDG_CURRENT_DESKTOP="${XDG_CURRENT_DESKTOP:-yantrik:labwc:wlroots}"

# Where .desktop files and icon themes are found. Spelled out rather than left to the
# default, because the default does not include the flatpak export directories, and an app
# installed there being invisible to the launcher is a bug nobody would think to look for.
# /opt/yantrik/share is where this OS keeps its own .desktop entries and icons, so the
# ordinary freedesktop scan finds the apps it ships without writing into /usr.
# No directory in the home is named here (#548): the person's own Flatpak exports used to come
# first. The shell scans them itself (shell-core apps.rs, flatpak_app_dirs), so an app the Package
# Manager installed per-user (#399) is still in the launcher; what is gone is every other program
# in the session reading the home's desktop entries through this variable.
export XDG_DATA_DIRS="${XDG_DATA_DIRS:-/usr/local/share:/usr/share}:/opt/yantrik/share:/var/lib/flatpak/exports/share"
export XDG_CONFIG_DIRS="${XDG_CONFIG_DIRS:-/etc/xdg}"

# The OS's own binaries. `yos` is the agent surface and scripts call it by name; without this
# it is only reachable by absolute path, which is the sort of thing that works everywhere it
# was tested and nowhere else.
case ":$PATH:" in
  *":/opt/yantrik/bin:"*) ;;
  *) export PATH="/opt/yantrik/bin:$PATH" ;;
esac

# The editor every program in the session opens when it needs one. The image ships nano for
# exactly this (#210); with EDITOR unset — which is what the live VM showed — `git commit`,
# `crontab -e` and every $EDITOR prompt fall back to vi, which no Yantrik image installs
# either, and die. The `:-` so a person's own EDITOR, set above this session, still wins.
export EDITOR="${EDITOR:-nano}"

# ── git identity ────────────────────────────────────────────────────────────────────────
# Not set here any more: it read and wrote ~/.gitconfig before the lock screen (#548). It is
# git's system default now, written as root by yantrik-session-install (#680).

# ── The desktop's own chrome ────────────────────────────────────────────────────────────
# For apps the answer is a themed frame rather than no frame. The window theme and the house
# typeface are data in the person's home, put there by yantrik-session-chrome as this account; it
# writes nothing through a link. The compositor's keys, menu and autostart are not: labwc reads
# those from the root-owned /etc/yantrik/labwc (below), so nothing the person can write decides
# what starts with the desktop (#548). A failure is said on stderr (the journal) and does not
# stop the desktop: a session without its theme still beats no session.
/opt/yantrik/bin/yantrik-session-chrome /opt/yantrik/share \
  || echo "yantrik-session: the desktop's chrome was not all put in place (see above)" >&2

# ── Start the compositor, and keep what it says ──
#
# The shell's own output went nowhere on the supported start path. /opt/yantrik/logs was
# written only by yantrik-update's fallback spawn, so on a machine started the normal way --
# by systemd, which is every machine -- the log's last entry was from whenever someone last
# updated it by hand, and the journal had only systemd's five lines about the unit.
#
# That is how a companion that panics at boot goes unnoticed: `companion.sock` is listening,
# the desktop says the companion is online, every AI action in every app fails, and there is
# no file anywhere that says why. Diagnosing it meant reading a log that had stopped being
# written eight hours earlier and not noticing that it had.
LOG_DIR=/opt/yantrik/logs
mkdir -p "$LOG_DIR" 2>/dev/null || true
# Only into a directory this account owns and alone can write. Anyone else able to write it could
# put a link where the log goes (a link to ~/.bashrc, say) and have the shell's output appended to
# it; yantrik-update repairs such a directory, and until it has, the log goes to the person's own.
if [ ! -O "$LOG_DIR" ] || [ -n "$(find "$LOG_DIR" -maxdepth 0 -perm /022 2>/dev/null)" ]; then
    LOG_DIR="${XDG_STATE_HOME:-$HOME/.local/state}/yantrik"
    mkdir -p "$LOG_DIR"
fi
LOG="$LOG_DIR/yantrik-os.log"
[ -L "$LOG" ] && rm -f -- "$LOG"
# Rotate on start rather than growing without bound; one previous boot is enough to compare.
# -T: onto the name itself, never into a directory a link there points at.
[ -f "$LOG" ] && mv -fT -- "$LOG" "$LOG.1" 2>/dev/null

# The compositor's own directory is root's: rc.xml, menu.xml, autostart and the environment
# come from /etc/yantrik/labwc, not from ~/.config/labwc, which anything running as the person
# can rewrite (#548). A machine the update has not reached yet (no such directory) keeps the home's.
CONF=""
[ -d /etc/yantrik/labwc ] && CONF="-C /etc/yantrik/labwc"
# No capability is carried into the desktop (#548). Started from yantrik-session.service, the
# compositor and everything under it held CAP_WAKE_ALARM (permitted, effective and ambient), which a
# login of the same person does not. The kernel lets one process read another's /proc/<pid>/exe
# only if the target's permitted capabilities are within the reader's, so `yos` could not tell who
# answered as the shell and refused it: release-check and the harness pairing both failed on the
# branch ISO. The desktop needs no capability; clearing the inheritable and ambient sets (no
# privilege needed) leaves what it starts with none. Skipped, with the plain start, where setpriv
# is missing or refuses, because a desktop that does not start is worse.
CAPS=""
if command -v setpriv >/dev/null 2>&1 && setpriv --inh-caps=-all --ambient-caps=-all true 2>/dev/null; then
  CAPS="setpriv --inh-caps=-all --ambient-caps=-all"
fi
# shellcheck disable=SC2086  # CONF is a flag and its value, or nothing; CAPS is a command and flags, or nothing
exec $CAPS labwc $CONF -s '/opt/yantrik/bin/yantrik-shell /opt/yantrik/config.yaml'   >>"$LOG" 2>&1
