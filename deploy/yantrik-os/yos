#!/usr/bin/python3
"""yos — talk to Yantrik OS from a command line.

The OS publishes a rich control surface over unix sockets and, until now, no way to
reach it except by writing a JSON-RPC client. That is not a theoretical gap: an agent
given the job of writing a handover note spent most of a 64k context window building
`parse_perc.py` and `fetch_perc.py` — mktemp, chmod, atomic rename, over and over —
before it could ask the OS a single question. It then died when the context it had
spent on plumbing pushed the actual task out of the window.

So this exists to make the common thing one line. It is deliberately small, has no
dependencies beyond the standard library, and does no interpretation: it speaks the
protocol and prints what came back.

    yos ls                              which surfaces are up, and which can be opened
    yos ls --all                        ... and sockets left behind by closed windows, and the
                                        desktop's own sockets that are not surfaces
    yos describe shell                  what the desktop is showing
    yos describe notes                  what an app is showing
    yos check notes                     does a surface keep the protocol (docs/surface-protocol.md)
    yos check ./my-app.sock --json      the same, for a socket you are writing, as JSON
    yos check --all                     every surface that answers on this machine
    yos act shell open_app name=notes   ask something to do something
    yos act notes append text='...'     with arguments
    yos act shell open_app name=notes --full     the reply with the app state
    yos act blender render out=x.png    an action the mode asks about: a card goes up,
                                        yos waits for Allow (120 s) and acts with the grant
    yos perception [N]                  the last N kernel observations, starting the
                                        service if the desktop has not needed it yet
    yos journal                         is the eye being drained, and how far behind
    yos notify "Build finished"         tell the person something
    yos notify "Disk full" "/ is at 98%" --urgency critical

    yos web                             what is on the page, as a list of things you can do
    yos web text                        what the page SAYS — the prose a reader sees
    yos web find <words>                where is the thing I want, anywhere on the page
    yos web all                         every interactive element, not just the viewport
    yos web go <url>                    navigate
    yos web click <n>                   click element n from `yos web`
    yos web type <n> <text>             type into element n
    yos web tabs                        what is open
    YOS_WEB_TAB=<id> yos web ...        drive that tab (a DevTools target id), not the first
    yos web listen [secs]               what the page SAYS OUT LOUD — records the audio
                                        the machine is playing and transcribes it

Conventions worth knowing:

  * an `act` argument is read as the app declared it. `describe` publishes a type for every
    argument, so `dismiss id=67` sends the string "67" to an action whose `id` is text and
    `add_event duration_min=30` sends the number 30 to one whose parameter is a number.
    Quoting says it outright — `id="67"` is the string whatever the app declared.

  * an `act` graded above what the desktop's mode allows — `sensitive` in `ask` mode — is
    refused by the app itself unless the call carries a grant, whichever door it came through:
    a mind's tools, this command, or a raw client on the socket all meet the same refusal.
    `yos act` asks for you: it puts the card on the person's screen, waits up to 120 s for
    Allow, and acts again carrying the grant. `--no-ask` hands the refusal back instead, and
    `--grant <id>` carries a grant you already hold. `describe` needs nothing.

  * an `act` made for one of the person's agents carries that agent's token BESIDE the
    arguments, never among them: `--agent-token <t>`, or `YANTRIK_AGENT_TOKEN` in the
    environment a harness started this in (an `agent_token=` argument is lifted out the same
    way). The arguments are what an approval card shows and the audit log keeps; a token there
    is a token anyone reading either could replay. The shell's `agent_run` / `agent_job` /
    `agent_input` / `agent_kill` need it, and `agent_run` and `agent_job` are given as long as
    their `wait` says (120 s when it says nothing) before this gives up on the answer.

  * `describe` and `act` take a short name. `shell` means `app-shell`, `notes` means
    `app-notes`; anything else is used as given, so `yos describe weather` reaches the
    weather service directly. An app answers to every name it is known by — `containers`
    and `container-manager` are the same window — and `yos ls` shows them together. The
    names come from each app's `.desktop` file (`X-Yantrik-Surface`, `X-Yantrik-Aliases`),
    which is also how `yos ls` lists an app that is closed.

  * `act` prints the whole reply rather than a success line, because the reply is not a
    boolean. `settled: false` means the work was accepted and has not finished — a
    launch dispatched, a build started. Reading that as done is the mistake this
    surface is built to make impossible, and hiding it behind a tick would put it back.

  * `web` is the one place the OS cannot read structure from raw data, so it reads the
    page the way a person does: the accessible name of everything you could interact
    with, in the viewport, numbered so you can act on it. Measured on Hacker News,
    that is 6 KB against 692 KB for Chromium's own accessibility tree, and 59 ms
    against 417 ms. The numbers are refs into the last `yos web` — take a fresh
    reading before clicking if the page may have moved.
"""

import json
import os
import re
import shutil
import socket
import statistics
import struct
import sys
import time


def socket_dirs():
    """The socket-directory chain, in the order docs/surface-protocol.md says a client searches it.

    It is the transport's own chain (`server::socket_dir()`): `$XDG_RUNTIME_DIR/yantrik`, then
    `/run/yantrik`, then `/tmp/yantrik-<uid>`. A server binds in the first it can use; a client
    looks in all three, in order, and creates none of them.

    perception-service is the reason the second one matters: started by the desktop it lands in
    the session's directory like the rest, but started privileged — it wants CAP_SYS_ADMIN and
    CAP_NET_ADMIN for its descriptors — it has no XDG_RUNTIME_DIR and lands in /run/yantrik. The
    third is where everything lands on a machine with neither, and `yos` did not look there.

    A `yos` started without XDG_RUNTIME_DIR (sudo, cron, a bare ssh command) cannot know the
    session's value, so it looks where logind puts it, `/run/user/<uid>`, in the first place —
    which the protocol allows a client and never a server.
    """
    xdg = os.environ.get("XDG_RUNTIME_DIR", "").strip() or "/run/user/%d" % os.getuid()
    return [os.path.join(xdg, "yantrik"), "/run/yantrik", "/tmp/yantrik-%d" % os.getuid()]


SOCKET_DIRS = socket_dirs()

ALIASES = {"shell": "app-shell"}


# ── Surfaces declared in .desktop files ──
#
# A closed app has no socket, so the socket directory cannot say it exists. Its `.desktop` file
# can: an app that publishes a surface declares it there (docs/app-control.md, "Findable while
# closed"), and the shell lists it in `describe shell` → `apps` from those keys. `yos` reads the same
# keys itself for two things the shell cannot do for it: resolving an alias when the shell's links
# are not there (no desktop running, or a name declared a moment ago), and `yos ls` when the shell
# is not answering. The shell's listing wins whenever there is one — it also knows which names the
# desktop itself holds.

SURFACE_KEYS = ("X-Yantrik-Surface", "X-Yantrik-Purpose", "X-Yantrik-Aliases", "X-Yantrik-Adapter")
SURFACE_NAME = re.compile(r"^[a-z0-9]+(-[a-z0-9]+)*$")
YANTRIK_APPLICATIONS = "/opt/yantrik/share/applications"


def fold_name(name):
    """The protocol's fold: trim, lowercase, `_` and space become `-`."""
    return name.strip().lower().replace("_", "-").replace(" ", "-")


def application_dirs():
    """The freedesktop application directories, in search order, as the shell scans them
    (`yantrik_shell_core::apps::app_dirs`): the person's own first, this OS's own last."""
    dirs = []
    home = os.environ.get("HOME", "")
    if home:
        dirs.append(os.path.join(home, ".local/share/applications"))
    if os.environ.get("XDG_DATA_HOME"):
        dirs.append(os.path.join(os.environ["XDG_DATA_HOME"], "applications"))
    data_dirs = os.environ.get("XDG_DATA_DIRS")
    if data_dirs is not None:
        dirs.extend(os.path.join(d, "applications") for d in data_dirs.split(":") if d.strip())
    else:
        dirs.extend(["/usr/share/applications", "/usr/local/share/applications"])
    dirs.append(YANTRIK_APPLICATIONS)
    seen, ordered = set(), []
    for d in dirs:
        if d not in seen:
            seen.add(d)
            ordered.append(d)
    return ordered


def try_exec_found(program):
    """Whether the program a `TryExec` key names is on this machine: by path as written, or in
    /opt/yantrik/bin, or on PATH — the places the shell itself looks (`yantrik-ui`'s
    `find_program`)."""
    if os.path.sep in program:
        return os.path.isfile(program) and os.access(program, os.X_OK)
    deployed = os.path.join("/opt/yantrik/bin", program)
    if os.path.isfile(deployed) and os.access(deployed, os.X_OK):
        return True
    return shutil.which(program) is not None


def read_desktop_entry(stem, text):
    """One `[Desktop Entry]` group, as the launcher reads it; None for anything it does not list."""
    keys, group = {}, None
    for line in text.splitlines():
        line = line.strip()
        if line.startswith("["):
            group = line
            continue
        if group != "[Desktop Entry]" or not line or line.startswith("#") or "=" not in line:
            continue
        key, value = line.split("=", 1)
        keys[key.strip()] = value.strip()
    if (keys.get("Type") != "Application" or keys.get("NoDisplay") == "true"
            or keys.get("Hidden") == "true" or not keys.get("Name") or not keys.get("Exec")):
        return None
    # `TryExec` is the standard "list it only if this program is installed" rule, and the
    # shell's catalogue applies it too (`yantrik-ui`'s `entry_is_launchable`). It is the only
    # key that can hide an adapter's entry: the wrapper its Exec runs ships with the adapter
    # and is always there, so a machine without the wrapped app would otherwise keep naming
    # it in `yos ls` and in the apps a mind is offered (#214).
    try_exec = keys.get("TryExec", "").split()
    if try_exec and not try_exec_found(try_exec[0]):
        return None
    surface = fold_name(keys.get("X-Yantrik-Surface", ""))
    if not SURFACE_NAME.match(surface):
        surface = None
    aliases = []
    if surface:
        for alias in (fold_name(a) for a in keys.get("X-Yantrik-Aliases", "").split(";")):
            if alias and SURFACE_NAME.match(alias) and alias != surface and alias not in aliases:
                aliases.append(alias)
    return {"entry": stem, "name": keys["Name"], "surface": surface,
            "purpose": keys.get("X-Yantrik-Purpose", "") if surface else "",
            "aliases": aliases}


def declared_surfaces(dirs=None):
    """Every surface the installed `.desktop` files declare, one per id: `{id, title, purpose,
    aliases, entry}`. The same rules as the shell's catalogue, less the ones only the shell knows
    (which names are its own screens): an entry id found twice is the first directory's, entries
    are taken in the order of their names, ids are settled before aliases, a name is given to the
    first surface that claims it, and an entry whose `TryExec` program this machine does not have
    declares nothing (#214)."""
    entries, seen = [], set()
    for directory in (dirs if dirs is not None else application_dirs()):
        try:
            names = sorted(os.listdir(directory))
        except OSError:
            continue
        for filename in names:
            if not filename.endswith(".desktop") or filename[:-8] in seen:
                continue
            try:
                with open(os.path.join(directory, filename), encoding="utf-8", errors="replace") as fh:
                    entry = read_desktop_entry(filename[:-8], fh.read())
            except OSError:
                continue
            if entry is not None:
                seen.add(entry["entry"])
                entries.append(entry)
    entries.sort(key=lambda e: e["name"].lower())
    surfaces = []
    for e in entries:
        sid = e["surface"]
        if not sid or sid in ("shell", "yantrik"):
            continue
        existing = next((s for s in surfaces if s["id"] == sid), None)
        if existing is None:
            surfaces.append({"id": sid, "title": e["name"], "purpose": e["purpose"],
                             "aliases": [], "entry": e["entry"]})
        elif not existing["purpose"]:
            existing["purpose"] = e["purpose"]
    for e in entries:
        mine = next((s for s in surfaces if s["id"] == e["surface"]), None)
        if mine is None:
            continue
        for alias in e["aliases"]:
            taken = alias in ("shell", "yantrik") or any(
                s is not mine and (s["id"] == alias or alias in s["aliases"]) for s in surfaces)
            if not taken and alias not in mine["aliases"]:
                mine["aliases"].append(alias)
    return surfaces


def declared_surface(name, surfaces=None):
    """The declared surface a name refers to — its id, an alias, or what the app is called — or
    None."""
    key = fold_name(name)
    if key.startswith("app-"):
        key = key[4:]
    surfaces = declared_surfaces() if surfaces is None else surfaces
    for match in (lambda s: s["id"] == key,
                  lambda s: key in s["aliases"],
                  lambda s: fold_name(s["title"]) == key or fold_name(s["entry"]) == key):
        found = next((s for s in surfaces if match(s)), None)
        if found:
            return found
    return None

# ── Who is answering as the shell ──
#
# The shell's socket is where a person's Allow is asked for and spent, and where `describe shell`
# reads the mode and the ceiling every other decision starts from. Anything that bound
# `app-shell.sock` before the shell did, or after it died, would be believed. So before anything is
# written to it the process listening on it has to be the desktop's own shell: the kernel says which
# pid is listening (`SO_PEERCRED`), `/proc/<pid>/exe` says which program that is, and it has to be
# a `yantrik-ui` binary — the installed one or a developer's build. The same rule the apps' own
# dispatch applies before it spends a grant (`yantrik_ipc_transport::owner::must_be_the_shell`).
# yos-mcp reaches the shell only through this script, so it inherits the check. Same-uid limits
# stand: this stops a stray server or a second shell, not hostile code running as the person.
SHELL_SOCKET = "app-shell.sock"
SHELL_BINARIES = ("yantrik-ui",)


def shell_peer_problem(sock, path):
    """None when `path` is not the shell's socket or the shell is what listens on it; otherwise
    the sentence saying what is listening instead."""
    if os.path.basename(os.path.realpath(path)) != SHELL_SOCKET:
        return None
    try:
        creds = sock.getsockopt(socket.SOL_SOCKET, socket.SO_PEERCRED, struct.calcsize("3i"))
        pid = struct.unpack("3i", creds)[0]
        exe = os.readlink("/proc/%d/exe" % pid)
    except (OSError, AttributeError, struct.error) as e:
        return ("could not tell which process is answering as the shell at %s (%s), so nothing "
                "was sent to it" % (path, e))
    name = os.path.basename(exe[:-len(" (deleted)")] if exe.endswith(" (deleted)") else exe)
    if name in SHELL_BINARIES:
        return None
    return ("the process answering as the shell at %s is %s (pid %d), not the desktop's own "
            "yantrik-ui, so nothing was sent to it. Something else has the shell's name; the "
            "shell will refuse to start beside it" % (path, exe, pid))


def open_socket(path, timeout):
    """Connect to `path`, and when it is the shell's, make sure the shell is who answers."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(timeout)
    try:
        s.connect(path)
    except BaseException:
        s.close()
        raise
    problem = shell_peer_problem(s, path)
    if problem:
        s.close()
        raise Unreachable(problem)
    return s


def socket_candidates(name):
    """Every socket a short name might mean, best guess first.

    Matching ignores case. The app calls itself "Notes" everywhere a caller can see it —
    in its own title, in `describe` output — while its socket is `app-notes`, so anyone
    reading the name off the screen and typing it back gets told there is no such app.
    That is a needless way to fail, and the caller has no way to learn better from it.

    Returns a list, not one path, because "best guess" can be wrong: an app window
    (`app-weather`) preferred over the service (`weather`) may have been closed, leaving a
    stale socket file that refuses connections. The caller tries them in order and falls
    through a dead one, so a killed window never hides a live service.

    The separator a caller arrived with is not part of the name either. One app is
    `container-manager` in /opt/yantrik/bin, `container_manager` in the launcher's route table
    and "Container Manager" when somebody types the words, and all three are the one window;
    the shell links every name an app's `.desktop` file declares at its socket, spelled with
    hyphens, so the folded spellings are tried too. After the literal one, so nothing that
    resolved before resolves differently now.

    Last, and only when none of that found anything: the id of the surface the name is declared
    for (an alias, or what the app is called — `System Monitor`, `yDoc`), read from the `.desktop`
    files themselves. That is for a machine where the shell's links are not there: no desktop
    running, or an app installed a moment ago.
    """
    key = name.lower()
    names = [ALIASES.get(key, key)]
    if key not in ALIASES and not key.startswith("app-"):
        # `notes` should try `app-notes` before the `notes` service, because a person
        # asking about Notes usually means the window they can see — but only *before*, so
        # a closed window falls through to the service rather than dead-ending on it.
        names.insert(0, "app-" + key)
    folded = name.strip().lower().replace("_", "-").replace(" ", "-")
    if folded and folded != key:
        names.extend(n for n in ("app-" + folded, folded) if n not in names)

    found = []
    seen = set()
    for candidate in names:
        for directory in SOCKET_DIRS:
            path = os.path.join(directory, candidate + ".sock")
            if os.path.exists(path) and path not in seen:
                found.append(path); seen.add(path)
        # A socket whose name differs only in case is the same app, so find it anyway.
        for directory in SOCKET_DIRS:
            if not os.path.isdir(directory):
                continue
            for entry in os.listdir(directory):
                if entry.lower() == candidate + ".sock":
                    path = os.path.join(directory, entry)
                    if path not in seen:
                        found.append(path); seen.add(path)
    if not found and not key.startswith("app-") and key not in ALIASES:
        surface = declared_surface(name)
        if surface and surface["id"] != folded:
            return socket_candidates(surface["id"])
    return found


class Unreachable(Exception):
    """A request that could not be made, or was refused, carrying the sentence a reader wants.

    `call` turns this into an exit code, which is right for almost every command: a caller
    asking about a window that is shut has made a mistake and should hear so. It is wrong for
    a caller that can carry on without the answer — `perception` asks the desktop to start a
    service and has something honest to print if no desktop answers, and exiting 1 there put
    "failed (exit 1)" in front of a mind that had done nothing wrong.
    """


def request(name, method, params=None, timeout=40):
    """One JSON-RPC round trip. One line in, one line out.

    Tries every socket the name could mean, in order, skipping any that no longer has a
    process behind it. A socket file outlives the process that made it, so a connection
    refused is "that window is gone", not an error worth stopping on — the next candidate,
    usually the always-on service, answers.

    Raises `Unreachable` rather than exiting, so both kinds of caller can be written.
    """
    candidates = socket_candidates(name)
    if not candidates:
        surface = declared_surface(name)
        if surface:
            raise Unreachable(
                "%s is closed%s. Open it first: act shell open_app name=%s — then describe %s. "
                "(no socket for %r yet)"
                % (name, (" (%s: %s)" % (surface["id"], surface["purpose"])) if surface["purpose"] else "",
                   surface["id"], surface["id"], name))
        raise Unreachable("no socket for %r (try: yos ls)" % name)

    last_error = None
    for path in candidates:
        try:
            s = open_socket(path, timeout)
        except (ConnectionRefusedError, FileNotFoundError) as e:
            # A stale socket: the file is there, the process is not. Try the next candidate.
            last_error = e
            continue
        except PermissionError:
            # Connecting to a unix socket needs *write* permission, which is why a
            # world-readable socket is still unreachable. Say that rather than "denied".
            raise Unreachable(
                "%s is not readable by this user — perception runs as root; try sudo" % path)
        s.sendall((json.dumps({"jsonrpc": "2.0", "id": 1, "method": method, "params": params or {}}) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
        s.close()
        if not buf:
            raise Unreachable("%s closed the connection without answering" % name)
        reply = json.loads(buf)
        if "error" in reply:
            if method == "app.describe" and no_describe(reply):
                # Not a surface at all. When an app of that name is declared, this is the service
                # behind its closed window, and the way forward is to open the app; otherwise it
                # is the desktop's own plumbing, which `yos ls` does not offer (#190).
                surface = declared_surface(name)
                if surface:
                    raise Unreachable(
                        "%s is closed%s. Open it first: act shell open_app name=%s — then "
                        "describe %s." % (name, (" (%s: %s)" % (surface["id"], surface["purpose"]))
                                         if surface["purpose"] else "", surface["id"], surface["id"]))
                raise Unreachable(
                    "%s is part of the desktop's plumbing, not an app or a service to describe: "
                    "it does not answer describe. `yos ls` lists what can be described. "
                    "(%s said: %s)" % (name, name, reply["error"].get("message", "unknown")))
            raise Unreachable(
                "%s.%s refused: %s" % (name, method, reply["error"].get("message", "unknown")))
        return reply["result"]

    # The caller asked about something that is closed. Say how to open it: "its socket is
    # stale" is the mechanism, and the reader wanted to know what to do next.
    surface = declared_surface(name)
    if surface:
        raise Unreachable(
            "%s is closed%s. Open it first: act shell open_app name=%s — then describe %s."
            % (name, (" (%s: %s)" % (surface["id"], surface["purpose"])) if surface["purpose"] else "",
               surface["id"], surface["id"]))
    raise Unreachable(
        "%s is not open. If it is an app, open it first: act shell open_app name=%s — then "
        "describe it again. (`yos ls` shows what is open and what can be opened.)" % (name, name))


def call(name, method, params=None, timeout=40):
    """`request`, with an unreachable service as the end of the command."""
    try:
        return request(name, method, params, timeout)
    except Unreachable as e:
        die(str(e))


def die(message):
    print("yos: " + message, file=sys.stderr)
    raise SystemExit(1)


def read_value(text, declared):
    """One `key=value` value, read the way the parameter it is bound for wants it.

    This used to be `json.loads` on everything, falling back to the raw text, and that is
    right for `count=3` and `all_day=true` and wrong for every identifier made of digits.
    `yos act notifications dismiss id=67` sent the NUMBER 67 to an action that publishes
    `id: string`; the service read a non-string as no string at all and answered "missing
    `id`", while `"id": "67"` over the raw socket dismissed it. A mind following the
    describe exactly could not dismiss a notification at all.

    So the app's own declaration decides. Every action publishes a type per parameter
    (`Param::text` → `string`), and a value bound for a `string` parameter is kept as the
    text it arrived as. For anything else the JSON reading IS the meaning — the download
    manager publishes `Param::number("id")` and wants 3, not "3".

    Quoting still says it explicitly: `id="67"` and `title="  keep the spaces  "` parse to
    the string inside the quotes whatever the parameter is, which is the only way to send
    text that would otherwise be read as JSON.

    `declared` is the published type, or None when nothing said — a parameter the app does
    not list, or an app that would not answer — and then this behaves exactly as it always
    did, because a guess is worse than the old rule.
    """
    try:
        parsed = json.loads(text)
    except ValueError:
        # Not JSON at all. It was only ever the text, and no declaration changes that.
        return text
    if isinstance(parsed, str):
        return parsed
    if declared == "string":
        return text
    return parsed


# `expect_revision` is not an argument to the action — it is the guard around the call — so no
# app declares it and the lookup below would find nothing. It is always a revision hash, which
# `View::revision` renders as 16 hex digits: about one in six thousand of them is all digits,
# and that one would arrive as a number at a runtime that reads it with `as_str` and silently
# acts without the guard the caller asked for.
GUARD_TYPES = {"expect_revision": "string"}


def declared_types(target, action, pairs):
    """What the app says these arguments are — asked for only when it changes the answer.

    A value that is not JSON (`text=hello world`, `name=notes`, `date=2026-10-02`) means the
    same thing whatever it is bound for, and ordinary `yos act` calls are made entirely of
    those. So the describe happens only when some value would read as something other than
    text — `id=67`, `on=true`, `args={"a":1}` — which keeps the common act at the one round
    trip it has always been.

    An app that will not answer leaves everything undeclared, which is the old behaviour; the
    `act` that follows is about to fail on the same socket and say so properly.
    """
    wanted = set()
    for pair in pairs:
        key, _, text = pair.partition("=")
        if key in GUARD_TYPES:
            continue
        try:
            if isinstance(json.loads(text), str):
                continue
        except ValueError:
            continue
        wanted.add(key)
    if not wanted:
        return dict(GUARD_TYPES)

    types = dict(GUARD_TYPES)
    try:
        view = request(target, "app.describe")
    except (Unreachable, OSError, ValueError):
        return types
    for published in view.get("actions") or []:
        if published.get("name") != action:
            continue
        properties = ((published.get("parameters") or {}).get("properties")) or {}
        for name, spec in properties.items():
            if name in wanted:
                types[name] = (spec or {}).get("type")
    return types


def parse_args(pairs, types=None):
    """`name=notes count=3` into a dict, each value read as its parameter is declared.

    `types` maps parameter name to the published JSON Schema type; see `read_value` for what
    it decides and `declared_types` for where it comes from. Without it every value is read
    as JSON where it parses, which is what a caller with no app to ask can do.
    """
    types = types or {}
    out = {}
    for pair in pairs:
        if "=" not in pair:
            die("arguments look like key=value, got %r" % pair)
        key, value = pair.split("=", 1)
        out[key] = read_value(value, types.get(key))
    return out


def _answers(path):
    """Whether a process is behind this socket file right now."""
    s = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    s.settimeout(0.5)
    try:
        s.connect(path)
        return True
    except OSError:
        return False
    finally:
        s.close()


def is_up(name):
    """Whether any socket this name could mean has a process behind it."""
    return any(_answers(path) for path in socket_candidates(name))


# ── Services that are only started when something needs them ──
#
# calendar, notes, email and perception are registered without autostart, so on a fresh session
# their sockets do not exist and the machine rail calls them "on demand". The shell owns service
# lifetimes through its ServiceManager, so a caller that needs one asks the shell — `act shell
# start_service` — rather than spawning the binary behind its back. Starting it any other way
# would have the rail report a running process as stopped, which is the same class of lie as the
# caption it replaced. This is the same request `yantrik_ipc_transport::service::ensure` makes
# from inside an app.


def started_on_demand(name, wait=2.0):
    """Ask the desktop to start a service, and say whether its socket answers afterwards.

    Reports rather than exiting, because for one caller a service that will not start is an
    answer to print and not an error to raise: `perception` has a plain sentence for a machine
    with no record to read, and dying there would put "failed (exit 1)" in front of a mind that
    had asked a perfectly good question. `ensure_service` is the strict wrapper for the rest.
    """
    if is_up(name):
        return True
    try:
        request("shell", "app.act", {"action": "start_service", "args": {"name": name}})
    except Unreachable:
        # No desktop to ask, or it does not know this service. Either way it is not coming up on
        # this request, and the caller has its own words for that.
        return False
    # The manager returns once it has spawned the process; the socket appears a moment later.
    # Measured on a release build: perception-service binds 54ms after exec, opening its
    # descriptors and closing its Landlock eyelid on the way.
    deadline = time.time() + wait
    while time.time() < deadline:
        if is_up(name):
            return True
        time.sleep(0.1)
    return False


def ensure_service(name):
    """Make sure a service is up, asking the desktop to start it if it is not.

    The notifications service is autostarted, but "autostarted" is not "running": it can
    have died, or the shell can still be coming up. Sending into a socket nobody is behind
    would lose the message silently, which is the failure this whole path exists to end.
    """
    if not started_on_demand(name):
        die("the %s service is not running and the desktop could not start it" % name)


def no_describe(reply):
    """Whether a JSON-RPC reply to `app.describe` says the socket has no such method: a service
    that is not a surface. Each says it its own way — the transport's -32601, the companion's
    socket -32602, the harness host -32000 (docs/surface-protocol.md) — and what they all say is
    that the method is unknown."""
    error = reply.get("error") if isinstance(reply, dict) else None
    if not isinstance(error, dict):
        return False
    return error.get("code") == -32601 or "unknown method" in str(error.get("message", "")).lower()


def _describable(path, timeout=2.0):
    """Whether the socket at `path` answers `app.describe`. False only when it says plainly that
    it has no such method: a describe that is slow, or fails some other way, is still a surface's,
    and a surface is listed rather than hidden. Never raises: this is a listing."""
    try:
        s = open_socket(path, timeout)
    except (OSError, Unreachable):
        return True
    try:
        s.sendall(b'{"jsonrpc":"2.0","id":1,"method":"app.describe","params":{}}\n')
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
        return not no_describe(json.loads(buf))
    except (OSError, ValueError):
        return True
    finally:
        s.close()


def _describable_all(paths):
    """`_describable` for each path, asked at once, so the listing waits for the slowest service
    rather than for all of them in turn."""
    if not paths:
        return []
    import concurrent.futures
    with concurrent.futures.ThreadPoolExecutor(max_workers=min(8, len(paths))) as pool:
        return list(pool.map(_describable, paths))


def _one_line(path):
    """An app's own one-line summary, or nothing. Never raises: this is a listing."""
    try:
        s = open_socket(path, 2)
    except (OSError, Unreachable):
        return ""
    try:
        s.sendall(b'{"jsonrpc":"2.0","id":1,"method":"app.describe","params":{}}\n')
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
        return (json.loads(buf).get("result") or {}).get("summary", "")
    except (OSError, ValueError):
        return ""
    finally:
        s.close()


def cmd_ls(argv):
    """What is running, and what could be.

    This printed the socket directory. A socket file outlives the process that made it, so
    the listing a mind was told is "what is running on this desktop right now" named every app
    that had ever been opened since boot: Calendar, closed for hours, sat in it beside Notes,
    and describing it failed. It also printed `calendar` and `app-calendar` as two entries with
    nothing to say which was the window and which the service behind it. Each socket is now
    asked whether anybody is there, the ones that answer are split into apps and services and
    shown by the name to describe them by, and what `open_app` can open comes from the shell —
    because the other half of "what can I do here" was written down nowhere at all.

    An app answers to more than one name — Container Manager publishes `containers` and is
    `container-manager` in the launcher, in `/opt/yantrik/bin` and in `open_app` — and the other
    names are symlinks to the one socket. So they are collected and shown beside the app rather
    than listed as apps of their own: one window, one line, and every name it answers to on it.

    Every app whose `.desktop` file declares a surface is listed whether or not it is running —
    closed ones as `(closed)` with what they are for — from the shell's own catalogue, or, when
    the shell is not answering, from the `.desktop` files themselves. An app somebody else wrote is
    listed exactly as ours are. `--all` adds the sockets closed windows left behind.
    """
    raw = "--all" in argv
    apps, services, stale, also = [], [], [], {}
    for directory in SOCKET_DIRS:
        if not os.path.isdir(directory):
            continue
        try:
            entries = sorted(f[:-5] for f in os.listdir(directory) if f.endswith(".sock"))
        except PermissionError:
            print("  %s (not readable by this user)" % directory)
            continue
        for name in entries:
            path = os.path.join(directory, name + ".sock")
            if os.path.islink(path):
                # The same surface under another of its names. A dangling one means the app is
                # closed, and the socket it points at is already reported as stale. Anything
                # else that happens to be a symlink is listed the way it always was.
                target = os.path.basename(os.readlink(path))
                if target.startswith("app-") and target.endswith(".sock"):
                    also.setdefault(target[4:-5], []).append(
                        name[4:] if name.startswith("app-") else name)
                    continue
            if not _answers(path):
                stale.append(name)
            elif name.startswith("app-"):
                apps.append((name[4:], _one_line(path)))
            else:
                services.append((name, path))

    # A socket that answers and has no `app.describe` is not a surface: it is the desktop's own
    # plumbing — the harness host minds attach through, the companion's socket, a journal, the
    # store behind an app. It was listed below beside the services, and a mind read `harness` off
    # this listing, described it, and spent a failed call finding out it was not one (#190). Each
    # service is asked once, all at once, and left out only when it says plainly that it has no
    # such method.
    speaks = _describable_all([path for _, path in services])
    internal = [name for (name, _), ok in zip(services, speaks) if not ok]
    services = [name for (name, _), ok in zip(services, speaks) if ok]

    print("Open now (describe these by name):")
    for name, summary in apps:
        names = ", ".join(sorted(also.get(name, [])))
        print("    %-18s %s%s" % (name, summary, ("  (also %s)" % names) if names else ""))
    if not apps:
        print("    (nothing)")
    print("Services answering: %s" % (", ".join(services) or "(none)"))
    print("    a service shares a name with its app (weather, calendar); the app is the window,")
    print("    and `describe <name>` means the window whenever it is open.")

    shell = os.path.join(SOCKET_DIRS[0], "app-shell.sock")
    openable, from_disk = [], False
    if _answers(shell):
        try:
            openable = (call("shell", "app.describe", timeout=5).get("state") or {}).get("apps") or []
        except SystemExit:
            openable = []
    if not openable:
        # No desktop to ask. The apps that declare a surface are still on the disk, and a closed
        # app is exactly what a caller cannot find any other way.
        from_disk = True
        openable = [{"name": s["id"], "opens": "app", "describe_as": s["id"], "for": s["purpose"],
                     "aliases": s["aliases"]} for s in declared_surfaces()]
    running = {name for name, _ in apps}
    closed = [a for a in openable if a.get("opens") == "app" and a.get("describe_as") not in running]
    if closed:
        # One line each, with what the app is for. This was a comma-separated row of names, and
        # a row of names is how three different models, asked for a "document", each wrote a
        # note: Notes was open with a summary that fitted and `documents` was a word in a list.
        # The heading's first words are what harnesses read the section by
        # (harnesses/deepseek/yantrik_deepseek.py, `apps_from_listing`); keep them.
        print("Can be opened with `act shell open_app name=<name>`, then described by that "
              "name%s:" % (" (the desktop is not answering; read from the .desktop files)"
                           if from_disk else ""))
        for a in closed:
            then = "" if a["name"] == a.get("describe_as") else "  (then describe %s)" % a["describe_as"]
            also = ", ".join(a.get("aliases") or [])
            print("    %-18s (closed)  %s%s%s" % (a["name"], a.get("for", ""), then,
                                                  ("  (also %s)" % also) if also else ""))
    screens = [a["name"] for a in openable if a.get("opens", "").startswith("a screen")]
    if screens:
        print("Screens of the desktop itself (also open_app): %s" % ", ".join(screens))
    # The launcher used to be printed among the screens, and `show_screen screen=launchpad`
    # was the next thing every reader tried. It opens over the desktop, by either verb.
    for a in openable:
        if a.get("opens", "").startswith("the launcher"):
            print("The launcher (open_app name=%s, or show_screen): %s" % (a["name"], a.get("for", "")))
    # The sentence issue #116 asked for. Before it, this listing said the surfaces were "what
    # the minds use too" while a mind with a terminal could run through `yos act` what its own
    # tools would have asked about — the grade was the bridge's policy, not the machine's.
    print("Every door asks the same way: an action graded above what the desktop's mode allows")
    print("    needs the person's Allow — from a mind's tools, from `yos act` here, or straight")
    print("    at the socket; the app itself refuses without a grant. `yos act` raises the card")
    print("    and waits (120 s). `describe shell` shows the mode; `describe` never asks.")
    if raw and stale:
        print("Closed, socket left behind: %s" % ", ".join(stale))
    if raw and internal:
        print("The desktop's own, not surfaces (they do not answer describe): %s"
              % ", ".join(internal))


def cmd_describe(argv):
    if not argv:
        die("usage: yos describe <shell|notes|...>")
    view = call(argv[0], "app.describe")
    print(view.get("summary", "(no summary)"))
    if "revision" in view:
        print("revision: %s" % view["revision"])
    fold = "--fold" in argv
    if view.get("state"):
        print(render_state(view["state"], argv[0], fold))
    brief = "--brief" in argv
    if fold and not brief:
        expand = argv[argv.index("--actions") + 1] if "--actions" in argv[:-1] else None
        print(render_folded(argv[0], view.get("actions", []), expand))
        return
    for action in view.get("actions", []):
        print(render_action(action, brief))


# The fixed presentation order of the state's keys (#319). The wire cannot carry an order:
# `View.state` is a `serde_json::Value`, whose map is a BTreeMap, so every describe arrives with
# its keys sorted alphabetically — and it has to stay that way, because `View::revision()` hashes
# exactly that sorted rendering and the Python port pins the same bytes. Alphabetically, the
# shell's large lists land among the small fields it buries: measured on a live desktop, `agents`
# (~11.5 KB) and `catalog` (~4.5 KB) sorted ahead of `clock`, so a mind reading only the head of
# a describe, or clipping it by length, lost the time and every other small field sorting after
# the big ones. The order is therefore chosen here, where the text a reader sees is made: the
# small, high-value fields first, the large lists last, the rest in the wire's alphabetical order
# between them. Keys and values are untouched; only the order they are printed in changes. A key
# that is not present is simply not printed, so this is safe for every app, not only the shell.
STATE_FIRST = ("summary", "screen", "locked", "clock", "windows", "companion_online")
STATE_LAST = ("agents", "catalog", "services")


def state_keys_in_order(state):
    """The keys of `state` in the order a reader gets them: `STATE_FIRST` that are present, in
    that order, then every other key as it arrived, then `STATE_LAST` that are present."""
    middle = [k for k in state if k not in STATE_FIRST and k not in STATE_LAST]
    return ([k for k in STATE_FIRST if k in state] + middle
            + [k for k in STATE_LAST if k in state])


def render_state(state, app, fold):
    """The state object, still JSON, without the air.

    Every describe a mind reads stays in its conversation for the rest of the session, so its
    size is paid on every later turn. Measured on a live desktop, `describe shell` was 13.8 KB —
    about 3,400 tokens — and 5.9 KB of that was this object pretty-printed at indent 2: one
    line per bracket, a window list of four entries spread over twenty lines. It is printed one
    top-level key per line with the value compact. That is the same JSON — every caller that
    parses it from the first `{` still can — at well under half the size.

    The keys are printed in the fixed order of `state_keys_in_order`, small fields first and the
    large lists last, because the wire's own order is alphabetical and put the largest fields
    over the small ones a length-clipped reader keeps (#319).

    `--fold` (what the MCP bridge asks for) also leaves out the shell's `apps` list: it is the
    table behind `open_app`, `os_apps` already presents it in three lines, and here it was 2.7 KB
    of every describe of the desktop. It is named, not silently dropped.
    """
    if not isinstance(state, dict):
        return json.dumps(state)
    note = ""
    if fold and app.lower() in ("shell", "app-shell") and "apps" in state:
        state = {k: v for k, v in state.items() if k != "apps"}
        note = "\n(what `open_app` can open is listed by os_apps / `yos ls`, not repeated here)"
    rows = ["  %s: %s" % (json.dumps(k), json.dumps(state[k], ensure_ascii=False))
            for k in state_keys_in_order(state)]
    return "{\n" + ",\n".join(rows) + "\n}" + note


# How many actions an app may publish before families of them are folded, and how big a
# family has to be to count as one.
FOLD_ABOVE = 14
FAMILY_AT_LEAST = 4


def render_folded(app, actions, expand=None):
    """Actions for a reader paying by the token: documented where it matters, listed elsewhere.

    The desktop publishes 36 actions and 20 of them are `files_*` and `editor_*`, which matter
    on two screens out of fifteen. Documenting all 36 in full on every describe cost a mind
    about 2,000 tokens to learn, again, how to rename a file it was not going to rename. An app
    with a handful of actions is printed in full, as before. Above FOLD_ABOVE, a family — four
    or more actions sharing the word before their first underscore — is printed as signatures
    and grades only, under a line that says how to read the rest. Nothing is hidden: every
    action's name, arguments and grade are still there, which is what is needed to notice that
    an action exists; its documentation is one call away, and `expand` is that call.
    """
    if len(actions) <= FOLD_ABOVE and not expand:
        return "\n".join(render_action(a) for a in actions)

    families = {}
    for a in actions:
        head = a["name"].split("_", 1)[0] if "_" in a["name"] else None
        families.setdefault(head, []).append(a)
    folded = {h for h, members in families.items()
              if h is not None and len(members) >= FAMILY_AT_LEAST}
    if expand and len(actions) > FOLD_ABOVE:
        # Asked for one family: print that one in full and the rest briefly, so the answer to
        # "how do the files actions work" is not another 3,000 tokens of everything else.
        want = expand.rstrip("_")
        out = [render_action(a) for a in actions if a["name"].split("_", 1)[0] == want]
        if not out:
            out = ["  (no action of %s starts with `%s`)" % (app, expand)]
        rest = [a for a in actions if a["name"].split("_", 1)[0] != want]
        out.append("  other actions of %s, briefly:" % app)
        out.extend(render_action(a, brief=True) for a in rest)
        return "\n".join(out)

    out = []
    done = set()
    for a in actions:
        head = a["name"].split("_", 1)[0] if "_" in a["name"] else None
        if head in folded:
            if head in done:
                continue
            done.add(head)
            members = families[head]
            out.append("  %s_* — %d actions, signatures only; for what each does and what its "
                       "arguments mean: os_describe %s with actions=%s_"
                       % (head, len(members), app, head))
            out.extend("  " + render_action(m, brief=True) for m in members)
        else:
            out.append(render_action(a))
    return "\n".join(out)


def render_action(action, brief=False):
    """One action, with everything the app said about it.

    Every app publishes, for every action, what it is for; and for every argument, its type,
    whether it is required, and a sentence about it — `date: "YYYY-MM-DD"`, and on
    `delete_event`, "It is not recoverable". This function printed the argument NAMES and
    dropped the rest, so a mind was shown `add_event(all_day, date, duration_min, notes, time,
    title)` and left to guess that `date` is ISO and `time` is 24-hour. The refusals were good
    ("`date` should look like 2026-09-06"), which made it a wasted round trip per app rather
    than a wall; and the things a refusal cannot teach — what an action is for, that a delete
    is final, which of six arguments are optional — were simply never seen. A model working
    from that and "inventing arguments" is reading what it was given.

    `--brief` keeps the old one-line form for a person at a terminal.
    """
    params = action.get("parameters") or {}
    props = params.get("properties") or {}
    if brief:
        return "  act: %s(%s)  [%s, settles %s]" % (
            action["name"], ", ".join(props.keys()),
            action.get("permission", "?"), action.get("settles", "?"))

    required = set(params.get("required") or [])
    # Required first, then the rest, each in the order the app declared them.
    names = [n for n in props if n in required] + [n for n in props if n not in required]
    lines = ["  act: %s(%s)  [%s, settles %s]" % (
        action["name"], ", ".join(n if n in required else n + "?" for n in names),
        action.get("permission", "?"), action.get("settles", "?"))]
    purpose = (action.get("description") or "").strip()
    if purpose:
        lines.append("       %s" % purpose)
    for n in names:
        spec = props[n] or {}
        kind = spec.get("type", "any")
        if spec.get("enum"):
            kind = "one of " + " | ".join(str(v) for v in spec["enum"])
        about = (spec.get("description") or "").strip()
        lines.append("         %s%s: %s%s" % (
            n, "" if n in required else "?", kind, (" — " + about) if about else ""))
    return "\n".join(lines)


# How an app says "not without the person's Allow". The refusal an app's runtime sends for a
# call above what the desktop's mode allows starts with this and says how to get a grant: ask
# the shell, wait for the person, act again carrying the grant. `yos act` does those three steps
# itself, so a person at the keyboard sees one card and clicks it, and a mind in a terminal gets
# the same card its own tools would have raised (issue #116). It branches on the marker the
# way the bridge branches on `CEILING:`; the words after it are for a reader.
GRANT_MARK = "GRANT:"
# The shell holds a request open for this long. Polled, once a second, because nothing here can
# be called back; a person cannot answer inside the first second anyway.
APPROVAL_WAIT = 120
APPROVAL_POLL = 1.0


def plain(unreachable):
    """The sentence in a refusal, without the `shell.app.act refused:` the transport put in front."""
    return re.sub(r"^\S+\.app\.act refused: ", "", str(unreachable))


def act_after_asking(target, action, params, refusal):
    """Raise the card the refusal asked for, wait for the person, and act again with the grant.

    Returns the second act's reply, or ends the command with a plain sentence: the person said
    no, nobody answered, or the desktop would not ask. Nothing in here decides anything —
    `request_approval` puts a card up, `approval_status` reads an answer somebody else gave, and
    the app's own dispatch spends the grant when the action runs. There is no action anywhere on
    this desktop that grants.
    """
    app = target[4:] if target.startswith("app-") else target
    found = re.search(r"graded `([a-z]+)`", refusal)
    # The shell reads the app's published grade itself and corrects an understated one; what is
    # sent here only has to be a grade, and the refusal always names one.
    grade = found.group(1) if found else "sensitive"
    try:
        asked = request("shell", "app.act", {"action": "request_approval", "args": {
            "app": app, "action": action, "grade": grade,
            "args_json": params["args"], "requester": "yos",
        }}, timeout=20)
    except Unreachable as e:
        # The shell's own sentence: plan mode, the ceiling, a grade it will not ask about.
        die("%s.%s needs the person's Allow and they could not be asked: %s" % (app, action, plain(e)))
    answer = asked.get("result") or {}
    if answer.get("status") == "not_needed":
        die("%s refused %s.%s without a grant, but the desktop says its %s mode runs it unasked. "
            "The two should agree; nothing was run. Try again in a moment, or read the refusal: %s"
            % (app, app, action, answer.get("mode", "current"), plain(refusal)))
    request_id = answer.get("request_id")
    if not request_id:
        die("the desktop was asked to put a card up for %s.%s and did not say which request it "
            "was, so there is nothing to wait on. Nothing was run." % (app, action))

    print("asking — a card is on the screen (%d s)" % APPROVAL_WAIT)
    sys.stdout.flush()
    deadline = time.monotonic() + APPROVAL_WAIT
    status = "pending"
    while time.monotonic() < deadline:
        time.sleep(max(0.0, min(APPROVAL_POLL, deadline - time.monotonic())))
        try:
            poll = request("shell", "app.act", {"action": "approval_status",
                                                "args": {"request_id": request_id}}, timeout=10)
        except Unreachable:
            # A poll that fails is not an answer. The card is still up and the person may be
            # reaching for the mouse; ask again until the wait is up.
            continue
        status = (poll.get("result") or {}).get("status", "pending")
        if status != "pending":
            break

    if status == "granted":
        try:
            return request(target, "app.act", dict(params, grant=request_id),
                           timeout=act_timeout(action, params["args"]))
        except Unreachable as e:
            die("the person allowed %s.%s, but it did not go through: %s" % (app, action, plain(e)))
    if status == "denied":
        die("the person at the machine said no to %s.%s. Nothing was run. That is an answer, not "
            "an error: do not ask again unless they bring it up." % (app, action))
    if status == "consumed":
        die("the grant for %s.%s had already been spent, so nothing was run. Ask again if it still "
            "needs doing." % (app, action))
    die("nobody answered the card for %s.%s within %d s, so nothing was run. They were probably "
        "away from the keyboard; run this again when they are back." % (app, action, APPROVAL_WAIT))


# Where a harness puts the token of the agent it runs, for every `yos` its mind starts.
AGENT_TOKEN_ENV = "YANTRIK_AGENT_TOKEN"
# How long an act is given by default, and by how much an act that was told to `wait` is given
# longer than its wait: the shell answers `agent_run` when the command ends or the wait runs out.
ACT_TIMEOUT = 40
WAIT_MARGIN = 20
# Actions that wait for a command, and how long they wait when not told (the shell's default).
WAITING_ACTIONS = {"agent_run": 120, "agent_job": 120}


def act_timeout(action, args):
    """How long to wait for an act's answer: longer than the act itself was told to wait —
    `wait` for a command, `wait_seconds` for `hand_off`, which waits for a role's answer."""
    wait = args.get("wait", args.get("wait_seconds", WAITING_ACTIONS.get(action)))
    if isinstance(wait, (int, float)) and not isinstance(wait, bool) and wait > 0:
        return max(ACT_TIMEOUT, float(wait) + WAIT_MARGIN)
    return ACT_TIMEOUT


def take_agent_token(argv):
    """The agent token off a command line, and the command line without it.

    `--agent-token <t>` first, then an `agent_token=<t>` argument, then the environment a
    harness started this in. Read as the text it is — never through `read_value`, which would
    turn a token made of digits into a number.
    """
    token = None
    if "--agent-token" in argv:
        at = argv.index("--agent-token")
        if at + 1 >= len(argv):
            die("--agent-token needs the token your harness was given")
        token = argv[at + 1]
        argv = argv[:at] + argv[at + 2:]
    rest = []
    for arg in argv:
        if arg.startswith("agent_token="):
            token = token or arg.split("=", 1)[1]
        else:
            rest.append(arg)
    token = (token or os.environ.get(AGENT_TOKEN_ENV, "")).strip()
    return (token or None), rest


def cmd_act(argv):
    if len(argv) < 2:
        die("usage: yos act <target> <action> [key=value ...] [--full] [--grant <id>] [--no-ask] "
            "[--agent-token <t>]")
    # The reply carries a full `describe` of the app as it stands after the action. That is
    # the right thing to send and the wrong thing to print: filling six fields of the
    # installer printed the same 180-line shell state six times, and an agent pays for every
    # line of it. So the default is the part that changed, and `--full` is there for when the
    # whole picture is what you actually wanted.
    full = "--full" in argv
    # `--no-ask` is for a caller that asks on its own account — the MCP bridge raises the card
    # itself, with the mind's name on it — and wants a refusal back rather than a second card.
    # `--grant` carries a grant such a caller already holds.
    no_ask = "--no-ask" in argv
    grant = None
    if "--grant" in argv:
        at = argv.index("--grant")
        if at + 1 >= len(argv):
            die("--grant needs the request_id the shell granted")
        grant = argv[at + 1]
        argv = argv[:at] + argv[at + 2:]
    argv = [a for a in argv if a not in ("--full", "--no-ask")]
    # Beside the arguments, never among them: see the conventions at the top.
    agent_token, argv = take_agent_token(argv)
    if len(argv) < 2:
        die("usage: yos act <target> <action> [key=value ...] [--full] [--grant <id>] [--no-ask] "
            "[--agent-token <t>]")
    target, action = argv[0], argv[1]
    pairs = argv[2:]
    params = {"action": action, "args": parse_args(pairs, declared_types(target, action, pairs))}
    # An `expect_revision` is lifted out of the args, because it guards the call rather
    # than being an argument to the action.
    if "expect_revision" in params["args"]:
        params["expect_revision"] = params["args"].pop("expect_revision")
    if grant:
        params["grant"] = grant
    if agent_token:
        params["agent_token"] = agent_token
    try:
        reply = request(target, "app.act", params, timeout=act_timeout(action, params["args"]))
    except Unreachable as e:
        # A refusal for want of a grant is a question, not an ending — unless the caller said
        # it would do its own asking, or already brought a grant that did not hold.
        if GRANT_MARK not in str(e) or no_ask or grant:
            die(plain(e) if GRANT_MARK in str(e) else str(e))
        reply = act_after_asking(target, action, params, str(e))
    if full:
        print(json.dumps(reply, indent=2))
        return
    print(reply.get("summary", "(no summary)"))
    # `settled` is the one field a caller must not miss: false means the work was accepted and
    # has not finished, so it is printed even when everything went well.
    print("accepted: %s, settled: %s" % (reply.get("accepted"), reply.get("settled")))
    if "revision" in reply:
        print("revision: %s" % reply["revision"])
    if reply.get("result"):
        print(json.dumps(reply["result"], indent=2))
    if reply.get("state"):
        print("(state omitted; `yos describe %s`, or re-run with --full)" % target)


def cmd_perception(argv):
    limit = int(argv[0]) if argv else 20
    # This request is the demand, so it is what starts the service.
    #
    # perception is registered without autostart, like calendar and notes, and for a while
    # nothing anywhere started it: `describe shell` said "stopped, on demand", every mind was
    # offered os_perception, and every call answered "no socket for 'perception' (try: yos ls)"
    # — which reads as the caller having done something wrong and sends it to a listing that
    # will not show it. "On demand" was a caption on a process nothing ever ran.
    #
    # Started from the session it lands in the user's runtime directory and answers. It cannot
    # join the process connector or open fanotify from there — those need CAP_NET_ADMIN and
    # CAP_SYS_ADMIN, which a desktop session has no way to grant — so it comes up on PSI alone
    # and publishes a `SourceFailed` observation naming each source it had to do without. That
    # is the first thing printed below, at salience 1.0. Half-blind and saying which half is a
    # report; a socket that was never opened is not. A privileged one already running is found
    # first and left alone, because `started_on_demand` only asks when nothing answers.
    if not started_on_demand("perception"):
        print("The perception service is not running on this machine and the desktop could not "
              "start it, so there is no record of recent activity to read. Nothing is wrong with "
              "the request. To see what an app is showing right now, describe it instead.")
        return
    page = call("perception", "perception.since", {"seq": 0})
    obs = page["observations"]
    print("%d held, next_seq %d, missed %d" % (len(obs), page["next_seq"], page["missed"]))
    if page["missed"]:
        print("  (%d observations were overwritten before anything read them)" % page["missed"])
    # A source that could not start says so once, in the first observations of the run, which is
    # exactly what the tail slice hides: ask for the last three on a service that has been up an
    # hour and "perception cannot use its files source" is the first thing off the end. So it is
    # printed whatever the limit, in its own place in the order. A reader who does not know a
    # source is missing reads its silence as nothing having happened, and this feed is answering
    # "what has been going on" for a mind that has no other way to find out.
    shown = obs[-limit:]
    for o in obs[:len(obs) - len(shown)]:
        if (o.get("kind") or {}).get("type") == "source_failed":
            print("  [%.2f] %s" % (o["salience"], o["summary"]))
    for o in shown:
        print("  [%.2f] %s" % (o["salience"], o["summary"]))


def cmd_journal(_):
    status = call("perception-journal", "journal.status")
    for key in ("connected", "source_next_seq", "consumed_next_seq", "lag",
                "records", "gaps", "observations_lost", "bytes_on_disk",
                "seconds_since_progress"):
        print("  %-22s %s" % (key, status.get(key)))


# ── Notifications ──
#
# One line, because the common case is one line: something finished and the person should
# be told. It lands in the same store as every notification on the machine — `notify-send`,
# Chromium, our own apps — so the toast, the notification centre and `yos describe shell`
# all see it.
#
# No `--app` sends no name. This used to fill in `Yantrik`, so every line typed here — and
# every line a mind sent through here — wore the desktop's own name (#114). The service files
# a nameless notification under the program that called, as the kernel identified it, and
# records both what was claimed and what it verified; `Yantrik` is kept for the shell itself.


def cmd_notify(argv):
    urgency = "normal"
    app = None
    words = []
    i = 0
    while i < len(argv):
        if argv[i] in ("--urgency", "-u") and i + 1 < len(argv):
            urgency, i = argv[i + 1], i + 2
        elif argv[i] == "--app" and i + 1 < len(argv):
            app, i = argv[i + 1], i + 2
        else:
            words.append(argv[i])
            i += 1
    if not words:
        die("usage: yos notify <title> [body] [--urgency low|normal|critical] [--app NAME]")

    ensure_service("notifications")
    params = {
        "title": words[0],
        "body": " ".join(words[1:]),
        "urgency": urgency,
    }
    if app is not None:
        params["app"] = app
    stored = call("notifications", "notifications.add", params)
    # The id, because that is what `yos act notifications dismiss id=...` takes; the urgency
    # as the store recorded it — a typo in `--urgency` becomes `normal` rather than a refusal,
    # and printing it is how the sender finds out; and the name it was filed under, which is
    # the sender's word only if they gave one.
    print("%s  [%s] %s  (from %s)" % (stored["id"], stored["urgency"], stored["title"],
                                     stored.get("app", "?")))
    if stored.get("body"):
        print("  %s" % stored["body"])


# ── The browser ──
#
# Everything else in this file talks to something we wrote, which can simply be asked.
# A web page cannot: it is rendered, unstructured, and changes under you. So this reads
# it semantically rather than visually — accessible names over pixels — which is the
# same rule the rest of the OS follows for foreign windows.

CDP = "http://127.0.0.1:9222"


def _page():
    """The active page's debugger socket, or a usable complaint."""
    import urllib.error
    import urllib.request
    try:
        tabs = json.load(urllib.request.urlopen(CDP + "/json/list", timeout=5))
    except urllib.error.URLError:
        # The way forward, not a flag recipe: the desktop's own launcher starts the browser
        # drivable, so the answer to "no browser" is to open it. (A browser somebody started by
        # hand, or one from before this build, has no port — closing and reopening it fixes that.)
        die("no browser this desktop can drive is open. Open it: yos act shell open_app "
            "name=browser — then `yos web go <url>`. If a browser window is already open, it "
            "was not started by the desktop; close it and open it that way.")
    pages = [t for t in tabs if t.get("type") == "page"]
    # A caller that opened a tab of its own names it, and every `yos web` drives that tab and no
    # other — release-check does, so a check of the browser never navigates a person's page.
    # Otherwise the first page the browser lists, which is the one most recently active.
    wanted = os.environ.get("YOS_WEB_TAB", "").strip()
    if wanted:
        mine = [t for t in pages if t.get("id") == wanted]
        if not mine:
            die("the tab YOS_WEB_TAB names (%s) is not open in this browser" % wanted)
        return mine[0]
    if not pages:
        die("the browser is running but has no page open")
    return pages[0]


def _eval(expression, await_promise=False):
    try:
        from websocket import create_connection
    except ImportError:
        die("needs python3-websocket (apt install python3-websocket)")
    page = _page()
    # Chromium 2024+ refuses websocket upgrades whose Origin it did not expect, which is
    # why the browser must be started with --remote-allow-origins and this must send one.
    ws = create_connection(page["webSocketDebuggerUrl"], origin=CDP, timeout=60)
    ws.send(json.dumps({"id": 1, "method": "Runtime.evaluate", "params": {
        "expression": expression, "returnByValue": True, "awaitPromise": await_promise}}))
    while True:
        msg = json.loads(ws.recv())
        if msg.get("id") == 1:
            break
    ws.close()
    if "error" in msg:
        die("the page refused: %s" % msg["error"].get("message"))
    result = msg["result"].get("result", {})
    if msg["result"].get("exceptionDetails"):
        die("the page threw: %s" % msg["result"]["exceptionDetails"].get("text"))
    return result.get("value")


SCAN = None  # loaded lazily from disk beside this script


def _scan_js():
    global SCAN
    if SCAN is None:
        path = os.path.join(os.path.dirname(os.path.realpath(__file__)), "scan.js")
        if not os.path.exists(path):
            die("scan.js is missing next to yos; the page reader needs it")
        SCAN = open(path).read()
    return SCAN


def cmd_web(argv):
    if not argv:
        page = _page()
        print("%s\n%s\n" % (page.get("title", "")[:90], page.get("url", "")[:90]))
        print(_eval(_scan_js()) or "(nothing interactive in the viewport)")
        return

    sub = argv[0]
    if sub == "find":
        # The answer to "1509 more not currently on screen".
        #
        # A viewport reading of Wikipedia shows 100 elements out of 1609. Printing all of
        # them costs 60 KB and throws away the compression that makes this readable at
        # all. But the refs are global — the scan numbers every element and only *prints*
        # the visible ones — so the rest are already addressable, they just cannot be
        # found. This searches the whole set by accessible name and prints the matches
        # with their real refs, which is what an agent actually wants: not "show me
        # everything", but "where is the thing I came for".
        if len(argv) < 2:
            die("usage: yos web find <words>")
        needle = " ".join(argv[1:])
        _eval(_scan_js())  # refresh the registry before searching it
        matches = _eval("""(() => {
            const NL = String.fromCharCode(10);
            const q = %s.toLowerCase();
            const out = [];
            (window.__yantrik_elements || []).forEach((el, i) => {
                const name = (el.getAttribute('aria-label') || el.innerText ||
                              el.value || el.getAttribute('name') || '').trim();
                if (!name || !name.toLowerCase().includes(q)) return;
                const r = el.getBoundingClientRect();
                const onscreen = r.width > 0 && r.height > 0 &&
                                 r.top < innerHeight && r.bottom > 0;
                out.push('[' + (i+1) + '] ' + el.tagName.toLowerCase() + ' "' +
                         name.slice(0, 70).split(NL).join(' ') + '"' +
                         (el.href ? ' -> ' + el.href.slice(0, 60) : '') +
                         (onscreen ? '' : '  (off screen)'));
            });
            return out.slice(0, 40).join(NL);
        })()""" % json.dumps(needle))
        if not matches:
            # Said plainly, because "nothing printed" and "nothing there" look identical
            # and an agent will conclude the page lacks it and give up.
            print("nothing on this page matches %r. It may be behind a click, or the page "
                  "may not have finished rendering." % needle)
        else:
            print(matches)
    elif sub == "all":
        print(_eval(_scan_js().replace("const showAll = false", "const showAll = true"))
              or "(nothing interactive on this page)")
    elif sub == "text":
        # The other half of seeing a page, and the half that was missing.
        #
        # `yos web` lists what you can *do* — links, buttons, fields — which is what an
        # agent needs to act. It is useless for research, because an article and a comment
        # thread are prose, and prose is not interactive. Pointed at a Hacker News
        # discussion, the element scan returned 1.5 KB of navigation chrome and not one
        # word of any comment. An agent asked to summarise the argument could navigate
        # perfectly and had nothing to read.
        #
        # `innerText` rather than `textContent` deliberately: innerText is what is
        # *rendered* — it respects display:none, collapses whitespace the way the browser
        # does, and inserts the line breaks a reader actually sees. textContent would hand
        # back hidden markup and run paragraphs together.
        limit = int(argv[1]) if len(argv) > 1 else 20000
        text = _eval("document.body.innerText") or ""
        if len(text) > limit:
            # Truncation is announced, not silent. An agent that quietly received half a
            # page would summarise half an argument and never know.
            print(text[:limit])
            print("\n[... %d more characters. `yos web text %d` for more.]"
                  % (len(text) - limit, len(text)))
        else:
            print(text)
    elif sub == "go":
        if len(argv) < 2:
            die("usage: yos web go <url>")
        url = argv[1]
        _eval("location.assign(%s)" % json.dumps(url))
        print("navigating to %s — take a fresh `yos web` once it settles" % url)
    elif sub == "tabs":
        import urllib.request
        for t in json.load(urllib.request.urlopen(CDP + "/json/list", timeout=5)):
            if t.get("type") == "page":
                print("  %-60s %s" % (t.get("title", "")[:60], t.get("url", "")[:60]))
    elif sub in ("click", "type"):
        _web_click_or_type(sub, argv)
    elif sub == "listen":
        cmd_listen(argv[1:])
    else:
        die("unknown: yos web [go|click|type|tabs|listen]")


# Controls whose label reads as a commitment. Taken from yantrik-mind's browser driver so
# the two paths draw the same line — an agent stopped at a button in one of them must not
# be able to reach it through the other.
#
# Broad on purpose: a false positive costs one confirmation, a false negative costs money
# or a sent message.
COMMIT_WORDS = [
    "buy", "purchase", "order", "checkout", "pay", "payment", "subscribe", "place order",
    "send", "submit", "post", "publish", "confirm", "book now", "reserve", "delete",
    "remove", "cancel subscription", "deactivate", "close account", "transfer",
    "withdraw", "sign contract", "agree and", "accept and", "apply now",
]


def _web_click_or_type(sub, argv):
    """Click or type, refusing controls that read as a commitment unless explicitly armed.

    The label is read and the click is made in ONE evaluation. Reading the label in a first
    call and clicking in a second leaves a gap in which the page can re-render, and the
    thing checked stops being the thing pressed — the same reason the OS checks an action's
    guard and dispatches it inside a single turn of the app's event loop.

    Nothing here asks permission upstream and then proceeds: a refusal is the absence of a
    click, decided in the process holding the mouse.
    """
    if len(argv) < 2:
        die("usage: yos web %s <n> %s" % (sub, "<text>" if sub == "type" else ""))

    armed = "--armed" in argv
    argv = [a for a in argv if a != "--armed"]
    ref = argv[1]

    # The scan leaves its elements on the page as `window.__yantrik_elements`, so a click
    # refers to the element that was actually read rather than to a selector guessed from
    # its name. That list is 0-indexed and the printed refs are 1-based, so the ref is
    # decremented here — getting this wrong clicks the neighbour, which is the kind of
    # mistake that looks like the page changed under you.
    guard = """
      const label = ((e.getAttribute('aria-label') || e.innerText || e.value ||
                      e.getAttribute('title') || '') + '').toLowerCase().trim();
      const words = %s;
      if (!%s && label && words.some(w => label.includes(w)))
        return 'commit:' + label.slice(0, 80);
    """ % (json.dumps(COMMIT_WORDS), "true" if armed else "false")

    if sub == "click":
        out = _eval("(() => { const e = (window.__yantrik_elements||[])[%s-1]; if(!e) return 'gone';"
                    "%s e.scrollIntoView({block:'center'}); e.click(); return 'clicked'; })()"
                    % (ref, guard))
    else:
        text = " ".join(argv[2:])
        out = _eval("(() => { const e = (window.__yantrik_elements||[])[%s-1]; if(!e) return 'gone';"
                    "%s e.focus(); e.value = %s;"
                    "e.dispatchEvent(new Event('input',{bubbles:true}));"
                    "e.dispatchEvent(new Event('change',{bubbles:true})); return 'typed'; })()"
                    % (ref, guard, json.dumps(text)))

    if out == "gone":
        die("element %s is not on the page any more — take a fresh `yos web`" % ref)
    if out and out.startswith("commit:"):
        die("refused: element %s reads as a commitment (%r). Nothing was %s. This is the "
            "point at which a person decides — re-run with --armed only if that person has."
            % (ref, out[len("commit:"):], "clicked" if sub == "click" else "typed"))
    print("%s %s. The page may not have finished reacting; read it again to see." % (out, ref))


MODEL_DIR = "/opt/yantrik/models/whisper"
SINK = "yantrik_capture.monitor"


def cmd_listen(argv):
    """Transcribe what the machine is currently playing.

    A page's speech is only in the DOM when the video happens to be captioned. This
    route does not care: it records the audio the machine is actually playing and
    transcribes it, so an uncaptioned video reads the same as a captioned one. It hears
    whatever is making noise, not just the browser — there is no per-tab isolation here.
    """
    import shutil
    import subprocess
    import tempfile

    seconds = 30
    if argv:
        try:
            seconds = max(1, int(argv[0]))
        except ValueError:
            die("usage: yos web listen [seconds]")

    for binary in ("parec", "/opt/yantrik/bin/transcribe"):
        if not (shutil.which(binary) or os.path.exists(binary)):
            die("%s is not installed — audio capture is unavailable on this machine" % binary)
    if not os.path.isdir(MODEL_DIR):
        die("no speech model at %s — transcription is unavailable" % MODEL_DIR)

    # A silent recording is the common failure and it looks identical to a video with no
    # speech in it, so check the sink has a producer before spending the time.
    sinks = subprocess.run(["pactl", "list", "short", "sink-inputs"],
                           capture_output=True, text=True).stdout.strip()
    if not sinks:
        print("nothing is playing audio right now — this will record %ds of silence."
              % seconds)

    # A pre-roll advert transcribes exactly as cleanly as the video does, and the result
    # reads like the page's own content. The player knows the difference, so ask it, and
    # say so rather than handing back a confident transcript of an unrelated commercial.
    # Audio capture does not need a browser, so a browser that cannot be reached must not
    # take the transcription down with it — it only costs us the advert check.
    try:
        ad = _eval("""(() => {
          const p = document.querySelector('.html5-video-player');
          const v = document.querySelector('video');
          if (!p || !v) return '';
          const showing = p.classList.contains('ad-showing') ||
                          p.classList.contains('ad-interrupting') ||
                          !!document.querySelector('.ytp-ad-player-overlay, .ytp-ad-module .ytp-ad-text');
          return showing ? String(Math.round(v.duration || 0)) : '';
        })()""")
    except SystemExit:
        ad = ""

    raw = tempfile.NamedTemporaryFile(suffix=".f32", delete=False)
    raw.close()
    print("listening for %ds..." % seconds)
    # parec runs until killed, so it is timed rather than asked to stop.
    proc = subprocess.Popen(
        ["parec", "-d", SINK, "--format=float32le", "--rate=16000", "--channels=1",
         "--file-format=raw", raw.name],
        stdout=subprocess.DEVNULL, stderr=subprocess.PIPE)
    try:
        proc.wait(timeout=seconds)
    except subprocess.TimeoutExpired:
        proc.terminate()
        proc.wait()

    size = os.path.getsize(raw.name)
    if size < 4:
        os.unlink(raw.name)
        die("captured no audio — is %s a real sink? (pactl list short sinks)" % SINK)

    out = subprocess.run(["/opt/yantrik/bin/transcribe", "--timestamps",
                          "--model", MODEL_DIR, raw.name],
                         capture_output=True, text=True)
    os.unlink(raw.name)

    text = out.stdout.strip()
    if text:
        if ad:
            print("WARNING: an advertisement was playing (%ss long), not the video. What "
                  "follows is the advert's audio, not the page's content. Wait for it to "
                  "finish and listen again." % ad)
        print(text)
    else:
        # Distinguish "heard nothing" from "heard something and could not read it": the
        # first is a capture problem, the second is a model limit, and they need
        # different fixes.
        print("no speech found in %ds of audio." % seconds)
        print("(%s)" % (out.stderr.strip().splitlines() or ["no detail"])[-1])


# ── yos check: does a surface keep the protocol ──
#
# The checker an author runs against their own surface, and `release-check` can run against
# every surface on a machine: docs/surface-protocol.md, read by a program. It prints what it saw
# for each check, exits non-zero when any check fails, and says it as JSON with `--json`.
#
# It never runs an action. Every `app.act` it sends is one the protocol's dispatch refuses before
# a handler is reached — an empty or unknown action, a missing or undeclared argument, a stale
# `expect_revision` — and even those are sent only to a surface that has shown it runs the
# protocol's dispatch: it publishes `protocol: 1` AND refused the unknown action exactly as that
# dispatch does. The action a probe names is graded `safe` or `standard` and does not say it
# cannot be undone, and every probe also carries a stale `expect_revision`, so a surface that
# skipped an argument check is still stopped by its revision guard before its handler runs. A
# surface that implements neither could run a `safe` or `standard` handler with placeholder
# arguments — which is why the gate on sending those probes is a dispatch that has already
# answered like the protocol's.

PROTOCOL = 1
LADDER = ("safe", "standard", "sensitive", "dangerous")
# `yantrik_ipc_contracts::control_surface::PARAM_TYPES`: what a parameter may be declared as.
PARAM_TYPES = ("string", "number", "integer", "boolean", "array", "object")
# How long a describe may take before the checker says so. A describe reads a few properties on a
# UI thread; half a second is already a surface a mind waits on.
DESCRIBE_BUDGET = 0.5
DESCRIBE_READS = 3
# The shell's secret-name rule (`no_published_action_can_carry_a_passphrase` in
# crates/yantrik-ui/src/control_approvals.rs): the words a secret would arrive under, and the
# parameter that contains one of them and is not one. `args` is what an approval card draws and
# the audit log keeps, so a secret among them is shown to whoever reads either.
SECRET_WORDS = ("passphrase", "password", "passwd", "pin", "secret", "credential", "unlock")
SECRET_PERMITTED = ("pinned",)
# `gate::UNRECOVERABLE_PHRASES`. An action whose description says one of these is asked about in
# every mode but bypass, so the checker never names one in a probe.
UNRECOVERABLE_PHRASES = ("not recoverable", "cannot be undone", "can't be undone", "irreversible",
                         "permanently", "permanent", "no undo")
NO_SUCH_ACTION = "yos-check-no-such-action"
NO_SUCH_METHOD = "app.yos_check_no_such_method"
UNDECLARED = "yos_check_undeclared"
PLACEHOLDER = {"string": "yos-check", "number": 0, "integer": 0, "boolean": False,
               "array": [], "object": {}}
# One value of the wrong type for each declared type that no dispatch converts (a number for text
# and a numeric string for a number are converted, docs/surface-protocol.md §4), and how the
# dispatch names what arrived (`yantrik_surface::check_value`): the `types` probe sends one and
# expects that sentence.
MISTYPED = {"string": (True, "a boolean"), "number": ("yos-check", "a string"),
            "integer": ("yos-check", "a string"), "boolean": ("yos-check", "a string"),
            "array": ("yos-check", "a string"), "object": ("yos-check", "a string")}
WANTED = {"string": "a string", "number": "a number", "integer": "an integer",
          "boolean": "a boolean", "array": "an array", "object": "an object"}
WANTED_ITEMS = {"string": "strings", "number": "numbers", "integer": "integers",
                "boolean": "booleans", "array": "arrays", "object": "objects"}

