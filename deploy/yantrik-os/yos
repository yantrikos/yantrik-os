def _json_equal(a, b):
    """Equality the way JSON means it: `true` is not `1`."""
    if isinstance(a, bool) or isinstance(b, bool):
        return type(a) is type(b) and a == b
    return a == b


def _is_type(value, kind):
    if kind == "object":
        return isinstance(value, dict)
    if kind == "array":
        return isinstance(value, list)
    if kind == "string":
        return isinstance(value, str)
    if kind == "boolean":
        return isinstance(value, bool)
    if kind == "null":
        return value is None
    if isinstance(value, bool):
        return False
    if kind == "integer":
        return isinstance(value, int) or (isinstance(value, float) and value.is_integer())
    if kind == "number":
        return isinstance(value, (int, float))
    return False


def schema_errors(value, schema, root=None, at="$"):
    """What is wrong with `value` against a JSON Schema, as `path: problem` lines.

    The subset the protocol's schemas use — type, const, enum, required, properties,
    additionalProperties, items, pattern, minLength, uniqueItems and local `$ref` — because `yos`
    carries no dependencies. Annotation keywords are ignored, as the standard says they are.
    """
    root = schema if root is None else root
    if "$ref" in schema:
        node = root
        for part in schema["$ref"][2:].split("/"):
            node = node[part]
        return schema_errors(value, node, root, at)
    errors = []
    kinds = schema.get("type")
    if kinds is not None:
        kinds = kinds if isinstance(kinds, list) else [kinds]
        if not any(_is_type(value, k) for k in kinds):
            return ["%s: is %s, not %s" % (at, type(value).__name__, " or ".join(kinds))]
    if "const" in schema and not _json_equal(value, schema["const"]):
        errors.append("%s: is %s, must be %s" % (at, json.dumps(value), json.dumps(schema["const"])))
    if "enum" in schema and not any(_json_equal(value, e) for e in schema["enum"]):
        errors.append("%s: %s is not one of %s" % (at, json.dumps(value), json.dumps(schema["enum"])))
    if isinstance(value, str):
        if len(value) < schema.get("minLength", 0):
            errors.append("%s: is empty" % at)
        if "pattern" in schema and not re.search(schema["pattern"], value):
            errors.append("%s: %s does not match %s" % (at, json.dumps(value), schema["pattern"]))
    if isinstance(value, dict):
        for key in schema.get("required", []):
            if key not in value:
                errors.append("%s: `%s` is missing" % (at, key))
        properties = schema.get("properties", {})
        extra = schema.get("additionalProperties", True)
        for key, item in value.items():
            if key in properties:
                errors.extend(schema_errors(item, properties[key], root, "%s.%s" % (at, key)))
            elif extra is False:
                errors.append("%s: `%s` is not allowed" % (at, key))
            elif isinstance(extra, dict):
                errors.extend(schema_errors(item, extra, root, "%s.%s" % (at, key)))
    if isinstance(value, list):
        if "items" in schema:
            for i, item in enumerate(value):
                errors.extend(schema_errors(item, schema["items"], root, "%s[%d]" % (at, i)))
        if schema.get("uniqueItems"):
            seen = [json.dumps(v, sort_keys=True) for v in value]
            if len(set(seen)) != len(seen):
                errors.append("%s: has repeated items" % at)
    return errors


def revision_of(summary, state):
    """`View::revision()`: FNV-1a 64 over the summary, a zero byte, and the state rendered compact
    with sorted keys and UTF-8 kept raw. docs/surface-protocol.md has the vectors."""
    h = 0xCBF29CE484222325
    rendered = json.dumps(state, sort_keys=True, separators=(",", ":"), ensure_ascii=False)
    for byte in summary.encode("utf-8") + b"\x00" + rendered.encode("utf-8"):
        h = ((h ^ byte) * 0x100000001B3) & 0xFFFFFFFFFFFFFFFF
    return "%016x" % h


def _has_float(value):
    if isinstance(value, float):
        return True
    if isinstance(value, dict):
        return any(_has_float(v) for v in value.values())
    if isinstance(value, list):
        return any(_has_float(v) for v in value)
    return False


def rpc(path, method, params=None, timeout=10, request_id=1):
    """One JSON-RPC line to `path` and the whole reply object back, error or not, with how long
    it took. Unlike `request`, a refusal is an answer here: the checker reads its code and words."""
    started = time.monotonic()
    s = open_socket(path, timeout)
    try:
        line = {"jsonrpc": "2.0", "id": request_id, "method": method}
        if params is not None:
            line["params"] = params
        s.sendall((json.dumps(line) + "\n").encode())
        buf = b""
        while not buf.endswith(b"\n"):
            chunk = s.recv(1 << 20)
            if not chunk:
                break
            buf += chunk
    finally:
        s.close()
    if not buf:
        raise Unreachable("%s closed the connection without answering %s" % (path, method))
    return json.loads(buf), time.monotonic() - started


def unrecoverable(purpose):
    lower = (purpose or "").lower()
    return any(phrase in lower for phrase in UNRECOVERABLE_PHRASES)


def _stale(revision):
    """A revision guaranteed not to be the current one: every hex digit flipped."""
    if isinstance(revision, str) and re.fullmatch(r"[0-9a-f]{16}", revision):
        return "".join("%x" % (15 - int(c, 16)) for c in revision)
    return "0123456789abcdef"


class Report:
    """The rows one surface's check produced, and how they print."""

    def __init__(self, surface, path):
        self.surface, self.path, self.rows = surface, path, []

    def add(self, check, status, saw):
        self.rows.append({"check": check, "status": status, "saw": saw})

    def failed(self):
        return any(r["status"] == "fail" for r in self.rows)

    def as_json(self):
        return {"surface": self.surface, "socket": self.path, "ok": not self.failed(),
                "checks": self.rows}

    def print(self):
        print("yos check %s  (%s)" % (self.surface, self.path))
        for r in self.rows:
            lines = str(r["saw"]).splitlines() or [""]
            print("  %-5s %-11s %s" % (r["status"], r["check"], lines[0]))
            for more in lines[1:]:
                print("  %-5s %-11s %s" % ("", "", more))
        counts = {s: sum(1 for r in self.rows if r["status"] == s)
                  for s in ("fail", "warn", "pass", "skip")}
        print("  %d failed, %d warned, %d passed, %d skipped"
              % (counts["fail"], counts["warn"], counts["pass"], counts["skip"]))


def _refusal(reply):
    """`(code, message)` of a JSON-RPC error, or None when the reply is not one."""
    error = reply.get("error") if isinstance(reply, dict) else None
    if not isinstance(error, dict):
        return None
    return error.get("code"), error.get("message")


def _expect_refusal(report, check, reply, code, sentence, what):
    """One refusal probe: the code and the exact words, or a failure saying which differed."""
    got = _refusal(reply)
    if got is None:
        report.add(check, "fail", "%s was not refused: it answered %s"
                   % (what, json.dumps(reply.get("result"))[:200]))
        return False
    got_code, got_message = got
    if got_code == code and got_message == sentence:
        report.add(check, "pass", "%s → %s %s" % (what, got_code, got_message))
        return True
    report.add(check, "fail", "%s → %s %s\nthe protocol says: %s %s"
               % (what, got_code, got_message, code, sentence))
    return False


def _probe(report, path, action, args, stale):
    """`app.act` a probe that a protocol dispatch refuses before any handler, carrying a stale
    `expect_revision` besides. Returns the reply, or records the failure and returns None."""
    try:
        reply, _ = rpc(path, "app.act", {"action": action, "args": args, "expect_revision": stale})
    except (OSError, ValueError, Unreachable) as e:
        report.add("refusals", "fail", "app.act %s did not answer: %s" % (action, e))
        return None
    return reply


def _gated(reply):
    """The gate's refusal, if that is what came back instead of the one a probe was after."""
    got = _refusal(reply)
    if got and isinstance(got[1], str) and got[1].split(":", 1)[0] in ("CEILING", "GRANT"):
        return got[1]
    return None


def check_surface(path, label, services_too=False):
    """Every check, against one socket. Returns the Report.

    `services_too`: a socket that answers but has no `app.describe` (-32601) is a service rather
    than a surface, and is skipped instead of failed — for `--all`, which meets both."""
    report = Report(label, path)

    # rpc.ping: the transport answers it before any handler, and echoes the id it was sent.
    try:
        reply, took = rpc(path, "rpc.ping", request_id=7)
    except (OSError, ValueError, Unreachable) as e:
        report.add("reachable", "fail", str(e))
        return report
    if reply.get("result") == "pong" and reply.get("id") == 7 and reply.get("jsonrpc") == "2.0":
        report.add("ping", "pass", 'rpc.ping answered "pong" with the id it was sent (%.1f ms)'
                   % (took * 1000))
    else:
        report.add("ping", "fail", "rpc.ping answered %s" % json.dumps(reply)[:300])

    # describe, a few times: the envelope, how long it takes, and whether the revision is steady.
    views, times = [], []
    for _ in range(DESCRIBE_READS):
        try:
            reply, took = rpc(path, "app.describe", {})
        except (OSError, ValueError, Unreachable) as e:
            report.add("describe", "fail", "app.describe did not answer: %s" % e)
            return report
        if services_too and no_describe(reply):
            # Not every service says so with -32601 (the companion's socket answers -32602, the
            # harness host -32000); what they all say is that the method is unknown.
            report.add("describe", "skip", "answers, but has no app.describe — a service, not a "
                       "surface")
            return report
        if _refusal(reply) or not isinstance(reply.get("result"), dict):
            report.add("describe", "fail", "app.describe answered %s — not a surface"
                       % json.dumps(reply)[:300])
            return report
        views.append(reply["result"])
        times.append(took)
    view = views[-1]
    median = statistics.median(times)
    shown = ", ".join("%.1f" % (t * 1000) for t in times)
    report.add("describe", "pass" if median <= DESCRIBE_BUDGET else "warn",
               "answered in %.1f ms, the median of %d reads (%s ms)%s" % (
                   median * 1000, len(times), shown,
                   "" if median <= DESCRIBE_BUDGET else
                   " — over the %d ms a caller should wait for a read" % (DESCRIBE_BUDGET * 1000)))

    protocol = view.get("protocol")
    if protocol == PROTOCOL and not isinstance(protocol, bool):
        report.add("protocol", "pass", "protocol %d" % PROTOCOL)
    elif protocol is None:
        report.add("protocol", "fail", "no `protocol` in describe: a surface from before the "
                   "protocol was written down (docs/surface-protocol.md adds `protocol: 1`)")
    else:
        report.add("protocol", "warn", "protocol %s; this yos knows %d" % (json.dumps(protocol),
                                                                          PROTOCOL))

    errors = schema_errors(view, DESCRIBE_SCHEMA)
    report.add("schema", "fail" if errors else "pass",
               "\n".join(errors[:12] + (["… and %d more" % (len(errors) - 12)]
                                        if len(errors) > 12 else []))
               if errors else "describe matches docs/schema/describe.schema.json")

    actions = [a for a in (view.get("actions") or []) if isinstance(a, dict)]
    grades = [(a.get("name"), a.get("permission")) for a in actions]
    off = ["%s is graded %s" % (n, json.dumps(g)) for n, g in grades if g not in LADDER]
    tally = ", ".join("%d %s" % (sum(1 for _, g in grades if g == level), level)
                      for level in LADDER if any(g == level for _, g in grades))
    report.add("grades", "fail" if off else "pass",
               "\n".join(off) if off else "%d action%s: %s" % (
                   len(actions), "" if len(actions) == 1 else "s", tally or "none"))

    bad_params, secrets, counted = [], [], 0
    for a in actions:
        params = a.get("parameters") if isinstance(a.get("parameters"), dict) else {}
        props = params.get("properties") if isinstance(params.get("properties"), dict) else {}
        for name, spec in props.items():
            counted += 1
            kind = (spec or {}).get("type") if isinstance(spec, dict) else None
            if kind not in PARAM_TYPES:
                bad_params.append("%s(%s) is typed %s" % (a.get("name"), name, json.dumps(kind)))
            elif kind == "array" and isinstance(spec.get("items"), dict) \
                    and spec["items"].get("type") not in PARAM_TYPES:
                bad_params.append("%s(%s) is an array of %s" % (a.get("name"), name,
                                                              json.dumps(spec["items"].get("type"))))
            lower = name.lower()
            if any(w in lower for w in SECRET_WORDS) and name not in SECRET_PERMITTED:
                secrets.append("%s(%s)" % (a.get("name"), name))
        for name in params.get("required") or []:
            if name not in props:
                bad_params.append("%s requires `%s`, which it does not declare"
                                  % (a.get("name"), name))
    report.add("params", "fail" if bad_params else "pass",
               "\n".join(bad_params) if bad_params else
               "%d parameter%s, each typed %s" % (counted, "" if counted == 1 else "s",
                                                  " | ".join(PARAM_TYPES)))
    report.add("secrets", "fail" if secrets else "pass",
               ("named like a secret: %s — args are what an approval card draws and the audit log "
                "keeps, so a secret among them is shown to whoever reads either"
                % ", ".join(secrets)) if secrets else
               "no parameter named like a secret (%s)" % ", ".join(SECRET_WORDS))

    # The revision: computed as the protocol says, and steady while the view is.
    summary, state = view.get("summary"), view.get("state")
    if isinstance(summary, str) and isinstance(view.get("revision"), str):
        mine = revision_of(summary, state)
        if mine == view["revision"]:
            report.add("revision", "pass", "%s is FNV-1a over the summary and the state"
                       % view["revision"])
        elif _has_float(state):
            report.add("revision", "warn", "published %s, computed %s — the state carries a float, "
                       "and a float's rendering is where ports differ (the vectors' "
                       "`revision_float_edges`)" % (view["revision"], mine))
        else:
            report.add("revision", "fail", "published %s, but FNV-1a over the summary and the "
                       "state is %s" % (view["revision"], mine))
    same = [(a, b) for a, b in zip(views, views[1:])
            if a.get("summary") == b.get("summary") and a.get("state") == b.get("state")]
    if not same:
        report.add("steady", "skip", "the view changed between every read (live data), so "
                   "whether an unchanged view keeps its revision could not be seen")
    elif all(a.get("revision") == b.get("revision") for a, b in same):
        report.add("steady", "pass", "%d reads of an unchanged view, one revision"
                   % (len(same) + 1))
    else:
        report.add("steady", "fail", "the same summary and state came back under different "
                   "revisions: %s" % ", ".join(v.get("revision", "?") for v in views))

    # Refusals. None of these names anything a handler runs for.
    stale = _stale(view.get("revision"))
    try:
        reply, _ = rpc(path, NO_SUCH_METHOD, {})
        got = _refusal(reply)
        if got and got[0] == -32601:
            report.add("method", "pass", "%s → -32601 %s" % (NO_SUCH_METHOD, got[1]))
        else:
            report.add("method", "fail", "%s → %s; the protocol says -32601"
                       % (NO_SUCH_METHOD, json.dumps(reply)[:200]))
        reply, _ = rpc(path, "app.act", {"args": {}})
        _expect_refusal(report, "empty", reply, -32602, "act needs a non-empty `action`",
                        "app.act with no action")
    except (OSError, ValueError, Unreachable) as e:
        report.add("refusals", "fail", "did not answer: %s" % e)
        return report

    names = [a.get("name") for a in actions]
    reply = _probe(report, path, NO_SUCH_ACTION, {}, stale)
    if reply is None:
        return report
    protocol_dispatch = _expect_refusal(
        report, "unknown", reply, -32602,
        "unknown action `%s`; this app offers: %s" % (NO_SUCH_ACTION, ", ".join(names)),
        "unknown action")

    if not (protocol == PROTOCOL and protocol_dispatch):
        why = ("it does not publish protocol 1" if protocol != PROTOCOL else
               "its unknown-action refusal is not the protocol dispatch's")
        for check in ("missing", "undeclared", "types", "stale"):
            report.add(check, "skip", "not probed: %s, so nothing promises it refuses before a "
                       "handler runs" % why)
        return report

    ceiling = _machine_ceiling()
    eligible = [a for a in actions
                if a.get("permission") in ("safe", "standard")
                and LADDER.index(a["permission"]) <= LADDER.index(ceiling)
                and not unrecoverable(a.get("description"))]
    eligible.sort(key=lambda a: LADDER.index(a["permission"]))  # safe first
    if not eligible:
        for check in ("missing", "undeclared", "types", "stale"):
            report.add(check, "skip", "no action graded safe or standard (within this machine's "
                       "%s ceiling) that can be undone; yos check names nothing else" % ceiling)
        return report

    def declared(a):
        params = a.get("parameters") or {}
        return list((params.get("properties") or {}).keys()), list(params.get("required") or [])

    def placeholder(spec):
        spec = spec if isinstance(spec, dict) else {}
        if "default" in spec:
            return spec["default"]
        if spec.get("enum"):
            return spec["enum"][0]
        return PLACEHOLDER.get(spec.get("type"), "yos-check")

    def placeholders(a):
        props = (a.get("parameters") or {}).get("properties") or {}
        return {n: placeholder(props.get(n)) for n in declared(a)[1]}

    def gated(check, reply):
        why = _gated(reply)
        if why:
            report.add(check, "skip", "the gate answered first, as it should: %s" % why[:160])
        return bool(why)

    needing = [a for a in eligible if declared(a)[1]]
    if needing:
        a = needing[0]
        reply = _probe(report, path, a["name"], {}, stale)
        if reply is not None and not gated("missing", reply):
            _expect_refusal(report, "missing", reply, -32602,
                            "`%s` needs argument `%s`" % (a["name"], declared(a)[1][0]),
                            "%s with no arguments" % a["name"])
    else:
        report.add("missing", "skip", "no eligible action requires an argument")

    a = eligible[0]
    args = dict(placeholders(a), **{UNDECLARED: "yos-check"})
    reply = _probe(report, path, a["name"], args, stale)
    if reply is not None and not gated("undeclared", reply):
        props = declared(a)[0]
        got = _refusal(reply)
        if props:
            prefix = "`%s` has no argument `%s`; it takes: " % (a["name"], UNDECLARED)
            ok = (got and got[0] == -32602 and isinstance(got[1], str) and got[1].startswith(prefix)
                  and sorted(got[1][len(prefix):].split(", ")) == sorted(props))
            want = prefix + ", ".join(props)
        else:
            want = "`%s` takes no arguments, but `%s` was given" % (a["name"], UNDECLARED)
            ok = got == (-32602, want)
        if ok:
            report.add("undeclared", "pass", "%s with `%s` → -32602 %s"
                       % (a["name"], UNDECLARED, got[1]))
        else:
            report.add("undeclared", "fail", "%s with `%s` → %s\nthe protocol says: -32602 %s"
                       % (a["name"], UNDECLARED, json.dumps(got or reply.get("result"))[:300], want))

    # One argument of the wrong type, the rest as the action wants them.
    typed = next(((x, n, s) for x in eligible
                  for n, s in sorted(((x.get("parameters") or {}).get("properties") or {}).items())
                  if isinstance(s, dict) and s.get("type") in MISTYPED), None)
    if typed is None:
        report.add("types", "skip", "no eligible action declares an argument")
    else:
        x, name, spec = typed
        value, arrived = MISTYPED[spec["type"]]
        wanted = WANTED[spec["type"]]
        if spec["type"] == "array" and (spec.get("items") or {}).get("type") in WANTED_ITEMS:
            wanted = "an array of " + WANTED_ITEMS[spec["items"]["type"]]
        reply = _probe(report, path, x["name"], dict(placeholders(x), **{name: value}), stale)
        if reply is not None and not gated("types", reply):
            want = "`%s` argument `%s` must be %s, and %s arrived" % (x["name"], name, wanted, arrived)
            got = _refusal(reply)
            if got == (-32602, want):
                report.add("types", "pass", "%s with %s=%s → -32602 %s"
                           % (x["name"], name, json.dumps(value), want))
            elif got and got[0] == -32602 and str(got[1]).startswith("STALE:"):
                report.add("types", "warn", "%s with %s=%s was not refused for its type; the "
                           "revision guard stopped it instead. Checking types is a protocol-1 "
                           "addition (docs/surface-protocol.md §5, step 7)"
                           % (x["name"], name, json.dumps(value)))
            else:
                report.add("types", "fail", "%s with %s=%s → %s\nthe protocol says: -32602 %s"
                           % (x["name"], name, json.dumps(value),
                              json.dumps(got or reply.get("result"))[:300], want))

    reply = _probe(report, path, a["name"], placeholders(a), stale)
    if reply is not None and not gated("stale", reply):
        got = _refusal(reply)
        pattern = (r"STALE: this app is at revision ([0-9a-f]{16}) and you acted on %s\. "
                   r"It now reports: (.*)\. Read it again before deciding\." % stale)
        matched = got and got[0] == -32602 and isinstance(got[1], str) and \
            re.fullmatch(pattern, got[1], re.DOTALL)
        if matched:
            report.add("stale", "pass", "%s acting on %s → -32602 %s"
                       % (a["name"], stale, got[1][:200]))
        else:
            report.add("stale", "fail", "%s acting on %s → %s\nthe protocol says: -32602 STALE: "
                       "this app is at revision <current> and you acted on %s. It now reports: "
                       "<summary>. Read it again before deciding."
                       % (a["name"], stale, json.dumps(got or reply.get("result"))[:300], stale))
    return report


def _machine_ceiling():
    """`tool_permission` as every dispatch reads it (`gate::ceiling_from`), for choosing probes
    the ceiling will not refuse first."""
    path = os.path.join(os.path.expanduser("~"), ".config", "yantrik", "settings.yaml")
    try:
        with open(path, encoding="utf-8") as f:
            for line in f:
                key, _, value = line.partition(":")
                if key.strip() == "tool_permission":
                    value = value.strip().strip("\"'")
                    return value if value in LADDER else "sensitive"
    except OSError:
        pass
    return "sensitive"


def _every_surface():
    """Every socket in the chain that answers, once each (another name's symlink is skipped)."""
    found = []
    for directory in SOCKET_DIRS:
        try:
            entries = sorted(os.listdir(directory))
        except OSError:
            continue
        for entry in entries:
            path = os.path.join(directory, entry)
            if entry.endswith(".sock") and not os.path.islink(path) and _answers(path):
                found.append((entry[:-5], path))
    return found


def cmd_check(argv):
    as_json = "--json" in argv
    every = "--all" in argv
    names = [a for a in argv if a not in ("--json", "--all")]
    if not names and not every:
        die("usage: yos check <surface|path.sock> [...] [--json]   or   yos check --all [--json]")

    targets = []
    for name in names:
        if os.sep in name or name.endswith(".sock"):
            targets.append((name, name))
            continue
        live = [p for p in socket_candidates(name) if _answers(p)]
        targets.append((name, live[0] if live else None))
    if every:
        targets.extend((n, p) for n, p in _every_surface()
                       if not any(p == q for _, q in targets))

    reports = []
    for label, path in targets:
        if path is None:
            report = Report(label, None)
            report.add("reachable", "fail", "nothing answers as %r (try: yos ls)" % label)
        else:
            report = check_surface(path, label, services_too=every and label not in names)
        reports.append(report)

    if as_json:
        print(json.dumps({"ok": not any(r.failed() for r in reports),
                          "surfaces": [r.as_json() for r in reports]}, indent=2))
    else:
        for i, report in enumerate(reports):
            if i:
                print()
            report.print()
    if any(r.failed() for r in reports):
        raise SystemExit(1)


# ── The screen, as one reading (#257, step 1) ──
#
# A mind asking "what is on the screen" had to know which of four readers to use for each
# window — describe for ours, the accessibility service for a foreign one, the page scan for the
# browser — and call them one by one. Or it asked for a screenshot, which is thousands of vision
# tokens to learn that a window says "Ready". This is one call over the readers that exist, in
# that order, and it builds nothing new underneath them.
#
# Every id it prints works where it says: an app's actions with `yos act <app> <action>`, a
# page's numbers with `yos web click <n>`, an accessibility element's `a11y:` id with the
# accessibility service's `a11y.act`. It reaches only what the caller could already reach. A
# mind at the mind door has no accessibility socket, so a foreign window is reported to it as
# unreadable from here, not quietly left out: each source publishes its own blindness.

SCENE_ACTIONS = 10      # actions named per app, then "+N more"
SCENE_ELEMENTS = 25     # accessibility elements per foreign window
SCENE_WEB_LINES = 25    # lines of the page scan
SCENE_WAIT = 5          # seconds any one reader is given


def _flat(text, cap=160):
    """Text another program wrote, as one line of at most `cap` characters. A window title, a
    summary or a page title is the other program's to choose, and a newline in one would start a
    line of its own here — a fake "Waiting on the person:", or a fake app with fake actions."""
    text = " ".join(str(text or "").split())
    return text if len(text) <= cap else text[:cap - 3] + "..."


def _quietly(fn, *args, **kwargs):
    """(value, None), or (None, why) — a scene is a listing, and one unreadable window must not
    take the rest of the screen with it."""
    try:
        return fn(*args, **kwargs), None
    except Unreachable as e:
        return None, plain(e)
    except SystemExit:
        return None, "it did not answer"
    except (OSError, ValueError, KeyError, TypeError) as e:
        return None, str(e) or type(e).__name__


def scene_actions(actions, limit=SCENE_ACTIONS):
    """An app's actions as call shapes — `refresh()`, `set_location(city)` — required arguments
    only, which is enough to notice an action exists; `yos describe` has the rest."""
    shapes = []
    for a in actions:
        params = a.get("parameters") or {}
        required = set(params.get("required") or [])
        names = [n for n in (params.get("properties") or {}) if n in required]
        shapes.append("%s(%s)" % (a.get("name", "?"), ", ".join(names)))
    more = len(shapes) - limit
    return ", ".join(shapes[:limit]) + (", +%d more" % more if more > 0 else "")


def scene_app(name, indent="    "):
    """Our own app, from its describe: its summary and what it can be asked to do."""
    view, why = _quietly(request, name, "app.describe", timeout=SCENE_WAIT, waited=True)
    if view is None:
        return ["%snot readable: %s" % (indent, why)]
    lines = ["%s%s" % (indent, _flat(view.get("summary") or "(no summary)", 240))]
    if view.get("actions"):
        lines.append("%sact: %s" % (indent, scene_actions(view["actions"])))
    return lines


# What a browser window's app id can be. The desktop's own launcher names it `browser`; the
# compositor names a Chromium it did not start by what Chromium declares.
BROWSER_APPS = {"browser", "chromium", "chromium-browser", "google-chrome", "google-chrome-stable",
                "chrome"}

# Roles that are the window's scaffolding: the frame repeats the title, and a panel with nothing
# to do is layout.
SCAFFOLDING = {"frame", "panel", "filler", "section", "grouping", "tool bar", "menu bar"}


def _element_name(element):
    """An element's name as a person would read it. Chromium names a container by U+FFFC, the
    object replacement character, once per child: `￼￼￼￼` says there are four things inside and
    nothing about them."""
    return _flat((element.get("name") or element.get("text") or "").replace("￼", ""), 80)


def _element_actions(element):
    """What it can be asked to do, without the empty names Chromium publishes beside real ones."""
    return [_flat(a, 30) for a in element.get("actions") or [] if str(a).strip()]


def worth_listing(element):
    """Whether an element says anything: a name or something it can do, and not only scaffolding."""
    name, actions = _element_name(element), _element_actions(element)
    if not name and not actions:
        return False
    return bool(actions) or (element.get("role") or "") not in SCAFFOLDING


def scene_element(element):
    """One accessibility element: its id, role, name and what it can be asked to do."""
    name = _element_name(element)
    parts = ["a11y:%s" % _flat(element.get("id", "?"), 16)]
    if element.get("role"):
        parts.append(_flat(element["role"], 30))
    if name:
        parts.append(json.dumps(name, ensure_ascii=False))
    actions = _element_actions(element)
    if actions:
        parts.append("[%s]" % ", ".join(actions))
    return " ".join(parts)


def scene_elements(elements, limit=SCENE_ELEMENTS, indent="    "):
    """A foreign window's elements, capped, without the label twin some toolkits publish under
    every button: Slint puts the button, then its text again as a separate node with the same
    name and nothing to do. The second says nothing the first did not."""
    kept, last_actionable = [], None
    for e in elements:
        if not worth_listing(e):
            continue
        name = _element_name(e)
        acts = _element_actions(e)
        if not acts and last_actionable is not None and name == last_actionable:
            last_actionable = None
            continue
        last_actionable = name if acts else None
        kept.append(e)
    lines = [indent + scene_element(e) for e in kept[:limit]]
    if len(kept) > limit:
        lines.append("%s(+%d more elements)" % (indent, len(kept) - limit))
    return lines


class Accessibility:
    """The accessibility service as a scene reads it: whether this caller can reach it at all,
    and the foreign windows it knows."""

    def __init__(self):
        self.windows, self.blind = [], None
        if not socket_candidates("a11y"):
            self.blind = ("the accessibility service is not reachable from here, so a window that "
                          "is not one of ours cannot be read by this caller")
            return
        status, why = _quietly(request, "a11y", "a11y.status", timeout=SCENE_WAIT)
        if status is None or not status.get("available"):
            self.blind = "there is no accessibility bus in this session (%s)" % (
                why or (status or {}).get("note") or "it says it is unavailable")
            return
        listing, why = _quietly(request, "a11y", "a11y.windows", timeout=SCENE_WAIT)
        if listing is None:
            self.blind = "the accessibility service did not list its windows: %s" % why
            return
        self.windows = [w for w in listing.get("windows") or [] if isinstance(w, dict)]

    def windows_titled(self, title):
        return [w for w in self.windows if w.get("title") == title]

    def read(self, title, indent="    "):
        """The elements of the foreign window called `title`, or why they cannot be had."""
        if self.blind:
            return ["%snot readable: %s" % (indent, self.blind)]
        titled = self.windows_titled(title)
        if not titled:
            return ["%sno accessibility tree: the app publishes none (a terminal, a game, a canvas "
                    "or an X11 app without a bridge). Its text can be read from the pixels: "
                    "act shell read_screen (it asks the person first)." % indent]
        # The compositor names a window by its title and nothing else, so two windows with the
        # same title cannot be told apart from here. Said, rather than read as if they were one.
        note = ([] if len(titled) == 1 else
                ["%s(%d windows share this title; this is the first of them)" % (indent, len(titled))])
        described, why = _quietly(request, "a11y", "a11y.describe", {"window": titled[0]["id"]},
                                  timeout=10)
        if described is None:
            return note + ["%snot readable: %s" % (indent, why)]
        elements = described.get("elements") or []
        if not elements:
            return note + ["%sits accessibility tree names nothing a person would mention" % indent]
        return note + scene_elements(elements, indent=indent)


def with_token(params):
    """An act's params with the agent token this was started with, beside the arguments as `yos
    act` sends it: a mind reaching an app at the door is refused without one."""
    token, _ = take_agent_token([])
    if token:
        params = dict(params, agent_token=token)
    return params


def scene_web(indent="    "):
    """The browser's page, through its surface: title, address, and what can be done on it."""
    try:
        page = request("browser", "app.act", with_token({"action": "read", "args": {}}),
                       timeout=15).get("result")
    except Unreachable as e:
        return ["%snot readable: %s" % (indent, plain(e))]
    if not isinstance(page, dict) or "elements" not in page:
        return ["%snot readable: the browser answered with no page" % indent]
    rows = render_page(page).splitlines()
    lines = [indent + r for r in rows[:SCENE_WEB_LINES]]
    if len(rows) > SCENE_WEB_LINES:
        lines.append("%s(+%d more lines: yos web, or act browser read)" % (indent, len(rows) - SCENE_WEB_LINES))
    return lines


def scene_surface(app):
    """The surface a window's app answers on, when it is one of ours with a socket here."""
    for path in socket_candidates(app):
        name = os.path.basename(path)[:-len(".sock")]
        if name.startswith("app-"):
            return name
    return None


def _plural(n, word):
    return "%d %s%s" % (n, word, "" if n == 1 else "s")


def scene(desktop, accessibility=None):
    """The whole screen as lines of text, from `describe shell`."""
    state = desktop.get("state") or {}
    if state.get("locked"):
        return ["The screen is locked. Nothing on it can be read until the person unlocks it."]
    windows = [w for w in state.get("windows") or [] if isinstance(w, dict)]
    in_front = state.get("in_front")
    desktop_in_front = state.get("desktop_in_front")
    clock = state.get("clock") if isinstance(state.get("clock"), dict) else {}
    head = ("Screen at %s %s. " % (clock.get("weekday", ""), clock["time"])).replace("  ", " ")         if clock.get("time") else "Screen. "
    if desktop_in_front is True:
        head += "In front: the desktop itself (its %s screen)." % _flat(state.get("screen") or "desktop", 30)
    elif in_front:
        head += "In front: %s." % json.dumps(_flat(in_front, 100), ensure_ascii=False)
    else:
        head += "Which window is in front is not knowable right now."
    lines = [head]

    waiting = state.get("pending_approvals") or []
    questions = state.get("pending_questions") or []
    if waiting or questions:
        lines.append("Waiting on the person: %s." % " and ".join(filter(None, [
            _plural(len(waiting), "approval card") if waiting else "",
            _plural(len(questions), "question") if questions else ""])))

    view = state.get("mind_view") if isinstance(state.get("mind_view"), dict) else {}
    surfaces = {w.get("app"): scene_surface(w.get("app") or "") for w in windows}
    if accessibility is None and any(
            not surfaces.get(w.get("app")) and w.get("app") != "mind-view"
            and w.get("app") not in BROWSER_APPS
            for w in windows):
        accessibility = Accessibility()

    lines += ["", "On the person's desktop, %s:" % _plural(len(windows), "window")]
    if not windows:
        lines.append("  (none — the desktop itself is all there is)")
    for w in windows:
        app, title = w.get("app") or "?", w.get("title") or "?"
        mark = "  (in front)" if in_front and in_front == title and desktop_in_front is not True else ""
        if app == "mind-view":
            inside = _flat(", ".join(a for a in view.get("apps") or [] if isinstance(a, str))) or "nothing yet"
            lines.append("- Mind View%s — the minds' own display, holding: %s" % (mark, inside))
        elif app in BROWSER_APPS:
            lines.append("- [browser] %s%s" % (json.dumps(_flat(title, 100), ensure_ascii=False), mark))
            lines.extend(scene_web())
        elif surfaces.get(app):
            lines.append("- [%s] %s%s" % (_flat(app, 40), _flat(title, 100), mark))
            lines.extend(scene_app(surfaces[app]))
        else:
            lines.append("- %s — %s, not one of ours%s" % (
                json.dumps(_flat(title, 100), ensure_ascii=False), _flat(app, 40), mark))
            lines.extend(accessibility.read(title))

    apps = [a for a in view.get("apps") or [] if isinstance(a, str)]
    if apps:
        lines += ["", "In Mind View, %s:" % _plural(len(apps), "app")]
        for app in apps:
            surface = scene_surface(app)
            lines.append("- [%s]" % _flat(app, 40))
            lines.extend(scene_app(surface) if surface
                         else ["    no surface this caller can reach; its text can be read from "
                               "the pixels: act shell read_mind_view"])
    elif view.get("unavailable"):
        lines += ["", "Mind View is not available: %s" % _flat(view["unavailable"], 200)]

    lines += ["", "To act: yos act <app> <action> on an [app]; yos web click <n> on a page's "
                  "numbers; a11y.act on the a11y service with an a11y: id."]
    return lines


def cmd_screen_text(argv):
    """`yos screen text [desktop|mind-view] [x,y,w,h]`: a display's text, read from its pixels.
    The person's desktop asks them first (the shell grades it `sensitive`); Mind View does not."""
    which = "desktop"
    region = None
    for arg in argv:
        if arg in ("desktop", "mind-view", "mind_view", "mindview"):
            which = "mind_view" if arg != "desktop" else "desktop"
        elif re.match(r"^\d+,\d+,\d+,\d+$", arg):
            region = arg
        else:
            die("usage: yos screen text [desktop|mind-view] [x,y,w,h]")
    action = "read_screen" if which == "desktop" else "read_mind_view"
    cmd_act(["shell", action] + (["region=%s" % region] if region else []))


def cmd_screen(argv):
    """`yos screen`: what is on the screen, as one reading. `yos screen text` reads a display's
    text from its pixels, for windows that publish nothing else."""
    if argv and argv[0] == "text":
        return cmd_screen_text(argv[1:])
    desktop, why = _quietly(request, "shell", "app.describe", timeout=10)
    if desktop is None:
        die("the desktop did not answer, so there is no screen to read: %s" % why)
    print("\n".join(scene(desktop)))


COMMANDS = {
    "ls": cmd_ls,
    "describe": cmd_describe,
    "check": cmd_check,
    "act": cmd_act,
    "perception": cmd_perception,
    "journal": cmd_journal,
    "notify": cmd_notify,
    "web": cmd_web,
    "screen": cmd_screen,
}


# ── Private mode ─────────────────────────────────────────────────────────────────────────────
#
# While the person has it on, no agent sees or does anything on this desktop. The sockets refuse
# an agent's token and the mind account themselves (`yantrik_ipc_transport::privacy`); this is for
# what they cannot tell apart — an agent's harness running as the person, reading describe with
# no token. The file and the sentence are the transport's: absent is off, anything but a clear
# `"private": false` is on.
PRIVACY_REFUSAL = ("PRIVATE: the person has turned on Private mode. Nothing on this desktop is shown "
                   "to agents or done for them until they turn it off. Nothing was run.")


def private_now():
    home = os.environ.get("HOME") or os.environ.get("USERPROFILE") or ""
    if not os.path.isabs(home):
        # Never "." (the transport's rule): an unknown home is taken to be private.
        try:
            import pwd
            home = pwd.getpwuid(os.getuid()).pw_dir
        except (ImportError, KeyError, OSError):
            return True
        if not os.path.isabs(home):
            return True
    try:
        with open(os.path.join(home, ".config", "yantrik", "privacy.json"), encoding="utf-8") as f:
            value = json.loads(f.read())
    except FileNotFoundError:
        return False
    except (OSError, ValueError, UnicodeDecodeError):
        return True
    flag = value.get("private", True) if isinstance(value, dict) else True
    return flag if isinstance(flag, bool) else True


def main():
    if len(sys.argv) < 2 or sys.argv[1] in ("-h", "--help", "help"):
        print(__doc__.strip())
        return
    # Run for an agent (a harness put its token here): nothing, while the person is private.
    agent = os.environ.get(AGENT_TOKEN_ENV, "").strip() or any(
        a == "--agent-token" or a.startswith("agent_token=") for a in sys.argv[2:])
    if agent and private_now():
        print(PRIVACY_REFUSAL)
        sys.exit(3)
    command = COMMANDS.get(sys.argv[1])
    if command is None:
        die("unknown command %r; try one of: %s" % (sys.argv[1], ", ".join(COMMANDS)))
    command(sys.argv[2:])


if __name__ == "__main__":
    main()
