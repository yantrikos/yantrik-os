.claude/
.mcp.json
.mcp.json.template

# Scripts (local-only by default)
#
# Most of scripts/ is probes and one-off deploy helpers that mean nothing outside this machine.
# The exceptions are the two renderers that PRODUCE things the OS ships: the wallpapers are
# generated art, and a generated asset whose generator is not in the repo is a binary somebody
# exported once and nobody can ever change.
scripts/*
!scripts/render-wallpapers.py
!scripts/render-scene-wallpapers.py
!scripts/render-wallpaper-previews.py
!scripts/render-window-buttons.py

# Python
__pycache__/
unsloth_compiled_cache/

# Cargo local config
.cargo/

# VM backup
.vm-backup/

# Brainstorm / MCP tool outputs
brainstorm_*.md
mcp__brainstorm__*.txt

# Compiler long-type diagnostics
lib.long-type-*.txt

# Large binaries
*.iso
*.gguf
*.png
# ...except the ones the desktop is made of. These are the shell's wallpapers and its icon
# theme: without them a fresh clone builds an OS whose desktop has no picture on it, which is
# not a smaller version of this project, it is a broken one. They are 60-270 KB each and they
# are reproducible from the scripts above, so they belong in the tree next to them.
!crates/yantrik-ui-slint/ui/wallpapers/*.png
!crates/yantrik-ui-slint/ui/wallpapers/previews/*.png
# ...and the titlebar buttons, for the same reason: generated, tiny, and the window has no
# close button without them.
!config/labwc/*.png

# Secrets
google_client_*
*.secret*

# Personal scripts (not part of the project)
create_*_epics.py
create_*_epic.py
migrate_*.py
reddit_post.png
skill_store_screenshot.png

# Test scripts (local-only)
test-*.sh
test_*.sh
test_*.py
# ...except the lints' own tests. They assert that named faults in the real tree are still
# caught, which is the only thing standing between a change to the lint and a lint that has
# quietly stopped seeing. The rule above kept them out of version control for a day.
!tests/app-lints/test_*.py
# ...but not the unit tests that ship with a harness plugin.
!harnesses/*/tests/test_*.py
# ...nor the suite shared by every attachable harness. It lives one level up, at
# harnesses/tests, because it covers harnesses/lib as well as pi and deepseek, and the pattern
# above misses it by exactly one directory — which would have left CI running a discover over
# four files git had never heard of, and passing.
!harnesses/tests/test_*.py
# ...nor the Blender control surface's tests. They are the shipped addon's test suite, not
# local-only scripts, and the same one-directory miss applies: CI runs a discover over
# tests/blender-core that would pass with the files it runs never committed.
!tests/blender-core/test_*.py
# ...nor the service-methods walk. CI runs a discover over tests/service-methods that would
# pass with the file it runs never committed, leaving the table in docs/app-control.md holding
# nothing: the walk that keeps every method a service answers listed beside its grade.
!tests/service-methods/test_*.py
# ...nor the Python surface SDK's conformance suite, which CI discovers the same way.
!sdk/python/tests/test_*.py
# ...nor the surface SDK's template, adapter and guide-sample suites (docs/sdk), which CI
# discovers the same way.
!templates/python-surface/tests/test_*.py
!adapters/libreoffice/tests/test_*.py
!docs/sdk/samples/test_*.py

# Brainstorm outputs
brainstorm_*.py

# Training artifacts
training/checkpoints*/
training/model_*/
training/unsloth_compiled_cache/

