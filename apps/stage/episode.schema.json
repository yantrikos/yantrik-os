{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://yantrikos.com/stage/episode.schema.json",
  "title": "Stage episode",
  "description": "The only file a Mind writes. The OS draws, voices, lights, films and cuts it. Everything except title, cast and scenes is optional.",
  "type": "object",
  "required": [
    "title",
    "scenes"
  ],
  "x-accessories": {
    "CLAUDE": [
      "glasses",
      "beret"
    ],
    "GPT": [
      "tie",
      "bowtie"
    ],
    "GEMINI": [
      "headphones",
      "cape"
    ],
    "GROK": [
      "shades",
      "chain"
    ]
  },
  "x-default-voice": {
    "CLAUDE": "claude",
    "GPT": "gpt",
    "GEMINI": "gemini",
    "GROK": "grok"
  },
  "additionalProperties": false,
  "properties": {
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "description": "Episode title, shown on the title card and used as the video file name."
    },
    "show": {
      "type": "string",
      "maxLength": 60,
      "default": "THE CLUSTER"
    },
    "cast": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "description": "Who is in the show. Leave it out to get all four stars with their own voices.",
      "items": {
        "$ref": "#/$defs/castMember"
      }
    },
    "music": {
      "$ref": "#/$defs/music"
    },
    "scenes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "$ref": "#/$defs/scene"
      }
    }
  },
  "$defs": {
    "castMember": {
      "type": "object",
      "required": [
        "name"
      ],
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "pattern": "^[A-Z][A-Z0-9_ ]{0,15}$",
          "description": "Short UPPERCASE name used as the speaker in lines."
        },
        "rig": {
          "enum": [
            "CLAUDE",
            "GPT",
            "GEMINI",
            "GROK"
          ],
          "description": "Which finished character to draw. Defaults to the one named like the cast member."
        },
        "voice": {
          "enum": [
            "claude",
            "gpt",
            "gemini",
            "grok"
          ],
          "description": "Which voice to speak with. Defaults to the rig's own voice."
        },
        "palette": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "main": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            },
            "accent": {
              "type": "string",
              "pattern": "^#[0-9a-fA-F]{6}$"
            }
          }
        },
        "accessory": {
          "type": "string",
          "description": "CLAUDE: glasses, beret. GPT: tie, bowtie. GEMINI: headphones, cape. GROK: shades, chain. Or none."
        }
      }
    },
    "music": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cue": {
          "enum": [
            "none",
            "cheeky",
            "calm",
            "tense",
            "triumphant"
          ],
          "default": "cheeky"
        },
        "volume": {
          "type": "number",
          "minimum": 0,
          "maximum": 1,
          "default": 0.5
        }
      }
    },
    "scene": {
      "type": "object",
      "required": [
        "lines"
      ],
      "additionalProperties": false,
      "properties": {
        "set": {
          "enum": [
            "server-room",
            "break-room",
            "rooftop"
          ],
          "default": "server-room"
        },
        "camera": {
          "enum": [
            "auto",
            "wide",
            "two-shot",
            "close-up",
            "push-in"
          ],
          "default": "auto",
          "description": "auto (the default) cuts between wide, two-shots, close-ups and a push-in on the last line by itself."
        },
        "transition": {
          "enum": [
            "cut",
            "fade",
            "wipe"
          ],
          "default": "fade",
          "description": "How this scene is entered."
        },
        "present": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Cast names on screen. Defaults to everyone in the cast."
        },
        "lines": {
          "type": "array",
          "minItems": 1,
          "maxItems": 24,
          "items": {
            "$ref": "#/$defs/line"
          }
        },
        "part": {
          "enum": [
            "cold-open",
            "main",
            "tag"
          ],
          "default": "main",
          "description": "cold-open plays before the title card, tag after the credits."
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propSet"
          },
          "description": "How props start this scene. They keep their state from the last scene in the same set."
        }
      }
    },
    "line": {
      "type": "object",
      "required": [
        "speaker",
        "text"
      ],
      "additionalProperties": false,
      "properties": {
        "speaker": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 240
        },
        "emotion": {
          "enum": [
            "neutral",
            "happy",
            "smug",
            "shocked",
            "angry",
            "sad",
            "confused",
            "laughing"
          ],
          "default": "neutral"
        },
        "pose": {
          "enum": [
            "idle",
            "talk-gesture",
            "point",
            "facepalm"
          ],
          "description": "Defaults to talk-gesture for the speaker, idle for everyone else."
        },
        "pause": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 0.25,
          "description": "Seconds of silence after the line."
        },
        "react": {
          "type": "object",
          "description": "Optional. How others feel while this line is spoken, e.g. {\"GROK\": \"smug\"}.",
          "additionalProperties": {
            "enum": [
              "neutral",
              "happy",
              "smug",
              "shocked",
              "angry",
              "sad",
              "confused",
              "laughing"
            ]
          }
        },
        "camera": {
          "anyOf": [
            {
              "enum": [
                "auto",
                "wide",
                "two-shot",
                "close-up",
                "push-in"
              ]
            },
            {
              "type": "string",
              "pattern": "^insert:[a-z-]+$"
            }
          ],
          "description": "Overrides the scene camera for this line. \"insert:alert-lamp\" cuts away to a close-up of that prop (it must belong to the scene set)."
        },
        "hold": {
          "type": "number",
          "minimum": 0,
          "maximum": 4,
          "default": 0,
          "description": "Seconds of silence BEFORE the line, a beat before a punchline."
        },
        "props": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/propSet"
          },
          "description": "Props that change as this line starts, like [{\"prop\":\"alert-lamp\",\"state\":\"steady\"}]."
        },
        "move": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          },
          "description": "Who walks where as this line starts: {\"GROK\":\"rack\"}. They stay there afterwards. Marks are listed in x-marks."
        },
        "sfx": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          ],
          "description": "Sound cue, one of x-sfx."
        },
        "laugh": {
          "type": "boolean",
          "default": false,
          "description": "A laugh track after this line."
        }
      }
    },
    "propSet": {
      "type": "object",
      "required": [
        "prop"
      ],
      "additionalProperties": false,
      "description": "Set a prop to a state and/or give it words. Props belong to a set (see x-props): each lists its own states.",
      "properties": {
        "prop": {
          "type": "string"
        },
        "state": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "maxLength": 28
        }
      }
    }
  },
  "x-marks": {
    "server-room": [
      "left",
      "center",
      "right",
      "home",
      "dashboard",
      "cables",
      "rack",
      "door"
    ],
    "break-room": [
      "left",
      "center",
      "right",
      "home",
      "window",
      "coffee",
      "vending"
    ],
    "rooftop": [
      "left",
      "center",
      "right",
      "home",
      "sign",
      "antenna",
      "edge"
    ]
  },
  "x-props": {
    "server-room": {
      "alert-lamp": {
        "states": [
          "blink",
          "steady",
          "off"
        ],
        "text": true
      },
      "dashboard": {
        "states": [
          "ok",
          "warn",
          "alarm"
        ],
        "text": true
      },
      "rack-doors": {
        "states": [
          "closed",
          "open"
        ],
        "text": false
      },
      "cable-mess": {
        "states": [
          "tangled",
          "pulled"
        ],
        "text": false
      }
    },
    "break-room": {
      "coffee-machine": {
        "states": [
          "idle",
          "brewing",
          "empty"
        ],
        "text": true
      },
      "vending-machine": {
        "states": [
          "idle",
          "stuck",
          "off"
        ],
        "text": true
      },
      "wall-clock": {
        "states": [
          "stopped",
          "ticking",
          "racing"
        ],
        "text": true
      }
    },
    "rooftop": {
      "antenna": {
        "states": [
          "blink",
          "steady",
          "off"
        ],
        "text": false
      },
      "neon-sign": {
        "states": [
          "on",
          "flicker",
          "off"
        ],
        "text": true
      },
      "string-lights": {
        "states": [
          "on",
          "flicker",
          "off"
        ],
        "text": false
      }
    }
  },
  "x-sfx": [
    "record-beep",
    "rimshot",
    "power-down",
    "alarm",
    "door",
    "typing",
    "coffee-pour",
    "crowd-gasp",
    "laugh"
  ]
}
