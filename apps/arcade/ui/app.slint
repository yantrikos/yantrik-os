import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AppIdentity } from "app_color.slint";
import { AppHeader } from "app_header.slint";
import { YButton } from "y_button.slint";
import { Icons } from "icon.slint";
import { ScrollView, TextEdit, LineEdit } from "std-widgets.slint";
export { ThemeMode, AccentPreset }

export struct GameRow { slug:string, title:string, detail:string, selected:bool }
export struct CharacterRow { slug:string, name:string, archetype:string, selected:bool }

export component ArcadeApp inherits AppWindow {
    // The header below is this window's title bar (#256).
    show-bar: false;
    title: "Arcade";
    preferred-width: 1020px;
    preferred-height: 680px;
    min-width: 660px;
    min-height: 440px;
    default-font-family: Theme.font-ui;
    background: Theme.bg-deep;
    init => { AppIdentity.id = "game"; }

    in property <[GameRow]> games;
    in property <[CharacterRow]> characters;
    in-out property <string> spec-text;
    in-out property <string> game-name;
    in property <string> status: "Reading the library…";
    in property <string> notice;
    in property <bool> busy;

    // One callback for every command, from the header or the buttons below:
    // the window and the control surface both arrive here and nowhere else.
    callback action(string);
    callback pick-game(string);
    callback pick-character(string);

    VerticalLayout {
        spacing: 0px;
        AppHeader {
            window-bar: true;
            app-id: "arcade";
            icon: Icons.media;
            title: "Arcade";
            subtitle: root.status;
            actions: [
                { id: "build", icon: Icons.refresh, label: "Build", disabled: root.busy },
                { id: "play", icon: Icons.play, label: "Play", emphasis: 2, disabled: root.busy },
                { id: "verify", icon: Icons.check, label: "Verify", disabled: root.busy },
                { id: "screenshot", icon: Icons.media, label: "Shot", disabled: root.busy },
                { id: "delete", icon: Icons.trash, label: "Delete", disabled: root.busy }
            ];
            action(id) => { root.action(id); }
        }

        if root.notice != "" : Rectangle {
            height: message.preferred-height + 20px;
            background: Theme.bg-elevated;
            message := Text {
                x: 20px; y: 10px; width: parent.width - 40px;
                text: root.notice; color: Theme.amber; font-size: 13px; wrap: word-wrap;
            }
        }

        HorizontalLayout {
            spacing: 0px;

            // ── The library ──────────────────────────────────────────
            Rectangle {
                width: 300px;
                background: Theme.bg-surface;
                VerticalLayout {
                    padding: 14px; spacing: 8px;
                    Text { text: "GAMES"; color: Theme.text-dim; font-size: 10px; font-weight: 600; letter-spacing: 1.6px; height: 18px; }
                    ScrollView {
                        vertical-stretch: 3;
                        VerticalLayout {
                            spacing: 4px; alignment: start;
                            for row in root.games: Rectangle {
                                height: 52px;
                                border-radius: 6px;
                                background: row.selected ? Theme.bg-selected : transparent;
                                VerticalLayout {
                                    padding-left: 10px; padding-right: 10px; padding-top: 6px;
                                    spacing: 2px;
                                    Text { text: row.title; color: Theme.text-primary; font-size: 13px; font-weight: 600; overflow: elide; }
                                    Text { text: row.detail; color: Theme.text-dim; font-size: 11px; overflow: elide; }
                                }
                                TouchArea { clicked => { root.pick-game(row.slug); } }
                            }
                            if root.games.length == 0 : Text {
                                text: "No games yet.\nWrite a spec, save it as a game,\nthen build it.";
                                color: Theme.text-dim; font-size: 12px; wrap: word-wrap;
                            }
                        }
                    }
                    Text { text: "CHARACTERS"; color: Theme.text-dim; font-size: 10px; font-weight: 600; letter-spacing: 1.6px; height: 18px; }
                    ScrollView {
                        vertical-stretch: 2;
                        VerticalLayout {
                            spacing: 4px; alignment: start;
                            for row in root.characters: Rectangle {
                                height: 34px;
                                border-radius: 6px;
                                background: row.selected ? Theme.bg-selected : transparent;
                                HorizontalLayout {
                                    padding-left: 10px; padding-right: 10px; spacing: 6px; alignment: space-between;
                                    Text { text: row.name; color: Theme.text-primary; font-size: 13px; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                                    Text { text: row.archetype; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.pick-character(row.slug); } }
                            }
                            if root.characters.length == 0 : Text {
                                text: "No characters yet.";
                                color: Theme.text-dim; font-size: 12px;
                            }
                        }
                    }
                }
            }

            // ── The workbench ────────────────────────────────────────
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-deep;
                VerticalLayout {
                    padding: 16px; spacing: 10px;
                    Text {
                        text: "SPEC — a character or a game, as JSON";
                        color: Theme.text-dim; font-size: 10px; font-weight: 600; letter-spacing: 1.6px; height: 16px;
                    }
                    TextEdit {
                        text <=> root.spec-text;
                        vertical-stretch: 1;
                        wrap: no-wrap;
                        font-family: Theme.font-mono;
                        font-size: 12px;
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        YButton { label: "New character"; icon-path: Icons.plus; disabled: root.busy; clicked => { root.action("new-character"); } }
                        YButton { label: "New game"; icon-path: Icons.plus; variant: 1; disabled: root.busy; clicked => { root.action("new-game"); } }
                        Rectangle { horizontal-stretch: 1; }
                    }
                    HorizontalLayout {
                        spacing: 8px;
                        alignment: start;
                        Text {
                            text: "Selected game:"; color: Theme.text-dim; font-size: 12px; vertical-alignment: center;
                        }
                        LineEdit {
                            text <=> root.game-name;
                            placeholder-text: "The game's title";
                            width: 220px;
                        }
                        Rectangle { horizontal-stretch: 1; }
                    }
                }
            }
        }
    }
}
