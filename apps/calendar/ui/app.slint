// Yantrik Calendar — standalone app window.
// Wraps the shared CalendarScreen component in its own Window.

import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AppIdentity } from "app_color.slint";
import { AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposal } from "components/agent_proposal.slint";
import { CalendarScreen, CalendarEvent, CalendarDay, CalendarTimeEvent } from "calendar.slint";

export { CalendarEvent, CalendarDay, CalendarTimeEvent, ThemeMode, AccentPreset }
export { AgentContextItem, AgentSuggestion, AgentProposal }

export component CalendarApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    // ── The agent layer ──
    in property <[AgentContextItem]> agent-context <=> cal.agent-context;
    in property <[AgentSuggestion]> agent-suggestions <=> cal.agent-suggestions;
    in property <string> agent-unavailable <=> cal.agent-unavailable;
    callback agent-context-activated <=> cal.agent-context-activated;
    callback agent-suggestion-activated <=> cal.agent-suggestion-activated;
    in property <AgentProposal> proposal <=> cal.proposal;
    in property <bool> proposal-working <=> cal.proposal-working;
    callback proposal-dismissed <=> cal.proposal-dismissed;

    // What app this window is.
    //
    // Set on the WINDOW and not on AppHeader, which is where it lived first: a header covers
    // the screens that have one, and Email's account-setup screen has none -- so the app that
    // most needs to look like itself on first run was the one screen still drawing the house
    // teal. The window is the only element every screen of an app is inside.
    init => { AppIdentity.id = "calendar"; }

    default-font-family: Theme.font-ui;
    title: "Calendar";
    // preferred-, not fixed: a fixed size makes the window unresizable, and the content
    // stays this size even when the compositor maximises or fullscreens the window.
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg-deep;

    // ── State ──
    in property <string> month-title <=> cal.month-title;
    in property <[CalendarDay]> days <=> cal.days;
    in property <[CalendarEvent]> events-today <=> cal.events-today;
    in property <int> selected-day <=> cal.selected-day;
    in property <string> notice <=> cal.notice;

    // ── View mode ──
    in-out property <int> view-mode <=> cal.view-mode;

    // ── Week view ──
    in property <[CalendarTimeEvent]> week-events <=> cal.week-events;
    in property <[string]> week-day-labels <=> cal.week-day-labels;
    in property <bool> week-starts-monday <=> cal.week-starts-monday;
    in property <int> current-hour <=> cal.current-hour;
    in property <int> current-minute <=> cal.current-minute;

    // ── Day view ──
    in property <[CalendarTimeEvent]> day-events <=> cal.day-events;
    in property <string> day-view-title <=> cal.day-view-title;

    // ── Event form ──
    in-out property <bool> show-event-form <=> cal.show-event-form;
    in-out property <string> event-title <=> cal.event-title;
    in-out property <string> event-date <=> cal.event-date;
    in-out property <string> event-time <=> cal.event-time;
    in-out property <string> event-notes <=> cal.event-notes;

    // ── AI ──
    in property <bool> ai-is-working <=> cal.ai-is-working;
    in-out property <bool> ai-panel-open <=> cal.ai-panel-open;

    // ── Event templates ──
    //
    // What is left of the row that used to be here. The attendee list, the attendee input and
    // the reminder selector were removed with the controls they fed; calendar.slint records why
    // at each site. The template list is the screen's own property now, so there is nothing to
    // alias -- pressing a template hands its title and duration to the app through the callback.
    in property <string> cal-timezone-display <=> cal.cal-timezone-display;
    in-out property <bool> cal-template-panel-open <=> cal.cal-template-panel-open;

    // ── Callbacks (forwarded via alias — no parens allowed) ──
    callback switch-view <=> cal.switch-view;
    callback prev-month <=> cal.prev-month;
    callback next-month <=> cal.next-month;
    callback day-clicked <=> cal.day-clicked;
    callback add-event <=> cal.add-event;
    callback save-event <=> cal.save-event;
    callback delete-event <=> cal.delete-event;
    callback dismiss-notice <=> cal.dismiss-notice;
    callback cancel-event-form <=> cal.cancel-event-form;
    callback today-pressed <=> cal.today-pressed;
    callback ai-explain-pressed <=> cal.ai-explain-pressed;
    callback ai-dismiss <=> cal.ai-dismiss;

    callback cal-use-template <=> cal.cal-use-template;

    cal := CalendarScreen {
        window-bar: true;
        // Fills the window (no explicit size: Slint forbids width/height next to max-*).
        // The screen's own layouts may report a bounded maximum (a stretch layout of fixed rows);
        // the window must still open at its preferred size and grow with the user.
        max-width: 100000px;
        max-height: 100000px;
    }
}
