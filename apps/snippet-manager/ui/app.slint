// Yantrik Snippet Manager — standalone app window.
// Wraps the shared SnippetManagerScreen component in its own Window.

import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposal } from "components/agent_proposal.slint";
import { AppIdentity } from "app_color.slint";
import { YButton } from "components/y_button.slint";
import { SnippetManagerScreen, SnippetData, TagChip, CollectionData, LanguageOption } from "snippet_manager.slint";

export { SnippetData, TagChip, CollectionData, LanguageOption, ThemeMode, AccentPreset }
export { AgentContextItem, AgentSuggestion, AgentProposal }

export component SnippetManagerApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    // ── The agent layer ──
    in property <[AgentContextItem]> agent-context <=> inner.agent-context;
    in property <[AgentSuggestion]> agent-suggestions <=> inner.agent-suggestions;
    in property <string> agent-unavailable <=> inner.agent-unavailable;
    callback agent-context-activated <=> inner.agent-context-activated;
    callback agent-suggestion-activated <=> inner.agent-suggestion-activated;
    in property <AgentProposal> proposal <=> inner.proposal;
    in property <bool> proposal-working <=> inner.proposal-working;
    callback proposal-applied <=> inner.proposal-applied;
    callback proposal-dismissed <=> inner.proposal-dismissed;
    
    // What app this window is.
    //
    // Set on the WINDOW and not on AppHeader, which is where it lived first: a header covers
    // the screens that have one, and Email's account-setup screen has none -- so the app that
    // most needs to look like itself on first run was the one screen still drawing the house
    // teal. The window is the only element every screen of an app is inside.
    init => { AppIdentity.id = "snippets"; }

    default-font-family: Theme.font-ui;
    title: "Snippets";
    // preferred-, not fixed: a fixed size makes the window unresizable, and the content
    // stays this size even when the compositor maximises or fullscreens the window.
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg-deep;

    // Snippet data
    in property <[SnippetData]> snippets <=> inner.snippets;
    in property <[TagChip]> tag-chips <=> inner.tag-chips;
    in property <int> snippet-count <=> inner.snippet-count;
    in property <[CollectionData]> collections <=> inner.collections;
    in property <[LanguageOption]> language-options <=> inner.language-options;
    in property <int> match-count <=> inner.match-count;

    // Detail panel state
    in property <int> detail-id <=> inner.detail-id;
    in-out property <string> detail-title <=> inner.detail-title;
    in-out property <string> detail-language <=> inner.detail-language;
    in-out property <string> detail-code <=> inner.detail-code;
    in-out property <string> detail-tags <=> inner.detail-tags;
    in property <bool> detail-is-favorite <=> inner.detail-is-favorite;
    in property <string> detail-created-date <=> inner.detail-created-date;
    in property <string> detail-last-used-date <=> inner.detail-last-used-date;
    in property <int> detail-use-count <=> inner.detail-use-count;

    // Search
    in-out property <string> search-query <=> inner.search-query;

    // Copy feedback
    in property <bool> copy-feedback-visible <=> inner.copy-feedback-visible;

    // What went wrong, in words. Empty draws nothing; the same sentence goes to the control
    // surface, so a failure is said once on screen and once where a mind can read it.
    in property <string> notice <=> inner.notice;

    // Language dropdown
    in-out property <bool> lang-dropdown-open <=> inner.lang-dropdown-open;

    // Rename mode
    in-out property <bool> rename-mode <=> inner.rename-mode;
    in-out property <string> rename-text <=> inner.rename-text;

    // Snippet callbacks
    callback snip-search <=> inner.snip-search;
    callback snip-select <=> inner.snip-select;
    callback snip-new <=> inner.snip-new;
    callback snip-save <=> inner.snip-save;
    callback snip-delete <=> inner.snip-delete;
    callback snip-copy <=> inner.snip-copy;
    callback snip-tag-filter <=> inner.snip-tag-filter;
    callback snip-toggle-favorite <=> inner.snip-toggle-favorite;
    callback detail-edited <=> inner.detail-edited;

    // Collection callbacks
    callback collection-select <=> inner.collection-select;
    callback collection-create <=> inner.collection-create;
    callback collection-rename <=> inner.collection-rename;
    callback collection-delete <=> inner.collection-delete;

    // Export. Import has no button: it needs a path, and this screen has no file dialog. The
    // command line and the surface's `import` action are where a path can be named.
    callback snip-export-all <=> inner.snip-export-all;

    // Language
    callback snip-set-language <=> inner.snip-set-language;

    // AI. The answer lands in the shared proposal card above the panes.
    callback ai-explain-pressed <=> inner.ai-explain-pressed;

    // Unsaved text kept and offered back (the recovery bar): the sentence, empty when none, and
    // where its snippet is: 1 open in the editor, 2 kept and not open (Show), 3 no longer kept
    // (Restore as new). The buttons send "show", "restore" and "discard".
    in property <string> recovery-said;
    in property <int> recovery;
    callback recovery-action(string);

    inner := SnippetManagerScreen {
        window-bar: true;
        // Fills the window (no explicit size: Slint forbids width/height next to max-*).
        // The screen's own layouts may report a bounded maximum (a stretch layout of fixed rows);
        // the window must still open at its preferred size and grow with the user.
        max-width: 100000px;
        max-height: 100000px;
    }

    // Over the foot of the window, so the screen's own layout is untouched. Discard throws away
    // the only copy, so it is offered once the text can be seen, or when its snippet is gone.
    if root.recovery-said != "" : Rectangle {
        x: Theme.sp-3;
        width: parent.width - 2 * Theme.sp-3;
        y: parent.height - self.height - Theme.sp-3;
        height: offer.preferred-height;
        border-radius: Theme.r-md;
        background: Theme.notice-surface;
        border-width: 1px;
        border-color: Theme.notice-line;
        offer := HorizontalLayout {
            padding: Theme.sp-2;
            spacing: Theme.sp-2;
            Text {
                text: root.recovery-said;
                color: Theme.text-primary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
            if root.recovery == 2 : YButton { label: "Show"; variant: 1; size: 0; clicked => { root.recovery-action("show"); } }
            YButton {
                label: root.recovery == 3 ? "Restore as new" : "Restore";
                variant: 0;
                size: 0;
                clicked => { root.recovery-action("restore"); }
            }
            if root.recovery != 2 : YButton { label: "Discard"; variant: 3; size: 0; clicked => { root.recovery-action("discard"); } }
        }
    }
}
