// Yantrik Container Manager — standalone app window.
// Wraps the shared ContainerManagerScreen component in its own Window.

import { Theme, ThemeMode, AccentPreset } from "@yantrik-design/theme.slint";
import { AppWindow } from "@yantrik-kit/app_window.slint";
export { WindowChrome } from "@yantrik-kit/app_window.slint";
import { AgentContextItem, AgentSuggestion } from "@yantrik-kit/agent_rail.slint";
import { AgentProposal } from "@yantrik-kit/agent_proposal.slint";
import { AppIdentity } from "@yantrik-kit/app_color.slint";
import { ContainerManagerScreen, ContainerData, ImageData, VolumeData } from "container_manager.slint";

export { ContainerData, ImageData, VolumeData, ThemeMode, AccentPreset }
export { AgentContextItem, AgentSuggestion, AgentProposal }

export component ContainerManagerApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    // ── The agent layer ──
    in property <[AgentContextItem]> agent-context <=> inner.agent-context;
    in property <[AgentSuggestion]> agent-suggestions <=> inner.agent-suggestions;
    in property <string> agent-unavailable <=> inner.agent-unavailable;
    callback agent-context-activated <=> inner.agent-context-activated;
    callback agent-suggestion-activated <=> inner.agent-suggestion-activated;
    in property <AgentProposal> proposal <=> inner.proposal;
    in property <bool> proposal-working <=> inner.proposal-working;
    callback proposal-applied <=> inner.proposal-applied;
    callback proposal-dismissed <=> inner.proposal-dismissed;
    
    // What app this window is.
    //
    // Set on the WINDOW and not on AppHeader, which is where it lived first: a header covers
    // the screens that have one, and Email's account-setup screen has none -- so the app that
    // most needs to look like itself on first run was the one screen still drawing the house
    // teal. The window is the only element every screen of an app is inside.
    init => { AppIdentity.id = "containers"; }

    default-font-family: Theme.font-ui;
    title: "Containers";
    // preferred-, not fixed: a fixed size makes the window unresizable, and the content
    // stays this size even when the compositor maximises or fullscreens the window.
    preferred-width: 1100px;
    preferred-height: 720px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg-deep;

    // Tab state
    in-out property <int> active-tab <=> inner.active-tab;

    // Container data
    in property <[ContainerData]> containers <=> inner.containers;
    in property <int> running-count <=> inner.running-count;
    in property <int> stopped-count <=> inner.stopped-count;
    in property <int> total-count <=> inner.total-count;

    // Image data
    in property <[ImageData]> images <=> inner.images;

    // Volume data
    in property <[VolumeData]> volumes <=> inner.volumes;

    // Logs overlay
    in property <string> log-text <=> inner.log-text;
    in property <string> log-container-name <=> inner.log-container-name;
    in-out property <bool> show-logs <=> inner.show-logs;
    // The screen closes its own log pane (Close, or a click on the backdrop) without telling
    // anyone; the app's model has to hear of it, because `describe` carries the open pane's tail.
    callback logs-closed();
    changed show-logs => {
        if (!self.show-logs) { root.logs-closed(); }
    }

    // Runtime info
    in property <string> runtime-name <=> inner.runtime-name;

    // What could not be done. Set on failure, cleared on success, and carried in describe.
    in property <string> notice <=> inner.notice;

    // Input fields
    in-out property <string> run-image-input <=> inner.run-image-input;
    in-out property <string> pull-image-input <=> inner.pull-image-input;
    in-out property <string> create-volume-input <=> inner.create-volume-input;

    // AI Assist
    in property <bool> ai-is-working <=> inner.ai-is-working;
    in property <string> ai-response <=> inner.ai-response;
    in-out property <bool> ai-panel-open <=> inner.ai-panel-open;

    // Callbacks
    callback ct-tab <=> inner.ct-tab;
    callback ct-start <=> inner.ct-start;
    callback ct-stop <=> inner.ct-stop;
    callback ct-restart <=> inner.ct-restart;
    callback ct-remove <=> inner.ct-remove;
    callback ct-logs <=> inner.ct-logs;
    callback ct-run <=> inner.ct-run;
    callback ct-pull <=> inner.ct-pull;
    callback ct-remove-image <=> inner.ct-remove-image;
    callback ct-create-volume <=> inner.ct-create-volume;
    callback ct-remove-volume <=> inner.ct-remove-volume;
    callback ct-refresh <=> inner.ct-refresh;
    callback ai-summarize-logs <=> inner.ai-summarize-logs;
    callback ai-dismiss <=> inner.ai-dismiss;

    inner := ContainerManagerScreen {
        window-bar: true;
        // Fills the window (no explicit size: Slint forbids width/height next to max-*).
        // The screen's own layouts may report a bounded maximum (a stretch layout of fixed rows);
        // the window must still open at its preferred size and grow with the user.
        max-width: 100000px;
        max-height: 100000px;
    }
}
