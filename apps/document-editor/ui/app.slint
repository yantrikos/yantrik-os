// Yantrik Document Editor — standalone app window.
// Wraps the shared DocumentEditorScreen component in its own Window.

import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposal } from "components/agent_proposal.slint";
import { AppIdentity } from "app_color.slint";
import { DocumentEditorScreen, DocHeadingEntry } from "document_editor.slint";

export { DocHeadingEntry, ThemeMode, AccentPreset }
export { AgentContextItem, AgentSuggestion, AgentProposal }

export component DocumentEditorApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    // ── The agent layer ──
    in property <[AgentContextItem]> agent-context <=> editor.agent-context;
    in property <[AgentSuggestion]> agent-suggestions <=> editor.agent-suggestions;
    in property <string> agent-unavailable <=> editor.agent-unavailable;
    callback agent-context-activated <=> editor.agent-context-activated;
    callback agent-suggestion-activated <=> editor.agent-suggestion-activated;
    in property <AgentProposal> proposal <=> editor.proposal;
    in property <bool> proposal-working <=> editor.proposal-working;
    callback proposal-applied <=> editor.proposal-applied;
    callback proposal-dismissed <=> editor.proposal-dismissed;

    // What app this window is.
    //
    // Set on the WINDOW and not on AppHeader, which is where it lived first: a header covers
    // the screens that have one, and Email's account-setup screen has none -- so the app that
    // most needs to look like itself on first run was the one screen still drawing the house
    // teal. The window is the only element every screen of an app is inside.
    init => { AppIdentity.id = "documents"; }

    default-font-family: Theme.font-ui;
    title: "yDoc";
    // preferred-, not fixed: a fixed size makes the window unresizable, and the content
    // stays this size even when the compositor maximises or fullscreens the window.
    preferred-width: 1200px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg-deep;

    // ── The document ──
    in property <string> doc-title <=> editor.doc-title;
    in-out property <string> doc-content <=> editor.doc-content;
    in property <string> doc-file-path <=> editor.doc-file-path;
    in property <int> doc-word-count <=> editor.doc-word-count;
    in property <int> doc-char-count <=> editor.doc-char-count;
    in property <[DocHeadingEntry]> doc-headings <=> editor.doc-headings;
    in property <bool> doc-is-modified <=> editor.doc-is-modified;
    in property <string> doc-save-status <=> editor.doc-save-status;
    in property <string> notice <=> editor.notice;

    // ── Find and replace ──
    in-out property <bool> doc-show-find <=> editor.doc-show-find;
    in-out property <string> doc-find-query <=> editor.doc-find-query;
    in property <int> doc-find-count <=> editor.doc-find-count;
    in-out property <string> doc-replace-text <=> editor.doc-replace-text;

    // ── The outline sidebar ──
    //
    // Driven from the window's own toggle; Rust never needs to open or close it, which is why it
    // is `in-out` and not `in`.
    in-out property <bool> doc-show-outline <=> editor.doc-show-outline;

    // ── The file prompt ──
    in-out property <int> doc-dialog <=> editor.doc-dialog;
    in-out property <string> doc-dialog-path <=> editor.doc-dialog-path;
    in property <string> doc-dialog-error <=> editor.doc-dialog-error;
    callback doc-dialog-confirm <=> editor.doc-dialog-confirm;
    callback doc-dialog-cancel <=> editor.doc-dialog-cancel;
    callback doc-dialog-discard <=> editor.doc-dialog-discard;

    // ── AI assist ──
    //
    // The panel and the prompt box are the person's; Rust reads the prompt when the button is
    // pressed and never writes either.
    in-out property <bool> show-ai-panel <=> editor.show-ai-panel;
    in-out property <string> doc-ai-prompt <=> editor.doc-ai-prompt;
    callback doc-ai-submit <=> editor.doc-ai-submit;
    callback doc-ai-summarize <=> editor.doc-ai-summarize;
    callback doc-ai-improve <=> editor.doc-ai-improve;

    // ── The caret, and what can be done to it ──
    //
    // The formatting buttons need to know where the selection is before they can wrap it, and
    // need to put it back afterwards. These are the whole of that contract.
    out property <int> doc-cursor: editor.doc-cursor;
    out property <int> doc-anchor: editor.doc-anchor;
    public function select-range(start: int, end: int) { editor.select-range(start, end); }
    public function focus-body() { editor.focus-body(); }
    public function undo-body() { editor.undo-body(); }
    public function redo-body() { editor.redo-body(); }

    // ── Callbacks ──
    callback doc-new <=> editor.doc-new;
    callback doc-open <=> editor.doc-open;
    callback doc-save <=> editor.doc-save;
    callback doc-save-as <=> editor.doc-save-as;
    callback doc-export-md <=> editor.doc-export-md;
    callback doc-export-html <=> editor.doc-export-html;
    callback doc-content-changed <=> editor.doc-content-changed;
    callback doc-undo <=> editor.doc-undo;
    callback doc-redo <=> editor.doc-redo;
    callback doc-format-heading <=> editor.doc-format-heading;
    callback doc-format-bold <=> editor.doc-format-bold;
    callback doc-format-italic <=> editor.doc-format-italic;
    callback doc-format-strikethrough <=> editor.doc-format-strikethrough;
    callback doc-format-bullet <=> editor.doc-format-bullet;
    callback doc-format-checklist <=> editor.doc-format-checklist;
    callback doc-format-quote <=> editor.doc-format-quote;
    callback doc-format-code <=> editor.doc-format-code;
    callback doc-format-inline-code <=> editor.doc-format-inline-code;
    callback doc-format-divider <=> editor.doc-format-divider;
    callback doc-format-link <=> editor.doc-format-link;
    callback doc-find-changed <=> editor.doc-find-changed;
    callback doc-find-next <=> editor.doc-find-next;
    callback doc-find-prev <=> editor.doc-find-prev;
    callback doc-replace-one <=> editor.doc-replace-one;
    callback doc-replace-all <=> editor.doc-replace-all;
    callback doc-heading-clicked <=> editor.doc-heading-clicked;

    editor := DocumentEditorScreen {
        window-bar: true;
        // Fills the window (no explicit size: Slint forbids width/height next to max-*).
        // The screen's own layouts may report a bounded maximum (a stretch layout of fixed rows);
        // the window must still open at its preferred size and grow with the user.
        max-width: 100000px;
        max-height: 100000px;
    }
}
