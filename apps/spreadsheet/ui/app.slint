// Yantrik Spreadsheet — standalone app window: the screen, and the dialog over it.

import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AppIdentity } from "app_color.slint";
import { SpreadsheetScreen, SpreadsheetCell, SheetRow } from "spreadsheet.slint";
import { SheetDialogView, SheetDialog } from "sheet_dialog.slint";

export { SpreadsheetCell, SheetRow, SheetDialog, ThemeMode, AccentPreset }

export component SpreadsheetApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    // What app this window is (set on the window, which every screen of an app is inside).
    init => { AppIdentity.id = "spreadsheet"; }

    default-font-family: Theme.font-ui;
    title: "ySheets";
    // preferred-, not fixed: a fixed size makes the window unresizable.
    preferred-width: 1300px;
    preferred-height: 800px;
    min-width: 640px;
    min-height: 400px;
    background: Theme.bg-deep;

    in property <string> file-name <=> sheet.file-name;
    in property <bool> modified <=> sheet.modified;
    in property <[SheetRow]> rows <=> sheet.rows;
    in property <[string]> col-names <=> sheet.col-names;
    in property <int> active-row <=> sheet.active-row;
    in property <int> active-col <=> sheet.active-col;
    in property <string> active-ref <=> sheet.active-ref;
    in property <string> status-text <=> sheet.status-text;
    in property <bool> status-is-problem <=> sheet.status-is-problem;
    in property <bool> can-undo <=> sheet.can-undo;
    in property <bool> can-redo <=> sheet.can-redo;
    in-out property <string> cell-data <=> sheet.cell-data;

    callback cell-clicked <=> sheet.cell-clicked;
    callback formula-submitted <=> sheet.formula-submitted;
    callback formula-cancelled <=> sheet.formula-cancelled;
    callback command <=> sheet.command;

    in property <SheetDialog> dialog <=> dialog-view.kind;
    in property <string> dialog-message <=> dialog-view.message;
    in-out property <string> dialog-path <=> dialog-view.path;
    callback dialog-confirm <=> dialog-view.confirm;
    callback dialog-cancel <=> dialog-view.cancel;
    callback dialog-discard <=> dialog-view.discard;

    public function edit-cell() { sheet.edit-cell(); }

    sheet := SpreadsheetScreen {
        window-bar: true;
        // Fills the window (no explicit size: Slint forbids width/height next to max-*).
        max-width: 100000px;
        max-height: 100000px;
    }

    // Over the whole screen; its size is left unset so it fills the space below the bar.
    dialog-view := SheetDialogView {}
}
