import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppIdentity } from "app_color.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { YButton, YIconButton } from "y_button.slint";
import { YInput } from "y_input.slint";
import { Icon, Icons } from "icon.slint";
import { ScrollView } from "std-widgets.slint";
export { ThemeMode, AccentPreset }
export struct DocumentTab { title: string, active: bool, modified: bool }
export component TextEditorApp inherits AppWindow {
    title: "Editor";
    preferred-width: 1100px; preferred-height: 760px;
    min-width: 640px; min-height: 440px;
    init => { AppIdentity.id = "editor"; }
    app-id: "editor";
    header-icon: Icons.editor;
    header-subtitle: root.busy ? "Working…" : root.modified ? "Unsaved changes" : "Ready";
    header-actions: [
        {id:"open",icon:Icons.folder,label:"Open"},
        {id:"find",icon:Icons.search,label:"Find",active:root.show-find},
        {id:"save",icon:Icons.save,label:"Save",emphasis:2}
    ];
    header-action(id) => { if(id == "find") {root.show-find = !root.show-find; if(root.show-find){find-field.focus();}} else {root.action(id);} }
    in property <[DocumentTab]> tabs;
    in-out property <string> content;
    in property <string> document-title: "Untitled";
    in property <string> path-label: "A little space for your next idea";
    in property <string> language: "Plain text";
    in property <bool> modified;
    in property <bool> busy;
    in property <string> notice;
    in property <string> recovery-status: "Draft recovery ready";
    in property <string> numbers: "1";
    in property <int> line-count: 1;
    in property <int> cursor-line: 1;
    in property <int> cursor-column: 1;
    in property <string> ending: "LF";
    in-out property <int> font-pixels: 14;
    // #328: Slint's software renderer keeps every physical coordinate in an i16 and casts glyph
    // origins and rectangle corners without a guard, so text laid out past ~32k physical pixels
    // kills the process inside euclid. Everything the text layout sizes itself against is capped
    // at this limit, and the Rust side windows the text itself to what fits inside it; at scale
    // factor 2 the doubled coordinates plus the window chrome still leave headroom under i16::MAX.
    in-out property <length> render-limit: 15000px;
    // True while the text shown is a windowed part of the document; the view is read-only then,
    // because edits report the TextInput's text back and would truncate the document to the view.
    in property <bool> view-limited;
    // Says so in the status bar; the whole document is kept and saved regardless.
    in property <string> view-status;
    in-out property <bool> show-find;
    in-out property <bool> show-replace;
    in-out property <bool> match-case;
    in-out property <string> query;
    in-out property <string> replacement;
    in property <int> match-count;
    in property <int> match-index;
    // 1 open, 2 save as, 3 unsaved changes, 4 go to line.
    in-out property <int> dialog;
    in-out property <string> dialog-path;
    in property <string> dialog-error;
    in property <string> close-label;
    in-out property <bool> syntax: true;
    in property <string> keywords;
    in property <string> strings;
    in property <string> comments;
    in property <bool> has-highlights;
    callback action(string);
    callback select-tab(int);
    callback close-tab(int);
    callback edited(string);
    callback cursor(int);
    callback search();
    callback refresh();
    public function focus-editor() { editor.focus(); }
    public function select-range(start: int, end: int) { editor.set-selection-offsets(start,end); }
    public function reset-position() { scroll.viewport-y = 0px; scroll.viewport-x = 0px; editor.set-selection-offsets(0,0); }
    public function shortcut(event: KeyEvent) -> EventResult {
        if (event.modifiers.control) {
            if (event.text == "z" || event.text == "Z" || event.text == "y") { root.action(event.modifiers.shift || event.text == "y" ? "redo" : "undo"); return accept; }
            if (event.text == "s" || event.text == "S") { root.action(event.modifiers.shift ? "save-as" : "save"); return accept; }
            if (event.text == "n" || event.text == "t") { root.action("new"); return accept; }
            if (event.text == "o") { root.action("open"); return accept; }
            if (event.text == "w") { root.action("close"); return accept; }
            if (event.text == "f" || event.text == "h") { root.show-find = true; root.show-replace = event.text == "h"; find-field.focus(); return accept; }
            if (event.text == "g") { root.action("goto"); return accept; }
            if (event.text == "+" || event.text == "=") { root.font-pixels = min(22,root.font-pixels+1); return accept; }
            if (event.text == "-") { root.font-pixels = max(11,root.font-pixels - 1); return accept; }
            if (event.text == Key.Tab) { root.action(event.modifiers.shift ? "previous-tab" : "next-tab"); return accept; }
        }
        if (event.text == Key.F3) { root.action(event.modifiers.shift ? "find-prev" : "find-next"); return accept; }
        if (event.text == Key.Escape) { if(root.dialog != 0) {root.action("cancel");} else {root.show-find = false; root.focus-editor();} return accept; }
        return reject;
    }
    changed dialog => { if(root.dialog != 0 && root.dialog != 3) { path-field.focus(); } else if(root.dialog == 0) { editor.focus(); } }
    // How many lines fit inside the render limit depends on the font size (#328), so a change
    // here re-windows the document. Handled before the busy/dialog gates in the Rust `action`.
    changed font-pixels => { root.action("reflow"); }
    FocusScope {
    key-pressed(event) => { return root.shortcut(event); }
    VerticalLayout {
        spacing: 0px;
        Rectangle {
            height: 43px; background: Theme.bg-surface;
            HorizontalLayout {
                padding-left: 12px; padding-right: 8px; spacing: 4px;
                for tab[i] in root.tabs : Rectangle {
                    min-width: 0px; preferred-width: 178px; max-width: 178px; horizontal-stretch: 1; height: 38px;
                    border-radius: 7px; background: tab.active ? Theme.bg-elevated : area.has-hover ? Theme.hover-fill : transparent;
                    area := TouchArea { clicked => { root.select-tab(i); } }
                    HorizontalLayout {
                        padding-left: 10px; padding-right: 4px; spacing: 6px;
                        Text { text: tab.modified ? "●" : ""; width: 8px; color: Theme.accent; font-size: 9px; vertical-alignment: center; }
                        Text { text: tab.title; color: tab.active ? Theme.text-primary : Theme.text-secondary; font-size: 13px; overflow: elide; vertical-alignment: center; }
                        close := TouchArea { width: 22px; clicked => { root.close-tab(i); } Text { text: "×"; color: close.has-hover ? Theme.text-primary : Theme.text-dim; horizontal-alignment: center; vertical-alignment: center; } }
                    }
                    if tab.active : Rectangle { y: parent.height - 2px; height: 2px; background: Theme.accent; }
                }
                YIconButton { icon-path: Icons.plus; variant: 2; clicked => {root.action("new");} }
                Rectangle {horizontal-stretch:1;}
            }
        }
        Rectangle {
            height: 40px; background: Theme.bg-surface;
            HorizontalLayout {
                padding-left: 20px; padding-right: 12px; spacing: 12px;
                Text { text: root.path-label; color: Theme.text-dim; font-size: 12px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                YButton {label:"Save As"; variant:2; size:0; clicked=>{root.action("save-as");}}
                YButton {label:root.syntax ? "Color on" : "Color off"; variant:2; size:0; clicked=>{root.syntax = !root.syntax;}}
            }
        }
        if root.notice != "" : Rectangle {
            height: message.preferred-height + 20px; background: Theme.bg-elevated;
            message := Text { x:20px; y:10px; width: parent.width - 40px; text:root.notice; color:Theme.amber; font-size:13px; wrap:word-wrap; }
        }
        Rectangle {
            height: root.show-find ? (root.show-replace ? 90px : 48px) : 0px; clip:true; background:Theme.bg-elevated;
            VerticalLayout {
                padding:8px; spacing:6px;
                HorizontalLayout {
                    spacing:8px;
                    find-field := YInput { placeholder:"Find in document"; mode:1; value<=>root.query; edited(_)=>{root.search();} cleared=>{root.search();} accepted(_)=>{root.action("find-next");} }
                    Text {text: root.match-count == 0 ? "No matches" : "\{root.match-index} / \{root.match-count}"; color:Theme.text-secondary; font-size:12px; vertical-alignment:center; width:90px;}
                    YButton {label:root.match-case ? "Aa ✓" : "Aa"; variant:2; size:0; clicked=>{root.match-case = !root.match-case; root.search();}}
                    YIconButton {icon-path:Icons.chevron-up; variant:2; clicked=>{root.action("find-prev");}}
                    YIconButton {icon-path:Icons.chevron-down; variant:2; clicked=>{root.action("find-next");}}
                    YButton {label:"Replace"; variant:2; size:0; clicked=>{root.show-replace = !root.show-replace;}}
                    YIconButton {icon-path:Icons.close; variant:2; clicked=>{root.show-find=false;root.focus-editor();}}
                }
                if root.show-replace : HorizontalLayout {
                    spacing:8px;
                    YInput {placeholder:"Replace with"; value<=>root.replacement; accepted(_)=>{root.action("replace");}}
                    YButton {label:"Replace"; variant:1; size:0; clicked=>{root.action("replace");}}
                    YButton {label:"Replace all"; variant:1; size:0; clicked=>{root.action("replace-all");}}
                }
            }
        }
        Rectangle {height:1px;background:Theme.separator;}
        Rectangle {
            vertical-stretch:1; clip:true; background:Theme.bg-deep;
            if root.content == "" : VerticalLayout {
                padding-left:80px; padding-top:70px; alignment:start; spacing:12px;
                Text {text:"Make room for an idea."; color:Theme.text-dim; font-size:25px; font-weight:500;}
                Text {text:"Start writing, or open a text file.\nCtrl+O  Open     Ctrl+S  Save     Ctrl+F  Find";color:Theme.text-dim; font-size:14px;}
            }
            scroll := ScrollView {
                width:parent.width; height:parent.height;
                // Capped at the render limit (#328): the viewport rect is cast to i16 physical
                // coordinates when drawn, and the text inside is windowed to the same limit.
                viewport-width: min(max(self.visible-width, editor.preferred-width + 110px), root.render-limit);
                viewport-height:min(max(self.visible-height,editor.preferred-height + 40px), root.render-limit);
                Rectangle {
                width:scroll.viewport-width; height:scroll.viewport-height;
                Rectangle {x:0px;y:0px;width:60px;height:scroll.viewport-height;background:Theme.bg-surface;}
                gutter := Text {x:8px;y:20px;width:40px;text:root.numbers;horizontal-alignment:right;font-family:Theme.font-mono;font-size:root.font-pixels * 1px;color:Theme.text-dim;}
                editor := TextInput {
                    x:80px;y:20px;width:min(max(scroll.visible-width - 100px,self.preferred-width),root.render-limit);height:min(self.preferred-height,root.render-limit);
                    text<=>root.content;font-family:Theme.font-mono;font-size:root.font-pixels * 1px;color:Theme.text-primary;
                    single-line:false;wrap:no-wrap;read-only:root.busy || root.dialog != 0 || root.view-limited;
                    selection-background-color:Theme.accent;selection-foreground-color:Theme.bg-deep;
                    page-height:scroll.visible-height;
                    edited=>{root.edited(self.text);}
                    key-pressed(event)=>{return root.shortcut(event);}
                    cursor-position-changed(pos)=>{
                        root.cursor(self.cursor-position-byte-offset);
                        if(pos.y + 44px > -scroll.viewport-y + scroll.visible-height){scroll.viewport-y = min(0px, scroll.visible-height - pos.y - 44px);}
                        if(pos.y + 16px < -scroll.viewport-y){scroll.viewport-y = -pos.y;}
                        if(pos.x + 100px > -scroll.viewport-x + scroll.visible-width){scroll.viewport-x = min(0px,scroll.visible-width - pos.x - 110px);}
                        if(pos.x + 70px < -scroll.viewport-x){scroll.viewport-x = min(0px,-pos.x);}
                    }
                }
                // Bounded lexical color layers use the same font and exact line geometry.
                // Selection remains native and legible; non-ASCII/tabbed lines use plain text.
                if root.syntax && root.has-highlights && editor.cursor-position-byte-offset == editor.anchor-position-byte-offset : Rectangle {
                    x:80px;y:20px;width:editor.width;height:editor.height;
                    Text {x:0px;y:0px;width:parent.width;height:parent.height;text:root.keywords;font-family:Theme.font-mono;font-size:root.font-pixels * 1px;color:Theme.accent;}
                    Text {x:0px;y:0px;width:parent.width;height:parent.height;text:root.strings;font-family:Theme.font-mono;font-size:root.font-pixels * 1px;color:Theme.amber;}
                    Text {x:0px;y:0px;width:parent.width;height:parent.height;text:root.comments;font-family:Theme.font-mono;font-size:root.font-pixels * 1px;color:Theme.text-dim;}
                }
                }
            }
        }
        Rectangle {height:1px;background:Theme.separator;}
        Rectangle {
            height:32px;background:Theme.bg-surface;
            HorizontalLayout {padding-left:20px;padding-right:16px;spacing:18px;
                Text {text:"Ln \{root.cursor-line}, Col \{root.cursor-column}";color:Theme.text-secondary;font-size:12px;vertical-alignment:center;}
                Text {text:"\{root.line-count} lines";color:Theme.text-dim;font-size:12px;vertical-alignment:center;}
                if root.view-status != "" : Text {text:root.view-status;color:Theme.amber;font-size:12px;vertical-alignment:center;max-width:420px;overflow:elide;}
                Text {text:root.recovery-status;color:Theme.text-dim;font-size:12px;vertical-alignment:center;horizontal-stretch:1;overflow:elide;}
                Text {text:root.language + "  ·  UTF-8  ·  " + root.ending;color:Theme.text-secondary;font-size:12px;vertical-alignment:center;}
            }
        }
    }
    Rectangle {
        visible:root.dialog != 0;
        background:#00000066;
        TouchArea {}
        Rectangle {
            x:(parent.width - self.width)/2;y:(parent.height - self.height)/2;
            width:min(520px,root.width - 48px);height:modal.preferred-height;
            border-radius:14px;background:Theme.bg-elevated;border-width:1px;border-color:Theme.border-default;
            modal := VerticalLayout {
                padding:24px;spacing:16px;
                Text {text:root.dialog == 1 ? "Open a file" : root.dialog == 2 ? "Save a copy" : root.dialog == 4 ? "Go to line" : "Keep your changes?";color:Theme.text-primary;font-size:22px;font-weight:600;}
                Text {text:root.dialog == 3 ? root.close-label : root.dialog == 4 ? "Enter a line number." : "Absolute path or ~/ — UTF-8 text, up to 1 MiB.";color:Theme.text-secondary;font-size:14px;wrap:word-wrap;}
                path-field := YInput {visible:root.dialog != 3; value<=>root.dialog-path;accepted(_)=>{root.action("confirm");}}
                if root.dialog-error != "" : Text {text:root.dialog-error;color:Theme.amber;font-size:13px;wrap:word-wrap;}
                HorizontalLayout {spacing:8px;alignment:end;
                    YButton {label:"Cancel";variant:2;clicked=>{root.action("cancel");}}
                    if root.dialog == 3 : YButton {label:"Discard";variant:1;clicked=>{root.action("discard");}}
                    YButton {label:root.busy ? "Working…" : root.dialog == 1 ? "Open" : root.dialog == 4 ? "Go" : "Save";variant:0;clicked=>{root.action(root.dialog == 3 ? "save-close" : "confirm");}}
                }
            }
        }
    }
}
}
