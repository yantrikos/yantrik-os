[Desktop Entry]
Type=Application
Name=Calendar
Comment=Calendar with Google Calendar sync
Exec=/opt/yantrik/bin/yantrik-calendar
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Office;Calendar;
Keywords=calendar;events;schedule;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=calendar
X-Yantrik-Purpose=events and appointments
