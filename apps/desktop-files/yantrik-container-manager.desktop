[Desktop Entry]
Type=Application
Name=Containers
Comment=Docker/Podman container management
Exec=/opt/yantrik/bin/yantrik-container-manager
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Development;System;
Keywords=docker;podman;container;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=containers
X-Yantrik-Purpose=Docker or Podman containers
X-Yantrik-Aliases=container-manager
