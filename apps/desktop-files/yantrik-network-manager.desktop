[Desktop Entry]
Type=Application
Name=Network
Comment=WiFi, Bluetooth, VPN network management
Exec=/opt/yantrik/bin/yantrik-network-manager
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=System;Network;
Keywords=wifi;bluetooth;vpn;network;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=network
X-Yantrik-Purpose=this machine's connections, Wi-Fi and firewall state
X-Yantrik-Aliases=network-manager
