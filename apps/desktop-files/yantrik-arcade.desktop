[Desktop Entry]
Type=Application
Name=Arcade
Comment=Build playable games from small JSON specs
Exec=/opt/yantrik/bin/yantrik-arcade
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Game;
Keywords=arcade;games;builder;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=arcade
X-Yantrik-Purpose=game making: small JSON specs in, one playable HTML game out
