[Desktop Entry]
Type=Application
Name=Snippets
Comment=Code snippet manager with search
Exec=/opt/yantrik/bin/yantrik-snippet-manager
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Development;Utility;
Keywords=snippet;code;clipboard;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=snippets
X-Yantrik-Purpose=reusable pieces of code and text
X-Yantrik-Aliases=snippet-manager
