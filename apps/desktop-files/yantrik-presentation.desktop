[Desktop Entry]
Type=Application
Name=yPresent
Comment=Slide presentation editor
Exec=/opt/yantrik/bin/yantrik-presentation
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Office;Presentation;
Keywords=slides;presentation;powerpoint;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=presentation
X-Yantrik-Purpose=slide decks
X-Yantrik-Aliases=slides
