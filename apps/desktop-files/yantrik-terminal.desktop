[Desktop Entry]
Type=Application
Name=Terminal
Comment=Terminal emulator
Exec=/opt/yantrik/bin/yantrik-terminal
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=System;TerminalEmulator;
Keywords=terminal;shell;command;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=terminal
X-Yantrik-Purpose=a shell: run commands
