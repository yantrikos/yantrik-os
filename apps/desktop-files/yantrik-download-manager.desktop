[Desktop Entry]
Type=Application
Name=Downloads
Comment=File download manager with queue
Exec=/opt/yantrik/bin/yantrik-download-manager
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Network;FileTransfer;
Keywords=download;transfer;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=download-manager
X-Yantrik-Purpose=fetch a URL to a file, with progress
X-Yantrik-Aliases=downloads
