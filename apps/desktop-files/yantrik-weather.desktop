[Desktop Entry]
Type=Application
Name=Weather
Comment=Weather forecasts, air quality, and alerts
Exec=/opt/yantrik/bin/yantrik-weather
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Utility;
Keywords=weather;forecast;temperature;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=weather
X-Yantrik-Purpose=current conditions and forecast
