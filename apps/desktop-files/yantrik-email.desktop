[Desktop Entry]
Type=Application
Name=Email
Comment=Full-featured email client with AI assist
Exec=/opt/yantrik/bin/yantrik-email
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Network;Email;
Keywords=email;mail;imap;smtp;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=email
X-Yantrik-Purpose=read and send mail
