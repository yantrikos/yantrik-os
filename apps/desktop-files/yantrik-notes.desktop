[Desktop Entry]
Type=Application
Name=Notes
Comment=AI-native markdown notes with semantic search
Exec=/opt/yantrik/bin/yantrik-notes
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=Office;TextEditor;
Keywords=notes;markdown;write;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=notes
X-Yantrik-Purpose=quick markdown notes kept in the notes library, not files you name
