[Desktop Entry]
Type=Application
Name=System Monitor
Comment=CPU, memory, disk, network monitoring
Exec=/opt/yantrik/bin/yantrik-system-monitor
# One mark for now: brand/yantrik-icon.svg, installed as hicolor `yantrik`.
Icon=yantrik
Categories=System;Monitor;
Keywords=cpu;memory;disk;processes;
# The control surface this app publishes: docs/surface-protocol.md, section 3.
X-Yantrik-Surface=system-monitor
X-Yantrik-Purpose=CPU, memory, disk and processes
X-Yantrik-Aliases=sysmonitor
