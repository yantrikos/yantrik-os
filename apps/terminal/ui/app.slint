import { Theme, ThemeMode, AccentPreset } from "theme.slint";
import { AppWindow } from "app_window.slint";
export { WindowChrome } from "app_window.slint";
import { AppIdentity } from "app_color.slint";
import { TerminalWorkbench, SessionTab, TerminalRun } from "terminal_workbench.slint";
export { ThemeMode, AccentPreset, SessionTab, TerminalRun }
export component TerminalApp inherits AppWindow {
    // The screen's own header is this window's title bar (#256).
    show-bar: false;
    title: "Terminal";
    preferred-width: 1000px; preferred-height: 680px;
    min-width: 640px; min-height: 400px;
    default-font-family: Theme.font-ui;
    background: Theme.bg-deep;
    init => { AppIdentity.id = "terminal"; }
    in property <[SessionTab]> tabs <=> workbench.tabs;
    in property <[TerminalRun]> runs <=> workbench.runs;
    in property <string> screen-text <=> workbench.screen-text;
    in property <string> directory <=> workbench.directory;
    in property <bool> alive <=> workbench.alive;
    in property <string> status <=> workbench.status;
    in property <string> notice <=> workbench.notice;
    in property <int> cursor-row <=> workbench.cursor-row;
    in property <int> cursor-col <=> workbench.cursor-col;
    in property <bool> cursor-visible <=> workbench.cursor-visible;
    in property <int> scrollback <=> workbench.scrollback;
    in-out property <int> font-size <=> workbench.font-size;
    in-out property <bool> show-search <=> workbench.show-search;
    in-out property <string> query <=> workbench.query;
    in property <int> match-count <=> workbench.match-count;
    in property <int> match-index <=> workbench.match-index;
    in property <int> match-row <=> workbench.match-row;
    in-out property <bool> show-assistant <=> workbench.show-assistant;
    in property <string> explanation <=> workbench.explanation;
    in property <bool> explaining <=> workbench.explaining;
    in property <bool> confirm-close <=> workbench.confirm-close;
    in property <string> close-heading <=> workbench.close-heading;
    in property <string> close-said <=> workbench.close-said;
    in property <string> close-label <=> workbench.close-label;
    callback input <=> workbench.input;
    callback shortcut <=> workbench.shortcut;
    callback action <=> workbench.action;
    callback select-tab <=> workbench.select-tab;
    callback close-tab <=> workbench.close-tab;
    callback resized <=> workbench.resized;
    callback scroll <=> workbench.scroll;
    callback search <=> workbench.search;
    callback paste-text <=> workbench.paste-text;
    public function focus-terminal() { workbench.focus-terminal(); }
    public function copy-screen() { workbench.copy-screen(); }
    public function paste-clipboard() { workbench.paste-clipboard(); }
    workbench := TerminalWorkbench { max-width: 100000px; max-height: 100000px; window-bar: true; }
}
