[Unit]
Description=OpenClaw, attached to the Yantrik OS desktop as a mind
Documentation=file:///opt/yantrik/share/harnesses/openclaw/README.md
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/python3 /opt/yantrik/share/harnesses/openclaw/yantrik_openclaw.py
Restart=on-failure
RestartSec=5
# A user service does not inherit a login shell's PATH, and the Install button puts `openclaw`
# and the `node` it runs on in ~/.local/bin (harnesses/lib/install/npm.sh). Without it on PATH
# the CLI route cannot start openclaw at all and the picker line says "openclaw" with no
# version, because even `openclaw --version` could not be run. An install somewhere else goes
# in `path` in ~/.config/yantrik/openclaw.json, which this harness prepends.
Environment=PATH=%h/.local/bin:/usr/local/bin:/usr/bin:/bin
#
# OpenClaw's model, keys, memory and MCP servers are OpenClaw's own business and live in
# ~/.openclaw/openclaw.json and ~/.openclaw/.env. Nothing in this unit and nothing in the image
# holds one. The gateway route needs the gateway's own token when `gateway.auth.mode` is
# "token" (it is by default): name its variable in `token_env` and put the variable itself in an
# EnvironmentFile the person owns at mode 600 —
#   EnvironmentFile=%h/.config/yantrik/openclaw.env
# — never in an Environment= line here, which `systemctl show` prints to anyone who asks.
#
# This unit does not start the gateway. OpenClaw's own service does that (`openclaw daemon
# start`, or a unit of its own); this one only talks to it, and says so in the conversation when
# it is not there.

[Install]
WantedBy=default.target
