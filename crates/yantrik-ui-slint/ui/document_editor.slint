// Document Editor (yDoc) — screen 30
//
// A Markdown editor. The document's native format is Markdown, which is what the empty-document
// hint on the page has always said and what the formatting buttons and the `#`-derived outline
// have always assumed; it is now also what is on disk.
//
// This screen used to carry comments, track changes, version history, tables, templates, page
// layout, print preview and a second AI panel. None of it was backed: 53 of the 60 callbacks
// this app registered wrote a log line and returned, and sixteen `in` properties — including the
// `doc-file-path` that Save read — were never written by Rust at all. What was removed is
// recorded at the site it was removed from, with what it would take to bring it back. What is
// left does something.
//
// Wrapped in a Window by apps/document-editor/ui/app.slint.

import { Theme } from "theme.slint";
import { ListView, LineEdit, ScrollView } from "std-widgets.slint";
import { RibbonToolButton, RibbonToolButtonWide, RibbonSeparator, RibbonTabButton, RibbonGroupLabel } from "components/app_ribbon.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposalCard, AgentProposal } from "components/agent_proposal.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";

export struct DocHeadingEntry {
    title: string,
    level: int,
    // Byte offset of the heading in the document, so clicking it can move the real caret.
    block-index: int,
}

// DocCommentEntry, DocChangeEntry and DocVersionEntry were here, behind three sidebar panels
// with eleven callbacks between them. Nothing stored a comment, recorded a change or kept a
// version: every one of those handlers was a `tracing::info!` and the three list properties were
// never set, so the panels drew their own empty states for ever. Comments and track changes need
// a per-document store that can survive the text being rewritten under them — anchors, not line
// numbers, because the AI rewrite path replaces the whole document. Version history needs
// somewhere to put the versions. Until one of those exists, a person leaving a note here was
// typing into nothing.

export component DocumentEditorScreen inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar when
    // the screen fills an app window; the shell's copy leaves it off.
    in property <bool> window-bar: false;
    // ── The agent layer ──
    //
    // Filled from what this app and the companion actually hold; every row says where it came
    // from, and a section with nothing true to say does not draw. See agent_rail.slint.
    in property <[AgentContextItem]> agent-context: [];
    in property <[AgentSuggestion]> agent-suggestions: [];
    in property <string> agent-unavailable: "";
    callback agent-context-activated(string);
    callback agent-suggestion-activated(string);
    in property <AgentProposal> proposal;
    in property <bool> proposal-working: false;
    callback proposal-applied();
    callback proposal-dismissed();

    background: transparent;

    // ── The document ──
    //
    // `doc-title` is derived from the document, not typed beside it: the first `# ` heading, or
    // the file name. There used to be a title field on the page that could be typed into and was
    // saved nowhere, so a title survived until the next reload and no further.
    in property <string> doc-title: "Untitled";
    in-out property <string> doc-content: "";
    in property <string> doc-file-path: "";
    in property <int> doc-word-count: 0;
    in property <int> doc-char-count: 0;
    in property <[DocHeadingEntry]> doc-headings: [];
    in property <bool> doc-is-modified: false;
    in property <string> doc-save-status: "";

    // What went wrong, for the person. The same sentence goes to `describe.notice` for a mind:
    // contract point 4 is that a failure is said twice, and this is the half a person reads.
    in property <string> notice: "";

    // Find and replace
    in-out property <bool> doc-show-find: false;
    in-out property <string> doc-find-query: "";
    in property <int> doc-find-count: 0;
    in-out property <string> doc-replace-text: "";

    // The outline sidebar. One panel now, so this is a flag rather than the four-way mode it was.
    in-out property <bool> doc-show-outline: true;

    // ── The file prompt ──
    //
    // 0 none, 1 open, 2 save as, 3 export Markdown, 4 export HTML, 5 unsaved changes.
    //
    // This is what makes Save reachable. A new document has no path; Save with no path used to
    // log "No file path set" and return, for ever, because nothing in the app could ever give it
    // one. Now it opens this, the same way the text editor does.
    in-out property <int> doc-dialog: 0;
    in-out property <string> doc-dialog-path: "";
    in property <string> doc-dialog-error: "";
    callback doc-dialog-confirm();
    callback doc-dialog-cancel();
    callback doc-dialog-discard();

    // ── What the buttons do ──
    callback doc-new();
    callback doc-open();
    callback doc-save();
    callback doc-save-as();
    callback doc-export-md();
    callback doc-export-html();
    callback doc-content-changed(string);
    callback doc-undo();
    callback doc-redo();

    // Formatting: each of these inserts Markdown around the selection or at the start of the
    // lines it touches. Underline and highlight used to sit beside them and are gone — Markdown
    // has neither, and a button that writes a syntax no reader renders is a button that lies.
    callback doc-format-heading(int);
    callback doc-format-bold();
    callback doc-format-italic();
    callback doc-format-strikethrough();
    callback doc-format-bullet();
    callback doc-format-checklist();
    callback doc-format-quote();
    callback doc-format-code();
    callback doc-format-inline-code();
    callback doc-format-divider();
    callback doc-format-link(string);

    callback doc-find-changed(string);
    callback doc-find-next();
    callback doc-find-prev();
    callback doc-replace-one();
    callback doc-replace-all();
    callback doc-heading-clicked(int);

    // The one AI path, and it is real: it asks the companion and comes back as a proposal card
    // that says what applying it would do. `doc-ai-summarize` and `doc-ai-improve` are the two
    // canned prompts, and they go through the same call.
    //
    // doc-ai-apply, doc-ai-dismiss, doc-ai-draft, doc-ai-translate and doc-ai-insights were here
    // with a response pane and an Apply/Dismiss row beneath them. The pane's `doc-ai-response`
    // was never set, so the row it gated never drew at all, and the five callbacks logged their
    // arguments. Apply and Dismiss already exist for real as the proposal card's own buttons.
    // Translate hardcoded Spanish with nowhere to choose a language; Draft and Insights had no
    // prompt behind them.
    in-out property <bool> show-ai-panel: false;
    in-out property <string> doc-ai-prompt: "";
    callback doc-ai-submit(string);
    callback doc-ai-summarize();
    callback doc-ai-improve();

    // ── What the editing surface can be asked ──
    //
    // The body is a plain TextInput, which means the caret and the selection are real and
    // reachable. That is what lets the formatting buttons be more than decoration: Rust reads
    // these two offsets, computes the new text and the new selection as pure string work, and
    // puts the selection back with select-range.
    out property <int> doc-cursor: content-edit.cursor-position-byte-offset;
    out property <int> doc-anchor: content-edit.anchor-position-byte-offset;
    public function select-range(start: int, end: int) { content-edit.set-selection-offsets(start, end); }
    public function focus-body() { content-edit.focus(); }
    // Undo and redo are the TextInput's own. Slint's TextInput carries an edit history and
    // exposes undo()/redo(); writing a second stack beside it would have fought with the one
    // already running under the caret.
    public function undo-body() { content-edit.undo(); }
    public function redo-body() { content-edit.redo(); }

    // Ribbon tab state: 0=Home, 1=Insert, 2=File
    property <int> ribbon-tab: 0;

    changed doc-dialog => {
        if (root.doc-dialog != 0 && root.doc-dialog != 5) { dialog-path-input.focus(); }
    }

    VerticalLayout {
        // -- Header --
        AppHeader {
            window-bar: root.window-bar;
            app-id: "documents";
            icon: Icons.doc;
            title: root.doc-title != "" ? root.doc-title : "yDoc";
            subtitle: root.doc-file-path != "" ? root.doc-file-path : "Not saved yet — Save gives it a home";
            modified: root.doc-is-modified;
            leading-actions: [
                { id: "save", icon: Icons.save, label: "Save", emphasis: 2, active: root.doc-is-modified },
                { id: "undo", icon: Icons.rotate-ccw },
                { id: "redo", icon: Icons.rotate-cw },
            ];
            actions: [
                { id: "find", icon: Icons.search, label: "Find", active: root.doc-show-find },
                { id: "ai",   icon: Icons.spark,  label: "AI", emphasis: 1, active: root.show-ai-panel },
            ];
            action(id) => {
                if (id == "save") { root.doc-save(); }
                else if (id == "undo") { root.doc-undo(); }
                else if (id == "redo") { root.doc-redo(); }
                else if (id == "find") { root.doc-show-find = !root.doc-show-find; }
                else if (id == "ai") { root.show-ai-panel = !root.show-ai-panel; }
            }
        }
        // ═══ Row 1: Tab strip (36px) ═══
        Rectangle {
            height: 36px;
            background: Theme.bg-elevated;

            HorizontalLayout {
                padding-left: 8px;
                padding-right: 8px;
                spacing: 0px;

                // The ribbon's tab strip, and nothing else.
                //
                // It used to open with Save / Undo / Redo and close with Find and AI -- all five of which
                // are already in the AppHeader one row above, doing the same thing to the same document.
                // Converting this app to the SDK header gave it the commands and left the old row intact,
                // so the window opened with two command bars stacked, the top one and the bottom one
                // offering the same five buttons eighteen pixels apart. The tabs are the part that was
                // never anywhere else.
                //
                // Review was a tab of its own for track changes; it is gone with them.
                RibbonTabButton { label: "Home"; is-active: root.ribbon-tab == 0; clicked => { root.ribbon-tab = 0; } }
                RibbonTabButton { label: "Insert"; is-active: root.ribbon-tab == 1; clicked => { root.ribbon-tab = 1; } }
                RibbonTabButton { label: "File"; is-active: root.ribbon-tab == 2; clicked => { root.ribbon-tab = 2; } }

                Rectangle {}
            }

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        // ═══ Row 2: Grouped command band (44px) — swaps by tab ═══
        Rectangle {
            height: 44px;
            background: Theme.bg-elevated;

            // ── HOME tab: Style + Font + Paragraph ──
            if root.ribbon-tab == 0 : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 3px;
                alignment: start;

                RibbonGroupLabel { label: "STYLE"; }
                RibbonToolButton { label: "H1"; tooltip-text: "Heading 1"; clicked => { root.doc-format-heading(1); } }
                RibbonToolButton { label: "H2"; tooltip-text: "Heading 2"; clicked => { root.doc-format-heading(2); } }
                RibbonToolButton { label: "H3"; tooltip-text: "Heading 3"; clicked => { root.doc-format-heading(3); } }

                RibbonSeparator {}

                RibbonGroupLabel { label: "FONT"; }
                RibbonToolButton { icon-path: Icons.bold; tooltip-text: "Bold  **text**"; clicked => { root.doc-format-bold(); } }
                RibbonToolButton { icon-path: Icons.italic; tooltip-text: "Italic  *text*"; clicked => { root.doc-format-italic(); } }
                RibbonToolButton { icon-path: Icons.strikethrough; tooltip-text: "Strikethrough  ~~text~~"; clicked => { root.doc-format-strikethrough(); } }

                RibbonSeparator {}

                RibbonGroupLabel { label: "PARAGRAPH"; }
                RibbonToolButton { icon-path: Icons.list; tooltip-text: "Bullet list"; clicked => { root.doc-format-bullet(); } }
                RibbonToolButton { icon-path: Icons.checkbox; tooltip-text: "Checklist"; clicked => { root.doc-format-checklist(); } }
                RibbonToolButton { icon-path: Icons.quote; tooltip-text: "Quote"; clicked => { root.doc-format-quote(); } }
                RibbonToolButton { icon-path: Icons.link; tooltip-text: "Link"; clicked => { root.doc-format-link(""); } }
            }

            // ── INSERT tab: Code + Views ──
            //
            // Table, Image and Contents were here. A Markdown table needs a grid to edit once it
            // is inserted, an image needs a file to point at and there is no picker, and a table
            // of contents is the outline on the left — inserting a stale copy of it into the text
            // is a second source of the same truth. All three logged a line and returned.
            if root.ribbon-tab == 1 : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 3px;
                alignment: start;

                RibbonGroupLabel { label: "CODE"; }
                RibbonToolButtonWide { label: "Block"; icon-path: Icons.code; tooltip-text: "Code block"; clicked => { root.doc-format-code(); } }
                RibbonToolButtonWide { label: "Inline"; icon-path: Icons.code; tooltip-text: "Inline code"; clicked => { root.doc-format-inline-code(); } }
                RibbonToolButton { icon-path: Icons.divider; tooltip-text: "Divider"; clicked => { root.doc-format-divider(); } }

                RibbonSeparator {}

                RibbonGroupLabel { label: "VIEW"; }
                RibbonToolButtonWide {
                    label: "Outline";
                    is-active: root.doc-show-outline;
                    tooltip-text: "Show the outline";
                    clicked => { root.doc-show-outline = !root.doc-show-outline; }
                }
            }

            // ── FILE tab: the document, and copies of it ──
            //
            // Import Markdown is gone: the native format IS Markdown, so importing one is just
            // opening it, and two buttons doing the identical thing is how a person learns not
            // to trust either. Export PDF is gone too — there is no PDF writer on this machine
            // and nothing behind that button ever made one. Export Markdown stays because it is
            // not Save As: it writes a copy and leaves the document where it lives.
            if root.ribbon-tab == 2 : HorizontalLayout {
                padding-left: 10px;
                padding-right: 10px;
                spacing: 3px;
                alignment: start;

                RibbonGroupLabel { label: "DOCUMENT"; }
                RibbonToolButtonWide { label: "New"; icon-path: Icons.plus; clicked => { root.doc-new(); } }
                RibbonToolButtonWide { label: "Open"; icon-path: Icons.folder; clicked => { root.doc-open(); } }
                RibbonToolButtonWide { label: "Save"; icon-path: Icons.save; clicked => { root.doc-save(); } }
                RibbonToolButtonWide { label: "Save As"; icon-path: Icons.save; clicked => { root.doc-save-as(); } }

                RibbonSeparator {}

                RibbonGroupLabel { label: "COPY TO"; }
                RibbonToolButtonWide { label: "Markdown"; icon-path: Icons.export; tooltip-text: "Write a copy as Markdown"; clicked => { root.doc-export-md(); } }
                RibbonToolButtonWide { label: "HTML"; icon-path: Icons.globe; tooltip-text: "Write a copy as HTML"; clicked => { root.doc-export-html(); } }
            }

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.border-subtle;
            }
        }

        // ── What went wrong ──
        //
        // Every refusal this app makes lands here and in `describe.notice`, because a save that
        // did not happen has to be visible to the person in front of it and to the mind driving
        // it, and neither should have to ask the other.
        if root.notice != "" : Rectangle {
            background: Theme.bg-elevated;
            height: notice-text.preferred-height + 18px;

            notice-text := Text {
                x: 16px;
                y: 9px;
                width: parent.width - 32px;
                text: root.notice;
                color: Theme.amber;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }

            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }
        }

        // ── Find/Replace bar ──
        Rectangle {
            height: root.doc-show-find ? 40px : 0px;
            visible: root.doc-show-find;
            background: Theme.bg-card;
            border-width: 0px;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                alignment: start;

                Text {
                    text: "Find:";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                find-input := LineEdit {
                    width: 180px;
                    text <=> root.doc-find-query;
                    placeholder-text: "Search...";
                    edited => { root.doc-find-changed(self.text); }
                    accepted => { root.doc-find-next(); }
                }

                Text {
                    text: root.doc-find-query == "" ? "" : root.doc-find-count + " matches";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                RibbonToolButton { icon-path: Icons.chevron-up; clicked => { root.doc-find-prev(); } }
                RibbonToolButton { icon-path: Icons.chevron-down; clicked => { root.doc-find-next(); } }

                RibbonSeparator {}

                Text {
                    text: "Replace:";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                replace-input := LineEdit {
                    width: 160px;
                    text <=> root.doc-replace-text;
                    placeholder-text: "Replace with...";
                    accepted => { root.doc-replace-one(); }
                }

                RibbonToolButtonWide { label: "One"; clicked => { root.doc-replace-one(); } }
                RibbonToolButtonWide { label: "All"; clicked => { root.doc-replace-all(); } }
            }

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }
        }

        // ── What the companion is proposing ──
        if root.proposal.title != "" : AgentProposalCard {
            data: root.proposal;
            working: root.proposal-working;
            apply => { root.proposal-applied(); }
            dismiss => { root.proposal-dismissed(); }
        }

        // ── Main content area (outline + page + agent rail) ──
        HorizontalLayout {
            // ── Left sidebar: the outline ──
            //
            // There were four tabs across the top of this panel — Outline, Notes, Changes,
            // History — and three of them opened a panel over an empty list property nothing
            // ever filled. One panel needs no tab strip.
            if root.doc-show-outline : Rectangle {
                width: 220px;
                background: Theme.bg-surface;

                VerticalLayout {
                    Rectangle {
                        height: 38px;
                        background: Theme.bg-elevated;

                        Text {
                            x: 12px;
                            text: "OUTLINE";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            font-weight: 700;
                            vertical-alignment: center;
                            height: parent.height;
                        }
                    }

                    Rectangle { height: 1px; background: Theme.separator; }

                    Rectangle {
                        VerticalLayout {
                            padding: 8px;
                            spacing: 4px;

                            if root.doc-headings.length == 0 : VerticalLayout {
                                vertical-stretch: 1;
                                alignment: center;
                                spacing: 6px;
                                padding: 16px;

                                HorizontalLayout {
                                    alignment: center;
                                    Icon {
                                        commands: Icons.heading;
                                        size: 22px;
                                        tint: Theme.text-dim.transparentize(35%);
                                    }
                                }
                                Text {
                                    text: "No headings yet";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Start a line with # and it shows up here.";
                                    color: Theme.text-dim.transparentize(35%);
                                    font-size: Theme.fs-micro;
                                    horizontal-alignment: center;
                                    wrap: word-wrap;
                                }
                            }
                            if root.doc-headings.length > 0 : ListView {
                                for heading[idx] in root.doc-headings : Rectangle {
                                    height: 28px;
                                    background: heading-ta.has-hover ? Theme.hover-fill : transparent;
                                    border-radius: 4px;

                                    heading-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        // block-index is the heading's byte offset; the handler
                                        // moves the caret there and focuses the page.
                                        clicked => { root.doc-heading-clicked(heading.block-index); }
                                    }

                                    HorizontalLayout {
                                        padding-left: heading.level == 1 ? 8px : (heading.level == 2 ? 20px : 32px);
                                        spacing: 4px;

                                        Text {
                                            text: heading.level == 1 ? "H1" : (heading.level == 2 ? "H2" : "H3");
                                            color: Theme.accent;
                                            font-size: Theme.fs-micro;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                            width: 20px;
                                        }

                                        Text {
                                            text: heading.title;
                                            color: Theme.text-primary;
                                            font-size: heading.level == 1 ? 13px : (heading.level == 2 ? 12px : 11px);
                                            font-weight: heading.level == 1 ? 600 : 400;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }

                // Right border
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.separator;
                }
            }

            // ── Center: the page ──
            //
            // A document editor's job is to make a page. The sheet is a single continuous
            // surface: the body is a plain TextInput, not std-widgets' TextEdit, which draws
            // its own bordered box and made the page look like a form field inside a page.
            Rectangle {
                background: Theme.bg-deep;

                ScrollView {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding-top: 36px;
                        padding-bottom: 56px;
                        alignment: start;

                        HorizontalLayout {
                            alignment: center;

                            Rectangle {
                                width: 700px;
                                min-height: 920px;
                                background: Theme.bg-elevated;
                                border-radius: 4px;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding-left: 78px;
                                    padding-right: 78px;
                                    padding-top: 72px;
                                    padding-bottom: 56px;
                                    spacing: 0px;

                                    // Title
                                    //
                                    // Read out of the document, not typed into. This was a
                                    // TextInput bound to `doc-title`, and what was typed into it
                                    // went nowhere: the title was not part of the file and not
                                    // part of anything else either, so it survived until the next
                                    // load. The title of a Markdown document is its first `# `
                                    // heading, and that is what this shows — press H1 on the
                                    // first line to write one.
                                    Rectangle {
                                        height: 48px;
                                        clip: true;

                                        Text {
                                            x: 0;
                                            width: 100%;
                                            height: 100%;
                                            text: root.doc-title != "" ? root.doc-title : "Untitled document";
                                            color: root.doc-title != "" ? Theme.text-primary : Theme.text-dim.transparentize(30%);
                                            font-size: 30px;
                                            font-weight: 700;
                                            vertical-alignment: bottom;
                                            overflow: elide;
                                        }
                                    }

                                    // Rule under the title — a short accent stroke, not a full line
                                    Rectangle {
                                        height: 26px;
                                        Rectangle {
                                            x: 0;
                                            y: 12px;
                                            width: 44px;
                                            height: 2px;
                                            border-radius: 1px;
                                            background: Theme.accent;
                                        }
                                    }

                                    // Body
                                    Rectangle {
                                        vertical-stretch: 1;
                                        min-height: 640px;

                                        if root.doc-content == "" : Text {
                                            x: 0;
                                            y: 0;
                                            width: 100%;
                                            text: "Start writing. Markdown works here \{"\u{2014}"} # for a heading, - for a list.";
                                            color: Theme.text-dim.transparentize(20%);
                                            font-size: Theme.fs-headline;
                                            wrap: word-wrap;
                                        }

                                        content-edit := TextInput {
                                            x: 0;
                                            y: 0;
                                            width: 100%;
                                            height: 100%;
                                            text <=> root.doc-content;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-headline;
                                            single-line: false;
                                            wrap: word-wrap;
                                            read-only: root.doc-dialog != 0;
                                            selection-background-color: Theme.accent;
                                            edited => { root.doc-content-changed(self.text); }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── What Yantrik knows about this ──
            AgentRail {
                context-items: root.agent-context;
                suggestions: root.agent-suggestions;
                unavailable: root.agent-unavailable;
                context-activated(id) => { root.agent-context-activated(id); }
                suggestion-activated(id) => { root.agent-suggestion-activated(id); }
            }
        }

        // ── Bottom status bar ──
        //
        // Words and characters are measurements of the text. "Sentences", "~N pages" and
        // "N min read" were here beside them and were never set by anything, so they read 0, 0
        // and 0 on every document: a page is not a thing a Markdown file has, and a reading time
        // is a guess about a reader. The tracking badge went with track changes.
        Rectangle {
            height: 28px;
            background: Theme.bg-surface;

            // Top border
            Rectangle {
                height: 1px;
                background: Theme.separator;
            }

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 16px;
                alignment: start;

                Text {
                    text: root.doc-word-count + " words";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                Text {
                    text: root.doc-char-count + " chars";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                Text {
                    text: "Markdown";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                Rectangle {}

                Text {
                    text: root.doc-save-status;
                    color: root.doc-is-modified ? Theme.color-warning : Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }

                Text {
                    text: root.doc-file-path != "" ? root.doc-file-path : "No file yet";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 250px;
                }
            }
        }
    }

    // ── AI Assist Panel (right sidebar) ──
    //
    // One box that asks the companion, and two canned prompts that ask it the same way. The
    // answer comes back as the proposal card above the page — the card that says what applying
    // it would do before the button is pressed — and not as a pane in here with its own Apply.
    Rectangle {
        visible: root.show-ai-panel;
        x: parent.width - 280px;
        y: 80px;  // 36px (tabs) + 44px (command band)
        width: 280px;
        height: parent.height - 80px - 28px;  // minus top bars minus status bar
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.separator;

        VerticalLayout {
            padding: 10px;
            spacing: 8px;

            HorizontalLayout {
                spacing: 6px;
                height: 28px;

                Text {
                    text: "AI Assistant";
                    color: Theme.accent;
                    font-size: Theme.fs-body;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                Rectangle { }
                Rectangle {
                    width: 24px; height: 24px; border-radius: 4px;
                    background: close-ai-ta.has-hover ? Theme.hover-fill : transparent;
                    close-ai-ta := TouchArea { clicked => { root.show-ai-panel = false; } }
                    Text { text: "x"; color: Theme.text-secondary; font-size: Theme.fs-body; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            Rectangle { height: 1px; background: Theme.separator; }

            Text { text: "From this document"; color: Theme.text-secondary; font-size: Theme.fs-micro; }

            HorizontalLayout {
                spacing: 4px;

                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: summarize-ta.has-hover ? AppIdentity.accent.transparentize(0.8) : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.accent.transparentize(0.6);
                    summarize-ta := TouchArea { clicked => { root.doc-ai-summarize(); } }
                    Text { text: "Summarise"; color: Theme.accent; font-size: Theme.fs-micro; horizontal-alignment: center; vertical-alignment: center; }
                }

                Rectangle {
                    height: 28px;
                    border-radius: 4px;
                    background: improve-ta.has-hover ? AppIdentity.accent.transparentize(0.8) : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.accent.transparentize(0.6);
                    improve-ta := TouchArea { clicked => { root.doc-ai-improve(); } }
                    Text { text: "Shorten"; color: Theme.accent; font-size: Theme.fs-micro; horizontal-alignment: center; vertical-alignment: center; }
                }
            }

            Rectangle { height: 1px; background: Theme.separator; }

            Text { text: "Ask about this document"; color: Theme.text-secondary; font-size: Theme.fs-micro; }

            Rectangle {
                height: 60px;
                border-radius: 6px;
                background: Theme.bg-elevated; clip: true;
                border-width: 1px;
                border-color: Theme.separator;

                doc-ai-input := TextInput {
                    x: 8px; y: 6px;
                    width: parent.width - 16px;
                    height: parent.height - 12px;
                    color: Theme.text-primary;
                    font-size: Theme.fs-micro;
                    wrap: word-wrap;
                    single-line: false;
                    text <=> root.doc-ai-prompt;
                    accepted => { root.doc-ai-submit(self.text); }
                }
            }

            Rectangle {
                height: 28px;
                border-radius: 4px;
                background: root.proposal-working ? Theme.text-dim : (submit-doc-ai-ta.has-hover ? Theme.accent-button-hover : Theme.accent);
                submit-doc-ai-ta := TouchArea {
                    enabled: !root.proposal-working;
                    clicked => { root.doc-ai-submit(root.doc-ai-prompt); }
                }
                Text {
                    text: root.proposal-working ? "Thinking..." : "Ask";
                    color: Theme.text-on-accent;
                    font-size: Theme.fs-micro;
                    font-weight: 600;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            Text {
                text: "The answer arrives as a proposal above the page, with what it would replace.";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                wrap: word-wrap;
            }

            Rectangle { vertical-stretch: 1; }
        }
    }

    // ── The file prompt ──
    //
    // Open, Save As and the two exports all need a path, and a document with no file needs one
    // before Save can mean anything. There is no file picker on this machine, so this is a path
    // field — the same prompt the text editor uses, and the same rules: absolute or ~/.
    // Shown with `visible`, not with `if`: the path field has to exist for the focus handler
    // above to be able to put the caret in it when the prompt opens.
    Rectangle {
        visible: root.doc-dialog != 0;
        background: #00000066;
        TouchArea {}

        Rectangle {
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
            width: min(520px, root.width - 48px);
            height: dialog-body.preferred-height;
            border-radius: 14px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;

            dialog-body := VerticalLayout {
                padding: 24px;
                spacing: 14px;

                Text {
                    text: root.doc-dialog == 1 ? "Open a document"
                        : root.doc-dialog == 2 ? "Save this document"
                        : root.doc-dialog == 3 ? "Write a Markdown copy"
                        : root.doc-dialog == 4 ? "Write an HTML copy"
                        : "Keep your changes?";
                    color: Theme.text-primary;
                    font-size: 22px;
                    font-weight: 600;
                }

                Text {
                    text: root.doc-dialog == 5
                        ? "This document has changes that are not on disk."
                        : "Absolute path or ~/ — UTF-8 Markdown, up to 1 MiB.";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                }

                Rectangle {
                    visible: root.doc-dialog != 5;
                    height: root.doc-dialog != 5 ? 34px : 0px;
                    dialog-path-input := LineEdit {
                        width: 100%;
                        height: 34px;
                        text <=> root.doc-dialog-path;
                        placeholder-text: "~/Documents/notes.md";
                        accepted => { root.doc-dialog-confirm(); }
                    }
                }

                if root.doc-dialog-error != "" : Text {
                    text: root.doc-dialog-error;
                    color: Theme.amber;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: 8px;
                    alignment: end;
                    height: 32px;

                    Rectangle {
                        width: 92px;
                        border-radius: 5px;
                        background: cancel-ta.has-hover ? Theme.hover-fill : Theme.bg-card;
                        cancel-ta := TouchArea { clicked => { root.doc-dialog-cancel(); } }
                        Text { text: "Cancel"; color: Theme.text-secondary; font-size: Theme.fs-caption; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    if root.doc-dialog == 5 : Rectangle {
                        width: 92px;
                        border-radius: 5px;
                        background: discard-ta.has-hover ? Theme.color-danger : transparent;
                        border-width: 1px;
                        border-color: Theme.color-danger;
                        discard-ta := TouchArea { clicked => { root.doc-dialog-discard(); } }
                        Text { text: "Discard"; color: discard-ta.has-hover ? Theme.text-on-danger : Theme.color-danger; font-size: Theme.fs-caption; horizontal-alignment: center; vertical-alignment: center; }
                    }

                    Rectangle {
                        width: 92px;
                        border-radius: 5px;
                        background: confirm-ta.has-hover ? Theme.accent-button-hover : Theme.accent;
                        confirm-ta := TouchArea { clicked => { root.doc-dialog-confirm(); } }
                        Text {
                            text: root.doc-dialog == 1 ? "Open" : "Save";
                            color: Theme.text-on-accent;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
    }
}
