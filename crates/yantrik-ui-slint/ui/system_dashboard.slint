// System Dashboard — resource visualization.
// Screen 10. CPU, RAM, battery, network, top processes.
// Real-time CPU and memory charts with 60-second history.

import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { LineChart } from "components/line_chart.slint";

export struct ProcessData {
    name: string,
    pid: int,
    cpu-percent: float,
}

export component SystemDashboard inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    background: Theme.bg-deep;

    in property <float> cpu-usage: 0.0;
    in property <float> memory-usage: 0.0;
    in property <string> memory-text: "0 / 0 MB";
    // Memory breakdown
    in property <float> memory-used-percent: 0.0;
    in property <float> memory-cached-percent: 0.0;
    in property <string> memory-used-text: "";
    in property <string> memory-cached-text: "";
    // The row beside this is labelled "Free", and it was bound to the total.
    in property <string> memory-free-text: "";
    // Swap
    in property <float> swap-usage: 0.0;
    in property <string> swap-text: "";

    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <bool> battery-charging: false;
    // ── The network row ──
    //
    // Three properties and not `wifi-connected`. This row was the word "WiFi"
    // typed into the file, with NetworkManager's "Wired connection 1" beside
    // it, on a machine whose only interface is `ens18`. What the network
    // service reports is the medium — the label — and the connection, and
    // whether anything is up at all, which is true of a wired machine.
    in property <bool> network-online: false;
    in property <string> network-label: "Network";
    in property <string> network-detail: "";
    in property <string> uptime-text: "";
    in property <[ProcessData]> top-processes: [];

    // Chart history (last 60 data points, 0.0-1.0 normalized)
    in property <[float]> cpu-history: [];
    in property <[float]> memory-history: [];

    callback back-pressed();

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // Was a hand-rolled bar whose back button was the CHARACTER "left arrow" in a TouchArea.
        // A glyph is only an icon if the font has it; the same habit put an emoji in the Memory
        // browser's search field, where it drew as nothing and made the whole field look blank.
        // AppHeader's back button is a stroke path from the Icons set.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            // VM 520 sweep, 4 October: System was the one AppHeader screen with no app-id, so
            // its glyph wore the house accent instead of its own colour and AppIdentity kept
            // whichever app had been open before it.
            app-id: "system";
            show-back: true;
            icon: Icons.monitor;
            title: "System";
            back => { root.back-pressed(); }
        }

        // Content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 20px;
                spacing: 16px;
                alignment: start;

                // ── Resources section ──
                Text {
                    text: "RESOURCES";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    letter-spacing: 2px;
                }

                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: res-layout.preferred-height;

                    res-layout := VerticalLayout {
                        padding: 14px;
                        spacing: 12px;

                        // CPU bar
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                Text {
                                    text: "CPU";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: Math.round(root.cpu-usage) + "%";
                                    // Normal data is the accent and danger is red; nothing between.
                                    // It was teal (the minds' colour) and amber past 50% (amber
                                    // means "needs you", and a busy CPU does not).
                                    color: root.cpu-usage > 80 ? Theme.color-emotional : Theme.accent;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                }
                            }

                            Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.bg-deep;

                                Rectangle {
                                    // From the left edge: a child of a Rectangle is centred by default.
                                    x: 0;
                                    width: max(0px, parent.width * root.cpu-usage / 100);
                                    height: 100%;
                                    border-radius: 3px;
                                    background: root.cpu-usage > 80 ? Theme.color-emotional : Theme.accent;
                                    animate width { duration: 300ms; }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // Memory stacked bar
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                Text {
                                    text: "Memory";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.memory-text;
                                    color: root.memory-usage > 85 ? Theme.color-emotional : Theme.text-primary;
                                    font-size: Theme.font-small;
                                }
                            }

                            // Stacked bar: [used (accent)] [cached (dim accent)] [free (dark)].
                            // Cached was amber, which is "needs you" only (colour system); it is
                            // the same data at a lower weight, so the same hue, dimmer.
                            Rectangle {
                                height: 8px;
                                border-radius: 4px;
                                background: Theme.bg-deep;
                                clip: true;

                                // Used segment
                                Rectangle {
                                    x: 0px;
                                    width: max(0px, parent.width * root.memory-used-percent / 100);
                                    height: 100%;
                                    background: root.memory-usage > 85 ? Theme.color-emotional : Theme.accent;
                                    animate width { duration: 300ms; }
                                }

                                // Cached segment
                                Rectangle {
                                    x: max(0px, parent.width * root.memory-used-percent / 100);
                                    width: max(0px, parent.width * root.memory-cached-percent / 100);
                                    height: 100%;
                                    background: Theme.accent;
                                    opacity: 0.4;
                                    animate x { duration: 300ms; }
                                    animate width { duration: 300ms; }
                                }
                            }

                            // Legend row
                            HorizontalLayout {
                                spacing: 12px;
                                alignment: start;

                                // Used dot + label
                                HorizontalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        y: (parent.height - 6px) / 2;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                    }
                                    Text {
                                        text: "Used: " + root.memory-used-text;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }
                                }

                                // Cached dot + label
                                HorizontalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        y: (parent.height - 6px) / 2;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                        opacity: 0.4;
                                    }
                                    Text {
                                        text: "Cached: " + root.memory-cached-text;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }
                                }

                                // Free dot + label
                                HorizontalLayout {
                                    spacing: 4px;
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        y: (parent.height - 6px) / 2;
                                        border-radius: 3px;
                                        background: Theme.bg-deep;
                                        border-width: 1px;
                                        border-color: Theme.text-dim;
                                    }
                                    Text {
                                        text: "Free: " + root.memory-free-text;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // Swap bar
                        VerticalLayout {
                            spacing: 4px;

                            HorizontalLayout {
                                Text {
                                    text: "Swap";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.swap-text;
                                    color: root.swap-usage > 80 ? Theme.color-emotional : Theme.text-dim;
                                    font-size: Theme.font-small;
                                }
                            }

                            Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.bg-deep;

                                Rectangle {
                                    // From the left edge: a child of a Rectangle is centred by default.
                                    x: 0;
                                    width: max(0px, parent.width * root.swap-usage / 100);
                                    height: 100%;
                                    border-radius: 3px;
                                    background: root.swap-usage > 80 ? Theme.color-emotional : Theme.accent;
                                    opacity: 0.8;
                                    animate width { duration: 300ms; }
                                }
                            }
                        }
                    }
                }

                // ── Resource graphs section ──
                Text {
                    text: "HISTORY (60s)";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    letter-spacing: 2px;
                }

                LineChart {
                    title: "CPU";
                    values: root.cpu-history;
                    current-text: Math.round(root.cpu-usage) + "%";
                    accent-color: root.cpu-usage > 80 ? Theme.color-emotional : Theme.accent;
                    accent-glow: root.cpu-usage > 80 ? Theme.color-danger.transparentize(75%) : Theme.accent-glow;
                    height: 140px;
                    width: 100%;
                }

                LineChart {
                    title: "MEMORY";
                    values: root.memory-history;
                    current-text: root.memory-text;
                    accent-color: root.memory-usage > 85 ? Theme.color-emotional : Theme.accent;
                    accent-glow: root.memory-usage > 85 ? Theme.color-danger.transparentize(75%) : Theme.accent-glow;
                    height: 140px;
                    width: 100%;
                }

                // ── Status section ──
                Text {
                    text: "STATUS";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    letter-spacing: 2px;
                }

                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: status-layout.preferred-height;

                    status-layout := VerticalLayout {
                        padding: 14px;
                        spacing: 10px;

                        // Battery (hidden when no hardware)
                        HorizontalLayout {
                            visible: root.battery-available;
                            Text {
                                text: "Battery";
                                color: Theme.text-secondary;
                                font-size: Theme.font-body;
                                horizontal-stretch: 1;
                            }

                            HorizontalLayout {
                                spacing: 6px;

                                // Mini battery bar
                                Rectangle {
                                    width: 32px;
                                    height: 12px;
                                    y: (parent.height - 12px) / 2;
                                    border-radius: 3px;
                                    border-width: 1px;
                                    border-color: root.battery-level <= 20 ? Theme.color-emotional : Theme.text-dim;

                                    Rectangle {
                                        x: 2px; y: 2px;
                                        width: max(0px, (parent.width - 6px) * root.battery-level / 100);
                                        height: parent.height - 6px;
                                        border-radius: 1px;
                                        background: !root.battery-charging && root.battery-level <= 20 ? Theme.color-emotional : Theme.accent;
                                    }
                                }

                                Text {
                                    text: root.battery-level + "%" +
                                          (root.battery-charging ? " charging" : "");
                                    color: root.battery-level <= 20 ? Theme.color-emotional : Theme.text-primary;
                                    font-size: Theme.font-body;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // Network
                        HorizontalLayout {
                            Text {
                                text: root.network-label;
                                color: Theme.text-secondary;
                                font-size: Theme.font-body;
                                horizontal-stretch: 1;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                // Connection dot
                                Rectangle {
                                    width: 8px;
                                    height: 8px;
                                    y: (parent.height - 8px) / 2;
                                    border-radius: 4px;
                                    background: root.network-online ? Theme.accent : Theme.color-emotional;
                                }

                                Text {
                                    text: root.network-detail != "" ? root.network-detail :
                                          (root.network-online ? "Connected" : "Disconnected");
                                    color: root.network-online ? Theme.text-primary : Theme.text-dim;
                                    font-size: Theme.font-body;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // Uptime
                        HorizontalLayout {
                            Text {
                                text: "Uptime";
                                color: Theme.text-secondary;
                                font-size: Theme.font-body;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: root.uptime-text != "" ? root.uptime-text : "—";
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                            }
                        }
                    }
                }

                // ── Top Processes section ──
                Text {
                    text: "TOP PROCESSES";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    letter-spacing: 2px;
                }

                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: proc-layout.preferred-height;

                    proc-layout := VerticalLayout {
                        padding: 14px;
                        spacing: 6px;

                        // Column headers
                        HorizontalLayout {
                            spacing: 8px;

                            Text {
                                text: "Name";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: "PID";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                                min-width: 50px;
                            }
                            Text {
                                text: "CPU";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                                min-width: 44px;
                                horizontal-alignment: right;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        if root.top-processes.length == 0 : Text {
                            text: "No process data";
                            color: Theme.text-dim;
                            font-size: Theme.font-small;
                        }

                        for proc in root.top-processes : HorizontalLayout {
                            spacing: 8px;
                            height: 24px;

                            Text {
                                text: proc.name;
                                color: Theme.text-primary;
                                font-size: Theme.font-small;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }

                            Text {
                                text: proc.pid;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                min-width: 50px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: Math.round(proc.cpu-percent * 10) / 10 + "%";
                                color: proc.cpu-percent > 80 ? Theme.color-emotional :
                                       proc.cpu-percent > 50 ? Theme.text-primary :
                                       Theme.text-secondary;
                                font-size: Theme.font-small;
                                font-weight: 500;
                                min-width: 44px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Bottom spacer
                Rectangle { height: 32px; }
            }
        }
    }
}
