// Agents — the workroom (screen 34), and one agent in a window of its own.
//
// The screen is a workroom (design/minds-surfaces-spec-2026-10-02.md, section 2): a navigation
// (Workroom · Needs you · History, then each mind), the decisions waiting on the person, a desk
// for each mind at work, and — when a run is opened — its task detail: the changes recorded, an
// activity timeline that reads like prose, and the run's details. Its overview pieces are in
// agents_workroom.slint, agents_nav.slint and agents_task.slint, and the Start work sheet in
// agents_start.slint; all are drawn from props.
//
// Everything here reads one global, AgentsState, which the shell fills from
// crates/yantrik-ui/src/wire/agents.rs and wire/agents_workroom.rs. A popped-out window has its
// own instance of the global, so the same session components draw the screen's detail and every
// window. See design/agents-workspace-2026-09-23.md for the session itself.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { YButton } from "components/y_button.slint";
import { YInput } from "components/y_input.slint";
import { YNoticeBar } from "components/notice_bar.slint";
import { ToolCallData, ToolCallCard } from "components/tool_call.slint";
import { ApprovalRequest, ApprovalCard } from "components/intent_lens.slint";
import { QuestionCard } from "components/question_card.slint";
import { WorkCardData } from "components/work_card.slint";
import { JumpToPresent } from "jump_to_present.slint";
import { YContextMenu } from "components/y_context_menu.slint";
import {
    WorkNavData, DeskCardData, DecisionData, ResultData, ChangeRowData, ChildRunData, RunFactData, MindMark,
    WorkroomOverview, NeedsPage, HistoryPage,
} from "agents_workroom.slint";
import { WorkNav } from "agents_nav.slint";
import { ChangesLedger, ChildRuns, RunDetails, ConfirmDialog } from "agents_task.slint";
import { AgentMindData, AgentRoleData, StartSheet } from "agents_start.slint";
export { WorkNavData, DeskCardData, DecisionData, ResultData, ChangeRowData, ChildRunData, RunFactData } from "agents_workroom.slint";
export { AgentMindData, AgentRoleData } from "agents_start.slint";

// One run of same-looking cells in a command's terminal.
export struct AgentRunData {
    text: string,
    row: int,
    col: int,
    columns: int,
    fg: color,
    bg: color,
    bold: bool,
}

// One thing in a session: a prompt, the mind's text, its thinking, a note from the shell, a card,
// or an approval the shell asked the person for on this agent's behalf.
export struct AgentItemData {
    kind: string,          // prompt | text | thinking | note | card | approval | question
    key: string,           // stable across redraws; what `toggle` names
    text: string,
    // For a prompt: who sent it — "Council recipe" or the starting agent's id (`deepseek:c-…`),
    // the row's own attribution. "" for one the person typed, which draws as "you".
    sent-by: string,
    call: ToolCallData,    // a card's call, as ToolCallCard draws it
    badge: string,         // "verified · exit 0" / "reported"
    explain: string,       // shown open: how it ended, or why the shell made the card itself
    expanded: bool,
    live: bool,            // running: its output shows under the line even while folded
    output-kind: string,   // "" | text | terminal
    output: string,        // text output shown under the line while it runs
    more: string,          // "the last 8 of 212 lines"
    can-open-all: bool,
    runs: [AgentRunData],
    rows: int,
    // For an approval: the shell's own card, from the shell's approval store under one request id
    // — the same data the Lens draws. Never anything the agent said.
    approval: ApprovalRequest,
    // For the mind's text, one markdown block per item (the Lens's parser, crate::markdown):
    // text | heading | bullet | code, or "" for plain text drawn as it is. `text` is the block
    // with its markers stripped; `styled` is a paragraph's or a list's bold, italic, inline code
    // and links, which one StyledText draws and a Text cannot.
    block: string,
    styled: styled-text,
    // For a question the agent asked (#25): its request id, the answers it offers (none: a free
    // answer) and what the person answered, "" while it waits. `explain` says why it closed;
    // `asked` is when it was asked ("16:16"), so two cards with the same words can be told apart.
    request: string,
    options: [string],
    // For a card: some of its free text holds words the person had erased, and is drawn with the
    // marker. `revealed`: the person asked, in this pane, to see it as it was.
    masked: bool,
    revealed: bool,
    // For a Keep/Erase question: what Erase removes, as the shell parsed it from the prompt.
    removes: string,
    answer: string,
    asked: string,
}

export struct AgentHeaderData {
    id: string,
    mind: string,
    title: string,         // the run's name: its task's first sentence, "Command: …", or "Untitled run"
    raw: string,           // the prompt as it was sent, when the title does not already say it all
    state: string,
    label: string,
    since: string,
    status: string,        // the agent's own account of what it is doing
    note: string,          // "pi holds one conversation at a time — the one the Lens talks to."
    can-send: bool,
    send-hint: string,     // why the prompt box is closed, when it is
    tell-hint: string,     // a stuck task: why, and that sending interrupts the stuck step (#234)
    can-stop: bool,
}

export struct AgentDetailsData {
    mind: string,
    model: string,
    since: string,
    turns: string,
    calls: string,
    commands: string,
    command-lines: string,
    files: string,
    file-lines: string,
    approvals: string,
    tokens: string,
    cost: string,
    refused: string,
    // Behind the count: what arrived and why the store refused it, one line each, oldest of the
    // kept lines first (#212). "" for an agent nothing was refused for, and for a session saved
    // before the lines were kept — then the count is all there is, as it was.
    refused-lines: string,
    basis: string,
    role: string,          // the catalog role it was started as, if any
    reach: string,         // what that role may touch, in words a person reads: "the Editor,
                           // Documents and Notes, and it may ask for safe acts"
    // The patterns the words are made from — the ones the doors enforce — one click away under
    // them (#212): "editor, documents and notes · at most safe". "" when there is no second
    // form to open.
    reach-patterns: string,
}

export global AgentsState {
    // What the Lens's conversation shows of the runs it started (Chat v2): one card per run,
    // the run the strip describes, how many are live, and how many of those wait on the person.
    // Filled by wire/agents.rs from the same store as the workroom.
    in-out property <[WorkCardData]> lens-cards: [];
    in-out property <WorkCardData> lens-strip;
    in-out property <int> lens-live: 0;
    in-out property <int> lens-waiting: 0;
    // "Built-in mind" or "Attached mind", for the conversation header.
    in-out property <string> lens-identity: "";
    // The run opened on the screen, or the one a window shows.
    in-out property <string> selected: "";
    // The agent shown: the selected one on the screen, the window's own in a popped-out window.
    in-out property <bool> has-agent: false;
    in-out property <AgentHeaderData> header;
    in-out property <[AgentItemData]> items: [];
    in-out property <AgentDetailsData> details;
    in-out property <bool> popped: false;
    // New agent.
    in-out property <[AgentMindData]> minds: [];
    in-out property <bool> new-open: false;
    in-out property <string> new-mind: "";
    in-out property <string> new-note: "";
    // The reach patterns behind the note's words, one click away in the dialog (#212). Empty
    // for a mind, which has no reach of its own, and for a session saved before words were kept.
    in-out property <string> new-note-reach: "";
    in-out property <string> new-error: "";
    // New agent → from the catalog: a role instead of a mind.
    in-out property <[AgentRoleData]> roles: [];
    in-out property <bool> new-from-catalog: false;
    in-out property <string> new-role: "";
    // What the last press came to, when it did not go as asked.
    in-out property <string> notice: "";
    // ── The workroom ──
    // Which page: workroom | needs_you | history. A run opened over any of them is `detail-open`.
    in-out property <string> section: "workroom";
    in-out property <bool> detail-open: false;
    // The mind the workroom is narrowed to (its harness id and its name), or "".
    in-out property <string> mind-filter: "";
    in-out property <string> mind-filter-name: "";
    // The header's counts, as the shell words them: "2 working · 1 needs you".
    in-out property <string> summary: "";
    in-out property <int> needs-count: 0;
    in-out property <int> request-minds: 0;
    in-out property <int> runs-count: 0;
    // The overview's own counts, which are the narrowed mind's when one is chosen: its requests
    // and the minds they come from, and its finished runs.
    in-out property <int> shelf-count: 0;
    in-out property <int> shelf-minds: 0;
    in-out property <int> view-runs: 0;
    in-out property <[WorkNavData]> nav-minds: [];
    in-out property <[DeskCardData]> desks: [];
    // Every request waiting, oldest first, and the first three of them for the shelf.
    in-out property <[DecisionData]> decisions: [];
    in-out property <[DecisionData]> shelf: [];
    in-out property <[ResultData]> recent: [];
    in-out property <[ResultData]> history: [];
    // The opened run: its state in the screen's vocabulary, the mode in force, the ledger and facts.
    in-out property <string> detail-state: "";
    in-out property <string> detail-label: "";
    in-out property <string> detail-mode: "";
    in-out property <[ChangeRowData]> changes: [];
    in-out property <bool> changes-recorded: false;
    in-out property <[RunFactData]> run-facts: [];
    // Runs the opened one started (a hand-off): listed under its changes, each opens its own run.
    in-out property <[ChildRunData]> child-runs: [];
    // A desk's "more" menu, by the desk's key and where it opened; and a Stop asked, not yet
    // confirmed.
    in-out property <string> menu-key: "";
    in-out property <length> menu-x: 0;
    in-out property <length> menu-y: 0;
    in-out property <string> confirm-stop: "";
    // The desktop's mode as a sentence, for Start work.
    in-out property <string> mode-line: "";

    callback show-section(string);
    callback filter-mind(string);
    callback back();
    callback chat-with(string);
    callback select(string);
    callback pop-out(string);
    callback stop(string);
    callback toggle(string, bool);
    callback open-all(string);
    callback pick-mind(string);
    callback start(string, string);
    callback pick-role(string);
    // A role's id and the task: the shell hands it off as the person (`hand_off`).
    callback start-role(string, string);
    callback send(string, string);
    callback dismiss-notice();
    // An approval card in a pane. Each names the one request id; the shell answers it through the
    // same Allow and Deny the Lens's card calls, so answering here answers it there.
    callback approval-allow(string);
    callback approval-allow-session(string);
    callback approval-deny(string);
    // The person answered a question the agent asked (#25): agent id, request id, answer.
    callback answer-question(string, string, string, bool);   // agent, request, answer, pressed
    // Show one agent on the Agents screen — the Lens's "open in Agents", a notification's Open,
    // `show_agent`.
    callback show-agent(string);
}

component StateDot inherits Rectangle {
    in property <string> state;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    background: root.state == "waiting_for_you" ? Theme.amber
        : root.state == "thinking" || root.state == "running_tool" ? Theme.cyan
        : root.state == "done" ? Theme.color-success
        : root.state == "failed" ? Theme.color-danger
        : Theme.text-dim;
}

// A command's terminal, drawn from cells — the Terminal app's canvas, at card size. Only cells are
// drawn: a command cannot set this window's title, write the clipboard or draw a link.
component TerminalCells inherits Rectangle {
    in property <[AgentRunData]> runs;
    in property <int> rows;
    property <length> cell-w: measure.preferred-width / 100;
    property <length> cell-h: 15px;
    height: max(1, root.rows) * root.cell-h + 12px;
    background: #10171e;
    border-radius: 4px;
    clip: true;
    measure := Text {
        text: "MMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMMM";
        font-family: Theme.font-mono;
        font-size: 11px;
        visible: false;
    }
    for run in root.runs : Rectangle {
        x: 6px + run.col * root.cell-w;
        y: 6px + run.row * root.cell-h;
        width: run.columns * root.cell-w;
        height: root.cell-h;
        background: run.bg;
        Text {
            x: 0px;
            y: 0px;
            width: parent.width;
            height: parent.height;
            text: run.text;
            color: run.fg;
            font-family: Theme.font-mono;
            font-size: 11px;
            font-weight: run.bold ? 700 : 400;
            vertical-alignment: center;
        }
    }
}

component ItemView inherits Rectangle {
    in property <AgentItemData> item;
    // How tall an approval card here may be: the pane's own scroller's visible height, less what
    // sits around the card inside it. Every host passes it, so the card in a pane takes the same
    // three cases as in the Lens and the corner (intent_lens.slint, `height-limit`): the whole
    // card fits in view at once, and when its pinned lines do not, Allow waits until the card's
    // own scroll has been to its end. Without it the card was as tall as it liked, the gate never
    // applied, and the pane's scroll could put the arguments out of view with Allow still on
    // screen. A host that forgot it would leave 0px: a card that scrolls in no room and so never
    // allows, which fails closed (Decline stays live).
    in property <length> card-limit;
    VerticalLayout {
        padding-top: 2px;
        padding-bottom: 2px;
        // A list sits in from the paragraphs around it.
        padding-left: root.item.kind == "text" && root.item.block == "bullet" ? 8px : 0px;

        if root.item.kind == "prompt" : Rectangle {
            border-radius: 10px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;
            HorizontalLayout {
                padding: 8px;
                padding-left: 12px;
                spacing: 10px;
                Text {
                    // Who sent this prompt (#194): a recipe's or a starting agent's name, or
                    // "you" for one the person typed. A long id elides; the row says it in full.
                    text: root.item.sent-by == "" ? "you" : root.item.sent-by;
                    min-width: 30px;
                    max-width: 150px;
                    overflow: elide;
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                }
                Text {
                    text: root.item.text;
                    color: Theme.text-primary;
                    font-size: Theme.fs-body;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }
        }

        // The mind's text, a markdown block per item. A paragraph or a list is one StyledText —
        // the only element that draws bold, italic and code inside one wrapped run, on the
        // software renderer as on the GPU one. A heading and a code block are drawn as the Lens's
        // bubble draws them. Each wrapping text is a direct child of this layout, or sized from
        // its own preferred height: a text inside a nested layout is measured at its unwrapped
        // width, and the lines past the first are cut off.
        if root.item.kind == "text" && (root.item.block == "text" || root.item.block == "bullet") : StyledText {
            text: root.item.styled;
            default-color: Theme.text-primary;
            default-font-size: Theme.fs-body;
            link-color: Theme.accent;
        }
        if root.item.kind == "text" && root.item.block == "heading" : Text {
            text: root.item.text;
            color: Theme.amber-light;
            font-size: Theme.font-title;
            font-weight: 600;
            wrap: word-wrap;
        }
        if root.item.kind == "text" && root.item.block == "code" : Rectangle {
            background: Theme.bg-input;
            border-radius: 6px;
            border-width: 1px;
            border-color: Theme.border-subtle;
            height: code.preferred-height + 16px;
            code := Text {
                x: 10px;
                y: 8px;
                width: parent.width - 20px;
                text: root.item.text;
                color: Theme.cyan-light;
                font-family: Theme.font-mono;
                font-size: Theme.font-small;
                wrap: word-wrap;
            }
        }
        // Text with no block: drawn as it is.
        if root.item.kind == "text" && root.item.block == "" : Text {
            text: root.item.text;
            color: Theme.text-primary;
            font-size: Theme.fs-body;
            wrap: word-wrap;
        }

        // The mind's reasoning, folded to one line until asked for.
        if root.item.kind == "thinking" : Rectangle {
            HorizontalLayout {
                spacing: 6px;
                VerticalLayout {
                    padding-top: 3px;
                    alignment: start;
                    Icon {
                        commands: root.item.expanded ? Icons.chevron-down : Icons.chevron-right;
                        size: 12px;
                        tint: Theme.text-dim;
                    }
                }
                Text {
                    text: "thinking";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    font-italic: true;
                }
                Text {
                    text: root.item.text;
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    wrap: root.item.expanded ? TextWrap.word-wrap : TextWrap.no-wrap;
                    overflow: root.item.expanded ? TextOverflow.clip : TextOverflow.elide;
                    horizontal-stretch: 1;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { AgentsState.toggle(root.item.key, !root.item.expanded); }
            }
        }

        // A run of calls, folded to one line a person reads; the calls are under it when open.
        if root.item.kind == "group" : Rectangle {
            height: 40px;
            border-radius: Theme.r-md;
            background: group-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
            accessible-role: button;
            accessible-label: root.item.text;
            accessible-expanded: root.item.expanded;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;
                VerticalLayout {
                    alignment: center;
                    Icon {
                        commands: root.item.expanded ? Icons.chevron-down : Icons.chevron-right;
                        size: 14px;
                        tint: Theme.text-secondary;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: root.item.text;
                        color: Theme.text-primary;
                        font-size: Theme.fs-caption;
                        font-weight: 600;
                        overflow: elide;
                    }
                    if root.item.explain != "" : Text {
                        text: root.item.explain;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        overflow: elide;
                    }
                }
            }
            group-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { AgentsState.toggle(root.item.key, !root.item.expanded); }
            }
        }

        if root.item.kind == "note" : Text {
            text: root.item.text;
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            font-italic: true;
            wrap: word-wrap;
        }

        // An approval: the shell's own card (the Lens's component), with Allow and Deny bound to
        // the one request id. Waiting, it is the whole card; answered, the line it leaves. Only the
        // shell makes this item — never a harness event or a line of the agent's text — so nothing
        // an agent says can draw these buttons.
        if root.item.kind == "approval" : ApprovalCard {
            data: root.item.approval;
            height-limit: root.card-limit;
            allow => { AgentsState.approval-allow(root.item.approval.id); }
            allow-session => { AgentsState.approval-allow-session(root.item.approval.id); }
            deny => { AgentsState.approval-deny(root.item.approval.id); }
        }

        // A question the agent itself asked (#25): the shared card, drawn as the agent speaking.
        if root.item.kind == "question" : QuestionCard {
            mind: AgentsState.header.mind;
            prompt: root.item.text;
            options: root.item.options;
            answer: root.item.answer;
            closed: root.item.explain;
            asked: root.item.asked;
            removes: root.item.removes;
            answered(a, pressed) => { AgentsState.answer-question(AgentsState.header.id, root.item.request, a, pressed); }
        }

        // A call: the one card every view of a mind's calls shares (#125), with the call's own
        // output under it — its terminal while it runs, all of it when opened.
        if root.item.kind == "card" : ToolCallCard {
            call: root.item.call;
            badge: root.item.badge;
            expanded: root.item.expanded;
            toggled(open) => { AgentsState.toggle(root.item.key, open); }

            if root.item.expanded && root.item.explain != "" : Text {
                text: root.item.explain;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }
            // Words the person had erased are drawn with the marker; the call itself kept them.
            // Only here, and only for the person, can it be shown as it was.
            if root.item.masked : HorizontalLayout {
                Rectangle {
                    width: reveal.preferred-width;
                    reveal := Text {
                        text: root.item.revealed ? "Hide what was erased here" : "Show what was erased here";
                        color: Theme.accent;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AgentsState.toggle("reveal:" + root.item.key, !root.item.revealed); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
            if root.item.output-kind == "terminal" && (root.item.expanded || root.item.live) : TerminalCells {
                runs: root.item.runs;
                rows: root.item.rows;
            }
            if root.item.output-kind == "text" && root.item.live && !root.item.expanded && root.item.output != "" : Rectangle {
                background: Theme.bg-input;
                border-radius: 4px;
                HorizontalLayout {
                    padding: 6px;
                    Text {
                        text: root.item.output;
                        color: Theme.text-primary;
                        font-family: Theme.font-mono;
                        font-size: Theme.font-small;
                        wrap: word-wrap;
                        horizontal-stretch: 1;
                    }
                }
            }
            if root.item.more != "" && (root.item.expanded || root.item.live) : HorizontalLayout {
                spacing: 10px;
                Text {
                    text: root.item.more;
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                }
                if root.item.can-open-all : Rectangle {
                    width: open-all.preferred-width;
                    open-all := Text {
                        text: "Open all in Editor";
                        color: Theme.accent;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                    }
                    TouchArea {
                        mouse-cursor: pointer;
                        clicked => { AgentsState.open-all(root.item.key); }
                    }
                }
                Rectangle { horizontal-stretch: 1; }
            }
        }
    }
}

// One agent's session: who and what, then everything that happened, then a box to say more.
export component AgentSession inherits Rectangle {
    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    // Follow the newest line while the person is at the bottom, stay put once they scroll up,
    // and "Jump to present" to come back: the kit's JumpToPresent, over the transcript below.
    // Another agent opened starts at its newest line.
    property <string> shown: AgentsState.header.id;
    changed shown => { session-follow.jump(); }

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;

        HorizontalLayout {
            spacing: 8px;
            height: 26px;
            VerticalLayout {
                alignment: center;
                StateDot { state: AgentsState.header.state; }
            }
            Text {
                text: AgentsState.header.mind + " · " + AgentsState.header.title;
                color: Theme.text-primary;
                font-size: Theme.fs-body-strong;
                font-weight: 600;
                overflow: elide;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            Text {
                text: AgentsState.header.since == "" ? AgentsState.header.label : AgentsState.header.label + " · " + AgentsState.header.since;
                color: AgentsState.header.state == "waiting_for_you" ? Theme.amber : Theme.text-secondary;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
            }
        }
        if AgentsState.header.status != "" : Text {
            text: AgentsState.header.status;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            overflow: elide;
        }
        if AgentsState.header.note != "" : Text {
            text: AgentsState.header.note;
            color: Theme.text-dim;
            font-size: Theme.fs-micro;
            wrap: word-wrap;
        }
        Rectangle {
            height: 1px;
            background: Theme.separator;
        }

        Rectangle {
            vertical-stretch: 1;
            flick := Flickable {
                width: 100%;
                height: 100%;
                viewport-width: self.width;
                viewport-height: items-col.preferred-height;
                // A Rectangle between the Flickable and the layout, on purpose: a Flickable whose
                // child is a layout takes that layout's max-height as its own, and a session of three
                // cards would then cap the whole screen at the height of three cards.
                Rectangle {
                    width: flick.width;
                    height: items-col.preferred-height;
                    items-col := VerticalLayout {
                        spacing: 6px;
                        padding-right: 6px;
                        for item in AgentsState.items : ItemView {
                            item: item;
                            // The scroller's height, less the item's own 2px above and below.
                            card-limit: flick.height - 4px;
                        }
                    }
                }
            }
            session-follow := JumpToPresent {
                width: 100%;
                height: 100%;
                viewport-y <=> flick.viewport-y;
                viewport-height: flick.viewport-height;
                visible-height: flick.height;
            }
        }

        HorizontalLayout {
            spacing: 8px;
            composer := YInput {
                horizontal-stretch: 1;
                disabled: !AgentsState.header.can-send;
                placeholder: AgentsState.header.tell-hint != "" ? AgentsState.header.tell-hint
                    : AgentsState.header.can-send ? "type to " + AgentsState.header.mind + "…" : AgentsState.header.send-hint;
                accepted(text) => {
                    AgentsState.send(AgentsState.header.id, text);
                    self.value = "";
                }
            }
            YButton {
                label: "Send";
                icon-path: Icons.send;
                variant: 0;
                size: 1;
                disabled: !AgentsState.header.can-send;
                clicked => {
                    AgentsState.send(AgentsState.header.id, composer.value);
                    composer.value = "";
                }
            }
        }
    }

    if !AgentsState.has-agent : Rectangle {
        background: Theme.bg-card;
        VerticalLayout {
            padding: Theme.sp-6;
            alignment: center;
            spacing: Theme.sp-2;
            Text {
                text: "No agent selected.";
                color: Theme.text-primary;
                font-size: Theme.fs-body-strong;
                horizontal-alignment: center;
            }
            Text {
                text: "Start one with New agent. A request you make in the Lens shows up here as a run once it does work, with every call it makes as a card; plain conversation stays in the chat.";
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
                horizontal-alignment: center;
            }
        }
    }
}

component DetailRow inherits Rectangle {
    in property <string> label;
    in property <string> value;
    height: 20px;
    HorizontalLayout {
        spacing: 8px;
        Text {
            text: root.label;
            width: 76px;
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
        }
        Text {
            text: root.value == "" ? "—" : root.value;
            color: Theme.text-primary;
            font-size: Theme.fs-caption;
            overflow: elide;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
}

// Details, and the two acts: Stop, and Close.
export component AgentDetailsColumn inherits Rectangle {
    background: Theme.bg-card;
    border-radius: 12px;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: 4px;
        Text {
            text: "DETAILS";
            color: Theme.text-dim;
            font-size: Theme.fs-micro;
            letter-spacing: 2px;
        }
        if AgentsState.details.role != "" : DetailRow { label: "Role"; value: AgentsState.details.role; }
        // What the role may touch — held on every door, not advice.
        if AgentsState.details.role != "" : Text {
            text: "Reach · " + AgentsState.details.reach;
            color: Theme.text-secondary;
            font-size: Theme.fs-micro;
            wrap: word-wrap;
        }
        // The words are made from the patterns the doors enforce; the patterns stay one click
        // away, in the mono they are written in (#212). The whole box is the toggle, as the
        // session's "thinking" fold is.
        if AgentsState.details.reach-patterns != "" : reach-toggle := Rectangle {
            property <bool> open: false;
            height: reach-col.preferred-height;
            reach-col := VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    spacing: 4px;
                    alignment: start;
                    Text {
                        text: reach-toggle.open ? "hide the exact patterns" : "the exact patterns";
                        color: Theme.accent;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                    }
                    Icon {
                        commands: reach-toggle.open ? Icons.chevron-down : Icons.chevron-right;
                        size: 10px;
                        tint: Theme.text-dim;
                    }
                }
                if reach-toggle.open : Text {
                    text: AgentsState.details.reach-patterns;
                    color: Theme.text-dim;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-micro;
                    wrap: word-wrap;
                }
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { reach-toggle.open = !reach-toggle.open; }
            }
        }
        DetailRow { label: "Mind"; value: AgentsState.details.mind; }
        DetailRow { label: "Model"; value: AgentsState.details.model; }
        DetailRow { label: "Since"; value: AgentsState.details.since; }
        DetailRow { label: "Turns"; value: AgentsState.details.turns; }
        DetailRow { label: "Calls"; value: AgentsState.details.calls; }
        DetailRow { label: "Commands"; value: AgentsState.details.commands; }
        DetailRow { label: "Files"; value: AgentsState.details.files; }
        DetailRow { label: "Approvals"; value: AgentsState.details.approvals; }
        DetailRow { label: "Tokens"; value: AgentsState.details.tokens; }
        DetailRow { label: "Cost"; value: AgentsState.details.cost; }
        // The count, and behind it what arrived and why each was refused (#212). A session with
        // no kept lines shows the count alone, as it did before.
        if AgentsState.details.refused != "" : refused-row := Rectangle {
            property <bool> open: false;
            height: refused-col.preferred-height;
            refused-col := VerticalLayout {
                spacing: 2px;
                HorizontalLayout {
                    height: 20px;
                    spacing: 8px;
                    Text {
                        text: "Refused";
                        width: 76px;
                        color: Theme.text-dim;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                    }
                    Text {
                        text: AgentsState.details.refused;
                        color: Theme.text-primary;
                        font-size: Theme.fs-caption;
                        overflow: elide;
                        horizontal-stretch: 1;
                        vertical-alignment: center;
                    }
                    if AgentsState.details.refused-lines != "" : VerticalLayout {
                        alignment: center;
                        Icon {
                            commands: refused-row.open ? Icons.chevron-down : Icons.chevron-right;
                            size: 12px;
                            tint: Theme.text-dim;
                        }
                    }
                }
                if refused-row.open && AgentsState.details.refused-lines != "" : Text {
                    text: AgentsState.details.refused-lines;
                    color: Theme.text-secondary;
                    font-family: Theme.font-mono;
                    font-size: Theme.fs-micro;
                    wrap: word-wrap;
                }
            }
            if AgentsState.details.refused-lines != "" : TouchArea {
                mouse-cursor: pointer;
                clicked => { refused-row.open = !refused-row.open; }
            }
        }
        if AgentsState.details.command-lines != "" : Text {
            text: AgentsState.details.command-lines;
            color: Theme.text-secondary;
            font-family: Theme.font-mono;
            font-size: Theme.fs-micro;
            wrap: word-wrap;
        }
        if AgentsState.details.file-lines != "" : Text {
            text: AgentsState.details.file-lines;
            color: Theme.text-secondary;
            font-family: Theme.font-mono;
            font-size: Theme.fs-micro;
            wrap: word-wrap;
        }
        if AgentsState.details.basis != "" : Text {
            text: AgentsState.details.basis;
            color: Theme.text-dim;
            font-size: Theme.fs-micro;
            wrap: word-wrap;
        }
        Rectangle { vertical-stretch: 1; }
        HorizontalLayout {
            spacing: 8px;
            YButton {
                label: "Stop";
                icon-path: Icons.stop;
                variant: 1;
                size: 0;
                disabled: !AgentsState.header.can-stop;
                clicked => { AgentsState.stop(AgentsState.header.id); }
            }
        }
    }
}

// What could not be done, in the kit's one notice bar: neutral, because most of what lands here
// is information about a run rather than a failure of this screen.
component NoticeBar inherits YNoticeBar {
    text: AgentsState.notice;
    tone: 0;
    max-lines: 2;
    dismissed => { AgentsState.dismiss-notice(); }
}

// One opened run: who and what, the changes recorded, what happened, and the run's details.
//
// The activity is the session's own items (ItemView), with consecutive calls folded into one line
// by the shell (`group_calls`). An approval in it is the shell's own card, answered through the
// same Allow and Deny the Lens uses.
component TaskDetail inherits Rectangle {
    flick := Flickable {
        width: parent.width;
        height: parent.height;
        viewport-height: col.preferred-height;
        // A Rectangle between the Flickable and the layout, as every scroller here has: a layout
        // directly in a Flickable takes its own max-height as the Flickable's.
        Rectangle {
            width: flick.width;
            height: col.preferred-height;
            col := VerticalLayout {
                padding: 24px;
                spacing: 24px;
                alignment: start;

                VerticalLayout {
                    spacing: 12px;
                    Rectangle {
                        height: 28px;
                        accessible-role: button;
                        accessible-label: "Back to the workroom";
                        HorizontalLayout {
                            spacing: 6px;
                            alignment: start;
                            VerticalLayout {
                                alignment: center;
                                Icon { commands: Icons.arrow-left; size: 14px; tint: Theme.text-secondary; }
                            }
                            Text {
                                text: "Workroom";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                            }
                        }
                        TouchArea {
                            mouse-cursor: pointer;
                            clicked => { AgentsState.back(); }
                        }
                    }
                    HorizontalLayout {
                        spacing: 16px;
                        VerticalLayout {
                            spacing: 8px;
                            horizontal-stretch: 1;
                            Text {
                                text: AgentsState.header.title;
                                color: Theme.text-primary;
                                font-size: Theme.fs-page;
                                font-weight: 600;
                                wrap: word-wrap;
                            }
                            // The prompt as it was sent — ":beliefs the user", a role's whole
                            // brief — under the name, small, for whoever needs the exact words.
                            // It used to BE the heading, in the page's largest type.
                            if AgentsState.header.raw != "" : Text {
                                text: AgentsState.header.raw;
                                color: Theme.text-secondary;
                                font-size: Theme.font-label;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                            HorizontalLayout {
                                spacing: 8px;
                                alignment: start;
                                height: 20px;
                                VerticalLayout { alignment: center; MindMark { size: 16px; } }
                                Text {
                                    text: AgentsState.header.mind;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: "·";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: AgentsState.detail-label;
                                    color: AgentsState.detail-state == "needs_you" ? Theme.amber : Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                                if AgentsState.detail-mode != "" : Text {
                                    text: "·";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                                if AgentsState.detail-mode != "" : Text {
                                    text: "Mode: " + AgentsState.detail-mode;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        VerticalLayout {
                            alignment: start;
                            HorizontalLayout {
                                spacing: 8px;
                                YButton {
                                    label: "Chat";
                                    icon-path: Icons.chat;
                                    variant: 1;
                                    size: 1;
                                    clicked => { AgentsState.chat-with(AgentsState.header.id); }
                                }
                                // Pause and Resume are not here: no mind can be paused yet, and a
                                // button that does nothing is the one thing this screen must not draw.
                                YButton {
                                    label: "Stop…";
                                    icon-path: Icons.stop;
                                    variant: 1;
                                    size: 1;
                                    disabled: !AgentsState.header.can-stop;
                                    clicked => { AgentsState.confirm-stop = AgentsState.header.id; }
                                }
                            }
                        }
                    }
                    if AgentsState.header.status != "" : Text {
                        text: AgentsState.header.status;
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                    }
                }

                ChangesLedger {
                    changes: AgentsState.changes;
                    recorded: AgentsState.changes-recorded;
                }

                ChildRuns {
                    children: AgentsState.child-runs;
                    open(key) => { AgentsState.select(key); }
                }

                VerticalLayout {
                    spacing: 8px;
                    Text {
                        text: "Activity";
                        color: Theme.text-primary;
                        font-size: Theme.fs-title-2;
                        font-weight: 600;
                    }
                    if AgentsState.items.length == 0 : Text {
                        text: "Nothing has happened in this run yet.";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-body;
                    }
                    VerticalLayout {
                        spacing: 6px;
                        for item in AgentsState.items : ItemView {
                            item: item;
                            // The scroller's height, less the column's 24px padding above and
                            // below and the item's own 2px.
                            card-limit: flick.height - 2 * 24px - 4px;
                        }
                    }
                    // A word to the mind, to the agent this run belongs to.
                    HorizontalLayout {
                        spacing: 8px;
                        composer := YInput {
                            horizontal-stretch: 1;
                            disabled: !AgentsState.header.can-send;
                            placeholder: AgentsState.header.tell-hint != "" ? AgentsState.header.tell-hint
                                : AgentsState.header.can-send ? "Tell " + AgentsState.header.mind + "…" : AgentsState.header.send-hint;
                            accepted(text) => {
                                AgentsState.send(AgentsState.header.id, text);
                                self.value = "";
                            }
                        }
                        YButton {
                            label: "Send";
                            icon-path: Icons.send;
                            variant: 1;
                            size: 1;
                            disabled: !AgentsState.header.can-send;
                            clicked => {
                                AgentsState.send(AgentsState.header.id, composer.value);
                                composer.value = "";
                            }
                        }
                    }
                }

                RunDetails { facts: AgentsState.run-facts; }
            }
        }
    }
}

// The Agents screen: a 64px header, a 248px navigation, and the page it points at.
export component AgentsScreen inherits Rectangle {
    background: Theme.bg-surface;

    VerticalLayout {
        Rectangle {
            height: 64px;
            HorizontalLayout {
                padding-left: 24px;
                padding-right: 24px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    horizontal-stretch: 1;
                    Text {
                        text: "Agents";
                        color: Theme.text-primary;
                        font-size: Theme.fs-page;
                        font-weight: 600;
                    }
                    Text {
                        text: AgentsState.summary;
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                    }
                }
                VerticalLayout {
                    alignment: center;
                    YButton {
                        label: "History";
                        icon-path: Icons.history;
                        variant: 1;
                        size: 1;
                        clicked => { AgentsState.show-section("history"); }
                    }
                }
                VerticalLayout {
                    alignment: center;
                    YButton {
                        label: "Start work";
                        icon-path: Icons.plus;
                        variant: 0;
                        size: 1;
                        clicked => {
                            AgentsState.new-error = "";
                            AgentsState.new-open = true;
                        }
                    }
                }
            }
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }
        }

        if AgentsState.notice != "" : NoticeBar { }

        HorizontalLayout {
            WorkNav {
                width: 248px;
                section: AgentsState.section;
                mind: AgentsState.mind-filter;
                task: AgentsState.detail-open ? AgentsState.selected : "";
                needs: AgentsState.needs-count;
                runs: AgentsState.runs-count;
                minds: AgentsState.nav-minds;
                pick-section(id) => { AgentsState.show-section(id); }
                pick-mind(id) => { AgentsState.filter-mind(id); }
                pick-task(key) => { AgentsState.select(key); }
            }

            Rectangle {
                horizontal-stretch: 1;
                if AgentsState.detail-open : TaskDetail {
                    width: parent.width;
                    height: parent.height;
                }
                if !AgentsState.detail-open && AgentsState.section == "workroom" : WorkroomOverview {
                    width: parent.width;
                    height: parent.height;
                    decisions: AgentsState.shelf;
                    requests: AgentsState.shelf-count;
                    request-minds: AgentsState.shelf-minds;
                    desks: AgentsState.desks;
                    recent: AgentsState.recent;
                    runs: AgentsState.view-runs;
                    narrowed: AgentsState.mind-filter-name;
                    open(key) => { AgentsState.select(key); }
                    view-all-requests => { AgentsState.show-section("needs_you"); }
                    view-history => { AgentsState.show-section("history"); }
                    chat(mind) => { AgentsState.chat-with(mind); }
                    more(key, x, y) => {
                        AgentsState.menu-key = key;
                        AgentsState.menu-x = x - root.absolute-position.x;
                        AgentsState.menu-y = y - root.absolute-position.y;
                    }
                }
                if !AgentsState.detail-open && AgentsState.section == "needs_you" : NeedsPage {
                    width: parent.width;
                    height: parent.height;
                    decisions: AgentsState.decisions;
                    requests: AgentsState.needs-count;
                    request-minds: AgentsState.request-minds;
                    open(key) => { AgentsState.select(key); }
                }
                if !AgentsState.detail-open && AgentsState.section == "history" : HistoryPage {
                    width: parent.width;
                    height: parent.height;
                    results: AgentsState.history;
                    runs: AgentsState.runs-count;
                    open(key) => { AgentsState.select(key); }
                }
            }
        }
    }

    // A desk's menu. Pause is not offered: nothing can pause a mind yet.
    YContextMenu {
        open: AgentsState.menu-key != "";
        menu-x: AgentsState.menu-x;
        menu-y: AgentsState.menu-y;
        actions: [
            { id: "activity", label: "View activity" },
            { id: "changes", label: "View changes" },
            { id: "stop", label: "Stop…", is-danger: true },
        ];
        action-clicked(id) => {
            if (id == "stop") {
                AgentsState.confirm-stop = AgentsState.menu-key;
            } else {
                AgentsState.select(AgentsState.menu-key);
            }
        }
        close-menu => { AgentsState.menu-key = ""; }
    }

    // Start work: a mind and what it is to do — or, from the catalog, a role and its task.
    if AgentsState.new-open : StartSheet {
        minds: AgentsState.minds;
        roles: AgentsState.roles;
        mind: AgentsState.new-mind;
        role: AgentsState.new-role;
        from-catalog: AgentsState.new-from-catalog;
        note: AgentsState.new-note;
        note-reach: AgentsState.new-note-reach;
        error: AgentsState.new-error;
        mode-line: AgentsState.mode-line;
        pick-mind(id) => { AgentsState.pick-mind(id); }
        pick-role(id) => { AgentsState.pick-role(id); }
        set-catalog(on) => {
            AgentsState.new-from-catalog = on;
            AgentsState.new-error = "";
            if (on) {
                if (AgentsState.new-role != "") {
                    AgentsState.pick-role(AgentsState.new-role);
                } else {
                    AgentsState.new-note = "";
                    AgentsState.new-note-reach = "";
                }
            } else {
                if (AgentsState.new-mind != "") {
                    AgentsState.pick-mind(AgentsState.new-mind);
                } else {
                    AgentsState.new-note = "";
                    AgentsState.new-note-reach = "";
                }
            }
        }
        submit(text) => {
            if (AgentsState.new-from-catalog) {
                AgentsState.start-role(AgentsState.new-role, text);
            } else {
                AgentsState.start(AgentsState.new-mind, text);
            }
        }
        cancel => { AgentsState.new-open = false; }
    }

    // Stop, asked: never assumed. What it does is said, because it cannot be taken back.
    if AgentsState.confirm-stop != "" : ConfirmDialog {
        width: parent.width;
        height: parent.height;
        title: "Stop this work?";
        body: "It ends the run: commands it is running are stopped, and any request waiting on you is withdrawn. What it already did is not undone. Its record stays here.";
        confirm-label: "Stop";
        cancel-label: "Keep working";
        confirmed => {
            AgentsState.stop(AgentsState.confirm-stop);
            AgentsState.confirm-stop = "";
        }
        cancelled => { AgentsState.confirm-stop = ""; }
    }
}

// One agent in a window of its own: the same session and details, from the same store. Closing
// the window closes the view, never the agent.
export component AgentWindow inherits Window {
    in property <string> agent-title;
    title: root.agent-title;
    default-font-family: Theme.font-ui;
    preferred-width: 1000px;
    preferred-height: 680px;
    min-width: 560px;
    min-height: 360px;
    background: Theme.bg-surface;

    VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;
        if AgentsState.notice != "" : NoticeBar { }
        HorizontalLayout {
            spacing: Theme.sp-3;
            AgentSession {
                horizontal-stretch: 1;
            }
            AgentDetailsColumn {
                width: 250px;
            }
        }
    }
}
