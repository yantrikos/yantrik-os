// Settings panel — enterprise system configuration.
// Screen 7. Two-pane layout: 240px sidebar + fluid content.
// Data-driven sidebar with search. AI & Intelligence flagship page.

import { AppHeader } from "components/app_header.slint";
import { Theme, AccentPreset } from "theme.slint";
import { AppIdentity } from "components/app_color.slint";
import { SkillStore, SkillData } from "skill_store.slint";
import { YButton, YIconButton } from "components/y_button.slint";
import { YInput } from "components/y_input.slint";
import { ListView } from "std-widgets.slint";
import { Icon, Icons } from "components/icon.slint";
import { DecisionModelCard, DecisionPreset, DecisionUse } from "components/decision_model.slint";
import { ProviderPresetGroup } from "provider_presets.slint";
import { YDialog } from "components/y_dialog.slint";
import { AccountList, ProviderGroup, AddChoice } from "components/minds_panel.slint";
import { FreeAiCard } from "components/free_ai_card.slint";
export { DecisionPreset, DecisionUse }

// ── Settings sidebar category item ──
export struct SettingsCategoryItem {
    icon: string,
    label: string,
    id: int,
}

// ── AI Provider data (for provider list) ──
export struct AIProviderData {
    id: string,
    name: string,
    provider-type: string,      // "ollama", "openai", "anthropic", "openrouter", "gemini", "together", "groq", "fireworks", "mistral", "deepseek", "huggingface", "custom"
    base-url: string,
    status: string,             // "connected", "disconnected", "testing", "error"
    is-primary: bool,
    is-fallback: bool,
    latency-ms: int,            // -1 = unknown
    error-message: string,
}

// ── One mind that could answer ──
//
// Everything here is either what the harness said about itself when it attached, or the OS's own
// answer to "is this the one talking". There is deliberately no endpoint, model or credential: a
// harness manages its own, and this screen is for choosing between them, not configuring them.
export struct HarnessData {
    id: string,
    name: string,
    detail: string,           // whatever the harness chose to say: "qwen2.5 on node1"
    status: string,           // "answering" | "attached" | "built in"
    builtin: bool,
    active: bool,
    tools: bool,
    memory: bool,
}

// ── One mind this machine could have ──
//
// The row above is the *picker*: only something attached can be handed a turn, so only something
// attached is in it. This one is the Settings list, which is a different question — a person
// opens that page BECAUSE a mind is missing, and "being attached is what makes you exist" told
// them nothing at all. A harness the image ships but nobody installed was simply absent.
//
// Everything here is derived in Rust from the manifest beside each harness's code, what is on
// PATH, which config files exist, what systemd says and who has attached. See
// crates/yantrik-ui/src/harness_catalogue.rs. Still no endpoint, model or credential: `need`
// names a file at most, never anything in it.
export struct HarnessRowData {
    id: string,
    name: string,
    detail: string,
    // "not installed" | "installing" | "needs setup" | "ready to start" | "starting up"
    // | "would not start" | "attached" | "answering"
    state: string,
    // The one thing to do next, in a sentence. Empty when there is nothing to do.
    need: string,
    // Streaming output from an install, or a dead unit's last journal lines.
    log: string,
    builtin: bool,
    active: bool,
    // Attached, and therefore able to answer. The only thing that makes "Use this" appear.
    attached: bool,
    busy: bool,
    tools: bool,
    memory: bool,
    can-install: bool,
    can-start: bool,
    // The label of the harness's own setup — "Choose model" — or empty for none.
    configure-label: string,
    // "Provider: NVIDIA NIM · model (from your saved providers)", or "its own settings".
    provider-line: string,
    can-assign-provider: bool,
    can-revert-provider: bool,
    docs: string,
}

// ── AI Model data (for model list) ──
export struct AIModelData {
    id: string,
    name: string,
    tier: string,               // "Tiny", "Small", "Medium", "Large"
    param-count: string,        // "0.8B", "4B", "27B"
    context-length: string,     // "4K", "32K", "128K"
    is-active: bool,
    is-local: bool,             // true for locally available models (Ollama)
}

// ── Live AI status data ──
// One mind and what it runs on (crates/yantrik-ui/src/runs_on): the same words the Minds panel and
// the Harnesses rows use, from the same resolver.
// One theme card: a place. The colours are the theme's own palette, read from its file by
// wire/theme.rs, so the card cannot show a colour the theme does not have.
export struct ThemeCardData {
    id: string,
    name: string,
    description: string,
    preview: image,
    ground: color,
    surface: color,
    card: color,
    accent: color,
}

export struct RunsOnRow {
    name: string,       // "Yantrik Mind"
    state: string,      // "Answering" | "Built in" | "Attached"
    answering: bool,
    runs-on: string,    // "Ollama Cloud · deepseek-v4.1-flash"
    source: string,     // "its own settings · as it reported" | "set in /opt/yantrik/config.yaml"
}

// A provider the minds run on that is not saved here (runs_on::in_use_not_saved): listed so the
// Providers section never says "none" while minds run on some. Add as provider fills the form;
// the key is typed by the person, never copied from a mind's settings.
export struct InUseRow {
    label: string,      // "Ollama Cloud", "Custom endpoint · aig.mycluster.cyou"
    used-by: string,    // "Used by Yantrik Mind, DeepSeek, OpenClaw, Pi"
    where-set: string,  // "each mind keeps its own key in its own settings"
    models: string,     // "deepseek-v4.1-flash, kimi-k3"
    preset: string,     // the Add form's preset: "ollama-cloud", "custom"
    base-url: string,   // known address, or empty
    model: string,      // first model, for the form
}

export struct AIStatusData {
    provider-name: string,
    provider-type: string,
    model-name: string,
    model-tier: string,         // "Tiny", "Small", "Medium", "Large"
    // What asking the companion's endpoint found (crates/yantrik-ui/src/wire/ai_status.rs):
    // "checking" | "connected" | "missing" (not one of the models it lists) | "refused"
    // | "unreachable" | "error" (answered, not with a model list) | "unset" | "fallback"
    status: string,
    // The sentence under the name when the status is not "connected": what was found.
    detail: string,
    latency-ms: int,
    tokens-per-sec: float,
    tokens-today: int,
    using-fallback: bool,
    fallback-provider: string,
    fallback-model: string,
}


component WallpaperChoice inherits Rectangle {
    in property <string> label;
    in property <image> image-source;
    in property <bool> selected;
    callback chosen();
    forward-focus: focus;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { root.chosen(); }
    border-radius: 10px; background: Theme.bg-elevated;
    border-width: root.selected || focus.has-focus ? 2px : 1px;
    border-color: root.selected || focus.has-focus ? Theme.accent : Theme.border-subtle;
    Rectangle {
        x: 5px; y: 5px; width: parent.width - 10px; height: parent.height - 36px;
        clip: true; border-radius: 6px; background: Theme.bg-deep;
        Image { width: 100%; height: 100%; source: root.image-source; image-fit: cover; }
    }
    Text {
        x: 10px; y: parent.height - 28px; width: parent.width - 20px; height: 24px;
        text: root.label; color: Theme.text-primary; font-size: 12px;
        font-weight: root.selected ? 600 : 400; vertical-alignment: center; overflow: elide;
    }
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") && !e.repeat { root.chosen(); return accept; }
            return reject;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(); } }
}

component ThemeCard inherits Rectangle {
    in property <ThemeCardData> theme;
    in property <bool> selected;
    callback chosen();
    forward-focus: focus;
    accessible-role: button;
    accessible-label: root.theme.name + ". " + root.theme.description;
    accessible-action-default => { root.chosen(); }
    preferred-width: 360px;
    min-width: 240px;
    max-width: 380px;
    border-radius: Theme.r-xl;
    background: Theme.bg-card;
    border-width: root.selected || focus.has-focus ? 2px : 1px;
    border-color: root.selected || focus.has-focus ? Theme.text-primary : Theme.border-default;
    // The place itself: its wallpaper, with the colours it brings in the corner.
    Rectangle {
        x: 8px; y: 8px; width: parent.width - 16px; height: 104px;
        border-radius: Theme.r-lg; clip: true; background: root.theme.ground;
        Image { width: 100%; height: 100%; source: root.theme.preview; image-fit: cover; }
        HorizontalLayout {
            x: 10px; y: parent.height - 28px; spacing: 6px;
            for swatch in [root.theme.ground, root.theme.surface, root.theme.card, root.theme.accent] : Rectangle {
                width: 18px; height: 18px; border-radius: 9px; background: swatch;
                border-width: 1px; border-color: Theme.glass-border-strong;
            }
        }
    }
    Text {
        x: 16px; y: 122px; width: parent.width - 56px; height: 22px;
        text: root.theme.name; color: Theme.text-primary; font-size: Theme.fs-title-2; font-weight: 600; overflow: elide;
    }
    Text {
        x: 16px; y: 146px; width: parent.width - 32px; height: 18px;
        text: root.theme.description; color: Theme.text-secondary; font-size: Theme.fs-caption; overflow: elide;
    }
    if root.selected : Icon { x: parent.width - 36px; y: 122px; commands: Icons.check; size: 20px; tint: Theme.text-primary; }
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") && !e.repeat { root.chosen(); return accept; }
            return reject;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(); } }
}

component ThemeChoice inherits Rectangle {
    in property <bool> dark;
    in property <bool> selected;
    callback chosen();
    forward-focus: focus;
    accessible-role: button; accessible-label: root.dark ? "Dark appearance" : "Light appearance";
    accessible-action-default => { root.chosen(); }
    border-radius: 12px; background: Theme.bg-card;
    border-width: root.selected || focus.has-focus ? 2px : 1px;
    border-color: root.selected || focus.has-focus ? Theme.accent : Theme.border-default;
    Rectangle {
        x: 12px; y: 12px; width: parent.width - 24px; height: 100px;
        border-radius: 6px; clip: true;
        background: root.dark ? #182533 : #dce8ed;
        Rectangle {
            x: 18px; y: 15px; width: parent.width - 36px; height: 84px;
            border-radius: 6px; background: root.dark ? #252d38 : #ffffff;
            Rectangle { x: 10px; y: 10px; width: 28px; height: 5px; border-radius: 2px; background: Theme.accent; }
            Rectangle { x: 10px; y: 28px; width: 32px; height: 44px; border-radius: 3px; background: root.dark ? #354253 : #e5ebf0; }
            Rectangle { x: 54px; y: 30px; width: parent.width - 68px; height: 5px; border-radius: 2px; background: root.dark ? #a5afbf : #667283; }
            Rectangle { x: 54px; y: 44px; width: (parent.width - 68px) * 0.8; height: 4px; border-radius: 2px; background: root.dark ? #5b6777 : #c3ced7; }
            Rectangle { x: 54px; y: 57px; width: (parent.width - 68px) * 0.6; height: 4px; border-radius: 2px; background: root.dark ? #5b6777 : #c3ced7; }
        }
    }
    Text { x: 16px; y: 122px; text: root.dark ? "Dark" : "Light"; color: Theme.text-primary; font-size: 15px; font-weight: 600; }
    if root.selected : Icon { x: parent.width - 34px; y: 122px; commands: Icons.check; size: 18px; tint: Theme.accent; }
    focus := FocusScope {
        key-pressed(e) => {
            if (e.text == "\n" || e.text == " ") && !e.repeat { root.chosen(); return accept; }
            return reject;
        }
    }
    TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.chosen(); } }
}

component SettingRow inherits Rectangle {
    in property <string> label;
    in property <string> description;
    in property <string> value;
    in property <bool> interactive:true;
    callback activated();
    background:Theme.bg-card;border-radius:10px;border-width:1px;border-color:Theme.border-subtle;
    height:max(88px,details.preferred-height+32px);
    HorizontalLayout {padding:16px;spacing:18px;
        details:=VerticalLayout {spacing:6px;alignment:center;horizontal-stretch:1;
            Text{text:root.label;color:Theme.text-primary;font-size:14px;font-weight:600;wrap:word-wrap;}
            Text{text:root.description;color:Theme.text-secondary;font-size:12px;wrap:word-wrap;}
        }
        if root.interactive : YButton {label:root.value;variant:1;size:0;clicked=>{root.activated();}}
        if !root.interactive : Text {text:root.value;color:Theme.text-secondary;font-size:13px;vertical-alignment:center;overflow:elide;max-width:220px;}
    }
}
component AccentChoice inherits Rectangle {
    in property <color> swatch;
    in property <string> label;
    in property <bool> selected;
    callback chosen();
    width:38px;height:38px;border-radius:19px;background:transparent;
    border-width:root.selected||focus.has-focus?2px:0px;border-color:Theme.text-primary;
    accessible-role:button;accessible-label:root.label;accessible-action-default=>{root.chosen();}forward-focus:focus;
    Rectangle{x:6px;y:6px;width:26px;height:26px;border-radius:13px;background:root.swatch;}
    focus:=FocusScope{key-pressed(e)=>{if(e.text==" "||e.text=="\n"){root.chosen();return accept;}return reject;}}
    TouchArea{mouse-cursor:pointer;clicked=>{focus.focus();root.chosen();}}
}

export component SettingsScreen inherits Rectangle {
    // The window's own buttons, carried in this screen's AppHeader when the shell's WindowFrame
    // hosts it maximized (the frame then drops its own bar: content-has-controls). Without them
    // the screen wore two bars, the frame's "Files"/"Settings" row above the header's own.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    // Apply settings identity to every category and its child panels.
    init => { AppIdentity.id = "settings"; keys.focus(); }

    background: Theme.bg-deep;

    // Account
    in-out property <string> user-name: "";
    in-out property <string> companion-name: "Yantrik";
    callback rename-user(string);
    callback rename-companion(string);

    // AI Model
    in property <string> model-name: "";
    in property <int> max-context: 4096;
    in property <int> max-tokens: 512;
    in property <string> tool-permission: "sensitive";

    // What a mind may do without being asked. The same control as the status bar's mode chip,
    // shown here beside `tool-permission` because the two are only understandable together: the
    // mode says how often you are asked, the ceiling says what no mode can reach. Somebody who
    // reads one without the other will conclude that Bypass means "anything".
    in property <string> mind-mode: "ask";
    in property <string> mind-mode-label: "Ask";
    in property <string> mind-mode-means: "";
    // Either bypass — `bypass` or `bypass_all` ("Full bypass") — lights the one Bypass button.
    property <bool> mind-in-bypass: root.mind-mode == "bypass" || root.mind-mode == "bypass_all";
    callback mind-mode-chosen(string);
    /// Neither bypass is set from here. It routes to the status bar's menu, which is where the
    /// confirmation and the durations live — one place, so there is one thing to get right.
    callback mind-bypass-requested();

    // Security
    in property <int> auto-lock-secs: 300;
    // False when the compositor gives no idle signal: no lock can come, so none is promised (#412).
    in property <bool> auto-lock-available: true;
    in-out property <bool> incognito-mode: false;
    in-out property <bool> dnd-mode: false;
    callback toggle-incognito-mode();
    callback toggle-dnd-mode();

    // Network — the reading from the network service, the same one the status
    // bar's mark and the System screen's row are drawn from. This row used to
    // head NetworkManager's "Wired connection 1" with "Wi-Fi", because all it
    // had was the wireless flag and a connection name it took for an SSID.
    in property <bool> network-online: false;
    in property <string> network-label: "Network";
    in property <string> network-detail: "";
    in property <string> ip-address: "";

    // Display
    in property <string> display-resolution: "";

    // LLM Backend
    in property <string> llm-backend: "candle";
    in property <string> llm-api-url: "";
    in property <string> llm-api-model: "";

    // System info
    in property <int> memory-count: 0;
    // Filled by wire/settings.rs from yantrik-version. The default was "0.1.0" and nothing
    // set it, so that default was what the Settings row showed, always.
    in property <string> version-text: "";
    in property <int> notification-count: 0;

    // Appearance
    in-out property <bool> dark-mode: true;
    in-out property <string> accent-color: "cyan";
    // The themes (places) to choose from, and the one in use.
    in property <[ThemeCardData]> themes;
    in-out property <string> theme-id: "lake";
    callback choose-theme(string);
    callback toggle-dark-mode();
    in property <bool> agent-mode: false;
    callback set-agent-mode(bool);
    callback cycle-accent-color();
    callback choose-accent(string);
    in property <string> save-status:"Preferences are saved automatically";
    in property <bool> save-error;
    in property <bool> save-can-retry:true;
    callback retry-save();
    callback open-network();

    // Wallpaper
    in-out property <string> wallpaper-path: "";
    property <string> custom-wallpaper-input: "";
    property <bool> custom-input-visible: false;
    callback wallpaper-changed(string);

    // Interactive settings
    callback cycle-tool-permission();
    callback cycle-auto-lock();

    callback back-pressed();
    callback navigate-to(int);

    // Connected Services (category 5)
    // Each connector: status is "connected", "disconnected", or "connecting"
    in property <string> conn-google-status: "disconnected";
    in property <string> conn-google-detail: "";
    in property <string> conn-spotify-status: "disconnected";
    in property <string> conn-spotify-detail: "";
    in property <string> conn-facebook-status: "disconnected";
    in property <string> conn-facebook-detail: "";
    in property <string> conn-instagram-status: "disconnected";
    in property <string> conn-instagram-detail: "";
    callback connect-service(string);
    callback disconnect-service(string);
    callback sync-service(string);

    // Skills / Skill Store (category 6) — data-driven via models
    in property <[SkillData]> skills;
    in property <[string]> skill-categories: ["All"];
    callback toggle-skill(string);
    callback search-skills(string);
    callback filter-skill-category(string);

    // ── AI Provider management (Phase 2) ──
    in property <AIStatusData> ai-status;
    in property <[AIProviderData]> ai-providers: [];
    in property <[AIModelData]> available-models: [];
    in-out property <string> provider-test-result: "";  // "success", "testing", "" or a sentence saying what failed
    // Decision model (components/decision_model.slint)
    in property <[DecisionPreset]> decision-presets: [];
    in property <string> decision-provider: "";
    in property <string> decision-endpoint: "";
    in property <string> decision-model: "";
    in property <string> decision-key-env: "";
    in property <[DecisionUse]> decision-uses: [];
    in property <string> decision-where: "";
    in property <bool> decision-leaves-machine: false;
    in property <string> decision-status: "";
    in property <bool> decision-status-good: false;
    callback decision-choose(string);
    callback decision-save(string, string, string);
    callback decision-test();
    callback decision-toggle-use(string);
    in-out property <bool> provider-panel-open: false;
    in-out property <string> editing-provider-id: "";   // empty = new provider
    callback add-provider();
    callback save-provider(string, string, string, string, string, string);  // name, type, url, key, auth, model
    callback delete-provider(string);
    callback test-provider(string);
    callback connect-provider(string, string, string);              // preset, url, key: checks the key and lists models
    callback provider-url-changed(string);                           // the URL field was edited: Rust says whether the host moved
    in property <bool> provider-form-host-changed: false;           // editing, and the address is now on another host
    callback provider-model-search(string);                          // filters provider-form-models
    callback edit-provider(string);                                  // a row's Models: the panel on that provider
    in property <[string]> provider-form-models: [];                 // the listed model ids, search applied
    in property <int> provider-form-model-total: 0;                  // how many the provider listed
    in-out property <string> provider-form-model: "";                // the model Save stores
    in-out property <bool> provider-form-connected: false;           // Connect succeeded for this URL and key
    callback provider-preset-selected(string);                        // preset id → fills form
    in property <[ProviderPresetGroup]> provider-presets: [];        // from the provider catalogue
    in-out property <string> provider-form-name: "";
    in-out property <string> provider-form-url: "";
    in-out property <string> selected-preset: "";  // tracks which preset button is highlighted
    callback set-primary-provider(string);
    callback set-fallback-provider(string);
    callback select-model(string);
    callback refresh-models();
    callback toggle-auto-fallback();

    // V60 — Task routing
    in-out property <string> route-fast-provider: "";
    in-out property <string> route-balanced-provider: "";
    in-out property <string> route-powerful-provider: "";
    callback save-task-routing(string, string, string);

    // V60 — Privacy controls
    in-out property <bool> privacy-local-only: false;
    in-out property <bool> privacy-cloud-confirm: true;
    in-out property <string> privacy-preset: "balanced";  // "maximum", "balanced", "cloud-first"
    callback set-privacy-preset(string);

    // The credential vault. Filled by `wire::vault` from `vault_unlock::cached_status`.
    in property <bool> vault-protected: false;
    in property <bool> vault-unlocked: false;
    /// Why it is unprotected, in the person's words. Only read when `vault-protected` is false.
    in property <string> vault-why: "";
    /// Asks the shell to raise its unlock prompt. Carries no passphrase and never will — see
    /// `no_published_action_can_carry_a_passphrase`.
    callback vault-set-passphrase();

    // V62 — Usage / Cost tracking
    in property <string> usage-period: "monthly";
    in property <float> usage-local-percent: 0.0;
    in property <float> usage-cloud-percent: 0.0;
    in property <string> usage-total-cost: "$0.00";
    in property <string> usage-daily-cost: "$0.00";
    in property <string> usage-tokens-today: "0";
    in property <string> usage-tokens-month: "0";
    in property <string> budget-limit: "";
    in property <float> budget-used-percent: 0.0;
    in property <bool> budget-warning: false;
    in-out property <string> budget-input: "";
    callback save-budget(string);

    // ── What runs on what (top of category 1) ──
    in property <[RunsOnRow]> runs-on-rows: [];
    in property <string> runs-on-summary: "";
    in property <[InUseRow]> in-use-providers: [];

    // ── Accounts (category 4): the same accounts, and the same list, as the Minds panel ──
    in property <[ProviderGroup]> account-groups: [];
    in property <[AddChoice]> account-choices: [];
    in property <[AddChoice]> account-key-choices: [];   // coding plans paid for with a key
    in property <string> account-keys-line: "";          // "Keys in use: xAI, for the companion"
    in property <string> account-status: "";
    in-out property <bool> accounts-adding: false;
    callback accounts-shown();                  // the page opened: read the accounts again
    callback account-use(string);               // an account id
    callback account-sign-in(string);           // an account id
    callback account-add(string);               // a vendor id

    // ── Harnesses (category 8) ──
    in property <[HarnessData]> harnesses: [];
    // What the machine could offer, installed or not. Separate from `harnesses` above on
    // purpose: that one is the picker and only holds minds that can actually take a turn.
    in property <[HarnessRowData]> harness-rows: [];
    in property <string> harness-error: "";
    callback use-harness(string);
    callback install-harness(string);
    callback start-harness(string);
    callback configure-harness(string);
    // Giving a harness one of the saved providers (crates/yantrik-ui/src/provider_handoff):
    // choose → the card says what will be written → Apply. Revert puts its own file back.
    in-out property <string> assigning-harness: "";      // the row whose provider choice is open
    in-out property <bool> handoff-card-open: false;
    in property <string> handoff-card-title: "";
    in property <string> handoff-card-body: "";
    callback plan-provider(string, string);              // harness id, provider id → the card
    callback apply-provider();
    callback cancel-provider();
    callback revert-provider(string);
    // Whether any row has a job running. Computed in Rust because Slint cannot reduce over a
    // model, and it is what stops the sweep below from animating on an idle machine.
    in property <bool> harness-busy: false;

    // A state's colour, defined once. A pill, its text and the sentence under it all have to
    // agree, and three copies of the same conditional is three places to drift apart.
    pure function harness-state-color(state: string) -> color {
        state == "would not start" ? Theme.color-danger
        : (state == "not installed" || state == "needs setup") ? Theme.color-warning
        : state == "attached" ? Theme.color-success
        : Theme.text-dim
    }
    pure function harness-state-tint(state: string) -> color {
        state == "would not start" ? Theme.color-danger-dim
        : (state == "not installed" || state == "needs setup") ? Theme.color-warning-dim
        : state == "attached" ? Theme.color-success-dim
        : Theme.bg-elevated
    }

    // Drives the indeterminate bar on a row that is installing or starting. 100ms rather than a
    // frame, and only while this page is open with something actually running: a settings screen
    // that repaints sixty times a second in the background is how an idle desktop gets warm.
    // It was 60ms, which is the same idea and still four repaints for every one the bar needs;
    // 100ms is the floor the scan in yantrik-ui-kit now holds every repeating timer to, and the
    // sweep keeps its two-second period because the step grew with the interval.
    property <float> harness-phase: 0;
    // A triangle rather than a saw: the bar comes back the way it went instead of jumping to
    // the left edge every two seconds.
    property <float> harness-sweep: root.harness-phase < 0.5
        ? root.harness-phase * 2 : (1.0 - root.harness-phase) * 2;
    Timer {
        interval: 100ms;
        running: root.active-category == 8 && root.harness-busy;
        triggered => { harness-phase = mod(root.harness-phase + 0.05, 1.0); }
    }

    // Active settings category (sidebar).
    //
    // in-out rather than private so something else can open Settings ON a section — the status
    // bar's mind badge goes straight to Harnesses, and the shell's control surface can too. A
    // person sent to "Settings, now find it yourself" has been given a chore, not a link.
    in-out property <int> active-category: 0;

    // Sidebar categories — data-driven
    property <[SettingsCategoryItem]> all-categories: [
        { icon: Icons.sun, label: "Appearance",         id: 0 },
        { icon: Icons.spark, label: "AI & Intelligence",  id: 1 },
        { icon: Icons.apps, label: "Desktop",            id: 2 },
        { icon: Icons.wifi, label: "Network",            id: 3 },
        { icon: Icons.link, label: "Accounts",          id: 4 },
        { icon: Icons.shield, label: "Privacy & Security", id: 5 },
        { icon: Icons.settings, label: "System",             id: 6 },
        { icon: Icons.bolt, label: "Skills",             id: 7 },
        { icon: Icons.companion, label: "Harnesses",        id: 8 },
    ];

    // Search-filtered categories (set from Rust callback or defaults to all)
    in-out property <[SettingsCategoryItem]> categories: root.all-categories;
    // Category glyphs live here, keyed by id, so the Rust side never has to know icon paths.
    pure function category-icon(id: int) -> string {
        id == 0 ? Icons.sun : id == 1 ? Icons.spark : id == 2 ? Icons.apps : id == 3 ? Icons.wifi
        : id == 4 ? Icons.link : id == 5 ? Icons.shield : id == 6 ? Icons.settings
        : id == 7 ? Icons.bolt : Icons.companion
    }

    // NOTE: the list of categories that actually reaches this screen is built in Rust, in
    // crates/yantrik-ui/src/wire/settings.rs — `all-categories` below is only what shows before
    // that arrives. Adding a category in one place and not the other is how Harnesses came to
    // exist with no way to open it.
    in-out property <string> search-query: "";
    callback settings-search(string);

    public function focus-search(){settings-search-field.focus();}
    keys:=FocusScope {width:root.width;height:root.height;
    key-pressed(e)=>{
        if(e.modifiers.control&&e.text=="f"){settings-search-field.focus();return accept;}
        if(e.text==Key.Escape&&root.search-query!=""){root.search-query="";root.settings-search("");return accept;}
        return reject;
    }
    VerticalLayout {
        height:root.height - 38px;spacing: 0px;

        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "settings"; icon: Icons.settings; title: "Settings";
            subtitle: "Make Yantrik yours"; show-back: true;
            back => { root.back-pressed(); }
        }

        if root.save-error : Rectangle {height:save-message.preferred-height+24px;background:Theme.bg-elevated;
            save-message:=Text{x:24px;y:12px;width:parent.width - 48px;text:root.save-status;color:Theme.amber;font-size:13px;wrap:word-wrap;}
        }
        // Main content: sidebar + panel
        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // ===== LEFT SIDEBAR (240px, data-driven) =====
            Rectangle {
                width: root.width < 900px ? 224px : 252px;
                background: Theme.bg-surface;

                // Right edge separator
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.separator;
                }

                Flickable {
                    width: 100%; height: 100%; viewport-width: self.width;
                    viewport-height: category-list.preferred-height;
                    category-list := VerticalLayout {
                        padding-top: Theme.sp-3;
                        padding-bottom: Theme.sp-4;
                        spacing: 0px;
                        alignment: start;

                        // ── Search bar ──
                        Rectangle {
                            height: Theme.touch-target;

                            HorizontalLayout {
                                padding-left: Theme.sp-3;
                                padding-right: Theme.sp-3;

                                settings-search-field:=YInput {
                                    mode: 1;
                                    placeholder: "Find a setting";
                                    value <=> root.search-query;
                                    edited(text) => { root.settings-search(text); }
                                    accepted(text) => { root.settings-search(text); if(root.categories.length>0){root.active-category=root.categories[0].id;} }
                                    cleared=>{root.settings-search("");}
                                }
                            }
                        }

                        // ── Spacer ──
                        Rectangle { height: Theme.sp-2; }

                        if root.categories.length==0 : Text {text:"No matching settings.\nTry theme, lock, model or Wi-Fi.";color:Theme.text-dim;font-size:12px;wrap:word-wrap;horizontal-alignment:center;height:90px;}
                        // ── Category list (data-driven) ──
                        for cat[idx] in root.categories : Rectangle {
                            property <bool> is-active: root.active-category == cat.id;
                            property <bool> hovered: cat-ta.has-hover;
                            forward-focus: category-focus;
                            accessible-role: button; accessible-label: cat.label;
                            accessible-action-default => { root.active-category = cat.id; }
                            border-width: category-focus.has-focus ? 1px : 0px;
                            border-color: Theme.accent;
                            category-focus := FocusScope {
                                key-pressed(e) => {
                                    if (e.text == "\n" || e.text == " ") && !e.repeat {
                                        root.active-category = cat.id; return accept;
                                    }
                                    return reject;
                                }
                            }

                            height: Theme.touch-target;
                            background: is-active ? AppIdentity.tint
                                      : hovered ? Theme.hover-fill
                                      : transparent;

                            animate background { duration: Theme.dur-fast; }

                            // Left accent bar (active indicator)
                            if is-active : Rectangle {
                                x: 0;
                                width: 3px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                border-radius: 2px;
                                background: Theme.accent;
                            }

                            cat-ta := TouchArea {
                                mouse-cursor: pointer;
                                clicked => { category-focus.focus(); root.active-category = cat.id; }
                            }

                            HorizontalLayout {
                                padding-left: Theme.sp-4;
                                padding-right: Theme.sp-3;
                                spacing: Theme.sp-3;
                                alignment: start;

                                Icon {
                                    commands: root.category-icon(cat.id);
                                    size: 15px;
                                    tint: cat.id == root.active-category ? AppIdentity.accent : Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: cat.label;
                                    color: is-active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    font-weight: is-active ? Theme.fw-body-strong : Theme.fw-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }

            // ===== RIGHT PANEL — category content =====
            Rectangle {
                horizontal-stretch: 1;
                background: transparent;

                // ===== CATEGORY 0: APPEARANCE =====
                if root.active-category == 0 : Flickable {
                    width: 100%; height: 100%; viewport-width: self.width;
                    viewport-height: appearance-body.preferred-height;

                    appearance-body := VerticalLayout {
                        padding: 28px; spacing: 20px; alignment: start;

                        Text { text: "Appearance"; color: Theme.text-primary; font-size: 28px; font-weight: 600; }
                        Text { text: "A workspace that feels like you. Native apps pick up appearance changes when reopened."; color: Theme.text-secondary; font-size: 13px; wrap:word-wrap; }
                        // Themes: a place sets the colours, the accent and the wallpaper together,
                        // and reaches the window frames, the terminal and the lock screen. The
                        // light and dark choice, accent and wallpaper below still work on top.
                        HorizontalLayout {
                            spacing: 16px; height: 176px; alignment: start;
                            for theme in root.themes : ThemeCard {
                                theme: theme;
                                selected: root.theme-id == theme.id;
                                chosen => { root.theme-id = theme.id; root.choose-theme(theme.id); }
                            }
                        }
                        HorizontalLayout {
                            spacing: 16px; height: 164px;
                            ThemeChoice {
                                dark: true; selected: root.dark-mode;
                                chosen => { if !root.dark-mode { root.toggle-dark-mode(); } }
                            }
                            ThemeChoice {
                                dark: false; selected: !root.dark-mode;
                                chosen => { if root.dark-mode { root.toggle-dark-mode(); } }
                            }
                        }

                        // Accent color picker row
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: 52px;

                            HorizontalLayout {
                                padding-left: Theme.sp-4;
                                padding-right: Theme.sp-4;

                                Text {
                                    text: "Accent color";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                // The swatch is the preset's own token, so it is the colour you get.
                                // The serialised id stays "cyan" for the first preset: saved
                                // settings and the control surface already say it.
                                for accent in [
                                    {id:"cyan",label:"Soft blue",color:AccentPreset.swatch-0},
                                    {id:"amber",label:"Amber",color:AccentPreset.swatch-1},
                                    {id:"purple",label:"Purple",color:AccentPreset.swatch-2},
                                    {id:"green",label:"Green",color:AccentPreset.swatch-3},
                                    {id:"pink",label:"Pink",color:AccentPreset.swatch-4}
                                ] : AccentChoice {swatch:accent.color;label:accent.label;selected:root.accent-color==accent.id;chosen=>{root.choose-accent(accent.id);}}

                            }
                        }

                        // ── Wallpaper section ──
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: wp-layout.preferred-height;

                            wp-layout := VerticalLayout {
                                padding: Theme.sp-4;
                                spacing: Theme.sp-3;

                                Text {
                                    text: "Wallpaper";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                }

                                // Real wallpaper previews, sized to the available pane.
                                wallpaper-grid := Rectangle {
                                    property <int> columns: max(1, floor(self.width / 140px));
                                    height: ceil(9 / self.columns) * 114px;
                                    for preset[idx] in [
                                        { id: "lake", label: "Lake", image: @image-url("wallpapers/previews/lake.png") },
                                        { id: "serenity", label: "Serenity", image: @image-url("wallpapers/previews/serenity.png") },
                                        { id: "first-light", label: "First light", image: @image-url("wallpapers/previews/first-light.png") },
                                        { id: "nightfall", label: "Nightfall", image: @image-url("wallpapers/previews/nightfall.png") },
                                        { id: "aurora", label: "Aurora", image: @image-url("wallpapers/previews/aurora.png") },
                                        { id: "sunset", label: "Sunset", image: @image-url("wallpapers/previews/sunset.png") },
                                        { id: "ocean", label: "Ocean", image: @image-url("wallpapers/previews/ocean.png") },
                                        { id: "nebula", label: "Nebula", image: @image-url("wallpapers/previews/nebula.png") },
                                        { id: "", label: "Solid color", image: @image-url("") }
                                    ] : WallpaperChoice {
                                        x: mod(idx, wallpaper-grid.columns) * (wallpaper-grid.width / wallpaper-grid.columns);
                                        y: floor(idx / wallpaper-grid.columns) * 114px;
                                        width: wallpaper-grid.width / wallpaper-grid.columns - 12px;
                                        height: 102px;
                                        label: preset.label; image-source: preset.image;
                                        selected: root.wallpaper-path == preset.id;
                                        chosen => {
                                            root.wallpaper-path = preset.id;
                                            root.custom-input-visible = false;
                                            root.wallpaper-changed(preset.id);
                                        }
                                    }
                                }

                                // Custom wallpaper button + path input
                                HorizontalLayout {
                                    spacing: Theme.sp-2;

                                    wp-custom-ta := TouchArea {
                                        width: custom-btn-rect.preferred-width;
                                        height: 32px;
                                        clicked => {
                                            root.custom-input-visible = !root.custom-input-visible;
                                        }
                                        custom-btn-rect := Rectangle {
                                            width: custom-btn-text.preferred-width + 24px;
                                            height: 32px;
                                            border-radius: Theme.r-md;
                                            background: wp-custom-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                                            border-width: 1px;
                                            border-color: root.custom-input-visible ? Theme.accent-dim : Theme.border-subtle;

                                            custom-btn-text := Text {
                                                text: "Custom...";
                                                color: root.custom-input-visible ? AppIdentity.accent : Theme.text-secondary;
                                                font-size: Theme.fs-caption;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Show active wallpaper label
                                    if root.wallpaper-path != "" && root.wallpaper-path != "lake" && root.wallpaper-path != "serenity" && root.wallpaper-path != "first-light" && root.wallpaper-path != "nightfall" && root.wallpaper-path != "aurora" && root.wallpaper-path != "sunset" && root.wallpaper-path != "ocean" && root.wallpaper-path != "nebula" : Text {
                                        text: root.wallpaper-path;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                }

                                // Custom path input row (shown when "Custom..." toggled)
                                if root.custom-input-visible : HorizontalLayout {
                                    spacing: Theme.sp-2;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 32px;
                                        border-radius: Theme.r-md;
                                        background: Theme.bg-elevated;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        clip: true;

                                        wp-input := TextInput {
                                            x: 8px;
                                            width: parent.width - 16px;
                                            height: 100%;
                                            text <=> root.custom-wallpaper-input;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-caption;
                                            vertical-alignment: center;

                                            accepted => {
                                                if root.custom-wallpaper-input != "" {
                                                    root.wallpaper-path = root.custom-wallpaper-input;
                                                    root.wallpaper-changed(root.custom-wallpaper-input);
                                                }
                                            }
                                        }

                                        // Placeholder text
                                        if root.custom-wallpaper-input == "" : Text {
                                            x: 8px;
                                            text: "/path/to/image.png";
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                            vertical-alignment: center;
                                            opacity: 0.5;
                                        }
                                    }

                                    wp-apply-ta := TouchArea {
                                        width: 60px;
                                        height: 32px;
                                        clicked => {
                                            if root.custom-wallpaper-input != "" {
                                                root.wallpaper-path = root.custom-wallpaper-input;
                                                root.wallpaper-changed(root.custom-wallpaper-input);
                                            }
                                        }
                                        Rectangle {
                                            width: 60px; height: 32px;
                                            border-radius: Theme.r-md;
                                            background: wp-apply-ta.has-hover ? Theme.accent-dim : Theme.hover-fill;
                                            border-width: 1px;
                                            border-color: Theme.accent-dim;

                                            Text {
                                                text: "Apply";
                                                color: Theme.accent;
                                                font-size: Theme.fs-micro;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                        }

                        // Display resolution
                        Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: disp-layout.preferred-height;

                            disp-layout := VerticalLayout {
                                padding: Theme.sp-4;
                                spacing: Theme.sp-3;

                                HorizontalLayout {
                                    Text {
                                        text: "Resolution";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: root.display-resolution != "" ? root.display-resolution : "auto";
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                    }
                                }
                            }
                        }

                        // Bottom spacer
                        Rectangle { height: 40px; }
                    }
                }

                // ===== CATEGORY 1: AI & INTELLIGENCE =====
                if root.active-category == 1 : Rectangle {
                    width: 100%;
                    height: 100%;

                    // Local form state for Add/Edit provider panel
                    property <string> form-name: "";
                    property <string> form-type: "custom";
                    property <string> form-url: "";
                    property <string> form-key: "";
                    property <string> form-auth: "bearer";
                    property <int> form-preset: -1;
                    property <bool> show-model-picker: false;

                    Flickable {
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding: Theme.sp-6;
                            spacing: Theme.sp-4;
                            alignment: start;

                            // ── Page title ──
                            Text {
                                text: "AI & Intelligence";
                                color: Theme.text-primary;
                                font-size: Theme.fs-title-1;
                                font-weight: 700;
                            }
                            Text {
                                text: "Manage AI providers, models, and companion intelligence.";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-body;
                            }

                            // ── WHAT RUNS ON WHAT ──
                            // Every mind, what it runs on, and where that is set: the first thing
                            // on this page, so nothing below can be read as the whole story.
                            if root.runs-on-rows.length > 0 : VerticalLayout {
                                spacing: Theme.sp-2;
                                HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    Rectangle { width: 3px; height: 14px; border-radius: 1.5px; background: Theme.accent; }
                                    Text {
                                        text: "WHAT RUNS ON WHAT";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        font-weight: 600;
                                        letter-spacing: 3px;
                                        vertical-alignment: center;
                                    }
                                }
                                Rectangle {
                                    background: Theme.bg-card;
                                    border-radius: Theme.r-lg;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    height: map-layout.preferred-height;
                                    map-layout := VerticalLayout {
                                        padding: Theme.sp-4;
                                        spacing: Theme.sp-3;
                                        for r in root.runs-on-rows : HorizontalLayout {
                                            spacing: Theme.sp-3;
                                            VerticalLayout {
                                                width: 200px;
                                                spacing: 2px;
                                                Text {
                                                    text: r.name;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-body;
                                                    font-weight: r.answering ? 700 : 600;
                                                    overflow: elide;
                                                }
                                                Text {
                                                    text: r.state;
                                                    color: r.answering ? Theme.accent : Theme.text-dim;
                                                    font-size: Theme.fs-caption;
                                                    font-weight: r.answering ? 600 : 400;
                                                }
                                            }
                                            VerticalLayout {
                                                horizontal-stretch: 1;
                                                spacing: 2px;
                                                Text {
                                                    text: r.runs-on;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-body;
                                                    wrap: word-wrap;
                                                }
                                                Text {
                                                    text: r.source;
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.fs-caption;
                                                    wrap: word-wrap;
                                                }
                                            }
                                        }
                                        Rectangle { height: 1px; background: Theme.border-subtle; }
                                        Text {
                                            text: root.runs-on-summary;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // ── FREE AI ACCOUNTS ──
                            // The free tiers and the way to each, under the map that says what
                            // runs now, so the card is never read as the whole story.
                            VerticalLayout {
                                spacing: Theme.sp-2;
                                HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    Rectangle { width: 3px; height: 14px; border-radius: 1.5px; background: Theme.accent; }
                                    Text {
                                        text: "FREE AI ACCOUNTS";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        font-weight: 600;
                                        letter-spacing: 3px;
                                        vertical-alignment: center;
                                    }
                                }
                                FreeAiCard { }
                            }

                            // ── THE BUILT-IN COMPANION'S STATUS ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: root.ai-status.status == "connected" ? Theme.color-success
                                              : root.ai-status.status == "fallback" ? Theme.amber
                                              : Theme.color-emotional;
                                    drop-shadow-blur: 6px;
                                    drop-shadow-color: root.ai-status.status == "connected" ? Theme.color-success-dim
                                                     : root.ai-status.status == "fallback" ? Theme.amber-glow
                                                     : Theme.color-danger-dim;
                                }
                                Text {
                                    // What this card is about: the desktop's own AI. The minds that
                                    // answer in the chat say what they run on in Harnesses.
                                    text: "BUILT-IN COMPANION";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }

                            // Status card
                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: root.ai-status.status == "connected" ? Theme.color-success-dim
                                            : root.ai-status.status == "fallback" ? Theme.amber-dim
                                            : Theme.color-danger-dim;
                                height: ai-status-layout.preferred-height;

                                ai-status-layout := VerticalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;

                                    // Provider + status row
                                    HorizontalLayout {
                                        spacing: Theme.sp-3;
                                        // Status dot with glow
                                        Rectangle {
                                            width: 10px;
                                            height: 10px;
                                            y: (parent.height - 10px) / 2;
                                            border-radius: 5px;
                                            background: root.ai-status.status == "connected" ? Theme.color-success
                                                      : root.ai-status.status == "fallback" ? Theme.amber
                                                      : root.ai-status.status == "disconnected" ? Theme.text-dim
                                                      : Theme.color-emotional;
                                            drop-shadow-blur: 8px;
                                            drop-shadow-color: root.ai-status.status == "connected" ? Theme.color-success-dim
                                                             : root.ai-status.status == "fallback" ? Theme.amber-glow-strong
                                                             : transparent;
                                            animate background { duration: Theme.dur-fast; }
                                            animate drop-shadow-color { duration: Theme.dur-fast; }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: root.ai-status.provider-name != "" ? root.ai-status.provider-name : "No model set up";
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                            HorizontalLayout {
                                                spacing: Theme.sp-2;
                                                Text {
                                                    text: root.ai-status.provider-type;
                                                    color: Theme.text-dim;
                                                    font-size: Theme.fs-caption;
                                                }
                                                if root.ai-status.using-fallback : Text {
                                                    text: " \u{2022} using fallback";
                                                    color: Theme.amber;
                                                    font-size: Theme.fs-caption;
                                                    font-weight: 500;
                                                }
                                            }
                                            if root.ai-status.detail != "" : Text {
                                                text: root.ai-status.detail;
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-caption;
                                                wrap: word-wrap;
                                            }
                                        }
                                        // Status badge
                                        Rectangle {
                                            width: status-txt.preferred-width + 16px;
                                            height: 24px;
                                            border-radius: Theme.r-lg;
                                            background: root.ai-status.status == "connected" ? Theme.color-success-dim
                                                      : root.ai-status.status == "fallback" || root.ai-status.status == "checking" ? Theme.tint-amber
                                                      : root.ai-status.status == "unset" ? Theme.hover-fill
                                                      : Theme.color-danger-dim;
                                            border-width: 1px;
                                            border-color: root.ai-status.status == "connected" ? Theme.color-success-dim
                                                        : root.ai-status.status == "fallback" || root.ai-status.status == "checking" ? Theme.amber-dim
                                                        : root.ai-status.status == "unset" ? Theme.border-subtle
                                                        : Theme.color-danger-dim;
                                            status-txt := Text {
                                                text: root.ai-status.status == "connected" ? "Connected"
                                                    : root.ai-status.status == "checking" ? "Checking…"
                                                    : root.ai-status.status == "missing" ? "Model not found"
                                                    : root.ai-status.status == "refused" ? "Key refused"
                                                    : root.ai-status.status == "unreachable" ? "Can't reach it"
                                                    : root.ai-status.status == "unset" ? "Not set up"
                                                    : root.ai-status.status == "fallback" ? "Fallback"
                                                    : "Unverified";
                                                color: root.ai-status.status == "connected" ? Theme.color-success
                                                     : root.ai-status.status == "fallback" || root.ai-status.status == "checking" ? Theme.amber
                                                     : root.ai-status.status == "unset" ? Theme.text-secondary
                                                     : Theme.color-emotional;
                                                font-size: Theme.fs-caption;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Model + tier row
                                    HorizontalLayout {
                                        Text {
                                            text: "Model";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            horizontal-stretch: 1;
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.sp-2;
                                            Text {
                                                text: root.ai-status.model-name != "" ? root.ai-status.model-name : "—";
                                                color: Theme.accent;
                                                font-size: Theme.fs-body;
                                                font-weight: 500;
                                            }
                                            if root.ai-status.model-tier != "" : Rectangle {
                                                width: tier-txt.preferred-width + 12px;
                                                height: 20px;
                                                border-radius: 10px;
                                                background: root.ai-status.model-tier == "Large" ? AppIdentity.tint
                                                          : root.ai-status.model-tier == "Medium" ? Theme.tint-cyan
                                                          : root.ai-status.model-tier == "Small" ? Theme.tint-amber
                                                          : Theme.border-subtle;
                                                tier-txt := Text {
                                                    text: root.ai-status.model-tier;
                                                    color: root.ai-status.model-tier == "Large" ? AppIdentity.accent
                                                         : root.ai-status.model-tier == "Medium" ? AppIdentity.accent
                                                         : root.ai-status.model-tier == "Small" ? Theme.amber
                                                         : Theme.text-secondary;
                                                    font-size: Theme.fs-micro;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Metrics row: latency + TPS + tokens today
                                    HorizontalLayout {
                                        spacing: Theme.sp-6;
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Latency";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                            Text {
                                                text: root.ai-status.latency-ms >= 0 ? root.ai-status.latency-ms + "ms" : "—";
                                                color: root.ai-status.latency-ms >= 0 && root.ai-status.latency-ms < 200 ? Theme.color-success
                                                     : root.ai-status.latency-ms < 500 ? Theme.amber
                                                     : Theme.color-emotional;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Tokens/sec";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                            Text {
                                                text: root.ai-status.tokens-per-sec > 0 ? round(root.ai-status.tokens-per-sec) + " t/s" : "—";
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Today";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                            Text {
                                                text: root.ai-status.tokens-today > 0 ? root.ai-status.tokens-today + " tokens" : "—";
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Fallback info (shown when using fallback)
                                    if root.ai-status.using-fallback : HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Icon {
                                            commands: Icons.warning;
                                            size: 14px;
                                            tint: Theme.amber;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Running on fallback: " + root.ai-status.fallback-provider;
                                                color: Theme.amber;
                                                font-size: Theme.fs-caption;
                                                font-weight: 500;
                                            }
                                            Text {
                                                text: "Model: " + root.ai-status.fallback-model;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                        }
                                    }

                                    // Tool permission
                                    perm-ta := TouchArea {
                                        height: 24px;
                                        clicked => { root.cycle-tool-permission(); }

                                        HorizontalLayout {
                                            Text {
                                                text: "Tool permission";
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-body;
                                                horizontal-stretch: 1;
                                            }
                                            Rectangle {
                                                width: perm-tag.preferred-width + 16px;
                                                height: 24px;
                                                border-radius: Theme.r-lg;
                                                background: root.tool-permission == "safe" ? Theme.tint-cyan
                                                    : (root.tool-permission == "standard" ? Theme.tint-amber
                                                    : Theme.color-danger-dim);
                                                border-width: 1px;
                                                border-color: root.tool-permission == "safe" ? Theme.accent-dim
                                                    : (root.tool-permission == "standard" ? Theme.amber-dim
                                                    : Theme.color-danger-dim);
                                                perm-tag := Text {
                                                    text: root.tool-permission == "safe" ? "Safe"
                                                        : (root.tool-permission == "standard" ? "Standard"
                                                        : "Sensitive");
                                                    color: root.tool-permission == "safe" ? AppIdentity.accent
                                                        : (root.tool-permission == "standard" ? Theme.amber
                                                        : Theme.color-emotional);
                                                    font-size: Theme.fs-micro;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // ── What the mind may do without asking ──
                                    //
                                    // Directly under the ceiling above it, and saying so, because
                                    // the pair is the whole policy: the ceiling is the wall no
                                    // mode can reach past, and the mode decides what happens
                                    // below it. The same choices as the status-bar chip, the two
                                    // bypasses behind one button; the chip is where the countdown
                                    // lives and where the two are told apart, so Bypass sends you
                                    // there rather than having a second confirmation here.
                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    VerticalLayout {
                                        spacing: Theme.sp-2;

                                        Text {
                                            text: "What the mind may do without asking";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                        }

                                        HorizontalLayout {
                                            spacing: Theme.sp-2;

                                            for choice in [
                                                { id: "plan", label: "Plan" },
                                                { id: "ask", label: "Ask" },
                                                { id: "auto", label: "Auto" },
                                                { id: "bypass", label: "Bypass" },
                                            ] : Rectangle {
                                                height: 28px;
                                                horizontal-stretch: 1;
                                                border-radius: Theme.r-sm;
                                                // Chosen: this mode, or — for the Bypass button — either bypass.
                                                property <bool> on: root.mind-mode == choice.id
                                                    || (choice.id == "bypass" && root.mind-in-bypass);
                                                background: self.on
                                                    ? (choice.id == "bypass" ? Theme.color-danger-dim : Theme.tint-accent)
                                                    : (mode-ta.has-hover ? Theme.hover-fill : transparent);
                                                border-width: 1px;
                                                border-color: self.on
                                                    ? (choice.id == "bypass" ? Theme.color-danger : Theme.accent-dim)
                                                    : Theme.border-subtle;

                                                mode-ta := TouchArea {
                                                    mouse-cursor: pointer;
                                                    clicked => {
                                                        if (choice.id == "bypass") {
                                                            root.mind-bypass-requested();
                                                        } else {
                                                            root.mind-mode-chosen(choice.id);
                                                        }
                                                    }
                                                }
                                                Text {
                                                    text: choice.id == "bypass" && root.mind-in-bypass
                                                        ? root.mind-mode-label : choice.label;
                                                    color: choice.id == "bypass" ? Theme.color-danger
                                                        : parent.on ? AppIdentity.accent
                                                        : Theme.text-secondary;
                                                    font-size: Theme.fs-micro;
                                                    font-weight: parent.on ? 700 : 500;
                                                    overflow: elide;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        Text {
                                            text: root.mind-mode-means;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                            wrap: word-wrap;
                                        }
                                        Text {
                                            text: "No mode reaches past the tool permission above — "
                                                + root.tool-permission
                                                + ". That wall is enforced inside every app, and only you can move it. "
                                                + "Bypass (which still asks before anything an app marks as impossible to undo, "
                                                + "such as a purchase or a calendar delete, and once per session before running "
                                                + "commands) and Full bypass (which asks nothing) "
                                                + "are time-boxed and are chosen from the mode chip in the status bar, where the "
                                                + "countdown stays in front of you.";
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // ── PROVIDERS ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.holo-blue;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.holo-blue-glow;
                                }
                                Text {
                                    text: "PROVIDERS";
                                    color: Theme.holo-blue;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // Add provider button
                                TouchArea {
                                    width: add-btn-row.preferred-width;
                                    height: 28px;
                                    clicked => {
                                        root.provider-panel-open = true;
                                        root.editing-provider-id = "";
                                        root.selected-preset = "";
                                        root.provider-form-name = "";
                                        root.provider-form-url = "";
                                        root.add-provider();
                                    }
                                    add-btn-row := HorizontalLayout {
                                        spacing: Theme.sp-1;
                                        Rectangle {
                                            width: 28px;
                                            height: 28px;
                                            border-radius: 14px;
                                            background: Theme.tint-accent;
                                            border-width: 1px;
                                            border-color: Theme.accent-dim;
                                            Text {
                                                text: "+";
                                                color: Theme.accent;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        Text {
                                            text: "Add Provider";
                                            color: Theme.accent;
                                            font-size: Theme.fs-caption;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // In use, not saved here: what the minds run on that Settings does not hold.
                            if root.in-use-providers.length > 0 : Text {
                                text: "IN USE, NOT SAVED HERE";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                font-weight: 600;
                                letter-spacing: 0.8px;
                            }
                            for u in root.in-use-providers : Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: in-use-layout.preferred-height;
                                in-use-layout := HorizontalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;
                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        spacing: 2px;
                                        Text { text: u.label; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: 600; wrap: word-wrap; }
                                        Text { text: u.used-by; color: Theme.text-secondary; font-size: Theme.fs-caption; wrap: word-wrap; }
                                        Text { text: u.where-set; color: Theme.text-dim; font-size: Theme.fs-caption; wrap: word-wrap; }
                                        if u.models != "" : Text { text: "Models: " + u.models; color: Theme.text-dim; font-size: Theme.fs-caption; wrap: word-wrap; }
                                    }
                                    VerticalLayout {
                                        alignment: center;
                                        YButton {
                                            label: "Add as provider";
                                            variant: 1;
                                            clicked => {
                                                root.provider-panel-open = true;
                                                root.editing-provider-id = "";
                                                root.selected-preset = u.preset;
                                                root.provider-preset-selected(u.preset);
                                                if u.base-url != "" { root.provider-form-url = u.base-url; }
                                                root.provider-form-model = u.model;
                                            }
                                        }
                                    }
                                }
                            }
                            if root.in-use-providers.length > 0 : Text {
                                text: root.ai-providers.length == 0
                                    ? "SAVED HERE · nothing yet. A saved provider can be used for the built-in companion and handed to harnesses."
                                    : "SAVED HERE";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                font-weight: 600;
                                letter-spacing: 0.8px;
                                wrap: word-wrap;
                            }

                            // Provider list — data-driven
                            for provider[idx] in root.ai-providers : Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: provider.is-primary ? Theme.accent-dim
                                            : provider.is-fallback ? Theme.amber-dim
                                            : Theme.border-subtle;
                                height: prov-row-layout.preferred-height;

                                prov-row-layout := VerticalLayout {
                                    padding: 14px;
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    spacing: Theme.sp-2;

                                    // Top row: name + type + status
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        // Status dot
                                        Rectangle {
                                            width: 8px;
                                            height: 8px;
                                            y: (parent.height - 8px) / 2;
                                            border-radius: 4px;
                                            background: provider.status == "connected" ? Theme.color-success
                                                      : provider.status == "testing" ? Theme.amber
                                                      : provider.status == "error" ? Theme.color-emotional
                                                      : Theme.text-dim;
                                        }
                                        Text {
                                            text: provider.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            font-weight: 500;
                                            horizontal-stretch: 1;
                                        }
                                        // Type badge
                                        Rectangle {
                                            width: ptype-txt.preferred-width + 12px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.border-subtle;
                                            ptype-txt := Text {
                                                text: provider.provider-type;
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-micro;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        // Primary/Fallback badges
                                        if provider.is-primary : Rectangle {
                                            width: pri-txt.preferred-width + 12px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.tint-accent;
                                            pri-txt := Text {
                                                text: "Companion uses this";
                                                color: Theme.accent;
                                                font-size: Theme.fs-micro;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                        if provider.is-fallback : Rectangle {
                                            width: fb-txt.preferred-width + 12px;
                                            height: 20px;
                                            border-radius: 10px;
                                            background: Theme.tint-amber;
                                            fb-txt := Text {
                                                text: "Fallback";
                                                color: Theme.amber;
                                                font-size: Theme.fs-micro;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Detail row: URL + latency
                                    HorizontalLayout {
                                        spacing: Theme.sp-3;
                                        Text {
                                            text: provider.base-url;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                        }
                                        if provider.latency-ms >= 0 : Text {
                                            text: provider.latency-ms + "ms";
                                            color: provider.latency-ms < 200 ? Theme.color-success
                                                 : provider.latency-ms < 500 ? Theme.amber
                                                 : Theme.color-emotional;
                                            font-size: Theme.fs-caption;
                                            font-weight: 500;
                                        }
                                    }

                                    // Error message (if any)
                                    if provider.error-message != "" : Text {
                                        text: provider.error-message;
                                        color: Theme.color-emotional;
                                        font-size: Theme.fs-caption;
                                        wrap: word-wrap;
                                    }

                                    // Action buttons row
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        alignment: end;

                                        // Models: re-list and change the saved model
                                        TouchArea {
                                            width: models-btn-txt.preferred-width + 16px;
                                            height: 28px;
                                            clicked => { root.edit-provider(provider.id); }
                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                models-btn-txt := Text {
                                                    text: "Models";
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Test
                                        TouchArea {
                                            width: test-btn-txt.preferred-width + 16px;
                                            height: 28px;
                                            clicked => { root.test-provider(provider.id); }
                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                test-btn-txt := Text {
                                                    text: "Test";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Use for the companion (if not already)
                                        if !provider.is-primary : TouchArea {
                                            width: set-pri-txt.preferred-width + 16px;
                                            height: 28px;
                                            clicked => { root.set-primary-provider(provider.id); }
                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                set-pri-txt := Text {
                                                    text: "Use for the companion";
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // The chosen one hands the companion back to the machine's own
                                        // address (config.yaml), which nothing here ever rewrites.
                                        if provider.is-primary : TouchArea {
                                            width: stop-txt.preferred-width + 16px;
                                            height: 28px;
                                            clicked => { root.set-primary-provider(""); }
                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                stop-txt := Text {
                                                    text: "Stop using for the companion";
                                                    color: Theme.text-secondary;
                                                    font-size: Theme.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Set Fallback (if not already)
                                        if !provider.is-fallback && !provider.is-primary : TouchArea {
                                            width: set-fb-txt.preferred-width + 16px;
                                            height: 28px;
                                            clicked => { root.set-fallback-provider(provider.id); }
                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                set-fb-txt := Text {
                                                    text: "Set Fallback";
                                                    color: Theme.amber;
                                                    font-size: Theme.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Delete
                                        TouchArea {
                                            width: del-btn-txt.preferred-width + 16px;
                                            height: 28px;
                                            clicked => { root.delete-provider(provider.id); }
                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                del-btn-txt := Text {
                                                    text: "Remove";
                                                    color: Theme.color-emotional;
                                                    font-size: Theme.fs-caption;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Empty state: only when nothing is saved AND nothing is in use. On VM 520 it
                            // said "No AI providers configured" under the companion's own endpoint.
                            if root.ai-providers.length == 0 && root.in-use-providers.length == 0 : Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 120px;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: Theme.sp-2;
                                    Text {
                                        text: "No AI providers configured";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                        horizontal-alignment: center;
                                    }
                                    Text {
                                        text: "Add a provider to connect to Ollama, OpenAI, Anthropic, or any OpenAI-compatible API.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        horizontal-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // ── MODELS ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.accent;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.accent-glow;
                                }
                                Text {
                                    text: "MODELS";
                                    color: Theme.accent;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                // Refresh button
                                TouchArea {
                                    width: 28px;
                                    height: 28px;
                                    clicked => { root.refresh-models(); }
                                    Rectangle {
                                        border-radius: 14px;
                                        background: Theme.hover-fill;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        Icon {
                                            commands: Icons.refresh;
                                            size: 14px;
                                            tint: Theme.accent;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }

                            // Model list
                            for model[midx] in root.available-models : TouchArea {
                                height: 56px;
                                clicked => { root.select-model(model.id); }

                                Rectangle {
                                    background: model.is-active
                                        ? AppIdentity.tint
                                        : Theme.bg-card;
                                    border-radius: Theme.r-lg;
                                    border-width: 1px;
                                    border-color: model.is-active ? Theme.accent-dim : Theme.border-subtle;

                                    HorizontalLayout {
                                        padding-left: Theme.sp-4;
                                        padding-right: Theme.sp-4;
                                        spacing: Theme.sp-3;

                                        // Active indicator
                                        if model.is-active : Rectangle {
                                            width: 6px;
                                            height: 6px;
                                            y: (parent.height - 6px) / 2;
                                            border-radius: 3px;
                                            background: Theme.accent;
                                            drop-shadow-blur: 6px;
                                            drop-shadow-color: Theme.accent-glow;
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            alignment: center;
                                            Text {
                                                text: model.name;
                                                color: model.is-active ? AppIdentity.accent : Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                font-weight: model.is-active ? 600 : 400;
                                            }
                                            HorizontalLayout {
                                                spacing: Theme.sp-2;
                                                if model.param-count != "" : Text {
                                                    text: model.param-count;
                                                    color: Theme.text-dim;
                                                    font-size: Theme.fs-caption;
                                                }
                                                if model.context-length != "" : Text {
                                                    text: model.context-length + " ctx";
                                                    color: Theme.text-dim;
                                                    font-size: Theme.fs-caption;
                                                }
                                                if model.is-local : Text {
                                                    text: "local";
                                                    color: Theme.color-success;
                                                    font-size: Theme.fs-caption;
                                                    font-weight: 500;
                                                }
                                            }
                                        }

                                        // Tier badge
                                        if model.tier != "" : Rectangle {
                                            width: mtier-txt.preferred-width + 12px;
                                            height: 20px;
                                            y: (parent.height - 20px) / 2;
                                            border-radius: 10px;
                                            background: model.tier == "Large" ? AppIdentity.tint
                                                      : model.tier == "Medium" ? Theme.tint-cyan
                                                      : model.tier == "Small" ? Theme.tint-amber
                                                      : Theme.border-subtle;
                                            mtier-txt := Text {
                                                text: model.tier;
                                                color: model.tier == "Large" ? AppIdentity.accent
                                                     : model.tier == "Medium" ? AppIdentity.accent
                                                     : model.tier == "Small" ? Theme.amber
                                                     : Theme.text-secondary;
                                                font-size: Theme.fs-micro;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }

                            // Empty model state
                            if root.available-models.length == 0 : Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 64px;

                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    Text {
                                        // This lists a saved provider's models. With none chosen for the
                                        // companion, its model comes from config.yaml: say which, never "none".
                                        text: root.ai-status.model-name != "" && root.ai-status.provider-type == "from config.yaml"
                                            ? "The built-in companion uses " + root.ai-status.model-name + ", set in /opt/yantrik/config.yaml. Models are listed here for a provider you save and use for the companion."
                                            : "No models listed yet. Save a provider, use it for the companion, and refresh.";
                                        wrap: word-wrap;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // ── FALLBACK ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.amber;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.amber-glow;
                                }
                                Text {
                                    text: "FALLBACK";
                                    color: Theme.amber;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: fallback-layout.preferred-height;

                                fallback-layout := VerticalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;

                                    HorizontalLayout {
                                        Text {
                                            text: "Auto-fallback";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            horizontal-stretch: 1;
                                        }
                                        TouchArea {
                                            width: 44px;
                                            height: 24px;
                                            clicked => { root.toggle-auto-fallback(); }
                                            Rectangle {
                                                border-radius: Theme.r-lg;
                                                background: root.ai-status.using-fallback ? AppIdentity.accent : Theme.border-default;
                                                border-width: 1px;
                                                border-color: root.ai-status.using-fallback ? Theme.accent-dim : Theme.border-subtle;
                                                // Toggle knob
                                                Rectangle {
                                                    width: 18px;
                                                    height: 18px;
                                                    x: root.ai-status.using-fallback ? parent.width - 21px : 3px;
                                                    y: 3px;
                                                    border-radius: 9px;
                                                    background: Theme.text-primary;
                                                    animate x { duration: Theme.dur-fast; easing: ease-in-out; }
                                                    animate background { duration: Theme.dur-fast; }
                                                }
                                            }
                                        }
                                    }

                                    Text {
                                        text: "When the provider the companion uses fails 3 times, switch the companion to the fallback provider.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // ── DECISION MODEL ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.accent;
                                }
                                Text {
                                    text: "DECISION MODEL";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }
                            DecisionModelCard {
                                presets: root.decision-presets;
                                provider: root.decision-provider;
                                endpoint: root.decision-endpoint;
                                model: root.decision-model;
                                key-env: root.decision-key-env;
                                uses: root.decision-uses;
                                where-note: root.decision-where;
                                leaves-machine: root.decision-leaves-machine;
                                status: root.decision-status;
                                status-good: root.decision-status-good;
                                choose(id) => { root.decision-choose(id); }
                                save(e, m, k) => { root.decision-save(e, m, k); }
                                test => { root.decision-test(); }
                                toggle-use(id) => { root.decision-toggle-use(id); }
                            }

                            // ── TASK ROUTING (V60) ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.color-purple;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.color-purple-dim;
                                }
                                Text {
                                    text: "TASK ROUTING";
                                    color: Theme.color-purple;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: routing-layout.preferred-height;

                                routing-layout := VerticalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;

                                    Text {
                                        text: "Route tasks to different providers by speed tier.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                    }

                                    // Fast tier
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Rectangle {
                                            width: 8px; height: 8px;
                                            y: (parent.height - 8px) / 2;
                                            border-radius: 4px;
                                            background: Theme.color-success;
                                        }
                                        Text {
                                            text: "Fast";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            width: 80px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.route-fast-provider != "" ? root.route-fast-provider : "Auto";
                                            color: Theme.accent;
                                            font-size: Theme.fs-body;
                                            font-weight: 500;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Balanced tier
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Rectangle {
                                            width: 8px; height: 8px;
                                            y: (parent.height - 8px) / 2;
                                            border-radius: 4px;
                                            background: Theme.holo-blue;
                                        }
                                        Text {
                                            text: "Balanced";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            width: 80px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.route-balanced-provider != "" ? root.route-balanced-provider : "Auto";
                                            color: Theme.accent;
                                            font-size: Theme.fs-body;
                                            font-weight: 500;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Powerful tier
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Rectangle {
                                            width: 8px; height: 8px;
                                            y: (parent.height - 8px) / 2;
                                            border-radius: 4px;
                                            background: Theme.color-purple;
                                        }
                                        Text {
                                            text: "Powerful";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            width: 80px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.route-powerful-provider != "" ? root.route-powerful-provider : "Auto";
                                            color: Theme.accent;
                                            font-size: Theme.fs-body;
                                            font-weight: 500;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            // ── PRIVACY (V60) ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.color-success;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.color-success-dim;
                                }
                                Text {
                                    text: "PRIVACY";
                                    color: Theme.color-success;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: privacy-layout.preferred-height;

                                privacy-layout := VerticalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;

                                    // The vault, first, because on most machines the true answer
                                    // is "not protected" and nothing has ever said so out loud.
                                    //
                                    // `vault-why` is written by the shell and is the whole value
                                    // of this row: a bare "off" reads as a feature nobody turned
                                    // on, and the real reason — this session signs in without a
                                    // password — is a fact about the machine that the person can
                                    // do something about.
                                    Text {
                                        text: "Credential vault";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                    }

                                    Rectangle {
                                        border-radius: Theme.r-md;
                                        background: Theme.bg-elevated;
                                        border-width: 1px;
                                        border-color: root.vault-protected
                                            ? Theme.border-subtle : Theme.color-warning;
                                        height: vault-row.preferred-height;

                                        vault-row := VerticalLayout {
                                            padding: Theme.sp-3;
                                            spacing: Theme.sp-1;

                                            Text {
                                                text: root.vault-protected
                                                    ? (root.vault-unlocked
                                                        ? "Locked with a passphrase · open in this session"
                                                        : "Locked with a passphrase · shut")
                                                    : "Not protected";
                                                color: root.vault-protected
                                                    ? Theme.text-primary : Theme.color-warning;
                                                font-size: Theme.fs-body-strong;
                                                wrap: word-wrap;
                                            }

                                            Text {
                                                text: root.vault-protected
                                                    ? "Saved credentials are encrypted under a key that is itself wrapped with your passphrase. A copy of the memory database is no use without it."
                                                    : root.vault-why;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                wrap: word-wrap;
                                            }

                                            Rectangle {
                                                height: Theme.h-regular;
                                                border-radius: Theme.r-md;
                                                background: vault-btn.has-hover
                                                    ? Theme.amber-glow : transparent;
                                                border-width: 1px;
                                                border-color: Theme.amber;

                                                vault-btn := TouchArea {
                                                    mouse-cursor: pointer;
                                                    // Raises the shell's own prompt and nothing
                                                    // else. The passphrase is never typed here:
                                                    // this panel is reachable from the control
                                                    // surface (`show_screen settings`), and a
                                                    // field on a screen an agent can open is a
                                                    // field an agent can be in front of.
                                                    clicked => { root.vault-set-passphrase(); }
                                                }
                                                Text {
                                                    text: root.vault-protected
                                                        ? "Change vault passphrase"
                                                        : "Set a vault passphrase";
                                                    color: Theme.amber-light;
                                                    font-size: Theme.fs-body-strong;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    wrap: no-wrap;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }

                                    // Privacy presets
                                    Text {
                                        text: "Privacy Level";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.sp-2;

                                        for preset-item in [
                                            { label: "Maximum", value: "maximum" },
                                            { label: "Balanced", value: "balanced" },
                                            { label: "Cloud-First", value: "cloud-first" }
                                        ] : TouchArea {
                                            horizontal-stretch: 1;
                                            height: 32px;
                                            clicked => {
                                                root.privacy-preset = preset-item.value;
                                                root.set-privacy-preset(preset-item.value);
                                            }
                                            Rectangle {
                                                border-radius: Theme.r-md;
                                                background: root.privacy-preset == preset-item.value ? Theme.color-success-dim : Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: root.privacy-preset == preset-item.value ? Theme.color-success-dim : Theme.border-subtle;
                                                Text {
                                                    text: preset-item.label;
                                                    color: root.privacy-preset == preset-item.value ? Theme.color-success : Theme.text-secondary;
                                                    font-size: Theme.fs-caption;
                                                    font-weight: root.privacy-preset == preset-item.value ? 600 : 400;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Local-only toggle
                                    HorizontalLayout {
                                        Text {
                                            text: "Local-only rules";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Never send data to cloud";
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { width: 8px; }
                                        TouchArea {
                                            width: 44px; height: 24px;
                                            clicked => { root.privacy-local-only = !root.privacy-local-only; }
                                            Rectangle {
                                                border-radius: Theme.r-lg;
                                                background: root.privacy-local-only ? Theme.color-success : Theme.border-default;
                                                border-width: 1px;
                                                border-color: root.privacy-local-only ? Theme.color-success-dim : Theme.border-subtle;
                                                Rectangle {
                                                    width: 18px; height: 18px;
                                                    x: root.privacy-local-only ? parent.width - 21px : 3px;
                                                    y: 3px;
                                                    border-radius: 9px;
                                                    background: Theme.text-primary;
                                                    animate x { duration: Theme.dur-fast; easing: ease-in-out; }
                                                }
                                            }
                                        }
                                    }

                                    // Cloud escalation confirmation toggle
                                    HorizontalLayout {
                                        Text {
                                            text: "Cloud escalation confirm";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "Ask before cloud send";
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { width: 8px; }
                                        TouchArea {
                                            width: 44px; height: 24px;
                                            clicked => { root.privacy-cloud-confirm = !root.privacy-cloud-confirm; }
                                            Rectangle {
                                                border-radius: Theme.r-lg;
                                                background: root.privacy-cloud-confirm ? AppIdentity.accent : Theme.border-default;
                                                border-width: 1px;
                                                border-color: root.privacy-cloud-confirm ? Theme.accent-dim : Theme.border-subtle;
                                                Rectangle {
                                                    width: 18px; height: 18px;
                                                    x: root.privacy-cloud-confirm ? parent.width - 21px : 3px;
                                                    y: 3px;
                                                    border-radius: 9px;
                                                    background: Theme.text-primary;
                                                    animate x { duration: Theme.dur-fast; easing: ease-in-out; }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ── USAGE & COST (V62) ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.holo-blue;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.holo-blue-glow;
                                }
                                Text {
                                    text: "USAGE & COST";
                                    color: Theme.holo-blue;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }

                            // Usage dashboard card
                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: usage-layout.preferred-height;

                                usage-layout := VerticalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;

                                    // Cost overview
                                    HorizontalLayout {
                                        spacing: Theme.sp-6;
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Daily Cost";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                            Text {
                                                text: root.usage-daily-cost;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Monthly Cost";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                            Text {
                                                text: root.usage-total-cost;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                        }
                                        VerticalLayout {
                                            spacing: 2px;
                                            horizontal-stretch: 1;
                                            Text {
                                                text: "Tokens Today";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                            Text {
                                                text: root.usage-tokens-today;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-headline;
                                                font-weight: 600;
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Local vs Cloud bar
                                    Text {
                                        text: "Local vs Cloud";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                    }

                                    usage-bar := Rectangle {
                                        height: 12px;
                                        border-radius: Theme.r-sm;
                                        background: Theme.border-subtle;
                                        clip: true;
                                        // Local segment (left)
                                        Rectangle {
                                            x: 0px;
                                            y: 0px;
                                            width: usage-bar.width * (root.usage-local-percent / 100.0);
                                            height: 12px;
                                            background: Theme.color-success;
                                            border-radius: Theme.r-sm;
                                        }
                                        // Cloud segment (right of local)
                                        Rectangle {
                                            x: usage-bar.width * (root.usage-local-percent / 100.0);
                                            y: 0px;
                                            width: usage-bar.width * (root.usage-cloud-percent / 100.0);
                                            height: 12px;
                                            background: Theme.holo-blue;
                                        }
                                    }

                                    HorizontalLayout {
                                        HorizontalLayout {
                                            spacing: Theme.sp-1;
                                            horizontal-stretch: 1;
                                            Rectangle {
                                                width: 8px; height: 8px;
                                                y: (parent.height - 8px) / 2;
                                                border-radius: 4px;
                                                background: Theme.color-success;
                                            }
                                            Text {
                                                text: "Local " + round(root.usage-local-percent) + "%";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                vertical-alignment: center;
                                            }
                                        }
                                        HorizontalLayout {
                                            spacing: Theme.sp-1;
                                            Rectangle {
                                                width: 8px; height: 8px;
                                                y: (parent.height - 8px) / 2;
                                                border-radius: 4px;
                                                background: Theme.holo-blue;
                                            }
                                            Text {
                                                text: "Cloud " + round(root.usage-cloud-percent) + "%";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    // Budget controls
                                    Text {
                                        text: "MONTHLY BUDGET";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-weight: 600;
                                        letter-spacing: 2px;
                                    }

                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Rectangle {
                                            horizontal-stretch: 1;
                                            height: 32px;
                                            border-radius: Theme.r-md;
                                            background: Theme.bg-input;
                                            border-width: 1px;
                                            border-color: root.budget-warning ? Theme.amber-dim : Theme.border-subtle;
                                            clip: true;
                                            budget-input-field := TextInput {
                                                x: 8px;
                                                width: parent.width - 16px;
                                                height: 100%;
                                                text <=> root.budget-input;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                                accepted => { root.save-budget(self.text); }
                                            }
                                            if root.budget-input == "" : Text {
                                                x: 8px;
                                                text: "e.g. $20.00";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                                opacity: 0.5;
                                            }
                                        }
                                        TouchArea {
                                            width: 60px; height: 32px;
                                            clicked => { root.save-budget(root.budget-input); }
                                            Rectangle {
                                                border-radius: Theme.r-md;
                                                background: Theme.hover-fill;
                                                border-width: 1px;
                                                border-color: Theme.border-subtle;
                                                Text {
                                                    text: "Set";
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-caption;
                                                    font-weight: 600;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    // Budget progress bar
                                    if root.budget-limit != "" : VerticalLayout {
                                        spacing: Theme.sp-1;
                                        HorizontalLayout {
                                            Text {
                                                text: "Used";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                horizontal-stretch: 1;
                                            }
                                            Text {
                                                text: root.usage-total-cost + " / " + root.budget-limit;
                                                color: root.budget-warning ? Theme.amber : Theme.text-secondary;
                                                font-size: Theme.fs-caption;
                                                font-weight: 500;
                                            }
                                        }
                                        Rectangle {
                                            height: 6px;
                                            border-radius: 3px;
                                            background: Theme.border-subtle;
                                            Rectangle {
                                                width: parent.width * min(1.0, root.budget-used-percent / 100.0);
                                                height: 6px;
                                                border-radius: 3px;
                                                background: root.budget-used-percent > 90 ? Theme.color-emotional
                                                          : root.budget-used-percent > 70 ? Theme.amber
                                                          : Theme.accent;
                                            }
                                        }
                                        if root.budget-warning : Text {
                                            text: "Approaching budget limit";
                                            color: Theme.amber;
                                            font-size: Theme.fs-caption;
                                            font-weight: 500;
                                        }
                                    }
                                }
                            }

                            // ── COMPANION ──
                            HorizontalLayout {
                                spacing: Theme.sp-2;
                                Rectangle {
                                    width: 3px; height: 14px;
                                    border-radius: 1.5px;
                                    background: Theme.amber;
                                    drop-shadow-blur: 4px;
                                    drop-shadow-color: Theme.amber-glow;
                                }
                                Text {
                                    text: "COMPANION";
                                    color: Theme.amber;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    letter-spacing: 3px;
                                    vertical-alignment: center;
                                }
                            }

                            // Account card
                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: acct-layout.preferred-height;

                                acct-layout := VerticalLayout {
                                    padding: Theme.sp-4;
                                    spacing: Theme.sp-3;

                                    property <bool> editing-user: false;
                                    HorizontalLayout {
                                        Text {
                                            text: "User";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            horizontal-stretch: 1;
                                        }
                                        if !acct-layout.editing-user: TouchArea {
                                            width: user-display.preferred-width;
                                            height: user-display.preferred-height;
                                            clicked => { acct-layout.editing-user = true; }
                                            user-display := HorizontalLayout {
                                                spacing: Theme.sp-2;
                                                Text {
                                                    text: root.user-name;
                                                    color: Theme.text-primary;
                                                    font-size: Theme.fs-body;
                                                }
                                                Icon {
                                                    commands: Icons.pencil;
                                                    size: 12px;
                                                    tint: Theme.text-dim;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                        if acct-layout.editing-user: Rectangle {
                                            width: 160px;
                                            height: 28px;
                                            border-radius: 4px;
                                            background: Theme.border-subtle;
                                            border-width: 1px;
                                            border-color: Theme.accent;
                                            clip: true;
                                            user-input := TextInput {
                                                text: root.user-name;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                                accepted => {
                                                    root.user-name = self.text;
                                                    root.rename-user(self.text);
                                                    acct-layout.editing-user = false;
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { height: 1px; background: Theme.border-subtle; }

                                    property <bool> editing-companion: false;
                                    HorizontalLayout {
                                        Text {
                                            text: "Companion";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            horizontal-stretch: 1;
                                        }
                                        if !acct-layout.editing-companion: TouchArea {
                                            width: comp-display.preferred-width;
                                            height: comp-display.preferred-height;
                                            clicked => { acct-layout.editing-companion = true; }
                                            comp-display := HorizontalLayout {
                                                spacing: Theme.sp-2;
                                                Text {
                                                    text: root.companion-name;
                                                    color: Theme.amber;
                                                    font-size: Theme.fs-body;
                                                    font-weight: 500;
                                                }
                                                Icon {
                                                    commands: Icons.pencil;
                                                    size: 12px;
                                                    tint: Theme.text-dim;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                        if acct-layout.editing-companion: Rectangle {
                                            width: 160px;
                                            height: 28px;
                                            border-radius: 4px;
                                            background: Theme.border-subtle;
                                            border-width: 1px;
                                            border-color: Theme.amber;
                                            clip: true;
                                            comp-input := TextInput {
                                                text: root.companion-name;
                                                color: Theme.amber;
                                                font-size: Theme.fs-body;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                                accepted => {
                                                    root.companion-name = self.text;
                                                    root.rename-companion(self.text);
                                                    acct-layout.editing-companion = false;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Nav links: Bond, Personality, Memory
                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 52px;
                                TouchArea { clicked => { root.navigate-to(4); } }
                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    Text {
                                        text: "Bond";
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Icon {
                                        commands: Icons.arrow-right;
                                        size: 16px;
                                        tint: Theme.accent-dim;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 52px;
                                TouchArea { clicked => { root.navigate-to(5); } }
                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    Text {
                                        text: "Personality";
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Icon {
                                        commands: Icons.arrow-right;
                                        size: 16px;
                                        tint: Theme.accent-dim;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            Rectangle {
                                background: Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: Theme.border-subtle;
                                height: 52px;
                                TouchArea { clicked => { root.navigate-to(6); } }
                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    Text {
                                        text: "Memory Browser";
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        horizontal-stretch: 1;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: mem-count-txt.preferred-width + 14px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 10px;
                                        background: Theme.tint-amber;
                                        mem-count-txt := Text {
                                            text: root.memory-count;
                                            color: Theme.amber;
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Icon {
                                        commands: Icons.arrow-right;
                                        size: 16px;
                                        tint: Theme.accent-dim;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // Bottom spacer
                            Rectangle { height: 40px; }
                        }
                    }

                    // ── ADD/EDIT PROVIDER OVERLAY ──
                    if root.provider-panel-open : Rectangle {
                        width: 100%;
                        height: 100%;
                        background: Theme.overlay-backdrop;

                        TouchArea {
                            clicked => { root.provider-panel-open = false; root.editing-provider-id = ""; }
                        }

                        Rectangle {
                            x: (parent.width - 480px) / 2;
                            y: (parent.height - self.height) / 2;
                            width: 480px;
                            height: min(provider-panel-layout.preferred-height, parent.height - 40px);
                            background: Theme.bg-deep;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.accent-dim;
                            drop-shadow-blur: 40px;
                            drop-shadow-color: Theme.overlay-backdrop;
                            clip: true;

                            // Block clicks from propagating to backdrop
                            TouchArea {}

                            // Scrolls when the panel is taller than the window. It had no viewport
                            // height, so it never did — and with the catalogue's 39 presets the
                            // form under the grid was off the bottom with no way to reach it.
                            Flickable {
                                width: 100%;
                                height: 100%;
                                viewport-height: provider-panel-layout.preferred-height;
                            provider-panel-layout := VerticalLayout {
                                width: parent.width;
                                padding: Theme.sp-6;
                                spacing: Theme.sp-4;

                                // Title
                                Text {
                                    text: root.editing-provider-id == "" ? "Add Provider" : "Edit Provider";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-headline;
                                    font-weight: 700;
                                }

                                // Two steps. First the provider, from the grid; once one is
                                // chosen the grid folds to a line naming it, with Change, and the
                                // form takes its place — nothing to scroll past to reach Connect.
                                // Editing a saved provider starts at the second step: its preset
                                // is chosen already.
                                if root.selected-preset == "" : Text {
                                    text: "Choose a provider, or Custom for any OpenAI-compatible address:";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    wrap: word-wrap;
                                }

                                if root.selected-preset != "" : HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    Rectangle {
                                        height: 32px;
                                        width: chosen-label.preferred-width + Theme.sp-6;
                                        border-radius: Theme.r-md;
                                        background: Theme.accent-dim;
                                        border-width: 1px;
                                        border-color: AppIdentity.accent;
                                        chosen-label := Text {
                                            text: root.selected-preset == "custom" ? "Custom"
                                                : root.provider-form-name != "" ? root.provider-form-name
                                                : root.selected-preset;
                                            // Primary text on the tint: the accent on its own dim
                                            // tint read as teal on teal.
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-caption;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    if root.editing-provider-id == "" : TouchArea {
                                        width: change-label.preferred-width + Theme.sp-4;
                                        height: 32px;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.selected-preset = "";
                                            root.provider-form-connected = false;
                                            root.provider-test-result = "";
                                        }
                                        change-label := Text {
                                            text: "Change";
                                            color: parent.has-hover ? AppIdentity.accent : Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                }

                                // Preset buttons — categorized grid
                                if root.selected-preset == "" : VerticalLayout {
                                    spacing: Theme.sp-3;

                                    // Groups and rows come from the provider catalogue (Rust),
                                    // five cells to a row, short rows padded with blank cells.
                                    for group in root.provider-presets : VerticalLayout {
                                        spacing: Theme.sp-3;
                                        Text {
                                            text: group.title;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            letter-spacing: 2px;
                                        }
                                        for row in group.rows : HorizontalLayout {
                                            spacing: Theme.sp-2;
                                            for p in row.items : TouchArea {
                                                horizontal-stretch: 1;
                                                height: 32px;
                                                enabled: p.id != "";
                                                clicked => { root.selected-preset = p.id; root.provider-preset-selected(p.id); }
                                                if p.id != "" : Rectangle {
                                                    border-radius: Theme.r-md;
                                                    background: root.selected-preset == p.id ? Theme.accent-dim : Theme.hover-fill;
                                                    border-width: 1px;
                                                    border-color: root.selected-preset == p.id ? AppIdentity.accent : Theme.border-subtle;
                                                    Text {
                                                        text: p.label;
                                                        color: Theme.text-primary;
                                                        font-size: Theme.fs-caption;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    // Custom
                                    TouchArea {
                                        height: 32px;
                                        clicked => { root.selected-preset = "custom"; root.provider-preset-selected("custom"); }
                                        Rectangle {
                                            border-radius: Theme.r-md;
                                            background: root.selected-preset == "custom" ? Theme.accent-dim : Theme.hover-fill;
                                            border-width: 1px;
                                            border-color: root.selected-preset == "custom" ? AppIdentity.accent : Theme.border-subtle;
                                            Text {
                                                text: "Custom";
                                                color: root.selected-preset == "custom" ? AppIdentity.accent : Theme.text-primary;
                                                font-size: Theme.fs-caption;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.border-subtle; }

                                // Form fields
                                VerticalLayout {
                                    spacing: Theme.sp-3;

                                    // Name
                                    VerticalLayout {
                                        spacing: Theme.sp-1;
                                        Text {
                                            text: "Name";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.r-md;
                                            background: Theme.bg-input;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            clip: true;
                                            prov-name-input := TextInput {
                                                text <=> root.provider-form-name;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Base URL
                                    VerticalLayout {
                                        spacing: Theme.sp-1;
                                        Text {
                                            text: "Base URL";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.r-md;
                                            background: Theme.bg-input;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            clip: true;
                                            prov-url-input := TextInput {
                                                text <=> root.provider-form-url;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                                edited => { root.provider-form-connected = false; root.provider-test-result = ""; root.provider-url-changed(self.text); }
                                            }
                                        }
                                    }

                                    // API Key
                                    VerticalLayout {
                                        spacing: Theme.sp-1;
                                        Text {
                                            text: "API Key";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                        }
                                        Rectangle {
                                            height: 36px;
                                            border-radius: Theme.r-md;
                                            background: Theme.bg-input;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            clip: true;
                                            prov-key-input := TextInput {
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                vertical-alignment: center;
                                                input-type: password;
                                                edited => { root.provider-form-connected = false; root.provider-test-result = ""; }
                                            }
                                            if prov-key-input.text == "" && root.editing-provider-id != "" : Text {
                                                // A saved key stays with the address it was saved for: a new
                                                // host has to be given its key, never handed the old one.
                                                text: root.provider-form-host-changed
                                                    ? "New address: enter its key. The saved key stays with the old one."
                                                    : "Saved key kept unless you type a new one";
                                                color: root.provider-form-host-changed ? Theme.amber : Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                vertical-alignment: center;
                                                opacity: root.provider-form-host-changed ? 1.0 : 0.6;
                                            }
                                        }
                                    }
                                }

                                // Connect's answer: how many models, or what went wrong
                                if root.provider-test-result != "" : Rectangle {
                                    height: result-txt.preferred-height + 12px;
                                    border-radius: Theme.r-sm;
                                    background: root.provider-test-result == "success" ? Theme.color-success-dim
                                              : root.provider-test-result == "testing" ? Theme.tint-amber
                                              : Theme.color-danger-dim;
                                    result-txt := Text {
                                        x: Theme.sp-3;
                                        width: parent.width - Theme.sp-6;
                                        text: root.provider-test-result == "success" ? "Connected: " + root.provider-form-model-total + " models"
                                            : root.provider-test-result == "testing" ? "Connecting and listing models..."
                                            : root.provider-test-result;
                                        color: root.provider-test-result == "success" ? Theme.color-success
                                             : root.provider-test-result == "testing" ? Theme.amber
                                             : Theme.color-emotional;
                                        font-size: Theme.fs-caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: word-wrap;
                                    }
                                }

                                // Model: picked from what the provider listed
                                if root.provider-form-model-total > 0 : VerticalLayout {
                                    spacing: Theme.sp-2;
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Text {
                                            text: "Model";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-caption;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.provider-form-model;
                                            color: AppIdentity.accent;
                                            font-size: Theme.fs-caption;
                                            font-weight: 600;
                                            overflow: elide;
                                            horizontal-stretch: 1;
                                            vertical-alignment: center;
                                        }
                                    }
                                    // Many models (OpenRouter lists hundreds): search them.
                                    if root.provider-form-model-total > 8 : YInput {
                                        mode: 1;
                                        placeholder: "Search " + root.provider-form-model-total + " models";
                                        edited(text) => { root.provider-model-search(text); }
                                    }
                                    if root.provider-form-models.length > 0 : Rectangle {
                                        height: min(root.provider-form-models.length * 30px, 180px);
                                        border-radius: Theme.r-md;
                                        background: Theme.bg-input;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        clip: true;
                                        ListView {
                                            for m in root.provider-form-models : TouchArea {
                                                height: 30px;
                                                clicked => { root.provider-form-model = m; }
                                                Rectangle {
                                                    background: root.provider-form-model == m ? Theme.accent-dim
                                                              : parent.has-hover ? Theme.hover-fill : transparent;
                                                    Text {
                                                        x: Theme.sp-3;
                                                        width: parent.width - Theme.sp-6;
                                                        text: m;
                                                        color: root.provider-form-model == m ? AppIdentity.accent : Theme.text-primary;
                                                        font-size: Theme.fs-caption;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                    if root.provider-form-models.length == 0 : Text {
                                        text: "No listed model matches.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                    }
                                }

                                // Save works without Connect, but says what that means.
                                if !root.provider-form-connected && root.provider-test-result == ""
                                    && (prov-key-input.text != "" || root.provider-form-url != "") : Text {
                                    text: prov-key-input.text != ""
                                        ? "This key is untested. Connect checks it and lists the models to pick from."
                                        : "Not connected yet. Connect lists the models to pick from.";
                                    color: Theme.amber;
                                    font-size: Theme.fs-caption;
                                    wrap: word-wrap;
                                }

                                // Action buttons
                                HorizontalLayout {
                                    spacing: Theme.sp-3;
                                    alignment: end;

                                    // Connect: check the key and list the models
                                    TouchArea {
                                        width: test-new-txt.preferred-width + 24px;
                                        height: 36px;
                                        clicked => {
                                            root.connect-provider(root.selected-preset, prov-url-input.text, prov-key-input.text);
                                        }
                                        Rectangle {
                                            border-radius: Theme.r-md;
                                            background: Theme.hover-fill;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            test-new-txt := Text {
                                                text: "Connect";
                                                color: Theme.accent;
                                                font-size: Theme.fs-body;
                                                font-weight: 500;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Cancel
                                    TouchArea {
                                        width: cancel-txt.preferred-width + 24px;
                                        height: 36px;
                                        clicked => { root.provider-panel-open = false; root.editing-provider-id = ""; }
                                        Rectangle {
                                            border-radius: Theme.r-md;
                                            background: Theme.hover-fill;
                                            border-width: 1px;
                                            border-color: Theme.border-subtle;
                                            cancel-txt := Text {
                                                text: "Cancel";
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-body;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Save
                                    TouchArea {
                                        width: save-txt.preferred-width + 24px;
                                        height: 36px;
                                        clicked => {
                                            root.save-provider(prov-name-input.text, root.selected-preset == "" ? "custom" : root.selected-preset,
                                                prov-url-input.text, prov-key-input.text, "bearer", root.provider-form-model);
                                            if(!root.save-error){root.provider-panel-open = false;}
                                        }
                                        Rectangle {
                                            border-radius: Theme.r-md;
                                            background: Theme.accent;
                                            border-width: 1px;
                                            border-color: Theme.accent-light;
                                            save-txt := Text {
                                                text: "Save";
                                                color: Theme.text-on-accent;
                                                font-size: Theme.fs-body;
                                                font-weight: 600;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }
                                }
                            }
                            } // Flickable
                        }
                    }
                }

                // ===== CATEGORY 2: DESKTOP =====
                if root.active-category == 2 : Flickable {
                    width:100%;height:100%;viewport-width:self.width;viewport-height:page2.preferred-height;
                    page2:=VerticalLayout {padding:28px;spacing:18px;alignment:start;
                        Text{text:"Desktop";color:Theme.text-primary;font-size:28px;font-weight:600;}
                        Text{text:"Make space for the way you work.";color:Theme.text-secondary;font-size:13px;wrap:word-wrap;}

SettingRow{label:"Your workspace";description:"Everyday keeps the desktop calm. Overview shows active work and system information.";value:root.agent-mode?"Overview":"Everyday";activated=>{root.set-agent-mode(!root.agent-mode);}}
SettingRow{label:"Wallpaper and appearance";description:"Choose a scene, a light or dark appearance, and your accent color.";value:"Personalize";activated=>{root.active-category=0;}}
SettingRow{label:"Find a setting";description:"Search by category or by controls such as wallpaper, Wi-Fi, or notifications.";value:"Ctrl + F";interactive:false;}
SettingRow{label:"Clear search";description:"Return to the complete settings list.";value:"Escape";interactive:false;}

                        Rectangle{height:24px;}
                    }
                }

                // ===== CATEGORY 3: NETWORK =====
                if root.active-category == 3 : Flickable {
                    width:100%;height:100%;viewport-width:self.width;viewport-height:page3.preferred-height;
                    page3:=VerticalLayout {padding:28px;spacing:18px;alignment:start;
                        Text{text:"Network";color:Theme.text-primary;font-size:28px;font-weight:600;}
                        Text{text:"Connection information from this device.";color:Theme.text-secondary;font-size:13px;wrap:word-wrap;}

SettingRow{label:root.network-label;description:root.network-detail!=""?root.network-detail:"What this machine is connected over, as the network service reports it.";value:root.network-online?"Connected":"Offline";interactive:false;}
SettingRow{label:"IP address";description:"The address reported by the system monitor.";value:root.ip-address!=""?root.ip-address:"Not available";interactive:false;}
SettingRow{label:"Network manager";description:"Open the native app to inspect and manage connections.";value:"Open";activated=>{root.open-network();}}

                        Rectangle{height:24px;}
                    }
                }

                // ===== CATEGORY 5: PRIVACY & SECURITY =====
                if root.active-category == 5 : Flickable {
                    width:100%;height:100%;viewport-width:self.width;viewport-height:page5.preferred-height;
                    page5:=VerticalLayout {padding:28px;spacing:18px;alignment:start;
                        Text{text:"Privacy & security";color:Theme.text-primary;font-size:28px;font-weight:600;}
                        Text{text:"Clear controls, with their scope explained.";color:Theme.text-secondary;font-size:13px;wrap:word-wrap;}

SettingRow{label:"Incognito";description:"Pause new built-in companion memories for this session. Existing memories remain. Resets when the shell restarts.";value:root.incognito-mode?"On":"Off";activated=>{root.toggle-incognito-mode();}}
SettingRow{label:"Do Not Disturb";description:"Mute shell notification interruptions. This preference stays after a restart.";value:root.dnd-mode?"On":"Off";activated=>{root.toggle-dnd-mode();}}
SettingRow{label:"Lock when away";description:"Lock the screen after this long with no keyboard or mouse. An agent working does not count as you being here.";value:root.auto-lock-secs==0?"Never":!root.auto-lock-available?"Unavailable on this display":root.auto-lock-secs<60?"30 seconds":"\{root.auto-lock-secs/60} minutes";activated=>{root.cycle-auto-lock();}}
SettingRow{label:"Permissions";description:"Review the shell's tool permissions and outstanding requests.";value:"Review";activated=>{root.navigate-to(28);}}

                        Rectangle{height:24px;}
                    }
                }

                // ===== CATEGORY 6: SYSTEM =====
                if root.active-category == 6 : Flickable {
                    width:100%;height:100%;viewport-width:self.width;viewport-height:page6.preferred-height;
                    page6:=VerticalLayout {padding:28px;spacing:18px;alignment:start;
                        Text{text:"System";color:Theme.text-primary;font-size:28px;font-weight:600;}
                        Text{text:"Your device, apps, and system information.";color:Theme.text-secondary;font-size:13px;wrap:word-wrap;}

SettingRow{label:"Yantrik OS";description:"Native desktop workspace";value:root.version-text!=""?root.version-text:"unknown";interactive:false;}
SettingRow{label:"Display";description:"Current display resolution reported by the shell.";value:root.display-resolution!=""?root.display-resolution:"Automatic";interactive:false;}
SettingRow{label:"System monitor";description:"Inspect processor, memory, storage and running processes.";value:"Open";activated=>{root.navigate-to(10);}}
SettingRow{label:"Notifications";description:"Review notifications and requests in one place.";value:"Open";activated=>{root.navigate-to(9);}}
SettingRow{label:"About this device";description:"Detailed information about this installation.";value:"About";activated=>{root.navigate-to(16);}}

                        Rectangle{height:24px;}
                    }
                }

                // ===== CATEGORY 4: ACCOUNTS & SERVICES =====
                if root.active-category == 4 : Flickable {
                    width:100%;height:100%;viewport-width:self.width;viewport-height:page4.preferred-height;
                    page4:=VerticalLayout {padding:28px;spacing:18px;alignment:start;
                        // Read again each time the page opens: a sign-in finished in a terminal
                        // shows up without a restart.
                        init => { root.accounts-shown(); }
                        HorizontalLayout {
                            spacing: Theme.sp-3;
                            VerticalLayout {
                                spacing: 6px;
                                horizontal-stretch: 1;
                                Text{text:"Accounts";color:Theme.text-primary;font-size:28px;font-weight:600;}
                                Text{
                                    text:"Subscriptions you sign in to with each vendor's own program: Claude Code, Codex, Gemini CLI. The vendor's program keeps the sign-in; this desktop never sees it. The account chosen here is the one that program starts with. The minds that answer in the chat do not run on these: they run on AI providers (keys and endpoints), set in each mind's own settings or under AI & Intelligence.";
                                    color:Theme.text-secondary;font-size:13px;wrap:word-wrap;
                                }
                            }
                            VerticalLayout {
                                alignment: start;
                                YButton {
                                    label: root.accounts-adding ? "Done" : "Add account";
                                    clicked => { root.accounts-adding = !root.accounts-adding; }
                                }
                            }
                        }
                        Rectangle {
                            background:Theme.bg-card;border-radius:10px;border-width:1px;border-color:Theme.border-subtle;
                            height: account-list.preferred-height + 32px;
                            account-list := AccountList {
                                x: 16px; y: 16px; width: parent.width - 32px;
                                groups: root.account-groups;
                                choices: root.account-choices;
                                detailed: true;
                                status: root.account-status;
                                adding: root.accounts-adding;
                                divided: root.accounts-adding;
                                use-account(id) => { root.account-use(id); }
                                sign-in(id) => { root.account-sign-in(id); }
                                add(v) => { root.account-add(v); root.accounts-adding = false; }
                            }
                        }
                        // Coding plans paid for with a key are AI providers, not accounts: offered
                        // here, set up there, and never drawn as an account row.
                        if root.accounts-adding && root.account-key-choices.length > 0 : VerticalLayout {
                            spacing: 8px;
                            Text{text:"CODING PLANS BY KEY · set up in AI providers";color:Theme.text-dim;font-size:Theme.fs-micro;font-weight:600;letter-spacing:0.8px;}
                            Rectangle {
                                background:Theme.bg-card;border-radius:10px;border-width:1px;border-color:Theme.border-subtle;
                                height: key-list.preferred-height + 24px;
                                key-list := AccountList {
                                    x: 16px; y: 12px; width: parent.width - 32px;
                                    choices: root.account-key-choices;
                                    adding: true;
                                    divided: false;
                                    say-empty: false;
                                    add(v) => { root.account-add(v); root.accounts-adding = false; }
                                }
                            }
                        }
                        SettingRow{
                            label:"AI providers";
                            description: root.account-keys-line != ""
                                ? root.account-keys-line + ". Keys are managed there, and handed to harnesses from there; they are separate from these sign-ins."
                                : "API keys and endpoints (OpenAI, NVIDIA NIM, Nous, a local Ollama and more), used by the desktop and handed to harnesses. They are separate from these sign-ins.";
                            value:"Configure";activated=>{root.active-category=1;}
                        }
                        SettingRow{label:"Harnesses";description:"The minds that can answer in the chat, which one does, and what each runs on.";value:"Open";activated=>{root.active-category=8;}}

                        Rectangle{height:24px;}
                    }
                }

                // ===== CATEGORY 7: SKILLS =====
                // ── Harnesses (category 8) ──
                if root.active-category == 8 : Flickable {
                    width: 100%;
                    height: 100%;

                    VerticalLayout {
                        padding: Theme.sp-6;
                        spacing: Theme.sp-4;
                        alignment: start;

                        HorizontalLayout {
                            spacing: Theme.sp-2;
                            Rectangle {
                                width: 3px;
                                height: 14px;
                                y: 0;
                                border-radius: 1.5px;
                                background: Theme.accent;
                                drop-shadow-blur: 4px;
                                drop-shadow-color: Theme.accent-glow;
                            }
                            Text {
                                text: "HARNESSES";
                                color: Theme.accent;
                                font-size: Theme.fs-caption;
                                font-weight: 600;
                                letter-spacing: 3px;
                                vertical-alignment: center;
                            }
                        }

                        // Says the model out loud, because the thing people get wrong about this
                        // screen is expecting to configure a harness here.
                        Text {
                            text: "Which mind answers when you ask. A harness brings its own models, keys and setup — this screen only decides which one you are talking to.";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-body;
                            wrap: word-wrap;
                        }

                        if root.harness-error != "" : Rectangle {
                            background: Theme.color-danger-dim;
                            border-radius: Theme.r-md;
                            height: 38px;
                            HorizontalLayout {
                                padding-left: Theme.sp-3;
                                padding-right: Theme.sp-3;
                                Text {
                                    text: root.harness-error;
                                    color: Theme.color-danger;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Every mind this machine could have, whether or not it is running. A
                        // card grows to fit what it has to say, because a row mid-install has a
                        // sentence, a bar and six lines of npm output and a fixed 104px card
                        // clipped all three.
                        for h in root.harness-rows : Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            // The one answering is outlined in the accent: at a glance, before
                            // reading a word, you can see which mind you are talking to.
                            border-color: h.active ? AppIdentity.accent : Theme.border-subtle;
                            height: card.preferred-height;

                            card := VerticalLayout {
                                padding: Theme.sp-4;
                                spacing: Theme.sp-2;

                                HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    Text {
                                        text: h.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    Rectangle {
                                        width: pill-text.preferred-width + 20px;
                                        height: 22px;
                                        border-radius: 11px;
                                        // The state is a colour as well as a word: amber for
                                        // something the person has to do, red for something that
                                        // broke, accent for the mind that is talking.
                                        background: h.active ? AppIdentity.accent
                                                  : root.harness-state-tint(h.state);
                                        pill-text := Text {
                                            text: h.state;
                                            color: h.active ? Theme.bg-deep
                                                 : root.harness-state-color(h.state);
                                            font-size: Theme.fs-caption;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // The id in mono, because it is the thing you type — into
                                // `yos act shell use_harness`, or into your own harness's attach.
                                Text {
                                    text: h.detail != "" ? h.id + "  ·  " + h.detail : h.id;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    font-family: Theme.font-mono;
                                }

                                // The one thing to do next. A file path at most — never anything
                                // that is in the file.
                                if h.need != "" : Text {
                                    text: h.need;
                                    color: root.harness-state-color(h.state);
                                    font-size: Theme.fs-caption;
                                    wrap: word-wrap;
                                }

                                if h.provider-line != "" : Text {
                                    text: h.provider-line;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                }

                                // Which saved provider: one button each. Nothing is written until
                                // the card that follows is answered.
                                if root.assigning-harness == h.id : VerticalLayout {
                                    spacing: Theme.sp-2;
                                    Text {
                                        text: root.ai-providers.length == 0
                                            ? "No saved providers yet. Add one under AI & Intelligence first."
                                            : "Give " + h.name + " which provider?";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        wrap: word-wrap;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        alignment: start;
                                        for p in root.ai-providers : YButton {
                                            label: p.name;
                                            size: 0;
                                            variant: 1;
                                            clicked => { root.plan-provider(h.id, p.id); }
                                        }
                                        YButton {
                                            label: "Cancel";
                                            size: 0;
                                            variant: 1;
                                            clicked => { root.assigning-harness = ""; }
                                        }
                                    }
                                }

                                // Indeterminate on purpose. There is no way to know how far
                                // through an `npm install` is, and a bar that claimed a
                                // percentage would be a lie with a number on it.
                                if h.busy : Rectangle {
                                    height: 3px;
                                    border-radius: 1.5px;
                                    background: Theme.bg-elevated;
                                    clip: true;
                                    Rectangle {
                                        width: parent.width * 0.3;
                                        height: parent.height;
                                        border-radius: 1.5px;
                                        background: AppIdentity.accent;
                                        x: (parent.width - self.width) * root.harness-sweep;
                                    }
                                }

                                // What the install, or the unit that gave up, actually said.
                                if h.log != "" : Text {
                                    text: h.log;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-family: Theme.font-mono;
                                    wrap: word-wrap;
                                }

                                HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    // Only what the harness actually claimed. An empty row here
                                    // is honest about a mind that only talks.
                                    if h.tools : Text {
                                        text: "tools";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                    if h.memory : Text {
                                        text: "memory";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                    if h.docs != "" : Text {
                                        text: h.docs;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                        // Capped so a long staged path cannot push the buttons
                                        // off the right-hand edge of the card.
                                        max-width: 260px;
                                        overflow: elide;
                                    }
                                    Rectangle { horizontal-stretch: 1; }
                                    if h.can-install : YButton {
                                        label: "Install";
                                        size: 0;
                                        variant: 1;
                                        clicked => { root.install-harness(h.id); }
                                    }
                                    if h.can-start : YButton {
                                        label: "Start";
                                        size: 0;
                                        variant: 1;
                                        clicked => { root.start-harness(h.id); }
                                    }
                                    // The harness's own setup — its model, its sign-in — in a
                                    // terminal. Its settings stay its own; this only opens them.
                                    if h.configure-label != "" : YButton {
                                        label: h.configure-label;
                                        size: 0;
                                        variant: 1;
                                        clicked => { root.configure-harness(h.id); }
                                    }
                                    if h.can-assign-provider && root.assigning-harness != h.id : YButton {
                                        label: "Use a provider";
                                        size: 0;
                                        variant: 1;
                                        clicked => { root.assigning-harness = h.id; }
                                    }
                                    if h.can-revert-provider : YButton {
                                        label: "Revert provider";
                                        size: 0;
                                        variant: 1;
                                        clicked => { root.revert-provider(h.id); }
                                    }
                                    // Attachment is still the only thing that lets a mind answer.
                                    // A "Use this" on a row that is not attached would be a
                                    // button that cannot work.
                                    if h.attached && !h.active : YButton {
                                        label: "Use this";
                                        size: 0;
                                        clicked => { root.use-harness(h.id); }
                                    }
                                }
                            }
                        }

                        // Only when the machine really has nothing to offer — no manifests
                        // staged, nothing attached but the built-in. That is a broken image or a
                        // checkout, not a fresh install, so it says so rather than pretending
                        // there was never anything to install.
                        if root.harness-rows.length <= 1 : Rectangle {
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: empty-card.preferred-height;

                            empty-card := VerticalLayout {
                                padding: Theme.sp-4;
                                spacing: Theme.sp-2;
                                Text {
                                    text: "This machine knows of no other minds";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "The image stages a manifest beside each harness it ships, and this one has none — so there is nothing here to install or start. Any harness that attaches on its own still appears above while it runs.";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    wrap: word-wrap;
                                }
                                Text {
                                    text: "/opt/yantrik/share/harnesses · docs/harness.md";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    font-family: Theme.font-mono;
                                }
                            }
                        }
                    }
                }

                // The card before a harness is given a provider: every file by path, never the key. After
                // the pages, so it covers whichever one is showing (it is opened from Harnesses).
                if root.handoff-card-open : YDialog {
                    open: true;
                    title: root.handoff-card-title;
                    body: root.handoff-card-body;
                    confirm-label: "Apply";
                    confirmed => { root.apply-provider(); }
                    cancelled => { root.cancel-provider(); }
                }

                if root.active-category == 7 : SkillStore {
                    width: 100%;
                    height: 100%;
                    skills: root.skills;
                    categories: root.skill-categories;
                    toggle-skill(id) => { root.toggle-skill(id); }
                    search-skills(query) => { root.search-skills(query); }
                    filter-category(cat) => { root.filter-skill-category(cat); }
                }
            }
        }
    }
    Rectangle {x:0px;y:root.height - 38px;width:root.width;height:38px;background:Theme.bg-surface;
        HorizontalLayout {padding-left:18px;padding-right:12px;spacing:12px;
            Text{text:root.save-status;color:root.save-error?Theme.amber:Theme.text-dim;font-size:12px;overflow:elide;vertical-alignment:center;horizontal-stretch:1;}
            if root.save-error && root.save-can-retry : YButton{label:"Retry save";variant: 1;size:0;clicked=>{root.retry-save();}}
            Text{text:"Ctrl+F  Search";color:Theme.text-dim;font-size:11px;vertical-alignment:center;}
        }
    }
    }
}
