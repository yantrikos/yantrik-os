// Getting promised things ready: the person's own yes, no and turn-on (#1184).
//
// The answer is the person's alone, so it has its own buttons and its own callback, `PrepState.answer`.
// It is never a row's expand toggle: a click that only folds a row cannot answer. Every button is
// `pointer-only` (no Tab and Enter, no accessibility default action), so only a deliberate click
// presses it. Rust (wire/commitment_prep.rs) is the only code that listens, and says the answer back in
// a toast.
//
// Two places use this: the question and the way back on the morning brief card
// (components/morning_brief.slint), and the switch in Settings > Companion (PrepSwitch below), which
// is always there when the brief has gone.

import { Theme } from "theme.slint";
import { YButton } from "components/y_button.slint";

// One card raised in the shell for an item: the question, or what was done with Turn off.
export struct PrepCardData {
    item: string,
    title: string,
    text: string,
    yes-label: string,
    yes-id: string,
    no-label: string,
    no-id: string,
    // The person's own ways in to what was found: "Open <file name>" for up to two files (empty
    // label: no such file), "and 3 more" as text, and "Open the draft" when a draft waits in Email.
    // The paths and the commitment id stay in Rust; a press names the card and the file's place.
    file1-label: string,
    file2-label: string,
    more-files: string,
    draft-label: string,
}

export global PrepState {
    // The cards to show, one per item. They go when the item is answered or has expired.
    in-out property <[PrepCardData]> cards;
    // Whether getting promised things ready is on; the shell keeps it current.
    in-out property <bool> on: true;
    // The question that waits, when one does: its sentence and the ids of its two buttons.
    in-out property <string> question;
    in-out property <string> yes-id;
    in-out property <string> no-id;
    // The ids of the turn-off and turn-on buttons, from the companion, so they cannot drift.
    in-out property <string> off-id;
    in-out property <string> on-id;
    callback answer(string);
    // The person's own opening of a found file (card item, 0 or 1) and of the draft Email holds
    // for a promise (card item). Handled in Rust (wire/commitment_prep.rs) as a person's own open,
    // never the Mind's. Pressed only by the buttons below, which are pointer-only.
    callback open-file(string, int);
    callback open-draft(string);
}

// The buttons of one answer. `no-id` empty means a single button (turn back on).
export component PrepChoices inherits HorizontalLayout {
    in property <string> yes-label: "Yes";
    in property <string> yes-id;
    in property <string> no-label: "No";
    in property <string> no-id;
    spacing: Theme.sp-2;
    alignment: start;

    YButton {
        label: root.yes-label;
        pointer-only: true;
        clicked => { PrepState.answer(root.yes-id); }
    }
    if root.no-id != "": YButton {
        label: root.no-label;
        variant: 1;
        pointer-only: true;
        clicked => { PrepState.answer(root.no-id); }
    }
}

// Settings > Companion: the switch, and the question when one waits.
export component PrepSwitch inherits VerticalLayout {
    spacing: Theme.sp-2;

    Rectangle { height: 1px; background: Theme.border-subtle; }
    HorizontalLayout {
        spacing: Theme.sp-3;
        Text {
            text: "Get promised things ready";
            color: Theme.text-secondary;
            font-size: Theme.fs-body;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
        Text {
            text: PrepState.on ? "On" : "Off";
            color: PrepState.on ? Theme.amber : Theme.text-dim;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        YButton {
            label: PrepState.on ? "Turn off" : "Turn on";
            variant: 1;
            pointer-only: true;
            clicked => { PrepState.answer(PrepState.on ? PrepState.off-id : PrepState.on-id); }
        }
    }
    Text {
        text: "Finds the files a promise names and drafts the email with them attached. Nothing is ever sent or opened for you.";
        color: Theme.text-dim;
        font-size: Theme.fs-caption;
        wrap: word-wrap;
    }
    if PrepState.question != "": VerticalLayout {
        spacing: Theme.sp-2;
        Text {
            text: PrepState.question;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        PrepChoices { yes-id: PrepState.yes-id; no-id: PrepState.no-id; }
    }
}

// A card on the desktop, where the person is: it stays until its item is answered or expires. Its
// buttons are `PrepChoices`, so they are pointer-only and press `PrepState.answer`, as the brief's do.
//
// The card is as tall as its content: the layout inside it has the card's padding itself and fills
// the card, so the card's height is the layout's own preferred height, padding and button row
// included. (It used to be placed at `y: sp-3` while being as tall as the card, which pushed the
// button row `sp-3` past the card's bottom edge.)
export component PrepAsk inherits Rectangle {
    in property <PrepCardData> card;
    // Where the last button row ends inside the card, for the preview check that no button hangs out.
    out property <length> buttons-bottom: choices.y + choices.height;

    width: 300px;
    height: body.preferred-height;
    border-radius: 16px;
    background: Theme.bg-deep.transparentize(10%);
    border-width: 1px;
    border-color: Theme.border-default;

    body := VerticalLayout {
        padding: Theme.sp-3;
        spacing: Theme.sp-2;
        alignment: start;
        Text {
            text: root.card.title;
            color: Theme.text-primary;
            font-size: Theme.fs-body;
            font-weight: 600;
            wrap: word-wrap;
        }
        Text {
            text: root.card.text;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        // The person's own openings, each on its own row above Got it / Stop, pointer-only.
        if root.card.file1-label != "": YButton {
            label: root.card.file1-label;
            variant: 1;
            pointer-only: true;
            clicked => { PrepState.open-file(root.card.item, 0); }
        }
        if root.card.file2-label != "": YButton {
            label: root.card.file2-label;
            variant: 1;
            pointer-only: true;
            clicked => { PrepState.open-file(root.card.item, 1); }
        }
        if root.card.more-files != "": Text {
            text: root.card.more-files;
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
        }
        if root.card.draft-label != "": YButton {
            label: root.card.draft-label;
            variant: 1;
            pointer-only: true;
            clicked => { PrepState.open-draft(root.card.item); }
        }
        choices := PrepChoices {
            yes-label: root.card.yes-label;
            yes-id: root.card.yes-id;
            no-label: root.card.no-label;
            no-id: root.card.no-id;
        }
    }
}

// The cards for prepared things, one under another. When they are taller than the room they are
// given (the stack stops above the dock) they scroll, so no button is ever drawn under the dock.
export component PrepCards inherits Flickable {
    min-height: 0px;
    preferred-height: stack.preferred-height;
    viewport-height: stack.preferred-height;
    viewport-width: self.width;

    stack := VerticalLayout {
        spacing: 8px;
        for prep in PrepState.cards : PrepAsk { card: prep; }
    }
}
