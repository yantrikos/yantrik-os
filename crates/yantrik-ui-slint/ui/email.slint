// Email client — Enterprise 3-pane layout with AI integration.
// Threaded conversations, search, message actions, compose with formatting,
// folder sidebar with icons & badges, rich email list, status bar.

import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { YButton, YIconButton } from "components/y_button.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";

// ── Data Structures ──

export struct EmailFolderData {
    name: string,
    icon: string,
    unread-count: int,
    total-count: int,
    // False when the mail server did not count this folder this time — a refused STATUS, a
    // reply that never came, a container that is not a mailbox. The two counts above are then
    // nothing, not zero, and `counts-reason` says why; the row shows a mark instead of a badge.
    counts-known: bool,
    counts-reason: string,
    is-selected: bool,
    folder-type: string,    // "inbox", "starred", "sent", "drafts", "archive", "trash", "spam", "custom"
}

export struct EmailListItem {
    id: int,
    from-name: string,
    from-addr: string,
    subject: string,
    preview: string,
    date-text: string,
    is-read: bool,
    is-flagged: bool,
    is-selected: bool,
    has-attachment: bool,
    thread-count: int,      // number of messages in thread (0 or 1 = no thread badge)
    thread-id: string,      // grouping key for threaded view
    avatar-initial: string, // first letter of sender name for avatar circle
    avatar-color: color,    // background color for avatar circle
}

export struct EmailThreadMessage {
    id: int,
    from-name: string,
    from-addr: string,
    date-text: string,
    body: string,
    is-collapsed: bool,
}

export struct EmailDetailData {
    id: int,
    from-name: string,
    from-addr: string,
    from-initial: string,       // first letter of sender name for avatar
    from-avatar-color: color,   // avatar background color
    to-addr: string,
    cc-addr: string,
    subject: string,
    date-text: string,
    body: string,
    ai-summary: string,
    is-flagged: bool,
    is-read: bool,
    has-attachment: bool,
    attachment-names: string,   // comma-separated list
    thread-count: int,
    has-html: bool,             // sender delivered an HTML original; gates "Open original"
}

export struct EmailAttachmentData {
    name: string,
    size-text: string,
    mime-type: string,
    is-downloaded: bool,
}

// ── Email Client Component ──

export component EmailClient inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar when
    // the screen fills an app window; the shell's copy leaves it off.
    in property <bool> window-bar: false;
    background: Theme.bg-deep;

    // Data
    in property <[EmailFolderData]> folders: [];
    in property <[EmailListItem]> email-list: [];
    in property <EmailDetailData> email-detail: { id: 0 };
    in property <bool> is-loading: false;
    in property <bool> is-composing: false;
    in property <bool> ai-is-working: false;
    in property <int> selected-folder-index: 0;
    in property <string> account-name: "";

    // What went wrong, in the words the app would give a caller.
    //
    // Every failure in this app used to be a discarded Option: a delete that failed changed
    // nothing on screen and said nothing, a search that failed looked like a mailbox with no
    // matches, and "Synced" was set whether or not anything synced. This strip is the person's
    // half of contract point 4; `describe.notice` carries the same sentence to a mind.
    in property <string> notice: "";

    // Account setup state
    in property <bool> has-account: false;
    // "up" or "unreachable" — whether the mail service answered at all.
    //
    // This screen had two states and needed three. A service that was never started answered
    // nothing, the app read nothing as no account, and the first thing anyone saw of Mail was a
    // form asking them to add the account they already had.
    in property <string> service-state: "up";
    in property <string> setup-status: "";
    // Whether `setup-status` is good news. The screen used to decide by comparing the status to
    // the literal "Connected!", so a server that answered anything else — including a success
    // said differently — was drawn in the failure colour.
    in property <bool> setup-ok: false;
    in property <bool> setup-testing: false;
    // Where the account is kept and what happens to the password, in the service's own words.
    in property <string> setup-note: "";

    // ── Sign in with Google ──
    //
    // Whether this build has a Google OAuth client at all, answered by the mail service on
    // `email.accounts`. The screen has to know before it draws anything: a "Sign in with Google"
    // that cannot work is the dead button this replaced, and drawing one and then apologising
    // after the click is the same failure a moment later.
    in property <bool> google-available: false;
    // The whole explanation, in the service's words, either way: where the client id came from,
    // or that there is not one and what to do instead. Never an empty string where a control
    // would otherwise have been -- a missing button with no reason given is indistinguishable
    // from a broken one.
    in property <string> google-note: "";
    // True between the click and the browser coming back.
    in property <bool> google-waiting: false;
    // The consent URL, set only when a browser could not be opened for it, so it can be read off
    // the screen and typed somewhere that has one. Empty the rest of the time.
    in property <string> google-url: "";
    // The setup form over an app that already has an account, for adding a second one.
    in-out property <bool> setup-open: false;

    // Thread messages for detail view
    in property <[EmailThreadMessage]> email-thread-messages: [];

    // Search state
    in property <int> email-search-count: 0;
    in property <bool> email-search-active: false;
    in-out property <string> email-search-query: "";

    // Sync status
    in property <string> email-sync-status: "Synced";
    in property <int> email-folder-total: 0;
    in property <int> email-folder-unread: 0;
    // False when the open folder's counts could not be read; the status bar then says so, with
    // the reason on hover, instead of "0 emails" — which is what an empty folder says.
    in property <bool> email-folder-counts-known: true;
    in property <string> email-folder-counts-reason: "";

    // Compose state
    in-out property <string> compose-to: "";
    in-out property <string> compose-cc: "";
    in-out property <string> compose-bcc: "";
    in-out property <string> compose-subject: "";
    in-out property <string> compose-body: "";

    // AI Draft prompt
    in-out property <bool> show-ai-prompt: false;
    in-out property <string> ai-draft-prompt: "";

    // Setup form state
    in-out property <string> setup-email: "";
    in-out property <string> setup-password: "";
    in-out property <string> setup-display-name: "";
    in-out property <string> setup-provider: "";
    in-out property <bool> setup-advanced-mode: false;
    in-out property <string> setup-imap-server: "";
    in-out property <string> setup-imap-port: "993";
    in-out property <string> setup-smtp-server: "";
    in-out property <string> setup-smtp-port: "587";

    // CC/BCC toggle
    in-out property <bool> show-cc-bcc: false;

    // Compose formatting state
    in-out property <bool> compose-bold-active: false;
    in-out property <bool> compose-italic-active: false;

    // V41: Enterprise email enhancements
    //
    // The attachment list is what the open message actually carries. The signature picker that
    // stood beside it is gone: it read a model nothing populated, so the list was always empty
    // and the block never drew, and there is no signature editor anywhere in this app for it to
    // have listed. `ComposeRequest.signature` is still on the wire for whoever builds one.
    in property <[EmailAttachmentData]> email-attachments: [];
    in property <int> email-triage-view: 0;  // 0=all, 1=unread, 2=flagged
    in property <string> email-draft-status: "";  // "Draft saved" / "Draft restored" / ""
    in property <string> email-ai-intent: "";  // "action-needed", "fyi", "meeting", "newsletter"

    // Callbacks — email operations
    callback folder-clicked(int);
    callback email-selected(int);
    callback compose-new();
    callback send-email(string, string, string, string, string);  // to, cc, bcc, subject, body
    callback reply-email();
    callback reply-all-email();
    callback forward-email();
    callback archive-email(int);
    callback delete-email(int);
    callback mark-read(int);
    callback mark-flagged(int);
    callback summarize-email();
    callback enhance-text(string);       // the tone to rewrite in — the handler reads the body from the composer itself
    callback ai-draft(string);           // generate email from prompt
    callback ai-reply-suggest();         // suggest reply
    callback search-emails(string);
    callback sync-emails();
    callback cancel-compose();
    callback add-account();              // open setup for an additional account
    callback cancel-setup();             // leave the setup form without saving
    callback toggle-thread-message(int); // collapse/expand a thread message

    // Open the open message's HTML original in a browser, for the mail whose layout the
    // reading pane's text cannot carry. The app strips remote images from the file it writes
    // first — a browser loading a sender's pixel is an open tracker — and its notice says so.
    callback open-original();

    // V41: Enterprise callbacks
    //
    // Download and preview are gone with the buttons that called them. Fetching an attachment
    // needs the bytes, and this service's `EmailAttachment` carries a filename, a MIME type and
    // a size — there is no method on the wire that returns a part's content, so both buttons
    // could only ever have logged a line. The chips list what the message has; opening one waits
    // on a method that fetches it.
    callback triage-filter(int);
    callback save-draft();
    callback ai-classify();

    // Callbacks — account setup
    //
    // `sign-in-with-google` replaces the `oauth-google` that was removed in September for
    // calling a stub. It is not the same flow: the companion's `connect_service` mints
    // Gmail-API tokens under `gmail.readonly` into the companion's own connector store, and IMAP
    // XOAUTH2 needs `https://mail.google.com/` in a token this mail service can read. This one
    // runs in `email-service` — PKCE, a loopback redirect, and an IMAP sign-in before anything
    // is written — so the button completes something the mailbox can actually use.
    //
    // Neither callback carries a credential. The token never comes near this window: the app
    // gets back an address and the servers behind it, exactly as it does from `save-account`.
    callback sign-in-with-google();
    callback cancel-google-sign-in();
    callback save-account(string, string, string, string, string, string, string, string);
    callback test-connection(string, string, string, string, string);

    // ── Account setup (shown until there is an account) ──
    //
    // With the header. This was the one screen in the OS that had no app shell at all: no
    // glyph, no name, no window chrome of its own -- a bare form on a dark field, and the FIRST
    // thing anyone sees of Mail, because it is what shows until an account exists. The app
    // introduced itself everywhere except at the door.
    //
    // It also said "No account yet" when the mail service had never been started, which is a
    // different thing and was the whole of what an audit found here. The subtitle reads the
    // service's state now, and a service that could not be reached gets the panel below instead
    // of a form: there is nothing to submit a form to.
    if (!root.has-account || root.setup-open) : VerticalLayout {
        spacing: 0px;

        AppHeader {
            window-bar: root.window-bar;
            app-id: "email";
            icon: Icons.mail;
            title: "Email";
            subtitle: root.service-state == "unreachable" ? "Mail service unreachable"
                : root.setup-open ? "Add another account"
                : "No account yet";
        }

        Rectangle {
        background: Theme.bg-deep;

        VerticalLayout {
            alignment: center;
            spacing: 0px;

            // ── The service is not there ──
            //
            // Not a form. Saving an account goes through the mail service, and offering eight
            // fields and a Sign In button to something that cannot be reached is how a person
            // comes to believe they have typed their password into a working machine.
            if root.service-state == "unreachable" : HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 440px;
                    height: down-content.preferred-height + 48px;
                    border-radius: 16px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.amber.with-alpha(0.4);

                    down-content := VerticalLayout {
                        padding: 32px;
                        spacing: 12px;

                        Icon {
                            commands: Icons.warning;
                            size: 32px;
                            tint: Theme.amber;
                            thickness: 1.6px;
                            x: (parent.width - self.width) / 2;
                        }
                        Text {
                            text: "The mail service is not running";
                            color: Theme.text-primary;
                            font-size: Theme.fs-title-2;
                            font-weight: Theme.fw-title-2;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.notice;
                            color: Theme.amber;
                            font-size: Theme.fs-caption;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }
                        Text {
                            text: "This is not the same as having no account. Until the service "
                                + "answers, this app cannot tell whether one is configured, and "
                                + "there is nothing here to sign in to.";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-caption;
                            horizontal-alignment: center;
                            wrap: word-wrap;
                        }

                        HorizontalLayout {
                            alignment: center;
                            YButton {
                                label: "Try again";
                                icon: Icons.refresh;
                                clicked => { root.sync-emails(); }
                            }
                        }
                    }
                }
            }

            if root.service-state != "unreachable" : HorizontalLayout {
                alignment: center;

                Rectangle {
                    width: 440px;
                    height: setup-content.preferred-height + 48px;
                    border-radius: 16px;
                    background: Theme.bg-surface;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    drop-shadow-blur: 32px;
                    drop-shadow-color: Theme.overlay-backdrop;

                    setup-content := VerticalLayout {
                        padding: 32px;
                        spacing: 16px;

                        // Header
                        VerticalLayout {
                            spacing: Theme.sp-2;

                            // Was the character "@" at display size. It happens to render, but
                            // a letter standing in for an icon is the look this kit exists to
                            // retire, and this one is the first thing a new user sees.
                            Icon {
                                commands: Icons.mail;
                                size: 40px;
                                tint: Theme.accent;
                                thickness: 1.6px;
                                x: (parent.width - self.width) / 2;
                            }
                            Text {
                                text: "Add Email Account";
                                color: Theme.text-primary;
                                font-size: Theme.fs-title-1;
                                font-weight: Theme.fw-title-1;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Choose your provider or use Advanced for custom domains.";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }

                        // ── Provider Picker ──
                        VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Email Provider";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                font-weight: 600;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                for prov in [
                                    { id: "gmail", label: "Gmail" },
                                    { id: "outlook", label: "Outlook" },
                                    { id: "yahoo", label: "Yahoo" },
                                    { id: "icloud", label: "iCloud" },
                                    { id: "advanced", label: "Advanced" },
                                ] : Rectangle {
                                    height: Theme.h-prominent;
                                    border-radius: Theme.r-md;
                                    background: root.setup-provider == prov.id ? AppIdentity.tint : Theme.bg-deep;
                                    border-width: root.setup-provider == prov.id ? 2px : 1px;
                                    border-color: root.setup-provider == prov.id ? AppIdentity.accent : Theme.border-subtle;

                                    TouchArea {
                                        clicked => {
                                            root.setup-provider = prov.id;
                                            root.setup-advanced-mode = prov.id == "advanced";
                                        }
                                        mouse-cursor: pointer;
                                    }

                                    Text {
                                        text: prov.label;
                                        color: root.setup-provider == prov.id ? AppIdentity.accent : Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                        font-weight: root.setup-provider == prov.id ? Theme.fw-headline : Theme.fw-body;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }

                                    animate background { duration: Theme.dur-fast; }
                                    animate border-color { duration: Theme.dur-fast; }
                                }
                            }

                            if root.setup-provider != "" && root.setup-provider != "advanced" : Text {
                                text: root.setup-provider == "gmail" ? "Sign in with Google below, or fill in the form with an App Password: Google Account > Security > 2-Step Verification > App passwords. Custom domains on Gmail supported."
                                    : root.setup-provider == "outlook" ? "Use your Outlook/Office 365 password. Custom domains on Outlook supported."
                                    : root.setup-provider == "yahoo" ? "Requires App Password: Yahoo Account > Security > App passwords."
                                    : "Requires App-specific password: appleid.apple.com > Security > App passwords.";
                                color: Theme.amber;
                                font-size: Theme.fs-micro;
                                wrap: word-wrap;
                            }
                        }

                        // ── Sign in with Google ──
                        //
                        // Only for Gmail, because that is the only account this flow can be
                        // for: the scope is Google's and the servers behind it are Gmail's.
                        //
                        // Three states and never a dead control. With a client id configured:
                        // a button, and then a waiting panel with a Cancel that is real. With
                        // no client id: the service's own sentence saying so and pointing at
                        // the App Password path below, which works on every build.
                        if root.setup-provider == "gmail" : VerticalLayout {
                            spacing: 8px;

                            if root.google-available && !root.google-waiting : Rectangle {
                                height: 44px; border-radius: 10px; background: Theme.bg-card;
                                border-width: 1px; border-color: Theme.border-subtle;
                                TouchArea {
                                    clicked => { root.sign-in-with-google(); }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: "Sign in with Google";
                                    color: Theme.text-primary; font-size: Theme.fs-body; font-weight: 600;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }

                            // What is happening, while it is happening. The person has left for
                            // a browser; this window says what it is waiting for and offers the
                            // way out, rather than sitting on an unchanged form.
                            if root.google-waiting : VerticalLayout {
                                spacing: 8px;

                                Text {
                                    text: "Waiting for Google\u{2026}";
                                    color: AppIdentity.accent; font-size: Theme.fs-body; font-weight: 600;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Choose the account in your browser and allow access to mail, then come back to this window.";
                                    color: Theme.text-secondary; font-size: Theme.fs-micro;
                                    horizontal-alignment: center; wrap: word-wrap;
                                }
                                // Only when a browser could not be opened. The address is long
                                // and unlovely and it is the only way through on a machine with
                                // no handler for it, so it is on the screen rather than in a log.
                                if root.google-url != "" : Rectangle {
                                    height: url-text.preferred-height + 16px;
                                    border-radius: 8px; background: Theme.bg-deep;
                                    border-width: 1px; border-color: Theme.border-subtle;
                                    url-text := TextInput {
                                        x: 8px; y: 8px; width: parent.width - 16px;
                                        text: root.google-url;
                                        read-only: true;
                                        color: Theme.text-dim; font-size: Theme.fs-micro;
                                        wrap: word-wrap;
                                    }
                                }
                                Rectangle {
                                    height: 38px; border-radius: 10px; background: Theme.bg-card;
                                    border-width: 1px; border-color: Theme.border-subtle;
                                    TouchArea {
                                        clicked => { root.cancel-google-sign-in(); }
                                        mouse-cursor: pointer;
                                    }
                                    Text {
                                        text: "Cancel";
                                        color: Theme.text-secondary; font-size: Theme.fs-body; font-weight: 500;
                                        horizontal-alignment: center; vertical-alignment: center;
                                    }
                                }
                            }

                            // Said either way: where the OAuth client came from, or that there
                            // is not one on this build and what works instead.
                            if root.google-note != "" : Text {
                                text: root.google-note;
                                color: root.google-available ? Theme.text-dim : Theme.amber;
                                font-size: Theme.fs-micro;
                                horizontal-alignment: center; wrap: word-wrap;
                            }

                            Rectangle { height: 1px; background: Theme.border-subtle; }
                        }

                        // Display Name
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Your Name"; color: Theme.text-secondary; font-size: Theme.fs-caption; font-weight: 600; }
                            Rectangle {
                                height: 42px; border-radius: 8px; background: Theme.bg-deep;
                                border-width: 1px; border-color: Theme.border-subtle; clip: true;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    TextInput { text <=> root.setup-display-name; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                                }
                            }
                        }

                        // Email Address
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Email Address"; color: Theme.text-secondary; font-size: Theme.fs-caption; font-weight: 600; }
                            Rectangle {
                                height: 42px; border-radius: 8px; background: Theme.bg-deep; clip: true;
                                border-width: 1px; border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    TextInput { text <=> root.setup-email; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                                }
                            }
                        }

                        // Password
                        VerticalLayout {
                            spacing: 4px;
                            Text { text: "Password"; color: Theme.text-secondary; font-size: Theme.fs-caption; font-weight: 600; }
                            Rectangle {
                                height: 42px; border-radius: 8px; background: Theme.bg-deep; clip: true;
                                border-width: 1px; border-color: Theme.border-subtle;
                                HorizontalLayout {
                                    padding-left: 14px; padding-right: 14px;
                                    TextInput { text <=> root.setup-password; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; input-type: password; }
                                }
                            }
                            Text {
                                text: root.setup-provider == "gmail"
                                    ? "App Password (16 chars, no spaces): Google Account > Security > 2-Step Verification > App passwords > Mail"
                                    : root.setup-provider == "yahoo"
                                    ? "App Password: Yahoo Account > Account Security > Generate app password"
                                    : root.setup-provider == "icloud"
                                    ? "App-specific password: appleid.apple.com > Sign-In and Security > App-Specific Passwords"
                                    : "Use your email account password or app password.";
                                color: Theme.amber; font-size: Theme.fs-micro; wrap: word-wrap;
                            }
                        }

                        // ── Advanced: Manual IMAP/SMTP fields ──
                        if root.setup-advanced-mode : VerticalLayout {
                            spacing: 12px;

                            Rectangle { height: 1px; background: Theme.border-subtle; }
                            Text { text: "Server Settings"; color: Theme.text-secondary; font-size: Theme.fs-caption; font-weight: 600; }

                            // IMAP row
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "IMAP Server"; color: Theme.text-dim; font-size: Theme.fs-micro; }
                                    Rectangle {
                                        height: 38px; border-radius: 8px; background: Theme.bg-deep; clip: true;
                                        border-width: 1px; border-color: Theme.border-subtle;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            TextInput { text <=> root.setup-imap-server; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px; max-width: 80px;
                                    Text { text: "Port"; color: Theme.text-dim; font-size: Theme.fs-micro; }
                                    Rectangle {
                                        height: 38px; border-radius: 8px; background: Theme.bg-deep; clip: true;
                                        border-width: 1px; border-color: Theme.border-subtle;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            TextInput { text <=> root.setup-imap-port; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }

                            // SMTP row
                            HorizontalLayout {
                                spacing: 8px;
                                VerticalLayout {
                                    spacing: 4px;
                                    Text { text: "SMTP Server"; color: Theme.text-dim; font-size: Theme.fs-micro; }
                                    Rectangle {
                                        height: 38px; border-radius: 8px; background: Theme.bg-deep; clip: true;
                                        border-width: 1px; border-color: Theme.border-subtle;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            TextInput { text <=> root.setup-smtp-server; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                                        }
                                    }
                                }
                                VerticalLayout {
                                    spacing: 4px; max-width: 80px;
                                    Text { text: "Port"; color: Theme.text-dim; font-size: Theme.fs-micro; }
                                    Rectangle {
                                        height: 38px; border-radius: 8px; background: Theme.bg-deep; clip: true;
                                        border-width: 1px; border-color: Theme.border-subtle;
                                        HorizontalLayout {
                                            padding-left: 12px; padding-right: 12px;
                                            TextInput { text <=> root.setup-smtp-port; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }

                        // Where the password goes, in the service's own words.
                        //
                        // A form that asks a person for a mail password and will not say what is
                        // done with it is asking them to trust something they cannot see. The
                        // text comes from the service, so the day there is a secret store behind
                        // this it stops saying there is not.
                        if root.setup-note != "" : Text {
                            text: root.setup-note;
                            color: Theme.text-dim; font-size: Theme.fs-micro;
                            horizontal-alignment: center; wrap: word-wrap;
                        }

                        // What happened, last time either button was pressed.
                        //
                        // This was compared against the literal string "Connected!" to choose its
                        // colour, so anything the server actually said was drawn as a failure.
                        // The app sets `setup-ok` alongside the words now.
                        if root.setup-status != "" : Text {
                            text: root.setup-status;
                            color: root.setup-ok ? AppIdentity.accent : Theme.amber;
                            font-size: Theme.fs-caption; horizontal-alignment: center; wrap: word-wrap;
                        }

                        // Action buttons
                        //
                        // Not while a Google sign-in is in flight. Both of these sign in to the
                        // same mail server with a password the form does not have during that
                        // flow, and a control that is drawn and refused in Rust is a dead
                        // control with extra steps. The waiting panel above carries the only
                        // thing there is to do, which is Cancel.
                        if !root.google-waiting : HorizontalLayout {
                            spacing: 12px;

                            // Only when there is a mailbox to go back to. On first run this form
                            // is the whole app and a Cancel would lead nowhere.
                            if root.setup-open : Rectangle {
                                height: 44px; border-radius: 10px; background: Theme.bg-card;
                                border-width: 1px; border-color: Theme.border-subtle;
                                TouchArea {
                                    clicked => { root.cancel-setup(); }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: "Cancel";
                                    color: Theme.text-secondary; font-size: Theme.fs-body; font-weight: 500;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 44px; border-radius: 10px; background: Theme.bg-card;
                                border-width: 1px; border-color: Theme.border-subtle;
                                TouchArea {
                                    clicked => {
                                        root.test-connection(root.setup-email, root.setup-password, root.setup-provider, root.setup-imap-server, root.setup-imap-port);
                                    }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: root.setup-testing ? "Testing..." : "Test Connection";
                                    color: Theme.text-secondary; font-size: Theme.fs-body; font-weight: 500;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 44px; border-radius: 10px;
                                background: root.setup-testing ? Theme.bg-card : Theme.accent;
                                TouchArea {
                                    clicked => {
                                        // Not while a connection is being tried: both buttons go
                                        // to the same server with the same credentials, and a
                                        // second attempt on top of the first only makes the
                                        // provider's rate limiter the thing being tested.
                                        if (!root.setup-testing) {
                                            root.save-account(root.setup-email, root.setup-password, root.setup-display-name, root.setup-provider, root.setup-imap-server, root.setup-imap-port, root.setup-smtp-server, root.setup-smtp-port);
                                        }
                                    }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: root.setup-testing ? "Working..." : "Sign In";
                                    color: root.setup-testing ? Theme.text-dim : Theme.bg-deep;
                                    font-size: Theme.fs-body; font-weight: 600;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
        }

    // ── Main Email View (shown when account is configured) ──
    if (root.has-account && !root.setup-open) : VerticalLayout {
        // -- Header --
        AppHeader {
            window-bar: root.window-bar;
            app-id: "email";
            icon: Icons.mail;
            title: "Email";
            subtitle: root.account-name != ""
                        ? root.account-name + "  -  " + root.email-sync-status
                        : root.email-sync-status;
            show-search: true;
            search-placeholder: "Search mail";
            actions: [
                { id: "refresh", icon: Icons.refresh },
                { id: "ai",      icon: Icons.spark, label: root.ai-is-working ? "Working" : "Summarize",
                  emphasis: 1, loading: root.ai-is-working },
                { id: "compose", icon: Icons.pencil, label: "Compose", emphasis: 2, active: root.is-composing },
            ];
            search-text <=> root.email-search-query;
            search-accepted(t) => { root.search-emails(t); }
            action(id) => {
                if (id == "refresh") { root.sync-emails(); }
                else if (id == "ai") { root.summarize-email(); }
                else if (id == "compose") { root.compose-new(); }
            }
        }
        spacing: 0px;

        // ── The notice strip ──
        //
        // Failure said twice: this, and `describe.notice`, which carries the same sentence to
        // whatever is driving the app. A delete that the mail server refused used to leave the
        // list exactly as it was and say nothing at all, which reads as a delete that worked.
        if root.notice != "" : Rectangle {
            height: notice-text.preferred-height + Theme.sp-4;
            background: Theme.tint-amber;

            Rectangle {
                x: 0; width: 3px; height: 100%;
                background: Theme.amber;
            }

            notice-text := Text {
                x: Theme.sp-4;
                width: parent.width - Theme.sp-4 * 2;
                y: Theme.sp-2;
                text: root.notice;
                color: Theme.amber;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }
        }

        HorizontalLayout {
            spacing: 0px;

            // ── Left: Folder sidebar ──
            Rectangle {
                width: 220px;
                background: Theme.bg-surface;

                // Right edge separator
                Rectangle {
                    x: parent.width - 1px;
                    width: 1px;
                    height: 100%;
                    background: Theme.separator;
                }

                VerticalLayout {
                    padding: Theme.sp-3;
                    spacing: Theme.sp-1;

                    // Account header
                    Rectangle {
                        height: Theme.touch-target;
                        border-radius: Theme.r-md;

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: Theme.sp-2;
                            alignment: start;

                            // Account avatar
                            Rectangle {
                                width: 28px;
                                height: 28px;
                                border-radius: 14px;
                                background: Theme.tint-accent;

                                Icon {
                                    commands: Icons.mail;
                                    size: 15px;
                                    tint: Theme.accent;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                alignment: center;

                                Text {
                                    text: root.account-name;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-caption;
                                    font-weight: Theme.fw-headline;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                    Rectangle { height: Theme.sp-2; }

                    // Compose button
                    YButton {
                        label: "Compose";
                        icon-path: Icons.plus;
                        variant: 0;
                        size: 2;
                        clicked => { root.compose-new(); }
                    }

                    Rectangle { height: Theme.sp-3; }

                    // Folder list with icons, active indicator, and badges
                    for folder[idx] in root.folders : Rectangle {
                        property <bool> hovered: folder-ta.has-hover;

                        height: Theme.h-regular;
                        border-radius: Theme.r-md;
                        background: folder.is-selected ? AppIdentity.tint
                                  : hovered ? Theme.hover-fill
                                  : transparent;

                        animate background { duration: Theme.dur-fast; }

                        // Active indicator bar
                        if folder.is-selected : Rectangle {
                            x: 0;
                            width: 3px;
                            height: 18px;
                            y: (parent.height - 18px) / 2;
                            border-radius: 2px;
                            background: Theme.accent;
                        }

                        folder-ta := TouchArea {
                            clicked => { root.folder-clicked(idx); }
                            mouse-cursor: pointer;
                        }

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: Theme.sp-2;

                            // Folder icon
                            Icon {
                                commands: folder.folder-type == "inbox" ? Icons.inbox
                                    : folder.folder-type == "starred" ? Icons.star
                                    : folder.folder-type == "sent" ? Icons.send
                                    : folder.folder-type == "drafts" ? Icons.pencil
                                    : folder.folder-type == "archive" ? Icons.archive
                                    : folder.folder-type == "trash" ? Icons.trash
                                    : folder.folder-type == "spam" ? Icons.warning
                                    : Icons.folder;
                                size: 15px;
                                tint: folder.is-selected ? AppIdentity.accent : Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: folder.name;
                                color: folder.is-selected ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.fs-body;
                                font-weight: folder.is-selected ? Theme.fw-body-strong : Theme.fw-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }

                            // A folder the server did not count: a mark, not an empty badge,
                            // with the reason on hover.
                            if !folder.counts-known : Rectangle {
                                width: 18px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;

                                Text {
                                    text: "?";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                mark-ta := TouchArea {
                                    // Let the click through to the row.
                                    clicked => { root.folder-clicked(idx); }
                                }

                                if mark-ta.has-hover && folder.counts-reason != "" : Rectangle {
                                    property <length> tw: min(reason-tt.preferred-width + 14px, 320px);
                                    x: parent.width - self.tw;
                                    y: -28px;
                                    width: self.tw;
                                    height: 22px;
                                    border-radius: 5px;
                                    background: Theme.bg-deep.transparentize(12%);
                                    border-width: 1px;
                                    border-color: Theme.hover-fill-strong;
                                    drop-shadow-blur: 6px;
                                    drop-shadow-color: Theme.overlay-backdrop;

                                    reason-tt := Text {
                                        text: "Counts unavailable: " + folder.counts-reason;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-micro;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Unread badge
                            if folder.counts-known && folder.unread-count > 0 : Rectangle {
                                width: max(18px, badge-ct.preferred-width + 10px);
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                border-radius: 9px;
                                background: Theme.accent;

                                badge-ct := Text {
                                    text: folder.unread-count >= 1000 ? "999+" : folder.unread-count;
                                    color: Theme.text-on-accent;
                                    font-size: Theme.fs-micro;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { vertical-stretch: 1; } // spacer

                    // Add another account
                    YButton {
                        label: "Add Account";
                        icon-path: Icons.plus;
                        variant: 2;
                        size: 0;
                        clicked => { root.add-account(); }
                    }

                    // Sync button
                    YButton {
                        label: root.is-loading ? "Syncing..." : "Sync";
                        icon-path: Icons.refresh;
                        variant: 1;
                        size: 0;
                        loading: root.is-loading;
                        clicked => { root.sync-emails(); }
                    }
                }
            }

            // ── Middle: Email list ──
            Rectangle {
                width: 340px;
                background: Theme.bg-deep;

                VerticalLayout {
                    spacing: 0px;

                    // Search bar
                    Rectangle {
                        height: Theme.sp-9;
                        background: Theme.bg-surface;

                        HorizontalLayout {
                            padding: Theme.sp-2;
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;

                            Rectangle {
                                border-radius: Theme.r-md;
                                background: Theme.bg-input;
                                border-width: 1px;
                                border-color: root.email-search-active ? Theme.accent-dim : Theme.border-subtle;
                                clip: true;
                                animate border-color { duration: Theme.dur-fast; }

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 6px;

                                    // Search icon
                                    Icon {
                                        commands: Icons.search;
                                        size: 14px;
                                        thickness: 1.7px;
                                        tint: root.email-search-active ? AppIdentity.accent : Theme.text-dim;
                                        y: (parent.height - self.height) / 2;
                                    }

                                    search-input := TextInput {
                                        text <=> root.email-search-query;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        vertical-alignment: center;

                                        accepted => {
                                            root.search-emails(root.email-search-query);
                                        }
                                        edited => {
                                            if self.text == "" {
                                                root.search-emails("");
                                            }
                                        }
                                    }

                                    // Match count badge
                                    if root.email-search-active && root.email-search-query != "" : Rectangle {
                                        width: match-count-text.preferred-width + 12px;
                                        height: 20px;
                                        border-radius: 10px;
                                        background: Theme.accent.with-alpha(0.15);

                                        match-count-text := Text {
                                            text: root.email-search-count;
                                            color: Theme.accent;
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Clear search
                                    if root.email-search-query != "" : Rectangle {
                                        width: 20px;
                                        height: 20px;
                                        border-radius: 10px;

                                        TouchArea {
                                            clicked => {
                                                root.email-search-query = "";
                                                root.search-emails("");
                                            }
                                            mouse-cursor: pointer;
                                        }

                                        Icon {
                                            commands: Icons.close;
                                            size: 10px;
                                            tint: Theme.text-dim;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }

                                if root.email-search-query == "" : Text {
                                    x: 10px + 14px + 6px;
                                    height: 100%;
                                    text: "Search mail";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // ── Triage filter tabs ──
                    Rectangle {
                        height: Theme.h-prominent;
                        background: Theme.bg-surface;

                        HorizontalLayout {
                            padding-left: Theme.sp-2;
                            padding-right: Theme.sp-2;
                            padding-top: Theme.sp-1;
                            padding-bottom: Theme.sp-1;
                            spacing: Theme.sp-1;

                            // Three, not four. The fourth was Priority, and nothing in this app
                            // or on its wire says a message is important: `email-priority-count`
                            // was an `in` property nothing ever set, so the badge never drew and
                            // the tab filtered on a quality no message had. These three are read
                            // off the rows already in hand.
                            for triage-item[tidx] in [
                                { label: "All", idx: 0 },
                                { label: "Unread", idx: 1 },
                                { label: "Flagged", idx: 2 },
                            ] : Rectangle {
                                property <bool> is-active: root.email-triage-view == triage-item.idx;
                                property <bool> hovered: triage-ta.has-hover;

                                height: Theme.h-compact;
                                border-radius: self.height / 2;
                                background: is-active ? AppIdentity.tint
                                          : hovered ? Theme.hover-fill
                                          : transparent;
                                border-width: is-active ? 1px : 0px;
                                border-color: Theme.accent-dim;

                                animate background { duration: Theme.dur-fast; }

                                triage-ta := TouchArea {
                                    clicked => { root.triage-filter(triage-item.idx); }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    alignment: center;
                                    padding-left: Theme.sp-3;
                                    padding-right: Theme.sp-3;
                                    spacing: Theme.sp-1;

                                    Text {
                                        text: triage-item.label;
                                        color: is-active ? AppIdentity.accent : Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        font-weight: is-active ? Theme.fw-headline : Theme.fw-body;
                                        vertical-alignment: center;
                                    }

                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // Email list
                    ScrollView {
                        VerticalLayout {
                            spacing: 0px;

                            for email[idx] in root.email-list : Rectangle {
                                property <bool> hovered: email-ta.has-hover;

                                height: 76px;
                                background: email.is-selected ? Theme.bg-selected
                                    : hovered ? Theme.hover-fill
                                    : (email.is-read ? transparent : Theme.bg-surface.with-alpha(0.4));

                                animate background { duration: Theme.dur-fast; }

                                // Bottom border
                                Rectangle {
                                    y: parent.height - 1px;
                                    height: 1px;
                                    background: Theme.separator;
                                }

                                // Selected indicator bar
                                if email.is-selected : Rectangle {
                                    x: 0px;
                                    width: 3px;
                                    height: parent.height;
                                    background: Theme.accent;
                                }

                                email-ta := TouchArea {
                                    clicked => { root.email-selected(email.id); }
                                    mouse-cursor: pointer;
                                }

                                HorizontalLayout {
                                    padding-left: Theme.sp-3;
                                    padding-right: Theme.sp-3;
                                    padding-top: Theme.sp-3;
                                    padding-bottom: Theme.sp-3;
                                    spacing: Theme.sp-3;

                                    // Avatar circle with initial
                                    Rectangle {
                                        width: 36px;
                                        height: 36px;
                                        border-radius: 18px;
                                        background: email.avatar-color != #000000 ? email.avatar-color.with-alpha(0.2) : Theme.tint-accent;

                                        Text {
                                            text: email.avatar-initial != "" ? email.avatar-initial :
                                                (email.from-name != "" ? email.from-name : "?");
                                            color: email.avatar-color != #000000 ? email.avatar-color : Theme.accent;
                                            font-size: Theme.fs-body;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Email content
                                    VerticalLayout {
                                        spacing: 2px;

                                        // Row 1: Sender name + date
                                        HorizontalLayout {
                                            alignment: space-between;

                                            HorizontalLayout {
                                                spacing: Theme.sp-2;

                                                // Unread dot
                                                if !email.is-read : Rectangle {
                                                    width: 8px;
                                                    height: 8px;
                                                    border-radius: 4px;
                                                    background: Theme.accent;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                Text {
                                                    text: email.from-name != "" ? email.from-name : email.from-addr;
                                                    color: email.is-read ? Theme.text-secondary : Theme.text-primary;
                                                    font-size: Theme.fs-body;
                                                    font-weight: email.is-read ? Theme.fw-body : Theme.fw-headline;
                                                    overflow: elide;
                                                }
                                            }

                                            HorizontalLayout {
                                                spacing: Theme.sp-1;
                                                alignment: end;

                                                // Attachment icon
                                                if email.has-attachment : Icon {
                                                    commands: Icons.paperclip;
                                                    size: 12px;
                                                    tint: Theme.text-dim;
                                                    y: (parent.height - self.height) / 2;
                                                }

                                                // Thread count badge
                                                if email.thread-count > 1 : Rectangle {
                                                    width: 22px;
                                                    height: 16px;
                                                    border-radius: 8px;
                                                    background: Theme.bg-elevated;
                                                    border-width: 1px;
                                                    border-color: Theme.border-subtle;

                                                    Text {
                                                        text: email.thread-count;
                                                        color: Theme.text-secondary;
                                                        font-size: Theme.fs-micro;
                                                        font-weight: Theme.fw-headline;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                }

                                                Text {
                                                    text: email.date-text;
                                                    color: Theme.text-dim;
                                                    font-size: Theme.fs-caption;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        // Row 2: Subject (bold when unread)
                                        Text {
                                            text: email.subject;
                                            color: email.is-read ? Theme.text-secondary : Theme.text-primary;
                                            font-size: Theme.fs-caption;
                                            font-weight: email.is-read ? Theme.fw-body : Theme.fw-headline;
                                            overflow: elide;
                                        }

                                        // Row 3: Preview snippet + star
                                        HorizontalLayout {
                                            alignment: space-between;

                                            Text {
                                                text: email.preview;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }

                                            // Star toggle
                                            Rectangle {
                                                width: 20px;
                                                height: 16px;

                                                TouchArea {
                                                    clicked => { root.mark-flagged(email.id); }
                                                    mouse-cursor: pointer;
                                                }

                                                Icon {
                                                    commands: Icons.star;
                                                    size: 13px;
                                                    tint: email.is-flagged ? Theme.amber : Theme.text-dim;
                                                    fill: email.is-flagged ? Theme.amber : transparent;
                                                    x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // Empty state using YEmptyState
                            if root.email-list.length == 0 : YEmptyState {
                                icon-path: root.is-loading ? Icons.refresh : Icons.inbox;
                                title: root.is-loading ? "Loading emails..."
                                     : root.email-search-active ? "No matching emails"
                                     : "No emails in this folder";
                                description: root.email-search-active ? "Try adjusting your search terms" : "New messages will appear here";
                            }
                        }
                    }
                }
            }

            // List separator line
            Rectangle {
                width: 1px;
                background: Theme.border-subtle;
            }

            // ── Right: Detail / Compose pane ──
            Rectangle {
                background: Theme.bg-surface;

                // ══ COMPOSE VIEW ══
                if root.is-composing : VerticalLayout {
                    padding: Theme.sp-5;
                    spacing: Theme.sp-3;

                    // Header bar
                    HorizontalLayout {
                        alignment: space-between;

                        HorizontalLayout {
                            spacing: Theme.sp-2;
                            alignment: start;

                            Text {
                                text: "New Message";
                                color: Theme.text-primary;
                                font-size: Theme.fs-title-2;
                                font-weight: Theme.fw-title-2;
                                vertical-alignment: center;
                            }

                            // Draft autosave indicator
                            if root.email-draft-status != "" : Text {
                                text: root.email-draft-status;
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.sp-2;

                            YButton {
                                label: "Save Draft";
                                variant: 1;
                                size: 0;
                                clicked => { root.save-draft(); }
                            }

                            YButton {
                                label: "Cancel";
                                variant: 2;
                                size: 0;
                                clicked => { root.cancel-compose(); }
                            }

                            YButton {
                                label: "Send";
                                icon-path: Icons.send;
                                variant: 0;
                                clicked => {
                                    root.send-email(root.compose-to, root.compose-cc, root.compose-bcc, root.compose-subject, root.compose-body);
                                }
                            }
                        }
                    }

                    Rectangle { height: 1px; background: Theme.border-subtle; }

                    // To field
                    Rectangle {
                        height: 38px; border-radius: 8px; background: Theme.bg-card; clip: true;
                        border-width: 1px; border-color: Theme.border-subtle;
                        HorizontalLayout {
                            padding-left: 12px; spacing: 8px;
                            Text { text: "To"; color: Theme.text-dim; font-size: Theme.fs-body; font-weight: 500; vertical-alignment: center; width: 55px; }
                            Rectangle { width: 1px; height: 20px; background: Theme.border-subtle; }
                            TextInput { text <=> root.compose-to; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                            // CC/BCC toggle
                            Rectangle {
                                width: 60px;
                                TouchArea { clicked => { root.show-cc-bcc = !root.show-cc-bcc; } mouse-cursor: pointer; }
                                Text {
                                    text: "Cc/Bcc";
                                    color: root.show-cc-bcc ? AppIdentity.accent : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-weight: root.show-cc-bcc ? 600 : 400;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // CC field (collapsible)
                    if root.show-cc-bcc : Rectangle {
                        height: 38px; border-radius: 8px; background: Theme.bg-card; clip: true;
                        border-width: 1px; border-color: Theme.border-subtle;
                        HorizontalLayout {
                            padding-left: 12px; spacing: 8px;
                            Text { text: "Cc"; color: Theme.text-dim; font-size: Theme.fs-body; font-weight: 500; vertical-alignment: center; width: 55px; }
                            Rectangle { width: 1px; height: 20px; background: Theme.border-subtle; }
                            TextInput { text <=> root.compose-cc; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                        }
                    }

                    // BCC field (collapsible)
                    if root.show-cc-bcc : Rectangle {
                        height: 38px; border-radius: 8px; background: Theme.bg-card; clip: true;
                        border-width: 1px; border-color: Theme.border-subtle;
                        HorizontalLayout {
                            padding-left: 12px; spacing: 8px;
                            Text { text: "Bcc"; color: Theme.text-dim; font-size: Theme.fs-body; font-weight: 500; vertical-alignment: center; width: 55px; }
                            Rectangle { width: 1px; height: 20px; background: Theme.border-subtle; }
                            TextInput { text <=> root.compose-bcc; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                        }
                    }

                    // Subject field
                    Rectangle {
                        height: 38px; border-radius: 8px; background: Theme.bg-card; clip: true;
                        border-width: 1px; border-color: Theme.border-subtle;
                        HorizontalLayout {
                            padding-left: 12px; spacing: 8px;
                            Text { text: "Subject"; color: Theme.text-dim; font-size: Theme.fs-body; font-weight: 500; vertical-alignment: center; width: 55px; }
                            Rectangle { width: 1px; height: 20px; background: Theme.border-subtle; }
                            TextInput { text <=> root.compose-subject; color: Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; }
                        }
                    }

                    // ── Formatting Toolbar ──
                    Rectangle {
                        height: 36px;
                        border-radius: 8px;
                        background: Theme.bg-deep;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 8px;
                            padding-right: 8px;
                            spacing: 2px;
                            alignment: start;

                            // Bold
                            Rectangle {
                                width: 32px; height: 28px; border-radius: 6px;
                                background: root.compose-bold-active ? AppIdentity.accent.with-alpha(0.15) : transparent;
                                TouchArea {
                                    clicked => { root.compose-bold-active = !root.compose-bold-active; }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "B"; color: root.compose-bold-active ? AppIdentity.accent : Theme.text-secondary; font-size: Theme.fs-body; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            // Italic
                            Rectangle {
                                width: 32px; height: 28px; border-radius: 6px;
                                background: root.compose-italic-active ? AppIdentity.accent.with-alpha(0.15) : transparent;
                                TouchArea {
                                    clicked => { root.compose-italic-active = !root.compose-italic-active; }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "I"; color: root.compose-italic-active ? AppIdentity.accent : Theme.text-secondary; font-size: Theme.fs-body; font-weight: 400; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            // Link
                            Rectangle {
                                width: 32px; height: 28px; border-radius: 6px;
                                TouchArea { mouse-cursor: pointer; }
                                Icon { commands: Icons.link; size: 14px; tint: Theme.text-secondary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            }

                            Rectangle { width: 1px; height: 20px; background: Theme.border-subtle; }

                            // Attachment indicator
                            Rectangle {
                                width: 32px; height: 28px; border-radius: 6px;
                                TouchArea { mouse-cursor: pointer; }
                                Icon { commands: Icons.paperclip; size: 14px; tint: Theme.text-secondary; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            }

                            Rectangle {} // spacer

                            // AI section separator
                            Rectangle { width: 1px; height: 20px; background: Theme.accent.with-alpha(0.3); }

                            // AI toolbar label
                            Text {
                                text: "Yantrik";
                                color: Theme.accent;
                                font-size: Theme.fs-micro;
                                font-weight: 700;
                                vertical-alignment: center;
                            }

                            // AI Draft button
                            Rectangle {
                                width: 65px; height: 28px; border-radius: 6px;
                                background: Theme.bg-card;
                                TouchArea {
                                    clicked => { root.show-ai-prompt = !root.show-ai-prompt; }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "AI Draft"; color: Theme.accent; font-size: Theme.fs-micro; font-weight: 500; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            // Enhance button
                            Rectangle {
                                width: 65px; height: 28px; border-radius: 6px;
                                background: Theme.bg-card;
                                TouchArea {
                                    clicked => { root.enhance-text("clearer and more polished"); }
                                    mouse-cursor: pointer;
                                }
                                Text {
                                    text: root.ai-is-working ? "..." : "Enhance";
                                    color: Theme.text-secondary; font-size: Theme.fs-micro; font-weight: 500;
                                    horizontal-alignment: center; vertical-alignment: center;
                                }
                            }

                            // Tone: Professional
                            Rectangle {
                                width: 75px; height: 28px; border-radius: 6px;
                                background: Theme.bg-card;
                                TouchArea {
                                    clicked => { root.enhance-text("professional and formal"); }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "Professional"; color: Theme.text-dim; font-size: Theme.fs-micro; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            // Tone: Casual
                            Rectangle {
                                width: 50px; height: 28px; border-radius: 6px;
                                background: Theme.bg-card;
                                TouchArea {
                                    clicked => { root.enhance-text("casual and friendly"); }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "Casual"; color: Theme.text-dim; font-size: Theme.fs-micro; horizontal-alignment: center; vertical-alignment: center; }
                            }

                            // Tone: Concise
                            Rectangle {
                                width: 55px; height: 28px; border-radius: 6px;
                                background: Theme.bg-card;
                                TouchArea {
                                    clicked => { root.enhance-text("shorter and more concise"); }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "Concise"; color: Theme.text-dim; font-size: Theme.fs-micro; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    // AI Draft prompt input (shown when AI Draft clicked)
                    if root.show-ai-prompt : Rectangle {
                        height: 70px;
                        border-radius: 8px;
                        background: Theme.bg-deep;
                        border-width: 1px;
                        border-color: Theme.accent.with-alpha(0.3);
                        clip: true;

                        HorizontalLayout {
                            padding: 10px;
                            spacing: 8px;

                            VerticalLayout {
                                spacing: 4px;

                                Text {
                                    text: "Describe what you want to write...";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }
                                TextInput {
                                    text <=> root.ai-draft-prompt;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    wrap: word-wrap;
                                }
                            }

                            Rectangle {
                                width: 60px;
                                border-radius: 6px;
                                background: Theme.accent;

                                TouchArea {
                                    clicked => {
                                        root.ai-draft(root.ai-draft-prompt);
                                        root.show-ai-prompt = false;
                                    }
                                    mouse-cursor: pointer;
                                }
                                Text { text: "Draft"; color: Theme.bg-deep; font-size: Theme.fs-caption; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                            }
                        }
                    }

                    // Body editor
                    Rectangle {
                        border-radius: 8px;
                        background: Theme.bg-card; clip: true;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        ScrollView {
                            VerticalLayout {
                                padding: 14px;

                                TextInput {
                                    text <=> root.compose-body;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }

                    // The signature picker stood here. It read `email-signatures`, an `in`
                    // property nothing in the repository ever set, so the list was always empty
                    // and the block never drew; `set-signature` logged a line. There is no
                    // signature editor in this app for it to have listed, and inventing one is
                    // not what this pass is for. `ComposeRequest.signature` is still on the
                    // wire for whoever builds it.
                }

                // ══ EMAIL DETAIL VIEW ══
                if !root.is-composing && root.email-detail.id > 0 : VerticalLayout {
                    spacing: 0px;

                    // ── Actions Toolbar ──
                    // Labelled buttons for the three things people do most, icon buttons for the
                    // rest, and the two AI actions on the right. Fits a 600px pane.
                    Rectangle {
                        height: 44px;
                        background: Theme.bg-surface;

                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.separator; }

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            padding-top: 8px;
                            padding-bottom: 8px;
                            spacing: Theme.sp-1;
                            alignment: start;

                            YButton { label: "Reply"; icon-path: Icons.reply; variant: 1; size: 0; clicked => { root.reply-email(); } }
                            YButton { label: "Reply all"; icon-path: Icons.reply; variant: 2; size: 0; clicked => { root.reply-all-email(); } }
                            YButton { label: "Forward"; icon-path: Icons.forward; variant: 2; size: 0; clicked => { root.forward-email(); } }

                            Rectangle { width: 1px; height: 18px; y: (parent.height - 18px) / 2; background: Theme.separator; }

                            YIconButton { icon-path: Icons.archive; variant: 2; clicked => { root.archive-email(root.email-detail.id); } }
                            YIconButton { icon-path: Icons.trash; variant: 2; clicked => { root.delete-email(root.email-detail.id); } }
                            YIconButton { icon-path: root.email-detail.is-read ? Icons.mail : Icons.mail-open; variant: 2; clicked => { root.mark-read(root.email-detail.id); } }
                            YIconButton { icon-path: Icons.star; variant: root.email-detail.is-flagged ? 1 : 2; clicked => { root.mark-flagged(root.email-detail.id); } }

                            // Only for a message that has an HTML original to open; a plain-text
                            // mail's original is the text already on screen.
                            if root.email-detail.has-html : YButton {
                                label: "Open original";
                                icon-path: Icons.browser; variant: 2; size: 0;
                                clicked => { root.open-original(); }
                            }

                            Rectangle { horizontal-stretch: 1; }

                            YButton {
                                label: root.ai-is-working ? "Thinking" : "Summarize";
                                icon-path: Icons.spark; variant: 1; size: 0;
                                loading: root.ai-is-working;
                                clicked => { root.summarize-email(); }
                            }
                            YButton { label: "Draft reply"; icon-path: Icons.companion; variant: 0; size: 0; clicked => { root.ai-reply-suggest(); } }
                        }
                    }

                    // ── Email detail content ──
                    ScrollView {
                        VerticalLayout {
                            padding: 20px;
                            spacing: 12px;
                            alignment: start;

                            // Subject line
                            Text {
                                text: root.email-detail.subject;
                                color: Theme.text-primary;
                                font-size: Theme.fs-title-1;
                                font-weight: 700;
                                wrap: word-wrap;
                            }

                            // AI Intent badge
                            if root.email-ai-intent != "" : Rectangle {
                                height: 24px;
                                width: intent-label.preferred-width + 20px;
                                border-radius: 12px;
                                background: root.email-ai-intent == "action-needed" ? Theme.amber.with-alpha(0.15)
                                    : root.email-ai-intent == "meeting" ? Theme.color-success-dim
                                    : root.email-ai-intent == "newsletter" ? Theme.color-purple-dim
                                    : Theme.accent.with-alpha(0.15);
                                border-width: 1px;
                                border-color: root.email-ai-intent == "action-needed" ? Theme.amber.with-alpha(0.4)
                                    : root.email-ai-intent == "meeting" ? Theme.color-success.with-alpha(0.37)
                                    : root.email-ai-intent == "newsletter" ? Theme.color-purple.with-alpha(0.37)
                                    : Theme.accent.with-alpha(0.4);

                                intent-label := Text {
                                    text: root.email-ai-intent == "action-needed" ? "ACTION NEEDED"
                                        : root.email-ai-intent == "fyi" ? "FYI"
                                        : root.email-ai-intent == "meeting" ? "MEETING"
                                        : root.email-ai-intent == "newsletter" ? "NEWSLETTER"
                                        : root.email-ai-intent;
                                    color: root.email-ai-intent == "action-needed" ? Theme.amber
                                        : root.email-ai-intent == "meeting" ? Theme.color-success
                                        : root.email-ai-intent == "newsletter" ? Theme.color-purple
                                        : Theme.accent;
                                    font-size: Theme.fs-micro;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Sender info card
                            Rectangle {
                                height: 56px;
                                border-radius: 8px;

                                HorizontalLayout {
                                    spacing: 12px;

                                    // Sender avatar
                                    Rectangle {
                                        width: 40px;
                                        height: 40px;
                                        border-radius: 20px;
                                        background: root.email-detail.from-avatar-color != #000000
                                            ? root.email-detail.from-avatar-color.with-alpha(0.2)
                                            : Theme.tint-accent;

                                        Text {
                                            text: root.email-detail.from-initial != "" ? root.email-detail.from-initial : "?";
                                            color: root.email-detail.from-avatar-color != #000000
                                                ? root.email-detail.from-avatar-color
                                                : Theme.accent;
                                            font-size: Theme.fs-title-2;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        alignment: center;
                                        spacing: 2px;

                                        HorizontalLayout {
                                            spacing: 8px;

                                            Text {
                                                text: root.email-detail.from-name != "" ? root.email-detail.from-name : root.email-detail.from-addr;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                font-weight: 600;
                                            }
                                            Text {
                                                text: "<" + root.email-detail.from-addr + ">";
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                                vertical-alignment: center;
                                            }
                                        }

                                        HorizontalLayout {
                                            spacing: 12px;

                                            if root.email-detail.to-addr != "" : Text {
                                                text: "To: " + root.email-detail.to-addr;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-micro;
                                            }
                                            if root.email-detail.cc-addr != "" : Text {
                                                text: "Cc: " + root.email-detail.cc-addr;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-micro;
                                            }
                                        }
                                    }

                                    Rectangle {} // spacer

                                    // AI Classify button
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        border-radius: 6px;
                                        background: Theme.border-subtle;

                                        TouchArea {
                                            clicked => { root.ai-classify(); }
                                            mouse-cursor: pointer;
                                        }

                                        Icon {
                                            commands: Icons.tag;
                                            size: 13px;
                                            tint: Theme.text-secondary;
                                            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
                                        }
                                    }

                                    Text {
                                        text: root.email-detail.date-text;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Attachment bar (legacy simple view)
                            if root.email-detail.has-attachment && root.email-attachments.length == 0 : Rectangle {
                                height: 36px;
                                border-radius: 8px;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;

                                    Icon { commands: Icons.paperclip; size: 13px; tint: Theme.text-dim; y: (parent.height - self.height) / 2; }
                                    Text {
                                        text: root.email-detail.attachment-names != "" ? root.email-detail.attachment-names : "Attachments";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                        overflow: elide;
                                    }
                                }
                            }

                            // Rich attachment chips (V41)
                            if root.email-attachments.length > 0 : Rectangle {
                                height: 48px;
                                border-radius: 8px;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    padding-top: 8px;
                                    padding-bottom: 8px;
                                    spacing: 6px;

                                    Icon { commands: Icons.paperclip; size: 13px; tint: Theme.text-dim; y: (parent.height - self.height) / 2; }

                                    for att[aidx] in root.email-attachments : Rectangle {
                                        height: 32px;
                                        border-radius: 8px;
                                        background: att.is-downloaded ? AppIdentity.accent.with-alpha(0.08) : Theme.border-subtle;
                                        border-width: 1px;
                                        border-color: att.is-downloaded ? AppIdentity.accent.with-alpha(0.2) : Theme.border-subtle;
                                        width: att-chip-content.preferred-width + 24px;

                                        att-chip-content := HorizontalLayout {
                                            padding-left: 8px;
                                            padding-right: 4px;
                                            spacing: 6px;

                                            // File type icon
                                            Icon {
                                                commands: att.mime-type == "application/pdf" ? Icons.doc
                                                    : att.mime-type == "image/png" || att.mime-type == "image/jpeg" ? Icons.image
                                                    : Icons.file;
                                                size: 12px;
                                                tint: att.is-downloaded ? AppIdentity.accent : Theme.text-secondary;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            // Filename
                                            Text {
                                                text: att.name;
                                                color: Theme.text-secondary;
                                                font-size: Theme.fs-micro;
                                                font-weight: 500;
                                                vertical-alignment: center;
                                                overflow: elide;
                                                max-width: 120px;
                                            }

                                            // Size
                                            Text {
                                                text: att.size-text;
                                                color: Theme.text-dim;
                                                font-size: Theme.fs-micro;
                                                vertical-alignment: center;
                                            }

                                            // A download button and a preview button stood
                                            // here. Neither could work: the mail service's
                                            // `EmailAttachment` carries a filename, a MIME type
                                            // and a size, and there is no method on this wire
                                            // that returns a part's bytes, so both handlers
                                            // logged a line. The chip says what the message
                                            // carries, which is true, and stops there.
                                        }
                                    }
                                }
                            }

                            // AI Summary card
                            if root.email-detail.ai-summary != "" : Rectangle {
                                height: ai-summary-content.preferred-height + 20px;
                                border-radius: 10px;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.accent.with-alpha(0.3);

                                ai-summary-content := VerticalLayout {
                                    padding: 12px;
                                    spacing: 6px;

                                    HorizontalLayout {
                                        spacing: 6px;
                                        Icon { commands: Icons.spark; size: 13px; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                                        Text {
                                            text: "Yantrik AI Summary";
                                            color: Theme.accent;
                                            font-size: Theme.fs-caption;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: root.email-detail.ai-summary;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        wrap: word-wrap;
                                    }
                                }
                            }

                            // Thread header (if threaded)
                            if root.email-detail.thread-count > 1 : Rectangle {
                                height: 32px;
                                border-radius: 8px;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;
                                    spacing: 6px;

                                    Icon {
                                        commands: Icons.chat;
                                        size: 13px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: root.email-detail.thread-count + " messages in this thread";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Thread messages (collapsible)
                            for tmsg[tidx] in root.email-thread-messages : VerticalLayout {
                                spacing: 0px;

                                // Thread message header (always visible)
                                Rectangle {
                                    height: 40px;
                                    border-radius: tmsg.is-collapsed ? 8px : 0px;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    TouchArea {
                                        clicked => { root.toggle-thread-message(tmsg.id); }
                                        mouse-cursor: pointer;
                                    }

                                    HorizontalLayout {
                                        padding-left: 12px;
                                        padding-right: 12px;
                                        spacing: 8px;

                                        Icon {
                                            commands: tmsg.is-collapsed ? Icons.chevron-right : Icons.chevron-down;
                                            size: 12px;
                                            tint: Theme.text-dim;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: tmsg.from-name != "" ? tmsg.from-name : tmsg.from-addr;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                            overflow: elide;
                                        }
                                        Rectangle {} // spacer
                                        Text {
                                            text: tmsg.date-text;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Thread message body (shown when expanded)
                                if !tmsg.is-collapsed : Rectangle {
                                    border-radius: 0px;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    height: thread-body-text.preferred-height + 24px;

                                    VerticalLayout {
                                        padding: 12px;
                                        padding-top: 0px;

                                        thread-body-text := Text {
                                            text: tmsg.body;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }

                            // Main email body (shown when no thread messages, or as the latest message)
                            if root.email-thread-messages.length == 0 : Rectangle {
                                border-radius: 8px;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 16px;

                                    Text {
                                        text: root.email-detail.body;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        wrap: word-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                // ══ EMPTY STATE ══
                if !root.is-composing && root.email-detail.id <= 0 : YEmptyState {
                    icon-path: Icons.mail-open;
                    title: "Select a message";
                    description: "Pick a conversation on the left, or start a new one.";
                    action-label: "Compose";
                    action-clicked => { root.compose-new(); }
                }
            }
        }

        // ── Status Bar ──
        Rectangle {
            height: 28px;
            background: Theme.bg-card;
            border-width: 0px;

            // Top border
            Rectangle {
                y: 0px;
                height: 1px;
                background: Theme.border-subtle;
            }

            HorizontalLayout {
                padding-left: 14px;
                padding-right: 14px;
                spacing: 16px;

                // Total emails in folder — or that it could not be counted, which is not
                // "0 emails". The reason is on hover.
                HorizontalLayout {
                    spacing: 4px;

                    Icon {
                        commands: Icons.mail;
                        size: 11px;
                        tint: Theme.text-dim;
                        y: (parent.height - self.height) / 2;
                    }
                    Rectangle {
                        width: total-text.preferred-width;

                        total-text := Text {
                            text: root.email-folder-counts-known
                                ? root.email-folder-total + " emails"
                                : "counts unavailable";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            vertical-alignment: center;
                        }

                        counts-ta := TouchArea {
                            enabled: !root.email-folder-counts-known;
                        }

                        if counts-ta.has-hover && !root.email-folder-counts-known
                            && root.email-folder-counts-reason != "" : Rectangle {
                            property <length> tw: min(counts-tt.preferred-width + 14px, 480px);
                            x: 0px;
                            y: -28px;
                            width: self.tw;
                            height: 22px;
                            border-radius: 5px;
                            background: Theme.bg-deep.transparentize(12%);
                            border-width: 1px;
                            border-color: Theme.hover-fill-strong;
                            drop-shadow-blur: 6px;
                            drop-shadow-color: Theme.overlay-backdrop;

                            counts-tt := Text {
                                text: root.email-folder-counts-reason;
                                color: Theme.text-secondary;
                                font-size: Theme.fs-micro;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                                overflow: elide;
                            }
                        }
                    }
                }

                // Unread count
                if root.email-folder-counts-known && root.email-folder-unread > 0 : HorizontalLayout {
                    spacing: 4px;

                    Rectangle {
                        width: 6px;
                        height: 6px;
                        border-radius: 3px;
                        background: Theme.accent;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.email-folder-unread + " unread";
                        color: Theme.accent;
                        font-size: Theme.fs-micro;
                        font-weight: 500;
                        vertical-alignment: center;
                    }
                }

                Rectangle {} // spacer

                // Sync status
                HorizontalLayout {
                    spacing: 4px;

                    Icon {
                        commands: root.is-loading ? Icons.refresh : Icons.check;
                        size: 11px;
                        tint: root.is-loading ? Theme.amber : Theme.color-success;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.email-sync-status;
                        color: root.is-loading ? Theme.amber : Theme.text-dim;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
