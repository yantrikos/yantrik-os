// Desktop screen — the AI-native desktop experience.
// Clean canvas: particle field + greeting + bottom-center orb.
// Intent Lens overlays when invoked.
// No clutter. The AI is alive, not widgetized.
//
// Layout:
//   ┌─────────────────────────────────────┐
//   │ StatusBar (24px) [●] 14:32    87%  │
//   ├─────────────────────────────────────┤
//   │                                     │
//   │    ░░░ particle field ░░░           │
//   │                                     │
//   │       Good evening, Pranab          │
//   │          12 memories                │
//   │                                     │
//   │              ◉ orb                  │
//   │                                     │
//   │▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁▁│ ← dock glow trigger
//   └─────────────────────────────────────┘
//
//   Intent Lens: overlays center-screen when Super pressed

import { Theme, ThemeMode } from "theme.slint";
import { ParticleField } from "components/particle_field.slint";
import { DesktopHome } from "components/desktop_home.slint";
import { DockButton } from "components/grounded_dock.slint";
import { StatusBar } from "components/status_bar.slint";
import { DockItem } from "components/app_dock.slint";
import { Icon, Icons } from "components/icon.slint";
import { IntentLens, LensResult, ApprovalRequest } from "components/intent_lens.slint";
import { WorkCardData } from "components/work_card.slint";
import { QuestionRequest } from "components/question_card.slint";
import { MessageData } from "components/message_bubble.slint";
import { UrgeCardData } from "components/glance_card.slint";
import { WhisperCardStack, WhisperCardItem } from "components/whisper_card.slint";
import { AppGrid, AppGridItem } from "components/app_grid.slint";
import { WindowItem } from "components/window_item.slint";
import { CommandPalette, CommandItem } from "components/command_palette.slint";
import { MorningBriefCard, BriefSection } from "components/morning_brief.slint";

import { YContextMenu } from "components/y_context_menu.slint";

export component DesktopScreen inherits Rectangle {
    // Status bar state
    in property <string> clock-text: "00:00";
    in property <string> companion-status: "idle";
    in property <bool> companion-online: true;
    in property <int> pending-count: 0;
    in property <bool> settings-incognito-mode: false;
    in property <bool> dnd-mode: false;
    // The date, from the clock timer. The load readouts, the services and the bond went with the
    // machine rail: the mind panel (app.slint) holds the right edge on every screen now.
    in property <string> date-text: "";
    // The room the mind panel takes at the right edge. Everything on this screen that used to
    // measure itself against the rail measures against this instead.
    in property <length> right-inset: 0px;
    // Launcher categories

    // Companion state
    in property <bool> is-thinking: false;
    in property <bool> has-urges: false;
    in property <bool> is-speaking: false;
    in property <bool> is-listening: false;
    in property <string> greeting-text: "Hello";
    in property <int> memory-count: 0;

    // Ambient Intelligence
    // Ambient animation budget, in milliseconds per tick, set from Rust at startup.
    // 16 = 60fps on a GPU; ~100 = 10fps on the software rasteriser, which costs roughly
    // a sixth as much and still moves; 0 turns ambient animation off entirely for a
    // headless or unattended deployment. Phase increments are multiplied by tick-scale
    // so the animation runs at the same SPEED at any of these rates, just fewer frames.
    in property <int> ambient-interval-ms: 16;
    // Frames are fewer at a longer interval, so each step must be proportionally larger
    // for the animation to keep the same wall-clock speed.
    property <float> tick-scale: max(16, ambient-interval-ms) / 16.0;
    in property <float> particle-sentiment: 0.0;
    in property <float> particle-cognitive-load: 0.0;
    in property <float> particle-time-of-day: 0.5;

    // Project Consciousness
    in property <string> active-project: "";

    // Intent Lens state
    in-out property <bool> lens-open: false;
    /// What is typed in the Lens. Carried up to the App so the shell's control surface can
    /// prefill the ask bar and report back what is actually in it.
    in-out property <string> lens-input-text: "";
    in property <[LensResult]> lens-results: [];
    in property <bool> lens-chat-mode: false;
    in property <[LensResult]> lens-suggestions: [];
    in property <[LensResult]> lens-recents: [];

    // Chat state (for lens chat mode)
    in property <[MessageData]> messages: [];
    in property <bool> is-generating: false;

    // What a mind has asked the person to allow. Drawn in the Lens's conversation; the App
    // draws the same list over whatever screen is up when the Lens is not showing it.
    in property <[ApprovalRequest]> approvals: [];
    in property <int> approvals-waiting: 0;
    /// The Lens's mind's own questions (#25).
    in property <[QuestionRequest]> questions: [];
    callback question-answer(string, string, string);
    callback open-run(string);
    callback approval-allow(string);
    /// The same grant plus a standing rule for that (app, action) — see mind_mode.rs.
    callback approval-allow-session(string);
    callback approval-deny(string);

    // The Lens's "open in Agents": whether the conversation is an agent's, and the press.
    in property <bool> lens-can-open-in-agents: false;
    callback lens-open-in-agents();
    callback lens-open-history();
    callback lens-new-chat();

    // Chat v2: the work cards of the runs this chat started, the strip's run and counts, the mode
    // chip's label and the header's identity line. Filled from the Agents store and the mind mode.
    in property <[WorkCardData]> lens-work-cards: [];
    in property <WorkCardData> lens-strip;
    in property <int> lens-live-runs: 0;
    in property <int> lens-waiting-runs: 0;
    in property <string> lens-mode-label: "Ask";
    in property <string> lens-identity: "";
    callback lens-mode-clicked();
    callback lens-view-desk(string);

    // Urges (for quiet queue)
    in property <[UrgeCardData]> urges: [];

    // Whisper Cards (floating notifications)
    in property <[WhisperCardItem]> whisper-cards: [];
    callback whisper-card-dismissed(string);
    callback whisper-card-action(string);
    callback whisper-hint-clicked();

    // Morning Brief card
    in property <bool> morning-brief-visible: false;
    in property <string> morning-brief-greeting: "Good morning!";
    in property <[BriefSection]> morning-brief-sections: [];
    callback morning-brief-dismissed();
    callback morning-brief-section-action(string);

    // Quick Settings, the power menu and the clipboard panel are not here: they are the shell's
    // (`ShellOverlays`, drawn once in app.slint), so the bar's buttons work from every screen.
    // `power-action` stays because the launcher's own power row calls it.
    callback power-action(string);

    // App grid
    in-out property <bool> app-grid-open: false;
    in property <[AppGridItem]> grid-apps: [];
    in property <[DockButton]> grid-running: [];
    callback grid-launch-app(string);
    callback grid-toggle-pin(string);
    callback grid-search-apps(string);

    // Open windows, for the taskbar
    in property <[WindowItem]> window-list: [];

    // Command Palette (Ctrl+Shift+P)
    in-out property <bool> command-palette-open: false;
    in property <[CommandItem]> command-palette-filtered: [];
    callback command-palette-search(string);
    callback command-palette-selected(string);

    // Dock items (settable from Rust for running indicators)
    in property <[DockItem]> dock-items: [];

    // Focus mode (Workspace Morph)
    in-out property <bool> focus-mode: false;
    in property <string> focus-remaining: "";
    callback end-focus-mode();

    // Wallpaper
    // Agent mode shows the machine: both rails and the ask bar. A human gets a
    // desktop instead. Off by default — the person is the default user.
    in property <bool> agent-mode: false;

    in property <string> wallpaper-path: "";
    in property <image> wallpaper-image;

    // V61 — AI privacy indicator state
    in property <string> ai-privacy-mode: "local";
    in property <string> ai-fallback-banner: "";
    callback ai-privacy-clicked();

    in property <string> active-harness-id: "";
    in property <string> active-harness-name: "";
    callback active-mind-clicked();

    // Callbacks
    callback send-message(string);
    callback mic-pressed();
    callback launch-app(string);

    // The desktop's right-click menu.
    //
    // Every entry dispatches through `launch-app`, the same callback the desktop icons and the
    // dock already use, so the menu cannot drift away from what clicking an icon does and needs
    // no wiring of its own on the Rust side.
    // The work rail yields to the working area on laptop and compact displays.
    property <bool> show-work-rail: root.width >= 1360px && (root.active-project != "" || root.lens-recents.length > 0);
    // The centre column: 860 wide, centred in what the mind panel leaves; or, beside the work
    // rail, everything between the rail and the panel with the gap the machine rail used to get.
    property <length> content-left: root.show-work-rail ? 316px : max(24px, (root.width - root.right-inset - 860px) / 2);
    property <length> content-right: root.right-inset + (root.show-work-rail ? 4px : root.content-left);

    property <bool> desktop-menu-open: false;
    property <length> desktop-menu-x: 0;
    property <length> desktop-menu-y: 0;
    callback navigate-to(int);
    callback lens-query(string);
    callback lens-submit(string);
    callback lens-result-selected(string);
    callback open-lens();
    callback close-lens();

    background: Theme.bg-deep;
    clip: true;

    // ── Layer 1: Status bar (always on top, dims in focus mode) ──
    // The status bar is the shell's now, not the desktop's.
    //
    // It was declared here, so the clock, the CPU and memory meters, the battery, the network
    // and the chip naming which mind is answering all existed on exactly ONE screen. Open
    // anything and they were gone — while the compositor went on reserving 32px at the top of
    // every screen for a bar that was not being drawn there. The same mistake the taskbar had,
    // found the same way: by asking why a reserved strip was empty.
    //
    // The desktop still starts below it; that is what the offset on the layer below is for.

    // ── Layer 2: Desktop content area ──
    Rectangle {
        y: Theme.status-bar-height;
        width: 100%;
        height: root.height - Theme.status-bar-height;
        clip: true;

        // ── Wallpaper layer (lowest — below all backdrops) ──

        // Preset: Aurora (green/purple gradient)
        // ── Wallpaper ──
        //
        // Pre-rendered, not computed. These four were Slint gradient stacks — a linear base plus
        // three radial glows and a vignette, five full-screen passes — and the software
        // rasteriser re-evaluated all of them on EVERY repaint of the desktop. The desktop
        // repaints whenever a live value changes, which here is the clock and the CPU meter,
        // every two or three seconds, all day.
        //
        // Measured on VM 520, idle, nothing running:
        //     procedural gradient   6.6% of a core
        //     pre-rendered bitmap   1.5% of a core
        //
        // Mac and Windows ship bitmaps for exactly this reason. The pixels are identical — they
        // are generated from these same definitions by scripts/render-wallpapers.py, which is
        // committed beside them so the design stays editable and the PNGs stay reproducible.
        // ── Scenes ──
        //
        // Rendered by scripts/render-scene-wallpapers.py: a horizon, ridges hazing back into
        // the sky, and a lake that mirrors it. The four gradients below are still here and are
        // still fine; they are also FLAT, and a flat backdrop is what made every card drawn on
        // it read as paint on the same plane rather than glass in front of something.
        //
        // These are blurred slightly at render time, which is the whole reason the surfaces on
        // top can be translucent without the compositor blurring anything per frame.
        if root.wallpaper-path == "serenity" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/serenity.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "first-light" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/first-light.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "nightfall" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/nightfall.png");
            image-fit: fill;
        }

        if root.wallpaper-path == "aurora" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/aurora.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "sunset" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/sunset.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "ocean" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/ocean.png");
            image-fit: fill;
        }
        if root.wallpaper-path == "nebula" : Image {
            width: 100%; height: 100%;
            source: @image-url("wallpapers/nebula.png");
            image-fit: fill;
        }

        if root.wallpaper-path != "" && root.wallpaper-path != "aurora" && root.wallpaper-path != "sunset" && root.wallpaper-path != "ocean" && root.wallpaper-path != "nebula" && root.wallpaper-path != "serenity" && root.wallpaper-path != "first-light" && root.wallpaper-path != "nightfall" : Image {
            width: 100%; height: 100%;
            source: root.wallpaper-image;
            image-fit: cover;
        }

        // A still background has no idle frame loop or per-frame blur passes.
        if root.wallpaper-path == "" : Rectangle {
            width: 100%; height: 100%; background: Theme.bg-deep;
        }
        if !ThemeMode.dark && root.wallpaper-path != "" : Rectangle {
            width: 100%; height: 100%; background: #f3f5f8b0;
        }

        // ── The desktop's own right-click ──
        //
        // There was none, anywhere: YContextMenu has existed in the kit the whole time and was
        // never once instantiated. And the compositor's root menu cannot stand in for it, because
        // the shell is a fullscreen window — labwc's root is underneath it and unreachable, so a
        // right click anywhere on the desktop lands here and, until now, on nothing.
        //
        // Placed before the icons and the orb so those stay on top and keep their left clicks;
        // this only ever sees what they do not take.
        TouchArea {
            width: 100%;
            height: 100%;
            pointer-event(e) => {
                if (e.button == PointerEventButton.right && e.kind == PointerEventKind.down) {
                    root.desktop-menu-x = self.mouse-x;
                    root.desktop-menu-y = self.mouse-y;
                    root.desktop-menu-open = true;
                }
            }
        }

        // The one desktop home. Everyday and agent mode are the same component with a flag: they
        // used to be two designs (a different search field, different pin tiles, different
        // spacing; the agent one lived here, 380 lines of it). Agent mode only adds what the mind
        // proposes and the day-one card, and sits in the centre column the work rail leaves.
        if !root.focus-mode : DesktopHome {
            // Centred in what the mind panel leaves, not under it.
            x: root.agent-mode ? root.content-left : (parent.width - root.right-inset - self.width) / 2;
            y: root.agent-mode ? Theme.sp-4 + 4px : (parent.height < 720px ? 24px : 56px);
            width: root.agent-mode ? max(0px, parent.width - root.content-left - root.content-right)
                                   : min(760px, parent.width - root.right-inset - 48px);
            height: max(0px, parent.height - self.y - Theme.taskbar-height - 24px);
            agent-mode: root.agent-mode;
            greeting: root.greeting-text;
            date: root.date-text;
            mind-name: root.active-harness-name;
            online: root.companion-online;
            pins: root.dock-items;
            recents: root.lens-recents;
            urges: root.urges;
            has-windows: root.window-list.length > 0;
            send-message(text) => { root.send-message(text); }
            search => { root.lens-open = true; root.open-lens(); }
            all-apps => { root.app-grid-open = true; }
            launch(id) => { root.launch-app(id); }
            open-recent(id) => { root.lens-result-selected(id); }
            configure-mind => {
                if root.companion-online {
                    root.lens-open = true;
                    root.open-lens();
                } else {
                    root.active-mind-clicked();
                }
            }
        }

        // ── Working set (left rail, hidden in focus mode) ──
        // What replaced the centred greeting. A desktop that shows the project, the recent
        // files and the memory count is a desktop that shows work; one that says "Good
        // evening" shows nothing. Every line here is data the shell already had.
        if root.agent-mode && root.show-work-rail && !root.focus-mode : Rectangle {
            x: Theme.sp-4;
            y: Theme.sp-4;
            width: 296px - Theme.sp-4;
            // As tall as what it holds, and no taller.
            //
            // Running the full height, this card was 550px of empty panel between "Nothing yet
            // -- open something." and the counters pinned to its foot. Nothing was in that
            // space and nothing was going to be; it was a dark rectangle asserting that
            // something lived there. A card that ends where its content ends says the same
            // thing honestly, and hands the rest back to the wallpaper.
            //
            // The clamp is what keeps a machine with forty recent files from growing a rail
            // taller than the screen.
            height: Math.min(work-body.preferred-height,
                             parent.height - Theme.taskbar-height - Theme.sp-4 * 3 - 96px);
            border-radius: Theme.r-lg;
            background: Theme.glass-rail;
            border-width: 1px;
            border-color: Theme.glass-border;
            clip: true;

            work-body := VerticalLayout {
                padding: Theme.sp-4;
                spacing: 0;

                Text { text: "PROJECT"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    padding-top: 6px;
                    Rectangle { width: 3px; height: 15px; y: (parent.height - 15px) / 2; border-radius: 1.5px; background: Theme.accent; }
                    Text {
                        text: root.active-project != "" ? root.active-project : "No active project";
                        color: root.active-project != "" ? Theme.text-primary : Theme.text-secondary;
                        font-size: Theme.fs-headline;
                        font-weight: Theme.fw-headline;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                Rectangle { height: 1px; background: Theme.separator; }
                Rectangle { height: Theme.sp-3; }

                Text { text: "RECENT"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                Rectangle { height: 6px; }

                if root.lens-recents.length == 0 : Text {
                    text: "Nothing yet — open something.";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                }
                for r in root.lens-recents : TouchArea {
                    height: 28px;
                    mouse-cursor: pointer;
                    clicked => { root.lens-result-selected(r.action-id); }
                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.r-sm;
                        background: parent.has-hover ? Theme.hover-fill : transparent;
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px;
                            spacing: 9px;
                            Icon { commands: Icons.file; size: 13px; tint: Theme.text-dim; y: (parent.height - self.height) / 2; }
                            Text {
                                text: r.title;
                                color: Theme.text-primary;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                            Text {
                                text: r.subtitle;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 90px;
                            }
                        }
                    }
                }

            }
        }

        // -- Vitals (foot of the left column) --
        //
        // Its own card, because it is its own thing: two counts about the companion, which have
        // nothing to do with the project and the recent files above them. Joined to that panel
        // by a separator they read as the bottom of a list; separated, they read as a widget,
        // and the gap between the two is wallpaper rather than filler.
        if root.agent-mode && root.show-work-rail && !root.focus-mode : Rectangle {
            x: Theme.sp-4;
            y: parent.height - Theme.taskbar-height - Theme.sp-4 - vitals-body.preferred-height;
            width: 296px - Theme.sp-4;
            height: vitals-body.preferred-height;
            border-radius: Theme.r-lg;
            background: Theme.glass-rail;
            border-width: 1px;
            border-color: Theme.glass-border;
            clip: true;

            vitals-body := HorizontalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-3;
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "MEMORIES"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                    Text { text: root.memory-count; color: Theme.text-primary; font-size: Theme.fs-title-2; font-weight: 500; }
                }
                VerticalLayout {
                    horizontal-stretch: 1;
                    Text { text: "PENDING"; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: Theme.fw-micro; letter-spacing: 1px; }
                    Text { text: root.pending-count; color: root.pending-count > 0 ? Theme.accent : Theme.text-primary; font-size: Theme.fs-title-2; font-weight: 500; }
                }
            }
        }

        // ── Focus Overlay (Workspace Morph) ──
        if root.focus-mode : VerticalLayout {
            alignment: center;
            spacing: 8px;

            // Large countdown timer
            Text {
                text: root.focus-remaining;
                color: Theme.text-primary;
                font-size: 72px;
                font-weight: 200;
                letter-spacing: 4px;
                horizontal-alignment: center;
                opacity: 0.85;
            }

            // Label
            Text {
                text: "remaining";
                color: Theme.text-dim;
                font-size: Theme.fs-body;
                letter-spacing: 3px;
                horizontal-alignment: center;
                opacity: 0.5;
            }

            // Spacer
            Rectangle { height: 32px; }

            // End Focus button
            TouchArea {
                width: 120px;
                height: 36px;
                x: (parent.width - 120px) / 2;
                clicked => { root.end-focus-mode(); }

                Rectangle {
                    width: 100%; height: 100%;
                    border-radius: 18px;
                    border-width: 1px;
                    border-color: Theme.text-dim;
                    background: parent.has-hover ? Theme.hover-fill-strong : transparent;

                    Text {
                        text: "End Focus";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-body;
                        font-weight: 500;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }

        // ── The right edge ──
        // The machine rail stood here, in agent mode only and on this screen only. The mind panel
        // replaced it and is the shell's, not the desktop's: see `MindPanel` in app.slint. Its
        // LOAD and SERVICES went into the panel's MACHINE section, still agent mode only.

        // ── Taskbar (bottom edge) ──
        // The taskbar is the shell's now, not the desktop's — it is drawn once in app.slint so
        // it is the same bar above every screen instead of vanishing when you leave this one.
    }

    // ── Layer 2.53: App grid overlay ──
    AppGrid {
        width: 100%;
        height: 100%;
        is-open <=> root.app-grid-open;
        apps: root.grid-apps;
        running: root.grid-running;
        launch-app(app-id) => { root.grid-launch-app(app-id); }
        toggle-pin(app-id) => { root.grid-toggle-pin(app-id); }
        power-action(action) => { root.power-action(action); }
        close => { root.app-grid-open = false; }
        search-changed(query) => { root.grid-search-apps(query); }
    }

    // ── Layer 2.56: Command Palette overlay ──
    CommandPalette {
        width: 100%;
        height: 100%;
        is-open <=> root.command-palette-open;
        filtered-commands: root.command-palette-filtered;
        search-changed(query) => { root.command-palette-search(query); }
        command-selected(action-id) => { root.command-palette-selected(action-id); }
        close => { root.command-palette-open = false; }
    }

    // ── Layer 2.6: Whisper Cards (floating, top-right) ──
    WhisperCardStack {
        // Beside the mind panel rather than under it.
        x: root.width - root.right-inset - 316px;
        y: Theme.status-bar-height + 8px;
        cards: root.whisper-cards;
        card-dismissed(id) => { root.whisper-card-dismissed(id); }
        card-action(id) => { root.whisper-card-action(id); }
    }

    // ── Layer 2.7: Morning Brief Card (floating, upper-left) ──
    MorningBriefCard {
        // Where there is actually nothing.
        //
        // "In agent mode there are no icons, so it keeps its corner" was true when it was
        // written and stopped being true the moment agent mode grew a working-set rail in that
        // corner. The card then sat on top of PROJECT and RECENT *and* across the hero, with
        // three layers of text overlapping in the same 400 pixels.
        //
        // Agent mode: the foot of the centre column, above the taskbar. Clear of both rails,
        // clear of the hero, and where a transient card belongs — it is an announcement, not
        // part of the layout.
        x: root.agent-mode ? 296px + Theme.sp-5 : parent.width - root.right-inset - self.width - 24px;
        y: root.agent-mode
            ? parent.height - Theme.taskbar-height - self.height - Theme.sp-4
            : Theme.status-bar-height + 16px;
        // A child of a plain Rectangle fills its parent by default, so the card
        // ignored its own preferred-height and ran the whole height of the screen.
        height: self.preferred-height;
        show-card: root.morning-brief-visible;
        greeting: root.morning-brief-greeting;
        sections: root.morning-brief-sections;
        dismissed => { root.morning-brief-dismissed(); }
        section-action(id) => { root.morning-brief-section-action(id); }
    }

    // ── Layer 3: Intent Lens overlay ──
    IntentLens {
        is-open: root.lens-open;
        input-text <=> root.lens-input-text;
        is-thinking: root.is-thinking;
        results: root.lens-results;
        companion-status: root.companion-status;
        companion-online: root.companion-online;
        chat-mode: root.lens-chat-mode;
        // So the conversation header says who is answering — the same name the status bar
        // chip and the machine rail carry, rather than a generic "Conversation".
        mind-name: root.active-harness-name;
        can-open-in-agents: root.lens-can-open-in-agents;
        open-in-agents => { root.lens-open-in-agents(); }
        open-history => { root.lens-open-history(); }
        new-chat => { root.lens-new-chat(); }
        work-cards: root.lens-work-cards;
        strip: root.lens-strip;
        live-runs: root.lens-live-runs;
        waiting-runs: root.lens-waiting-runs;
        mode-label: root.lens-mode-label;
        identity: root.lens-identity;
        mode-clicked => { root.lens-mode-clicked(); }
        mind-clicked => { root.active-mind-clicked(); }
        view-desk(run) => { root.lens-view-desk(run); }
        messages: root.messages;
        is-generating: root.is-generating;
        suggestions: root.lens-suggestions;
        recents: root.lens-recents;
        approvals: root.approvals;
        approvals-waiting: root.approvals-waiting;

        approval-allow(id) => { root.approval-allow(id); }
        approval-allow-session(id) => { root.approval-allow-session(id); }
        approval-deny(id) => { root.approval-deny(id); }
        questions: root.questions;
        question-answer(agent, request, answer) => { root.question-answer(agent, request, answer); }
        open-run(run) => { root.open-run(run); }
        query-changed(text) => { root.lens-query(text); }
        submit-query(text) => { root.lens-submit(text); }
        result-selected(id) => { root.lens-result-selected(id); }
        close-lens => {
            root.lens-open = false;
            root.close-lens();
        }
        send-message(text) => { root.send-message(text); }
        mic-pressed => { root.mic-pressed(); }
    }

    // Last in the file so it draws over the icons, the orb and the taskbar. A menu that opened
    // underneath the thing it was summoned from would be worse than no menu.
    if root.desktop-menu-open : YContextMenu {
        open: true;
        // Kept inside the screen when summoned near an edge: the panel is 220px wide and each
        // row is 32px, so a click in the bottom-right corner would otherwise open a menu mostly
        // off-screen.
        menu-x: min(root.desktop-menu-x, root.width - 232px);
        menu-y: min(root.desktop-menu-y, root.height - 200px);
        actions: [
            { id: "terminal", label: "Open Terminal" },
            { id: "files", label: "Open Files", separator-after: true },
            { id: "launchpad", label: "All Apps" },
            { id: "devices", label: "Devices", separator-after: true },
            { id: "settings", label: "Settings" },
        ];
        action-clicked(id) => {
            root.desktop-menu-open = false;
            root.launch-app(id);
        }
        close-menu => { root.desktop-menu-open = false; }
    }
}
