// Notes Editor — AI-native markdown notes with semantic search.
// Screen 15. Opens from dock "Notes" icon.
// Split-pane: folder sidebar + note list + themed writing surface.
// Notes saved as .md files + indexed in YantrikDB for semantic recall.

import { Theme } from "theme.slint";
import { YButton, YIconButton } from "components/y_button.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposalCard, AgentProposal } from "components/agent_proposal.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";

export struct NoteEntry {
    title: string,
    filename: string,
    modified: string,
    preview: string,
    is-pinned: bool,
    tags: string,
    created: string,
    word-count: int,
}

export struct NoteVersionEntry {
    label: string,
    timestamp: string,
    index: int,
}

export struct NoteBacklink {
    title: string,
    filename: string,
}

/// An image a note embeds. `source` is already loaded by the Rust side; `found` is false when
/// the reference does not resolve to a file, which is worth showing rather than hiding.
export struct NoteImage {
    name: string,
    path: string,
    source: image,
    found: bool,
}


// One notebook row: icon, name, count.
//
// The selected row wears the app's colour, not the house accent -- this is the sidebar of
// Notes, and which app you are in is exactly what a selected sidebar row is saying.
component FolderRow inherits TouchArea {
    in property <string> label;
    in property <string> icon;
    in property <int> count;
    in property <bool> selected;

    height: 30px;
    mouse-cursor: pointer;

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-sm;
        background: root.selected ? AppIdentity.tint
                  : parent.has-hover ? Theme.hover-fill
                  : transparent;

        HorizontalLayout {
            padding-left: Theme.sp-2;
            padding-right: Theme.sp-2;
            spacing: Theme.sp-2;

            Icon {
                commands: root.icon;
                size: 14px;
                // Every notebook icon wears the app's colour, dimmed when the row is not the
                // one you are in. That is what Mail and Notes and Finder all do: the sidebar
                // is the one place an app says its own name in colour on every row, and
                // selection is carried by the tint behind and the weight of the word.
                tint: root.selected ? AppIdentity.accent : AppIdentity.accent.transparentize(50%);
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.label;
                color: root.selected ? AppIdentity.accent : Theme.text-primary;
                font-size: Theme.fs-caption;
                font-weight: root.selected ? 600 : 400;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.count > 0 ? "\{root.count}" : "";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                vertical-alignment: center;
            }
        }
    }
}

export component NotesEditor inherits Rectangle {
    background: Theme.bg-deep;

    in-out property <bool> library-visible: true;
    in-out property <bool> assistant-visible: false;
    changed width => {
        if (root.width < 1000px && root.assistant-visible) { root.library-visible = false; }
    }

    // Note list
    in property <[NoteEntry]> notes-list: [];
    in property <int> selected-index: -1;

    // Editor state
    in-out property <string> current-content: "";
    in property <string> current-title: "";
    in property <bool> is-modified: false;
    in property <int> note-count: 0;

    // Search state
    in-out property <string> search-query: "";
    in property <bool> is-searching: false;

    // Folder/notebook state
    in-out property <int> active-folder: 0;  // 0=All, 1=Favorites, 2=Recent
    in property <int> folder-all-count: 0;
    in property <int> folder-fav-count: 0;
    in property <int> folder-recent-count: 0;
    callback select-folder(int);

    // Tags
    in-out property <string> current-tags: "";
    callback update-tags(string);

    // Pin/Favorite
    callback toggle-pin(int);

    // Templates
    callback new-from-template(string);

    // Metadata
    in property <string> meta-created: "";
    in property <string> meta-modified: "";
    in property <int> meta-word-count: 0;

    // Formatting toolbar
    callback insert-format(string);

    // AI Assist
    in property <bool> ai-is-working: false;
    in property <string> ai-response: "";
    // ── The agent layer ──
    //
    // Everything here is filled from something the app or the companion actually holds --
    // backlinks the note really has, memories the companion really recalled -- and each row
    // says which. Nothing is invented to fill the column; see agent_rail.slint.
    in property <[AgentContextItem]> agent-context: [];
    in property <[AgentSuggestion]> agent-suggestions: [];
    in property <string> agent-unavailable: "";
    callback agent-context-activated(string);
    callback agent-suggestion-activated(string);

    // What the companion is proposing to do to this note, if anything.
    in property <AgentProposal> proposal;
    in property <bool> proposal-working: false;

    in-out property <bool> ai-panel-open: false;
    callback ai-structure();
    callback ai-summarize();
    callback ai-apply();
    callback ai-dismiss();

    // Version history
    in property <[NoteVersionEntry]> version-history: [];
    in-out property <bool> version-panel-open: false;
    callback view-version(int);
    callback restore-version(int);

    // Backlinks
    in property <[NoteBacklink]> backlinks: [];
    /// Where this note points. An entry with an empty `filename` is a link to a note that
    /// does not exist yet.
    in property <[NoteBacklink]> outbound-links: [];
    in-out property <bool> backlinks-panel-open: false;
    callback find-backlinks();
    /// Open a note by filename — how a backlink is followed.
    callback open-note(string);

    // ── Images ──
    in property <[NoteImage]> note-images: [];
    in-out property <bool> images-panel-open: false;
    in-out property <int> image-preview-index: 0;
    in-out property <string> attach-image-path: "";
    callback scan-images();
    /// Copy a file into the vault's attachments and embed it in the current note.
    callback attach-image(string);

    // Meeting mode
    in property <bool> meeting-mode: false;
    callback toggle-meeting-mode();

    // Export/Import
    in property <string> export-status: "";
    callback export-md();
    callback import-md();

    // Callbacks
    callback new-note();
    callback save-note();
    callback delete-note();
    callback close-note();
    callback select-note(int);
    callback search-notes(string);
    callback content-changed(string);

    // Template menu state (internal)
    property <bool> template-menu-open: false;

    // Isolate responsive child sizes from the resizable window's preferred size.
    Flickable {
        width: 100%; height: 100%; interactive: false;
        viewport-width: self.width; viewport-height: self.height;

    VerticalLayout {
        spacing: 0px;

        // ── Header ──
        //
        // Drawn by the SDK, not by Notes. What stood here was 170 lines of hand-rolled bar: a
        // 48px Rectangle, its own divider, its own glyph tile, its own title typography and a
        // right-hand row of eleven buttons with their own padding. Fifteen other apps had the
        // same block, at seven different heights, which is why nothing lined up.
        //
        // The buttons are data now. AppHeader decides how tall they are, how far apart, and how
        // far from the edge; Notes only says which ones exist and what they mean. Actions that
        // need a note now grey out instead of vanishing — a toolbar that reflows as you click
        // around it is the jumpiest thing a window can do.
        AppHeader {
            app-id: "notes";
            icon: Icons.notes;
            title: "Notes";
            modified: root.is-modified;
            leading-actions: [
                { id: "library", icon: Icons.list, label: "Library", active: root.library-visible },
                { id: "assistant", icon: Icons.spark, label: "Assistant", active: root.assistant-visible }
            ];
            status: root.export-status;
            actions: [
                // Keep the most frequent actions visible at compact widths.
                { id: "new",       icon: Icons.plus,         label: "New",       emphasis: 2 },
                { id: "save",      icon: Icons.save,         label: "Save",      emphasis: 1, active: root.is-modified, disabled: root.selected-index < 0 },
                { separator: true },
                // The note: what you can do to the thing you are looking at.
                { id: "meeting",   icon: Icons.people, label: "Meeting mode", active: root.meeting-mode, disabled: root.selected-index < 0 },
                { id: "history",   icon: Icons.history, label: "Version history", active: root.version-panel-open, disabled: root.selected-index < 0 },
                { id: "export",    icon: Icons.export,       label: "Export",                disabled: root.selected-index < 0 },
                { id: "import",    icon: Icons.import,       label: "Import" },
                { separator: true },

                // The companion.
                { id: "structure", icon: Icons.spark,        label: root.ai-is-working ? "Working" : "Structure",
                  emphasis: 1, loading: root.ai-is-working,  disabled: root.selected-index < 0 },
                { id: "summarize", icon: Icons.template,     label: "Summarize", emphasis: 1, disabled: root.selected-index < 0 },
                { separator: true },

                // Making and keeping.
                { id: "template",  icon: Icons.chevron-down, label: "Template",  active: root.template-menu-open,
                  trailing-icon: true },
                { separator: true },

                // Getting rid of it. On its own, and last, because a bin beside a Save button
                // with nothing between them is a row that invites the wrong click.
                { id: "delete",    icon: Icons.trash,        label: "Delete",    emphasis: 3, disabled: root.selected-index < 0 },
                { id: "close",     icon: Icons.close,        label: "Close",     disabled: root.selected-index < 0 },
            ];
            action(id) => {
                if (id == "library") {
                    root.library-visible = !root.library-visible;
                    if (root.library-visible && root.width < 1000px) { root.assistant-visible = false; }
                }
                else if (id == "assistant") {
                    root.assistant-visible = !root.assistant-visible;
                    if (root.assistant-visible && root.width < 1000px) { root.library-visible = false; }
                }
                else if (id == "meeting") { root.toggle-meeting-mode(); }
                else if (id == "export") { root.export-md(); }
                else if (id == "import") { root.import-md(); }
                else if (id == "history") { root.version-panel-open = !root.version-panel-open; }
                else if (id == "structure") { root.ai-structure(); root.ai-panel-open = true; }
                else if (id == "summarize") { root.ai-summarize(); root.ai-panel-open = true; }
                else if (id == "new") { root.new-note(); }
                else if (id == "template") { root.template-menu-open = !root.template-menu-open; }
                else if (id == "save") { root.save-note(); }
                else if (id == "delete") { root.delete-note(); }
                else if (id == "close") { root.close-note(); }
            }
        }

        // ── Template dropdown menu (overlay) ──
        if root.template-menu-open : Rectangle {
            height: 180px;
            background: Theme.bg-elevated;
            border-radius: Theme.r-md;
            border-width: 1px;
            border-color: Theme.border-subtle;

            VerticalLayout {
                padding: Theme.sp-1;
                spacing: 0px;

                // Meeting Notes
                TouchArea {
                    height: 32px;
                    clicked => {
                        root.new-from-template("meeting");
                        root.template-menu-open = false;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { commands: Icons.calendar; size: 14px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                            Text { text: "Meeting Notes"; color: Theme.text-primary; font-size: Theme.fs-caption; vertical-alignment: center; }
                        }
                    }
                }
                // Project Brief
                TouchArea {
                    height: 32px;
                    clicked => {
                        root.new-from-template("project");
                        root.template-menu-open = false;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { commands: Icons.template; size: 14px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                            Text { text: "Project Brief"; color: Theme.text-primary; font-size: Theme.fs-caption; vertical-alignment: center; }
                        }
                    }
                }
                // Decision Log
                TouchArea {
                    height: 32px;
                    clicked => {
                        root.new-from-template("decision");
                        root.template-menu-open = false;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { commands: Icons.check; size: 14px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                            Text { text: "Decision Log"; color: Theme.text-primary; font-size: Theme.fs-caption; vertical-alignment: center; }
                        }
                    }
                }
                // TODO List
                TouchArea {
                    height: 32px;
                    clicked => {
                        root.new-from-template("todo");
                        root.template-menu-open = false;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { commands: Icons.checkbox; size: 14px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                            Text { text: "TODO List"; color: Theme.text-primary; font-size: Theme.fs-caption; vertical-alignment: center; }
                        }
                    }
                }
                // SOP
                TouchArea {
                    height: 32px;
                    clicked => {
                        root.new-from-template("sop");
                        root.template-menu-open = false;
                    }
                    Rectangle {
                        height: 32px;
                        border-radius: 4px;
                        background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                        HorizontalLayout {
                            padding-left: 10px; spacing: 8px;
                            Icon { commands: Icons.doc; size: 14px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                            Text { text: "Standard Operating Procedure"; color: Theme.text-primary; font-size: Theme.fs-caption; vertical-alignment: center; }
                        }
                    }
                }
            }
        }


        // ── Main content: folders + note list + editor ──
        HorizontalLayout {
            spacing: 0px;

            // ── Left sidebar: folders + search + note list ──
            if root.library-visible : Rectangle {
                width: root.width < 1000px ? 220px : 248px;
                background: Theme.bg-surface;

                VerticalLayout {
                    spacing: 0px;

                    // ── Folder/Notebook selector ──
                    Rectangle {
                        height: 118px;
                        background: Theme.bg-surface;

                        VerticalLayout {
                            padding: Theme.sp-2;
                            padding-left: Theme.sp-2;
                            padding-right: Theme.sp-2;
                            spacing: 0px;

                            // Header
                            Text {
                                text: "NOTEBOOKS";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                font-weight: Theme.fw-micro;
                                letter-spacing: 1px;
                                height: 22px;
                                vertical-alignment: center;
                            }

                            FolderRow {
                                label: "All Notes"; icon: Icons.doc;   count: root.folder-all-count;
                                selected: root.active-folder == 0;
                                clicked => { root.select-folder(0); }
                            }
                            FolderRow {
                                label: "Favorites"; icon: Icons.star;  count: root.folder-fav-count;
                                selected: root.active-folder == 1;
                                clicked => { root.select-folder(1); }
                            }
                            FolderRow {
                                label: "Recent";    icon: Icons.clock; count: root.folder-recent-count;
                                selected: root.active-folder == 2;
                                clicked => { root.select-folder(2); }
                            }
                        }
                    }

                    // Separator
                    Rectangle { height: 1px; background: Theme.separator; }

                    // Search input
                    Rectangle {
                        height: 40px;
                        background: Theme.bg-surface;

                        Rectangle {
                            x: 8px; y: 5px;
                            width: parent.width - 16px; height: 30px;
                            border-radius: Theme.r-md;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: Theme.border-default;
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 14px;
                            spacing: 8px;

                            Icon {
                                commands: Icons.search;
                                size: 13px; thickness: 1.7px;
                                tint: Theme.text-dim;
                                y: (parent.height - self.height) / 2;
                            }

                            search-input := TextInput {
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                                single-line: true;
                                font-size: Theme.fs-caption;
                                color: Theme.text-primary;
                                text <=> root.search-query;
                                edited => { root.search-notes(self.text); }
                            }
                        }

                        if root.search-query == "" : Text {
                            x: 16px + 13px + 8px;
                            height: 100%;
                            text: "Search notes";
                            color: Theme.text-dim;
                            font-size: Theme.fs-caption;
                            vertical-alignment: center;
                        }
                    }

                    // Note count
                    Rectangle {
                        height: 24px;
                        background: Theme.bg-surface;

                        Text {
                            x: 10px;
                            text: root.note-count == 1
                                ? "1 note"
                                : (root.note-count > 0
                                    ? "\{root.note-count} notes"
                                    : "No notes");
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            vertical-alignment: center;
                        }
                    }

                    // Separator
                    Rectangle { height: 1px; background: Theme.separator; }

                    // Note list (scrollable)
                    Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: note-list-layout.preferred-height;

                        note-list-layout := VerticalLayout {
                            // `start`, not the default `stretch`: a stretch layout reports the sum of
                            // its rows as its maximum height, and Slint carries that bound up through
                            // the Flickable and the sidebar to the window, which then cannot open
                            // taller than the list. A list stacks from the top anyway.
                            alignment: start;
                            spacing: 4px;
                            padding: 8px;

                            if root.notes-list.length == 0 : Text {
                                text: root.search-query != "" ? "No matching notes" : "Your notes will appear here";
                                color: Theme.text-dim; font-size: 12px; height: 64px;
                                horizontal-alignment: center; vertical-alignment: center;
                            }
                            for entry[idx] in root.notes-list : TouchArea {
                                height: 84px;
                                clicked => { root.select-note(idx); }

                                Rectangle {
                                    height: 84px;
                                    border-radius: 8px;
                                    clip: true;
                                    background: idx == root.selected-index
                                        ? Theme.hover-fill-strong
                                        : (parent.has-hover ? Theme.hover-fill : transparent);

                                    VerticalLayout {
                                        padding: Theme.sp-2;
                                        padding-left: Theme.sp-3;
                                        padding-right: Theme.sp-3;
                                        spacing: 2px;

                                        // Title row with pin indicator
                                        HorizontalLayout {
                                            spacing: 4px;

                                            // Pin star
                                            if entry.is-pinned : Icon {
                                                commands: Icons.star;
                                                size: 11px; tint: Theme.amber;
                                                y: (parent.height - self.height) / 2;
                                            }

                                            // Title
                                            Text {
                                                text: entry.title;
                                                color: idx == root.selected-index
                                                    ? AppIdentity.accent
                                                    : Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                font-weight: 500;
                                                overflow: elide;
                                                horizontal-stretch: 1;
                                            }

                                            // Pin toggle
                                            pin-ta := TouchArea {
                                                width: 20px;
                                                height: 20px;
                                                clicked => { root.toggle-pin(idx); }
                                                Rectangle {
                                                    width: 20px; height: 20px;
                                                    border-radius: 10px;
                                                    background: parent.has-hover ? Theme.hover-fill : transparent;
                                                    Icon {
                                                        commands: Icons.star;
                                                        size: 12px;
                                                        tint: entry.is-pinned ? Theme.amber : Theme.text-dim;
                                                        x: (parent.width - self.width) / 2;
                                                        y: (parent.height - self.height) / 2;
                                                    }
                                                }
                                            }
                                        }

                                        // Preview (first line of content)
                                        Text {
                                            text: entry.preview;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            overflow: elide;
                                        }

                                        // Tags + modified row
                                        HorizontalLayout {
                                            spacing: 4px;

                                            // Show first tag as chip if exists
                                            if entry.tags != "" : Rectangle {
                                                height: 14px;
                                                width: tag-chip-text.preferred-width + 8px;
                                                border-radius: 7px;
                                                background: Theme.accent.transparentize(80%);
                                                tag-chip-text := Text {
                                                    text: entry.tags;
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-micro;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    max-width: 70px;
                                                }
                                            }

                                            Rectangle { horizontal-stretch: 1; }

                                            // Modified time
                                            Text {
                                                text: entry.modified;
                                                color: Theme.text-dim;
                                                font-family: Theme.font-mono;
                                                font-size: Theme.fs-micro;
                                                vertical-alignment: center;
                                            }
                                        }
                                    }

                                    // Selected indicator bar
                                    if idx == root.selected-index : Rectangle {
                                        x: 0px;
                                        y: 8px;
                                        width: 2px;
                                        height: parent.height - 16px;
                                        border-radius: 1px;
                                        background: Theme.accent;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // Vertical separator
            Rectangle { width: 1px; background: Theme.separator; }

            // ── Right: editor area ──
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 0px;

                // ── What the companion is proposing ──
                //
                // In the editor column, not across the whole window: it is about this note, and a
                // card that also spans the notebook list is claiming to be about more than it is.
                if root.proposal.title != "" : Rectangle {
                    height: card.height + Theme.sp-4;
                    background: Theme.bg-deep;
                    card := AgentProposalCard {
                        x: Theme.sp-4;
                        y: Theme.sp-3;
                        width: parent.width - Theme.sp-4 * 2;
                        data: root.proposal;
                        working: root.proposal-working;
                        apply => { root.ai-apply(); }
                        dismiss => { root.ai-panel-open = false; root.ai-dismiss(); }
                    }
                }

                // ── Formatting toolbar (only when note selected) ──
                if root.selected-index >= 0 : Rectangle {
                    height: Theme.h-prominent;
                    background: Theme.bg-surface;

                    // Bottom divider
                    Rectangle {
                        y: parent.height - 1px;
                        width: 100%;
                        height: 1px;
                        background: Theme.separator;
                    }

                    HorizontalLayout {
                        padding-left: Theme.sp-2;
                        padding-right: Theme.sp-2;
                        spacing: 2px;
                        alignment: start;

                        // Bold
                        TouchArea {
                            width: 30px; height: 28px;
                            clicked => { root.insert-format("bold"); }
                            Rectangle {
                                width: 30px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Text {
                                    text: "B";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Italic
                        TouchArea {
                            width: 30px; height: 28px;
                            clicked => { root.insert-format("italic"); }
                            Rectangle {
                                width: 30px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Text {
                                    text: "I";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    font-weight: 400;
                                    font-italic: true;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Heading
                        TouchArea {
                            width: 30px; height: 28px;
                            clicked => { root.insert-format("heading"); }
                            Rectangle {
                                width: 30px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Text {
                                    text: "#";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Separator
                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: 5px;
                            background: Theme.separator;
                        }

                        // Bullet list
                        TouchArea {
                            width: 30px; height: 28px;
                            clicked => { root.insert-format("bullet"); }
                            Rectangle {
                                width: 30px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Icon {
                                    commands: Icons.list;
                                    size: 14px; tint: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // Checklist
                        TouchArea {
                            width: 30px; height: 28px;
                            clicked => { root.insert-format("checklist"); }
                            Rectangle {
                                width: 30px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Icon {
                                    commands: Icons.checkbox;
                                    size: 14px; tint: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // Separator
                        Rectangle {
                            width: 1px;
                            height: 18px;
                            y: 5px;
                            background: Theme.separator;
                        }

                        // Code block
                        TouchArea {
                            width: 36px; height: 28px;
                            clicked => { root.insert-format("code"); }
                            Rectangle {
                                width: 36px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Icon {
                                    commands: Icons.code;
                                    size: 14px; tint: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }

                        // Divider
                        TouchArea {
                            width: 30px; height: 28px;
                            clicked => { root.insert-format("divider"); }
                            Rectangle {
                                width: 30px; height: 28px;
                                border-radius: 4px;
                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                Icon {
                                    commands: Icons.divider;
                                    size: 14px; tint: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }

                // Separator below toolbar
                if root.selected-index >= 0 : Rectangle { height: 1px; background: Theme.separator; }

                // ── Tags row (below toolbar, above editor) ──
                if root.selected-index >= 0 : Rectangle {
                    height: 32px;
                    background: Theme.bg-deep;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 6px;
                        alignment: start;

                        Icon {
                            commands: Icons.tag;
                            size: 13px;
                            tint: Theme.text-dim;
                            y: (parent.height - self.height) / 2;
                        }

                        tags-edit := TextInput {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            single-line: true;
                            font-size: Theme.fs-caption;
                            color: Theme.text-secondary;
                            text <=> root.current-tags;
                            edited => { root.update-tags(self.text); }
                        }
                    }

                    if root.current-tags == "" : Text {
                        x: 12px + 13px + 6px;
                        height: 100%;
                        text: "Add tags, comma separated";
                        color: Theme.text-dim;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                    }
                }

                // Separator
                if root.selected-index >= 0 : Rectangle { height: 1px; background: Theme.separator; }

                // ── Editor + Backlinks ──
                VerticalLayout {
                    horizontal-stretch: 1;
                    vertical-stretch: 1;

                    // ── Editor ──
                    Rectangle {
                        horizontal-stretch: 1;
                        vertical-stretch: 1;
                        background: Theme.bg-deep;

                        if root.selected-index >= 0 : Flickable {
                            width: 100%; height: 100%;
                            viewport-width: self.width;
                            viewport-height: max(self.height, body-input.y + body-input.preferred-height + 48px);

                            page-title := Text {
                                x: max(28px, (parent.width - 740px) / 2);
                                y: 36px; width: parent.width - self.x * 2;
                                text: root.current-title; font-family: Theme.font-ui;
                                font-size: 28px; font-weight: 600; color: Theme.text-primary;
                                overflow: elide;
                            }
                            Text {
                                x: page-title.x; y: 76px; width: page-title.width;
                                text: root.is-modified ? "Unsaved changes" : "Markdown note";
                                font-size: 12px; color: Theme.text-dim;
                            }
                            if root.current-content == "" : Text {
                                x: page-title.x; y: 116px; width: page-title.width;
                                text: "Start writing. Link another note with [[note title]].";
                                color: Theme.text-dim; font-size: 16px; wrap: word-wrap;
                            }
                            body-input := TextInput {
                                x: page-title.x; y: 116px; width: page-title.width;
                                text <=> root.current-content;
                                color: Theme.text-primary; font-family: Theme.font-ui;
                                font-size: 16px; single-line: false; wrap: word-wrap;
                                selection-foreground-color: Theme.text-on-accent;
                                selection-background-color: Theme.accent;
                                edited => { root.content-changed(self.text); }
                            }
                        }

                        // Empty state when no note selected
                        if root.selected-index < 0 : YEmptyState {
                            icon-path: Icons.pencil;
                            title: "No note open";
                            description: "Pick one from the list, or start a new note.";
                            action-label: "New note";
                            action-clicked => { root.new-note(); }
                        }
                    }

                    // ── Backlinks panel (toggle) ──
                    if root.backlinks-panel-open && root.selected-index >= 0 : Rectangle {
                        height: 176px;
                        background: Theme.border-subtle;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            padding: 10px;
                            spacing: 6px;

                            HorizontalLayout {
                                spacing: 6px;
                                Icon { commands: Icons.link; size: 13px; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                                Text {
                                    text: "Links";
                                    color: Theme.accent;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }

                                // Find backlinks button
                                TouchArea {
                                    width: 60px;
                                    height: 22px;
                                    clicked => { root.find-backlinks(); }
                                    Rectangle {
                                        width: 60px; height: 22px;
                                        border-radius: 11px;
                                        background: parent.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                                        border-width: 1px;
                                        border-color: Theme.border-subtle;
                                        Text {
                                            text: "Scan";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-micro;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Close button
                                TouchArea {
                                    width: 22px;
                                    height: 22px;
                                    clicked => { root.backlinks-panel-open = false; }
                                    Rectangle {
                                        width: 22px; height: 22px;
                                        border-radius: 11px;
                                        background: parent.has-hover ? Theme.hover-fill : transparent;
                                        Icon { commands: Icons.close; size: 11px; tint: Theme.text-dim; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                                    }
                                }
                            }

                            // Links, both directions
                            Flickable {
                                vertical-stretch: 1;
                                viewport-height: links-layout.preferred-height;

                                links-layout := VerticalLayout {
                                    alignment: start;
                                    spacing: 2px;

                                    if root.outbound-links.length == 0 && root.backlinks.length == 0 : Text {
                                        text: "No links yet. Click Scan.";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }

                                    if root.outbound-links.length > 0 : Text {
                                        text: "LINKS OUT";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-weight: Theme.fw-micro;
                                        letter-spacing: 1px;
                                        height: 18px;
                                        vertical-alignment: center;
                                    }

                                    for ol[oidx] in root.outbound-links : TouchArea {
                                        height: 24px;
                                        mouse-cursor: ol.filename != "" ? pointer : default;
                                        clicked => {
                                            if (ol.filename != "") { root.open-note(ol.filename); }
                                        }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: parent.has-hover && ol.filename != "" ? Theme.hover-fill : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                padding-right: 8px;
                                                spacing: 6px;
                                                Icon {
                                                    commands: ol.filename != "" ? Icons.doc : Icons.plus;
                                                    size: 12px;
                                                    tint: ol.filename != "" ? AppIdentity.accent : Theme.text-dim;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                Text {
                                                    text: ol.title;
                                                    color: ol.filename != "" ? AppIdentity.accent : Theme.text-dim;
                                                    font-size: Theme.fs-micro;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                    horizontal-stretch: 1;
                                                }
                                                // A link with nothing behind it yet is the useful
                                                // half of the graph: it is what was promised.
                                                if ol.filename == "" : Text {
                                                    text: "not written yet";
                                                    color: Theme.text-dim.transparentize(25%);
                                                    font-size: Theme.fs-micro;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }

                                    if root.backlinks.length > 0 : Text {
                                        text: "LINKS IN";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-weight: Theme.fw-micro;
                                        letter-spacing: 1px;
                                        height: 18px;
                                        vertical-alignment: center;
                                    }

                                    for bl[idx] in root.backlinks : TouchArea {
                                        height: 24px;
                                        mouse-cursor: pointer;
                                        clicked => { root.open-note(bl.filename); }
                                        Rectangle {
                                            height: 24px;
                                            border-radius: 4px;
                                            background: parent.has-hover ? Theme.hover-fill : transparent;
                                            HorizontalLayout {
                                                padding-left: 8px;
                                                spacing: 6px;
                                                Icon {
                                                    commands: Icons.reply;
                                                    size: 12px;
                                                    tint: Theme.accent;
                                                    y: (parent.height - self.height) / 2;
                                                }
                                                Text {
                                                    text: bl.title;
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-micro;
                                                    font-weight: 500;
                                                    vertical-alignment: center;
                                                    overflow: elide;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── Images panel (toggle) ──
                    if root.images-panel-open && root.selected-index >= 0 : Rectangle {
                        height: 208px;
                        background: Theme.bg-surface;

                        Rectangle { y: 0; height: 1px; width: 100%; background: Theme.separator; }

                        VerticalLayout {
                            padding: 10px;
                            spacing: 8px;

                            // Header: count, a path to attach, rescan, close
                            HorizontalLayout {
                                spacing: 8px;

                                Icon {
                                    commands: Icons.image;
                                    size: 13px;
                                    tint: Theme.accent;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Images";
                                    color: Theme.accent;
                                    font-size: Theme.fs-caption;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                                if root.note-images.length > 0 : Text {
                                    text: root.note-images.length;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-family: Theme.font-mono;
                                    vertical-alignment: center;
                                }

                                Rectangle { horizontal-stretch: 1; }

                                // There is no file picker in this app yet, so a path is typed or
                                // pasted — the same way the music player takes a library folder.
                                Rectangle {
                                    width: 300px;
                                    height: 26px;
                                    y: (parent.height - 26px) / 2;
                                    border-radius: Theme.r-sm;
                                    background: Theme.bg-input;
                                    border-width: 1px;
                                    border-color: attach-input.has-focus ? Theme.accent-dim : Theme.border-default;
                                    clip: true;

                                    if root.attach-image-path == "" : Text {
                                        x: 8px;
                                        height: 100%;
                                        text: "/path/to/picture.png";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                    }

                                    attach-input := TextInput {
                                        x: 8px;
                                        width: parent.width - 16px;
                                        height: 100%;
                                        vertical-alignment: center;
                                        single-line: true;
                                        font-size: Theme.fs-micro;
                                        font-family: Theme.font-mono;
                                        color: Theme.text-primary;
                                        text <=> root.attach-image-path;
                                        accepted => {
                                            root.attach-image(self.text);
                                            root.attach-image-path = "";
                                        }
                                    }
                                }

                                YButton {
                                    label: "Attach";
                                    icon-path: Icons.plus;
                                    variant: 1;
                                    size: 0;
                                    disabled: root.attach-image-path == "";
                                    y: (parent.height - self.height) / 2;
                                    clicked => {
                                        root.attach-image(root.attach-image-path);
                                        root.attach-image-path = "";
                                    }
                                }
                                YIconButton {
                                    icon-path: Icons.refresh;
                                    variant: 1;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.scan-images(); }
                                }
                                YIconButton {
                                    icon-path: Icons.close;
                                    variant: 1;
                                    y: (parent.height - self.height) / 2;
                                    clicked => { root.images-panel-open = false; }
                                }
                            }

                            // Preview + the list of what this note embeds
                            if root.note-images.length > 0 : HorizontalLayout {
                                spacing: 10px;

                                Rectangle {
                                    width: 260px;
                                    border-radius: Theme.r-md;
                                    background: Theme.bg-deep;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    clip: true;

                                    if root.note-images.length > root.image-preview-index : Image {
                                        source: root.note-images[root.image-preview-index].source;
                                        image-fit: contain;
                                        x: 4px;
                                        y: 4px;
                                        width: parent.width - 8px;
                                        height: parent.height - 8px;
                                    }
                                }

                                Flickable {
                                    horizontal-stretch: 1;
                                    viewport-height: image-strip.preferred-height;

                                    image-strip := VerticalLayout {
                                        alignment: start;
                                        spacing: 3px;

                                        for img[idx] in root.note-images : TouchArea {
                                            height: 36px;
                                            mouse-cursor: pointer;
                                            clicked => { root.image-preview-index = idx; }

                                            Rectangle {
                                                border-radius: Theme.r-sm;
                                                background: idx == root.image-preview-index ? AppIdentity.tint
                                                          : parent.has-hover ? Theme.hover-fill : transparent;

                                                HorizontalLayout {
                                                    padding-left: 5px;
                                                    padding-right: 8px;
                                                    spacing: 8px;

                                                    Rectangle {
                                                        width: 44px;
                                                        height: 28px;
                                                        y: (parent.height - 28px) / 2;
                                                        border-radius: 3px;
                                                        background: Theme.bg-deep;
                                                        clip: true;

                                                        if img.found : Image {
                                                            source: img.source;
                                                            image-fit: contain;
                                                            width: 100%;
                                                            height: 100%;
                                                        }
                                                        if !img.found : Icon {
                                                            commands: Icons.warning;
                                                            size: 13px;
                                                            tint: Theme.color-danger;
                                                            x: (parent.width - self.width) / 2;
                                                            y: (parent.height - self.height) / 2;
                                                        }
                                                    }

                                                    Text {
                                                        text: img.name;
                                                        color: idx == root.image-preview-index ? AppIdentity.accent : Theme.text-primary;
                                                        font-size: Theme.fs-micro;
                                                        vertical-alignment: center;
                                                        horizontal-stretch: 1;
                                                        overflow: elide;
                                                    }

                                                    if !img.found : Text {
                                                        text: "missing";
                                                        color: Theme.color-danger;
                                                        font-size: Theme.fs-micro;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            if root.note-images.length == 0 : VerticalLayout {
                                alignment: center;
                                spacing: 4px;

                                Text {
                                    text: "No images in this note";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Attach a file, or write ![[picture.png]] in the body.";
                                    color: Theme.text-dim.transparentize(30%);
                                    font-size: Theme.fs-micro;
                                    horizontal-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Status bar with metadata ──
                if root.selected-index >= 0 : Rectangle {
                    height: 24px;
                    background: Theme.bg-surface;
                    Rectangle { y: 0; height: 1px; width: 100%; background: Theme.separator; }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        alignment: start;

                        // Created date
                        if root.meta-created != "" && root.width >= 1180px : Text {
                            text: "Created: \{root.meta-created}";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            vertical-alignment: center;
                        }

                        // Modified date
                        if root.meta-modified != "" && root.width >= 1000px : Text {
                            text: "Modified: \{root.meta-modified}";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            vertical-alignment: center;
                        }

                        Rectangle { horizontal-stretch: 1; }

                        // Images toggle
                        TouchArea {
                            width: 62px;
                            height: 18px;
                            mouse-cursor: pointer;
                            clicked => {
                                root.images-panel-open = !root.images-panel-open;
                                if (root.images-panel-open) { root.scan-images(); }
                            }
                            HorizontalLayout {
                                spacing: 4px;
                                Icon {
                                    commands: Icons.image;
                                    size: 11px;
                                    tint: root.images-panel-open ? AppIdentity.accent : Theme.text-dim;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Images";
                                    color: root.images-panel-open ? AppIdentity.accent : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-weight: root.images-panel-open ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Backlinks toggle
                        TouchArea {
                            width: 76px;
                            height: 18px;
                            mouse-cursor: pointer;
                            clicked => { root.backlinks-panel-open = !root.backlinks-panel-open; }
                            HorizontalLayout {
                                spacing: 4px;
                                Icon {
                                    commands: Icons.link;
                                    size: 11px;
                                    tint: root.backlinks-panel-open ? AppIdentity.accent : Theme.text-dim;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Links";
                                    color: root.backlinks-panel-open ? AppIdentity.accent : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-weight: root.backlinks-panel-open ? 600 : 400;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Word count
                        Text {
                            text: root.meta-word-count == 1
                                ? "1 word"
                                : "\{root.meta-word-count} words";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ── Version history panel (right side, toggled) ──
            if root.version-panel-open && root.selected-index >= 0 : Rectangle {
                width: 220px;
                background: Theme.border-subtle;
                border-width: 1px;
                border-color: Theme.border-subtle;

                VerticalLayout {
                    padding: 10px;
                    spacing: 8px;

                    // Header
                    HorizontalLayout {
                        spacing: 6px;
                        Icon { commands: Icons.history; size: 13px; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                        Text {
                            text: "Versions";
                            color: Theme.accent;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TouchArea {
                            width: 22px;
                            height: 22px;
                            clicked => { root.version-panel-open = false; }
                            Rectangle {
                                width: 22px; height: 22px;
                                border-radius: 11px;
                                background: parent.has-hover ? Theme.hover-fill : transparent;
                                Icon { commands: Icons.close; size: 11px; tint: Theme.text-dim; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
                            }
                        }
                    }

                    // Version list
                    Flickable {
                        vertical-stretch: 1;
                        viewport-height: version-list-layout.preferred-height;

                        version-list-layout := VerticalLayout {
                            alignment: start;
                            spacing: 4px;

                            if root.version-history.length == 0 : Text {
                                text: "No versions yet.\nVersions are created on save.";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                wrap: word-wrap;
                            }

                            for ver[idx] in root.version-history : Rectangle {
                                height: 56px;
                                border-radius: 8px;
                                background: Theme.border-subtle;
                                border-width: 1px;
                                border-color: Theme.border-subtle;

                                VerticalLayout {
                                    padding: 6px;
                                    padding-left: 8px;
                                    padding-right: 8px;
                                    spacing: 4px;

                                    Text {
                                        text: ver.label;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-micro;
                                        font-weight: 500;
                                        overflow: elide;
                                    }

                                    Text {
                                        text: ver.timestamp;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: end;

                                        TouchArea {
                                            width: 36px;
                                            height: 18px;
                                            clicked => { root.view-version(ver.index); }
                                            Rectangle {
                                                width: 36px; height: 18px;
                                                border-radius: 9px;
                                                background: parent.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                                                Text {
                                                    text: "View";
                                                    color: Theme.accent;
                                                    font-size: Theme.fs-micro;
                                                    font-weight: 500;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }

                                        TouchArea {
                                            width: 52px;
                                            height: 18px;
                                            clicked => { root.restore-version(ver.index); }
                                            Rectangle {
                                                width: 52px; height: 18px;
                                                border-radius: 9px;
                                                background: parent.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                                                Text {
                                                    text: "Restore";
                                                    color: Theme.amber;
                                                    font-size: Theme.fs-micro;
                                                    font-weight: 500;
                                                    horizontal-alignment: center;
                                                    vertical-alignment: center;
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ── What Yantrik knows about this note ──
            //
            // Collapses to nothing when there is nothing true to say, which on a fresh machine
            // with no notes and no shell is most of the time.
            if root.assistant-visible : AgentRail {
                context-items: root.agent-context;
                suggestions: root.agent-suggestions;
                unavailable: root.agent-unavailable;
                context-activated(id) => { root.agent-context-activated(id); }
                suggestion-activated(id) => { root.agent-suggestion-activated(id); }
            }
        }
    }
    }
}
