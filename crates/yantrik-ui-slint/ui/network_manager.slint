// Network Manager — how this machine is connected, and changing it.
//
// Three sections: Wi-Fi, Ethernet, Firewall. There were six, and 2506 lines of this file were
// driven by 235 of Rust. Bluetooth, VPN and Diagnostics drew panes for eighteen callbacks whose
// whole bodies were `tracing::info!`, and the Firewall pane drew a toggle, three profile buttons
// and an allow/block port box over four more. They are gone; what is left is backed by
// services/network-service and by nmcli underneath it, and every reading on this screen is set
// from Rust. design/network-2026-09-20.md is the account of what was wrong.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposalCard, AgentProposal } from "components/agent_proposal.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";
import { YButton } from "components/y_button.slint";

// ── Data structs ──

export struct WifiNetwork {
    ssid: string,
    signal: int,          // 0-100
    security: string,     // "WPA2", "WPA3", "Open", etc.
    is-connected: bool,
    is-saved: bool,
}

export struct EthernetInterface {
    name: string,         // "eth0", "enp0s3"
    status: string,       // "UP", "DOWN"
    ip-address: string,
    mac-address: string,
    speed: string,        // "1000Mbps"
    is-dhcp: bool,
    subnet: string,
    gateway: string,
    dns: string,
}

// BluetoothDevice, VpnConnection, DiagTestResult, ConnectionEvent and NetAIProviderStatus stood
// here. Nothing ever filled any of them: their five, three and five handlers were `tracing::info!`
// and nothing else, and a row type with no producer is a promise the screen keeps making on the
// app's behalf. They are gone with the panes that drew them.

export struct FirewallRule {
    // The firewall's own words for the rule, not ours. A person comparing this pane against
    // `nft list ruleset` has to see the same text; rewording it would make the screen a second,
    // less reliable account of the machine.
    description: string,  // "tcp dport 22 accept"
    chain: string,        // "input", "forward", "ufw"
    action: string,       // "accept", "drop", "reject", "unknown"
}

// ── Signal bar component ──

component SignalBars inherits HorizontalLayout {
    in property <int> strength;  // 0-100
    spacing: 2px;

    // Bar 1 (always lit if signal > 0)
    Rectangle {
        width: 4px;
        height: 8px;
        border-radius: 1px;
        background: strength > 0 ? AppIdentity.accent : Theme.text-dim;
        vertical-stretch: 0;
    }
    Rectangle {
        width: 4px;
        height: 12px;
        border-radius: 1px;
        background: strength > 25 ? AppIdentity.accent : Theme.text-dim;
        vertical-stretch: 0;
    }
    Rectangle {
        width: 4px;
        height: 16px;
        border-radius: 1px;
        background: strength > 50 ? AppIdentity.accent : Theme.text-dim;
        vertical-stretch: 0;
    }
    Rectangle {
        width: 4px;
        height: 20px;
        border-radius: 1px;
        background: strength > 75 ? AppIdentity.accent : Theme.text-dim;
        vertical-stretch: 0;
    }
}

// ── Toggle Switch component ──

component ToggleSwitch inherits TouchArea {
    in-out property <bool> checked;
    in property <string> label;
    width: 100%;
    height: 40px;

    callback toggled();

    clicked => {
        checked = !checked;
        root.toggled();
    }

    HorizontalLayout {
        spacing: Theme.sp-3;
        alignment: space-between;
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;

        Text {
            text: label;
            color: Theme.text-primary;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }

        // Track
        Rectangle {
            width: 44px;
            height: 24px;
            border-radius: Theme.r-lg;
            background: checked ? AppIdentity.accent : Theme.bg-elevated;
            border-width: 1px;
            border-color: checked ? Theme.accent-dim : Theme.text-dim;

            // Knob
            Rectangle {
                x: checked ? parent.width - self.width - 3px : 3px;
                y: 3px;
                width: 18px;
                height: 18px;
                border-radius: 9px;
                background: Theme.text-primary;
                animate x { duration: Theme.dur-fast; easing: ease-in-out; }
            }
        }
    }
}
// Buttons are the kit's YButton. This screen drew its own, and its primary wore the app's
// cyan identity rather than the accent every primary is (colour system).

// ── Main component ──

export component NetworkManager inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar when
    // the screen fills an app window; the shell's copy leaves it off.
    in property <bool> window-bar: false;
    // ── The agent layer ──
    //
    // Filled from what this app and the companion actually hold; every row says where it came
    // from, and a section with nothing true to say does not draw. See agent_rail.slint.
    in property <[AgentContextItem]> agent-context: [];
    in property <[AgentSuggestion]> agent-suggestions: [];
    in property <string> agent-unavailable: "";
    callback agent-context-activated(string);
    callback agent-suggestion-activated(string);
    in property <AgentProposal> proposal;
    in property <bool> proposal-working: false;
    callback proposal-applied();
    callback proposal-dismissed();

    background: Theme.bg-deep;

    // Active tab: 0=Wi-Fi, 1=Ethernet, 2=Firewall.
    //
    // There were six. Bluetooth, VPN and Diagnostics are gone, with their eighteen handlers:
    // every one of them logged a line and returned, and a screen that draws a pairing list
    // nothing can pair is worse than a screen that does not offer to. See
    // design/network-2026-09-20.md for what each would need to come back.
    in-out property <int> active-tab: 0;

    // ── What went wrong on the last thing this app was asked to do ──
    //
    // Empty when nothing is wrong. Rendered as a strip under the header, and carried in the
    // app's `describe` as `notice`, so a person and a mind read the same failure. Three of this
    // app's five Wi-Fi calls used to go into a `let _ =` and there was nowhere for a failure to
    // be said even if one had been noticed.
    in property <string> notice: "";

    // ── Wi-Fi state ──
    //
    // `wifi-enabled` stood here as `in property <bool>` that Rust never wrote, so the window drew
    // "Wi-Fi: Off" on a machine that has no Wi-Fi adapter in it. Three properties in its place,
    // because there are three answers and a bool holds two: is there an adapter at all, what is
    // the radio doing, and — when the answer is thin — why.
    in property <bool> wifi-adapter-present: false;
    // "on", "off", "unknown". Never blank: unknown is a value, not an absence.
    in property <string> wifi-radio: "unknown";
    in property <string> wifi-state-reason: "";
    in property <string> wifi-current-ssid: "";
    in property <int> wifi-signal-strength: 0;
    in property <string> wifi-ip-address: "";
    in property <string> wifi-speed: "";
    in property <[WifiNetwork]> wifi-networks: [];
    in property <[WifiNetwork]> wifi-saved-networks: [];
    in property <bool> wifi-scanning: false;

    // WiFi password dialog
    in-out property <bool> wifi-password-visible: false;
    in-out property <string> wifi-password-ssid: "";
    in-out property <string> wifi-password-input: "";
    in property <string> wifi-connect-status: "";

    // Ethernet state
    in property <[EthernetInterface]> ethernet-interfaces: [];

    // ── Firewall state ──
    //
    // `firewall-enabled: false` was the other unset `in` property, drawn as
    // `firewall-enabled ? "{rule-count} rules" : "Off"` in warning colour — and an audit of this
    // OS recorded "Firewall: Off" as a security finding about a machine nothing had looked at.
    // A word rather than a bool, because "no firewall tool is installed", "it is installed and
    // not filtering" and "I was not allowed to read the ruleset" are three different statements
    // and only the middle one is "off".
    //
    // "active", "inactive", "absent", "unknown".
    in property <string> firewall-state: "unknown";
    in property <string> firewall-backend-name: "";
    // -1 when the count is not known, which includes an active firewall whose ruleset could not
    // be read. Zero is a count that was taken.
    in property <int> firewall-rule-count: -1;
    in property <[FirewallRule]> firewall-rules: [];
    in property <string> firewall-reason: "";

    // WiFi connection details (expandable section)
    in property <string> wifi-gateway: "";
    in property <string> wifi-dns: "";
    in property <string> wifi-subnet: "";
    in-out property <bool> wifi-details-expanded: false;

    // Status bar (shown on all tabs)
    in property <string> status-connection-type: "";   // "WiFi", "Ethernet", ""
    in property <string> status-ip-address: "";
    in property <int> status-signal-strength: 0;        // 0-100, for WiFi
    in property <string> status-state: "disconnected";  // "connected", "disconnected", "connecting"

    // ── Callbacks ──
    //
    // Five, and each has one path behind it in apps/network-manager/src/main.rs that the control
    // surface action of the same name also takes. `toggle-wifi` became `wifi-radio-set(bool)`:
    // the toggle computed `!wifi-enabled` from a property nothing wrote, so it asked to turn on
    // a radio that was already on as often as not.
    callback wifi-radio-set(bool);
    callback wifi-scan();
    callback wifi-connect(string, string);  // ssid, password
    callback wifi-disconnect();
    callback wifi-forget(string);           // ssid

    // AI Assist
    in property <bool> ai-is-working: false;
    in property <string> ai-response: "";
    in-out property <bool> ai-panel-open: false;
    callback ai-explain-pressed();
    callback ai-dismiss();

    // Built in steps rather than as one expression, and not for taste: Slint's generated Rust
    // MOVES a string property's value into the first branch that reads it, so an expression
    // naming `status-connection-type` three times fails to compile with "borrow of moved
    // value". Each of these reads any one string exactly once.
    property <bool> conn-is-wifi: root.status-connection-type == "WiFi";
    property <string> conn-name: root.conn-is-wifi && root.wifi-current-ssid != ""
                                 ? root.wifi-current-ssid : root.status-connection-type;
    property <string> conn-detail: root.status-ip-address != "" ? root.status-ip-address : "";
    property <string> conn-summary: root.status-state == "connecting" ? "Connecting"
                                  : root.status-state != "connected" ? "Not connected"
                                  : root.conn-detail != "" ? root.conn-name + "  -  " + root.conn-detail
                                  : root.conn-name;

    VerticalLayout {
        spacing: 0px;
        // -- Header --
        //
        // The bar that stood here existed to answer one question on every section: what is this
        // machine actually using right now. That answer keeps its place -- it is the subtitle,
        // the line directly under the app name -- and the app gets the same top edge as the
        // other fifteen instead of a 56px status panel unique to itself.
        AppHeader {
            window-bar: root.window-bar;
            app-id: "network";
            icon: root.status-connection-type == "Ethernet" ? Icons.network : Icons.wifi;
            title: "Network";
            subtitle: root.conn-summary;
            actions: [
                { id: "ai", icon: Icons.spark, label: root.ai-is-working ? "Working" : "Explain",
                  emphasis: 1, loading: root.ai-is-working, active: root.ai-panel-open },
            ];
            action(id) => {
                if (id == "ai") {
                    if (root.ai-panel-open) { root.ai-dismiss(); root.ai-panel-open = false; }
                    else { root.ai-explain-pressed(); root.ai-panel-open = true; }
                }
            }
        }

        // ── What went wrong, said where the person is looking ──
        //
        // Contract point 4: a failure is said twice, here for the person and in `describe.notice`
        // for the mind. Nothing on this screen had anywhere to report a failure before — the
        // radio toggle logged that it had toggled and returned, whatever the service said.
        if root.notice != "" : Rectangle {
            height: net-notice-text.preferred-height + 16px;
            background: Theme.color-danger-dim;
            border-width: 1px;
            border-color: Theme.color-danger.transparentize(60%);

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;
                padding-top: Theme.sp-2;
                padding-bottom: Theme.sp-2;
                spacing: Theme.sp-2;

                Icon {
                    commands: Icons.close;
                    size: 12px;
                    tint: Theme.color-danger;
                    y: (parent.height - self.height) / 2;
                }
                net-notice-text := Text {
                    text: root.notice;
                    color: Theme.color-danger;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                }
            }
        }

        // ── AI Response Panel ──
        if root.ai-panel-open && root.ai-response != "" : Rectangle {
            height: min(160px, ai-net-resp.preferred-height + 16px);
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.accent.transparentize(70%);

            Flickable {
                viewport-height: ai-net-resp.preferred-height + 16px;

                ai-net-resp := VerticalLayout {
                    alignment: start;
                    padding: Theme.sp-3;
                    spacing: Theme.sp-2;

                    HorizontalLayout {
                        spacing: Theme.sp-2;
                        Icon {
                            commands: Icons.spark;
                            size: 12px;
                            tint: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "AI Analysis";
                            color: Theme.accent;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TouchArea {
                            width: 24px;
                            height: 24px;
                            clicked => {
                                root.ai-panel-open = false;
                                root.ai-dismiss();
                            }
                            Rectangle {
                                width: 24px; height: 24px;
                                border-radius: Theme.r-lg;
                                background: parent.has-hover ? Theme.hover-fill : transparent;
                                Icon {
                                    commands: Icons.close;
                                    size: 12px;
                                    tint: Theme.text-dim;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.ai-response;
                        color: Theme.text-primary;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ══════════════ Rail + section ══════════════
        // ── What the companion is proposing ──
        if root.proposal.title != "" : AgentProposalCard {
            data: root.proposal;
            working: root.proposal-working;
            apply => { root.proposal-applied(); }
            dismiss => { root.proposal-dismissed(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // ─── Section rail ───
            Rectangle {
                width: 208px;
                background: Theme.bg-surface;

                Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.separator; }

                VerticalLayout {
                    padding: Theme.sp-2;
                    padding-top: Theme.sp-3;
                    spacing: 2px;
                    alignment: start;

                    // Wi-Fi — the SSID is the state
                    Rectangle {
                        property <bool> active: root.active-tab == 0;
                        height: 46px;
                        border-radius: Theme.r-sm;
                        background: active ? AppIdentity.tint : ta0.has-hover ? Theme.hover-fill : transparent;

                        if active : Rectangle {
                            x: 0; width: 3px; height: 22px;
                            y: (parent.height - 22px) / 2;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        ta0 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active-tab = 0; }
                        }

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: 10px;

                            Icon {
                                commands: Icons.wifi;
                                size: 16px;
                                tint: active ? AppIdentity.accent : Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "Wi-Fi";
                                    color: active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-label;
                                    font-weight: active ? 500 : Theme.fw-body;
                                    overflow: elide;
                                }
                                Text {
                                    // The rail carries live state: the point of the app is to see
                                    // all three at once, not one per tab.
                                    //
                                    // "No adapter" leads, because it is the answer that stops
                                    // every other line here from meaning anything — and it is the
                                    // one this rail used to render as "Off".
                                    text: !root.wifi-adapter-present ? "No adapter"
                                        : root.wifi-radio == "unknown" ? "Unknown"
                                        : root.wifi-radio == "off" ? "Radio off"
                                        : root.wifi-current-ssid != "" ? root.wifi-current-ssid
                                        : root.wifi-scanning ? "Scanning\{"\u{2026}"}" : "Not connected";
                                    color: root.wifi-current-ssid != "" ? Theme.color-success : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    // Ethernet — link speed or nothing plugged in
                    Rectangle {
                        property <bool> active: root.active-tab == 1;
                        height: 46px;
                        border-radius: Theme.r-sm;
                        background: active ? AppIdentity.tint : ta1.has-hover ? Theme.hover-fill : transparent;

                        if active : Rectangle {
                            x: 0; width: 3px; height: 22px;
                            y: (parent.height - 22px) / 2;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        ta1 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active-tab = 1; }
                        }

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: 10px;

                            Icon {
                                commands: Icons.network;
                                size: 16px;
                                tint: active ? AppIdentity.accent : Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "Ethernet";
                                    color: active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-label;
                                    font-weight: active ? 500 : Theme.fw-body;
                                    overflow: elide;
                                }
                                Text {
                                    // The rail carries live state: the point of the app is to see
                                    // all six at once, not one per tab.
                                    text: root.ethernet-interfaces.length == 0 ? "No interface" : root.ethernet-interfaces[0].status == "UP" ? root.ethernet-interfaces[0].speed : "Down";
                                    color: root.ethernet-interfaces.length > 0 && root.ethernet-interfaces[0].status == "UP" ? Theme.color-success : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                }
                            }
                        }
                    }
                    // Firewall — a security fact, so say what was actually read
                    Rectangle {
                        property <bool> active: root.active-tab == 2;
                        height: 46px;
                        border-radius: Theme.r-sm;
                        background: active ? AppIdentity.tint : ta2.has-hover ? Theme.hover-fill : transparent;

                        if active : Rectangle {
                            x: 0; width: 3px; height: 22px;
                            y: (parent.height - 22px) / 2;
                            border-radius: 1.5px;
                            background: Theme.accent;
                        }

                        ta2 := TouchArea {
                            mouse-cursor: pointer;
                            clicked => { root.active-tab = 2; }
                        }

                        HorizontalLayout {
                            padding-left: Theme.sp-3;
                            padding-right: Theme.sp-3;
                            spacing: 10px;

                            Icon {
                                commands: Icons.shield;
                                size: 16px;
                                tint: active ? AppIdentity.accent : Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 1px;
                                horizontal-stretch: 1;

                                Text {
                                    text: "Firewall";
                                    color: active ? Theme.text-primary : Theme.text-secondary;
                                    font-size: Theme.font-label;
                                    font-weight: active ? 500 : Theme.fw-body;
                                    overflow: elide;
                                }
                                Text {
                                    // The rail carries live state: the point of the app is to see
                                    // all six at once, not one per tab.
                                    // This one line is the whole bug in miniature. It used to read
                                    // `firewall-enabled ? "{rule-count} rules" : "Off"` in warning
                                    // colour, from a default nothing had written, and an audit
                                    // copied "Firewall: Off" out of it as a security finding.
                                    text: root.firewall-state == "absent" ? "Not installed"
                                        : root.firewall-state == "unknown" ? "Unknown"
                                        : root.firewall-rule-count < 0 ? root.firewall-state
                                        : "\{root.firewall-rule-count} rules";
                                    color: root.firewall-state == "active" ? Theme.color-success
                                         : root.firewall-state == "inactive" ? Theme.color-warning
                                         : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                }
                            }
                        }
                    }

                }
            }

        // ── Tab content ──
        Rectangle {
            vertical-stretch: 1;
            clip: true;

            // ═════════════════════════════════════
            // TAB 0: WiFi
            // ═════════════════════════════════════
            if root.active-tab == 0 : Flickable {
                width: 100%;
                height: 100%;
                viewport-height: wifi-content.preferred-height + 40px;

                wifi-content := VerticalLayout {
                    alignment: start;
                    padding: Theme.sp-5;
                    spacing: Theme.sp-4;

                    // The radio switch, and only when there is a radio.
                    //
                    // The switch used to be drawn unconditionally, bound to a property Rust never
                    // wrote, and pressing it called `toggle-wifi` which sent `!wifi-enabled` — the
                    // negation of a default. On a machine with no Wi-Fi adapter it offered to
                    // turn on hardware that is not in the machine.
                    if root.wifi-adapter-present : Rectangle {
                        height: 56px;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        ToggleSwitch {
                            checked: root.wifi-radio == "on";
                            label: "Wi-Fi";
                            // `checked` has already flipped by the time this runs, so it holds
                            // the state being asked for. The app sends that state, not a flip:
                            // the callback is `wifi-radio-set(bool)` for exactly this reason.
                            toggled => { root.wifi-radio-set(self.checked); }
                        }
                    }

                    // No adapter. The one statement this screen most needed and never made.
                    if !root.wifi-adapter-present : Rectangle {
                        height: 150px;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.sp-2;

                            HorizontalLayout {
                                alignment: center;
                                Icon {
                                    commands: Icons.wifi;
                                    size: 26px;
                                    tint: Theme.text-dim.transparentize(30%);
                                }
                            }
                            Text {
                                text: "This machine has no Wi-Fi adapter";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-body;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Nothing here is switched off — there is no radio to switch. The Ethernet section has what this machine is using.";
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                horizontal-alignment: center;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // The adapter is there and its state could not be read. Said, rather than
                    // drawn as "off": those are different things and the second invites a press.
                    if root.wifi-adapter-present && root.wifi-radio == "unknown" : Rectangle {
                        height: wifi-unknown-layout.preferred-height + 24px;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.color-warning.transparentize(60%);

                        wifi-unknown-layout := VerticalLayout {
                            padding: Theme.sp-4;
                            spacing: Theme.sp-1;
                            Text {
                                text: "Wi-Fi state unknown";
                                color: Theme.color-warning;
                                font-size: Theme.fs-body;
                                font-weight: 600;
                            }
                            Text {
                                text: root.wifi-state-reason != "" ? root.wifi-state-reason : "the network service gave no reason";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                wrap: word-wrap;
                            }
                        }
                    }

                    // The radio is off, and that was read rather than assumed.
                    if root.wifi-adapter-present && root.wifi-radio == "off" : Rectangle {
                        height: 130px;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        VerticalLayout {
                            alignment: center;
                            spacing: Theme.sp-2;

                            HorizontalLayout {
                                alignment: center;
                                Icon {
                                    commands: Icons.wifi;
                                    size: 26px;
                                    tint: Theme.text-dim.transparentize(30%);
                                }
                            }
                            Text {
                                text: "The Wi-Fi radio is off";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-body;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Turn it on to scan for networks.";
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                horizontal-alignment: center;
                            }
                        }
                    }

                    // Current connection card
                    if root.wifi-current-ssid != "" : Rectangle {
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.accent-glow;
                        height: conn-layout.preferred-height + 24px;

                        conn-layout := VerticalLayout {
                            padding: Theme.sp-4;
                            spacing: Theme.sp-2;

                            HorizontalLayout {
                                spacing: Theme.sp-3;
                                alignment: space-between;

                                VerticalLayout {
                                    spacing: Theme.sp-1;
                                    Text {
                                        text: "Connected";
                                        color: Theme.accent;
                                        font-size: Theme.fs-caption;
                                        font-weight: 600;
                                        letter-spacing: 1px;
                                    }
                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Text {
                                            text: root.wifi-current-ssid;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-headline;
                                            font-weight: 600;
                                        }
                                        SignalBars {
                                            strength: root.wifi-signal-strength;
                                        }
                                    }
                                }

                                YButton {
                                    label: "Disconnect";
                                    // Secondary, not the destructive red: a network you leave
                                    // is one click from rejoining; nothing is lost.
                                    variant: 1;
                                    clicked => { root.wifi-disconnect(); }
                                }
                            }

                            // Details row
                            HorizontalLayout {
                                spacing: Theme.sp-6;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "IP Address"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: root.wifi-ip-address != "" ? root.wifi-ip-address : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Signal"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: root.wifi-signal-strength + "%"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Speed"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: root.wifi-speed != "" ? root.wifi-speed : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                            }
                        }
                    }

                    // Connection Details (expandable)
                    if root.wifi-current-ssid != "" : Rectangle {
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        height: wifi-details-inner.preferred-height + 16px;

                        wifi-details-inner := VerticalLayout {
                            padding: Theme.sp-3;
                            padding-left: Theme.sp-4;
                            padding-right: Theme.sp-4;
                            spacing: Theme.sp-2;

                            details-toggle := TouchArea {
                                height: 28px;
                                clicked => { root.wifi-details-expanded = !root.wifi-details-expanded; }

                                HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: Theme.sp-2;
                                        Icon {
                                            commands: root.wifi-details-expanded ? Icons.chevron-down : Icons.play;
                                            size: 12px;
                                            tint: Theme.text-dim;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: "Connection Details";
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            font-weight: 500;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            if root.wifi-details-expanded : VerticalLayout {
                                spacing: 10px;
                                // Row 1
                                HorizontalLayout {
                                    spacing: Theme.sp-7;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "IP Address"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                        Text { text: root.wifi-ip-address != "" ? root.wifi-ip-address : "\u{2014}"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Subnet Mask"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                        Text { text: root.wifi-subnet != "" ? root.wifi-subnet : "\u{2014}"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                    }
                                }
                                // Row 2
                                HorizontalLayout {
                                    spacing: Theme.sp-7;
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "Gateway"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                        Text { text: root.wifi-gateway != "" ? root.wifi-gateway : "\u{2014}"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                    }
                                    VerticalLayout {
                                        spacing: 2px;
                                        Text { text: "DNS"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                        Text { text: root.wifi-dns != "" ? root.wifi-dns : "\u{2014}"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                    }
                                }
                            }
                        }
                    }

                    // Available networks section
                    // Available networks — only when there is a radio and it is on. A Scan
                    // button on a machine with no adapter is a control that cannot work.
                    if root.wifi-adapter-present && root.wifi-radio == "on" : VerticalLayout {
                        spacing: Theme.sp-2;

                        HorizontalLayout {
                            spacing: Theme.sp-3;
                            alignment: space-between;

                            Text {
                                text: "Available Networks";
                                color: Theme.text-primary;
                                font-size: Theme.fs-headline;
                                font-weight: 600;
                                vertical-alignment: center;
                            }

                            HorizontalLayout {
                                spacing: Theme.sp-2;

                                if root.wifi-scanning : Text {
                                    text: "Scanning...";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                }

                                YButton {
                                    label: "Scan";
                                    variant: 0;
                                    clicked => { root.wifi-scan(); }
                                }
                            }
                        }

                        // Scanning and "found nothing" are different answers.
                        if root.wifi-networks.length == 0 : Rectangle {
                            height: 120px;
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            VerticalLayout {
                                alignment: center;
                                spacing: Theme.sp-1;

                                Text {
                                    text: root.wifi-scanning ? "Scanning\{"\u{2026}"}" : "No networks in range";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: root.wifi-scanning
                                        ? "This takes a few seconds."
                                        : "Press Scan to look again.";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        // Network list
                        for network[idx] in root.wifi-networks : net-ta := TouchArea {
                            height: 52px;

                            clicked => {
                                if network.is-connected {
                                    // Already connected — do nothing
                                } else if network.is-saved {
                                    // Saved network — connect without password
                                    root.wifi-connect(network.ssid, "");
                                } else {
                                    // Need password
                                    root.wifi-password-ssid = network.ssid;
                                    root.wifi-password-input = "";
                                    root.wifi-password-visible = true;
                                }
                            }

                            Rectangle {
                                background: network.is-connected ? AppIdentity.tint
                                          : net-ta.has-hover ? Theme.hover-fill
                                          : Theme.bg-card;
                                border-radius: Theme.r-lg;
                                border-width: 1px;
                                border-color: network.is-connected ? Theme.accent-dim : Theme.border-subtle;

                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    spacing: Theme.sp-3;
                                    alignment: space-between;

                                    HorizontalLayout {
                                        spacing: Theme.sp-3;

                                        SignalBars {
                                            strength: network.signal;
                                        }

                                        VerticalLayout {
                                            spacing: 2px;
                                            alignment: center;
                                            Text {
                                                text: network.ssid;
                                                color: Theme.text-primary;
                                                font-size: Theme.fs-body;
                                                font-weight: network.is-connected ? 600 : 400;
                                            }
                                            Text {
                                                text: network.is-connected ? "Connected" : network.security;
                                                color: network.is-connected ? AppIdentity.accent : Theme.text-dim;
                                                font-size: Theme.fs-caption;
                                            }
                                        }
                                    }

                                    if network.is-saved && !network.is-connected : Text {
                                        text: "Saved";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }

                    // Saved networks section
                    // Known networks — the saved list, which this machine has whether or not
                    // the radio is on. Only the Forget button needs the radio, and the service
                    // refuses the one network that is in use rather than cutting the link.
                    if root.wifi-adapter-present && root.wifi-saved-networks.length > 0 : VerticalLayout {
                        spacing: Theme.sp-2;

                        Text {
                            text: "Known Networks";
                            color: Theme.text-primary;
                            font-size: Theme.fs-headline;
                            font-weight: 600;
                        }

                        for saved[idx] in root.wifi-saved-networks : Rectangle {
                            height: 44px;
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: Theme.sp-4;
                                padding-right: Theme.sp-4;
                                alignment: space-between;

                                Text {
                                    text: saved.ssid;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                }

                                forget-ta := TouchArea {
                                    width: 70px;
                                    height: 100%;
                                    clicked => { root.wifi-forget(saved.ssid); }
                                    Text {
                                        text: "Forget";
                                        color: forget-ta.has-hover ? Theme.color-danger : Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ═════════════════════════════════════
            // TAB 1: Ethernet
            // ═════════════════════════════════════
            if root.active-tab == 1 : Flickable {
                width: 100%;
                height: 100%;
                viewport-height: eth-content.preferred-height + 40px;

                eth-content := VerticalLayout {
                    alignment: start;
                    padding: Theme.sp-5;
                    spacing: Theme.sp-4;

                    Text {
                        text: "Ethernet Interfaces";
                        color: Theme.text-primary;
                        font-size: Theme.fs-headline;
                        font-weight: 600;
                    }

                    if root.ethernet-interfaces.length == 0 : Rectangle {
                        height: 80px;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: Theme.border-subtle;
                        Text {
                            text: "No Ethernet interfaces detected";
                            color: Theme.text-dim;
                            font-size: Theme.fs-body;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    for iface[idx] in root.ethernet-interfaces : Rectangle {
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: iface.status == "UP" ? Theme.accent-dim : Theme.border-subtle;
                        height: eth-iface-layout.preferred-height + 24px;

                        eth-iface-layout := VerticalLayout {
                            padding: Theme.sp-4;
                            spacing: 10px;

                            // Header row
                            HorizontalLayout {
                                spacing: Theme.sp-3;
                                alignment: space-between;

                                HorizontalLayout {
                                    spacing: Theme.sp-2;
                                    Text {
                                        text: iface.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-headline;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                    Rectangle {
                                        width: eth-status-text.preferred-width + 16px;
                                        height: 22px;
                                        border-radius: 11px;
                                        background: iface.status == "UP" ? Theme.accent-glow : Theme.bg-elevated;
                                        eth-status-text := Text {
                                            text: iface.status;
                                            color: iface.status == "UP" ? AppIdentity.accent : Theme.text-dim;
                                            font-size: Theme.fs-caption;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                if iface.is-dhcp : Rectangle {
                                    width: 60px;
                                    height: 22px;
                                    border-radius: 11px;
                                    background: Theme.tint-accent;
                                    Text {
                                        text: "DHCP";
                                        color: Theme.accent;
                                        font-size: Theme.fs-caption;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Details grid
                            HorizontalLayout {
                                spacing: Theme.sp-7;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "IP Address"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: iface.ip-address != "" ? iface.ip-address : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "MAC"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: iface.mac-address != "" ? iface.mac-address : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Speed"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: iface.speed != "" ? iface.speed : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                            }

                            if iface.status == "UP" : HorizontalLayout {
                                spacing: Theme.sp-7;
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Subnet"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: iface.subnet != "" ? iface.subnet : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Gateway"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: iface.gateway != "" ? iface.gateway : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "DNS"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text { text: iface.dns != "" ? iface.dns : "—"; color: Theme.text-secondary; font-size: Theme.fs-body; }
                                }
                            }
                        }
                    }
                }
            }

            // ═════════════════════════════════════
            // TAB 2: Firewall
            // ═════════════════════════════════════
            if root.active-tab == 2 : Flickable {
                width: 100%;
                height: 100%;
                viewport-height: fw-content.preferred-height + 40px;

                fw-content := VerticalLayout {
                    alignment: start;
                    padding: Theme.sp-5;
                    spacing: Theme.sp-4;

                    // ── What firewall this machine has, and what it is doing ──
                    //
                    // A toggle switch stood here, bound to `firewall-enabled` — an `in property
                    // <bool>` defaulting to false that Rust never wrote — and beside it Quick
                    // Profiles (Home / Public / Restrictive) and Allow / Block port. All four
                    // callbacks were `tracing::info!` and nothing else. So the pane offered to
                    // change the firewall of a machine it had never read the firewall of.
                    //
                    // The controls are gone and the reading is real. Changing a firewall from a
                    // desktop session needs root, and this OS has no scoped privileged path for
                    // it — no polkit rule, no helper — only a blanket NOPASSWD sudoers line that
                    // the images written by deploy/ install. Using that to let a button press
                    // rewrite the packet filter is not a thing this app should do quietly. See
                    // design/network-2026-09-20.md.
                    Rectangle {
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        border-width: 1px;
                        border-color: root.firewall-state == "active" ? Theme.accent-dim
                                    : root.firewall-state == "unknown" ? Theme.color-warning.transparentize(60%)
                                    : Theme.border-subtle;
                        height: fw-header.preferred-height + 24px;

                        fw-header := VerticalLayout {
                            padding: Theme.sp-4;
                            spacing: Theme.sp-3;

                            HorizontalLayout {
                                spacing: Theme.sp-3;

                                Icon {
                                    commands: Icons.shield;
                                    size: 18px;
                                    tint: root.firewall-state == "active" ? Theme.color-success
                                        : root.firewall-state == "inactive" ? Theme.color-warning
                                        : Theme.text-dim;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    // Four words, four different statements. "Unknown" is not
                                    // "Off", and "not installed" is neither.
                                    text: root.firewall-state == "active" ? "Filtering"
                                        : root.firewall-state == "inactive" ? "Installed, not filtering"
                                        : root.firewall-state == "absent" ? "No firewall installed"
                                        : "Could not be determined";
                                    color: root.firewall-state == "active" ? Theme.color-success
                                         : root.firewall-state == "inactive" ? Theme.color-warning
                                         : Theme.text-secondary;
                                    font-size: Theme.fs-headline;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                            }

                            // Why the line above says what it says. Always drawn when there is a
                            // reason, because a security display whose "unknown" carries no
                            // reason is the confident "Off" this replaces wearing another word.
                            if root.firewall-reason != "" : Text {
                                text: root.firewall-reason;
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                wrap: word-wrap;
                            }

                            HorizontalLayout {
                                spacing: Theme.sp-6;

                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Tool"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text {
                                        text: root.firewall-backend-name != "" ? root.firewall-backend-name : "none found";
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                    }
                                }
                                VerticalLayout {
                                    spacing: 2px;
                                    Text { text: "Rules"; color: Theme.text-dim; font-size: Theme.fs-caption; }
                                    Text {
                                        // -1 is "not counted". Drawing that as 0 would be a
                                        // number nobody measured, which is how this pane got
                                        // into an audit in the first place.
                                        text: root.firewall-rule-count < 0 ? "unknown" : root.firewall-rule-count;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-body;
                                    }
                                }
                            }
                        }
                    }

                    // Active rules
                    // Only drawn when rules were actually read. An empty list here
                    // means the ruleset could not be read, not that it is empty;
                    // the card above says which.
                    if root.firewall-rules.length > 0 : VerticalLayout {
                        spacing: Theme.sp-2;

                        Text {
                            text: "Active Rules";
                            color: Theme.text-primary;
                            font-size: Theme.fs-headline;
                            font-weight: 600;
                        }

                        for rule[idx] in root.firewall-rules : Rectangle {
                            height: 44px;
                            background: Theme.bg-card;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: Theme.sp-4;
                                padding-right: Theme.sp-4;
                                spacing: Theme.sp-3;

                                // Action badge
                                Rectangle {
                                    width: rule-action-text.preferred-width + Theme.sp-3;
                                    height: 20px;
                                    border-radius: 10px;
                                    background: rule.action == "ACCEPT" ? Theme.color-success-dim
                                              : rule.action == "DROP" ? Theme.color-danger-dim
                                              : Theme.bg-elevated;
                                    rule-action-text := Text {
                                        text: rule.action;
                                        color: rule.action == "ACCEPT" ? Theme.color-success
                                             : rule.action == "DROP" ? Theme.color-danger
                                             : Theme.text-secondary;
                                        font-size: Theme.fs-micro;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                Text {
                                    text: rule.chain;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: rule.description;
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }
                            }
                        }
                    }
                }
            }

        }

            // ── What Yantrik knows about this ──
            AgentRail {
                context-items: root.agent-context;
                suggestions: root.agent-suggestions;
                unavailable: root.agent-unavailable;
                context-activated(id) => { root.agent-context-activated(id); }
                suggestion-activated(id) => { root.agent-suggestion-activated(id); }
            }
        }
    }

    // The password prompt is an overlay on the window, not a row in the column layout:
    // as a layout child it took real space and squashed everything above it.
        // ── WiFi Password Dialog (overlay) ──
        if root.wifi-password-visible : Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay-backdrop;

            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.wifi-password-visible = false; }
            }

            Rectangle {
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
                width: 400px;
                height: pw-dialog-layout.preferred-height + 32px;
                background: Theme.bg-card;
                border-radius: Theme.r-lg;
                border-width: 1px;
                border-color: Theme.accent-dim;
                drop-shadow-blur: 20px;
                drop-shadow-color: Theme.overlay-shadow;

                // Block clicks from closing
                TouchArea { width: 100%; height: 100%; }

                pw-dialog-layout := VerticalLayout {
                    padding: Theme.sp-5;
                    spacing: Theme.sp-4;

                    Text {
                        text: "Connect to " + root.wifi-password-ssid;
                        color: Theme.text-primary;
                        font-size: Theme.fs-headline;
                        font-weight: 600;
                    }

                    VerticalLayout {
                        spacing: Theme.sp-2;
                        Text {
                            text: "Password";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-caption;
                        }
                        Rectangle {
                            height: 40px;
                            background: Theme.bg-input; clip: true;
                            border-radius: Theme.r-lg;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            pw-input := TextInput {
                                x: 12px;
                                width: parent.width - 24px;
                                height: 100%;
                                text <=> root.wifi-password-input;
                                color: Theme.text-primary;
                                font-size: Theme.fs-body;
                                accepted => {
                                    root.wifi-connect(root.wifi-password-ssid, root.wifi-password-input);
                                    root.wifi-password-visible = false;
                                }
                            }
                        }
                    }

                    if root.wifi-connect-status != "" : Text {
                        text: root.wifi-connect-status;
                        color: Theme.color-emotional;
                        font-size: Theme.fs-caption;
                    }

                    HorizontalLayout {
                        spacing: 10px;
                        alignment: end;

                        YButton {
                            label: "Cancel";
                            variant: 1;
                            clicked => { root.wifi-password-visible = false; }
                        }
                        YButton {
                            label: "Connect";
                            variant: 0;
                            clicked => {
                                root.wifi-connect(root.wifi-password-ssid, root.wifi-password-input);
                                root.wifi-password-visible = false;
                            }
                        }
                    }
                }
            }
        }
}
