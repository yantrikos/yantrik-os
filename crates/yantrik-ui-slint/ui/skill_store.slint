// Skill Store — data-driven skill management UI.
// Skills are loaded from SkillRegistry manifests via Rust backend.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { YEmptyState } from "components/y_empty_state.slint";

export struct SkillData {
    id: string,
    name: string,
    description: string,
    icon: string,
    category: string,
    enabled: bool,
    tags: string,
}

export component SkillStore inherits Rectangle {
    // Model data populated from Rust
    in property <[SkillData]> skills;
    in property <[string]> categories: ["All"];
    in-out property <string> active-category: "All";
    in-out property <string> search-query: "";

    // Callbacks
    callback toggle-skill(string);
    callback search-skills(string);
    callback filter-category(string);

    // Internals
    property <int> total-count: skills.length;

    background: transparent;

    VerticalLayout {
        padding: 20px;
        spacing: 16px;
        alignment: start;

        // ── Header ──
        HorizontalLayout {
            spacing: 8px;
            // The accent marker and secondary text of the other Settings headers. Teal is the
            // minds' colour (colour system), and a skill list is not a mind.
            Rectangle {
                width: 3px; height: 14px;
                border-radius: 1.5px;
                background: Theme.accent;
            }
            Text {
                text: "SKILL STORE";
                color: Theme.text-secondary;
                font-size: Theme.fs-micro;
                font-weight: 600;
                letter-spacing: 3px;
                vertical-alignment: center;
            }
            Rectangle { horizontal-stretch: 1; }
            Text {
                text: skills.length > 0 ? skills.length + " skills" : "";
                color: Theme.text-dim;
                font-size: Theme.font-small;
                vertical-alignment: center;
            }
        }

        Text {
            text: "Enable or disable capabilities. Toggle skills based on what you use.";
            color: Theme.text-dim;
            font-size: Theme.font-small;
            wrap: word-wrap;
        }

        // -- Search --
        //
        // The magnifying glass here was the LETTER Q. At 13px on a dark panel it read as a
        // zero, which is what the survey photograph showed: a thousand-pixel-wide empty box
        // with what looked like a stray 0 in it and no hint of what it was for.
        //
        // Three things were wrong and only one of them was the glyph: no placeholder, so an
        // empty field said nothing about itself; and no width, so a search box for a list of
        // skills stretched the full width of the settings pane.
        Rectangle {
            height: 36px;
            max-width: 360px;
            horizontal-stretch: 0;
            border-radius: 8px;
            background: Theme.hover-fill;
            border-width: 1px;
            border-color: search-input.has-focus ? Theme.accent-dim : Theme.hover-fill-strong;
            clip: true;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                spacing: 8px;

                Icon {
                    commands: Icons.search;
                    size: 14px;
                    tint: Theme.text-dim;
                    thickness: 1.6px;
                    y: (parent.height - self.height) / 2;
                }

                search-input := TextInput {
                    text <=> root.search-query;
                    font-size: Theme.fs-body;
                    color: Theme.text-primary;
                    vertical-alignment: center;

                    accepted => {
                        root.search-skills(self.text);
                    }
                    edited => {
                        root.search-skills(self.text);
                    }
                }
            }

            if root.search-query == "" && !search-input.has-focus : Text {
                x: 34px;
                text: "Search skills";
                color: Theme.text-dim;
                font-size: Theme.fs-body;
                vertical-alignment: center;
                height: 100%;
            }
        }

        // ── Category Tabs ──
        HorizontalLayout {
            spacing: 6px;
            height: 30px;

            for cat[idx] in root.categories : cat-ta := TouchArea {
                width: cat-label.preferred-width + 16px;
                height: 28px;

                clicked => {
                    root.active-category = cat;
                    root.filter-category(cat);
                }

                // The selected category is the accent: selected and ON are the accent, and teal
                // is only for minds (colour system).
                Rectangle {
                    border-radius: 6px;
                    background: root.active-category == cat ? Theme.tint-accent : (cat-ta.has-hover ? Theme.hover-fill : transparent);
                    border-width: root.active-category == cat ? 1px : 0px;
                    border-color: Theme.accent-dim;

                    HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 8px;

                        cat-label := Text {
                            text: cat;
                            color: root.active-category == cat ? Theme.accent : Theme.text-dim;
                            font-size: Theme.fs-micro;
                            font-weight: root.active-category == cat ? 600 : 400;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Flexible spacer
            Rectangle { horizontal-stretch: 1; }
        }

        // ── Skill Cards ──
        Flickable {
            horizontal-stretch: 1;
            vertical-stretch: 1;

            VerticalLayout {
                spacing: 8px;
                alignment: start;

                for skill[idx] in root.skills : skill-ta := TouchArea {
                    height: 64px;

                    clicked => {
                        root.toggle-skill(skill.id);
                    }

                    Rectangle {
                        border-radius: 10px;
                        background: skill-ta.has-hover ? Theme.border-subtle : Theme.bg-card;
                        border-width: 1px;
                        // An enabled skill is ON, and ON is the accent. It was the success colour,
                        // whose dark value is a teal (colour system: teal is only for minds).
                        border-color: skill.enabled ? Theme.accent-dim : Theme.hover-fill;

                        HorizontalLayout {
                            padding: 12px;
                            spacing: 12px;

                            // Icon circle
                            Rectangle {
                                width: 40px;
                                height: 40px;
                                border-radius: 10px;
                                background: skill.enabled ? Theme.tint-accent : Theme.hover-fill;

                                Icon {
                                    commands: Icons.glyph(skill.icon);
                                    size: 18px;
                                    tint: skill.enabled ? Theme.accent : Theme.text-dim;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            // Name + description
                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 2px;

                                HorizontalLayout {
                                    spacing: 6px;

                                    Text {
                                        text: skill.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }

                                    // Category badge
                                    Rectangle {
                                        width: cat-badge-text.preferred-width + 10px;
                                        height: 16px;
                                        border-radius: 4px;
                                        background: Theme.hover-fill;

                                        cat-badge-text := Text {
                                            text: skill.category;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Rectangle { horizontal-stretch: 1; }
                                }

                                Text {
                                    text: skill.description;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                }
                            }

                            // Toggle switch
                            Rectangle {
                                width: 44px;
                                height: 24px;
                                border-radius: 12px;
                                background: skill.enabled ? Theme.accent : Theme.bg-card;

                                animate background { duration: 150ms; }

                                Rectangle {
                                    width: 18px;
                                    height: 18px;
                                    border-radius: 9px;
                                    y: 3px;
                                    x: skill.enabled ? parent.width - self.width - 3px : 3px;
                                    background: Theme.text-on-accent;

                                    animate x { duration: 150ms; }
                                }
                            }
                        }
                    }
                }

                // Empty state
                //
                // Two lines of 14px and 11px dim text, 8px apart, inside a fixed 120px box --
                // which photographed as a heading and a caption drifting apart in the middle
                // of the pane with nothing tying them together.
                if root.skills.length == 0 : YEmptyState {
                    height: 200px;
                    icon-path: Icons.skill;
                    title: "No skills found";
                    description: root.search-query != ""
                        ? "Try a different search term."
                        : "Skills will appear here once loaded.";
                }

                // Bottom spacer
                Rectangle { height: 40px; }
            }
        }
    }
}
