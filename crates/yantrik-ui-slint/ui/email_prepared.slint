// A draft Yantrik prepared for the person (#1184): an entry of its own beside Compose, and the bar
// over the composer while it is open. Plain Compose never opens it. Discard and Remove attachment
// are the person's buttons and nothing else's: the app raises them as commands from a click, and
// publishes no action that does either.

import { Theme } from "theme.slint";
import { YButton } from "components/y_button.slint";

// "Draft Yantrik prepared for Maya", under Compose. Empty label: nothing is prepared, nothing drawn.
export component PreparedEntry inherits Rectangle {
    in property <string> label: "";
    callback opened();
    height: self.label == "" ? 0px : Theme.h-regular;
    visible: self.label != "";
    border-radius: Theme.r-md;
    background: ta.has-hover ? Theme.hover-fill : transparent;
    Text {
        x: 12px;
        width: parent.width - 24px;
        text: root.label;
        color: Theme.text-primary;
        font-size: Theme.fs-caption;
        vertical-alignment: center;
        overflow: elide;
    }
    ta := TouchArea { clicked => { root.opened(); } mouse-cursor: pointer; }
}

// Over the composer while it shows the prepared draft: says what it is, shows the file it carries
// (and that it cannot be sent while it carries one), and offers the two ways out.
export component PreparedBar inherits Rectangle {
    in property <string> file: "";
    callback discard();
    callback remove-attachment();
    height: root.file == "" ? 40px : 56px;
    border-radius: 8px;
    background: Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border-subtle;
    HorizontalLayout {
        padding-left: 12px;
        padding-right: 8px;
        spacing: 8px;
        Text {
            text: root.file == "" ? "Prepared by Yantrik" : "Prepared by Yantrik. Attached: " + root.file + ". Email can't send attachments yet; remove it to send.";
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            wrap: word-wrap;
            horizontal-stretch: 1;
        }
        if root.file != "" : YButton { label: "Remove attachment"; variant: 1; size: 0; clicked => { root.remove-attachment(); } }
        YButton { label: "Discard prepared draft"; variant: 1; size: 0; clicked => { root.discard(); } }
    }
}
