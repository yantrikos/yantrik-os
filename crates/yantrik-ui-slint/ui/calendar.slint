// Calendar — month, week, and day views with event list sidebar.
// AI-integrated: natural language event creation, smart scheduling suggestions.

import { Theme } from "theme.slint";
import { ScrollView } from "std-widgets.slint";
import { YButton, YIconButton } from "components/y_button.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposalCard, AgentProposal } from "components/agent_proposal.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";
import { YNoticeBar } from "components/notice_bar.slint";
import { MonthGrid, CalendarDay } from "components/month_grid.slint";

// The struct moved with the grid that draws it; the app's Rust still names it from here.
export { CalendarDay }

// ── Data Structures ──

export struct CalendarEvent {
    id: int,
    title: string,
    date-text: string,       // "Mar 5, 2026"
    time-text: string,       // "2:00 PM - 3:00 PM" or "All day"
    color: color,            // category color
    is-all-day: bool,
}

export struct CalendarTimeEvent {
    title: string,
    start-hour: int,    // 0-23
    start-min: int,     // 0-59
    duration-min: int,  // in minutes
    day-index: int,     // 0-6 (column)
    color: color,
}

// CalendarAttendee was here, with an attendee chip list and an add-attendee field in the event
// form. Nothing could ever be done with what was typed into it: `CreateEventParams` in
// yantrik_ipc_contracts::calendar carries no attendees, `UpdateEventParams` carries none either,
// and the store writes `attendees: Vec::new()` on every event it creates. The wire type
// `CalendarEvent` does have an `attendees` field, which is what made the screen look backed.
// Bringing the section back means carrying attendees on the create and update params and having
// the store keep them; until then a person typing an address into this form was typing into
// nothing.

export struct CalendarTemplate {
    name: string,
    title-template: string,
    duration-min: int,
    icon: string,
}

// ── Calendar Component ──

export component CalendarScreen inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar when
    // the screen fills an app window; the shell's copy leaves it off.
    in property <bool> window-bar: false;
    background: Theme.bg-deep;

    // State
    in property <string> month-title: "March 2026";
    // ── The agent layer ──
    //
    // Same rule as everywhere: every row is something this app or the companion actually
    // holds, and says where it came from. See agent_rail.slint.
    in property <[AgentContextItem]> agent-context: [];
    in property <[AgentSuggestion]> agent-suggestions: [];
    in property <string> agent-unavailable: "";
    callback agent-context-activated(string);
    callback agent-suggestion-activated(string);
    in property <AgentProposal> proposal;
    in property <bool> proposal-working: false;
    callback proposal-dismissed();

    in property <[CalendarDay]> days: [];
    in property <[CalendarEvent]> events-today: [];
    in property <int> selected-day: 0;

    // `is-loading` was here and nothing read it -- not one element in this file -- and nothing
    // set it. It could not have been read usefully either: every fetch the app makes is a
    // blocking call on the UI thread, so the flag would go up and come down inside one callback
    // and no frame could ever be drawn while it was true. A spinner belongs here on the day the
    // fetch moves off the UI thread, and not before.

    /// What went wrong with the last thing the person asked for, in their words.
    ///
    /// Empty when nothing has. Saving used to fail in silence -- the form closed, the day stayed
    /// empty, and the only way to find out the event had not been stored was to look for it
    /// later. A calendar that cannot save has to say so at the moment it cannot.
    in property <string> notice: "";

    // View mode: 0=month, 1=week, 2=day
    in-out property <int> view-mode: 0;
    callback switch-view(int);

    // Week view data
    in property <[CalendarTimeEvent]> week-events: [];
    in property <[string]> week-day-labels: [];

    // Where "now" is on the hour grid.
    //
    // `current-hour` alone put the line on the top of the hour, which is up to fifty-nine
    // minutes from where the person is standing; both views draw the line at
    // (current-hour * 60 + current-minute) px now, since the grid is one pixel to the minute.
    // Both were zero until today, so the line sat on midnight in every session.
    in property <int> current-hour: 0;
    in property <int> current-minute: 0;

    // Day view data
    in property <[CalendarTimeEvent]> day-events: [];
    in property <string> day-view-title: "";

    // Event form state
    in-out property <bool> show-event-form: false;
    in-out property <string> event-title: "";
    in-out property <string> event-date: "";
    in-out property <string> event-time: "";
    in-out property <string> event-notes: "";

    // Callbacks
    callback prev-month();
    callback next-month();
    callback day-clicked(int);
    callback add-event();
    callback save-event(string, string, string, string);
    callback delete-event(int);
    // The notice bar's close button: the app clears `notice`.
    callback dismiss-notice();
    callback cancel-event-form();
    callback today-pressed();

    // AI Assist
    in property <bool> ai-is-working: false;
    in-out property <bool> ai-panel-open: false;
    callback ai-explain-pressed();
    callback ai-dismiss();

    // `ai-response` and the panel that drew it were here. The companion's answer arrives in
    // `proposal` and is drawn by AgentProposalCard over the grid, the way every app shows one;
    // this second panel was never given a line of text by anything, so `ai-panel-open` opened an
    // empty box that the `!= ""` guard then declined to draw.

    // ── Event templates ──
    //
    // The list is the screen's own: four shapes of meeting with their durations, no more
    // configurable than the weekday headers above the month. It used to be an `in` property with
    // this same list as its default, which read as data the app supplies and never did. Pressing
    // one hands the app the two things it needs -- the title to start from and how long the
    // thing runs -- rather than an index into a list the app cannot see.
    private property <[CalendarTemplate]> cal-templates: [
        { name: "1-on-1", title-template: "1:1 with ", duration-min: 30, icon: Icons.people },
        { name: "Standup", title-template: "Daily Standup", duration-min: 15, icon: Icons.arrow-up },
        { name: "Team Meeting", title-template: "Team Meeting", duration-min: 60, icon: Icons.people },
        { name: "Focus Time", title-template: "Focus Block", duration-min: 120, icon: Icons.spark },
    ];
    in property <string> cal-timezone-display: "";
    in-out property <bool> cal-template-panel-open: false;

    callback cal-use-template(string, int);  // title to start from, minutes

    // `cal-reminder-minutes` and `cal-set-reminder` were here, drawing a None/5m/15m/30m/1h
    // selector in the event form. A reminder has nowhere to live: neither `CreateEventParams`
    // nor the stored `CalendarEvent` has a field for one, and nothing on this machine would fire
    // it if they did. The selector remembered a choice for as long as the form was open and threw
    // it away on Save. It comes back when the event model carries a reminder and something
    // watches the clock for it.
    //
    // `cal-toggle-template-panel` went with them. The panel's open state is this component's own
    // in-out property and the header action flips it directly; routing that through Rust meant a
    // callback whose only correct body would have been to set a property it does not own -- and
    // whose actual body was empty, so the template button did nothing at all.

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // The month and the three view modes used to live inside the left pane, which meant
        // the thing telling you where you are scrolled with the thing you were looking at.
        AppHeader {
            window-bar: root.window-bar;
            app-id: "calendar";
            icon: Icons.calendar;
            title: "Calendar";
            subtitle: root.month-title;
            leading-actions: [
                { id: "view-0", label: "Month", active: root.view-mode == 0 },
                { id: "view-1", label: "Week",  active: root.view-mode == 1 },
                { id: "view-2", label: "Day",   active: root.view-mode == 2 },
            ];
            actions: [
                { id: "prev",  icon: Icons.chevron-left },
                { id: "today", label: "Today" },
                { id: "next",  icon: Icons.chevron-right },
                { id: "ai",    icon: Icons.spark, label: root.ai-is-working ? "Working" : "AI",
                  emphasis: 1, loading: root.ai-is-working, active: root.ai-panel-open },
                { id: "new",   icon: Icons.plus, label: "New Event", emphasis: 2 },
                { id: "templates", icon: Icons.menu, active: root.cal-template-panel-open },
            ];
            action(id) => {
                if (id == "view-0") { root.view-mode = 0; root.switch-view(0); }
                else if (id == "view-1") { root.view-mode = 1; root.switch-view(1); }
                else if (id == "view-2") { root.view-mode = 2; root.switch-view(2); }
                else if (id == "prev") { root.prev-month(); }
                else if (id == "today") { root.today-pressed(); }
                else if (id == "next") { root.next-month(); }
                else if (id == "ai") {
                    if (root.ai-panel-open) { root.ai-dismiss(); root.ai-panel-open = false; }
                    else { root.ai-explain-pressed(); root.ai-panel-open = true; }
                }
                else if (id == "new") { root.add-event(); }
                else if (id == "templates") { root.cal-template-panel-open = !root.cal-template-panel-open; }
            }
        }

    HorizontalLayout {
        spacing: 0px;

        // ── Left: Calendar grid / week / day ──
        Rectangle {
            background: Theme.bg-surface;
            min-width: 480px;

            VerticalLayout {
                // ── What the companion is proposing ──
                //
                // Over the calendar, which is what it is about.
                if root.proposal.title != "" : AgentProposalCard {
                    data: root.proposal;
                    working: root.proposal-working;
                    apply => { root.proposal-dismissed(); }
                    dismiss => { root.proposal-dismissed(); }
                }

                padding: Theme.sp-5;
                spacing: Theme.sp-4;

                // The toolbar that was here is gone.
                //
                // It was the app's original one -- < > September 2026, Month/Week/Day, Today,
                // AI, +, the template menu -- and when Calendar was converted to AppHeader the
                // header got all of it and this kept all of it too. Two toolbars, stacked, with
                // the same seven controls in the same order: one row apart, both live, both
                // working. The only thing the header did not have is the template panel, which
                // is now an action on it like everything else.
                // ── Event Templates Panel ──
                if root.cal-template-panel-open : Rectangle {
                    height: tpl-layout.preferred-height + Theme.sp-6;
                    border-radius: Theme.r-lg;
                    background: Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    tpl-layout := VerticalLayout {
                        padding: Theme.sp-3;
                        spacing: Theme.sp-2;

                        HorizontalLayout {
                            spacing: Theme.sp-2;
                            Text {
                                text: "Quick Templates";
                                color: Theme.text-primary;
                                font-size: Theme.fs-caption;
                                font-weight: Theme.fw-headline;
                                vertical-alignment: center;
                            }
                            Rectangle { horizontal-stretch: 1; }
                            YIconButton {
                                icon-path: Icons.close;
                                variant: 1;
                                clicked => { root.cal-template-panel-open = false; }
                            }
                        }

                        HorizontalLayout {
                            spacing: Theme.sp-2;

                            for idx in root.cal-templates.length : Rectangle {
                                property <CalendarTemplate> tpl: root.cal-templates[idx];
                                min-width: 100px;
                                height: 56px;
                                border-radius: 8px;
                                background: tpl-touch.has-hover ? Theme.bg-card : Theme.border-subtle;
                                border-width: 1px;
                                border-color: tpl-touch.has-hover ? AppIdentity.accent.transparentize(60%) : transparent;

                                tpl-touch := TouchArea {
                                    clicked => {
                                        root.cal-use-template(tpl.title-template, tpl.duration-min);
                                        root.cal-template-panel-open = false;
                                    }
                                    mouse-cursor: pointer;
                                }

                                VerticalLayout {
                                    padding: 8px;
                                    spacing: 4px;
                                    alignment: center;

                                    HorizontalLayout {
                                        spacing: 4px;
                                        alignment: center;
                                        Icon { commands: tpl.icon; size: 14px; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                                        Text {
                                            text: tpl.name;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: tpl.duration-min + " min";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        horizontal-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ═══════════════════════════════════════
                // MONTH VIEW (view-mode == 0)
                // ═══════════════════════════════════════
                if root.view-mode == 0 : MonthGrid {
                    days: root.days;
                    cell-min-height: 56px;
                    accent: AppIdentity.accent;
                    tint: AppIdentity.tint;
                    day-clicked(day) => { root.day-clicked(day); }
                }

                // ═══════════════════════════════════════
                // WEEK VIEW (view-mode == 1)
                // ═══════════════════════════════════════
                if root.view-mode == 1 : VerticalLayout {
                    spacing: 0px;

                    // Day column headers with date labels
                    HorizontalLayout {
                        spacing: 0px;
                        height: 36px;

                        // Spacer for hour column
                        Rectangle {
                            width: 50px;
                            height: 36px;
                        }

                        for idx in 7 : Rectangle {
                            height: 36px;
                            border-width: 1px;
                            border-color: Theme.hover-fill;
                            clip: true;

                            Text {
                                // A label carrying an all-day count is longer than "Sun 20" and
                                // a seventh of the pane is all it gets, so it elides inside its
                                // own column rather than spilling over the next one.
                                width: 100%;
                                overflow: elide;
                                text: root.week-day-labels.length > idx ? root.week-day-labels[idx] : "";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-micro;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Scrollable time grid
                    Flickable {
                        viewport-height: 1440px; // 24 hours * 60px

                        Rectangle {
                            width: 100%;
                            height: 1440px;

                            // Hour rows (background lines)
                            for hour in 24 : Rectangle {
                                y: hour * 60px;
                                width: 100%;
                                height: 60px;

                                // Hour label
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 50px;
                                    height: 60px;

                                    Text {
                                        text: hour < 10 ? "0" + hour : hour;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        horizontal-alignment: center;
                                        vertical-alignment: top;
                                    }
                                }

                                // Grid line
                                Rectangle {
                                    x: 50px;
                                    y: 0;
                                    width: parent.width - 50px;
                                    height: 1px;
                                    background: Theme.hover-fill;
                                }

                                // Day column dividers
                                for col in 6 : Rectangle {
                                    x: 50px + (col + 1) * ((parent.width - 50px) / 7);
                                    y: 0;
                                    width: 1px;
                                    height: 60px;
                                    background: Theme.hover-fill;
                                }
                            }

                            // Current hour indicator line
                            Rectangle {
                                x: 50px;
                                y: (root.current-hour * 60 + root.current-minute) * 1px;
                                width: parent.width - 50px;
                                height: 2px;
                                background: Theme.accent;
                            }
                            // Current hour dot
                            Rectangle {
                                x: 44px;
                                y: (root.current-hour * 60 + root.current-minute) * 1px - 4px;
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: Theme.accent;
                            }

                            // Week events
                            for ev in root.week-events : Rectangle {
                                property <length> col-width: (parent.width - 50px) / 7;
                                x: 50px + ev.day-index * col-width + 2px;
                                y: ev.start-hour * 60px + ev.start-min * 1px;
                                width: col-width - 4px;
                                height: Math.max(ev.duration-min * 1px, 20px);
                                border-radius: 4px;
                                background: ev.color.with-alpha(0.85);
                                clip: true;

                                VerticalLayout {
                                    padding: 4px;
                                    spacing: 1px;

                                    Text {
                                        text: ev.title;
                                        color: Theme.text-on-accent;
                                        font-size: Theme.fs-micro;
                                        font-weight: 600;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: (ev.start-hour < 10 ? "0" : "") + ev.start-hour + ":" + (ev.start-min < 10 ? "0" : "") + ev.start-min;
                                        color: Theme.text-on-accent;
                                        font-size: Theme.fs-micro;
                                    }
                                }
                            }
                        }
                    }
                }

                // ═══════════════════════════════════════
                // DAY VIEW (view-mode == 2)
                // ═══════════════════════════════════════
                if root.view-mode == 2 : VerticalLayout {
                    spacing: 0px;

                    // Which day this is.
                    //
                    // The day view drew twenty-four unlabelled hours and no date at all, so the
                    // one view that shows a single day was the one that never said which. The
                    // gutter matches the hour column below it, so the title starts on the same
                    // axis the events do.
                    HorizontalLayout {
                        spacing: 0px;
                        height: 36px;

                        Rectangle {
                            width: 50px;
                            height: 36px;
                        }

                        Rectangle {
                            height: 36px;
                            clip: true;

                            Text {
                                width: 100%;
                                overflow: elide;
                                text: root.day-view-title;
                                color: Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                font-weight: 600;
                                horizontal-alignment: left;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Scrollable time grid — single day
                    Flickable {
                        viewport-height: 1440px; // 24 hours * 60px

                        Rectangle {
                            width: 100%;
                            height: 1440px;

                            // Hour rows
                            for hour in 24 : Rectangle {
                                y: hour * 60px;
                                width: 100%;
                                height: 60px;

                                // Hour label
                                Rectangle {
                                    x: 0;
                                    y: 0;
                                    width: 50px;
                                    height: 60px;

                                    Text {
                                        text: hour < 10 ? "0" + hour : hour;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        horizontal-alignment: center;
                                        vertical-alignment: top;
                                    }
                                }

                                // Grid line
                                Rectangle {
                                    x: 50px;
                                    y: 0;
                                    width: parent.width - 50px;
                                    height: 1px;
                                    background: Theme.hover-fill;
                                }

                                // Half-hour line (subtle)
                                Rectangle {
                                    x: 50px;
                                    y: 30px;
                                    width: parent.width - 50px;
                                    height: 1px;
                                    background: Theme.hover-fill.with-alpha(0.5);
                                }
                            }

                            // Current hour indicator line
                            Rectangle {
                                x: 50px;
                                y: (root.current-hour * 60 + root.current-minute) * 1px;
                                width: parent.width - 50px;
                                height: 2px;
                                background: Theme.accent;
                            }
                            // Current hour dot
                            Rectangle {
                                x: 44px;
                                y: (root.current-hour * 60 + root.current-minute) * 1px - 4px;
                                width: 10px;
                                height: 10px;
                                border-radius: 5px;
                                background: Theme.accent;
                            }

                            // Day events (only day-index == 0)
                            for ev in root.day-events : Rectangle {
                                x: 54px;
                                y: ev.start-hour * 60px + ev.start-min * 1px;
                                width: parent.width - 58px;
                                height: Math.max(ev.duration-min * 1px, 24px);
                                border-radius: 6px;
                                background: ev.color.with-alpha(0.85);
                                clip: true;

                                HorizontalLayout {
                                    padding: 8px;
                                    spacing: 12px;
                                    alignment: start;

                                    // Color accent strip
                                    Rectangle {
                                        width: 3px;
                                        height: parent.height - 8px;
                                        border-radius: 1.5px;
                                        background: Theme.text-secondary;
                                    }

                                    VerticalLayout {
                                        spacing: 2px;
                                        alignment: center;

                                        Text {
                                            text: ev.title;
                                            color: Theme.text-on-accent;
                                            font-size: Theme.fs-body;
                                            font-weight: 600;
                                            overflow: elide;
                                        }
                                        Text {
                                            text: (ev.start-hour < 10 ? "0" : "") + ev.start-hour + ":" + (ev.start-min < 10 ? "0" : "") + ev.start-min;
                                            color: Theme.text-on-accent;
                                            font-size: Theme.fs-micro;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── Right: Events sidebar ──
        Rectangle {
            width: 300px;
            background: Theme.bg-surface;

            // Left separator
            Rectangle {
                x: 0;
                width: 1px;
                height: 100%;
                background: Theme.separator;
            }

            // What could not be done, in its own row above whatever the sidebar is showing — the kit's
            // notice bar, so nothing is drawn under it. Outside the form because the failure outlives it:
            // a delete that could not reach the store has no form to report into.
            VerticalLayout {
                if root.notice != "" : YNoticeBar {
                    text: root.notice;
                    dismissed => { root.dismiss-notice(); }
                }

                Rectangle {
                    vertical-stretch: 1;

                    // Event form overlay
                    if root.show-event-form : VerticalLayout {
                        padding: Theme.sp-5;
                        spacing: Theme.sp-3;

                        HorizontalLayout {
                            alignment: space-between;

                            Text {
                                text: "New Event";
                                color: Theme.text-primary;
                                font-size: Theme.fs-title-2;
                                font-weight: Theme.fw-title-2;
                                vertical-alignment: center;
                            }

                            YIconButton {
                                icon: "X";
                                variant: 1;
                                clicked => { root.cancel-event-form(); }
                            }
                        }

                        // Title
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Title";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                            }
                            Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: Theme.bg-card; clip: true;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;

                                    TextInput {
                                        text <=> root.event-title;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Date
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Date";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                            }
                            Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: Theme.bg-card; clip: true;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;

                                    TextInput {
                                        text <=> root.event-date;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Time
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Time (e.g. 2:00 PM - 3:00 PM)";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                            }
                            Rectangle {
                                height: 38px;
                                border-radius: 8px;
                                background: Theme.bg-card; clip: true;

                                HorizontalLayout {
                                    padding-left: 12px;
                                    padding-right: 12px;

                                    TextInput {
                                        text <=> root.event-time;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // Notes
                        VerticalLayout {
                            spacing: 4px;

                            Text {
                                text: "Notes";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                            }
                            Rectangle {
                                height: 80px;
                                border-radius: 8px;
                                background: Theme.bg-card; clip: true;

                                ScrollView {
                                    VerticalLayout {
                                        alignment: start;
                                        padding: 10px;

                                        TextInput {
                                            text <=> root.event-notes;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            wrap: word-wrap;
                                        }
                                    }
                                }
                            }
                        }

                        // Timezone display
                        if root.cal-timezone-display != "" : Text {
                            text: root.cal-timezone-display;
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                        }

                        // The reminder selector and the attendees section were here. Both are
                        // recorded at the top of this file: neither had anywhere to put what was typed
                        // into it, and a control that cannot keep what it is given is worse than no
                        // control, because the person believes they set something.

                        // Save button
                        Rectangle {
                            height: 40px;
                            border-radius: 8px;
                            background: Theme.accent;

                            TouchArea {
                                clicked => {
                                    root.save-event(root.event-title, root.event-date, root.event-time, root.event-notes);
                                }
                                mouse-cursor: pointer;
                            }

                            Text {
                                text: "Save Event";
                                color: Theme.bg-deep;
                                font-size: Theme.fs-body;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    // Events list (when form is hidden)
                    if !root.show-event-form : VerticalLayout {
                        padding: 20px;
                        spacing: 12px;

                        // Agenda header: the day, and how full it is
                        HorizontalLayout {
                            spacing: Theme.sp-2;

                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;

                                Text {
                                    text: root.selected-day > 0 ? "DAY \{root.selected-day}" : "TODAY";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-weight: Theme.fw-micro;
                                    letter-spacing: 1px;
                                }
                                Text {
                                    text: root.events-today.length == 0 ? "Nothing scheduled"
                                        : root.events-today.length == 1 ? "1 event"
                                        : "\{root.events-today.length} events";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-title-2;
                                    font-weight: Theme.fw-title-2;
                                    letter-spacing: -0.2px;
                                }
                            }

                            YButton {
                                label: "New";
                                icon-path: Icons.plus;
                                variant: 0;
                                size: 0;
                                y: (parent.height - self.height) / 2;
                                clicked => { root.add-event(); }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.separator; }

                        if root.events-today.length == 0 : Rectangle {
                            height: 160px;

                            VerticalLayout {
                                alignment: center;
                                spacing: 8px;

                                HorizontalLayout {
                                    alignment: center;
                                    Icon {
                                        commands: Icons.calendar;
                                        size: 26px;
                                        tint: AppIdentity.accent.transparentize(55%);
                                    }
                                }
                                Text {
                                    text: "A clear day";
                                    color: Theme.text-secondary;
                                    font-size: Theme.fs-body;
                                    horizontal-alignment: center;
                                }
                                Text {
                                    text: "Press New to put something in it.";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    horizontal-alignment: center;
                                }
                            }
                        }

                        ScrollView {
                            VerticalLayout {
                                alignment: start;
                                spacing: 8px;

                                for event in root.events-today : Rectangle {
                                    height: event-content.preferred-height + 20px;
                                    border-radius: 10px;
                                    background: Theme.bg-card;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;

                                    // Color accent bar
                                    Rectangle {
                                        x: 0;
                                        y: 8px;
                                        width: 3px;
                                        height: parent.height - 16px;
                                        border-radius: 1.5px;
                                        background: event.color;
                                    }

                                    event-content := VerticalLayout {
                                        padding: 10px;
                                        padding-left: 14px;
                                        spacing: 4px;

                                        Text {
                                            text: event.title;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            font-weight: 600;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: event.time-text;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-micro;
                                        }
                                    }

                                    // Delete
                                    del-ta := TouchArea {
                                        x: parent.width - 32px;
                                        y: 6px;
                                        width: 26px;
                                        height: 26px;
                                        mouse-cursor: pointer;
                                        clicked => { root.delete-event(event.id); }

                                        Rectangle {
                                            border-radius: Theme.r-sm;
                                            background: del-ta.has-hover ? Theme.color-danger-dim : transparent;
                                            Icon {
                                                commands: Icons.trash;
                                                size: 12px;
                                                tint: del-ta.has-hover ? Theme.color-danger : Theme.text-dim;
                                                x: (parent.width - self.width) / 2;
                                                y: (parent.height - self.height) / 2;
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ── What Yantrik knows about this day ──
        AgentRail {
            context-items: root.agent-context;
            suggestions: root.agent-suggestions;
            unavailable: root.agent-unavailable;
            context-activated(id) => { root.agent-context-activated(id); }
            suggestion-activated(id) => { root.agent-suggestion-activated(id); }
        }
    }
    }
}
