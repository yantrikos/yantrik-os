// Notification Center — screen 9.
//
// It lists what the notifications service holds, grouped by app, newest first. It used to list
// the shell's own private JSON file in `~/.yantrik/`, which only the shell could write and only
// the shell could read — so a notification from `notify-send`, from Chromium, or from any of our
// own apps was never in it. There is one store now and this is a view of it.
//
// When the service is not running this says so in a sentence. An empty list and a dead service
// look identical, and "All caught up" over a service that is down is the confident lie this repo
// exists to stop.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";

export struct NotifActionData {
    id: string,
    label: string,
}

export struct NotificationData {
    id: string,
    app-name: string,
    summary: string,
    body: string,
    urgency: int,  // 0=low, 1=normal, 2=critical
    time-ago: string,
    is-read: bool,
    // Grouping fields
    is-group-header: bool,
    group-name: string,
    group-icon: string,
    group-count: int,
    // The sender's buttons. Empty for a group header.
    actions: [NotifActionData],
    // Where it came in from — "yantrik" or "freedesktop". Shown on the row, because "who told
    // me this" is the first question about a notification from a program nobody remembers
    // installing.
    source: string,
    // Who sent it, in the approval card's two voices on one line: what the caller called
    // itself, and what the kernel-stamped pid on the socket resolved to. A notification that
    // said `Yantrik` and something false had no second voice (#114). Empty when the store
    // recorded nothing — an old record, or one from the freedesktop door — and then not drawn.
    sender-line: string,
}

export component NotificationCenter inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    background: Theme.bg-deep;

    in property <[NotificationData]> notifications: [];
    in property <int> unread-count: 0;
    /// Is the one store answering? Everything below is about what to say when it is not.
    in property <bool> service-up: true;
    /// Why it is not, in the words the shell was given. Empty when all is well.
    in property <string> service-notice: "";

    callback back-pressed();
    callback clear-all();
    callback mark-all-read();
    callback notification-tapped(string);
    callback notification-dismissed(string);
    callback notification-action(string, string);  // notification id, action id
    callback clear-group(string);

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // Back was the character "left arrow", mark-all-read was "check mark" and clear-all was
        // "multiplication x" -- three glyphs standing in for icons, each one a bet that the
        // installed font happens to carry it. They are Icons paths now, and the unread count is
        // the subtitle instead of a pill the header had to size by hand.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "notifications";
            show-back: true;
            icon: Icons.alerts;
            title: "Notifications";
            subtitle: !root.service-up ? "service not running"
                    : root.unread-count > 0 ? "\{root.unread-count} unread" : "";
            actions: [
                { id: "read",  icon: Icons.check, label: "Mark all read", disabled: root.unread-count == 0 },
                { id: "clear", icon: Icons.trash, label: "Clear all", disabled: root.notifications.length == 0 },
            ];
            back => { root.back-pressed(); }
            action(id) => {
                if (id == "read") { root.mark-all-read(); }
                else if (id == "clear") { root.clear-all(); }
            }
        }

        // ── Notification list ──
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: Theme.sp-4;
                spacing: Theme.sp-1;
                alignment: start;

                // The service is not answering.
                //
                // Said as a sentence, not as an empty list: the two look the same and mean
                // opposite things. Nothing is lost while it is down — notifications posted
                // meanwhile land in the file when it comes back — and the sentence says so, so
                // nobody goes looking for a message that is simply not readable yet.
                if !root.service-up : Rectangle {
                    height: down.preferred-height;
                    border-radius: Theme.r-lg;
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.color-danger-dim;

                    down := VerticalLayout {
                        padding: Theme.sp-4;
                        spacing: Theme.sp-2;

                        Text {
                            text: "The notifications service is not running.";
                            color: Theme.text-primary;
                            font-size: Theme.fs-body;
                            font-weight: Theme.fw-headline;
                            wrap: word-wrap;
                        }
                        Text {
                            text: root.service-notice != "" ? root.service-notice
                                : "Nothing is lost — this screen cannot read the store until the service is back. It is started on demand, so opening this screen again usually brings it up.";
                            color: Theme.text-dim;
                            font-size: Theme.fs-caption;
                            wrap: word-wrap;
                        }
                    }
                }

                // Empty state
                //
                // Was a bell EMOJI at 48px with two loose lines of text under it. The emoji
                // drew as a tofu box on a machine with no emoji font -- a question mark in a
                // rectangle, in the middle of an otherwise empty screen. YEmptyState is what
                // every other view uses to say it has nothing, and it has no emoji in it.
                if root.service-up && root.notifications.length == 0 : YEmptyState {
                    icon-path: Icons.alerts;
                    title: "All caught up";
                    description: "Notifications from this desktop and from any application on it appear here.";
                }

                for notif[idx] in root.notifications : VerticalLayout {
                    spacing: 0px;

                    // Group header
                    if notif.is-group-header : Rectangle {
                        height: group-header-layout.preferred-height;

                        group-header-layout := VerticalLayout {
                            spacing: 0px;

                            HorizontalLayout {
                                padding-top: idx > 0 ? Theme.sp-4 : Theme.sp-1;
                                padding-bottom: Theme.sp-2;
                                padding-left: Theme.sp-1;
                                padding-right: Theme.sp-1;
                                spacing: Theme.sp-2;

                                Rectangle {
                                    width: 28px; height: 28px;
                                    border-radius: Theme.r-md;
                                    background: Theme.tint-accent;
                                    Icon {
                                        commands: Icons.glyph(notif.group-icon);
                                        size: 15px;
                                        tint: Theme.accent;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }

                                Text { text: notif.group-name; color: Theme.text-primary; font-size: Theme.fs-body; font-weight: Theme.fw-headline; vertical-alignment: center; horizontal-stretch: 1; }

                                Rectangle {
                                    width: max(20px, gct.preferred-width + Theme.sp-2);
                                    height: 20px; border-radius: self.height / 2; background: Theme.bg-elevated;
                                    gct := Text { text: notif.group-count; color: Theme.text-dim; font-size: Theme.fs-micro; font-weight: 600; horizontal-alignment: center; vertical-alignment: center; }
                                }

                                TouchArea {
                                    width: 28px; height: 28px;
                                    clicked => { root.clear-group(notif.group-name); }
                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: Theme.r-md;
                                        background: parent.has-hover ? Theme.hover-fill : transparent;
                                        animate background { duration: Theme.dur-fast; }
                                        Icon {
                                            commands: Icons.close;
                                            size: 12px;
                                            tint: Theme.text-dim;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.separator; }
                        }
                    }

                    // Notification card
                    if !notif.is-group-header : Rectangle {
                        property <bool> hovered: cta.has-hover;
                        background: hovered ? Theme.hover-fill : notif.is-read ? Theme.bg-card : Theme.bg-elevated;
                        border-radius: Theme.r-lg;
                        border-width: notif.urgency == 2 ? 1px : 0px;
                        border-color: notif.urgency == 2 ? Theme.color-danger-dim : transparent;
                        // Everything variable on this card lives inside `nc`, one unconditional
                        // layout, so this Rectangle has a real preferred height. A Rectangle
                        // whose children are all behind `if` reports zero and its content spills
                        // upward off the screen — see the note in toast_banner.slint.
                        height: nc.preferred-height;
                        animate background { duration: Theme.dur-fast; }

                        cta := TouchArea { clicked => { root.notification-tapped(notif.id); } }

                        nc := VerticalLayout {
                            padding: Theme.sp-3;
                            spacing: Theme.sp-1;

                            HorizontalLayout {
                                spacing: Theme.sp-2;

                                Rectangle {
                                    width: 8px; height: 8px; y: 5px;
                                    border-radius: 4px;
                                    background: !notif.is-read ? (notif.urgency == 2 ? Theme.color-danger : notif.urgency == 0 ? Theme.text-dim : Theme.accent) : transparent;
                                }

                                Text {
                                    text: notif.summary;
                                    color: notif.is-read ? Theme.text-secondary : Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    font-weight: notif.is-read ? Theme.fw-body : Theme.fw-body-strong;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                    overflow: elide;
                                }

                                Text { text: notif.time-ago; color: Theme.text-dim; font-size: Theme.fs-caption; vertical-alignment: center; }

                                // Dismiss this one. The list had no way to remove a single
                                // notification — only the whole app group or everything — so
                                // reading one message meant clearing four.
                                TouchArea {
                                    width: 24px; height: 24px;
                                    mouse-cursor: pointer;
                                    clicked => { root.notification-dismissed(notif.id); }
                                    Icon {
                                        commands: Icons.close;
                                        size: 11px;
                                        tint: parent.has-hover ? Theme.text-primary : Theme.text-dim;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            if notif.body != "" && notif.body != notif.summary : Text {
                                text: notif.body;
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                wrap: word-wrap;
                            }

                            // Who sent it — the same "says the caller" / "verified by this
                            // machine" the approval card draws, because the name on the row
                            // is only what the sender said. One elided line, at the card's
                            // size for it, so a long command line cannot push the buttons.
                            if notif.sender-line != "" : Text {
                                text: notif.sender-line;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                wrap: no-wrap;
                                overflow: elide;
                            }

                            // The sender's own buttons. For a freedesktop notification, pressing
                            // one sends `ActionInvoked` back to the program that raised it; for
                            // one of ours, the app hears about it the same way. A button that
                            // did nothing would be the dead control this repo forbids, so these
                            // are only drawn for a notification that published actions.
                            if notif.actions.length > 0 : HorizontalLayout {
                                spacing: Theme.sp-2;
                                alignment: start;
                                padding-top: 2px;

                                for action in notif.actions : Rectangle {
                                    width: act-label.preferred-width + Theme.sp-4;
                                    height: 26px;
                                    border-radius: Theme.r-sm;
                                    background: act-ta.has-hover ? Theme.accent.transparentize(75%) : Theme.bg-deep;
                                    border-width: 1px;
                                    border-color: Theme.accent.transparentize(70%);

                                    act-ta := TouchArea {
                                        mouse-cursor: pointer;
                                        clicked => { root.notification-action(notif.id, action.id); }
                                    }

                                    act-label := Text {
                                        text: action.label;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-caption;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                        wrap: no-wrap;
                                    }
                                }
                            }
                        }
                    }
                }

                Rectangle { height: Theme.sp-5; }
            }
        }
    }
}
