// About screen — system info panel for Yantrik OS.
// Screen 16. Read-only info cards showing hardware & OS details.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";
import { YantrikMark } from "components/yantrik_mark.slint";

// What is installed, and nothing else.
//
// This carried `latest-version`, `has-update` and `is-checking` as well, filled in by a checker
// that read `channels[c]["components"][name]["version"]` out of the release manifest — a field
// no manifest this project publishes has ever had. The lookup always missed, so `has-update` was
// always false and the two badges those fields drew were never once drawn. The release manifest
// describes whole builds, not per-component versions; there is no honest source for a
// per-component "available" and so there is no longer a field claiming one. Update availability
// is answered once, for the machine, by the UPDATES card below.
export struct ComponentVersionData {
    name: string,
    current-version: string,
}

// One channel in the picker. Three of these, one per channel the updater knows.
//
// `enabled` is false when update.conf cannot be written by the user the desktop runs as: the
// chip goes flat and stops responding rather than sending a request that will come back as a
// permission error. The card says what to type instead.
component ChannelChip inherits Rectangle {
    in property <string> label;
    in property <bool> selected: false;
    in property <bool> enabled: true;
    callback picked();

    width: chip-text.preferred-width + 24px;
    height: 26px;
    border-radius: 13px;
    background: root.selected ? Theme.tint-cyan
              : (chip-ta.has-hover && root.enabled) ? Theme.hover-fill-strong
              : Theme.hover-fill;
    border-width: 1px;
    border-color: root.selected ? Theme.cyan-dim : Theme.border-subtle;
    opacity: root.enabled ? 1.0 : 0.45;

    chip-text := Text {
        text: root.label;
        font-size: Theme.fs-micro;
        font-weight: root.selected ? 700 : 500;
        color: root.selected ? Theme.cyan : Theme.text-secondary;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    chip-ta := TouchArea {
        enabled: root.enabled && !root.selected;
        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
        clicked => { root.picked(); }
    }
}

export component AboutScreen inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    background: Theme.bg-deep;

    // Data fields (all read-only, populated from Rust)
    in property <string> hostname: "";
    in property <string> kernel: "";
    in property <string> cpu-model: "";
    in property <string> ram-total: "";
    in property <string> disk-info: "";
    in property <string> uptime-text: "";
    // Empty until wire/about.rs fills it from yantrik-version. It used to default to "0.3.0",
    // which is a plausible-looking answer and was the wrong one on every machine.
    in property <string> version-text: "";
    in property <string> build-date: "";

    // Component versions — installed only.
    in property <[ComponentVersionData]> components: [];
    // The bundle's CHANGELOG.md, one line per change. Empty on a build that shipped none.
    in property <[string]> changes: [];

    // ── Updates ──
    //
    // Every one of these comes from `yantrik-update`, which is the only program on the machine
    // that reads /opt/yantrik/update.conf and the only one that writes it. The screen states
    // what the updater states; it does not have a second opinion about the channel, the host,
    // or whether this machine is current.
    in property <string> update-channel: "";         // nightly | beta | stable
    in property <string> update-host: "";            // https://releases.yantrikos.com
    in property <string> update-installed: "";       // 0.4.2 (deadbee)
    in property <string> update-latest: "";          // what the channel has, blank if unknown
    in property <string> update-status: "";          // the updater's own sentence
    // idle | checking | up-to-date | ahead | available | not-published | failed | applying
    // "ahead" is its own state and not a flavour of up-to-date: this machine is past the
    // channel's build rather than on it, and the distinction is the one that keeps an older
    // build from being offered here as an update.
    in property <string> update-state: "idle";
    in property <bool> update-busy: false;
    // False when update.conf is not writable by the user the desktop runs as. The picker then
    // says what to type instead of offering a control that silently fails.
    in property <bool> update-can-set-channel: true;

    // AI Readiness
    in property <string> ai-model-name: "";
    in property <string> ai-model-tier: "";
    in property <string> ai-provider-status: "";
    in property <string> ai-capability-summary: "";

    callback back-pressed();
    callback check-updates();
    callback install-update();
    // The channel name to switch to. Goes to `yantrik-update set-channel`, which validates it
    // again and is the one writer of update.conf.
    callback set-channel(string);
    callback open-ai-settings();

    VerticalLayout {
        width: 100%;
        height: 100%;

        // -- Header --
        //
        // A 56px bar with its own back button, its own title type and its own padding, three
        // pixels taller than every app's and built from scratch to be almost the same.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "about";
            show-back: true;
            icon: Icons.chip;
            title: "About";
            subtitle: root.version-text != "" ? "Yantrik OS " + root.version-text : "";
            back => { root.back-pressed(); }
        }

        // ── Scrollable content ──
        Flickable {
            viewport-height: content-col.preferred-height + 40px;

            content-col := VerticalLayout {
                alignment: start;
                padding: 20px;
                spacing: 20px;

                // ── Logo / Identity section ──
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: logo-col.preferred-height;

                    logo-col := VerticalLayout {
                        padding: 24px;
                        spacing: 12px;
                        alignment: center;

                        // ── The mark and the wordmark ──
                        //
                        // This card is the one place in the OS whose entire job is to say what
                        // this is, and it did it with 28px amber letter-spaced text — no mark,
                        // in a colour the mark does not contain. Amber is this shell's warning
                        // and queue colour; it was never the brand.
                        //
                        // Set the way the boot screen sets it: the name solid in text-primary
                        // at 600, the category light in text-secondary at 300, ten pixels
                        // apart. The About box and the first screen of the machine now agree.
                        HorizontalLayout {
                            alignment: center;
                            spacing: 0;

                            YantrikMark {
                                mark-size: 56px;
                                y: (parent.height - self.height) / 2;
                            }
                            Rectangle { width: 16px; }
                            Text {
                                text: "Yantrik";
                                color: Theme.text-primary;
                                font-size: 34px;
                                font-weight: 600;
                                vertical-alignment: center;
                            }
                            Rectangle { width: 10px; }
                            Text {
                                text: "OS";
                                color: Theme.text-secondary;
                                font-size: 34px;
                                font-weight: 300;
                                vertical-alignment: center;
                            }
                        }

                        HorizontalLayout {
                            alignment: center;
                            spacing: 8px;

                            Rectangle {
                                width: v-label.preferred-width + 16px;
                                height: 24px;
                                border-radius: 12px;
                                background: Theme.tint-cyan;
                                border-width: 1px;
                                border-color: Theme.cyan-dim;

                                v-label := Text {
                                    // Not "v" + version: a git describe already starts with
                                    // the tag, so prefixing gave "vv0.1.0-258-g64165ad".
                                    text: root.version-text != "" ? root.version-text : "unknown";
                                    color: Theme.cyan;
                                    font-size: Theme.fs-micro;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Text {
                            text: "AI-native desktop shell";
                            color: Theme.text-dim;
                            font-size: Theme.font-small;
                            horizontal-alignment: center;
                        }
                    }
                }

                // ── DEVICE section header ──
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.cyan;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.cyan-glow;
                    }
                    Text {
                        text: "DEVICE";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                // ── Device info card ──
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: device-col.preferred-height;

                    device-col := VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        // Hostname row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Hostname";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.hostname;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Kernel row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Kernel";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.kernel;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // CPU row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "CPU";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.cpu-model;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                    overflow: elide;
                                    max-width: 500px;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // RAM row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "RAM";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.ram-total;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Disk row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Disk";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.disk-info;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── RUNTIME section header ──
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.amber;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.amber-glow;
                    }
                    Text {
                        text: "RUNTIME";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                // ── Runtime info card ──
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: runtime-col.preferred-height;

                    runtime-col := VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        // Uptime row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Uptime";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.uptime-text;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Build date row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Build Date";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.build-date;
                                    color: Theme.text-primary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── WHAT CHANGED section header ──
                //
                // The changelog the release bundle carries at share/CHANGELOG.md: the commit
                // subjects since the build published before this one. Shown only when the
                // bundle had one, so an old install does not get an empty heading.
                if root.changes.length > 0 : HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.accent-glow;
                    }
                    Text {
                        text: "WHAT CHANGED IN THIS BUILD";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }
                if root.changes.length > 0 : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: chg-col.preferred-height;
                    chg-col := VerticalLayout {
                        padding: 16px;
                        spacing: 6px;
                        for line in root.changes : Text {
                            text: "•  " + line;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            wrap: word-wrap;
                        }
                    }
                }
                // ── AI READINESS section header ──
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.accent;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.accent-glow;
                    }
                    Text {
                        text: "AI READINESS";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                    }
                }

                // AI Readiness card
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: ai-ready-col.preferred-height;

                    ai-ready-col := VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        // Model row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "AI Model";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: root.ai-model-name != "" ? root.ai-model-name : "Not configured";
                                        color: root.ai-model-name != "" ? AppIdentity.accent : Theme.text-dim;
                                        font-size: Theme.font-body;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                    }
                                    if root.ai-model-tier != "" : Rectangle {
                                        width: about-tier-txt.preferred-width + 12px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 10px;
                                        background: root.ai-model-tier == "Large" ? AppIdentity.tint
                                                  : root.ai-model-tier == "Medium" ? Theme.tint-cyan
                                                  : root.ai-model-tier == "Small" ? Theme.tint-amber
                                                  : Theme.border-default;
                                        about-tier-txt := Text {
                                            text: root.ai-model-tier;
                                            color: root.ai-model-tier == "Large" ? AppIdentity.accent
                                                 : root.ai-model-tier == "Medium" ? Theme.cyan
                                                 : root.ai-model-tier == "Small" ? Theme.amber
                                                 : Theme.text-secondary;
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Provider status row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Provider";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                HorizontalLayout {
                                    spacing: 8px;
                                    Rectangle {
                                        width: 8px;
                                        height: 8px;
                                        y: (parent.height - 8px) / 2;
                                        border-radius: 4px;
                                        background: root.ai-provider-status == "Connected" ? Theme.color-reminder
                                                  : root.ai-provider-status == "Disconnected" ? Theme.color-emotional
                                                  : Theme.text-dim;
                                    }
                                    Text {
                                        text: root.ai-provider-status != "" ? root.ai-provider-status : "Unknown";
                                        color: root.ai-provider-status == "Connected" ? Theme.color-reminder
                                             : root.ai-provider-status == "Disconnected" ? Theme.color-emotional
                                             : Theme.text-dim;
                                        font-size: Theme.font-body;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Capability summary row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Capabilities";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Text {
                                    text: root.ai-capability-summary != "" ? root.ai-capability-summary : "—";
                                    color: Theme.text-primary;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Open AI Settings link
                        TouchArea {
                            height: 44px;
                            clicked => { root.open-ai-settings(); }
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Open AI Settings";
                                    color: Theme.accent;
                                    font-size: Theme.font-body;
                                    font-weight: 500;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }
                                Icon {
                                    commands: Icons.arrow-right;
                                    size: 18px;
                                    tint: Theme.accent-dim;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }
                }

                // ── UPDATES section header ──
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.holo-blue;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.holo-blue.transparentize(75%);
                    }
                    Text {
                        text: "UPDATES";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                }

                // ── Updates card ──
                //
                // Channel, server, installed build, what the channel has, and the result — in
                // that order, because that is the order the questions get asked in when an
                // update does not arrive. Every field is what `yantrik-update` reports; the
                // screen states it and does not compute it.
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: upd-col.preferred-height;

                    upd-col := VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        // Channel row — visible AND changeable, which it was in neither sense
                        // before: no screen in this OS stated the channel, and no screen or
                        // command could change it short of editing update.conf by hand.
                        Rectangle {
                            height: 48px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 8px;
                                Text {
                                    text: "Channel";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                HorizontalLayout {
                                    spacing: 6px;
                                    alignment: end;
                                    ChannelChip {
                                        label: "nightly";
                                        selected: root.update-channel == "nightly";
                                        enabled: root.update-can-set-channel && !root.update-busy;
                                        y: (parent.height - self.height) / 2;
                                        picked => { root.set-channel("nightly"); }
                                    }
                                    ChannelChip {
                                        label: "beta";
                                        selected: root.update-channel == "beta";
                                        enabled: root.update-can-set-channel && !root.update-busy;
                                        y: (parent.height - self.height) / 2;
                                        picked => { root.set-channel("beta"); }
                                    }
                                    ChannelChip {
                                        label: "stable";
                                        selected: root.update-channel == "stable";
                                        enabled: root.update-can-set-channel && !root.update-busy;
                                        y: (parent.height - self.height) / 2;
                                        picked => { root.set-channel("stable"); }
                                    }
                                }
                            }
                        }

                        // Why the picker is inert, when it is. A disabled control with no
                        // explanation is the same defect as a control that does nothing.
                        if !root.update-can-set-channel : Rectangle {
                            height: chan-note.preferred-height + 8px;
                            chan-note := Text {
                                text: "The update settings file is not writable by this desktop. "
                                    + "From a terminal: sudo yantrik-update set-channel <name>";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                wrap: word-wrap;
                                x: 4px;
                                width: parent.width - 8px;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Server row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Server";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.update-host != "" ? root.update-host : "—";
                                    color: Theme.text-primary;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // Installed row
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Installed";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.update-installed != "" ? root.update-installed : "—";
                                    color: Theme.text-primary;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // What the channel has. An em dash until a check has answered — it is
                        // not known before then, and a blank that looks like a value is a lie
                        // with better manners.
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                Text {
                                    text: "Channel has";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    vertical-alignment: center;
                                    horizontal-stretch: 1;
                                }
                                Text {
                                    text: root.update-latest != "" ? root.update-latest : "—";
                                    color: root.update-state == "available" ? Theme.holo-blue : Theme.text-primary;
                                    font-size: Theme.font-small;
                                    vertical-alignment: center;
                                }
                            }
                        }
                        Rectangle { height: 1px; background: Theme.border-subtle; }

                        // The result, in the updater's own words. "up to date", "update
                        // available", "nothing to update — this machine is ahead of the
                        // channel", "channel 'beta' is not published", "cannot reach
                        // releases.yantrikos.com" — five different sentences, where this screen
                        // used to have one.
                        //
                        // "ahead" is the one that used to arrive dressed as "available": a
                        // channel behind this machine was offered as an update, with the Install
                        // button under it. It is coloured like up-to-date, because like
                        // up-to-date it asks nothing of anyone — and the button below stays
                        // hidden, because there is nothing to install.
                        if root.update-status != "" : Rectangle {
                            height: upd-status.preferred-height + 20px;
                            upd-status := Text {
                                text: root.update-status;
                                color: root.update-state == "up-to-date" ? Theme.color-reminder
                                     : root.update-state == "ahead" ? Theme.color-reminder
                                     : root.update-state == "available" ? Theme.holo-blue
                                     : root.update-state == "failed" ? Theme.color-emotional
                                     : root.update-state == "not-published" ? Theme.amber
                                     : Theme.text-dim;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                                x: 4px;
                                y: 10px;
                                width: parent.width - 8px;
                            }
                        }

                        // Buttons
                        Rectangle {
                            height: 44px;
                            HorizontalLayout {
                                padding-left: 4px;
                                padding-right: 4px;
                                spacing: 8px;
                                alignment: start;

                                Rectangle {
                                    width: check-btn-text.preferred-width + 24px;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 15px;
                                    background: check-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                                    border-width: 1px;
                                    border-color: Theme.border-subtle;
                                    opacity: root.update-busy ? 0.5 : 1.0;

                                    check-btn-text := Text {
                                        text: root.update-busy ? "Checking…" : "Check for updates";
                                        font-size: Theme.fs-micro;
                                        font-weight: 500;
                                        color: Theme.text-secondary;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    check-ta := TouchArea {
                                        enabled: !root.update-busy;
                                        mouse-cursor: self.enabled ? MouseCursor.pointer : MouseCursor.default;
                                        clicked => { root.check-updates(); }
                                    }
                                }

                                // Only when there is something to install. A permanently
                                // present Install button on a current machine is a control
                                // with nothing behind it.
                                if root.update-state == "available" : Rectangle {
                                    width: install-btn-text.preferred-width + 24px;
                                    height: 30px;
                                    y: (parent.height - self.height) / 2;
                                    border-radius: 15px;
                                    background: install-ta.has-hover
                                        ? Theme.holo-blue.transparentize(70%)
                                        : Theme.holo-blue.transparentize(85%);
                                    border-width: 1px;
                                    border-color: Theme.holo-blue.transparentize(50%);

                                    install-btn-text := Text {
                                        text: "Install";
                                        font-size: Theme.fs-micro;
                                        font-weight: 600;
                                        color: Theme.holo-blue;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    install-ta := TouchArea {
                                        mouse-cursor: MouseCursor.pointer;
                                        clicked => { root.install-update(); }
                                    }
                                }
                            }
                        }
                    }
                }

                // ── COMPONENTS section header ──
                HorizontalLayout {
                    spacing: 8px;
                    Rectangle {
                        width: 3px; height: 14px;
                        border-radius: 1.5px;
                        background: Theme.holo-blue;
                        drop-shadow-blur: 4px;
                        drop-shadow-color: Theme.holo-blue.transparentize(75%);
                    }
                    Text {
                        text: "COMPONENTS";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        letter-spacing: 2px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "installed";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                    }
                }

                // ── Components card ──
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.separator;
                    height: comp-col.preferred-height;

                    comp-col := VerticalLayout {
                        padding: 16px;
                        spacing: 0px;

                        for comp[idx] in root.components : VerticalLayout {
                            spacing: 0px;

                            Rectangle {
                                height: 48px;

                                HorizontalLayout {
                                    padding-left: 4px;
                                    padding-right: 4px;
                                    spacing: 8px;

                                    // Component name
                                    Text {
                                        text: comp.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.font-body;
                                        font-weight: 500;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }

                                    // Current version. No "available" badge beside it: see the
                                    // note on ComponentVersionData — nothing publishes
                                    // per-component versions, so nothing here can know.
                                    Text {
                                        text: comp.current-version;
                                        color: Theme.text-secondary;
                                        font-size: Theme.font-small;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Separator between items (not after last)
                            if idx < root.components.length - 1 : Rectangle {
                                height: 1px;
                                background: Theme.border-subtle;
                            }
                        }
                    }
                }

                // The update status used to be repeated down here, under the component list,
                // where it described a check of the components. It says one thing now, in the
                // card of the thing it is about.

                // Bottom spacer
                Rectangle {
                    height: 40px;
                }
            }
        }
    }
}
