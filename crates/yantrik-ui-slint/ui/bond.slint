// Interaction history (the old Bond screen).
// Plain facts about use: how many turns of conversation, over how many days. Nothing else.
//
// It used to show a level ("Partner-in-Crime, Level 5 of 5"), the formula that scored it, a streak
// ("6 days in a row"), a count of messages that said how you felt and a humor rate. The design
// rules ban all five (no manufactured pull: no score to grind, no run to keep up, nothing counted
// about a person's feelings), and Pranab and Astra had already decided the screen is "Interaction
// history, not relationship gamification". The sweep of 17 October found them still drawn
// (design/ui-sweep-2026-10-17.md, root cause 2). The companion still keeps its bond state in its
// own store, where its voice and wording read it; this screen does not draw it.

import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";

export struct BondData {
    // False until the companion worker has pushed the store's bond once. Until it is true there
    // is nothing measured to show, and the screen says so rather than drawing zeros.
    loaded: bool,
    // Read by `describe shell` (control.rs `describe_bond`), not drawn here.
    bond-score: float,
    bond-level: string,
    total-interactions: int,
    // Calendar days from the first conversation, the first day counted as one.
    days-together: int,
}

export component BondScreen inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    in property <BondData> data;
    callback back-pressed();

    background: Theme.bg-deep;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // Was a hand-rolled bar whose back button was the CHARACTER "left arrow" in a TouchArea.
        // A glyph is only an icon if the font has it; the same habit put an emoji in the Memory
        // browser's search field, where it drew as nothing and made the whole field look blank.
        // AppHeader's back button is a stroke path from the Icons set.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "bond";
            show-back: true;
            icon: Icons.bond;
            title: "Interaction history";
            back => { root.back-pressed(); }
        }

        Flickable {
            vertical-stretch: 1;
            // The viewport is the view's width, so the column fills the screen rather than sitting
            // in a ribbon down the left at its own preferred width.
            viewport-width: self.width;

            VerticalLayout {
                width: parent.width;
                padding: 24px;
                spacing: Theme.sp-4;
                alignment: start;

                // One sentence on top: what is true, in words.
                Text {
                    text: !data.loaded ? "Not read yet: the companion has not reported its history since the desktop started."
                        : data.total-interactions == 0 ? "You have not talked with the companion yet."
                        : "You have talked with the companion " + data.total-interactions
                            + (data.total-interactions == 1 ? " time" : " times") + " over "
                            + data.days-together + (data.days-together == 1 ? " day." : " days.");
                    color: data.loaded ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.fs-title-1;
                    font-weight: 600;
                    wrap: word-wrap;
                }
                Text {
                    text: "Counted from use. It says nothing about how well a mind understands you, or what it may do.";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                }

                if data.loaded : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: stats-layout.preferred-height;

                    stats-layout := HorizontalLayout {
                        padding: 16px;
                        spacing: 16px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: data.total-interactions;
                                color: Theme.text-primary;
                                font-size: Theme.fs-display;
                                font-weight: 600;
                            }
                            Text {
                                text: "turns of conversation with the companion";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }

                        VerticalLayout {
                            horizontal-stretch: 1;
                            Text {
                                text: data.days-together;
                                color: Theme.text-primary;
                                font-size: Theme.fs-display;
                                font-weight: 600;
                            }
                            Text {
                                text: data.days-together == 1 ? "day since your first conversation, counting that day"
                                    : "days since your first conversation, counting that day";
                                color: Theme.text-secondary;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }
    }
}
