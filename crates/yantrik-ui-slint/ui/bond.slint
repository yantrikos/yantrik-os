// Interaction history (the Bond screen).
// Shows the usage-derived level, how it was counted, and the plain counts it was counted from.
// Headed "Interaction history", not "Bond", and the level labelled as derived from use (review of
// the UI overhaul by GPT-6 Astra, H): it counts conversation, and says nothing about whether a
// mind understands the person, can be relied on, or may do anything. The scoring is unchanged.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";

export struct BondData {
    // False until the companion worker has pushed the store's bond once. This struct's Slint
    // default used to read "Stranger, 0.0", and the machine rail and `describe shell` showed
    // that as the relationship for the window between boot and the first push — two minutes
    // after a restart, over a store that said Partner-in-Crime. Until this is true there is
    // no level to show, and nothing below is to be read as one.
    loaded: bool,
    bond-score: float,
    bond-level: string,
    // What this level changes about how the companion talks, in one short line.
    bond-description: string,
    // Which of the five levels, 1 (Stranger) to 5 (Partner-in-Crime): "Level 4 of 5".
    level-number: int,
    total-interactions: int,
    days-together: int,
    humor-rate: float,
    shared-references: int,
}

export component BondScreen inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    in property <BondData> data;
    callback back-pressed();

    // The decimal score and the counting rules are folded away by default: a visible
    // number invites grinding, and the level name plus what it changes is the honest
    // version (design/ux-psychology-2026-10-11.md, "What we will not build").
    in-out property <bool> details-open: false;

    background: Theme.bg-deep;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // Was a hand-rolled bar whose back button was the CHARACTER "left arrow" in a TouchArea.
        // A glyph is only an icon if the font has it; the same habit put an emoji in the Memory
        // browser's search field, where it drew as nothing and made the whole field look blank.
        // AppHeader's back button is a stroke path from the Icons set.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "bond";
            show-back: true;
            icon: Icons.bond;
            title: "Interaction history";
            back => { root.back-pressed(); }
        }

        // Scrollable content
        Flickable {
            vertical-stretch: 1;
            // Without this the column lays itself out at its own preferred width and the stats
            // card sits in a ribbon down the left, leaving the right half of the screen empty.
            // A Flickable's viewport defaults to the size its CONTENT asks for, not the size of
            // the view -- which is right for the scrolling axis and wrong for the other one.
            viewport-width: self.width;

            VerticalLayout {
                width: parent.width;
                padding: 24px;
                // The level block and the stats card: the derivation ends 16px above the card.
                spacing: Theme.sp-4;
                alignment: start;

                // The level, and where it comes from.
                //
                // There was a full ring here with "5 / 5.0" in it, over counts like "0% humor
                // rate" — a finished circle whose denominator nobody could see or check. The
                // level now says which of five it is and what it was counted from, and the line
                // under it says how, from `BondTracker::score_interaction` (yantrik-companion's
                // bond.rs) and `BondLevel::from_score`: change those and this line with them.
                if data.loaded : VerticalLayout {
                    spacing: 6px;
                    Text {
                        text: data.bond-level;
                        // A heading, not a state: primary text. Amber is only "needs you".
                        color: Theme.text-primary;
                        font-size: Theme.fs-display;
                        font-weight: 600;
                        horizontal-alignment: center;
                        letter-spacing: 1px;
                    }
                    Text {
                        text: "Usage-derived level \u{b7} not a measure of understanding, reliability or permissions";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: data.bond-description;
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "Level " + data.level-number + " of 5 · from "
                            + data.total-interactions + (data.total-interactions == 1 ? " interaction" : " interactions")
                            + " over " + data.days-together + (data.days-together == 1 ? " day" : " days");
                        color: Theme.text-secondary;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                    }

                    // Details, folded away by default: the decimal score and how it is counted.
                    // A visible number invites grinding, so the level name and what it changes are
                    // the main view; the curious can open this (design/ux-psychology-2026-10-11.md).
                    Rectangle {
                        height: details-col.preferred-height;
                        details-col := VerticalLayout {
                            spacing: Theme.sp-2;
                            Rectangle {
                                height: Theme.h-regular;
                                accessible-role: button;
                                accessible-label: "Details";
                                accessible-expanded: root.details-open;
                                HorizontalLayout {
                                    spacing: Theme.sp-1h;
                                    alignment: start;
                                    Icon {
                                        commands: root.details-open ? Icons.chevron-down : Icons.chevron-right;
                                        size: Theme.wr-glyph;
                                        tint: Theme.text-secondary;
                                    }
                                    Text {
                                        text: "Details";
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-title-2;
                                        font-weight: Theme.fw-headline;
                                        vertical-alignment: center;
                                    }
                                }
                                TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.details-open = !root.details-open; }
                                }
                            }
                            if root.details-open : VerticalLayout {
                                spacing: 2px;
                                for line in [
                                    "How this is counted:",
                                    "Each conversation turn adds 0.01 to a score.",
                                    "A longer message adds up to 0.02 more.",
                                    "Laughing at a joke (\"haha\", \"lol\") adds 0.02.",
                                    "The score stops at 5.0 and sets the level:",
                                    "Stranger below 0.5, Acquaintance below 1.5, Friend below 2.5, Confidant below 3.5, Partner-in-Crime from 3.5.",
                                    "It is " + Math.round(data.bond-score * 100) / 100 + " now."
                                ] : Text {
                                    text: line;
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-label;
                                    horizontal-alignment: left;
                                    wrap: word-wrap;
                                }
                            }
                        }
                    }
                }

                // Stats grid (2 columns)
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: stats-layout.preferred-height;

                    stats-layout := VerticalLayout {
                        padding: 16px;
                        spacing: 12px;

                        // Row 1
                        HorizontalLayout {
                            spacing: 16px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: data.total-interactions;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-display;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "interactions";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: data.days-together;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-display;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "days together";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                            }
                        }

                        // Row 2
                        HorizontalLayout {
                            spacing: 16px;

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: @tr("{}%", Math.round(data.humor-rate * 100));
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-display;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "humor rate";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                Text {
                                    text: data.shared-references;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-display;
                                    font-weight: 600;
                                }
                                Text {
                                    text: "shared refs";
                                    color: Theme.text-secondary;
                                    font-size: Theme.font-small;
                                }
                            }
                        }
                    }
                }
            }
        }
    }
}
