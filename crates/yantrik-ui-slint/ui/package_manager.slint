// Package Manager — Debian packages and Flathub apps.
// Screen 21. Search, browse, install, remove, upgrade. Every row carries its source, because a
// Debian package and a Flatpak are installed, removed and updated by different commands (#399).
// Wrapped in WindowFrame by app.slint, which draws no bar of its own over it
// (content-has-controls): this screen's AppHeader is the window's one bar.
// Firelight treatment: glassmorphism, holographic glows, gradient accents.

import { Theme } from "theme.slint";
import { AppIdentity } from "components/app_color.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppAction, AppHeader } from "components/app_header.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { YStatusPill } from "components/y_status_pill.slint";
import { ListView } from "std-widgets.slint";

export struct PackageData {
    // What the commands take: the package name, or a Flatpak's app id.
    id: string,
    // What the list shows: the same as `id` for Debian, the app's own name for a Flatpak.
    name: string,
    version: string,
    description: string,
    installed: bool,
    upgradable: bool,
    size-text: string,
    repo: string,
    // "debian" or "flathub".
    source: string,
}

export struct PendingAction {
    package-name: string,
    action-type: string,   // "install", "remove", "upgrade"
}

export component PackageManager inherits Rectangle {
    // The window's own buttons, carried in this screen's AppHeader now that its WindowFrame no
    // longer draws a bar above it (content-has-controls). Without them this screen, hosted
    // restored or maximised, would have no minimise, restore or close at all.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();
    callback back-pressed();

    background: transparent;

    in property <[PackageData]> packages: [];
    in property <bool> is-loading: false;
    in property <string> status-text: "Ready";
    in property <int> upgradable-count: 0;
    in property <[PendingAction]> pending-actions: [];
    in property <bool> is-applying: false;
    in property <float> apply-progress: 0.0;
    in property <string> error-text: "";

    // Detail panel
    in property <string> detail-id: "";
    in property <string> detail-source: "";
    in property <string> detail-name: "";
    in property <string> detail-version: "";
    in property <string> detail-description: "";
    in property <string> detail-maintainer: "";
    in property <string> detail-dependencies: "";
    in property <string> detail-size: "";
    in property <string> detail-repo: "";
    in property <bool> detail-installed: false;
    in property <bool> detail-upgradable: false;

    in-out property <string> search-query: "";
    in-out property <int> selected-index: -1;
    in-out property <int> active-filter: 0;  // 0=All, 1=Installed, 2=Upgradable, 3=Available

    callback search(string);
    callback refresh();
    callback select-package(int);
    callback install-package(string);
    callback remove-package(string);
    callback upgrade-package(string);
    callback upgrade-all();
    callback apply-changes();
    callback cancel-changes();
    callback filter-changed(int);

    // AI Assist
    in property <bool> ai-is-working: false;
    in property <string> ai-response: "";
    in-out property <bool> ai-panel-open: false;
    callback ai-explain-pressed();
    callback ai-intent(string);
    callback ai-dismiss();

    // The header's verbs. AI Explain needs a package open to explain; Upgrade All is the screen's
    // one primary action, and only there when something can be upgraded.
    property <AppAction> ai-action: {
        id: "ai", icon: Icons.spark, label: root.ai-is-working ? "Analyzing" : "AI Explain", emphasis: 1,
        loading: root.ai-is-working, active: root.ai-panel-open,
        disabled: root.detail-name == "" && !root.ai-panel-open,
    };
    property <AppAction> refresh-action: { id: "refresh", icon: Icons.refresh, label: "Refresh", loading: root.is-loading };
    property <[AppAction]> actions-plain: [root.ai-action, root.refresh-action];
    property <[AppAction]> actions-with-upgrade: [
        root.ai-action, root.refresh-action,
        { id: "upgrade-all", icon: Icons.download, label: "Upgrade All", emphasis: 2 },
    ];

    // ── Layout: header + list/detail + pending queue + status ──
    VerticalLayout {
        // ── Header ──
        //
        // VM 520 sweep, 4 October: Packages had no title at all -- its top row was a search
        // field and filter chips, so nothing on screen said which app this was, and there was
        // no back arrow. It wears the shared AppHeader now, as Settings and Bond do: the search
        // is the header's own field, and the verbs (AI Explain, Refresh, Upgrade All) are its
        // actions. The filter chips change what the list shows, so they keep a row under it.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "packages";
            show-back: true;
            icon: Icons.packages;
            title: "Packages";
            subtitle: "Debian packages and Flathub apps";
            show-search: true;
            search-placeholder: "Search packages and apps";
            search-text <=> root.search-query;
            search-edited(text) => { root.search(text); }
            actions: root.upgradable-count > 0 ? root.actions-with-upgrade : root.actions-plain;
            back => { root.back-pressed(); }
            action(id) => {
                if (id == "ai") {
                    if (root.ai-panel-open) {
                        root.ai-dismiss();
                        root.ai-panel-open = false;
                    } else if (root.detail-name != "") {
                        root.ai-explain-pressed();
                        root.ai-panel-open = true;
                    }
                } else if (id == "refresh") {
                    root.refresh();
                } else if (id == "upgrade-all") {
                    root.upgrade-all();
                }
            }
        }

        // ── Filters ──
        Rectangle {
            height: 44px;
            background: Theme.bg-card;
            border-radius: 0;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                spacing: 10px;
                alignment: start;

                // Filter: All
                Rectangle {
                    width: 56px;
                    height: 32px;
                    background: root.active-filter == 0 ? Theme.accent-glow : Theme.hover-fill;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: root.active-filter == 0 ? Theme.accent-dim : transparent;

                    Text {
                        text: "All";
                        font-size: Theme.font-small;
                        color: root.active-filter == 0 ? AppIdentity.accent : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.active-filter = 0;
                            root.filter-changed(0);
                        }
                    }
                }

                // Filter: Installed
                Rectangle {
                    width: 80px;
                    height: 32px;
                    background: root.active-filter == 1 ? Theme.accent-glow : Theme.hover-fill;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: root.active-filter == 1 ? Theme.accent-dim : transparent;

                    Text {
                        text: "Installed";
                        font-size: Theme.font-small;
                        color: root.active-filter == 1 ? AppIdentity.accent : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.active-filter = 1;
                            root.filter-changed(1);
                        }
                    }
                }

                // Filter: Upgradable
                Rectangle {
                    width: root.upgradable-count > 0 ? 108px : 90px;
                    height: 32px;
                    background: root.active-filter == 2 ? Theme.accent-glow : Theme.hover-fill;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: root.active-filter == 2 ? Theme.accent-dim : transparent;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 4px;

                        Text {
                            text: "Upgradable";
                            font-size: Theme.font-small;
                            color: root.active-filter == 2 ? AppIdentity.accent : Theme.text-secondary;
                            vertical-alignment: center;
                        }

                        if root.upgradable-count > 0 : Rectangle {
                            width: 22px;
                            height: 18px;
                            background: Theme.holo-blue;
                            border-radius: 9px;

                            Text {
                                text: root.upgradable-count;
                                font-size: Theme.fs-micro;
                                color: Theme.text-on-accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    TouchArea {
                        clicked => {
                            root.active-filter = 2;
                            root.filter-changed(2);
                        }
                    }
                }

                // Filter: Available (not installed)
                Rectangle {
                    width: 76px;
                    height: 32px;
                    background: root.active-filter == 3 ? Theme.accent-glow : Theme.hover-fill;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: root.active-filter == 3 ? Theme.accent-dim : transparent;

                    Text {
                        text: "Available";
                        font-size: Theme.font-small;
                        color: root.active-filter == 3 ? AppIdentity.accent : Theme.text-secondary;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }

                    TouchArea {
                        clicked => {
                            root.active-filter = 3;
                            root.filter-changed(3);
                        }
                    }
                }
            }
        }

        // ── Separator ──
        Rectangle { height: 1px; background: Theme.separator; }

        // ── AI Response Panel ──
        if root.ai-panel-open && root.ai-response != "" : Rectangle {
            height: min(180px, ai-pkg-resp.preferred-height + 16px);
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.accent.transparentize(70%);

            Flickable {
                viewport-height: ai-pkg-resp.preferred-height + 16px;

                ai-pkg-resp := VerticalLayout {
                    alignment: start;
                    padding: 12px;
                    spacing: 8px;

                    HorizontalLayout {
                        spacing: 6px;
                        Icon {
                            commands: Icons.spark;
                            size: 12px;
                            tint: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "AI Analysis";
                            color: Theme.accent;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Rectangle { horizontal-stretch: 1; }
                        TouchArea {
                            width: 24px;
                            height: 24px;
                            clicked => {
                                root.ai-panel-open = false;
                                root.ai-dismiss();
                            }
                            Rectangle {
                                width: 24px; height: 24px;
                                border-radius: 12px;
                                background: parent.has-hover ? Theme.hover-fill : transparent;
                                Icon {
                                    commands: Icons.close;
                                    size: 12px;
                                    tint: Theme.text-dim;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }
                        }
                    }

                    Text {
                        text: root.ai-response;
                        color: Theme.text-primary;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                    }
                }
            }
        }

        // ── Main Content: Package List + Detail Panel ──
        HorizontalLayout {
            vertical-stretch: 1;

            // ── Package List ──
            Rectangle {
                horizontal-stretch: 3;
                background: Theme.bg-surface;

                VerticalLayout {
                    // Loading indicator
                    if root.is-loading : Rectangle {
                        height: 3px;
                        background: Theme.accent-glow;

                        // Animated loading bar
                        Rectangle {
                            height: 3px;
                            width: parent.width * 0.4;
                            background: Theme.accent;
                            border-radius: 1px;
                            x: mod(animation-tick() / 8ms, parent.width / 1px + self.width / 1px) * 1px - self.width;
                        }
                    }

                    // Still reading, and nothing read yet.
                    //
                    // VM 520 sweep, 4 October: while "Updating package database…" ran, the list
                    // was a 3px moving stripe over an empty pane -- indistinguishable from a
                    // screen that had failed. It says what it is doing now, in the empty-state
                    // style Files and Memory use. The list itself fills in as soon as what is
                    // installed has been read (wire/package_manager.rs lists that before it
                    // asks the mirrors), so this is only ever the first second or two.
                    if packages.length == 0 && root.is-loading : YEmptyState {
                        vertical-stretch: 1;
                        icon-path: Icons.packages;
                        title: "Reading your packages";
                        description: root.status-text + " What is installed shows here as soon as it has been read.";
                    }

                    // Nothing to show
                    if packages.length == 0 && !root.is-loading : YEmptyState {
                        vertical-stretch: 1;
                        icon-path: root.search-query != "" || root.active-filter == 3 ? Icons.search : Icons.packages;
                        title: root.search-query != "" ? "No packages found"
                            : root.active-filter == 3 ? "Find something to install"
                            : "No packages listed";
                        description: root.search-query != "" ? "Try a different search term."
                            : root.active-filter == 3 ? "Search Flathub apps and Debian packages by name."
                            : "Press Refresh to read what is installed, or search for a package by name.";
                    }

                    // Package list
                    if packages.length > 0 : ListView {
                        vertical-stretch: 1;

                        for pkg[idx] in root.packages : Rectangle {
                            height: 56px;
                            background: idx == root.selected-index ? Theme.bg-selected
                                : row-ta.has-hover ? Theme.hover-fill : transparent;

                            // A fixed grid, left-aligned at 16px: status 16, name and description
                            // flexible, source pill, tag pill, size 72 right-aligned, state 96. Every
                            // column is the same width on every row, so the names read down one
                            // edge. The row used to centre its content on its own width, and the
                            // name drifted by up to 90px from one row to the next.
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;
                                alignment: start;

                                // Status: an 8px dot in its 16px column. Installed is a neutral
                                // fill, not the success teal, which is the minds' colour; the state
                                // pill says the word.
                                Rectangle {
                                    width: 16px;

                                    Rectangle {
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        width: 8px;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: pkg.upgradable ? Theme.holo-blue
                                            : pkg.installed ? Theme.text-secondary
                                            : transparent;
                                        border-width: pkg.upgradable || pkg.installed ? 0px : 1px;
                                        border-color: Theme.text-dim;
                                    }
                                }

                                // Name + description: the one flexible column.
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    min-width: 0px;
                                    alignment: center;
                                    spacing: 2px;

                                    HorizontalLayout {
                                        spacing: 8px;

                                        Text {
                                            text: pkg.name;
                                            font-size: Theme.font-body;
                                            font-weight: 600;
                                            color: Theme.text-primary;
                                            overflow: elide;
                                        }

                                        Text {
                                            text: pkg.version;
                                            font-size: Theme.font-small;
                                            color: Theme.text-dim;
                                            vertical-alignment: center;
                                        }
                                    }

                                    Text {
                                        text: pkg.description;
                                        font-size: Theme.font-small;
                                        color: Theme.text-secondary;
                                        overflow: elide;
                                    }
                                }

                                // Source pill: which store the row is from, so a Flatpak and a
                                // Debian package of the same name are never mistaken for each other.
                                // In a fixed slot, so the tag after it starts at one x.
                                Rectangle {
                                    width: 64px;

                                    Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: source-text.preferred-width + 14px;
                                        height: 20px;
                                        background: pkg.source == "flathub" ? AppIdentity.accent.transparentize(80%) : Theme.hover-fill;
                                        border-radius: 10px;
                                        border-width: 1px;
                                        border-color: pkg.source == "flathub" ? AppIdentity.accent.transparentize(50%) : transparent;

                                        source-text := Text {
                                            text: pkg.source == "flathub" ? "Flathub" : "Debian";
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            color: pkg.source == "flathub" ? AppIdentity.accent : Theme.text-secondary;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Tag pill: the Debian section or the Flatpak branch. The slot stays
                                // when a row has none, so the columns after it do not move.
                                Rectangle {
                                    width: 72px;

                                    if pkg.repo != "" : Rectangle {
                                        x: 0;
                                        y: (parent.height - self.height) / 2;
                                        width: min(parent.width, repo-text.preferred-width + 12px);
                                        height: 20px;
                                        background: Theme.hover-fill;
                                        border-radius: 10px;

                                        repo-text := Text {
                                            width: parent.width - 12px;
                                            text: pkg.repo;
                                            font-size: Theme.fs-micro;
                                            color: Theme.text-dim;
                                            overflow: elide;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Size, right-aligned so the figures line up by their last digit.
                                Text {
                                    width: 72px;
                                    text: pkg.size-text;
                                    font-size: Theme.font-small;
                                    color: Theme.text-dim;
                                    overflow: elide;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                // State. Installed is the kit's neutral outline pill: the word
                                // carries the state. Upgradable keeps the accent, because it is an
                                // action waiting to be taken.
                                Rectangle {
                                    width: 96px;

                                    if pkg.upgradable : Rectangle {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        height: 22px;
                                        background: Theme.accent-dim;
                                        border-radius: 11px;
                                        border-width: 1px;
                                        border-color: AppIdentity.accent.transparentize(60%);

                                        Text {
                                            text: "Upgradable";
                                            font-size: Theme.fs-micro;
                                            color: Theme.holo-blue;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    if !pkg.upgradable && pkg.installed : YStatusPill {
                                        y: (parent.height - self.height) / 2;
                                        width: parent.width;
                                        text: "Installed";
                                    }
                                }
                            }

                            // Subtle separator
                            Rectangle {
                                y: parent.height - 1px;
                                height: 1px;
                                background: Theme.separator;
                            }

                            row-ta := TouchArea {
                                clicked => {
                                    root.selected-index = idx;
                                    root.select-package(idx);
                                }
                            }
                        }
                    }
                }
            }

            // ── Vertical separator ──
            Rectangle { width: 1px; background: Theme.separator; }

            // ── Detail Panel ──
            Rectangle {
                horizontal-stretch: 2;
                background: Theme.bg-card;

                if root.detail-name == "" : VerticalLayout {
                    alignment: center;
                    spacing: 8px;

                    Text {
                        text: "Select a package";
                        font-size: Theme.font-title;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }

                    Text {
                        text: "to view details";
                        font-size: Theme.font-small;
                        color: Theme.text-dim;
                        horizontal-alignment: center;
                    }
                }

                if root.detail-name != "" : Flickable {
                    viewport-height: detail-content.preferred-height;

                    detail-content := VerticalLayout {
                        alignment: start;
                        padding: 24px;
                        spacing: 16px;

                        // Package header
                        HorizontalLayout {
                            spacing: 12px;

                            // Icon placeholder
                            Rectangle {
                                width: 48px;
                                height: 48px;
                                background: Theme.accent-glow;
                                border-radius: Theme.radius-card;

                                Icon {
                                    commands: Icons.packages;
                                    size: 20px;
                                    tint: Theme.text-secondary;
                                    x: (parent.width - self.width) / 2;
                                    y: (parent.height - self.height) / 2;
                                }
                            }

                            VerticalLayout {
                                horizontal-stretch: 1;
                                spacing: 4px;

                                Text {
                                    text: root.detail-name;
                                    font-size: Theme.fs-display;
                                    font-weight: 700;
                                    color: Theme.text-primary;
                                }

                                Text {
                                    text: root.detail-version;
                                    font-size: Theme.font-body;
                                    color: Theme.text-secondary;
                                }
                            }
                        }

                        // Action buttons
                        HorizontalLayout {
                            spacing: 8px;

                            // Install button — only when not installed
                            if !root.detail-installed : Rectangle {
                                width: 100px;
                                height: 36px;
                                background: install-ta.has-hover ? Theme.color-success.brighter(20%) : Theme.color-success;
                                border-radius: Theme.radius-pill;

                                Text {
                                    text: "Install";
                                    font-size: Theme.font-body;
                                    color: Theme.text-on-accent;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                install-ta := TouchArea {
                                    clicked => { root.install-package(root.detail-id); }
                                }
                            }

                            // Upgrade button — only when upgradable
                            if root.detail-upgradable : Rectangle {
                                width: 100px;
                                height: 36px;
                                background: upg-ta.has-hover ? Theme.accent-button-hover : Theme.accent;
                                border-radius: Theme.radius-pill;

                                Text {
                                    text: "Upgrade";
                                    font-size: Theme.font-body;
                                    color: Theme.text-on-accent;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                upg-ta := TouchArea {
                                    clicked => { root.upgrade-package(root.detail-id); }
                                }
                            }

                            // Remove button — when installed (regardless of upgradable)
                            if root.detail-installed : Rectangle {
                                width: 100px;
                                height: 36px;
                                background: remove-ta.has-hover ? Theme.destructive-hover : Theme.destructive;
                                border-radius: Theme.radius-pill;

                                Text {
                                    text: "Remove";
                                    font-size: Theme.font-body;
                                    color: Theme.text-on-danger;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                remove-ta := TouchArea {
                                    clicked => { root.remove-package(root.detail-id); }
                                }
                            }
                        }

                        // Separator
                        Rectangle { height: 1px; background: Theme.separator; }

                        // Description
                        if root.detail-description != "" : VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Description";
                                font-size: Theme.font-small;
                                font-weight: 600;
                                color: Theme.text-dim;
                            }

                            Text {
                                text: root.detail-description;
                                font-size: Theme.font-body;
                                color: Theme.text-primary;
                                wrap: word-wrap;
                            }
                        }

                        // Info grid
                        VerticalLayout {
                            spacing: 12px;

                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Source:";
                                    font-size: Theme.font-small;
                                    color: Theme.text-dim;
                                    width: 100px;
                                }
                                Text {
                                    text: root.detail-source == "flathub"
                                        ? "Flathub — a sandboxed app, installed for this account only"
                                        : "Debian — a system package";
                                    font-size: Theme.font-small;
                                    color: root.detail-source == "flathub" ? AppIdentity.accent : Theme.text-secondary;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }

                            if root.detail-id != "" && root.detail-id != root.detail-name : HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "App ID:";
                                    font-size: Theme.font-small;
                                    color: Theme.text-dim;
                                    width: 100px;
                                }
                                Text {
                                    text: root.detail-id;
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }

                            if root.detail-repo != "" : HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Repository:";
                                    font-size: Theme.font-small;
                                    color: Theme.text-dim;
                                    width: 100px;
                                }
                                Text {
                                    text: root.detail-repo;
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                }
                            }

                            if root.detail-size != "" : HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Size:";
                                    font-size: Theme.font-small;
                                    color: Theme.text-dim;
                                    width: 100px;
                                }
                                Text {
                                    text: root.detail-size;
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                }
                            }

                            if root.detail-maintainer != "" : HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Maintainer:";
                                    font-size: Theme.font-small;
                                    color: Theme.text-dim;
                                    width: 100px;
                                }
                                Text {
                                    text: root.detail-maintainer;
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                    wrap: word-wrap;
                                    horizontal-stretch: 1;
                                }
                            }
                        }

                        // Dependencies
                        if root.detail-dependencies != "" : VerticalLayout {
                            spacing: 8px;

                            Text {
                                text: "Dependencies";
                                font-size: Theme.font-small;
                                font-weight: 600;
                                color: Theme.text-dim;
                            }

                            Text {
                                text: root.detail-dependencies;
                                font-size: Theme.font-small;
                                color: Theme.text-secondary;
                                wrap: word-wrap;
                            }
                        }

                        // Spacer
                        Rectangle { vertical-stretch: 1; }
                    }
                }
            }
        }

        // ── Pending Actions Queue ──
        if root.pending-actions.length > 0 : Rectangle {
            max-height: 140px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;

            pending-layout := VerticalLayout {
                padding: 10px;
                padding-left: 16px;
                padding-right: 16px;
                spacing: 6px;

                // Header row
                HorizontalLayout {
                    spacing: 8px;
                    alignment: space-between;

                    HorizontalLayout {
                        spacing: 6px;

                        Text {
                            text: "Pending Changes";
                            font-size: Theme.font-small;
                            font-weight: 600;
                            color: Theme.amber;
                            vertical-alignment: center;
                        }

                        Rectangle {
                            width: 22px;
                            height: 18px;
                            background: Theme.amber-dim;
                            border-radius: 9px;

                            Text {
                                text: root.pending-actions.length;
                                font-size: Theme.fs-micro;
                                color: Theme.text-on-accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }

                    HorizontalLayout {
                        spacing: 6px;

                        // Apply button
                        Rectangle {
                            width: 72px;
                            height: 28px;
                            background: apply-ta.has-hover ? Theme.color-success.brighter(20%) : Theme.color-success;
                            border-radius: Theme.radius-pill;

                            Text {
                                text: "Apply";
                                font-size: Theme.font-small;
                                color: Theme.text-on-accent;
                                font-weight: 600;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            apply-ta := TouchArea {
                                clicked => { root.apply-changes(); }
                            }
                        }

                        // Cancel button
                        Rectangle {
                            width: 72px;
                            height: 28px;
                            background: cancel-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                            border-radius: Theme.radius-pill;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            Text {
                                text: "Cancel";
                                font-size: Theme.font-small;
                                color: Theme.text-secondary;
                                font-weight: 500;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            cancel-ta := TouchArea {
                                clicked => { root.cancel-changes(); }
                            }
                        }
                    }
                }

                // Pending action items (scrollable if many)
                Flickable {
                    viewport-height: pending-items.preferred-height;
                    max-height: 80px;

                    pending-items := VerticalLayout {
                        alignment: start;
                        spacing: 4px;

                        for action[idx] in root.pending-actions : HorizontalLayout {
                            height: 24px;
                            spacing: 8px;
                            padding-left: 4px;

                            // Action type indicator
                            Rectangle {
                                width: 6px;
                                height: 6px;
                                border-radius: 3px;
                                background: action.action-type == "install" ? Theme.color-success
                                    : action.action-type == "remove" ? Theme.color-danger
                                    : Theme.accent;
                            }

                            Text {
                                text: action.action-type;
                                font-size: Theme.fs-micro;
                                color: action.action-type == "install" ? Theme.color-success
                                    : action.action-type == "remove" ? Theme.color-danger
                                    : Theme.accent;
                                font-weight: 500;
                                width: 60px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: action.package-name;
                                font-size: Theme.fs-micro;
                                color: Theme.text-primary;
                                horizontal-stretch: 1;
                                overflow: elide;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ── Error bar ──
        if root.error-text != "" : Rectangle {
            height: 36px;
            background: Theme.color-danger-dim;
            border-width: 1px;
            border-color: Theme.color-danger.transparentize(60%);

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;

                Text {
                    text: root.error-text;
                    font-size: Theme.font-small;
                    color: Theme.color-danger;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }

                Rectangle {
                    width: 24px;
                    height: 24px;
                    background: err-close-ta.has-hover ? Theme.hover-fill : transparent;
                    border-radius: 12px;

                    Icon {
                        commands: Icons.close;
                        size: 12px;
                        tint: Theme.color-danger;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }

                    err-close-ta := TouchArea {}
                }
            }
        }

        // ── Status Bar ──
        Rectangle {
            height: 32px;
            background: Theme.bg-elevated;

            HorizontalLayout {
                padding-left: 16px;
                padding-right: 16px;
                alignment: center;

                Text {
                    text: root.status-text;
                    font-size: Theme.font-small;
                    color: Theme.text-dim;
                    horizontal-stretch: 1;
                    vertical-alignment: center;
                }

                if root.is-applying : HorizontalLayout {
                    spacing: 8px;
                    alignment: center;

                    // Progress bar
                    Rectangle {
                        width: 120px;
                        height: 4px;
                        background: Theme.bg-input;
                        border-radius: 2px;

                        Rectangle {
                            width: parent.width * root.apply-progress;
                            height: 100%;
                            background: Theme.accent;
                            border-radius: 2px;
                        }
                    }

                    Text {
                        text: "Applying changes...";
                        font-size: Theme.font-small;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                }

                if root.packages.length > 0 : HorizontalLayout {
                    spacing: 4px;
                    alignment: center;

                    Text {
                        text: root.packages.length;
                        font-size: Theme.font-small;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }

                    Text {
                        text: "packages";
                        font-size: Theme.font-small;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }
}
