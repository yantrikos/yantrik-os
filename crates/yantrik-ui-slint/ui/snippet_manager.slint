// Code Snippet Manager — screen 25
// 3-panel: collections sidebar + snippet list + detail/editor. SQLite-backed, tag filtering, search.
// Wrapped in WindowFrame by app.slint — no internal window header needed.

import { Theme } from "theme.slint";
import { Icon, Icons } from "components/icon.slint";
import { YButton } from "components/y_button.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposalCard, AgentProposal } from "components/agent_proposal.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { ListView, LineEdit, TextEdit } from "std-widgets.slint";

export struct SnippetData {
    id: int,
    title: string,
    language: string,
    code: string,
    tags: string,
    preview: string,
    date-text: string,
    is-selected: bool,
    is-favorite: bool,
    created-date: string,
    last-used-date: string,
    use-count: int,
    collection-id: int,
}

export struct TagChip {
    name: string,
    is-active: bool,
}

export struct CollectionData {
    id: int,
    name: string,
    snippet-count: int,
    is-builtin: bool,
    is-selected: bool,
    icon: string,
}

export struct LanguageOption {
    name: string,
}

export component SnippetManagerScreen inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar when
    // the screen fills an app window; the shell's copy leaves it off.
    in property <bool> window-bar: false;
    // ── The agent layer ──
    //
    // Filled from what this app and the companion actually hold; every row says where it came
    // from, and a section with nothing true to say does not draw. See agent_rail.slint.
    in property <[AgentContextItem]> agent-context: [];
    in property <[AgentSuggestion]> agent-suggestions: [];
    in property <string> agent-unavailable: "";
    callback agent-context-activated(string);
    callback agent-suggestion-activated(string);
    in property <AgentProposal> proposal;
    in property <bool> proposal-working: false;
    callback proposal-applied();
    callback proposal-dismissed();

    background: transparent;

    in property <[SnippetData]> snippets: [];
    in property <[TagChip]> tag-chips: [];
    in property <int> snippet-count: 0;
    in property <[CollectionData]> collections: [];
    in property <[LanguageOption]> language-options: [];
    in property <int> match-count: -1;

    // Detail panel state
    in property <int> detail-id: -1;
    in-out property <string> detail-title: "";
    in-out property <string> detail-language: "";
    in-out property <string> detail-code: "";
    in-out property <string> detail-tags: "";
    in property <bool> detail-is-favorite: false;
    in property <string> detail-created-date: "";
    in property <string> detail-last-used-date: "";
    in property <int> detail-use-count: 0;

    in-out property <string> search-query: "";

    // Copy feedback
    in property <bool> copy-feedback-visible: false;

    // What went wrong, in words, for the person at the keyboard.
    //
    // Empty is the ordinary state and draws nothing. The same sentence goes into the control
    // surface's `notice`, because contract point 4 is that a failure is said twice: once on
    // screen and once where a mind can read it.
    in property <string> notice: "";

    // Language dropdown state
    in-out property <bool> lang-dropdown-open: false;

    // Collection rename state
    in-out property <bool> rename-mode: false;
    in-out property <string> rename-text: "";

    callback snip-search(string);
    callback snip-select(int);
    callback snip-new();
    callback snip-save(int, string, string, string, string);
    callback snip-delete(int);
    callback snip-copy(int);
    callback snip-tag-filter(string);
    callback snip-toggle-favorite(int);

    // Collection callbacks
    callback collection-select(int);
    callback collection-create(string);
    callback collection-rename(int, string);
    callback collection-delete(int);

    // Export. There is no Import button any more: importing needs somebody to name a file, this
    // screen has no file dialog, and a button that cannot name a file cannot import one. The
    // capability is still here — `yantrik-snippet-manager <file>` and the surface's `import`
    // action both take a path — and a file dialog on this screen would bring the button back.
    callback snip-export-all();

    // Language select
    callback snip-set-language(string);

    // Version history is gone: the list, the panel and the two callbacks were a drawing with no
    // store behind them, and "Restore" over a list that is always empty is worse than no button.
    // Keeping previous bodies per snippet in the store is what would bring it back.

    // AI Assist.
    //
    // The answer lands in the shared AgentProposalCard above, the way Weather and System Monitor
    // put theirs: one place an app's machine-written text appears. The panel this screen used to
    // draw for itself was a second one, fed by two `in` properties nothing ever set.
    callback ai-explain-pressed();

    // -- Header --
    //
    // Placed rather than laid out, because this component positions its panes by hand around
    // a status bar it draws over the bottom 28px. The panes below now start at the header's
    // height instead of at zero.
    AppHeader {
        window-bar: root.window-bar;
        app-id: "snippets";
        x: 0;
        y: 0;
        width: parent.width;
        icon: Icons.code;
        title: "Snippets";
        // No show-search here: this app already has a search field at the top of its snippet
        // list, which is where it belongs -- it filters that list. Turning on the frame's as
        // well gave the window two identical "Search snippets" boxes side by side.
        actions: [
            { id: "ai",  icon: Icons.spark, label: root.proposal-working ? "Working" : "AI",
              emphasis: 1, loading: root.proposal-working },
            { id: "new", icon: Icons.plus,  label: "New Snippet", emphasis: 2 },
        ];
        action(id) => {
            if (id == "new") { root.snip-new(); }
            else if (id == "ai") { root.ai-explain-pressed(); }
        }
    }
    // ── What the companion is proposing ──
    if root.proposal.title != "" : AgentProposalCard {
        data: root.proposal;
        working: root.proposal-working;
        apply => { root.proposal-applied(); }
        dismiss => { root.proposal-dismissed(); }
    }

    HorizontalLayout {
        // Between the header at the top and the status bar drawn over the bottom 28px, minus the
        // notice strip when there is one. The panes shrink for it rather than being drawn over:
        // a failure that hides the thing it is about is half a message.
        x: 0;
        y: Theme.h-app-header;
        width: parent.width;
        height: parent.height - 28px - Theme.h-app-header - (root.notice != "" ? 28px : 0px);
        // ── Collections Sidebar ──
        Rectangle {
            width: 180px;
            background: Theme.bg-deep;

            VerticalLayout {
                padding: 8px;
                spacing: 4px;

                // Sidebar header
                HorizontalLayout {
                    padding-left: 8px;
                    padding-right: 4px;
                    height: 32px;
                    spacing: 4px;

                    Text {
                        text: "Collections";
                        font-size: Theme.font-small;
                        color: Theme.text-dim;
                        font-weight: 700;
                        letter-spacing: 0.5px;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }

                    // Add collection button
                    TouchArea {
                        width: 24px;
                        height: 24px;
                        clicked => {
                            root.collection-create("New Collection");
                        }
                        Rectangle {
                            width: 24px; height: 24px;
                            border-radius: 12px;
                            background: parent.has-hover ? Theme.hover-fill : transparent;
                            Text {
                                text: "+";
                                font-size: Theme.fs-title-2;
                                color: Theme.text-secondary;
                                font-weight: 700;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Collection items
                ListView {
                    vertical-stretch: 1;

                    for coll[idx] in root.collections : Rectangle {
                        height: 34px;
                        background: coll.is-selected ? Theme.bg-selected
                            : coll-ta.has-hover ? Theme.hover-fill : transparent;
                        border-radius: 8px;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 8px;
                            spacing: 8px;
                            alignment: center;

                            Icon {
                                commands: Icons.glyph(coll.icon);
                                size: 14px;
                                tint: coll.is-selected ? AppIdentity.accent : Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            if root.rename-mode && coll.is-selected && !coll.is-builtin : LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.rename-text;
                                font-size: Theme.font-small;
                                accepted(text) => {
                                    root.collection-rename(coll.id, text);
                                    root.rename-mode = false;
                                }
                            }

                            if !(root.rename-mode && coll.is-selected && !coll.is-builtin) : Text {
                                text: coll.name;
                                font-size: Theme.font-small;
                                color: coll.is-selected ? Theme.text-primary : Theme.text-secondary;
                                font-weight: coll.is-selected ? 600 : 400;
                                overflow: elide;
                                vertical-alignment: center;
                                horizontal-stretch: 1;
                            }

                            // Snippet count badge
                            if coll.snippet-count > 0 : Rectangle {
                                width: coll-count-text.width + 10px;
                                height: 18px;
                                background: Theme.hover-fill;
                                border-radius: 9px;

                                coll-count-text := Text {
                                    text: coll.snippet-count;
                                    font-size: Theme.fs-micro;
                                    color: Theme.text-dim;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        coll-ta := TouchArea {
                            clicked => {
                                root.collection-select(coll.id);
                            }
                            // Double-click to rename (only non-builtin)
                            double-clicked => {
                                if !coll.is-builtin {
                                    root.rename-mode = true;
                                    root.rename-text = coll.name;
                                }
                            }
                        }
                    }
                }

                // Separator
                Rectangle { height: 1px; background: Theme.separator; }

                // Export button. Its Import twin is gone — see the callback declarations above.
                HorizontalLayout {
                    spacing: 6px;
                    height: 32px;
                    padding-left: 4px;
                    padding-right: 4px;

                    // Export button
                    TouchArea {
                        horizontal-stretch: 1;
                        height: 28px;
                        clicked => { root.snip-export-all(); }
                        Rectangle {
                            width: 100%; height: 28px;
                            border-radius: 8px;
                            background: parent.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                            HorizontalLayout {
                                alignment: center;
                                spacing: 4px;
                                Icon {
                                    commands: Icons.arrow-up;
                                    size: 12px;
                                    tint: Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: "Export";
                                    font-size: Theme.font-small;
                                    color: Theme.text-secondary;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                }

                // Delete collection button (only for custom collections)
                for coll in root.collections : TouchArea {
                    visible: coll.is-selected && !coll.is-builtin;
                    height: self.visible ? 28px : 0px;
                    clicked => { root.collection-delete(coll.id); }
                    Rectangle {
                        width: 100%; height: 28px;
                        border-radius: 8px;
                        background: parent.has-hover ? Theme.color-danger-dim : transparent;
                        HorizontalLayout {
                            alignment: center;
                            spacing: 4px;
                            Icon {
                                commands: Icons.trash;
                                size: 12px;
                                tint: Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: "Delete Collection";
                                font-size: Theme.font-small;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ── Vertical separator ──
        Rectangle { width: 1px; background: Theme.separator; }

        // ── Middle Panel: Search + Tags + Snippet List ──
        Rectangle {
            width: 280px;
            background: Theme.bg-surface;

            VerticalLayout {
                padding: 12px;
                spacing: 10px;

                // Search bar
                Rectangle {
                    height: 36px;
                    background: Theme.bg-input;
                    border-radius: Theme.radius-pill;
                    border-width: 1px;
                    border-color: search-field.has-focus ? AppIdentity.accent : Theme.border-subtle;

                    if root.search-query == "" : Text {
                        x: 12px + 13px + 8px;
                        height: 100%;
                        text: "Search snippets";
                        color: Theme.text-dim;
                        font-size: Theme.font-body;
                        vertical-alignment: center;
                    }

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 8px;
                        spacing: 8px;

                        Icon {
                            commands: Icons.search;
                            size: 13px;
                            tint: Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }

                        search-field := TextInput {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            single-line: true;
                            text <=> root.search-query;
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            edited => { root.snip-search(self.text); }
                        }

                        // Match count badge
                        if root.match-count >= 0 : Rectangle {
                            width: match-count-text.width + 10px;
                            height: 18px;
                            background: Theme.accent-glow;
                            border-radius: 9px;

                            match-count-text := Text {
                                text: root.match-count;
                                font-size: Theme.fs-micro;
                                color: Theme.accent;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                    }
                }

                // Tag filter chips (horizontal wrap via Flickable)
                if root.tag-chips.length > 0 : Flickable {
                    height: 32px;
                    viewport-width: tag-row.preferred-width;

                    tag-row := HorizontalLayout {
                        alignment: start;
                        spacing: 6px;

                        for chip[idx] in root.tag-chips : Rectangle {
                            width: chip-label.width + 16px;
                            height: 26px;
                            background: chip.is-active ? Theme.accent-glow : Theme.hover-fill;
                            border-radius: 13px;
                            border-width: 1px;
                            border-color: chip.is-active ? Theme.accent-dim : Theme.border-subtle;

                            chip-label := Text {
                                text: chip.name;
                                font-size: Theme.font-small;
                                color: chip.is-active ? AppIdentity.accent : Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }

                            TouchArea {
                                clicked => {
                                    root.snip-tag-filter(chip.name);
                                }
                            }
                        }
                    }
                }

                // Separator
                Rectangle { height: 1px; background: Theme.separator; }

                // Snippet list
                if root.snippets.length == 0 : YEmptyState {
                    vertical-stretch: 1;
                    icon-path: Icons.code;
                    title: root.search-query != "" ? "No snippets found" : "No snippets yet";
                    description: root.search-query != "" ? "Try a different search." : "Save the commands and fragments you keep retyping.";
                    action-label: root.search-query != "" ? "" : "New snippet";
                    action-clicked => { root.snip-new(); }
                }
                if false : Rectangle {
                    VerticalLayout {

                        Text {
                            text: root.search-query != "" ? "Try a different search" : "Create your first snippet";
                            font-size: Theme.font-small;
                            color: Theme.text-dim;
                            horizontal-alignment: center;
                        }
                    }
                }

                if root.snippets.length > 0 : ListView {
                    vertical-stretch: 1;

                    for snip[idx] in root.snippets : Rectangle {
                        height: 82px;
                        background: snip.is-selected ? Theme.bg-selected
                            : row-ta.has-hover ? Theme.hover-fill : transparent;

                        VerticalLayout {
                            padding: 8px;
                            padding-left: 12px;
                            padding-right: 12px;
                            spacing: 4px;

                            // Title row
                            HorizontalLayout {
                                spacing: 6px;

                                // Favorite indicator
                                if snip.is-favorite : Icon {
                                    commands: Icons.star;
                                    size: 12px;
                                    tint: Theme.amber;
                                    y: (parent.height - self.height) / 2;
                                }

                                Text {
                                    text: snip.title;
                                    font-size: Theme.font-body;
                                    font-weight: 600;
                                    color: Theme.text-primary;
                                    overflow: elide;
                                    horizontal-stretch: 1;
                                }

                                // Language badge
                                if snip.language != "" : Rectangle {
                                    width: lang-text.width + 10px;
                                    height: 18px;
                                    background: Theme.accent-glow;
                                    border-radius: 9px;

                                    lang-text := Text {
                                        text: snip.language;
                                        font-size: Theme.fs-micro;
                                        color: Theme.accent;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Preview line (monospace)
                            Text {
                                text: snip.preview;
                                font-size: Theme.font-small;
                                font-family: Theme.font-mono;
                                color: Theme.text-secondary;
                                overflow: elide;
                            }

                            // Tags row
                            if snip.tags != "" : Rectangle {
                                height: 18px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    Icon {
                                        commands: Icons.tag;
                                        size: 12px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: snip.tags;
                                        font-size: Theme.fs-micro;
                                        color: Theme.accent-dim;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }

                            // Date row
                            HorizontalLayout {
                                spacing: 6px;

                                if snip.tags == "" : Rectangle {
                                    horizontal-stretch: 1;
                                }

                                if snip.tags != "" : Rectangle {
                                    horizontal-stretch: 1;
                                }

                                Text {
                                    text: snip.date-text;
                                    font-size: Theme.fs-micro;
                                    color: Theme.text-dim;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        // Bottom separator
                        Rectangle {
                            y: parent.height - 1px;
                            height: 1px;
                            background: Theme.separator;
                        }

                        row-ta := TouchArea {
                            clicked => {
                                root.snip-select(snip.id);
                            }
                        }
                    }
                }

                // The pill that was here is gone. "+ New Snippet" is already in the header, six
                // hundred pixels away and above it -- the same words, the same action, twice on
                // screen at once, one of them a full-width accent bar that made the sidebar look
                // like it ended in an advert.
            }
        }

        // ── Vertical separator ──
        Rectangle { width: 1px; background: Theme.separator; }

        // ── Right Panel: Detail / Editor ──
        Rectangle {
            horizontal-stretch: 1;
            background: Theme.bg-card;

            // Empty state
            if root.detail-id < 0 : VerticalLayout {
                alignment: center;
                spacing: 12px;

                Icon {
                    commands: Icons.copy;
                    size: 20px;
                    tint: Theme.text-secondary;
                    x: (parent.width - self.width) / 2;
                }

                Text {
                    text: "Select a snippet";
                    font-size: Theme.font-title;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }

                Text {
                    text: "or create a new one to get started";
                    font-size: Theme.font-small;
                    color: Theme.text-dim;
                    horizontal-alignment: center;
                }
            }

            // Editor view
            if root.detail-id >= 0 : VerticalLayout {
                padding: 20px;
                spacing: 14px;

                // Title + Favorite row
                HorizontalLayout {
                    spacing: 10px;
                    height: 40px;

                    // Title input
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 40px;
                        background: Theme.bg-input;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: title-field.has-focus ? AppIdentity.accent : Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 12px;
                            padding-right: 12px;
                            alignment: center;

                            title-field := LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.detail-title;
                                placeholder-text: "Snippet title...";
                                font-size: Theme.font-title;
                            }
                        }
                    }

                    // Favorite toggle button
                    TouchArea {
                        width: 40px;
                        height: 40px;
                        clicked => {
                            root.snip-toggle-favorite(root.detail-id);
                        }
                        Rectangle {
                            width: 40px; height: 40px;
                            border-radius: Theme.radius-card;
                            background: parent.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            Icon {
                                commands: root.detail-is-favorite ? Icons.star : Icons.star;
                                size: 18px;
                                tint: root.detail-is-favorite ? Theme.amber : Theme.text-dim;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // Language + Tags row
                HorizontalLayout {
                    spacing: 10px;
                    height: 36px;

                    // Language selector with dropdown
                    Rectangle {
                        width: 160px;
                        height: 36px;

                        // Language input / button
                        Rectangle {
                            width: 160px;
                            height: 36px;
                            background: Theme.bg-input;
                            border-radius: Theme.radius-card;
                            border-width: 1px;
                            border-color: lang-field.has-focus ? AppIdentity.accent : Theme.border-subtle;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 6px;
                                spacing: 4px;
                                alignment: center;

                                lang-field := LineEdit {
                                    horizontal-stretch: 1;
                                    text <=> root.detail-language;
                                    placeholder-text: "Language";
                                    font-size: Theme.font-body;
                                }

                                // Dropdown toggle
                                TouchArea {
                                    width: 24px;
                                    height: 24px;
                                    clicked => {
                                        root.lang-dropdown-open = !root.lang-dropdown-open;
                                    }
                                    Rectangle {
                                        width: 24px; height: 24px;
                                        border-radius: 12px;
                                        background: parent.has-hover ? Theme.hover-fill : transparent;
                                        Icon {
                                            commands: root.lang-dropdown-open ? Icons.chevron-up : Icons.chevron-down;
                                            size: 12px;
                                            tint: Theme.text-dim;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }

                        // Language dropdown menu
                        if root.lang-dropdown-open : Rectangle {
                            y: 38px;
                            width: 160px;
                            height: 200px;
                            background: Theme.bg-elevated;
                            border-radius: 8px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;

                            // Ensure dropdown appears on top
                            Rectangle {
                                width: 100%; height: 100%;
                                clip: true;

                                Flickable {
                                    width: 100%;
                                    height: 100%;

                                    VerticalLayout {
                                        alignment: start;
                                        padding: 4px;
                                        spacing: 2px;

                                        for lang-opt in root.language-options : TouchArea {
                                            height: 26px;
                                            clicked => {
                                                root.snip-set-language(lang-opt.name);
                                                root.lang-dropdown-open = false;
                                            }
                                            Rectangle {
                                                width: 100%; height: 26px;
                                                border-radius: 6px;
                                                background: parent.has-hover ? Theme.hover-fill-strong : transparent;
                                                HorizontalLayout {
                                                    padding-left: 10px;
                                                    alignment: center;
                                                    Text {
                                                        text: lang-opt.name;
                                                        font-size: Theme.font-small;
                                                        color: lang-opt.name == root.detail-language ? AppIdentity.accent : Theme.text-primary;
                                                        font-weight: lang-opt.name == root.detail-language ? 600 : 400;
                                                        vertical-alignment: center;
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Tags input
                    Rectangle {
                        horizontal-stretch: 1;
                        height: 36px;
                        background: Theme.bg-input;
                        border-radius: Theme.radius-card;
                        border-width: 1px;
                        border-color: tags-field.has-focus ? AppIdentity.accent : Theme.border-subtle;

                        HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 6px;
                            alignment: center;

                            Icon {
                                commands: Icons.tag;
                                size: 13px;
                                tint: Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            tags-field := LineEdit {
                                horizontal-stretch: 1;
                                text <=> root.detail-tags;
                                placeholder-text: "Tags (comma-separated)";
                                font-size: Theme.font-body;
                            }
                        }
                    }
                }

                // Code editor area
                Rectangle {
                    vertical-stretch: 1;
                    background: Theme.bg-deep;
                    border-radius: Theme.radius-card;
                    border-width: 1px;
                    border-color: Theme.border-subtle;

                    VerticalLayout {
                        padding: 2px;

                        code-editor := TextEdit {
                            vertical-stretch: 1;
                            text <=> root.detail-code;
                            font-size: Theme.fs-body;
                            font-family: Theme.font-mono;
                        }
                    }
                }

                // Action buttons row
                HorizontalLayout {
                    spacing: 10px;
                    height: 38px;

                    // Save button
                    Rectangle {
                        width: 100px;
                        height: 38px;
                        background: save-ta.has-hover ? AppIdentity.accent : Theme.accent-dim;
                        border-radius: Theme.radius-pill;

                        Text {
                            text: "Save";
                            font-size: Theme.font-body;
                            color: Theme.text-on-accent;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }

                        save-ta := TouchArea {
                            clicked => {
                                root.snip-save(root.detail-id, root.detail-title, root.detail-language, root.detail-code, root.detail-tags);
                            }
                        }
                    }

                    // Copy button with "Copied!" feedback
                    Rectangle {
                        width: 100px;
                        height: 38px;
                        background: root.copy-feedback-visible
                            ? Theme.color-success
                            : (copy-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill);
                        border-radius: Theme.radius-pill;
                        border-width: root.copy-feedback-visible ? 0px : 1px;
                        border-color: Theme.border-subtle;

                        HorizontalLayout {
                            alignment: center;
                            spacing: 6px;

                            if !root.copy-feedback-visible : Icon {
                                commands: Icons.copy;
                                size: 13px;
                                tint: Theme.text-secondary;
                                y: (parent.height - self.height) / 2;
                            }

                            Text {
                                text: root.copy-feedback-visible ? "Copied!" : "Copy";
                                font-size: Theme.font-body;
                                color: root.copy-feedback-visible ? Theme.text-on-accent : Theme.text-secondary;
                                font-weight: root.copy-feedback-visible ? 600 : 500;
                                vertical-alignment: center;
                            }
                        }

                        copy-ta := TouchArea {
                            clicked => {
                                root.snip-copy(root.detail-id);
                            }
                        }
                    }

                    // AI Explain button
                    TouchArea {
                        width: 90px;
                        height: 38px;
                        clicked => {
                            root.ai-explain-pressed();
                        }
                        Rectangle {
                            width: 90px; height: 38px;
                            border-radius: Theme.radius-pill;
                            background: root.proposal-working ? AppIdentity.accent
                                : (parent.has-hover ? Theme.hover-fill-strong : Theme.hover-fill);
                            border-width: root.proposal-working ? 0px : 1px;
                            border-color: Theme.border-subtle;
                            HorizontalLayout {
                                padding-left: 8px;
                                padding-right: 8px;
                                spacing: 4px;
                                alignment: center;
                                Icon {
                                    commands: Icons.spark;
                                    size: 12px;
                                    tint: Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }
                                Text {
                                    text: root.proposal-working ? "..." : "AI Explain";
                                    color: root.proposal-working ? Theme.text-on-accent : Theme.text-secondary;
                                    font-size: Theme.font-body;
                                    font-weight: 500;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // The Versions button stood here and opened an always-empty panel.

                    // Spacer
                    Rectangle { horizontal-stretch: 1; }

                    // Delete button
                    YButton {
                        label: "Delete";
                        variant: 3;
                        width: 100px;
                        clicked => { root.snip-delete(root.detail-id); }
                    }
                }

                // ── Metadata footer ──
                Rectangle {
                    height: 28px;
                    background: Theme.bg-deep;
                    border-radius: 8px;

                    HorizontalLayout {
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 16px;
                        alignment: center;

                        // Created date
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Created:";
                                font-size: Theme.fs-micro;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.detail-created-date != "" ? root.detail-created-date : "—";
                                font-size: Theme.fs-micro;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        // Last used date
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Last used:";
                                font-size: Theme.fs-micro;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.detail-last-used-date != "" ? root.detail-last-used-date : "Never";
                                font-size: Theme.fs-micro;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }

                        // Use count
                        HorizontalLayout {
                            spacing: 4px;
                            Text {
                                text: "Uses:";
                                font-size: Theme.fs-micro;
                                color: Theme.text-dim;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.detail-use-count;
                                font-size: Theme.fs-micro;
                                color: Theme.text-secondary;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // ── What Yantrik knows about this ──
        AgentRail {
            context-items: root.agent-context;
            suggestions: root.agent-suggestions;
            unavailable: root.agent-unavailable;
            context-activated(id) => { root.agent-context-activated(id); }
            suggestion-activated(id) => { root.agent-suggestion-activated(id); }
        }
    }

    // The AI Response Panel and the Version History Panel stood here.
    //
    // The first was a second place for machine-written text, fed by `ai-response` and
    // `ai-is-working`, neither of which anything ever set; the AgentProposalCard above now
    // carries the answer, as it does in Weather and System Monitor. The second listed
    // versions this app has never kept.

    // ── Notice ──
    //
    // A strip above the status bar, drawn only when there is something to say. It is the
    // person-facing half of contract point 4; the machine-facing half is `notice` in the
    // control surface's describe, and both are set from the same string in Rust.
    if root.notice != "" : Rectangle {
        x: 0;
        y: parent.height - 28px - self.height;
        width: 100%;
        height: 28px;
        background: Theme.color-danger-dim;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            spacing: 8px;
            alignment: start;

            Icon {
                commands: Icons.warning;
                size: 12px;
                tint: Theme.color-danger;
                y: (parent.height - self.height) / 2;
            }

            Text {
                text: root.notice;
                font-size: Theme.font-small;
                color: Theme.text-primary;
                overflow: elide;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }
        }
    }

    // ── Status bar ──
    Rectangle {
        y: parent.height - 28px;
        height: 28px;
        width: 100%;
        background: Theme.bg-elevated;

        HorizontalLayout {
            padding-left: 16px;
            padding-right: 16px;
            alignment: center;

            if root.snippet-count > 0 : HorizontalLayout {
                horizontal-stretch: 1;
                spacing: 4px;

                Text {
                    text: root.snippet-count;
                    font-size: Theme.font-small;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                Text {
                    text: "snippets";
                    font-size: Theme.font-small;
                    color: Theme.text-dim;
                    vertical-alignment: center;
                }

                if root.match-count >= 0 && root.search-query != "" : HorizontalLayout {
                    spacing: 4px;
                    Text {
                        text: " \u{2022} ";
                        font-size: Theme.font-small;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                    Text {
                        text: root.match-count;
                        font-size: Theme.font-small;
                        color: Theme.accent;
                        vertical-alignment: center;
                    }
                    Text {
                        text: "matches";
                        font-size: Theme.font-small;
                        color: Theme.text-dim;
                        vertical-alignment: center;
                    }
                }
            }

            if root.snippet-count == 0 : Text {
                text: "No snippets";
                font-size: Theme.font-small;
                color: Theme.text-dim;
                vertical-alignment: center;
                horizontal-stretch: 1;
            }

            if root.detail-language != "" : Text {
                text: root.detail-language;
                font-size: Theme.font-small;
                color: Theme.accent;
                vertical-alignment: center;
            }
        }
    }
}
