// System Monitor — comprehensive real-time resource monitoring.
// Screen 23. CPU (overall + per-core), Memory, Disk, Network, Processes.
// 2-column grid layout: CPU+Memory top, Disk+Network middle, Processes bottom.

import { Theme } from "theme.slint";
import { YIconButton } from "components/y_button.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
import { AgentProposalCard, AgentProposal } from "components/agent_proposal.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";

// ── Data structs ──

export struct CpuCoreData {
    core-id: int,
    usage: float,
}

export struct DiskData {
    mount-point: string,
    filesystem: string,
    used-bytes: string,
    total-bytes: string,
    usage-percent: float,
}

export struct NetworkInterfaceData {
    name: string,
    ip-address: string,
    rx-bytes: string,
    tx-bytes: string,
    rx-speed: string,
    tx-speed: string,
}

export struct MonitorProcessData {
    pid: int,
    name: string,
    cpu-percent: float,
    mem-percent: float,
    status: string,
}

// ── Main component ──

export component SystemMonitor inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar when
    // the screen fills an app window; the shell's copy leaves it off.
    in property <bool> window-bar: false;
    // ── The agent layer ──
    //
    // Filled from what this app and the companion actually hold; every row says where it came
    // from, and a section with nothing true to say does not draw. See agent_rail.slint.
    in property <[AgentContextItem]> agent-context: [];
    in property <[AgentSuggestion]> agent-suggestions: [];
    in property <string> agent-unavailable: "";
    callback agent-context-activated(string);
    callback agent-suggestion-activated(string);
    in property <AgentProposal> proposal;
    in property <bool> proposal-working: false;
    callback proposal-applied();
    callback proposal-dismissed();

    /// What the window could not do, and what it could not measure, in the person's words.
    ///
    /// Empty when there is neither. A kill that the service refused and the fallback could not
    /// carry used to leave a tracing line in a log nobody has open, and readings that had
    /// silently fallen back to this process's own `sysinfo` looked exactly like the service's.
    /// Both now say so here, and `describe` carries the same text for the mind.
    in property <string> notice: "";

    // Whether there is anywhere to go back TO.
    //
    // The header's back arrow was hardcoded on, which is right inside the shell -- back means
    // the desktop -- and meaningless in the standalone window, where it was the first control
    // in the title row of an app that has no history and no parent. Default true, so the shell
    // keeps what it had; the standalone wrappers say false.
    in property <bool> show-back: true;

    background: Theme.bg-deep;

    // CPU
    in property <float> cpu-usage: 0.0;
    in property <string> cpu-model: "";
    in property <string> cpu-frequency: "";
    in property <string> load-avg-1: "0.00";
    in property <string> load-avg-5: "0.00";
    in property <string> load-avg-15: "0.00";
    in property <[CpuCoreData]> cpu-cores: [];

    // Memory
    in property <float> memory-usage: 0.0;
    in property <string> memory-used-text: "";
    in property <string> memory-total-text: "";
    in property <string> memory-cached-text: "";
    in property <string> memory-buffers-text: "";
    in property <string> memory-available-text: "";
    in property <float> swap-usage: 0.0;
    in property <string> swap-used-text: "";
    in property <string> swap-total-text: "";

    // Disk
    in property <[DiskData]> disks: [];

    // Network
    in property <[NetworkInterfaceData]> network-interfaces: [];

    // Processes
    in property <[MonitorProcessData]> processes: [];
    in-out property <int> sort-column: 0;  // 0=CPU, 1=MEM
    callback sort-by-column(int);

    // Process search
    in-out property <string> process-search: "";
    callback process-search-changed(string);

    // Process actions
    in-out property <int> selected-process-pid: -1;
    callback kill-process(int);
    callback force-kill-process(int);

    // Uptime
    in property <string> uptime-text: "";

    // Health Score
    in property <string> health-status: "Healthy";  // "Healthy", "Degraded", "Critical"
    in property <float> health-score: 100.0;  // 0-100
    in property <string> health-summary: "";  // "All systems nominal" or issue description

    // AI Workloads
    in property <string> ai-model-name: "";
    in property <string> ai-model-tier: "";
    in property <float> ai-tokens-per-sec: 0.0;
    in property <int> ai-tokens-today: 0;
    in property <int> ai-provider-latency-ms: -1;
    in property <float> ai-error-rate: 0.0;
    in property <bool> ai-request-active: false;
    in property <float> ai-request-progress: 0.0;

    // AI Assist
    in property <bool> ai-is-working: false;
    in property <string> ai-response: "";
    in-out property <bool> ai-panel-open: false;
    callback ai-explain-pressed();
    callback ai-dismiss();

    callback back-pressed();

    // ── What the list and the AI card say about themselves (#220) ──
    //
    // A filter that matched nothing read exactly like a machine that reported nothing, so the
    // empty list now echoes the word that was typed. The AI Workloads card drew a row of
    // dashes and a confident "0%" error rate while nothing on this machine fed its inputs --
    // no source anywhere in Yantrik sets them -- so with nothing measured it now says that
    // plainly, and the numbers only draw when something real arrives.
    out property <string> process-empty-text: root.process-search != ""
        ? "No process matches '" + root.process-search + "'"
        : "No process data";
    property <bool> ai-has-measurements: root.ai-model-name != "" || root.ai-tokens-per-sec > 0.0
        || root.ai-tokens-today > 0 || root.ai-provider-latency-ms >= 0 || root.ai-request-active;
    out property <string> ai-no-source-text: root.ai-has-measurements ? ""
        : "Nothing measured: no source on this machine reports model or token activity.";

    // ── Geometry mirrored out for the ui-preview checks (#220) ──
    //
    // Slint centres an element that sets a width but no x -- (parent.width - width) / 2 --
    // which drew a 62% bar from about 20% of its track. The fills now say `x: 0`, and these
    // mirrors pin it: a fill must start at the left edge of its track and take a real width.
    // The core and disk fills live inside repeaters, so they report through changed
    // callbacks; the health and swap fills are single elements and bind directly.
    out property <length> health-fill-x: health-fill.x;
    out property <length> swap-fill-x: swap-fill.x;
    out property <length> swap-fill-width: swap-fill.width;
    out property <length> core-fill-x: 0px;
    out property <length> core-fill-width: 0px;
    out property <length> disk-fill-x: 0px;
    out property <length> disk-fill-width: 0px;
    // Selecting a row must not move the list: the header row used to grow 14px the moment
    // End and Force Kill appeared, sliding everything below down under the pointer.
    out property <length> proc-header-height: proc-header.height;
    out property <length> proc-search-y: proc-search-bar.y;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        AppHeader {
            window-bar: root.window-bar;
            app-id: "sysmonitor";
            show-back: root.show-back;
            icon: Icons.monitor;
            title: "System Monitor";
            subtitle: root.uptime-text != "" ? "Up " + root.uptime-text : "";
            actions: [
                { id: "ai", icon: Icons.spark, label: root.ai-is-working ? "Analyzing" : "AI Explain",
                  emphasis: 1, loading: root.ai-is-working, active: root.ai-panel-open },
            ];
            back => { root.back-pressed(); }
            action(id) => {
                if (id == "ai") {
                    if (root.ai-panel-open) { root.ai-dismiss(); root.ai-panel-open = false; }
                    else { root.ai-explain-pressed(); root.ai-panel-open = true; }
                }
            }
        }

        // What could not be done, and what could not be measured, above the readings it is
        // about. A strip rather than a dialog: degraded numbers are still worth looking at,
        // and a kill that failed leaves the list it failed on right underneath.
        if root.notice != "" : Rectangle {
            height: notice-text.preferred-height + Theme.sp-4;
            background: Theme.color-danger-dim;

            Rectangle {
                x: 0;
                width: 2px;
                height: 100%;
                background: Theme.color-danger;
            }

            notice-text := Text {
                x: Theme.sp-4;
                width: parent.width - Theme.sp-4 * 2;
                y: Theme.sp-2;
                text: root.notice;
                color: Theme.text-primary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }
        }

        // AI Response Panel
        if root.ai-panel-open && root.ai-response != "" : Rectangle {
            height: ai-resp-layout.preferred-height + 16px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.accent.transparentize(70%);

            ai-resp-layout := VerticalLayout {
                padding: Theme.sp-3;
                spacing: Theme.sp-2;

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    Icon {
                        commands: Icons.spark;
                        size: 12px;
                        tint: Theme.text-secondary;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: "AI Analysis";
                        color: Theme.accent;
                        font-size: Theme.fs-caption;
                        font-weight: Theme.fw-headline;
                        vertical-alignment: center;
                    }
                    Rectangle { horizontal-stretch: 1; }
                    YIconButton {
                        icon-path: Icons.close;
                        variant: 2;
                        clicked => {
                            root.ai-dismiss();
                            root.ai-panel-open = false;
                        }
                    }
                }

                Text {
                    text: root.ai-response;
                    color: Theme.text-primary;
                    font-size: Theme.fs-body;
                    wrap: word-wrap;
                }
            }
        }

        // ── Health Score Card ──
        Rectangle {
            height: 48px;
            background: Theme.bg-surface;

            // Bottom border
            Rectangle {
                y: parent.height - 1px;
                height: 1px;
                background: Theme.separator;
            }

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;
                spacing: Theme.sp-4;
                alignment: stretch;

                // Left: status dot + status text
                HorizontalLayout {
                    spacing: Theme.sp-2;
                    horizontal-stretch: 0;
                    alignment: center;

                    Rectangle {
                        width: 10px;
                        height: 10px;
                        y: (parent.height - 10px) / 2;
                        border-radius: 5px;
                        background: root.health-status == "Critical" ? Theme.color-emotional :
                                   root.health-status == "Degraded" ? Theme.amber : Theme.color-success;
                        animate background { duration: 150ms; easing: ease-in-out; }
                    }

                    Text {
                        text: root.health-status;
                        color: root.health-status == "Critical" ? Theme.color-emotional :
                               root.health-status == "Degraded" ? Theme.amber : Theme.color-success;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        vertical-alignment: center;
                        animate color { duration: 150ms; easing: ease-in-out; }
                    }
                }

                // Score percentage + the bar it belongs to.
                //
                // `alignment: center` and `horizontal-stretch: 1` on the child contradict each
                // other, and centre wins: the layout gives every child its preferred width and
                // centres the group, so the bar -- which has no preferred width, only a stretch
                // -- collapsed to nothing. On screen that was a bare "100%" floating in the
                // middle of the row with no indication of what it measured.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: 10px;

                    Text {
                        text: Math.round(root.health-score) + "%";
                        color: root.health-status == "Critical" ? Theme.color-emotional :
                               root.health-status == "Degraded" ? Theme.amber : Theme.color-success;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        vertical-alignment: center;
                        min-width: 36px;
                        animate color { duration: 150ms; easing: ease-in-out; }
                    }

                    // Wrapped so the 4px bar sits on the text's centre line. A fixed-height
                    // child of a HorizontalLayout is placed at the top of the row, which put
                    // the bar a clear 20px above the "100%" it belongs to.
                    VerticalLayout {
                        horizontal-stretch: 1;
                        alignment: center;
                    Rectangle {
                        height: 4px;
                        border-radius: 2px;
                        background: Theme.bg-deep;

                        health-fill := Rectangle {
                            x: 0;
                            width: max(0px, parent.width * root.health-score / 100);
                            height: 100%;
                            border-radius: 2px;
                            background: root.health-status == "Critical" ? Theme.color-emotional :
                                       root.health-status == "Degraded" ? Theme.amber : Theme.color-success;
                            animate width { duration: 150ms; easing: ease-in-out; }
                            animate background { duration: 150ms; easing: ease-in-out; }
                        }
                    }
                    }
                }

                // Right: summary text
                Text {
                    text: root.health-summary;
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    horizontal-stretch: 0;
                    vertical-alignment: center;
                    overflow: elide;
                    max-width: 260px;
                }
            }
        }

        // Content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 16px;
                spacing: 12px;
                alignment: start;

                // ── Row 1: CPU + Memory ──
                // ── What the companion is proposing ──
                if root.proposal.title != "" : AgentProposalCard {
                    data: root.proposal;
                    working: root.proposal-working;
                    apply => { root.proposal-applied(); }
                    dismiss => { root.proposal-dismissed(); }
                }

                HorizontalLayout {
                    spacing: 12px;

                    // ── CPU Panel ──
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        height: cpu-inner.preferred-height;

                        cpu-inner := VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            // Section header
                            Text {
                                text: "CPU";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 2px;
                            }

                            // Overall gauge row
                            HorizontalLayout {
                                spacing: 16px;

                                // Circular gauge (simulated with nested rects)
                                Rectangle {
                                    width: 80px;
                                    height: 80px;

                                    // Background ring
                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 40px;
                                        border-width: 5px;
                                        border-color: Theme.bg-deep;
                                        background: transparent;
                                    }

                                    // Foreground ring (full colored circle as progress indicator)
                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 40px;
                                        border-width: 5px;
                                        border-color: root.cpu-usage > 80 ? Theme.color-emotional :
                                                     root.cpu-usage > 50 ? Theme.amber : Theme.accent;
                                        background: transparent;
                                        // Clip to show percentage (using opacity trick)
                                        opacity: root.cpu-usage / 100;
                                        animate opacity { duration: 300ms; }
                                        animate border-color { duration: 300ms; }
                                    }

                                    // Center text
                                    Text {
                                        text: Math.round(root.cpu-usage) + "%";
                                        color: root.cpu-usage > 80 ? Theme.color-emotional :
                                               root.cpu-usage > 50 ? Theme.amber : Theme.accent;
                                        font-size: Theme.fs-title-1;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // CPU info
                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    if root.cpu-model != "" : Text {
                                        text: root.cpu-model;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-micro;
                                        overflow: elide;
                                    }

                                    if root.cpu-frequency != "" : Text {
                                        text: root.cpu-frequency;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }

                                    // Load averages. `alignment: start` because a Text in a
                                    // HorizontalLayout stretches by default, which scattered the
                                    // three numbers across the whole card with nothing to say
                                    // which window each belonged to.
                                    HorizontalLayout {
                                        spacing: 6px;
                                        alignment: start;

                                        Text {
                                            text: "LOAD";
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            letter-spacing: 0.6px;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.load-avg-1;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-micro;
                                            font-weight: 600;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.load-avg-5;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-micro;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: root.load-avg-15;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            vertical-alignment: center;
                                        }
                                        Text {
                                            text: "1 / 5 / 15 min";
                                            color: Theme.text-dim.transparentize(35%);
                                            font-size: Theme.fs-micro;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.bg-elevated; }

                            // Per-core bars
                            Text {
                                text: "CORES";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                            }

                            for core in root.cpu-cores : HorizontalLayout {
                                spacing: 8px;
                                height: 16px;

                                Text {
                                    text: core.core-id;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    min-width: 16px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Rectangle {
                                    horizontal-stretch: 1;
                                    height: 8px;
                                    border-radius: 4px;
                                    background: Theme.bg-deep;

                                    Rectangle {
                                        x: 0;
                                        width: max(0px, parent.width * core.usage / 100);
                                        height: 100%;
                                        border-radius: 4px;
                                        background: core.usage > 80 ? Theme.color-emotional :
                                                   core.usage > 50 ? Theme.amber : Theme.accent;
                                        animate width { duration: 300ms; }
                                        changed x => { root.core-fill-x = self.x; }
                                        changed width => { root.core-fill-width = self.width; }
                                    }
                                }

                                Text {
                                    text: Math.round(core.usage) + "%";
                                    color: core.usage > 80 ? Theme.color-emotional :
                                           core.usage > 50 ? Theme.amber : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    min-width: 32px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }

                    // ── Memory Panel ──
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        height: mem-inner.preferred-height;

                        mem-inner := VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            // Section header
                            Text {
                                text: "MEMORY";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 2px;
                            }

                            // RAM gauge row
                            HorizontalLayout {
                                spacing: 16px;

                                // Circular gauge
                                Rectangle {
                                    width: 80px;
                                    height: 80px;

                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 40px;
                                        border-width: 5px;
                                        border-color: Theme.bg-deep;
                                        background: transparent;
                                    }

                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 40px;
                                        border-width: 5px;
                                        border-color: root.memory-usage > 85 ? Theme.color-emotional :
                                                     root.memory-usage > 60 ? Theme.amber : Theme.accent;
                                        background: transparent;
                                        opacity: root.memory-usage / 100;
                                        animate opacity { duration: 300ms; }
                                        animate border-color { duration: 300ms; }
                                    }

                                    Text {
                                        text: Math.round(root.memory-usage) + "%";
                                        color: root.memory-usage > 85 ? Theme.color-emotional :
                                               root.memory-usage > 60 ? Theme.amber : Theme.accent;
                                        font-size: Theme.fs-title-1;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Memory details
                                VerticalLayout {
                                    spacing: 4px;
                                    alignment: center;

                                    Text {
                                        text: root.memory-used-text + " / " + root.memory-total-text;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-caption;
                                        font-weight: 500;
                                    }

                                    if root.memory-available-text != "" : Text {
                                        text: "Available: " + root.memory-available-text;
                                        color: Theme.text-secondary;
                                        font-size: Theme.fs-micro;
                                    }
                                }
                            }

                            Rectangle { height: 1px; background: Theme.bg-elevated; }

                            // Memory breakdown
                            Text {
                                text: "BREAKDOWN";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                            }

                            // Breakdown rows
                            HorizontalLayout {
                                height: 20px;
                                Text { text: "Used"; color: Theme.text-secondary; font-size: Theme.fs-micro; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: root.memory-used-text; color: Theme.text-primary; font-size: Theme.fs-micro; font-weight: 500; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 20px;
                                Text { text: "Cached"; color: Theme.text-secondary; font-size: Theme.fs-micro; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: root.memory-cached-text; color: Theme.text-primary; font-size: Theme.fs-micro; font-weight: 500; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 20px;
                                Text { text: "Buffers"; color: Theme.text-secondary; font-size: Theme.fs-micro; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: root.memory-buffers-text; color: Theme.text-primary; font-size: Theme.fs-micro; font-weight: 500; vertical-alignment: center; }
                            }
                            HorizontalLayout {
                                height: 20px;
                                Text { text: "Available"; color: Theme.text-secondary; font-size: Theme.fs-micro; horizontal-stretch: 1; vertical-alignment: center; }
                                Text { text: root.memory-available-text; color: Theme.text-primary; font-size: Theme.fs-micro; font-weight: 500; vertical-alignment: center; }
                            }

                            Rectangle { height: 1px; background: Theme.bg-elevated; }

                            // Swap
                            Text {
                                text: "SWAP";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                            }

                            HorizontalLayout {
                                spacing: 8px;

                                Text {
                                    text: root.swap-used-text + " / " + root.swap-total-text;
                                    color: root.swap-usage > 80 ? Theme.color-emotional :
                                           root.swap-usage > 50 ? Theme.amber : Theme.text-secondary;
                                    font-size: Theme.fs-micro;
                                    horizontal-stretch: 1;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: Math.round(root.swap-usage) + "%";
                                    color: root.swap-usage > 80 ? Theme.color-emotional :
                                           root.swap-usage > 50 ? Theme.amber : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }

                            Rectangle {
                                height: 6px;
                                border-radius: 3px;
                                background: Theme.bg-deep;

                                swap-fill := Rectangle {
                                    x: 0;
                                    width: max(0px, parent.width * root.swap-usage / 100);
                                    height: 100%;
                                    border-radius: 3px;
                                    background: root.swap-usage > 80 ? Theme.color-emotional :
                                               root.swap-usage > 50 ? Theme.amber : Theme.amber;
                                    opacity: 0.8;
                                    animate width { duration: 300ms; }
                                }
                            }
                        }
                    }

                    // ── What Yantrik knows about this ──
                    AgentRail {
                        context-items: root.agent-context;
                        suggestions: root.agent-suggestions;
                        unavailable: root.agent-unavailable;
                        context-activated(id) => { root.agent-context-activated(id); }
                        suggestion-activated(id) => { root.agent-suggestion-activated(id); }
                    }
                }

                // ── Row 2: Disk + Network ──
                HorizontalLayout {
                    spacing: 12px;

                    // ── Disk Panel ──
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        height: disk-inner.preferred-height;

                        disk-inner := VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            Text {
                                text: "DISK";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 2px;
                            }

                            if root.disks.length == 0 : Text {
                                text: "No disk data";
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                            }

                            for disk in root.disks : VerticalLayout {
                                spacing: 4px;

                                HorizontalLayout {
                                    Text {
                                        text: disk.mount-point;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-micro;
                                        font-weight: 500;
                                        horizontal-stretch: 1;
                                        overflow: elide;
                                    }
                                    Text {
                                        text: disk.used-bytes + " / " + disk.total-bytes;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                    }
                                }

                                HorizontalLayout {
                                    spacing: 8px;

                                    Rectangle {
                                        horizontal-stretch: 1;
                                        height: 8px;
                                        border-radius: 4px;
                                        background: Theme.bg-deep;

                                        Rectangle {
                                            x: 0;
                                            width: max(0px, parent.width * disk.usage-percent / 100);
                                            height: 100%;
                                            border-radius: 4px;
                                            background: disk.usage-percent > 90 ? Theme.color-emotional :
                                                       disk.usage-percent > 75 ? Theme.amber : Theme.accent;
                                            animate width { duration: 300ms; }
                                            changed x => { root.disk-fill-x = self.x; }
                                            changed width => { root.disk-fill-width = self.width; }
                                        }
                                    }

                                    Text {
                                        text: Math.round(disk.usage-percent) + "%";
                                        color: disk.usage-percent > 90 ? Theme.color-emotional :
                                               disk.usage-percent > 75 ? Theme.amber : Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-weight: 600;
                                        min-width: 32px;
                                        horizontal-alignment: right;
                                    }
                                }

                                if disk.filesystem != "" : Text {
                                    text: disk.filesystem;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }

                                Rectangle { height: 1px; background: Theme.bg-elevated; }
                            }
                        }
                    }

                    // ── Network Panel ──
                    Rectangle {
                        horizontal-stretch: 1;
                        background: Theme.bg-card;
                        border-radius: Theme.r-lg;
                        height: net-inner.preferred-height;

                        net-inner := VerticalLayout {
                            padding: 14px;
                            spacing: 10px;

                            Text {
                                text: "NETWORK";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 2px;
                            }

                            if root.network-interfaces.length == 0 : Text {
                                text: "No network interfaces";
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                            }

                            for iface in root.network-interfaces : VerticalLayout {
                                spacing: 4px;

                                // Interface name + IP
                                HorizontalLayout {
                                    spacing: 8px;

                                    // Status dot
                                    Rectangle {
                                        width: 6px;
                                        height: 6px;
                                        y: (parent.height - 6px) / 2;
                                        border-radius: 3px;
                                        background: Theme.accent;
                                    }

                                    Text {
                                        text: iface.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-caption;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }

                                    Rectangle { horizontal-stretch: 1; }

                                    if iface.ip-address != "" : Text {
                                        text: iface.ip-address;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }
                                }

                                // Speed indicators
                                HorizontalLayout {
                                    spacing: 16px;
                                    height: 20px;

                                    // Download
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Icon {
                                            commands: Icons.arrow-down;
                                            size: 12px;
                                            tint: Theme.accent;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: iface.rx-speed;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-micro;
                                            vertical-alignment: center;
                                        }
                                    }

                                    // Upload
                                    HorizontalLayout {
                                        spacing: 4px;
                                        Icon {
                                            commands: Icons.arrow-up;
                                            size: 12px;
                                            tint: Theme.amber;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        Text {
                                            text: iface.tx-speed;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-micro;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                // Total transferred
                                HorizontalLayout {
                                    spacing: 12px;
                                    height: 18px;

                                    Text {
                                        text: "Total RX: " + iface.rx-bytes;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: "TX: " + iface.tx-bytes;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }
                                }

                                Rectangle { height: 1px; background: Theme.bg-elevated; }
                            }
                        }
                    }
                }

                // ── Row 2.5: AI Workloads (full width) ──
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.r-lg;
                    height: ai-wl-inner.preferred-height;

                    ai-wl-inner := VerticalLayout {
                        padding: 14px;
                        spacing: 8px;

                        // Header
                        HorizontalLayout {
                            spacing: 8px;
                            Text {
                                text: "AI WORKLOADS";
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                font-weight: 600;
                                letter-spacing: 2px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            // Status indicator
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - 8px) / 2;
                                border-radius: 4px;
                                background: root.ai-model-name != "" ? Theme.color-reminder : Theme.text-dim;
                                drop-shadow-blur: root.ai-model-name != "" ? 6px : 0px;
                                drop-shadow-color: Theme.color-success.transparentize(60%);
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // The honest state (#220). Nothing in Yantrik feeds the ai-* inputs --
                        // no service reports a running model, tokens per second or provider
                        // latency -- so with nothing measured this card used to draw a row of
                        // dashes beside a confident "0%" error rate while minds ran, implying
                        // readings nobody took. It now says plainly that there is no source,
                        // and the numbers only draw when something real arrives.
                        if !root.ai-has-measurements : Text {
                            text: root.ai-no-source-text;
                            color: Theme.text-dim;
                            font-size: Theme.fs-caption;
                            wrap: word-wrap;
                        }

                        if root.ai-has-measurements : VerticalLayout {
                        spacing: 8px;

                        // Model info row
                        HorizontalLayout {
                            spacing: 10px;
                            Text {
                                text: "Model";
                                color: Theme.text-dim;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.ai-model-name != "" ? root.ai-model-name : "—";
                                color: Theme.accent;
                                font-size: Theme.fs-body;
                                font-weight: 500;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }
                            if root.ai-model-tier != "" : Rectangle {
                                width: ai-tier-txt.preferred-width + 12px;
                                height: 20px;
                                border-radius: 10px;
                                background: root.ai-model-tier == "Large" ? AppIdentity.tint
                                          : root.ai-model-tier == "Medium" ? Theme.tint-cyan
                                          : root.ai-model-tier == "Small" ? Theme.tint-amber
                                          : Theme.hover-fill;
                                ai-tier-txt := Text {
                                    text: root.ai-model-tier;
                                    color: root.ai-model-tier == "Large" ? AppIdentity.accent
                                         : root.ai-model-tier == "Medium" ? AppIdentity.accent
                                         : root.ai-model-tier == "Small" ? Theme.amber
                                         : Theme.text-secondary;
                                    font-size: Theme.fs-micro;
                                    font-weight: 600;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // Metrics row
                        HorizontalLayout {
                            spacing: 24px;

                            // Tokens/sec
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Tokens/sec";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }
                                Text {
                                    text: root.ai-tokens-per-sec > 0.0 ? round(root.ai-tokens-per-sec) + " t/s" : "—";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-headline;
                                    font-weight: 600;
                                }
                            }

                            // Today's tokens
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Today";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }
                                Text {
                                    text: root.ai-tokens-today > 0 ? root.ai-tokens-today + "" : "—";
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-headline;
                                    font-weight: 600;
                                }
                            }

                            // Latency
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Latency";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }
                                Text {
                                    text: root.ai-provider-latency-ms >= 0 ? root.ai-provider-latency-ms + "ms" : "—";
                                    color: root.ai-provider-latency-ms >= 0 && root.ai-provider-latency-ms < 200 ? Theme.color-reminder
                                         : root.ai-provider-latency-ms < 500 ? Theme.amber
                                         : Theme.color-emotional;
                                    font-size: Theme.fs-headline;
                                    font-weight: 600;
                                }
                            }

                            // Error rate
                            VerticalLayout {
                                spacing: 2px;
                                horizontal-stretch: 1;
                                Text {
                                    text: "Error Rate";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }
                                Text {
                                    text: root.ai-error-rate > 0.0 ? round(root.ai-error-rate * 100.0) + "%" : "0%";
                                    color: root.ai-error-rate < 0.05 ? Theme.color-reminder
                                         : root.ai-error-rate < 0.2 ? Theme.amber
                                         : Theme.color-emotional;
                                    font-size: Theme.fs-headline;
                                    font-weight: 600;
                                }
                            }
                        }
                        }

                        // Active request progress bar
                        if root.ai-request-active : VerticalLayout {
                            spacing: 4px;
                            Rectangle { height: 1px; background: Theme.bg-elevated; }
                            HorizontalLayout {
                                spacing: 8px;
                                Text {
                                    text: "Active Request";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    vertical-alignment: center;
                                }
                                Rectangle {
                                    height: 4px;
                                    horizontal-stretch: 1;
                                    border-radius: 2px;
                                    background: Theme.bg-elevated;
                                    Rectangle {
                                        x: 0;
                                        width: parent.width * (root.ai-request-progress / 100.0);
                                        height: 4px;
                                        border-radius: 2px;
                                        background: Theme.accent;
                                        drop-shadow-blur: 4px;
                                        drop-shadow-color: Theme.accent-glow;
                                    }
                                }
                                Text {
                                    text: round(root.ai-request-progress) + "%";
                                    color: Theme.accent;
                                    font-size: Theme.fs-micro;
                                    font-weight: 600;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // ── Row 3: Processes (full width) ──
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.r-lg;
                    height: proc-inner.preferred-height;

                    proc-inner := VerticalLayout {
                        padding: 14px;
                        spacing: 6px;

                        // Header row
                        proc-header := HorizontalLayout {
                            spacing: 8px;
                            // The row keeps the buttons' height whether or not they are shown
                            // (#220): it used to grow 14px the moment a selection produced End
                            // and Force Kill, sliding the whole list down under the pointer
                            // between the press and the click that was meant to follow it.
                            height: 28px;

                            Text {
                                text: "PROCESSES";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 2px;
                                vertical-alignment: center;
                            }

                            Rectangle { horizontal-stretch: 1; }

                            // Action buttons (visible when a process is selected)
                            if root.selected-process-pid >= 0 : HorizontalLayout {
                                spacing: 6px;

                                ta-end := TouchArea {
                                    width: 56px;
                                    height: 28px;
                                    clicked => { root.kill-process(root.selected-process-pid); }
                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 8px;
                                        background: ta-end.has-hover ? Theme.hover-fill-strong : Theme.bg-elevated;
                                        animate background { duration: 120ms; }
                                        Text {
                                            text: "End";
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-micro;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }

                                ta-fkill := TouchArea {
                                    width: 72px;
                                    height: 28px;
                                    clicked => { root.force-kill-process(root.selected-process-pid); }
                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: 8px;
                                        background: ta-fkill.has-hover ? Theme.color-danger.brighter(20%) : Theme.color-danger;
                                        animate background { duration: 120ms; }
                                        Text {
                                            text: "Force Kill";
                                            color: Theme.text-on-accent;
                                            font-size: Theme.fs-micro;
                                            font-weight: 500;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Text {
                                text: root.processes.length + " shown";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                vertical-alignment: center;
                            }
                        }

                        // Search bar
                        proc-search-bar := Rectangle {
                            height: 30px;
                            background: Theme.bg-deep;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            border-radius: 8px;
                            clip: true;

                            HorizontalLayout {
                                padding-left: 10px;
                                padding-right: 8px;
                                spacing: 6px;

                                Icon {
                                    commands: Icons.search;
                                    size: 12px;
                                    tint: Theme.text-secondary;
                                    y: (parent.height - self.height) / 2;
                                }

                                proc-search-input := TextInput {
                                    vertical-alignment: center;
                                    font-size: Theme.fs-caption;
                                    color: Theme.text-primary;
                                    horizontal-stretch: 1;
                                    text: root.process-search;
                                    edited => {
                                        root.process-search = self.text;
                                        root.process-search-changed(self.text);
                                    }
                                }
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // Column headers
                        HorizontalLayout {
                            spacing: 8px;
                            height: 28px;

                            Text {
                                text: "PID";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                                min-width: 52px;
                                vertical-alignment: center;
                            }

                            Text {
                                text: "NAME";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                                horizontal-stretch: 1;
                                vertical-alignment: center;
                            }

                            // CPU% (sortable)
                            TouchArea {
                                min-width: 56px;
                                height: 28px;
                                clicked => { root.sort-by-column(0); }

                                HorizontalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "CPU%";
                                        color: root.sort-column == 0 ? AppIdentity.accent : Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        letter-spacing: 1px;
                                        font-weight: root.sort-column == 0 ? 700 : 400;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    if root.sort-column == 0 : Icon {
                                        commands: Icons.chevron-down;
                                        size: 12px;
                                        tint: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            // MEM% (sortable)
                            TouchArea {
                                min-width: 56px;
                                height: 28px;
                                clicked => { root.sort-by-column(1); }

                                HorizontalLayout {
                                    spacing: 2px;
                                    Text {
                                        text: "MEM%";
                                        color: root.sort-column == 1 ? AppIdentity.accent : Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        letter-spacing: 1px;
                                        font-weight: root.sort-column == 1 ? 700 : 400;
                                        horizontal-alignment: right;
                                        vertical-alignment: center;
                                    }
                                    if root.sort-column == 1 : Icon {
                                        commands: Icons.chevron-down;
                                        size: 12px;
                                        tint: Theme.accent;
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }

                            Text {
                                text: "STATUS";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                                min-width: 44px;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                        }

                        Rectangle { height: 1px; background: Theme.bg-elevated; }

                        // An empty list says which of the two emptinesses this is (#220):
                        // a filter that matched nothing echoes the word typed, and only a
                        // machine that reported nothing at all says "No process data".
                        if root.processes.length == 0 : Text {
                            text: root.process-empty-text;
                            color: Theme.text-dim;
                            font-size: Theme.fs-caption;
                        }

                        for proc in root.processes : Rectangle {
                            height: 26px;
                            border-radius: 4px;
                            background: root.selected-process-pid == proc.pid ? Theme.hover-fill-strong : transparent;
                            animate background { duration: 120ms; }

                            TouchArea {
                                width: 100%; height: 100%;
                                clicked => {
                                    if root.selected-process-pid == proc.pid {
                                        root.selected-process-pid = -1;
                                    } else {
                                        root.selected-process-pid = proc.pid;
                                    }
                                }
                            }

                            HorizontalLayout {
                                spacing: 8px;
                                padding-left: 4px;
                                padding-right: 4px;

                                Text {
                                    text: proc.pid;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    min-width: 52px;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: proc.name;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-caption;
                                    horizontal-stretch: 1;
                                    overflow: elide;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: Math.round(proc.cpu-percent * 10) / 10 + "%";
                                    color: proc.cpu-percent > 80 ? Theme.color-emotional :
                                           proc.cpu-percent > 50 ? Theme.amber : Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    font-weight: 500;
                                    min-width: 56px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: Math.round(proc.mem-percent * 10) / 10 + "%";
                                    color: proc.mem-percent > 80 ? Theme.color-emotional :
                                           proc.mem-percent > 50 ? Theme.amber : Theme.text-secondary;
                                    font-size: Theme.fs-caption;
                                    font-weight: 500;
                                    min-width: 56px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }

                                Text {
                                    text: proc.status;
                                    color: proc.status == "R" ? AppIdentity.accent :
                                           proc.status == "S" ? Theme.text-dim :
                                           proc.status == "Z" ? Theme.color-emotional : Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    min-width: 44px;
                                    horizontal-alignment: right;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }

                // Bottom spacer
                Rectangle { height: 32px; }
            }
        }
    }
}
