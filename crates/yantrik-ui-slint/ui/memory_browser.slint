// Memory browser — what the Mind remembers about the person and their work.
//
// A trust interface, not a database viewer (the art direction of 20 Oct 2026, F): each row is a
// statement in reading size with where it came from under it in words (wire/memory_rows.rs makes
// both), on the ground with a hairline between rows, in a column no wider than reading needs. The
// type pills, importance bars, valence marks and relevance bars went; so did the machine's own
// records and the same fact twice.

import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";

export struct MemoryItem {
    rid: string,
    text: string,
    // Where it came from, in words: "A fact · saved 2d ago", "Saved 2 times · 10m ago".
    origin: string,
    score: float,
}

export component MemoryBrowser inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    in property <[MemoryItem]> results: [];
    in property <bool> is-searching: false;
    in property <int> total-memories: 0;
    // The rows are the newest memories rather than a search's matches: what the screen shows
    // when it opens and when its search is cleared (VM 520 sweep, 4 October -- it was blank
    // until something was typed, over about 1,036 stored memories).
    in property <bool> showing-recent: false;
    // No answer came within a few seconds (wire/memory_wait.rs). VM 520, 4 October: the screen
    // sat on "searching" over a blank page while the companion was busy with its own turns.
    in property <bool> busy: false;
    // What Retry asks again: the last query, or "" for the newest memories.
    property <string> last-query: "";
    callback search(string);
    callback back-pressed();

    background: Theme.bg-deep;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // A 56px bar and a 52px search bar beneath it, replaced by the one header every app
        // wears.
        //
        // The search field here rendered as a blank strip, and it was not a layout bug: its
        // icon was a magnifying-glass EMOJI, which draws as nothing on a machine with no emoji
        // font, and the input had no placeholder. An empty box with an invisible icon and no
        // prompt is indistinguishable from a decorative rectangle, which is exactly what it
        // looked like. The back button was a left-arrow character for the same reason.
        //
        // AppHeader draws both as stroke paths from the Icons set, at the size everything else
        // uses, and gives the field a placeholder.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "memory";
            show-back: true;
            icon: Icons.chip;
            title: "Memory";
            subtitle: "What the Mind remembers about you and your work";
            show-search: true;
            search-placeholder: "Search memories";
            status: root.is-searching ? "searching" : root.busy ? "busy" : "";
            back => { root.back-pressed(); }
            search-accepted(q) => { root.last-query = q; root.search(q); }
            // Clearing the field goes back to the newest memories, rather than leaving the last
            // search's matches under an empty box.
            search-edited(q) => { if (q == "") { root.last-query = ""; root.search(""); } }
        }

        // The rows, in a column no wider than reading needs.
        if results.length > 0 : Flickable {
            vertical-stretch: 1;
            viewport-height: list.preferred-height;
            list := VerticalLayout {
                width: parent.width;
                padding-left: max(Theme.sp-6, (root.width - 760px) / 2);
                padding-right: max(Theme.sp-6, (root.width - 760px) / 2);
                padding-top: Theme.sp-6;
                padding-bottom: Theme.sp-6;
                spacing: 0;
                alignment: start;
                // What the rows are: the newest, or what a search found.
                Text {
                    text: root.showing-recent ? "Most recent" : "Best matches";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    font-weight: 500;
                    height: 28px;
                    vertical-alignment: center;
                }
                for mem in root.results : VerticalLayout {
                    spacing: 0;
                    VerticalLayout {
                    padding-top: Theme.sp-4;
                    padding-bottom: Theme.sp-4;
                    spacing: Theme.sp-1;
                    Text {
                        text: mem.text;
                        color: Theme.text-primary;
                        font-size: Theme.fs-reading;
                        wrap: word-wrap;
                    }
                    Text {
                        text: mem.origin;
                        color: Theme.text-dim;
                        font-size: Theme.fs-caption;
                        overflow: elide;
                    }
                    }
                    Rectangle { height: 1px; background: Theme.separator; }
                }
            }
        }

        // Empty state
        //
        // Was two lines of dim text floating in the middle of a black screen. Every other view
        // in this OS uses YEmptyState for this -- a stroke glyph in a tinted circle, a title
        // and one sentence -- so this one looked like a screen that had failed to load rather
        // than one that is waiting for you.
        //
        // With nothing searched, the count is said beside the prompt, so an empty list is never
        // read as an empty store.
        // Still waiting, and nothing to show yet: say so, never a blank page.
        if results.length == 0 && is-searching : YEmptyState {
            vertical-stretch: 1;
            icon-path: Icons.chip;
            title: "Reading your memories";
            description: root.total-memories > 0 ? "\{root.total-memories} stored." : "";
        }

        // No answer in time. The count is still the count, and Retry asks again.
        if results.length == 0 && !is-searching && root.busy : YEmptyState {
            vertical-stretch: 1;
            icon-path: Icons.chip;
            title: "Memories are busy \u{2014} try again";
            description: root.total-memories > 0
                ? "\{root.total-memories} stored. Yantrik is in the middle of something; they will be here in a moment."
                : "Yantrik is in the middle of something; try again in a moment.";
            action-label: "Retry";
            action-clicked => { root.search(root.last-query); }
        }

        if results.length == 0 && !is-searching && !root.busy : YEmptyState {
            vertical-stretch: 1;
            icon-path: root.showing-recent ? Icons.chip : Icons.search;
            // A search over saved entries, said as one (review by GPT-6 Astra, F): it finds what
            // matches the words, not everything a mind "knows", and it can miss.
            title: root.showing-recent ? "Search saved memories" : "Nothing matched";
            description: !root.showing-recent ? "Try other words, or clear the search to see the newest memories."
                : root.total-memories > 0 ? "\{root.total-memories} stored. Enter a query to find matching saved entries. Results may be incomplete."
                : "Enter a query to find matching saved entries. Results may be incomplete.";
        }
    }
}
