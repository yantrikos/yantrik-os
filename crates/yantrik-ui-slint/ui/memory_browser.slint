// Memory browser — search and explore stored memories.

import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";
import { ListView } from "std-widgets.slint";

export struct MemoryItem {
    rid: string,
    text: string,
    memory-type: string,  // "episodic", "semantic", "procedural"
    importance: float,
    valence: float,
    score: float,
    time-ago: string,
}

export component MemoryBrowser inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    in property <[MemoryItem]> results: [];
    in property <bool> is-searching: false;
    in property <int> total-memories: 0;
    // The rows are the newest memories rather than a search's matches: what the screen shows
    // when it opens and when its search is cleared (VM 520 sweep, 4 October -- it was blank
    // until something was typed, over about 1,036 stored memories).
    in property <bool> showing-recent: false;
    callback search(string);
    callback back-pressed();

    background: Theme.bg-deep;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // A 56px bar and a 52px search bar beneath it, replaced by the one header every app
        // wears.
        //
        // The search field here rendered as a blank strip, and it was not a layout bug: its
        // icon was a magnifying-glass EMOJI, which draws as nothing on a machine with no emoji
        // font, and the input had no placeholder. An empty box with an invisible icon and no
        // prompt is indistinguishable from a decorative rectangle, which is exactly what it
        // looked like. The back button was a left-arrow character for the same reason.
        //
        // AppHeader draws both as stroke paths from the Icons set, at the size everything else
        // uses, and gives the field a placeholder.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "memory";
            show-back: true;
            icon: Icons.chip;
            title: "Memories";
            subtitle: "\{root.total-memories} stored";
            show-search: true;
            search-placeholder: "Search memories";
            status: root.is-searching ? "searching" : "";
            back => { root.back-pressed(); }
            search-accepted(q) => { root.search(q); }
            // Clearing the field goes back to the newest memories, rather than leaving the last
            // search's matches under an empty box.
            search-edited(q) => { if (q == "") { root.search(""); } }
        }

        // What the rows are: the newest, or what a search found.
        if results.length > 0 : HorizontalLayout {
            padding-left: Theme.sp-4;
            height: 28px;
            Text {
                text: root.showing-recent ? "Most recent" : "Best matches";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                font-weight: 600;
                vertical-alignment: center;
            }
        }

        // Results
        ListView {
            vertical-stretch: 1;

            for mem[idx] in results : Rectangle {
                background: Theme.bg-card;
                border-radius: Theme.radius-card;
                height: mem-layout.preferred-height;

                mem-layout := VerticalLayout {
                    padding: 12px;
                    spacing: 6px;

                    // Header row: type badge + time
                    HorizontalLayout {
                        spacing: 8px;

                        // Type badge
                        Rectangle {
                            height: 18px;
                            width: type-text.preferred-width + 12px;
                            border-radius: 4px;
                            background: mem.memory-type == "episodic" ? Theme.amber-glow :
                                        mem.memory-type == "semantic" ? Theme.cyan-glow :
                                        Theme.amber-dim;

                            type-text := Text {
                                text: mem.memory-type;
                                color: mem.memory-type == "episodic" ? Theme.amber :
                                       mem.memory-type == "semantic" ? Theme.color-follow-up :
                                       Theme.amber-dim;
                                font-size: Theme.fs-micro;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }

                        // Importance bar
                        Rectangle {
                            width: 30px;
                            height: 3px;
                            y: (parent.height - 3px) / 2;
                            border-radius: 1.5px;
                            background: Theme.bg-elevated;

                            Rectangle {
                                width: parent.width * mem.importance;
                                height: parent.height;
                                border-radius: 1.5px;
                                background: Theme.amber;
                            }
                        }

                        // Valence indicator
                        Text {
                            text: mem.valence > 0.2 ? "+" : mem.valence < -0.2 ? "−" : "·";
                            color: mem.valence > 0.2 ? Theme.color-check-in :
                                   mem.valence < -0.2 ? Theme.color-conflict :
                                   Theme.text-dim;
                            font-size: Theme.fs-body;
                            font-weight: 700;
                            vertical-alignment: center;
                        }

                        // Spacer + time
                        Text {
                            horizontal-stretch: 1;
                            text: mem.time-ago;
                            color: Theme.text-dim;
                            font-size: Theme.font-small;
                            horizontal-alignment: right;
                            vertical-alignment: center;
                        }
                    }

                    // Memory text
                    Text {
                        text: mem.text;
                        color: Theme.text-primary;
                        font-size: Theme.font-body;
                        wrap: word-wrap;
                        overflow: elide;
                    }

                    // Score (if search result)
                    if mem.score > 0 : HorizontalLayout {
                        Text {
                            text: "relevance ";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                        }
                        Rectangle {
                            width: 50px;
                            height: 3px;
                            y: (parent.height - 3px) / 2;
                            border-radius: 1.5px;
                            background: Theme.bg-elevated;

                            Rectangle {
                                width: parent.width * clamp(mem.score, 0, 1.0);
                                height: parent.height;
                                border-radius: 1.5px;
                                background: Theme.amber-dim;
                            }
                        }
                    }
                }
            }
        }

        // Empty state
        //
        // Was two lines of dim text floating in the middle of a black screen. Every other view
        // in this OS uses YEmptyState for this -- a stroke glyph in a tinted circle, a title
        // and one sentence -- so this one looked like a screen that had failed to load rather
        // than one that is waiting for you.
        //
        // With nothing searched, the count is said beside the prompt, so an empty list is never
        // read as an empty store.
        if results.length == 0 && !is-searching : YEmptyState {
            vertical-stretch: 1;
            icon-path: root.showing-recent ? Icons.chip : Icons.search;
            title: root.showing-recent ? "Search your memories" : "Nothing matched";
            description: !root.showing-recent ? "Try other words, or clear the search to see the newest memories."
                : root.total-memories > 0 ? "\{root.total-memories} stored. Type a query above and Yantrik will recall what it knows."
                : "Type a query above and Yantrik will recall what it knows.";
        }
    }
}
