// Personality screen — four trait bars + opinions + shared references.

import { Theme } from "theme.slint";
import { Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppColor } from "components/app_color.slint";

// One trait: its name and its number on a line, a 4px bar under them. The bar is the accent,
// because a reading is data; amber would say it needs the person, and it does not.
component TraitBar inherits VerticalLayout {
    in property <string> label;
    in property <float> value;
    spacing: 6px;
    HorizontalLayout {
        Text {
            text: root.label;
            color: Theme.text-primary;
            font-size: Theme.fs-body;
            horizontal-stretch: 1;
        }
        Text {
            text: Math.round(clamp(root.value, 0, 1) * 100) / 100;
            color: Theme.text-secondary;
            font-size: Theme.fs-body;
        }
    }
    Rectangle {
        height: 4px;
        border-radius: 2px;
        background: Theme.bg-elevated;
        Rectangle {
            x: 0px;
            width: parent.width * clamp(root.value, 0, 1);
            height: parent.height;
            border-radius: 2px;
            background: Theme.accent;
        }
    }
}

export struct OpinionData {
    topic: string,
    stance: string,
    confidence: float,
}

export struct SharedRefData {
    text: string,
    times-used: int,
}

export component PersonalityScreen inherits Rectangle {
    // ── Window chrome ──
    //
    // Passed down from the shell's WindowFrame rather than decided here, because this same
    // component is drawn in two places: inside the shell, where its header is the only chrome
    // the surface has, and inside a standalone binary, where the compositor draws a titlebar
    // and a second set of buttons would be a second set of buttons. Default off, so the
    // standalone case needs to say nothing.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    in property <float> formality: 0.5;
    in property <float> humor-ratio: 0.5;
    in property <float> opinion-strength: 0.5;
    in property <float> question-ratio: 0.5;
    in property <[OpinionData]> opinions: [];
    in property <[SharedRefData]> shared-refs: [];
    callback back-pressed();

    background: Theme.bg-deep;

    VerticalLayout {
        spacing: 0px;

        // -- Header --
        //
        // Was a hand-rolled bar whose back button was the CHARACTER "left arrow" in a TouchArea.
        // A glyph is only an icon if the font has it; the same habit put an emoji in the Memory
        // browser's search field, where it drew as nothing and made the whole field look blank.
        // AppHeader's back button is a stroke path from the Icons set.
        AppHeader {
            show-window-controls: root.show-window-controls;
            maximized: root.maximized;
            minimize => { root.minimize(); }
            toggle-maximize => { root.toggle-maximize(); }
            close-window => { root.close-window(); }
            app-id: "personality";
            show-back: true;
            icon: Icons.companion;
            title: "Personality";
            back => { root.back-pressed(); }
        }

        // Scrollable content
        Flickable {
            vertical-stretch: 1;

            VerticalLayout {
                padding: 24px;
                spacing: 20px;
                alignment: start;

                // Four bars with their numbers, on a card. This was a radar chart: two coloured
                // lines on a cross with four axis words, no scale and no legend, so no reading of
                // it could be checked against anything. Each trait is a number from 0 to 1, and
                // the bar and the figure say the same number.
                Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: traits.preferred-height;

                    traits := VerticalLayout {
                        padding: 16px;
                        spacing: 14px;
                        Text {
                            text: "Each trait from 0 to 1";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-caption;
                        }
                        TraitBar { label: "Formality"; value: root.formality; }
                        TraitBar { label: "Humour"; value: root.humor-ratio; }
                        TraitBar { label: "Opinion strength"; value: root.opinion-strength; }
                        TraitBar { label: "Question ratio"; value: root.question-ratio; }
                    }
                }

                // Opinions section
                Text {
                    text: "Opinions";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    letter-spacing: 1px;
                }

                for op[idx] in opinions : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: op-layout.preferred-height;

                    op-layout := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;

                        VerticalLayout {
                            horizontal-stretch: 1;
                            spacing: 4px;

                            Text {
                                text: op.topic;
                                color: Theme.text-primary;
                                font-size: Theme.fs-body;
                                font-weight: 600;
                            }

                            Text {
                                text: op.stance;
                                color: Theme.text-primary;
                                font-size: Theme.font-body;
                                wrap: word-wrap;
                            }
                        }

                        // Confidence bar
                        Rectangle {
                            width: 40px;
                            height: 4px;
                            y: (parent.height - 4px) / 2;
                            border-radius: 2px;
                            background: Theme.bg-elevated;

                            Rectangle {
                                width: parent.width * op.confidence;
                                height: parent.height;
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                        }
                    }
                }

                // Empty state for opinions
                //
                // Left-aligned, like the heading it belongs to. It was centred, so "Opinions"
                // sat at x=24 and the line explaining that there are none sat at x=640 -- a
                // heading and its content with six hundred pixels between them, reading as two
                // unrelated things.
                if opinions.length == 0 : Text {
                    text: "No opinions formed yet";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                }

                // Shared references section
                Text {
                    text: "Shared References";
                    color: Theme.text-secondary;
                    font-size: Theme.font-small;
                    letter-spacing: 1px;
                }

                for sr[idx] in shared-refs : Rectangle {
                    background: Theme.bg-card;
                    border-radius: Theme.radius-card;
                    height: sr-layout.preferred-height;

                    sr-layout := HorizontalLayout {
                        padding: 12px;
                        spacing: 8px;

                        Text {
                            text: "\"" + sr.text + "\"";
                            color: Theme.text-primary;
                            font-size: Theme.font-body;
                            font-italic: true;
                            wrap: word-wrap;
                            horizontal-stretch: 1;
                        }

                        Text {
                            text: "×" + sr.times-used;
                            color: Theme.text-dim;
                            font-size: Theme.font-small;
                            vertical-alignment: center;
                        }
                    }
                }

                if shared-refs.length == 0 : Text {
                    text: "No shared references yet";
                    color: Theme.text-dim;
                    font-size: Theme.font-body;
                }
            }
        }
    }
}
