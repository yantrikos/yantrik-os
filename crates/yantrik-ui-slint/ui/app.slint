// Yantrik OS — AI-native desktop shell.
// Screen states: 0=boot, 1=desktop, 2=onboarding, 3=lock, 4=bond, 5=personality,
//   6=memory, 7=settings, 8=files, 9=notifications, 10=system,
//   11=image_viewer, 12=text_editor, 13=media_player, 14=terminal, 15=notes, 16=about,
//   17=email, 18=calendar, 19=weather, 20=music_player, 21=package_manager, 22=network_manager, 23=system_monitor,
//   24=download_manager, 25=snippet_manager, 26=container_manager, 27=device_dashboard, 28=permission_dashboard,
//   29=spreadsheet, 30=document_editor, 31=presentation.
// The AI IS the shell — Intent Lens is the primary interaction.

import { Theme, ThemeMode, ThemeOverrides, AccentPreset } from "theme.slint";
import { Taskbar } from "components/taskbar.slint";
import { StatusBar } from "components/status_bar.slint";
import { BootScreen, BootStage } from "boot.slint";
import { OnboardingScreen } from "onboarding.slint";
import { DesktopScreen } from "desktop.slint";
import { BondScreen, BondData } from "bond.slint";
import { PersonalityScreen, OpinionData, SharedRefData } from "personality.slint";
import { LockScreen } from "lock.slint";
import { LoginScreen } from "login.slint";
import { SettingsScreen, SettingsCategoryItem, AIProviderData, AIModelData, AIStatusData, HarnessData, HarnessRowData } from "settings.slint";
import { SkillData } from "skill_store.slint";
import { MemoryBrowser, MemoryItem } from "memory_browser.slint";
import { FileBrowser, FileEntry, BreadcrumbSegment, FileDetailData, FileTabData, FileOpItem, FilePlaceData, FileRecentData, OpenWithItem } from "file_browser.slint";
import { NotificationCenter, NotificationData, NotifActionData } from "notification_center.slint";
import { SystemDashboard, ProcessData } from "system_dashboard.slint";
import { VoiceOverlay } from "voice_overlay.slint";
import { AboutScreen, ComponentVersionData } from "about.slint";
import { PackageManager, PackageData, PendingAction } from "package_manager.slint";
import { DeviceDashboardScreen, UsbDeviceData, PciDeviceData, InputDeviceData, StorageDeviceData, DisplayDeviceData } from "device_dashboard.slint";
import { PermissionDashboardScreen, UserData, GroupData, PermFileData } from "permission_dashboard.slint";
import { ToastBanner, ToastData, ToastActionData } from "components/toast_banner.slint";
import { ProblemReportScreen, ProblemRow } from "problem_report.slint";
// Agents (screen 34), and the window one agent pops out into. The window and the global it reads
// are exported so the shell can create a window per agent and fill each one.
import { AgentsScreen, AgentsState } from "agents.slint";
export { AgentWindow, AgentsState, AgentTabData, AgentRowData, AgentRunData, AgentItemData, AgentHeaderData, AgentDetailsData, AgentMindData, AgentRoleData } from "agents.slint";
export { OverviewNode, OverviewEdge } from "agents_overview.slint";
// Recipes (screen 35): every recipe as its stages. The global is exported so the shell can fill it.
import { RecipesScreen, RecipesState } from "recipes.slint";
export { RecipesState, RecipeTabData, RecipeRowData, RecipeStageData, RecipeStepData } from "recipes.slint";
import { CommandItem } from "components/command_palette.slint";
import { ContentBlock, MessageData } from "components/message_bubble.slint";
import { ToolCallData } from "components/tool_call.slint";
import { UrgeCardData } from "components/glance_card.slint";
import { LensResult, ApprovalRequest, ApprovalCard, VaultUnlockRequest, VaultUnlockCard } from "components/intent_lens.slint";
import { MindModeMenu, MindRule, MindAuditEntry } from "components/mind_mode_menu.slint";
import { WhisperCardItem } from "components/whisper_card.slint";
import { BriefSection } from "components/morning_brief.slint";
import { ClipboardEntryData } from "components/clipboard_panel.slint";
import { AppGridItem } from "components/app_grid.slint";
import { WindowItem } from "components/window_switcher.slint";
import { DockItem } from "components/app_dock.slint";
import { CategoryItem } from "components/app_grid.slint";
// The mind panel: shell furniture at the right edge, instantiated below beside the taskbar.
import { ServiceItem, MindPanel, MindPanelState, MindPanelNow, MindPanelAgent, MindPanelRecipe, MindPanelAct } from "components/mind_panel.slint";
export { MindPanelState, MindPanelNow, MindPanelAgent, MindPanelRecipe, MindPanelAct }
import { WindowFrame } from "components/window_frame.slint";
import { YSidebarItem, YSidebarSection } from "components/y_sidebar.slint";
import { YTabItem } from "components/y_tabs.slint";
import { YMenuAction, YContextMenu } from "components/y_context_menu.slint";
import { Icons } from "components/icon.slint";
import { Tr } from "translations.slint";

export { HarnessData, HarnessRowData, Tr, ThemeMode, ThemeOverrides, AccentPreset, ContentBlock, MessageData, ToolCallData, UrgeCardData, BondData, OpinionData, SharedRefData, MemoryItem, LensResult, ApprovalRequest, MindRule, MindAuditEntry, WhisperCardItem, FileEntry, BreadcrumbSegment, FileDetailData, NotificationData, NotifActionData, ProcessData, ClipboardEntryData, AppGridItem, CategoryItem, ServiceItem, WindowItem, DockItem, ToastData, ToastActionData, PackageData, PendingAction, UsbDeviceData, PciDeviceData, InputDeviceData, StorageDeviceData, DisplayDeviceData, UserData, GroupData, PermFileData, ComponentVersionData, BriefSection, CommandItem, YSidebarItem, YSidebarSection, YTabItem, YMenuAction, ProblemRow }

export component App inherits Window {
    default-font-family: Theme.font-ui;
    title: "Yantrik OS";
    default-font-size: Theme.fs-body;
    background: Theme.bg-deep;


    // Screen state: 0=boot, 1=desktop, 2=onboarding, 3=lock, 4=bond, 5=personality,
    //   6=memory, 7=settings, 8=files, 9=notifications, 10=system, 21=package_manager
    in-out property <int> current-screen: 0;

    // Window chrome state (shared across all windowed screens)
    in-out property <bool> window-maximized: true;

    // Window geometry (when not maximized) — drag/resize updates these
    in-out property <length> window-x: 80px;
    in-out property <length> window-y: 40px;
    in-out property <length> window-w: self.width * 0.85;
    in-out property <length> window-h: (self.height - 60px) * 0.90;

    // Boot state
    // ── Boot ──
    //
    // Filled by wire/boot.rs from what the shell is genuinely waiting for. The status line is
    // no longer a fixed word.
    in property <string> boot-status: "";
    in property <[BootStage]> boot-stages: [];
    in property <float> progress: 0.0;
    in property <string> version: "";
    // Fired by wire/boot.rs when the stages are done, or when the deadline passes.
    //
    // The handler lives on the root because Rust can only invoke the ROOT's callbacks. It was
    // on the BootScreen instance, so `ui.invoke_boot_complete()` reached a callback nobody had
    // written a body for and the machine sat at 100% with four ticks and no desktop.
    callback boot-complete();
    boot-complete => {
        if root.onboarding-step > 0 {
            root.current-screen = 2;
            root.navigate(2);
        } else {
            root.current-screen = 1;
            root.navigate(1);
        }
    }

    // Companion state
    in property <int> memory-count: 0;
    in property <bool> is-thinking: false;
    in property <bool> has-urges: false;
    in property <bool> is-speaking: false;
    in property <bool> is-listening: false;
    in property <bool> companion-online: true;  // LLM backend reachable
    // #30: a shell whose assistant has no model says so where the person can see it —
    // one persistent status-bar line that clicks straight into Settings → AI. Rust sets
    // it from `assistant_offline_notice` and clears it when a model answers again.
    in property <string> assistant-offline-notice: "";

    // Chat state
    in property <[MessageData]> messages: [];
    in property <bool> is-generating: false;

    /// What a mind has asked the person to allow, and what they recently decided.
    ///
    /// Filled by `control_approvals::publish`. Pending entries are drawn twice over: inside the
    /// Lens's conversation when it is open in chat mode, and over whatever screen is up when it
    /// is not — see the overlay at the foot of this file. A request the person never sees is a
    /// request that expires unanswered, which is indistinguishable from the machine ignoring
    /// them.
    in property <[ApprovalRequest]> approvals: [];
    /// The one request waiting on an answer, without the records of the ones already decided —
    /// what the overlay draws. Zero or one entry. Two lists rather than one filtered at draw
    /// time because Slint has no way to skip a row inside a `for`, and a stack of zero-height
    /// rows would leave the card floating below a gap the size of the session's history.
    in property <[ApprovalRequest]> pending-approvals: [];
    /// How many further requests are queued behind it. See `approvals-waiting` in intent_lens.
    in property <int> approvals-waiting: 0;
    /// Pressed Allow. This callback, and the one below it, are the only way a grant comes into
    /// existence anywhere in this OS — there is no action on the shell's control surface that
    /// grants. See crates/yantrik-ui/src/approvals.rs.
    callback approval-allow(string);
    /// The same grant, plus a standing rule for that (app, action) until the shell restarts.
    /// Never offered for `dangerous` or for an action the app says cannot be undone.
    callback approval-allow-session(string);
    callback approval-deny(string);

    // ── Agents glue: the Lens's "open in Agents" (crates/yantrik-ui/src/wire/agents.rs) ──
    in property <bool> lens-can-open-in-agents: false;
    callback lens-open-in-agents();
    callback lens-open-history();

    // ── The vault, and the one way a passphrase gets into this machine ──
    //
    // Filled by `wire::vault`. `reason` empty means nothing is being asked; anything else puts the
    // card on screen. There is no control-surface action, tool argument or RPC method that can
    // set `vault-unlock-submit` going — it is a keystroke in the card below and nothing else,
    // which is the whole claim the feature makes. See design/vault-unlock-2026-09-21.md.
    in property <VaultUnlockRequest> vault-unlock: { reason: "", error: "", first-time: false };
    /// The typed passphrase. Goes to `vault_unlock::adopt` and is not kept by anything on the way.
    callback vault-unlock-submit(string);
    callback vault-unlock-dismiss();
    /// The same three facts `describe shell` publishes under `vault`, for Settings > Privacy.
    in property <bool> vault-protected: false;
    in property <bool> vault-unlocked: false;
    in property <string> vault-why: "";
    /// Settings asked for the prompt. Carries nothing; it only raises the card above.
    callback vault-set-passphrase();

    // ── What the mind may do without being asked ──
    //
    // Filled by `control_approvals::publish_mode`. One fixed policy — ask about every sensitive
    // action — was wrong at both ends: forty cards for a long trusted job, and no way to say
    // "just look, don't touch". See crates/yantrik-ui/src/mind_mode.rs.
    in property <string> mind-mode: "ask";
    /// The chip's text: the mode, and the countdown while a bypass is running.
    in property <string> mind-mode-label: "Ask";
    in property <string> mind-mode-means: "";
    /// The machine's own wall, shown beside the mode because neither is understandable alone.
    in property <string> mind-ceiling: "sensitive";
    /// Whether the apps a mind opens go into Mind View (#239) rather than onto this desktop.
    in property <bool> mind-view-on: true;
    in property <[MindRule]> mind-session-rules: [];
    in property <[MindAuditEntry]> mind-audit: [];
    in-out property <bool> mind-menu-open: false;
    /// The menu's two sub-panels, held here rather than inside it because the chip that opens
    /// the menu has to be able to reset them, and the menu lives behind an `if`.
    in-out property <bool> mind-menu-confirming: false;
    in-out property <bool> mind-menu-audit-open: false;
    /// The menu belongs to the screen it was opened over: going anywhere else puts it away,
    /// whoever moved — a press, `show_screen`, a lock. `show_mind_audit` opens it from the socket,
    /// and it used to stay over every screen after, closable by nothing but a pointer (#184).
    /// `close_mind_menu` is the socket's way to put it away without moving.
    changed current-screen => {
        root.mind-menu-open = false;
        root.mind-menu-confirming = false;
        root.mind-menu-audit-open = false;
        // The taskbar entry's menu belongs to the screen it was opened over for the same
        // reason (#232) — and a lock is a screen change, so a menu can never survive onto the
        // lock screen, where its Close would act on a machine nobody has unlocked.
        root.taskbar-menu-open = false;
    }
    /// These three are the only way this desktop becomes MORE permissive. They are callbacks,
    /// reached by a pointer; nothing on the control surface can raise the mode or make a rule.
    callback mind-mode-chosen(string);
    callback mind-bypass-chosen(string);
    callback mind-rule-revoked(string, string);
    /// Where a mind's apps open. A person's choice, reached by a pointer like the three above.
    callback mind-view-chosen(bool);

    // ── The mind panel: where it is drawn, how open, and the room it takes ──
    //
    // Furniture, like the status bar and the taskbar: on every screen the taskbar is on, and the
    // room it takes is taken on every one of those screens — the desktop insets its content by it
    // and a maximized shell window stops short of it. The machine rail it replaces was declared in
    // desktop.slint and so existed on one screen only; that mistake is not repeated here.
    //
    // Open on the desktop, the strip everywhere else, until the person chooses otherwise; each
    // place keeps its own choice (MindPanelState, filled from ~/.config/yantrik/mind-panel.json by
    // crates/yantrik-ui/src/mind_panel.rs). Focus mode keeps it to the strip.
    property <bool> mind-panel-shown: root.current-screen == 1
        || (root.current-screen >= 4 && root.current-screen <= 31)
        || root.current-screen == 33 || root.current-screen == 34 || root.current-screen == 35;
    property <bool> mind-panel-open: root.mind-panel-shown
        && !(root.current-screen == 1 && root.focus-mode)
        && (root.current-screen == 1 ? MindPanelState.desktop-expanded : MindPanelState.elsewhere-expanded);
    // Below this width the open card floats over the screen instead of taking its room, so a
    // compact display keeps its working area and can still open the panel to look.
    property <bool> mind-panel-docks: root.width >= 1100px;
    // 302 for the card and 16 either side of it; 44 for the strip.
    property <length> mind-panel-reserve: !root.mind-panel-shown ? 0px
        : root.mind-panel-open && root.mind-panel-docks ? 334px : 44px;
    // The desktop's own overlays use the right edge too — the Lens docks there — so the panel
    // steps out of the way while one is up rather than drawing over it. Its room is kept, so
    // nothing underneath moves.
    property <bool> mind-panel-covered: root.current-screen == 1
        && (root.lens-open || root.app-grid-open || root.quick-settings-open || root.power-menu-open
            || root.window-switcher-open || root.command-palette-open || root.clip-panel-open);

    // Desktop state
    in property <[UrgeCardData]> urges: [];
    in property <string> clock-text: "00:00";
    in property <string> companion-status: "idle";
    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <bool> battery-charging: false;
    /// Wireless specifically — the Quick Settings tile, which is a radio.
    /// It is false on a wired machine, which is why nothing that means "am I
    /// online" may be drawn from it. See the four below.
    in property <bool> wifi-connected: false;
    /// The one network reading, from the network service: whether anything is
    /// up, over what medium, and under what name. The status bar's mark, the
    /// System screen's row and `describe` all read these rather than deriving
    /// their own — which is how a wired machine came to be shown as offline
    /// under a Wi-Fi mark, with NetworkManager's connection name beside it.
    in property <bool> network-online: false;
    in property <string> network-medium: "";
    in property <string> network-label: "Network";
    in property <string> network-detail: "";
    in property <int> pending-count: 0;
    in property <string> greeting-text: "Hello";

    // Intent Lens state
    in-out property <bool> lens-open: false;
    /// What is typed in the Lens, readable and writable from outside the window.
    ///
    /// The Lens owned this string privately, so the shell's control surface could open the ask
    /// bar and then had no way to put a question in it or to report what was in it — `open_lens
    /// text=…` would have had to answer "accepted" and hope. It is plumbed up through
    /// DesktopScreen to here so `describe` can read the field and an agent can prefill it.
    in-out property <string> lens-input-text: "";
    in property <[LensResult]> lens-results: [];
    in property <bool> lens-chat-mode: false;
    in property <[LensResult]> lens-suggestions: [];
    in property <[LensResult]> lens-recents: [];

    // Bond state
    in property <BondData> bond-data: {
        loaded: false,
        bond-score: 0.0,
        bond-level: "",
        total-interactions: 0,
        days-together: 0,
        current-streak: 0,
        humor-rate: 0.0,
        vulnerability-events: 0,
        shared-references: 0,
    };

    // Personality state
    in property <float> formality: 0.5;
    in property <float> humor-ratio: 0.0;
    in property <float> opinion-strength: 0.0;
    in property <float> question-ratio: 0.5;
    in property <[OpinionData]> opinions: [];
    in property <[SharedRefData]> shared-refs: [];

    // Memory browser state
    in property <[MemoryItem]> memory-results: [];
    in property <bool> is-searching-memories: false;

    // Voice state
    in-out property <bool> voice-active: false;
    in property <int> voice-state: 0;
    in property <string> voice-transcribed: "";
    in property <string> voice-response: "";

    // Whisper Cards (floating notifications)
    in property <[WhisperCardItem]> whisper-cards: [];
    in property <int> whisper-hint-count: 0;

    // Morning Brief card
    in property <bool> morning-brief-visible: false;
    in property <string> morning-brief-greeting: "Good morning!";
    in property <[BriefSection]> morning-brief-sections: [];
    callback morning-brief-dismissed();
    callback morning-brief-section-action(string);

    // Clipboard panel state
    in-out property <bool> clip-panel-open: false;
    in property <[ClipboardEntryData]> clip-panel-entries: [];
    in-out property <string> clip-search-query: "";
    callback clipboard-paste(int);
    callback clipboard-search(string);

    // Power menu state
    in-out property <bool> power-menu-open: false;
    callback power-action(string);

    // App grid state
    in-out property <bool> app-grid-open: false;
    // Fired when the launcher opens, so the shell can rescan the installed apps. The launcher
    // is opened from three places -- the taskbar, the dock and a keyboard shortcut -- and two
    // of them are pure Slint, so watching the property is the only hook that catches all three.
    callback app-grid-opened();
    changed app-grid-open => {
        if (self.app-grid-open) { self.app-grid-opened(); }
    }
    in property <[AppGridItem]> grid-apps: [];
    callback grid-launch-app(string);
    callback grid-toggle-pin(string);
    callback grid-search-apps(string);

    // Window switcher state
    in-out property <bool> window-switcher-open: false;
    in property <[WindowItem]> window-list: [];
    callback switch-window(string);

    // The taskbar entry's own right-click menu (#232). Rust builds the rows — which ones there
    // are depends on whether the window's app is pinned — and every row's id is the name of the
    // `shell` control action that runs it, so the menu is a second VIEW of one surface and not
    // a second path. Drawn at the end of this file, over everything, like the desktop's own
    // menu is over its screen.
    in-out property <bool> taskbar-menu-open: false;
    in-out property <[YMenuAction]> taskbar-menu-actions: [];
    in-out property <string> taskbar-menu-title: "";
    in-out property <string> taskbar-menu-app-id: "";
    in-out property <length> taskbar-menu-x: 0;
    in-out property <length> taskbar-menu-y: 0;
    // An entry was right-clicked (or the Menu key pressed on it): title, app id, and the
    // entry's corner in window coordinates.
    callback window-menu(string, string, length, length);
    // A menu row was chosen: the row's id — a control action's name — and the window it was
    // opened over.
    callback window-menu-action(string, string, string);

    // Dock items (for running indicators)
    in property <[DockItem]> dock-items: [];

    // Panel readouts — load from the observer poll, date from the clock timer
    in property <int> bar-cpu-percent: 0;
    in property <string> bar-mem-text: "";
    // ── The minimised shell screen ──
    //
    // Minimise has to leave a way back or it is a trapdoor, and these screens are not real
    // toplevels so the compositor's taskbar cannot hold them -- wlrctl only knows about real
    // windows. The shell holds this one itself and the taskbar draws it alongside the real
    // ones, which is the whole difference between "minimise" and "close".
    //
    // One slot, not a list: only one shell screen is ever on screen at a time, so a second
    // minimise can only be of the screen that replaced the first.
    property <int> minimized-screen: 0;
    property <string> minimized-title: "";
    property <string> minimized-app-id: "";

    in property <string> date-text: "";
    in property <int> bar-mem-percent: 0;
    in property <int> bar-swap-percent: 0;
    in property <string> bar-swap-text: "";
    in property <int> bar-disk-percent: 0;
    in property <string> bar-disk-text: "";
    in property <[ServiceItem]> services: [];
    // Launcher categories
    in property <[CategoryItem]> grid-categories: [];
    in-out property <string> grid-active-category: "all";
    callback grid-category-selected(string);

    // Quick Settings state
    in-out property <bool> quick-settings-open: false;
    in-out property <int> brightness-level: 80;
    in-out property <int> volume-level: 50;
    callback toggle-wifi();
    callback brightness-changed(int);
    callback volume-changed(int);

    // Command Palette state (Ctrl+Shift+P)
    in-out property <bool> command-palette-open: false;
    in property <[CommandItem]> command-palette-filtered: [];
    callback command-palette-search(string);
    callback command-palette-selected(string);
    callback open-command-palette();

    // Cross-App Workflow data transfer
    callback cross-app-action(string, string);  // (action_type, data_json)

    // Pre-fill properties for cross-app data transfer
    in-out property <string> cal-prefill-title: "";
    in-out property <string> cal-prefill-notes: "";
    in-out property <string> notes-prefill-title: "";
    in-out property <string> notes-prefill-content: "";
    in-out property <string> pres-prefill-title: "";
    in-out property <string> pres-prefill-content: "";

    // Notification toast (legacy — kept for backward compatibility)
    in property <string> notification-text: "";
    in-out property <bool> show-notification: false;

    // Toast notification banners (bottom-right, stacking upward, newest on top).
    //
    // The ids are the notifications service's, as strings. They were ints made from the wall
    // clock, so two toasts raised in the same millisecond shared an id, and nothing that was
    // dismissed could afterwards be found in any store.
    in property <[ToastData]> toast-queue: [];
    /// How many more are waiting behind the three shown.
    in property <int> toast-overflow: 0;
    callback toast-clicked(string);
    callback toast-dismissed(string);
    callback toast-action(string, string);

    // Ambient Intelligence state
    // Ambient animation budget, in milliseconds per tick, set from Rust at startup.
    // 16 = 60fps on a GPU; ~100 = 10fps on the software rasteriser, which costs roughly
    // a sixth as much and still moves; 0 turns ambient animation off entirely for a
    // headless or unattended deployment. Phase increments are multiplied by tick-scale
    // so the animation runs at the same SPEED at any of these rates, just fewer frames.
    // Agent mode swaps the desktop for the operator console (both rails + ask bar).
    // Default off: the machine is for a person until someone says otherwise.
    in property <bool> agent-mode: false;

    in property <int> ambient-interval-ms: 16;
    in property <float> particle-sentiment: 0.0;
    in property <float> particle-cognitive-load: 0.0;
    in property <float> particle-time-of-day: 0.5;

    // Project Consciousness
    in property <string> active-project: "";

    // Do Not Disturb mode
    in-out property <bool> dnd-mode: false;
    callback toggle-dnd-mode();

    // Focus mode (Workspace Morph)
    in-out property <bool> focus-mode: false;
    in property <string> focus-remaining: "";
    callback end-focus-mode();

    // Lock screen state
    in property <string> lock-error: "";
    in property <string> lock-date-text: "";
    in property <string> lock-greeting: "";
    callback try-unlock(string);
    callback lock-screen();

    // Login screen (screen 32) — graphical login after install
    in property <string> login-error: "";
    in property <string> login-hostname: "yantrik-os";
    callback login-attempt(/* username */ string, /* password */ string);

    // Settings state (screen 7)
    in-out property <string> settings-user-name: "";
    in-out property <string> settings-companion-name: "Yantrik";
    callback rename-user(string);
    callback rename-companion(string);
    in property <string> settings-model-name: "";
    in property <int> settings-max-context: 4096;
    in property <int> settings-max-tokens: 512;
    in property <string> settings-tool-permission: "sensitive";
    in property <int> settings-auto-lock-secs: 300;
    in property <string> settings-version: "";
    in property <string> settings-ip-address: "";
    in property <string> settings-display-resolution: "";
    in property <string> settings-llm-backend: "candle";
    in property <string> settings-llm-api-url: "";
    in property <string> settings-llm-api-model: "";
    in-out property <bool> settings-dark-mode: true;
    in-out property <bool> settings-incognito-mode: false;
    in-out property <string> settings-accent-color: "cyan";

    // AI Provider management
    in property <AIStatusData> settings-ai-status;
    in property <[AIProviderData]> settings-ai-providers: [];
