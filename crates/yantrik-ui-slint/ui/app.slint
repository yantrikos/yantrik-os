                if (root.minimized-screen == 27) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 27;
                root.minimized-title = Tr.title-devices;
                root.minimized-app-id = "devices";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            DeviceDashboardScreen {
                width: 100%; height: 100%;
                active-tab <=> root.dev-active-tab;
                usb-devices: root.dev-usb-devices;
                usb-selected-index <=> root.dev-usb-selected-index;
                usb-detail-text: root.dev-usb-detail-text;
                pci-devices: root.dev-pci-devices;
                pci-selected-index <=> root.dev-pci-selected-index;
                input-devices: root.dev-input-devices;
                storage-devices: root.dev-storage-devices;
                display-devices: root.dev-display-devices;
                gpu-info: root.dev-gpu-info;
                scanning: root.dev-scanning;
                selected-device-info: root.dev-selected-device-info;
                dev-search-text <=> root.dev-search-text;
                dev-export-status: root.dev-export-status;
                dev-summary: root.dev-summary;
                dev-tab(idx) => { root.dev-tab(idx); }
                dev-select-usb(idx) => { root.dev-select-usb(idx); }
                dev-select-pci(idx) => { root.dev-select-pci(idx); }
                dev-refresh() => { root.dev-refresh(); }
                dev-export() => { root.dev-export(); }
                dev-search(text) => { root.dev-search(text); }
                dev-close-detail() => { root.dev-close-detail(); }
                dev-hotplug-notification: root.dev-hotplug-notification;
                dev-hotplug-count: root.dev-hotplug-count;
                dev-hotplug-banner-visible <=> root.dev-hotplug-banner-visible;
                dev-dismiss-hotplug() => { root.dev-dismiss-hotplug(); }
                ai-is-working: root.dev-ai-is-working;
                ai-response: root.dev-ai-response;
                ai-panel-open <=> root.dev-ai-panel-open;
                ai-explain-pressed => { root.dev-ai-explain(); }
                ai-dismiss => { root.dev-ai-dismiss(); }
            }
        }

        // Permission Dashboard
        if current-screen == 28 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.lock;
            icon-color: Theme.color-emotional;
            title: Tr.title-permissions;
            close => {
                if (root.minimized-screen == 28) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 28;
                root.minimized-title = Tr.title-permissions;
                root.minimized-app-id = "permissions";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            PermissionDashboardScreen {
                width: 100%; height: 100%;
                active-tab <=> root.perm-active-tab;
                perm-users: root.perm-users;
                perm-groups: root.perm-groups;
                perm-selected-user: root.perm-selected-user;
                perm-suid-files: root.perm-suid-files;
                perm-world-writable: root.perm-world-writable;
                perm-scanning: root.perm-scanning;
                perm-high-risk-count: root.perm-high-risk-count;
                perm-medium-risk-count: root.perm-medium-risk-count;
                perm-low-risk-count: root.perm-low-risk-count;
                perm-scan-path <=> root.perm-scan-path;
                perm-scan-status: root.perm-scan-status;
                perm-search-text <=> root.perm-search-text;
                perm-selected-file: root.perm-selected-file;
                perm-has-selected-file: root.perm-has-selected-file;
                perm-export-status: root.perm-export-status;
                perm-tab(idx) => { root.perm-tab(idx); }
                perm-refresh() => { root.perm-refresh(); }
                perm-fix(path) => { root.perm-fix(path); }
                perm-select-user(idx) => { root.perm-select-user(idx); }
                perm-select-file(tab, idx) => { root.perm-select-file(tab, idx); }
                perm-scan-dir(path) => { root.perm-scan-dir(path); }
                perm-export-report() => { root.perm-export-report(); }
                perm-search(query) => { root.perm-search(query); }
                perm-fix-permission(path) => { root.perm-fix-permission(path); }
                perm-acl-output: root.perm-acl-output;
                perm-acl-panel-open <=> root.perm-acl-panel-open;
                perm-acl-target-path <=> root.perm-acl-target-path;
                perm-view-acl(path) => { root.perm-view-acl(path); }
                perm-set-acl(path, spec) => { root.perm-set-acl(path, spec); }
                ai-is-working: root.perm-ai-is-working;
                ai-response: root.perm-ai-response;
                ai-panel-open <=> root.perm-ai-panel-open;
                ai-explain-pressed => { root.perm-ai-explain(); }
                ai-dismiss => { root.perm-ai-dismiss(); }
            }
        }

        // Report a problem
        if current-screen == 33 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.lock;
            icon-color: Theme.color-emotional;
            title: Tr.title-problems;
            close => {
                if (root.minimized-screen == 33) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 33;
                root.minimized-title = Tr.title-problems;
                root.minimized-app-id = "problems";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            ProblemReportScreen {
                width: 100%; height: 100%;
                rows: root.problem-rows;
                selected: root.problem-selected;
                json: root.problem-json;
                note <=> root.problem-note;
                status: root.problem-status;
                sending: root.problem-sending;
                select(i) => { root.problem-select(i); }
                send => { root.problem-send(); }
                delete-record => { root.problem-delete(); }
                refresh => { root.problem-refresh(); }
            }
        }

        // Agents — one pane per agent, with its work inside it. Everything on it reads the
        // AgentsState global; see agents.slint and crates/yantrik-ui/src/wire/agents.rs.
        if current-screen == 34 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.people;
            icon-color: Theme.accent;
            title: Tr.title-agents;
            close => {
                if (root.minimized-screen == 34) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 34;
                root.minimized-title = Tr.title-agents;
                root.minimized-app-id = "agents";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            AgentsScreen {
                width: 100%; height: 100%;
            }
        }

        // Recipes — every recipe the companion holds, drawn as its stages. Everything on it reads
        // the RecipesState global; see recipes.slint and crates/yantrik-ui/src/wire/recipes.rs.
        if current-screen == 35 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.list;
            icon-color: Theme.accent;
            title: Tr.title-recipes;
            close => {
                if (root.minimized-screen == 35) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 35;
                root.minimized-title = Tr.title-recipes;
                root.minimized-app-id = "recipes";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            RecipesScreen {
                width: 100%; height: 100%;
            }
        }

        // Spreadsheet
        // ── Document Editor (screen 30) ──
        // Presentation (screen 31)
        // ── The taskbar, on every screen that should have one ──
        //
        // This was `>= 4 && <= 31`: app screens only, never the desktop, because the desktop
        // carried a taskbar of its own. Two bars, two conditions, and the seam between them was
        // exactly where the old Mac dock appeared.
        //
        // One bar now, drawn here for the desktop AND the app screens. Boot (0), onboarding (2),
        // lock (3) and login (32) are deliberately excluded: they are states where there is
        // nothing to switch to and nothing should invite you to try.
        // ── The one bar at the top of this OS ──
        //
        // Above every screen, because the time, the load, the battery and which mind is
        // answering are facts about the machine rather than about the desktop. Declared after
        // the screens so it draws over them, and every screen below leaves 32px for it.
        //
        // Boot, onboarding, lock and login deliberately do not: those are states where the
        // machine is not yet yours to read.
        if current-screen != 0 && current-screen != 2 && current-screen != 3 && current-screen != 32 : StatusBar {
            x: 0;
            y: 0;
            width: 100%;
            clock-text: root.clock-text;
            notification-unread: root.notification-unread-count;
            notifications-clicked => { root.current-screen = 9; root.navigate(9); }
            companion-status: root.companion-status;
            companion-online: root.companion-online;
            assistant-offline-notice: root.assistant-offline-notice;
            battery-available: root.battery-available;
            battery-level: root.battery-level;
            battery-charging: root.battery-charging;
            network-online: root.network-online;
            network-medium: root.network-medium;
            pending-count: root.pending-count;
            whisper-hint-count: root.whisper-hint-count;
            incognito-enabled: root.settings-incognito-mode;
            dnd-enabled: root.dnd-mode;
            active-project: root.active-project;
            ai-privacy-mode: root.ai-privacy-mode;
            ai-provider-label: root.ai-active-provider-label;
            ai-fallback-banner: root.ai-fallback-banner;
            cpu-percent: root.bar-cpu-percent;
            mem-text: root.bar-mem-text;
            date-text: root.date-text;
            active-harness-id: root.active-harness-id;
            active-harness-name: root.active-harness-name;
            harness-driving: root.harness-driving;
            mind-mode: root.mind-mode;
            mind-mode-label: root.mind-mode-label;
            // Closing it also drops the two sub-panels, so it never reopens mid-confirmation on
            // a question the person walked away from.
            mind-mode-clicked => {
                root.mind-menu-open = !root.mind-menu-open;
                root.mind-menu-confirming = false;
                root.mind-menu-audit-open = false;
            }
            anchor-clicked => { root.lens-open = !root.lens-open; root.open-lens(); }
            queue-clicked => { root.lens-open = true; root.open-lens(); }
            whisper-hint-clicked => { root.whisper-hint-clicked(); }
            settings-tapped => { root.quick-settings-open = !root.quick-settings-open; }
            power-pressed => { root.power-menu-open = !root.power-menu-open; }
            // Handled here, the same way the desktop's own instance handles them. They are not
            // callbacks on this component -- `ai-privacy-clicked` and `active-mind-clicked` are
            // declared on DesktopScreen, and forwarding to a root callback of the same name was
            // inventing two that do not exist.
            ai-privacy-clicked => { root.ai-quick-switcher-open = !root.ai-quick-switcher-open; }
            // Straight to the section, not to the front door of Settings.
            active-mind-clicked => {
                root.settings-category = 8;
                root.current-screen = 7;
                root.navigate(7);
            }
            // The "no model" notice goes to the AI section, where a model is set up (#30).
            assistant-offline-clicked => {
                root.settings-category = 1;
                root.current-screen = 7;
                root.navigate(7);
            }
        }

        if current-screen == 1 || (current-screen >= 4 && current-screen <= 31) || current-screen == 33 || current-screen == 34 || current-screen == 35 : Rectangle {
            width: 100%;
            height: parent.height;
            y: 0;
            background: transparent;

            // ── The one bar at the bottom of this OS ──
            //
            // What stood here was a Mac-style auto-hide dock: an invisible six-pixel strip at the
            // bottom edge that slid up a row of square tiles bearing LETTERS — ">_", "W", "F",
            // "@", "N" — from a hardcoded list that had drifted out of step with the real pinned
            // apps. It was the old design, and it was at the APP level, so it appeared on every
            // screen. The real Taskbar lived inside DesktopScreen, so it appeared on exactly one.
            //
            // The result is what you saw: on the desktop, the designed taskbar; the moment you
            // opened anything, that taskbar went away with the desktop and brushing the bottom of
            // the screen produced a different dock, in a different visual language, listing
            // different apps.
            //
            // One Taskbar, here, above every screen. Same component, same icons, same window
            // entries, always in the same place — which is the whole of what "consistent" means
            // for the one strip a person's eye returns to all day.
            Taskbar {
                y: parent.height - self.height;
                width: 100%;
                windows: root.window-list;
                minimized-screen: root.minimized-screen;
                minimized-title: root.minimized-title;
                minimized-app-id: root.minimized-app-id;
                restore-screen => {
                    root.current-screen = root.minimized-screen;
                    root.navigate(root.minimized-screen);
                    root.minimized-screen = 0;
                }
                launcher-label: Tr.dock-apps;
                companion-count: root.whisper-hint-count;
                companion-online: root.companion-online;
                companion-status: root.companion-status;
                // The launcher is drawn on the desktop screen and nowhere else, so from Files,
                // Recipes or any other screen this button flipped a property nothing drew (#219).
                // Opening it goes to the desktop first, as open_lens does, and puts the Lens
                // away, which would cover a third of it. The shell's handler for the grid opening
                // brings the window forward over whatever app is in front.
                open-launcher => {
                    if (!root.app-grid-open) {
                        if (root.current-screen != 1) {
                            root.current-screen = 1;
                            root.navigate(1);
                        }
                        root.lens-open = false;
                    }
                    root.app-grid-open = !root.app-grid-open;
                }
                activate-window(title) => { root.switch-window(title); }
                // The entry's right-click menu (#232). Straight to Rust, which knows whether
                // the window's app is pinned and answers with the rows; the menu itself is
                // drawn at the end of this file, over everything.
                window-menu(title, app-id, x, y) => { root.window-menu(title, app-id, x, y); }
                // The chat, from anywhere. The Lens is drawn on the desktop screen, so from any
                // other screen this used to open nothing a person could see; it goes to the
                // desktop first, as Apps does (#219, #241). The shell's handler for the Lens
                // opening brings the window forward over whatever app is in front.
                chat-with: root.active-harness-name;
                open-companion => {
                    if (!root.lens-open) {
                        if (root.current-screen != 1) {
                            root.current-screen = 1;
                            root.navigate(1);
                        }
                        root.app-grid-open = false;
                    }
                    root.lens-open = !root.lens-open;
                    root.open-lens();
                }
                show-desktop => { root.show-desktop(); }
            }

            // The glow hint that used to sit here belonged to the auto-hide dock: a thin line
            // teasing that something was down there. Nothing is hidden any more, so there is
            // nothing to hint at.
        }

        // ── The mind panel, at the right edge of every screen the taskbar is on ──
        //
        // Declared here, with the status bar and the taskbar, and not in desktop.slint: furniture
        // declared inside one screen exists on that screen only while its room is reserved on all
        // of them (the taskbar and the status bar both had that bug). After the screens, so it
        // draws over them; before the overlays below, so a card, a toast or the mode menu draws
        // over it. Between the two bars: the compositor's own margins (config/labwc/rc.xml, top 32
        // and bottom 40) are the bars', and this stays inside them.
        if root.mind-panel-shown : MindPanel {
            width: root.mind-panel-open ? 334px : 44px;
            x: parent.width - self.width;
            y: Theme.status-bar-height;
            height: parent.height - Theme.status-bar-height - Theme.taskbar-height;
            visible: !root.mind-panel-covered;
            open: root.mind-panel-open;
            agent-mode: root.agent-mode;
            ambient-interval-ms: root.ambient-interval-ms;
            // The chip's own data, not a copy of it: the panel and the status bar cannot disagree.
            mode: root.mind-mode;
            mode-label: root.mind-mode-label;
            ceiling: root.mind-ceiling;
            cpu-percent: root.bar-cpu-percent;
            mem-percent: root.bar-mem-percent;
            mem-text: root.bar-mem-text;
            swap-percent: root.bar-swap-percent;
            swap-text: root.bar-swap-text;
            disk-percent: root.bar-disk-percent;
            disk-text: root.bar-disk-text;
            toggle(open) => {
                MindPanelState.set-expanded(root.current-screen == 1 ? "desktop" : "elsewhere", open);
            }
            // Into the Agents screen with that agent selected, on the Active tab it is listed in.
            open-agent(id) => {
                root.current-screen = 34;
                root.navigate(34);
                AgentsState.select-tab("active");
                AgentsState.select(id);
            }
            open-agents => {
                root.current-screen = 34;
                root.navigate(34);
            }
            // A recipe row opens the Recipes screen with that recipe opened below its row.
            recipes-screen: 35;
            open-recipe(id) => {
                root.current-screen = 35;
                root.navigate(35);
                RecipesState.show(id);
            }
            // Straight to Settings > Harnesses, as the status bar's mind chip does.
            open-mind => {
                root.settings-category = 8;
                root.current-screen = 7;
                root.navigate(7);
            }
            open-mode => {
                root.mind-menu-open = !root.mind-menu-open;
                root.mind-menu-confirming = false;
                root.mind-menu-audit-open = false;
            }
            // The full list the rows are the head of: the mode menu's audit.
            open-audit => {
                root.mind-menu-open = true;
                root.mind-menu-confirming = false;
                root.mind-menu-audit-open = true;
            }
        }

        // Voice overlay
        if voice-active : VoiceOverlay {
            width: 100%; height: 100%;
            voice-state: root.voice-state;
            transcribed-text: root.voice-transcribed;
            response-text: root.voice-response;
            cancel-pressed => {
                root.voice-active = false;
                root.cancel-voice();
            }
        }

        // ── Which mind is answering, from the status bar ──
        //
        // `ai-quick-switcher-open` and `ai-quick-switch-provider` have existed here for a while
        // with nothing drawing them and nothing handling them: clicking the AI badge toggled a
        // boolean and the desktop did not move. This is the panel that toggle was always meant to
        // open, and switching minds is the thing it should have been switching.
        //
        // The fast path, deliberately: Settings > Harnesses is where you read about a mind, and
        // this is where you change to one without leaving what you were doing.
        if root.ai-quick-switcher-open : Rectangle {
            width: 100%;
            height: 100%;

            // Anywhere outside closes it. A popover you have to aim at to dismiss is a popover
            // that gets in the way.
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => { root.ai-quick-switcher-open = false; }
            }

            Rectangle {
                // Hangs under the status bar at the right, where the badge that opened it is.
                x: parent.width - self.width - 12px;
                y: Theme.status-bar-height + 6px;
                width: 260px;
                height: switcher-body.preferred-height;
                background: Theme.bg-elevated;
                border-radius: Theme.r-lg;
                border-width: 1px;
                border-color: Theme.border-strong;
                drop-shadow-blur: 24px;
                drop-shadow-color: Theme.overlay-backdrop;

                // Clicks inside must not reach the backdrop above.
                TouchArea { width: 100%; height: 100%; }

                switcher-body := VerticalLayout {
                    padding: Theme.sp-2;
                    spacing: 2px;

                    Text {
                        text: "ANSWERING";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: 600;
                        letter-spacing: 2px;
                        height: 22px;
                        vertical-alignment: center;
                        horizontal-alignment: left;
                    }

                    for m in root.harnesses : Rectangle {
                        height: 40px;
                        border-radius: Theme.r-sm;
                        background: row-ta.has-hover ? Theme.hover-fill
                                  : m.active ? Theme.tint-accent : transparent;

                        row-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.use-harness(m.id);
                                root.ai-quick-switcher-open = false;
                            }
                        }

                        HorizontalLayout {
                            padding-left: Theme.sp-2;
                            padding-right: Theme.sp-2;
                            spacing: Theme.sp-2;

                            // A filled dot for the one answering, an empty ring for the rest:
                            // the state is a shape before it is a colour, so it survives a
                            // greyscale screen and a person who cannot separate teal from grey.
                            Rectangle {
                                width: 8px;
                                height: 8px;
                                y: (parent.height - 8px) / 2;
                                border-radius: 4px;
                                background: m.active ? Theme.accent : transparent;
                                border-width: m.active ? 0px : 1px;
                                border-color: Theme.text-dim;
                            }

                            VerticalLayout {
                                alignment: center;
                                spacing: 0px;
                                Text {
                                    text: m.name;
                                    color: m.active ? Theme.accent : Theme.text-primary;
                                    font-size: Theme.fs-caption;
                                    font-weight: m.active ? 600 : 400;
                                }
                                if m.detail != "" : Text {
                                    text: m.detail;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                }
                            }
                            Rectangle { horizontal-stretch: 1; }
                        }
                    }

                    Rectangle {
                        height: 1px;
                        background: Theme.separator;
                    }

                    // The way out to the full surface, so this panel never has to grow into it.
                    Rectangle {
                        height: 32px;
                        border-radius: Theme.r-sm;
                        background: manage-ta.has-hover ? Theme.hover-fill : transparent;
                        manage-ta := TouchArea {
                            mouse-cursor: pointer;
                            clicked => {
                                root.ai-quick-switcher-open = false;
                                root.settings-category = 8;
                                root.current-screen = 7;
                                root.navigate(7);
                            }
                        }
                        HorizontalLayout {
                            padding-left: Theme.sp-2;
                            padding-right: Theme.sp-2;
                            Text {
                                text: "Manage harnesses…";
                                color: Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                            }
                        }
                    }
                }
            }
        }

        // Toast notification banners (top-right, stacking)
        if toast-queue.length > 0 : ToastBanner {
            width: 100%; height: 100%;
            toasts: root.toast-queue;
            overflow: root.toast-overflow;
            // Above the taskbar — on every screen. This used to inset only on the desktop, on
            // the belief that no other screen drew a taskbar; there is one Taskbar, drawn above
            // every screen (see below), so on Notifications, Settings and the rest the toasts
            // sat on top of it and covered the window entries a person was about to click.
            //
            // And above the conversation's text box while the conversation is open. The toasts
            // and the panel share the bottom right corner, and a critical toast does not time
            // out — so one "a mind is asking" notice sat on top of the box a person types their
            // next sentence into, for as long as it stayed up.
            bottom-inset: Theme.taskbar-height
                + (root.current-screen == 1 && root.lens-open && root.lens-chat-mode ? 76px : 0px);
            toast-clicked(id) => { root.toast-clicked(id); }
            toast-dismissed(id) => { root.toast-dismissed(id); }
            toast-action(id, action) => { root.toast-action(id, action); }
        }

        // Approval cards, over whatever screen is up.
        //
        // The Lens shows these in its conversation, which is the right home for them — but the
        // Lens lives on the desktop screen and is closed most of the time, and a request that
        // nobody is shown expires unanswered after two minutes. From the person's side that is
        // indistinguishable from the machine ignoring them, which is the bug this whole feature
        // exists to fix. So the same cards are drawn here, above every screen, and the Lens's
        // copy is suppressed when this one is up so the same question is never asked twice.
        //
        // Not on the lock, login, boot or onboarding screens. A card that can be allowed from a
        // locked screen is a way to act on a machine without unlocking it; the request stays
        // pending underneath and expires if nobody comes back, which is the honest outcome.
        if root.pending-approvals.length > 0
            && !(root.lens-open && root.lens-chat-mode && root.current-screen == 1)
            && root.current-screen != 0 && root.current-screen != 2
            && root.current-screen != 3 && root.current-screen != 32
            : Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            // The top edge is the anchor and the card grows downward from it.
            //
            // It did not, the first time. `ApprovalCard` reported a preferred height of zero
            // (see the note at the top of that component), so this box was sized to nothing and
            // the card spilled out of it — upward, off the top of the screen, taking the header
            // and the action name with it. The person was left looking at three arguments and
            // two buttons with no way to tell what they were allowing.
            //
            // With that fixed this box gets the card's true height, the card is a known number of
            // lines (every text on it is bounded in approvals.rs), and only ONE card is ever here
            // — three of them would be 780px on an 800px screen and the third one's buttons would
            // sit under the taskbar. `min-height` is deliberately not set beside `height`: Slint
            // refuses both on one element, and `height` is the one that has to be the layout's.
            Rectangle {
                x: parent.width - 420px;
                y: Theme.status-bar-height + Theme.sp-4;
                width: 404px;
                height: approval-stack.preferred-height;
                background: transparent;

                approval-stack := VerticalLayout {
                    spacing: Theme.sp-1;
                    alignment: start;

                    for item in root.pending-approvals : ApprovalCard {
                        data: item;
                        // The room this corner actually has: from the card's top edge (one sp-4
                        // under the status bar) down to one sp-4 above the taskbar. A card that
                        // grew past it would run its buttons under the taskbar, which is the
                        // same failure the Lens had in #218 — the details scroll instead.
                        height-limit: root.height - Theme.status-bar-height - Theme.taskbar-height
                            - 2 * Theme.sp-4;
                        allow => { root.approval-allow(item.id); }
                        allow-session => { root.approval-allow-session(item.id); }
                        deny => { root.approval-deny(item.id); }
                    }

                    if root.approvals-waiting > 0 : Text {
                        text: root.approvals-waiting + " more waiting — this one first";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
            }
        }

        // The vault unlock prompt, in the same corner and under the same rules as the card above.
        //
        // Excluded from lock (3), login (32), boot (0) and onboarding (2) for a reason that is
        // sharper here than it is for an approval: a passphrase box that can be typed into from a
        // *locked* screen would be a way to open the vault without unlocking the machine, which
        // is precisely the boundary locking the screen exists to draw. `on_screen_lock` has just
        // zeroed the key; drawing this over the lock screen would hand it back.
        //
        // Drawn above the approval card's corner, not beside it: they can both be up at once —
        // a mind asks to read a credential, the shell asks for the passphrase — and the approval
        // is the one with a timer on it, so it keeps the position the person is used to.
        if root.vault-unlock.reason != ""
            && root.current-screen != 0 && root.current-screen != 2
            && root.current-screen != 3 && root.current-screen != 32
            : Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            Rectangle {
                x: parent.width - 420px;
                // Below the approval stack when there is one, so neither covers the other. The
                // 300px is the approval card's bounded worst case — every text on it is clipped
                // in approvals.rs, so it has one.
                y: Theme.status-bar-height + Theme.sp-4
                    + (root.pending-approvals.length > 0 ? 300px : 0px);
                width: 404px;
                // Same lesson as the approval overlay: take the height from the layout inside,
                // never from the card, or the box is sized to nothing and the card draws off it.
                height: vault-stack.preferred-height;
                background: transparent;

                vault-stack := VerticalLayout {
                    alignment: start;

                    VaultUnlockCard {
                        data: root.vault-unlock;
                        submit(pass) => { root.vault-unlock-submit(pass); }
                        dismiss => { root.vault-unlock-dismiss(); }
                    }
                }
            }
        }

        // The mode menu, under the chip that opens it.
        //
        // Same exclusions as the approval card: not on boot, onboarding, lock or login. A mode
        // that could be loosened from a locked screen is a way to act on a machine without
        // unlocking it, which is the same hole the card's exclusion closes.
        //
        // Anchored 12px in from the right edge rather than centred under the chip, because the
        // chip's own x depends on what else is in the bar (battery, CPU, the mind chip) and a
        // menu that moved about would be untestable and hard to aim at. On 1280×800 that puts
        // it at x = 928…1268, y = 36 — the numbers the design doc's verification steps use.
        if root.mind-menu-open
            && root.current-screen != 0 && root.current-screen != 2
            && root.current-screen != 3 && root.current-screen != 32
            : Rectangle {
            width: 100%;
            height: 100%;
            background: transparent;

            // Click anywhere else to put it away. Behind the panel, so it never swallows a
            // press meant for a mode row.
            TouchArea {
                width: 100%;
                height: 100%;
                clicked => {
                    root.mind-menu-open = false;
                    root.mind-menu-confirming = false;
                    root.mind-menu-audit-open = false;
                }
            }

            MindModeMenu {
                x: parent.width - 352px;
                y: Theme.status-bar-height + Theme.sp-1;
                mode: root.mind-mode;
                mode-label: root.mind-mode-label;
                ceiling: root.mind-ceiling;
                rules: root.mind-session-rules;
                audit: root.mind-audit;
                confirming-bypass <=> root.mind-menu-confirming;
                showing-audit <=> root.mind-menu-audit-open;
                mode-chosen(m) => { root.mind-mode-chosen(m); root.mind-menu-open = false; }
                bypass-chosen(d) => { root.mind-bypass-chosen(d); root.mind-menu-open = false; }
                rule-revoked(app, action) => { root.mind-rule-revoked(app, action); }
                mind-view-on: root.mind-view-on;
                mind-view-chosen(on) => { root.mind-view-chosen(on); }
            }
        }

        // The taskbar entry's own menu (#232). Last in the file so it draws over everything,
        // the way the desktop's instance is last in its file — a menu that opened under the bar
        // it was summoned from would be worse than no menu. Clamped inside the screen like that
        // one, and the clamp is doing real work here: the taskbar sits at the bottom edge, so
        // `height - 200px` is what puts the panel ABOVE the bar instead of off the display.
        if root.taskbar-menu-open : YContextMenu {
            open: true;
            actions: root.taskbar-menu-actions;
            menu-x: min(root.taskbar-menu-x, root.width - 232px);
            menu-y: min(root.taskbar-menu-y, root.height - 200px);
            action-clicked(id) => {
                root.window-menu-action(id, root.taskbar-menu-title, root.taskbar-menu-app-id);
            }
            close-menu => { root.taskbar-menu-open = false; }
        }

            // Debug: navigate to screen from Rust
            // Set debug-target-screen from Rust, then call debug-navigate()
            // to switch to that screen (useful for automated screenshots).
        }   // global-keys — every screen above is inside it, which is what puts it on the
            // parent chain of whatever has focus. See its comment at the top of this block.
    }

    /// Take the keyboard back when the Lens closes.
    ///
    /// The Lens puts the cursor in its own field when it opens, and that field is inside a panel
    /// whose `visible` follows `lens-open`. Slint drops the focus item the moment it becomes
    /// invisible and focuses nothing in its place — so without this, closing the Lens once left
    /// the window with no focus at all, and the next Ctrl+K had no chain to be delivered along.
    /// A `changed` handler rather than a line in each close path, because the Lens is closed from
    /// five places, one of which is Rust setting the property directly.
    changed lens-open => {
        if (!root.lens-open) { global-keys.focus(); }
    }

    /// Give the shell's shortcut scope the keyboard, so there is a focus chain to deliver to.
    ///
    /// Called from `main` once the window exists. Without it the first key press after startup
    /// is dropped before any handler is consulted, because Slint has nothing focused to deliver
    /// to and therefore nothing to walk up from.
    public function focus-global-keys() {
        global-keys.focus();
    }
}
