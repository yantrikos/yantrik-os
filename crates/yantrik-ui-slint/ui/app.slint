                line-ending: root.editor-line-ending;
                file-type: root.editor-file-type;
                line-numbers-text: root.editor-line-numbers-text;
                // Go-to-line
                show-goto-line <=> root.editor-show-goto-line;
                goto-line-input <=> root.editor-goto-line-input;
                goto-line(ln) => { root.editor-goto-line(ln); }
                // Autosave
                autosave-enabled: root.editor-autosave-enabled;
                last-saved-time: root.editor-last-saved-time;
                // Save As
                show-save-dialog <=> root.editor-show-save-dialog;
                save-dir <=> root.editor-save-dir;
                save-filename <=> root.editor-save-filename;
                save-error: root.editor-save-error;
                save-file => { root.editor-save(); }
                save-file-as(dir, name) => { root.editor-save-as(dir, name); }
                content-changed(text) => { root.editor-content-changed(text); }
                // AI
                show-ai-panel <=> root.editor-show-ai-panel;
                ai-prompt <=> root.editor-ai-prompt;
                ai-response: root.editor-ai-response;
                ai-is-working: root.editor-ai-is-working;
                ai-request(prompt) => { root.editor-ai-request(prompt); }
                ai-insert => { root.editor-ai-insert(); }
                ai-dismiss => { root.editor-ai-dismiss(); }
                // Find & Replace
                show-find-bar <=> root.editor-show-find-bar;
                find-query <=> root.editor-find-query;
                replace-text <=> root.editor-replace-text;
                find-match-count: root.editor-find-match-count;
                find-current-match: root.editor-find-current-match;
                show-replace-row <=> root.editor-show-replace-row;
                find-next => { root.editor-find-next(); }
                find-prev => { root.editor-find-prev(); }
                replace-current => { root.editor-replace-current(); }
                replace-all => { root.editor-replace-all(); }
                find-query-changed(q) => { root.editor-find-query-changed(q); }
                // Large file & encoding/line-ending
                editor-large-file-warning: root.editor-large-file-warning;
                editor-file-size-text: root.editor-file-size-text;
                editor-minimap-visible <=> root.editor-minimap-visible;
                editor-set-encoding(enc) => { root.editor-set-encoding(enc); }
                editor-set-line-ending(le) => { root.editor-set-line-ending(le); }
                editor-toggle-minimap => { root.editor-toggle-minimap(); }
            }
        }

        // Media Player
        if current-screen == 13 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? 0px : root.window-y;
            width: root.window-maximized ? parent.width : root.window-w;
            height: root.window-maximized ? parent.height - 60px : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.music;
            icon-color: Theme.amber-dim;
            title: Tr.title-now-playing;
            close => { root.current-screen = 8; root.navigate(8); }
            minimize => { root.current-screen = 1; root.navigate(1); }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            MediaPlayer {
                width: 100%; height: 100%;
                track-name: root.player-track-name;
                track-path: root.player-track-path;
                is-playing: root.player-is-playing;
                progress: root.player-progress;
                time-current: root.player-time-current;
                time-total: root.player-time-total;
                volume: root.player-volume;
                is-muted: root.player-is-muted;
                speed-text: root.player-speed-text;
                speed-index: root.player-speed-index;
                repeat-mode: root.player-repeat-mode;
                shuffle-on: root.player-shuffle-on;
                track-artist: root.player-track-artist;
                track-album: root.player-track-album;
                track-format: root.player-track-format;
                is-video: root.player-is-video;
                queue-count: root.player-queue-count;
                queue-position: root.player-queue-position;
                ai-is-working: root.player-ai-is-working;
                ai-response: root.player-ai-response;
                ai-panel-open: root.player-ai-panel-open;
                play-pause => { root.player-play-pause(); }
                stop => { root.player-stop(); }
                seek(pos) => { root.player-seek(pos); }
                set-volume(v) => { root.player-set-volume(v); }
                toggle-mute => { root.player-toggle-mute(); }
                set-speed(idx) => { root.player-set-speed(idx); }
                next-track => { root.player-next-track(); }
                prev-track => { root.player-prev-track(); }
                toggle-repeat => { root.player-toggle-repeat(); }
                toggle-shuffle => { root.player-toggle-shuffle(); }
                player-subtitle-tracks: root.player-subtitle-tracks;
                player-subtitle-active: root.player-subtitle-active;
                player-show-subtitle-menu <=> root.player-show-subtitle-menu;
                player-select-subtitle(idx) => { root.player-select-subtitle(idx); }
                player-ab-repeat-active <=> root.player-ab-repeat-active;
                player-ab-start: root.player-ab-start;
                player-ab-end: root.player-ab-end;
                player-set-ab-start => { root.player-set-ab-start(); }
                player-set-ab-end => { root.player-set-ab-end(); }
                player-toggle-ab-repeat => { root.player-toggle-ab-repeat(); }
                ai-explain-pressed => { root.player-ai-explain(); }
                ai-dismiss => { root.player-ai-dismiss(); }
            }
        }

        // Terminal
        // Notes Editor screen
        if current-screen == 16 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? 0px : root.window-y;
            width: root.window-maximized ? parent.width : root.window-w;
            height: root.window-maximized ? parent.height - 60px : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.doc;
            icon-color: Theme.cyan;
            title: Tr.title-about;
            close => { root.current-screen = 7; root.navigate(7); }
            minimize => { root.current-screen = 1; root.navigate(1); }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            AboutScreen {
                width: 100%; height: 100%;
                hostname: root.about-hostname;
                kernel: root.about-kernel;
                cpu-model: root.about-cpu;
                ram-total: root.about-ram;
                disk-info: root.about-disk;
                uptime-text: root.about-uptime;
                version-text: root.about-version;
                build-date: root.about-build-date;
                components: root.about-components;
                update-count: root.about-update-count;
                update-status: root.about-update-status;
                ai-model-name: root.settings-llm-api-model;
                ai-provider-status: root.companion-online ? "Connected" : "Disconnected";
                check-updates => { root.about-check-updates(); }
                open-ai-settings => {
                    root.current-screen = 7;
                    root.navigate(7);
                }
                back-pressed => {
                    root.current-screen = 7;
                    root.navigate(7);
                }
            }
        }

        // Email Client
        // Calendar
        // Package Manager
        if current-screen == 21 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? 0px : root.window-y;
            width: root.window-maximized ? parent.width : root.window-w;
            height: root.window-maximized ? parent.height - 60px : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.packages;
            icon-color: Theme.cyan;
            title: Tr.title-packages;
            close => { root.current-screen = 1; root.navigate(1); }
            minimize => { root.current-screen = 1; root.navigate(1); }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            PackageManager {
                width: 100%; height: 100%;
                packages: root.pkg-packages;
                is-loading: root.pkg-is-loading;
                status-text: root.pkg-status-text;
                upgradable-count: root.pkg-upgradable-count;
                pending-actions: root.pkg-pending-actions;
                is-applying: root.pkg-is-applying;
                apply-progress: root.pkg-apply-progress;
                error-text: root.pkg-error-text;
                detail-name: root.pkg-detail-name;
                detail-version: root.pkg-detail-version;
                detail-description: root.pkg-detail-description;
                detail-maintainer: root.pkg-detail-maintainer;
                detail-dependencies: root.pkg-detail-dependencies;
                detail-size: root.pkg-detail-size;
                detail-repo: root.pkg-detail-repo;
                detail-installed: root.pkg-detail-installed;
                detail-upgradable: root.pkg-detail-upgradable;
                search-query <=> root.pkg-search-query;
                selected-index <=> root.pkg-selected-index;
                active-filter <=> root.pkg-active-filter;
                search(query) => { root.pkg-search(query); }
                refresh => { root.pkg-refresh(); }
                select-package(idx) => { root.pkg-select-package(idx); }
                install-package(name) => { root.pkg-install-package(name); }
                remove-package(name) => { root.pkg-remove-package(name); }
                upgrade-package(name) => { root.pkg-upgrade-package(name); }
                upgrade-all => { root.pkg-upgrade-all(); }
                apply-changes => { root.pkg-apply-changes(); }
                cancel-changes => { root.pkg-cancel-changes(); }
                filter-changed(idx) => { root.pkg-filter-changed(idx); }
                ai-is-working: root.pkg-ai-is-working;
                ai-response: root.pkg-ai-response;
                ai-panel-open <=> root.pkg-ai-panel-open;
                ai-explain-pressed => { root.pkg-ai-explain(); }
                ai-intent(query) => { root.pkg-ai-intent(query); }
                ai-dismiss => { root.pkg-ai-dismiss(); }
            }
        }

        // Network Manager
        // Weather Dashboard
        // Music Player
        // System Monitor
        // Download Manager
        // Code Snippet Manager
        // Container Manager
        // Device Dashboard
        if current-screen == 27 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? 0px : root.window-y;
            width: root.window-maximized ? parent.width : root.window-w;
            height: root.window-maximized ? parent.height - 60px : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.hybrid;
            icon-color: Theme.cyan;
            title: Tr.title-devices;
            close => { root.current-screen = 1; root.navigate(1); }
            minimize => { root.current-screen = 1; root.navigate(1); }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            DeviceDashboardScreen {
                width: 100%; height: 100%;
                active-tab <=> root.dev-active-tab;
                usb-devices: root.dev-usb-devices;
                usb-selected-index <=> root.dev-usb-selected-index;
                usb-detail-text: root.dev-usb-detail-text;
                pci-devices: root.dev-pci-devices;
                pci-selected-index <=> root.dev-pci-selected-index;
                input-devices: root.dev-input-devices;
                storage-devices: root.dev-storage-devices;
                display-devices: root.dev-display-devices;
                gpu-info: root.dev-gpu-info;
                scanning: root.dev-scanning;
                selected-device-info: root.dev-selected-device-info;
                dev-search-text <=> root.dev-search-text;
                dev-export-status: root.dev-export-status;
                dev-summary: root.dev-summary;
                dev-tab(idx) => { root.dev-tab(idx); }
                dev-select-usb(idx) => { root.dev-select-usb(idx); }
                dev-select-pci(idx) => { root.dev-select-pci(idx); }
                dev-refresh() => { root.dev-refresh(); }
                dev-export() => { root.dev-export(); }
                dev-search(text) => { root.dev-search(text); }
                dev-close-detail() => { root.dev-close-detail(); }
                dev-hotplug-notification: root.dev-hotplug-notification;
                dev-hotplug-count: root.dev-hotplug-count;
                dev-hotplug-banner-visible <=> root.dev-hotplug-banner-visible;
                dev-dismiss-hotplug() => { root.dev-dismiss-hotplug(); }
                ai-is-working: root.dev-ai-is-working;
                ai-response: root.dev-ai-response;
                ai-panel-open <=> root.dev-ai-panel-open;
                ai-explain-pressed => { root.dev-ai-explain(); }
                ai-dismiss => { root.dev-ai-dismiss(); }
            }
        }

        // Permission Dashboard
        if current-screen == 28 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? 0px : root.window-y;
            width: root.window-maximized ? parent.width : root.window-w;
            height: root.window-maximized ? parent.height - 60px : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.lock;
            icon-color: Theme.color-emotional;
            title: Tr.title-permissions;
            close => { root.current-screen = 1; root.navigate(1); }
            minimize => { root.current-screen = 1; root.navigate(1); }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            PermissionDashboardScreen {
                width: 100%; height: 100%;
                active-tab <=> root.perm-active-tab;
                perm-users: root.perm-users;
                perm-groups: root.perm-groups;
                perm-selected-user: root.perm-selected-user;
                perm-suid-files: root.perm-suid-files;
                perm-world-writable: root.perm-world-writable;
                perm-scanning: root.perm-scanning;
                perm-high-risk-count: root.perm-high-risk-count;
                perm-medium-risk-count: root.perm-medium-risk-count;
                perm-low-risk-count: root.perm-low-risk-count;
                perm-scan-path <=> root.perm-scan-path;
                perm-scan-status: root.perm-scan-status;
                perm-search-text <=> root.perm-search-text;
                perm-selected-file: root.perm-selected-file;
                perm-has-selected-file: root.perm-has-selected-file;
                perm-export-status: root.perm-export-status;
                perm-tab(idx) => { root.perm-tab(idx); }
                perm-refresh() => { root.perm-refresh(); }
                perm-fix(path) => { root.perm-fix(path); }
                perm-select-user(idx) => { root.perm-select-user(idx); }
                perm-select-file(tab, idx) => { root.perm-select-file(tab, idx); }
                perm-scan-dir(path) => { root.perm-scan-dir(path); }
                perm-export-report() => { root.perm-export-report(); }
                perm-search(query) => { root.perm-search(query); }
                perm-fix-permission(path) => { root.perm-fix-permission(path); }
                perm-acl-output: root.perm-acl-output;
                perm-acl-panel-open <=> root.perm-acl-panel-open;
                perm-acl-target-path <=> root.perm-acl-target-path;
                perm-view-acl(path) => { root.perm-view-acl(path); }
                perm-set-acl(path, spec) => { root.perm-set-acl(path, spec); }
                ai-is-working: root.perm-ai-is-working;
                ai-response: root.perm-ai-response;
                ai-panel-open <=> root.perm-ai-panel-open;
                ai-explain-pressed => { root.perm-ai-explain(); }
                ai-dismiss => { root.perm-ai-dismiss(); }
            }
        }

        // Spreadsheet
        // ── Document Editor (screen 30) ──
        // Presentation (screen 31)
        // ── Persistent dock for windowed app screens (auto-hide) ──
        if current-screen >= 4 && current-screen <= 31 : Rectangle {
            width: 100%;
            height: parent.height;
            y: 0;
            background: transparent;

            // Invisible hover-trigger zone at bottom edge
            dock-trigger := TouchArea {
                y: parent.height - 6px;
                width: 100%;
                height: 6px;
            }

            property <bool> dock-revealed: dock-trigger.has-hover || dock-area.has-hover;

            // The actual dock, slides up when revealed
            dock-area := TouchArea {
                y: parent.height - (dock-revealed ? 60px : 4px);
                width: 100%;
                height: 60px;

                animate y { duration: 200ms; easing: ease-out; }

                AppDock {
                    width: 100%;
                    opacity: dock-revealed ? 1.0 : 0.0;
                    animate opacity { duration: 150ms; }
                    items: root.dock-items.length > 0 ? root.dock-items : [
                        { app-id: "terminal",      label: "Terminal", icon-char: ">_", is-running: false },
                        { app-id: "browser",       label: "Browser",  icon-char: "W",  is-running: false },
                        { app-id: "files",         label: "Files",    icon-char: "F",  is-running: false },
                        { app-id: "notes",         label: "Notes",    icon-char: "✎",  is-running: false },
                        { app-id: "editor",        label: "Editor",   icon-char: "≡",  is-running: false },
                        { app-id: "bond",          label: "Bond",     icon-char: "♥",  is-running: false },
                        { app-id: "memory",        label: "Memory",   icon-char: "◈",  is-running: false },
                        { app-id: "notifications", label: "Alerts",   icon-char: "N",  is-running: false },
                        { app-id: "system",        label: "System",   icon-char: "◉",  is-running: false },
                        { app-id: "media",         label: "Media",    icon-char: "♪",  is-running: false },
                        { app-id: "email",         label: "Email",    icon-char: "@",  is-running: false },
                        { app-id: "calendar",      label: "Calendar", icon-char: "▦",  is-running: false },
                        { app-id: "network",       label: "Network",  icon-char: "\u{25CE}",  is-running: false },
                        { app-id: "launchpad",     label: "Apps",     icon-char: "\u{229E}",  is-running: false },
                        { app-id: "spreadsheet",   label: "ySheets",  icon-char: "YS", is-running: false },
                        { app-id: "documents",     label: "yDoc",     icon-char: "YD", is-running: false },
                        { app-id: "presentation",  label: "yPresent", icon-char: "YP", is-running: false },
                        { app-id: "settings",      label: "Settings", icon-char: "\u{2699}",  is-running: false },
                    ];
                    launch-app(app-id) => { root.launch-app(app-id); }
                    anchor-pressed => {
                        root.current-screen = 1;
                        root.navigate(1);
                    }
                }
            }

            // Thin glow hint line when dock is hidden
            Rectangle {
                y: parent.height - 2px;
                width: parent.width * 0.3;
                x: (parent.width - self.width) / 2;
                height: 2px;
                border-radius: 1px;
                background: @linear-gradient(90deg, transparent 0%, Theme.cyan-glow 50%, transparent 100%);
                opacity: dock-revealed ? 0.0 : 0.3;
                animate opacity { duration: 200ms; }
            }
        }

        // Voice overlay
        if voice-active : VoiceOverlay {
            width: 100%; height: 100%;
            voice-state: root.voice-state;
            transcribed-text: root.voice-transcribed;
            response-text: root.voice-response;
            cancel-pressed => {
                root.voice-active = false;
                root.cancel-voice();
            }
        }

        // Toast notification banners (top-right, stacking)
        if toast-queue.length > 0 : ToastBanner {
            width: 100%; height: 100%;
            toasts: root.toast-queue;
            toast-clicked(id) => { root.toast-clicked(id); }
            toast-dismissed(id) => { root.toast-dismissed(id); }
        }

        // Debug: navigate to screen from Rust
        // Set debug-target-screen from Rust, then call debug-navigate()
        // to switch to that screen (useful for automated screenshots).
    }
}
