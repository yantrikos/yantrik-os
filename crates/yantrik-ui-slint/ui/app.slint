    Rectangle {
        clip: true;
        width: 100%;
        height: 100%;

        // ── The shell's own keyboard shortcuts ────────────────────────────────────────────
        //
        // This was a 0x0 FocusScope sitting BESIDE the screens, holding a Ctrl+Space handler,
        // and it had never once run. Slint delivers a key event to the focused element and then
        // walks UP its parent chain; nothing in this window ever called `focus()` on this scope,
        // and even when something else had focus, this scope is not an ancestor of anything, so
        // a rejected key had no path to it. Two shortcuts were advertised on the desktop — "Ctrl
        // K" on the ask bar and again in the day-one card — against a handler that could not
        // fire and a Ctrl+K arm that was never written.
        //
        // So it wraps the window instead of standing next to it, which puts it on the parent
        // chain of every focused element in the shell, and:
        //
        //   • `capture-key-pressed` runs on the way DOWN, before the focused element sees the
        //     key. Ctrl+K is here because the Lens's own text field is a legitimate focus target
        //     and a shortcut that stops working once you have clicked in a field is not a
        //     shortcut. Only keys this shell reserves belong in capture; everything else must
        //     reject, or typing stops working.
        //   • `key-pressed` runs on the way back UP, after the focused element has declined the
        //     key. Ctrl+Space stays here: it is a hotkey, not something to take away from a text
        //     field that wants it.
        //
        // `focus-global-keys()` below is called once at startup. Slint drops a key event
        // entirely when NOTHING has focus — there is no chain to walk, so not even capture runs
        // — and on a freshly started shell sitting on the desktop, nothing does.
        //
        // This only covers the case where the compositor is giving this window the keys. labwc
        // hands keyboard focus to the focused toplevel, so while Notes is in front, Ctrl+K is
        // Notes' key and never reaches us. That case is the compositor's to answer: see the
        // Super+K binding in config/labwc/rc.xml, which calls `yos act shell open_lens`.
        global-keys := FocusScope {
            width: 100%; height: 100%;
            // Tab belongs to whatever is on screen; this scope is not a stop on the tour.
            focus-on-tab-navigation: false;

            capture-key-pressed(event) => {
                // Ctrl+K — the ask bar while the shell holds the keyboard. It was once wired to
                // nothing at all; what the desktop advertises now is Super+K, the compositor
                // binding that also works from inside any app (config/labwc/rc.xml, #209). The
                // Lens lives on the desktop screen, so summoning it from elsewhere goes there
                // first; opening it any other way (the ask bar, the orb, the taskbar anchor)
                // does exactly these two lines.
                if event.modifiers.control && (event.text == "k" || event.text == "K") {
                    // Not from the lock or login screen (#203): these two lines used to walk
                    // the shell off either one straight to the desktop with the Lens open and
                    // no password, exactly what `yos act shell open_lens` did over the socket.
                    // The key is swallowed rather than rejected so it reaches nothing else.
                    if root.current-screen == 3 || root.current-screen == 32 {
                        return accept;
                    }
                    if root.current-screen != 1 {
                        root.current-screen = 1;
                        root.navigate(1);
                    }
                    root.lens-open = true;
                    root.open-lens();
                    return accept;
                }
                return reject;
            }

            key-pressed(event) => {
                // Escape puts the taskbar's window menu away (#232). Handled here rather than
                // in the menu: YContextMenu is no PopupWindow, so nothing closes it for free,
                // and this scope is the one ancestor every focused element in the shell has —
                // whichever entry opened the menu, the key walks up to here.
                if root.taskbar-menu-open && event.text == Key.Escape {
                    root.taskbar-menu-open = false;
                    return accept;
                }
                // Ctrl+Space as voice hotkey (more reliable than Super across platforms)
                if event.modifiers.control && event.text == " " {
                    root.voice-hotkey-pressed();
                    return accept;
                }
                return reject;
            }

        // Boot screen
        if current-screen == 0 : BootScreen {
            width: 100%; height: 100%;
            ambient-interval-ms: root.ambient-interval-ms;
            status-text: root.boot-status;
            memory-count: root.memory-count;
            stages: root.boot-stages;
            progress: root.progress;
            version: root.version;
            boot-complete => { root.boot-complete(); }
        }

        // Onboarding (first boot only)
        if current-screen == 2 : OnboardingScreen {
            width: 100%; height: 100%;
            ambient-interval-ms: root.ambient-interval-ms;
            companion-name: root.settings-companion-name;
            installer-mode: root.onboard-installer-mode;
            // AI hardware scan properties
            ai-hw-cpu-ok: root.onboard-ai-hw-cpu-ok;
            ai-hw-ram-ok: root.onboard-ai-hw-ram-ok;
            ai-hw-gpu-ok: root.onboard-ai-hw-gpu-ok;
            ai-hw-disk-ok: root.onboard-ai-hw-disk-ok;
            ai-hw-network-ok: root.onboard-ai-hw-network-ok;
            ai-hw-runtime-ok: root.onboard-ai-hw-runtime-ok;
            ai-hw-cpu-label: root.onboard-ai-hw-cpu-label;
            ai-hw-ram-label: root.onboard-ai-hw-ram-label;
            ai-hw-gpu-label: root.onboard-ai-hw-gpu-label;
            ai-hw-disk-label: root.onboard-ai-hw-disk-label;
            ai-hw-recommend: root.onboard-ai-hw-recommend;
            ai-test-status: root.onboard-ai-test-status;
            ai-test-model: root.onboard-ai-test-model;
            ai-test-latency-ms: root.onboard-ai-test-latency-ms;
            ai-test-privacy: root.onboard-ai-test-privacy;
            set-names(user-name, comp-name) => {
                if user-name != "" {
                    root.rename-user(user-name);
                    root.settings-user-name = user-name;
                }
                if comp-name != "" {
                    root.rename-companion(comp-name);
                    root.settings-companion-name = comp-name;
                }
            }
            set-profile(interests, home-loc, notif-pref) => {
                root.onboarding-set-profile(interests, home-loc, notif-pref);
            }
            ai-mode-selected(mode) => { root.onboard-ai-mode-selected(mode); }
            ai-provider-selected(provider) => { root.onboard-ai-provider-selected(provider); }
            ai-api-key-submitted(provider, key) => { root.onboard-ai-api-key-submitted(provider, key); }
            ai-test-connection => { root.onboard-ai-test-connection(); }
            ai-skip-setup => { root.onboard-ai-skip-setup(); }
            disk-1-name: root.onboard-disk-1-name;
            disk-1-size: root.onboard-disk-1-size;
            disk-1-model: root.onboard-disk-1-model;
            disk-2-name: root.onboard-disk-2-name;
            disk-2-size: root.onboard-disk-2-size;
            disk-2-model: root.onboard-disk-2-model;
            disk-3-name: root.onboard-disk-3-name;
            disk-3-size: root.onboard-disk-3-size;
            disk-3-model: root.onboard-disk-3-model;
            selected-disk <=> root.onboard-selected-disk;
            install-to-disk(username, password, full-name, hostname, comp-name, target-disk) => {
                root.onboard-install-to-disk(username, password, full-name, hostname, comp-name, target-disk);
            }
            install-progress <=> root.onboard-install-progress;
            install-status <=> root.onboard-install-status;
            phase <=> root.onboard-phase;
            input-user-name <=> root.onboard-input-full-name;
            input-companion-name <=> root.onboard-input-companion;
            input-home-location <=> root.onboard-input-location;
            input-username <=> root.onboard-input-username;
            input-password <=> root.onboard-input-password;
            input-password-confirm <=> root.onboard-input-password-confirm;
            input-hostname <=> root.onboard-input-hostname;
            install-error <=> root.onboard-install-error;
            installing <=> root.onboard-installing;
            install-reboot => { root.onboard-install-reboot(); }
            ready => {
                root.current-screen = 1;
                root.navigate(1);
                root.onboarding-ready();
            }
            skip => {
                root.current-screen = 1;
                root.navigate(1);
                root.onboarding-skip();
            }
        }

        // Lock screen
        if current-screen == 3 : LockScreen {
            width: 100%; height: 100%;
            // The breathing background is decoration, and it is drawn on the screen that is up
            // whenever nobody is at the machine — so it gets the renderer's budget, like the
            // desktop's ambient layers, rather than the display's frame rate.
            ambient-interval-ms: root.ambient-interval-ms;
            clock-text: root.clock-text;
            date-text: root.lock-date-text;
            greeting-text: root.lock-greeting;
            error-text: root.lock-error;
            try-unlock(pin) => { root.try-unlock(pin); }
        }

        // Login screen (installed system boot)
        if current-screen == 32 : LoginScreen {
            width: 100%; height: 100%;
            ambient-interval-ms: root.ambient-interval-ms;
            clock-text: root.clock-text;
            date-text: root.lock-date-text;
            error-text: root.login-error;
            hostname: root.login-hostname;
            login-attempt(username, password) => { root.login-attempt(username, password); }
        }

        // Desktop (the main experience)
        if current-screen == 1 : DesktopScreen {
            width: 100%; height: 100%;
            agent-mode: root.agent-mode;
            ambient-interval-ms: root.ambient-interval-ms;
            // The room the mind panel takes at the right edge (see `mind-panel-reserve`).
            right-inset: root.mind-panel-reserve;
            date-text: root.date-text;
            grid-categories: root.grid-categories;
            grid-active-category: root.grid-active-category;
            grid-category-selected(id) => { root.grid-category-selected(id); }
            // Status bar
            clock-text: root.clock-text;
            companion-status: root.companion-status;
            companion-online: root.companion-online;
            battery-available: root.battery-available;
            battery-level: root.battery-level;
            battery-charging: root.battery-charging;
            wifi-connected: root.wifi-connected;
            wifi-ssid: root.sys-wifi-ssid;
            pending-count: root.pending-count;
            settings-incognito-mode: root.settings-incognito-mode;
            dnd-mode: root.dnd-mode;
            // Wallpaper
            wallpaper-path: root.wallpaper-path;
            wallpaper-image: root.wallpaper-image;
            // V61 — AI privacy mode
            ai-privacy-mode: root.ai-privacy-mode;
            ai-fallback-banner: root.ai-fallback-banner;
            ai-privacy-clicked => { root.ai-quick-switcher-open = !root.ai-quick-switcher-open; }
            active-harness-id: root.active-harness-id;
            active-harness-name: root.active-harness-name;
            // Straight to the section, not to the front door of Settings.
            active-mind-clicked => {
                root.settings-category = 8;
                root.current-screen = 7;
                root.navigate(7);
            }
            // Companion
            is-thinking: root.is-thinking;
            has-urges: root.has-urges;
            is-speaking: root.is-speaking;
            is-listening: root.is-listening;
            greeting-text: root.greeting-text;
            memory-count: root.memory-count;
            // Ambient Intelligence
            particle-sentiment: root.particle-sentiment;
            particle-cognitive-load: root.particle-cognitive-load;
            particle-time-of-day: root.particle-time-of-day;
            // Project Consciousness
            active-project: root.active-project;
            // Intent Lens
            lens-open <=> root.lens-open;
            lens-input-text <=> root.lens-input-text;
            lens-results: root.lens-results;
            lens-chat-mode: root.lens-chat-mode;
            lens-suggestions: root.lens-suggestions;
            lens-recents: root.lens-recents;
            // Chat
            messages: root.messages;
            is-generating: root.is-generating;
            // Approvals, in the conversation where the asking belongs
            approvals: root.approvals;
            approvals-waiting: root.approvals-waiting;
            approval-allow(id) => { root.approval-allow(id); }
            approval-allow-session(id) => { root.approval-allow-session(id); }
            approval-deny(id) => { root.approval-deny(id); }
            lens-can-open-in-agents: root.lens-can-open-in-agents;
            lens-open-in-agents => { root.lens-open-in-agents(); }
            lens-open-history => { root.lens-open-history(); }
            // Urges
            urges: root.urges;
            // Whisper Cards
            whisper-cards: root.whisper-cards;
            whisper-card-dismissed(id) => { root.whisper-card-dismissed(id); }
            whisper-card-action(id) => { root.whisper-card-action(id); }
            whisper-hint-clicked => { root.whisper-hint-clicked(); }
            // Morning Brief
            morning-brief-visible: root.morning-brief-visible;
            morning-brief-greeting: root.morning-brief-greeting;
            morning-brief-sections: root.morning-brief-sections;
            morning-brief-dismissed => { root.morning-brief-dismissed(); }
            morning-brief-section-action(id) => { root.morning-brief-section-action(id); }
            // Clipboard panel
            clip-panel-open <=> root.clip-panel-open;
            clip-panel-entries: root.clip-panel-entries;
            clip-search-query <=> root.clip-search-query;
            clipboard-paste(idx) => { root.clipboard-paste(idx); }
            clipboard-search(query) => { root.clipboard-search(query); }
            // Power menu
            power-menu-open <=> root.power-menu-open;
            power-action(action) => { root.power-action(action); }
            // App grid
            app-grid-open <=> root.app-grid-open;
            grid-apps: root.grid-apps;
            grid-launch-app(app-id) => { root.grid-launch-app(app-id); }
            grid-toggle-pin(app-id) => { root.grid-toggle-pin(app-id); }
            grid-search-apps(query) => { root.grid-search-apps(query); }
            // Window switcher
            window-switcher-open <=> root.window-switcher-open;
            window-list: root.window-list;
            switch-window(title) => { root.switch-window(title); }
            // Command Palette
            command-palette-open <=> root.command-palette-open;
            command-palette-filtered: root.command-palette-filtered;
            command-palette-search(query) => { root.command-palette-search(query); }
            command-palette-selected(action-id) => { root.command-palette-selected(action-id); }
            // Dock items
            dock-items: root.dock-items;
            // Quick Settings
            quick-settings-open <=> root.quick-settings-open;
            brightness-level <=> root.brightness-level;
            volume-level <=> root.volume-level;
            toggle-wifi => { root.toggle-wifi(); }
            brightness-changed(val) => { root.brightness-changed(val); }
            volume-changed(val) => { root.volume-changed(val); }
            // Focus mode
            focus-mode <=> root.focus-mode;
            focus-remaining: root.focus-remaining;
            end-focus-mode => { root.end-focus-mode(); }
            // Callbacks
            send-message(text) => { root.send-message(text); }
            mic-pressed => { root.mic-pressed(); }
            launch-app(app-id) => { root.launch-app(app-id); }
            navigate-to(screen) => {
                root.current-screen = screen;
                root.navigate(screen);
            }
            lens-query(text) => { root.lens-query(text); }
            lens-submit(text) => { root.lens-submit(text); }
            lens-result-selected(id) => { root.lens-result-selected(id); }
            open-lens => { root.open-lens(); }
            close-lens => { root.close-lens(); }
        }

        // ═══ Windowed app screens (4-13) — wrapped in WindowFrame ═══

        // Bond screen
        if current-screen == 4 : WindowFrame {
            content-has-controls: true;
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.bond;
            icon-color: Theme.color-emotional;
            title: Tr.title-bond;
            close => {
                if (root.minimized-screen == 4) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 4;
                root.minimized-title = Tr.title-bond;
                root.minimized-app-id = "bond";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            BondScreen {
                show-window-controls: root.window-maximized;
                maximized: root.window-maximized;
                minimize => {
                    root.minimized-screen = 4;
                    root.minimized-title = Tr.title-bond;
                    root.minimized-app-id = "bond";
                    root.current-screen = 1; root.navigate(1);
                }
                toggle-maximize => { root.window-maximized = !root.window-maximized; }
                close-window => {
                    if (root.minimized-screen == 4) { root.minimized-screen = 0; }
                    root.current-screen = 1; root.navigate(1);
                }
                width: 100%; height: 100%;
                data: root.bond-data;
                back-pressed => {
                    root.current-screen = 1;
                    root.navigate(1);
                }
            }
        }

        // Personality screen
        if current-screen == 5 : WindowFrame {
            content-has-controls: true;
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.spark;
            icon-color: Theme.color-pattern;
            title: Tr.title-personality;
            close => {
                if (root.minimized-screen == 5) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 5;
                root.minimized-title = Tr.title-personality;
                root.minimized-app-id = "personality";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            PersonalityScreen {
                show-window-controls: root.window-maximized;
                maximized: root.window-maximized;
                minimize => {
                    root.minimized-screen = 5;
                    root.minimized-title = Tr.title-personality;
                    root.minimized-app-id = "personality";
                    root.current-screen = 1; root.navigate(1);
                }
                toggle-maximize => { root.window-maximized = !root.window-maximized; }
                close-window => {
                    if (root.minimized-screen == 5) { root.minimized-screen = 0; }
                    root.current-screen = 1; root.navigate(1);
                }
                width: 100%; height: 100%;
                formality: root.formality;
                humor-ratio: root.humor-ratio;
                opinion-strength: root.opinion-strength;
                question-ratio: root.question-ratio;
                opinions: root.opinions;
                shared-refs: root.shared-refs;
                back-pressed => {
                    root.current-screen = 1;
                    root.navigate(1);
                }
            }
        }

        // Memory browser
        if current-screen == 6 : WindowFrame {
            content-has-controls: true;
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.chip;
            icon-color: Theme.amber;
            title: Tr.title-memory;
            close => {
                if (root.minimized-screen == 6) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 6;
                root.minimized-title = Tr.title-memory;
                root.minimized-app-id = "memory";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            MemoryBrowser {
                show-window-controls: root.window-maximized;
                maximized: root.window-maximized;
                minimize => {
                    root.minimized-screen = 6;
                    root.minimized-title = Tr.title-memory;
                    root.minimized-app-id = "memory";
                    root.current-screen = 1; root.navigate(1);
                }
                toggle-maximize => { root.window-maximized = !root.window-maximized; }
                close-window => {
                    if (root.minimized-screen == 6) { root.minimized-screen = 0; }
                    root.current-screen = 1; root.navigate(1);
                }
                width: 100%; height: 100%;
                results: root.memory-results;
                is-searching: root.is-searching-memories;
                total-memories: root.memory-count;
                search(query) => { root.search-memories(query); }
                back-pressed => {
                    root.current-screen = 1;
                    root.navigate(1);
                }
            }
        }

        // Settings screen
        if current-screen == 7 : WindowFrame {
            x: root.window-maximized ? 0px : root.window-x;
            y: root.window-maximized ? Theme.status-bar-height : root.window-y;
            width: root.window-maximized ? parent.width - root.mind-panel-reserve : root.window-w;
            height: root.window-maximized ? parent.height - Theme.taskbar-height - Theme.status-bar-height : root.window-h;
            is-maximized <=> root.window-maximized;
            win-x <=> root.window-x;
            win-y <=> root.window-y;
            win-w <=> root.window-w;
            win-h <=> root.window-h;
            icon-path: Icons.settings;
            icon-color: Theme.text-secondary;
            title: Tr.title-settings;
            close => {
                if (root.minimized-screen == 7) { root.minimized-screen = 0; }
                root.current-screen = 1; root.navigate(1);
            }
            minimize => {
                root.minimized-screen = 7;
                root.minimized-title = Tr.title-settings;
                root.minimized-app-id = "settings";
                root.current-screen = 1; root.navigate(1);
            }
            animate x, y, width, height { duration: 200ms; easing: ease-out; }

            SettingsScreen {
                width: 100%; height: 100%;
                user-name <=> root.settings-user-name;
                companion-name <=> root.settings-companion-name;
                rename-user(name) => { root.rename-user(name); }
                rename-companion(name) => { root.rename-companion(name); }
                model-name: root.settings-model-name;
                max-context: root.settings-max-context;
                max-tokens: root.settings-max-tokens;
                tool-permission: root.settings-tool-permission;
                auto-lock-secs: root.settings-auto-lock-secs;
                network-online: root.network-online;
                network-label: root.network-label;
                network-detail: root.network-detail;
                ip-address: root.settings-ip-address;
                display-resolution: root.settings-display-resolution;
                llm-backend: root.settings-llm-backend;
                llm-api-url: root.settings-llm-api-url;
                llm-api-model: root.settings-llm-api-model;
                memory-count: root.memory-count;
                version-text: root.settings-version;
                notification-count: root.notification-unread-count;
                dark-mode <=> root.settings-dark-mode;
                incognito-mode <=> root.settings-incognito-mode;
                dnd-mode <=> root.dnd-mode;
                accent-color <=> root.settings-accent-color;
                toggle-dark-mode => { root.toggle-dark-mode(); }
                agent-mode: root.agent-mode;
                set-agent-mode(value) => { root.set-agent-mode(value); }
                toggle-incognito-mode => { root.toggle-incognito-mode(); }
                toggle-dnd-mode => { root.toggle-dnd-mode(); }
                cycle-accent-color => { root.cycle-accent-color(); }
                cycle-tool-permission => { root.cycle-tool-permission(); }
                // The mode, beside the ceiling it can never reach past.
                mind-mode: root.mind-mode;
