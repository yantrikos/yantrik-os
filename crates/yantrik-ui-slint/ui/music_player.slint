// Music Player — a library from your folders, a queue, and a transport driven by mpv.
//
// Every control on this screen does something the app backs: the library is what a scan of the
// listed folders found, the queue is what plays next, and play, pause, stop, next, previous, seek,
// volume and mute are commands to the app's own mpv, drawn from what mpv reports back. The old
// screen (2,168 lines) also drew playlists, artist/album/genre browsing, shuffle, repeat, speed,
// an equaliser, folder watching and an "Explain" button with nothing behind any of them; they are
// gone until something backs them (design/apps-plan-2026-09-20.md, Wave 3).
//
// No timers and no animations: mpv pushes the position, so the screen only redraws when it moves.
import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { YButton, YIconButton } from "components/y_button.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { YNoticeBar } from "components/notice_bar.slint";
import { Icon, Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AgentRail, AgentContextItem } from "components/agent_rail.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";

// One track in the library or the queue.
export struct MusicTrackData {
    title: string,
    // The folder the file is in; the scan reads no tags.
    album: string,
    path: string,
    is-current: bool,
}

// One library folder and what its last scan found in it.
export struct MusicScanFolderData {
    path: string,
    track-count: int,
}

export component MusicPlayerScreen inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar.
    in property <bool> window-bar: false;
    // What this app holds, for the agent rail: the track mpv is playing.
    in property <[AgentContextItem]> agent-context: [];

    background: Theme.bg-deep;

    // Library — the tracks shown (after the search filter) and how many the library holds.
    in property <[MusicTrackData]> library-tracks: [];
    in property <int> library-track-count: 0;
    in-out property <string> browse-filter: "";

    // Now playing, as mpv reports it.
    in property <string> now-title: "";
    in property <string> now-album: "";
    in property <bool> is-playing: false;
    in property <float> progress: 0.0;
    in property <string> time-current: "";
    in property <string> time-total: "";
    in property <float> volume: 0.8;
    in property <bool> volume-muted: false;

    // Queue
    in property <[MusicTrackData]> queue-tracks: [];
    in property <int> queue-current-index: -1;

    // Folders and the scan
    in property <[MusicScanFolderData]> scan-folders: [];
    in property <bool> is-scanning: false;
    // The last thing the app has to say: how a scan went, what is playing. Always drawn.
    in property <string> status-text: "";
    // What could not be done, in plain words: no mpv, mpv stopped, a file that would not play.
    in property <string> notice: "";

    in-out property <bool> show-scan-folders-dialog: false;

    // Playback
    callback play-pause();
    callback stop();
    callback next-track();
    callback prev-track();
    callback seek(float);
    callback volume-changed(float);
    callback toggle-mute();
    callback play-track-index(int);
    callback queue-play-index(int);
    // Library
    callback browse-filter-changed(string);
    callback scan-add-folder(string);
    callback scan-remove-folder(int);
    callback scan-rescan();
    callback dismiss-notice();

    // The folders dialog's path field.
    property <string> new-folder-path: "";

    VerticalLayout {
        spacing: 0px;

        AppHeader {
            window-bar: root.window-bar;
            app-id: "music";
            icon: Icons.music;
            title: "Music";
            subtitle: root.library-track-count == 1 ? "1 track" : "\{root.library-track-count} tracks";
            show-search: true;
            search-placeholder: "Search library";
            search-text <=> root.browse-filter;
            actions: [
                { id: "folders", icon: Icons.folder, label: "Folders", active: root.show-scan-folders-dialog },
            ];
            search-edited(t) => { root.browse-filter-changed(t); }
            action(id) => {
                if (id == "folders") { root.show-scan-folders-dialog = !root.show-scan-folders-dialog; }
            }
        }

        // ══════════════ Status line ══════════════
        //
        // Outside any condition on scanning, so the sentence a scan ends with stays on screen.
        if root.status-text != "" || root.is-scanning : Rectangle {
            height: 28px;
            background: Theme.bg-card;
            Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.separator; }
            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;
                spacing: Theme.sp-2;
                if root.is-scanning : Icon {
                    commands: Icons.refresh;
                    size: 12px;
                    tint: Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: root.status-text;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }
        }

        if root.notice != "" : YNoticeBar {
            text: root.notice;
            tone: 1;
            dismissed => { root.dismiss-notice(); }
        }

        HorizontalLayout {
            vertical-stretch: 1;
            spacing: 0px;

            // ─── Library ───
            Rectangle {
                horizontal-stretch: 1;
                background: Theme.bg-deep;

                VerticalLayout {
                    spacing: 0px;

                    if root.library-tracks.length > 0 : Rectangle {
                        height: 28px;
                        Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.separator; }
                        HorizontalLayout {
                            padding-left: Theme.sp-4;
                            padding-right: Theme.sp-4;
                            spacing: Theme.sp-3;
                            Text {
                                text: "#";
                                width: 36px;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                font-family: Theme.font-mono;
                                horizontal-alignment: right;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "TITLE";
                                horizontal-stretch: 1;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: "FOLDER";
                                width: 200px;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 0.8px;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        if root.library-tracks.length > 0 : ListView {
                            for tr[tidx] in root.library-tracks : Rectangle {
                                height: 38px;
                                background: tr.is-current ? AppIdentity.tint
                                          : row-ta.has-hover ? Theme.hover-fill
                                          : mod(tidx, 2) == 1 ? Theme.bg-surface.transparentize(60%)
                                          : transparent;
                                if tr.is-current : Rectangle { x: 0; width: 2px; height: 100%; background: Theme.accent; }

                                row-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.play-track-index(tidx); }
                                }

                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-4;
                                    spacing: Theme.sp-3;
                                    Rectangle {
                                        width: 36px;
                                        if row-ta.has-hover || tr.is-current : Icon {
                                            commands: tr.is-current && root.is-playing ? Icons.volume : Icons.play;
                                            size: 13px;
                                            tint: tr.is-current ? Theme.accent : Theme.text-primary;
                                            x: parent.width - self.width;
                                            y: (parent.height - self.height) / 2;
                                        }
                                        if !row-ta.has-hover && !tr.is-current : Text {
                                            text: tidx + 1;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            font-family: Theme.font-mono;
                                            width: 100%;
                                            horizontal-alignment: right;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Text {
                                        text: tr.title;
                                        horizontal-stretch: 1;
                                        color: tr.is-current ? AppIdentity.accent : Theme.text-primary;
                                        font-size: Theme.fs-body;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: tr.album;
                                        width: 200px;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-caption;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.library-tracks.length == 0 : YEmptyState {
                            icon-path: Icons.music;
                            title: root.is-scanning ? "Scanning your folders"
                                 : root.library-track-count > 0 ? "Nothing matches the search"
                                 : root.scan-folders.length == 0 ? "No library folders"
                                 : "No music found";
                            description: root.is-scanning ? "Tracks appear here when the scan finishes."
                                    : root.library-track-count > 0 ? "Clear the search to see the whole library."
                                    : "Open Folders and add a folder that holds music (mp3, flac, ogg, opus, wav, m4a).";
                        }
                    }
                }
            }

            Rectangle { width: 1px; background: Theme.separator; }

            // ─── Now playing and the queue ───
            Rectangle {
                width: 300px;
                background: Theme.bg-surface;

                VerticalLayout {
                    spacing: 0px;
                    padding-top: Theme.sp-4;

                    VerticalLayout {
                        padding-left: Theme.sp-4;
                        padding-right: Theme.sp-4;
                        padding-bottom: Theme.sp-3;
                        spacing: 2px;
                        Text {
                            text: "NOW PLAYING";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            font-weight: Theme.fw-micro;
                            letter-spacing: 1px;
                        }
                        Text {
                            text: root.now-title != "" ? root.now-title : "Nothing playing";
                            color: root.now-title != "" ? Theme.text-primary : Theme.text-dim;
                            font-size: Theme.fs-body;
                            font-weight: 500;
                            overflow: elide;
                        }
                        Text {
                            text: root.now-album;
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            overflow: elide;
                        }
                    }

                    Rectangle { height: 1px; background: Theme.separator; }

                    Rectangle {
                        height: 30px;
                        HorizontalLayout {
                            padding-left: Theme.sp-4;
                            padding-right: Theme.sp-3;
                            spacing: Theme.sp-2;
                            Text {
                                text: "QUEUE";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                font-weight: Theme.fw-micro;
                                letter-spacing: 1px;
                                vertical-alignment: center;
                            }
                            Text {
                                text: root.queue-tracks.length > 0 ? "\{root.queue-current-index + 1} of \{root.queue-tracks.length}" : "";
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                font-family: Theme.font-mono;
                                vertical-alignment: center;
                            }
                        }
                    }

                    Rectangle {
                        vertical-stretch: 1;
                        clip: true;

                        if root.queue-tracks.length > 0 : ListView {
                            for qt[qidx] in root.queue-tracks : Rectangle {
                                property <bool> current: qidx == root.queue-current-index;
                                height: 36px;
                                background: current ? AppIdentity.tint : q-ta.has-hover ? Theme.hover-fill : transparent;
                                q-ta := TouchArea {
                                    mouse-cursor: pointer;
                                    clicked => { root.queue-play-index(qidx); }
                                }
                                HorizontalLayout {
                                    padding-left: Theme.sp-4;
                                    padding-right: Theme.sp-3;
                                    Text {
                                        text: qt.title;
                                        color: current ? AppIdentity.accent : Theme.text-secondary;
                                        font-size: Theme.fs-caption;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        if root.queue-tracks.length == 0 : Text {
                            x: Theme.sp-4;
                            y: Theme.sp-2;
                            width: parent.width - 2 * Theme.sp-4;
                            text: "Pick a track in the library: the list it is in becomes the queue.";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            wrap: word-wrap;
                        }
                    }

                    // ── What Yantrik knows about this ──
                    AgentRail {
                        context-items: root.agent-context;
                    }
                }
            }
        }

        // ══════════════ Transport ══════════════
        Rectangle {
            height: 76px;
            background: Theme.bg-card;
            Rectangle { y: 0; height: 1px; width: 100%; background: Theme.separator; }

            HorizontalLayout {
                padding-left: Theme.sp-4;
                padding-right: Theme.sp-4;
                spacing: Theme.sp-4;

                // Buttons
                HorizontalLayout {
                    spacing: 6px;
                    alignment: start;

                    prev-ta := TouchArea {
                        width: 34px; height: 34px;
                        y: (parent.height - 34px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.prev-track(); }
                        Rectangle {
                            border-radius: 17px;
                            background: prev-ta.has-hover ? Theme.hover-fill : transparent;
                            Icon {
                                commands: Icons.skip-back;
                                size: 17px;
                                tint: Theme.text-secondary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    play-ta := TouchArea {
                        width: 42px; height: 42px;
                        y: (parent.height - 42px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.play-pause(); }
                        Rectangle {
                            border-radius: 21px;
                            background: play-ta.has-hover ? Theme.accent-light : Theme.accent;
                            Icon {
                                commands: root.is-playing ? Icons.pause : Icons.play;
                                size: 18px;
                                thickness: 2px;
                                tint: Theme.text-on-accent;
                                fill: root.is-playing ? transparent : Theme.text-on-accent;
                                x: (parent.width - self.width) / 2 + (root.is-playing ? 0px : 1px);
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    next-ta := TouchArea {
                        width: 34px; height: 34px;
                        y: (parent.height - 34px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.next-track(); }
                        Rectangle {
                            border-radius: 17px;
                            background: next-ta.has-hover ? Theme.hover-fill : transparent;
                            Icon {
                                commands: Icons.skip-forward;
                                size: 17px;
                                tint: Theme.text-secondary;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                    stop-ta := TouchArea {
                        width: 30px; height: 30px;
                        y: (parent.height - 30px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.stop(); }
                        Rectangle {
                            border-radius: 15px;
                            background: stop-ta.has-hover ? Theme.hover-fill : transparent;
                            Icon {
                                commands: Icons.stop;
                                size: 13px;
                                tint: Theme.text-dim;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                // Seek: the bar is mpv's time-pos over its duration. No `alignment: center`
                // here: that hands a TouchArea its preferred size, which is zero.
                HorizontalLayout {
                    horizontal-stretch: 1;
                    spacing: Theme.sp-2;
                    Text {
                        text: root.time-current;
                        width: 52px;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-family: Theme.font-mono;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                    seek-ta := TouchArea {
                        horizontal-stretch: 1;
                        mouse-cursor: root.time-total != "" ? pointer : default;
                        clicked => { root.seek(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
                        Rectangle {
                            y: (parent.height - 4px) / 2;
                            height: 4px;
                            width: 100%;
                            border-radius: 2px;
                            background: Theme.bg-input;
                            Rectangle {
                                x: 0;
                                width: parent.width * clamp(root.progress, 0.0, 1.0);
                                height: 100%;
                                border-radius: 2px;
                                background: Theme.accent;
                            }
                        }
                        if seek-ta.has-hover && root.time-total != "" : Rectangle {
                            x: parent.width * clamp(root.progress, 0.0, 1.0) - 5px;
                            y: (parent.height - 10px) / 2;
                            width: 10px; height: 10px;
                            border-radius: 5px;
                            background: Theme.accent;
                        }
                    }
                    Text {
                        text: root.time-total;
                        width: 52px;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-family: Theme.font-mono;
                        vertical-alignment: center;
                    }
                }

                // Volume
                HorizontalLayout {
                    width: 170px;
                    spacing: Theme.sp-2;
                    mute-ta := TouchArea {
                        width: 28px; height: 28px;
                        y: (parent.height - 28px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.toggle-mute(); }
                        Icon {
                            commands: root.volume-muted ? Icons.volume-off : Icons.volume;
                            size: 16px;
                            tint: root.volume-muted ? Theme.color-danger
                                : mute-ta.has-hover ? Theme.text-primary : Theme.text-dim;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                    }
                    vol-ta := TouchArea {
                        horizontal-stretch: 1;
                        mouse-cursor: pointer;
                        clicked => { root.volume-changed(clamp(self.mouse-x / self.width, 0.0, 1.0)); }
                        Rectangle {
                            y: (parent.height - 4px) / 2;
                            height: 4px;
                            width: 100%;
                            border-radius: 2px;
                            background: Theme.bg-input;
                            Rectangle {
                                x: 0;
                                width: parent.width * (root.volume-muted ? 0.0 : clamp(root.volume, 0.0, 1.0));
                                height: 100%;
                                border-radius: 2px;
                                background: Theme.text-secondary;
                            }
                        }
                    }
                    Text {
                        text: "\{round((root.volume-muted ? 0.0 : root.volume) * 100)}%";
                        width: 36px;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-family: Theme.font-mono;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ══════════════ Library folders dialog ══════════════
    if root.show-scan-folders-dialog : Rectangle {
        background: Theme.overlay-backdrop;
        TouchArea { clicked => { root.show-scan-folders-dialog = false; } }

        Rectangle {
            x: (parent.width - 520px) / 2;
            y: (parent.height - 380px) / 2;
            width: 520px;
            height: 380px;
            border-radius: Theme.r-lg;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-default;
            TouchArea { }

            VerticalLayout {
                padding: Theme.sp-5;
                spacing: Theme.sp-3;

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: "Library folders";
                        color: Theme.text-primary;
                        font-size: Theme.fs-title-2;
                        font-weight: Theme.fw-title-2;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    YIconButton {
                        icon-path: Icons.close;
                        variant: 1;
                        clicked => { root.show-scan-folders-dialog = false; }
                    }
                }

                Text {
                    text: "Music lists the audio files it finds in these folders. Linked folders inside them are not followed.";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                }

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.h-regular;
                        border-radius: Theme.r-md;
                        background: Theme.bg-input;
                        border-width: 1px;
                        border-color: folder-input.has-focus ? Theme.accent-dim : Theme.border-default;
                        clip: true;
                        if root.new-folder-path == "" : Text {
                            x: 10px;
                            height: 100%;
                            text: "/home/you/Music";
                            color: Theme.text-dim;
                            font-size: Theme.fs-caption;
                            font-family: Theme.font-mono;
                            vertical-alignment: center;
                        }
                        folder-input := TextInput {
                            x: 10px;
                            width: parent.width - 20px;
                            height: 100%;
                            vertical-alignment: center;
                            single-line: true;
                            font-size: Theme.fs-caption;
                            font-family: Theme.font-mono;
                            color: Theme.text-primary;
                            text <=> root.new-folder-path;
                            accepted => {
                                if (self.text != "") {
                                    root.scan-add-folder(self.text);
                                    root.new-folder-path = "";
                                }
                            }
                        }
                    }
                    YButton {
                        label: "Add";
                        icon-path: Icons.plus;
                        variant: 1;
                        size: 1;
                        disabled: root.new-folder-path == "";
                        clicked => {
                            root.scan-add-folder(root.new-folder-path);
                            root.new-folder-path = "";
                        }
                    }
                }

                Rectangle {
                    vertical-stretch: 1;
                    border-radius: Theme.r-md;
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    clip: true;

                    if root.scan-folders.length > 0 : Flickable {
                        viewport-height: folders-col.preferred-height;
                        folders-col := VerticalLayout {
                            alignment: start;
                            spacing: 0px;
                            for fo[fidx] in root.scan-folders : Rectangle {
                                height: 40px;
                                background: fo-ta.has-hover ? Theme.hover-fill : transparent;
                                Rectangle { y: parent.height - 1px; height: 1px; width: 100%; background: Theme.separator; }
                                fo-ta := TouchArea { }
                                HorizontalLayout {
                                    padding-left: Theme.sp-3;
                                    padding-right: Theme.sp-2;
                                    spacing: Theme.sp-2;
                                    Icon {
                                        commands: Icons.folder;
                                        size: 14px;
                                        tint: Theme.text-secondary;
                                        y: (parent.height - self.height) / 2;
                                    }
                                    Text {
                                        text: fo.path;
                                        horizontal-stretch: 1;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-caption;
                                        font-family: Theme.font-mono;
                                        overflow: elide;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.is-scanning ? "scanning"
                                            : fo.track-count == 1 ? "1 track" : "\{fo.track-count} tracks";
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        font-family: Theme.font-mono;
                                        vertical-alignment: center;
                                    }
                                    fo-rm := TouchArea {
                                        width: 24px; height: 24px;
                                        y: (parent.height - 24px) / 2;
                                        mouse-cursor: pointer;
                                        clicked => { root.scan-remove-folder(fidx); }
                                        Icon {
                                            commands: Icons.trash;
                                            size: 12px;
                                            tint: fo-rm.has-hover ? Theme.color-danger : Theme.text-dim;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    if root.scan-folders.length == 0 : Text {
                        x: Theme.sp-3;
                        y: Theme.sp-3;
                        text: "No folders yet.";
                        color: Theme.text-dim;
                        font-size: Theme.fs-caption;
                    }
                }

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: root.status-text;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                    YButton {
                        label: root.is-scanning ? "Scanning" : "Rescan";
                        icon-path: Icons.refresh;
                        variant: 1;
                        size: 0;
                        loading: root.is-scanning;
                        clicked => { root.scan-rescan(); }
                    }
                    YButton {
                        label: "Done";
                        variant: 0;
                        size: 0;
                        clicked => { root.show-scan-folders-dialog = false; }
                    }
                }
            }
        }
    }
}
