// ySheets — the spreadsheet's screen.
//
// Everything drawn here is backed (design/apps-plan-2026-09-20.md, contract item 7: no dead
// controls). The screen this replaced drew a ribbon of formatting, sort, filter, freeze, chart,
// comment, clipboard and AI controls over a grid that was never filled; 44 of its 47 handlers
// were log lines. What is left is what the app does: one sheet, typed into from the formula
// bar, worked out, opened from and saved to CSV, with undo and redo. Rust owns every value on
// it — the grid, the size, the column names, the selection — and the screen only asks.

import { Theme } from "theme.slint";
import { ListView } from "std-widgets.slint";
import { Icons } from "components/icon.slint";
import { AppHeader } from "components/app_header.slint";
import { AppIdentity } from "components/app_color.slint";

export struct SpreadsheetCell {
    // What the cell shows: its value, or its error code.
    text: string,
    is-number: bool,
    is-error: bool,
}

export struct SheetRow {
    cells: [SpreadsheetCell],
}

component CellView inherits Rectangle {
    in property <SpreadsheetCell> cell;
    in property <bool> selected;
    callback clicked();

    width: 100px;
    height: 28px;
    background: root.selected ? AppIdentity.accent.transparentize(80%) : Theme.bg-deep;
    border-width: root.selected ? 2px : 1px;
    border-color: root.selected ? AppIdentity.accent : Theme.border-subtle;

    TouchArea { clicked => { root.clicked(); } }
    Text {
        x: 6px;
        width: parent.width - 12px;
        height: parent.height;
        text: root.cell.text;
        color: root.cell.is-error ? Theme.color-warning : Theme.text-primary;
        font-size: Theme.fs-caption;
        horizontal-alignment: (root.cell.is-number || root.cell.is-error) ? right : left;
        vertical-alignment: center;
        overflow: elide;
    }
}

component HeaderCell inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    width: 100px;
    height: 28px;
    background: root.active ? Theme.bg-card : Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border-subtle;
    Text {
        text: root.label;
        color: root.active ? AppIdentity.accent : Theme.text-secondary;
        font-size: Theme.fs-caption;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component SpreadsheetScreen inherits Rectangle {
    // The app's window-bar (#256): this screen's header is its window's one title bar.
    in property <bool> window-bar: false;
    background: Theme.bg-deep;

    // ── What Rust tells it ──
    in property <string> file-name: "Untitled";
    in property <bool> modified: false;
    in property <[SheetRow]> rows: [];
    in property <[string]> col-names: [];
    in property <int> active-row: 0;
    in property <int> active-col: 0;
    in property <string> active-ref: "A1";
    in property <string> status-text: "";
    in property <bool> status-is-problem: false;
    in property <bool> can-undo: false;
    in property <bool> can-redo: false;

    // The formula bar's text: the selected cell's typed text, until the person changes it.
    in-out property <string> cell-data: "";

    // ── What it asks ──
    callback cell-clicked(int, int);
    // The typed text, and where the selection goes next: "down", "up", "right", "left", "stay".
    callback formula-submitted(string, string);
    // Escape: put the formula bar back to what the cell holds.
    callback formula-cancelled();
    // A header command: "open", "save", "save-as", "undo", "redo".
    callback command(string);

    // Put the typing cursor in the formula bar with its text selected, so typing replaces it.
    public function edit-cell() {
        formula-input.focus();
        formula-input.select-all();
    }

    VerticalLayout {
        AppHeader {
            z: 1;
            window-bar: root.window-bar;
            app-id: "spreadsheet";
            icon: Icons.sheets;
            title: "ySheets";
            subtitle: root.file-name;
            modified: root.modified;
            leading-actions: [
                { id: "open", icon: Icons.folder, label: "Open", tooltip: "Open a CSV file (Ctrl+O)" },
                { id: "save", icon: Icons.save, label: "Save", emphasis: 2, tooltip: "Save (Ctrl+S)" },
                { id: "save-as", label: "Save as", tooltip: "Save to another CSV file (Ctrl+Shift+S)" },
                { id: "undo", icon: Icons.rotate-ccw, disabled: !root.can-undo, tooltip: root.can-undo ? "Undo (Ctrl+Z)" : "Nothing to undo" },
                { id: "redo", icon: Icons.rotate-cw, disabled: !root.can-redo, tooltip: root.can-redo ? "Redo (Ctrl+Y)" : "Nothing to redo" },
            ];
            action(id) => { root.command(id); }
        }

        // ── Formula bar ──
        Rectangle {
            height: 40px;
            background: Theme.bg-surface;
            HorizontalLayout {
                padding: 4px;
                padding-left: 8px;
                padding-right: 8px;
                spacing: 8px;
                Rectangle {
                    width: 64px;
                    border-radius: 4px;
                    background: Theme.bg-card;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    Text {
                        text: root.active-ref;
                        font-size: Theme.fs-body;
                        font-weight: 700;
                        color: AppIdentity.accent;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "fx";
                    font-italic: true;
                    font-weight: 600;
                    color: Theme.text-secondary;
                    vertical-alignment: center;
                }
                Rectangle {
                    border-radius: 4px;
                    background: Theme.bg-deep;
                    border-width: 1px;
                    border-color: formula-input.has-focus ? AppIdentity.accent : Theme.border-subtle;
                    clip: true;
                    keys := FocusScope {
                        // Keys that move the selection are taken before the text field sees them;
                        // everything else is typing.
                        capture-key-pressed(event) => {
                            if (event.modifiers.control) {
                                if (event.text == "z" && !event.modifiers.shift) { root.command("undo"); return accept; }
                                if (event.text == "y" || (event.text == "Z") || (event.text == "z" && event.modifiers.shift)) { root.command("redo"); return accept; }
                                if (event.text == "s" && !event.modifiers.shift) { root.command("save"); return accept; }
                                if (event.text == "S" || (event.text == "s" && event.modifiers.shift)) { root.command("save-as"); return accept; }
                                if (event.text == "o") { root.command("open"); return accept; }
                                return reject;
                            }
                            if (event.text == Key.Return) { root.formula-submitted(root.cell-data, event.modifiers.shift ? "up" : "down"); formula-input.select-all(); return accept; }
                            if (event.text == Key.Tab) { root.formula-submitted(root.cell-data, "right"); formula-input.select-all(); return accept; }
                            if (event.text == Key.Backtab) { root.formula-submitted(root.cell-data, "left"); formula-input.select-all(); return accept; }
                            if (event.text == Key.UpArrow) { root.formula-submitted(root.cell-data, "up"); formula-input.select-all(); return accept; }
                            if (event.text == Key.DownArrow) { root.formula-submitted(root.cell-data, "down"); formula-input.select-all(); return accept; }
                            if (event.text == Key.Escape) { root.formula-cancelled(); formula-input.select-all(); return accept; }
                            reject
                        }
                        formula-input := TextInput {
                            x: 8px;
                            width: parent.width - 16px;
                            height: parent.height;
                            text <=> root.cell-data;
                            single-line: true;
                            font-size: Theme.fs-caption;
                            color: Theme.text-primary;
                            vertical-alignment: center;
                        }
                    }
                }
            }
        }
        Rectangle { height: 1px; background: Theme.separator; }

        // ── Grid ──
        // Rows are a ListView, so only the rows in view are drawn: a 10,000-row CSV opens as fast
        // as a 50-row one. The column header scrolls sideways with the rows.
        Rectangle {
            clip: true;
            VerticalLayout {
                Rectangle {
                    height: 28px;
                    HorizontalLayout {
                        x: list.viewport-x;
                        width: 48px + root.col-names.length * 100px;
                        Rectangle { width: 48px; background: Theme.bg-elevated; border-width: 1px; border-color: Theme.border-subtle; }
                        for name[c] in root.col-names : HeaderCell { label: name; active: c == root.active-col; }
                    }
                }
                list := ListView {
                    viewport-width: max(self.visible-width, 48px + root.col-names.length * 100px);
                    for row[r] in root.rows : HorizontalLayout {
                        height: 28px;
                        Rectangle {
                            width: 48px;
                            background: r == root.active-row ? Theme.bg-card : Theme.bg-elevated;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            Text {
                                text: r + 1;
                                font-size: Theme.fs-caption;
                                font-weight: r == root.active-row ? 700 : 600;
                                color: r == root.active-row ? AppIdentity.accent : Theme.text-secondary;
                                horizontal-alignment: center;
                                vertical-alignment: center;
                            }
                        }
                        for cell[c] in row.cells : CellView {
                            cell: cell;
                            selected: r == root.active-row && c == root.active-col;
                            clicked => {
                                root.cell-clicked(r, c);
                                root.edit-cell();
                            }
                        }
                        Rectangle {}
                    }
                }
            }
        }

        // ── Status line ──
        Rectangle { height: 1px; background: Theme.separator; }
        Rectangle {
            height: 30px;
            background: root.status-is-problem ? Theme.color-warning-dim : Theme.bg-surface;
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 12px;
                Text {
                    text: root.status-text;
                    font-size: Theme.fs-caption;
                    color: root.status-is-problem ? Theme.color-warning : Theme.text-secondary;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }
    }
}
