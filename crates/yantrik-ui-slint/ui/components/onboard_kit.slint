// The controls first-run screens are built from: the pill button and the labelled text field.
//
// They lived privately inside onboarding.slint. The installer became a screen of its own
// (installer.slint) and needs the same two controls, and a second private copy is how two
// screens that are meant to look like one flow start to drift.
//
// Colour: a focused field is the accent, not teal; teal is only for minds (colour system).

import { Theme } from "theme.slint";
import { YButton } from "y_button.slint";

// ── Pill button ───────────────────────────────────────────────────
//
// Not a button of its own any more: the kit's YButton in the shell's three kinds, kept under
// this name so the first-run screens' call sites did not have to move. `quiet` is the secondary
// action beside a primary one (Back, Try it first); `destructive` is for the step that erases
// something (the installer's "Erase disk and install").

export component PillButton inherits Rectangle {
    in property <string> label;
    in property <bool> enabled: true;
    in property <bool> quiet: false;
    in property <bool> destructive: false;
    callback clicked();

    width: 160px;
    height: 42px;

    YButton {
        width: parent.width;
        height: parent.height;
        size: 2;
        label: root.label;
        variant: root.destructive ? 3 : root.quiet ? 1 : 0;
        disabled: !root.enabled;
        clicked => { root.clicked(); }
    }
}

// ── Text field ────────────────────────────────────────────────────

export component OnboardField inherits Rectangle {
    in property <string> placeholder;
    in-out property <string> value;
    in property <color> text-color: Theme.text-primary;
    in property <bool> is-password: false;
    // A password field the person has asked to see. Kept apart from `is-password` so the
    // field still knows it holds a secret while it is shown.
    in property <bool> reveal: false;
    in property <string> label: "";
    // Said under the field in the warning colour, and the border turns with it. Empty when the
    // value is fine — or when it is too early to complain, which the screen decides.
    in property <string> error: "";
    // Said under the field in the quiet colour when there is no error: what the value is for.
    in property <string> hint: "";
    // Typed into by the person, as opposed to changed by a binding. The installer uses it to
    // stop deriving a username once the person has written their own.
    callback edited(string);
    // Enter in the field.
    callback accepted();

    width: 340px;
    height: layout.preferred-height;

    public function focus-field() { field-input.focus(); }

    layout := VerticalLayout {
        spacing: 4px;

        // Label above field
        if root.label != "" : Text {
            text: root.label;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            letter-spacing: 0.5px;
        }

        Rectangle {
            height: 44px;
            border-radius: Theme.r-xl;
            background: Theme.bg-input;
            border-width: 1px;
            border-color: root.error != "" ? Theme.amber
                : field-input.has-focus ? Theme.accent : Theme.border-default;
            clip: true;
            animate border-color { duration: Theme.dur-normal; }
            drop-shadow-blur: field-input.has-focus ? 6px : 0;
            drop-shadow-color: Theme.accent.transparentize(80%);
            animate drop-shadow-blur { duration: Theme.dur-normal; }

            TouchArea {
                clicked => { field-input.focus(); }
            }

            // Placeholder text
            if root.value == "" && !field-input.has-focus : Text {
                x: 16px;
                width: parent.width - 32px;
                height: parent.height;
                text: root.placeholder;
                color: Theme.text-dim;
                font-size: Theme.fs-body;
                vertical-alignment: center;
                opacity: 0.5;
            }

            field-input := TextInput {
                x: 16px;
                y: 0;
                width: parent.width - 32px;
                height: parent.height;
                text <=> root.value;
                color: root.text-color;
                font-size: Theme.fs-body;
                vertical-alignment: center;
                single-line: true;
                input-type: root.is-password && !root.reveal ? InputType.password : InputType.text;
                selection-background-color: Theme.accent.transparentize(60%);
                edited => { root.edited(self.text); }
                accepted => { root.accepted(); }
            }
        }

        if root.error != "" : Text {
            text: root.error;
            color: Theme.amber;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        if root.error == "" && root.hint != "" : Text {
            text: root.hint;
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
    }
}
