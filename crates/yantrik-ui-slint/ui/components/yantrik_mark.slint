// ═══════════════════════════════════════════════════════════════════════════════════════
// yantrik_mark.slint — the product's face
// ═══════════════════════════════════════════════════════════════════════════════════════
//
// The mark is not drawn here. It is brand/yantrik-emblem.svg and brand/yantrik-mark.svg,
// both generated by brand/build.py, embedded at build time and rendered by the resvg that
// Slint already ships. This file only picks which of the two a size calls for, so the boot
// screen, login, the status bar and About show exactly what the brand directory says, at any
// size, and a change to the mark is a change to one script.
//
// Two levels of one drawing, not two logos: above 64 px the full emblem (gates, gear, yantra,
// the Y, the bindu); at 64 px and below the core (the Y, its channels and the bindu), because
// the fine lines of the full emblem turn to noise at a status-bar size.
//
// # Why this is not the orb
//
// The companion's Orb pulses when the mind thinks and brightens when it speaks: a status
// indicator. The thing that means "this is Yantrik OS" has to be the same every time it is
// seen. A logo that animates is not a logo, it is a widget, so the Orb stays where it means
// "someone is here" (lock, onboarding) and is never used as the product mark.

export component YantrikMark inherits Rectangle {
    in property <length> mark-size: 128px;

    width: root.mark-size;
    height: root.mark-size;

    Image {
        width: 100%;
        height: 100%;
        image-fit: contain;
        source: root.mark-size > 64px
            ? @image-url("../../../../brand/yantrik-emblem.svg")
            : @image-url("../../../../brand/yantrik-mark.svg");
    }
}

// "YANTRIK OS" as the brand sets it: brand/yantrik-name.svg, outlined Marcellus. Never set in
// a UI font — the name is part of the mark. `cap-height` is the height of the capitals; the
// image carries clear space above and below them.
export component YantrikName inherits Image {
    in property <length> cap-height: 32px;

    source: @image-url("../../../../brand/yantrik-name.svg");
    image-fit: contain;
    // The SVG is 80 units tall with 64-unit capitals.
    height: root.cap-height * 80 / 64;
    width: self.height * self.source.width / self.source.height;
}
