// Quick Settings, right-anchored under the bar's settings mark.
//
// Laid out like the reference render (design/renders/01): the minds first (Mind mode, Private,
// Mind View), then the machine (network, Do Not Disturb, Dark style, Power mode, Bluetooth), the
// two sliders, and a footer (battery, Screenshot, Settings, Lock, Power). Every control is a kit
// control: YToggleTile for the tiles (a split tile's body and its chevron are separate targets),
// YSlider for the levels, YIndicator for the footer.
//
// Nothing is invented. A control for hardware or a service that is not there is not drawn, and the
// rest close up: a VM has no battery and no backlight, so it has neither the battery text nor the
// brightness slider; a machine with no power-profiles-daemon has no Power mode tile; Bluetooth is
// drawn only when `bluetooth-present` says an adapter exists (nothing sets it yet: the Bluetooth
// story, PR 2.3, wires it).
//
// Each tile's subtitle is the true state in words, taken from the same properties the bar and the
// settings read. A tile's `on` is the real state; pressing says `toggled` and the owner changes the
// real thing, so the tile can never show a state the machine is not in. A lit tile is a switch, so
// its subtitle is that switch's state, never a description: Mind View is the setting "a mind's
// apps open in a view of their own" (not a place to go), so it says On or Off.
//
// Under the volume slider, the output it moves, named as the audio server names it (wire/audio.rs);
// nothing when the server gives no name. The footer buttons are YIndicators, so each says what it
// is in the kit's YTooltip on hover and to assistive tech.
//
// Keyboard. Arrow keys move between controls (Down and Right go on, Up and Left go back), Space or
// Enter presses the focused one, Esc closes. A split tile's chevron is reached with Tab. A slider
// uses the arrows for its own level, so Tab leaves it. Opening starts with nothing focused; the
// first arrow lands on the first control.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { YPopover } from "y_popover.slint";
import { QsTile, QsSlider, QsFooterButton } from "quick_settings_parts.slint";

export component QuickSettings inherits YPopover {
    // Minds
    in property <string> mind-mode: "ask";
    in property <string> mind-mode-label: "Ask";
    in property <bool> private-mode: false;
    in property <bool> mind-view-on: true;
    callback mind-mode-chosen(string);
    callback mind-mode-details();
    callback private-chosen(bool);
    callback mind-view-chosen(bool);

    // Network: a Wi-Fi tile where there is a Wi-Fi device, otherwise a Wired tile for a live
    // cable, otherwise nothing.
    in property <bool> wifi-present: false;
    in property <bool> wifi-radio-on: false;
    in property <bool> wifi-connected: false;
    in property <string> wifi-ssid: "";
    in property <bool> wired-online: false;
    callback toggle-wifi();
    callback network-details();

    // The machine
    in property <bool> dnd-on: false;
    in property <bool> dark-on: true;
    // "" when there is no power-profiles-daemon.
    in property <string> power-profile: "";
    in property <bool> power-performance-offered: false;
    in property <bool> bluetooth-present: false;
    in property <bool> bluetooth-on: false;
    callback toggle-dnd();
    callback toggle-dark();
    callback power-profile-chosen(string);
    callback toggle-bluetooth();
    callback bluetooth-details();

    // The machine's real levels. A row for hardware that is not there is not drawn.
    in property <bool> brightness-available: false;
    in-out property <int> brightness-level: 0;
    in property <bool> volume-available: false;
    in property <bool> volume-muted: false;
    in-out property <int> volume-level: 0;
    // "" when the audio server names no output: then no line is drawn, rather than a guess.
    in property <string> volume-device: "";
    callback brightness-changed(int);
    callback volume-changed(int);
    callback volume-mute-toggled();

    // Footer
    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <bool> battery-charging: false;
    callback screenshot();
    callback settings();
    callback lock();
    callback power();

    label: "Quick Settings";
    content-spacing: Theme.sp-3;

    // ── Which control is current (the arrow keys' cursor) ──
    // Slots: 0 Mind mode, 1 Private, 2 Mind View, 3 network, 4 Do Not Disturb, 5 Dark style,
    // 6 Power mode, 7 Bluetooth, 8 volume, 9 brightness, 10 Screenshot, 11 Settings, 12 Lock, 13 Power.
    in-out property <int> cursor: -1;
    changed open => { if (self.open) { self.cursor = -1; } }

    property <bool> net-shown: root.wifi-present || root.wired-online;
    property <bool> power-mode-shown: root.power-profile != "";
    pure function present(i: int) -> bool {
        i == 3 ? root.net-shown
        : i == 6 ? root.power-mode-shown
        : i == 7 ? root.bluetooth-present
        : i == 8 ? root.volume-available
        : i == 9 ? root.brightness-available
        : true
    }
    // Slint has no loops: the next and previous present slot are an unrolled chain.
    pure function next-from(c: int) -> int {
        (c + (1)) >= 0 && (c + (1)) < 14 && root.present(c + (1)) ? c + (1) : (c + (2)) >= 0 && (c + (2)) < 14 && root.present(c + (2)) ? c + (2) : (c + (3)) >= 0 && (c + (3)) < 14 && root.present(c + (3)) ? c + (3) : (c + (4)) >= 0 && (c + (4)) < 14 && root.present(c + (4)) ? c + (4) : (c + (5)) >= 0 && (c + (5)) < 14 && root.present(c + (5)) ? c + (5) : (c + (6)) >= 0 && (c + (6)) < 14 && root.present(c + (6)) ? c + (6) : (c + (7)) >= 0 && (c + (7)) < 14 && root.present(c + (7)) ? c + (7) : (c + (8)) >= 0 && (c + (8)) < 14 && root.present(c + (8)) ? c + (8) : (c + (9)) >= 0 && (c + (9)) < 14 && root.present(c + (9)) ? c + (9) : (c + (10)) >= 0 && (c + (10)) < 14 && root.present(c + (10)) ? c + (10) : (c + (11)) >= 0 && (c + (11)) < 14 && root.present(c + (11)) ? c + (11) : (c + (12)) >= 0 && (c + (12)) < 14 && root.present(c + (12)) ? c + (12) : (c + (13)) >= 0 && (c + (13)) < 14 && root.present(c + (13)) ? c + (13) : (c + (14)) >= 0 && (c + (14)) < 14 && root.present(c + (14)) ? c + (14) : c
    }
    pure function prev-from(c: int) -> int {
        (c + (-1)) >= 0 && (c + (-1)) < 14 && root.present(c + (-1)) ? c + (-1) : (c + (-2)) >= 0 && (c + (-2)) < 14 && root.present(c + (-2)) ? c + (-2) : (c + (-3)) >= 0 && (c + (-3)) < 14 && root.present(c + (-3)) ? c + (-3) : (c + (-4)) >= 0 && (c + (-4)) < 14 && root.present(c + (-4)) ? c + (-4) : (c + (-5)) >= 0 && (c + (-5)) < 14 && root.present(c + (-5)) ? c + (-5) : (c + (-6)) >= 0 && (c + (-6)) < 14 && root.present(c + (-6)) ? c + (-6) : (c + (-7)) >= 0 && (c + (-7)) < 14 && root.present(c + (-7)) ? c + (-7) : (c + (-8)) >= 0 && (c + (-8)) < 14 && root.present(c + (-8)) ? c + (-8) : (c + (-9)) >= 0 && (c + (-9)) < 14 && root.present(c + (-9)) ? c + (-9) : (c + (-10)) >= 0 && (c + (-10)) < 14 && root.present(c + (-10)) ? c + (-10) : (c + (-11)) >= 0 && (c + (-11)) < 14 && root.present(c + (-11)) ? c + (-11) : (c + (-12)) >= 0 && (c + (-12)) < 14 && root.present(c + (-12)) ? c + (-12) : (c + (-13)) >= 0 && (c + (-13)) < 14 && root.present(c + (-13)) ? c + (-13) : (c + (-14)) >= 0 && (c + (-14)) < 14 && root.present(c + (-14)) ? c + (-14) : c
    }
    key-unhandled(event) => {
        if (!root.open) { return reject; }
        if (event.text == Key.DownArrow || event.text == Key.RightArrow) { root.cursor = root.next-from(root.cursor); return accept; }
        if (event.text == Key.UpArrow || event.text == Key.LeftArrow) { root.cursor = root.prev-from(root.cursor); return accept; }
        reject
    }

    // ── Words ──
    property <string> mode-words: root.mind-mode-label;
    property <string> wifi-words: !root.wifi-radio-on ? "Off" : root.wifi-connected && root.wifi-ssid != "" ? root.wifi-ssid : "Not connected";
    property <string> profile-words: root.power-profile == "power-saver" ? "Power saver"
        : root.power-profile == "performance" ? "Performance" : "Balanced";
    // Balanced is the daemon's ordinary state; the tile is lit when the person has moved off it.
    property <string> next-profile: root.power-profile == "balanced" ? "power-saver"
        : root.power-profile == "power-saver" && root.power-performance-offered ? "performance" : "balanced";

    // Private's tile is this wide and Mind mode's takes the rest of the row.
    property <length> private-w: 136px;

    // ── Minds ──
    HorizontalLayout {
        height: Theme.sp-4;
        spacing: Theme.sp-2;
        // Teal is the minds' colour and nothing else's (the colour roles in the minds spec).
        Rectangle {
            width: Theme.sp-2 - 2px;
            height: self.width;
            y: (parent.height - self.height) / 2;
            border-radius: self.width / 2;
            background: Theme.cyan;
        }
        Text {
            text: "Minds";
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            font-weight: Theme.fw-body-strong;
            vertical-alignment: center;
        }
    }
    Rectangle {
        height: 2 * Theme.tile-h + Theme.sp-2;
        // Mind mode's name and its chevron need more room than Private's, so the pair is 184 and
        // the rest, not half and half.
        QsTile {
            slot: 0; cursor: root.cursor;
            x: 0; y: 0; width: parent.width - self.x - Theme.sp-2 - root.private-w;
            icon: Icons.spark;
            title: "Mind mode";
            subtitle: root.mode-words;
            // Lit when the minds may only look. The body steps between Plan and Ask, never
            // upward; the chevron opens the full choice (Auto and the bypasses need their own
            // confirmation there).
            on: root.mind-mode == "plan";
            split: true;
            toggled => { root.mind-mode-chosen(root.mind-mode == "plan" ? "ask" : "plan"); }
            details-requested => { root.mind-mode-details(); }
            focus-arrived(s) => { root.cursor = s; }
        }
        QsTile {
            slot: 1; cursor: root.cursor;
            x: parent.width - self.width; y: 0; width: root.private-w;
            icon: Icons.shield;
            title: "Private";
            // What it stops, as private_mode::enforce enforces it (review by GPT-6 Astra, D):
            // every turn to every mind is refused and the agents are frozen, and the event log,
            // the clipboard, activity and screen watchers record nothing. The tile has room for
            // the first half; the sentence is its description.
            subtitle: root.private-mode ? "Minds paused" : "Off";
            description: "While on, no mind is sent anything, agents this desktop runs are frozen, and the event log, clipboard, activity and screen watchers record nothing.";
            on: root.private-mode;
            toggled => { root.private-chosen(!root.private-mode); }
            focus-arrived(s) => { root.cursor = s; }
        }
        QsTile {
            slot: 2; cursor: root.cursor;
            x: 0; y: Theme.tile-h + Theme.sp-2; width: parent.width;
            icon: Icons.eye;
            title: "Mind View";
            subtitle: root.mind-view-on ? "On" : "Off";
            on: root.mind-view-on;
            toggled => { root.mind-view-chosen(!root.mind-view-on); }
            focus-arrived(s) => { root.cursor = s; }
        }
    }

    // ── The machine: a two-column flow that closes up around what is absent ──
    property <int> i-net: 0;
    property <int> i-dnd: root.net-shown ? 1 : 0;
    property <int> i-dark: root.i-dnd + 1;
    property <int> i-power: root.i-dark + 1;
    property <int> i-bt: root.i-power + (root.power-mode-shown ? 1 : 0);
    property <int> flow-count: root.i-bt + (root.bluetooth-present ? 1 : 0);
    property <int> flow-rows: Math.floor((root.flow-count + 1) / 2);
    Rectangle {
        height: root.flow-rows * Theme.tile-h + (root.flow-rows - 1) * Theme.sp-2;
        property <length> col-w: (self.width - Theme.sp-2) / 2;
        pure function col-x(i: int) -> length { mod(i, 2) == 0 ? 0px : self.col-w + Theme.sp-2 }
        pure function row-y(i: int) -> length { Math.floor(i / 2) * (Theme.tile-h + Theme.sp-2) }

        if root.net-shown : QsTile {
            slot: 3; cursor: root.cursor;
            x: parent.col-x(root.i-net); y: parent.row-y(root.i-net); width: parent.col-w;
            icon: root.wifi-present ? Icons.wifi : Icons.network;
            title: root.wifi-present ? "Wi-Fi" : "Wired";
            subtitle: root.wifi-present ? root.wifi-words : "Connected";
            on: root.wifi-present && root.wifi-radio-on;
            split: true;
            // A cable has no switch: its body opens the same list as its chevron.
            toggled => { if (root.wifi-present) { root.toggle-wifi(); } else { root.network-details(); } }
            details-requested => { root.network-details(); }
            focus-arrived(s) => { root.cursor = s; }
        }
        QsTile {
            slot: 4; cursor: root.cursor;
            x: parent.col-x(root.i-dnd); y: parent.row-y(root.i-dnd); width: parent.col-w;
            icon: Icons.moon;
            title: "Do Not Disturb";
            subtitle: root.dnd-on ? "On" : "Off";
            on: root.dnd-on;
            toggled => { root.toggle-dnd(); }
            focus-arrived(s) => { root.cursor = s; }
        }
        QsTile {
            slot: 5; cursor: root.cursor;
            x: parent.col-x(root.i-dark); y: parent.row-y(root.i-dark); width: parent.col-w;
            icon: Icons.contrast;
            title: "Dark style";
            subtitle: root.dark-on ? "On" : "Off";
            on: root.dark-on;
            toggled => { root.toggle-dark(); }
            focus-arrived(s) => { root.cursor = s; }
        }
        if root.power-mode-shown : QsTile {
            slot: 6; cursor: root.cursor;
            x: parent.col-x(root.i-power); y: parent.row-y(root.i-power); width: parent.col-w;
            icon: Icons.bolt;
            title: "Power mode";
            subtitle: root.profile-words;
            on: root.power-profile != "balanced";
            toggled => { root.power-profile-chosen(root.next-profile); }
            focus-arrived(s) => { root.cursor = s; }
        }
        if root.bluetooth-present : QsTile {
            slot: 7; cursor: root.cursor;
            x: parent.col-x(root.i-bt); y: parent.row-y(root.i-bt); width: parent.col-w;
            icon: Icons.bluetooth;
            title: "Bluetooth";
            subtitle: root.bluetooth-on ? "On" : "Off";
            on: root.bluetooth-on;
            split: true;
            toggled => { root.toggle-bluetooth(); }
            details-requested => { root.bluetooth-details(); }
            focus-arrived(s) => { root.cursor = s; }
        }
    }

    // ── Levels ──
    if root.volume-available : VerticalLayout {
        spacing: Theme.sp-1;
        Rectangle {
            height: Theme.h-regular;
            QsSlider {
                slot: 8; cursor: root.cursor;
                width: 100%;
                label: "Volume";
                icon: root.volume-muted ? Icons.volume-off : Icons.volume;
                value: root.volume-level;
                changed(v) => { root.volume-level = v; root.volume-changed(v); }
                focus-arrived(s) => { root.cursor = s; }
            }
            // The speaker mutes, as the media key does. Over the slider's icon only: the track starts
            // to its right.
            TouchArea {
                x: 0; y: 0;
                width: Theme.bar-icon-size + Theme.sp-2;
                height: parent.height;
                mouse-cursor: pointer;
                accessible-role: button;
                accessible-label: root.volume-muted ? "Unmute" : "Mute";
                accessible-action-default => { root.volume-mute-toggled(); }
                clicked => { root.volume-mute-toggled(); }
            }
        }
        // The output the slider moves, lined up under the track (YSlider's track-x).
        if root.volume-device != "" : HorizontalLayout {
            padding-left: Theme.bar-icon-size + Theme.sp-3;
            Text {
                text: root.volume-device;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                overflow: elide;
                accessible-role: text;
                accessible-label: "Output: " + root.volume-device;
            }
        }
    }
    if root.brightness-available : QsSlider {
        slot: 9; cursor: root.cursor;
        label: "Brightness";
        icon: Icons.sun;
        value: root.brightness-level;
        changed(v) => { root.brightness-level = v; root.brightness-changed(v); }
        focus-arrived(s) => { root.cursor = s; }
    }

    // ── Footer ──
    Rectangle { height: Theme.hairline; background: Theme.separator; }
    HorizontalLayout {
        height: Theme.h-regular;
        spacing: Theme.sp-1;
        if root.battery-available : HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.sp-2;
            alignment: start;
            Icon {
                commands: Icons.battery;
                size: Theme.bar-icon-size;
                tint: Theme.text-secondary;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: root.battery-level + "%" + (root.battery-charging ? " · Charging" : "");
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                vertical-alignment: center;
            }
        }
        if !root.battery-available : Rectangle { horizontal-stretch: 1; }
        QsFooterButton { slot: 10; cursor: root.cursor; icon: Icons.screenshot; label: "Screenshot"; clicked => { root.screenshot(); } focus-arrived(s) => { root.cursor = s; } }
        QsFooterButton { slot: 11; cursor: root.cursor; icon: Icons.settings; label: "Settings"; clicked => { root.settings(); } focus-arrived(s) => { root.cursor = s; } }
        QsFooterButton { slot: 12; cursor: root.cursor; icon: Icons.lock; label: "Lock"; clicked => { root.lock(); } focus-arrived(s) => { root.cursor = s; } }
        QsFooterButton { slot: 13; cursor: root.cursor; icon: Icons.power; label: "Power"; clicked => { root.power(); } focus-arrived(s) => { root.cursor = s; } }
    }
}
