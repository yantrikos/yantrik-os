// StatusBar — the whole machine on one 32px line.
//
// 3-zone layout: Left (AI dot + project) | Center (AI context lane) | Right (load, model,
// network, badges, power, clock+date).
//
// Two rules this file follows that its predecessor did not:
//   1. No emoji. Every glyph is a stroke Icon, so it scales, recolours, and does not depend
//      on whichever emoji font the host happens to have.
//   2. Nothing below 11px. The old bar set its most important labels at 8px and 9px, which
//      reads as decoration rather than information. A status bar is read in a glance from
//      arm's length; Theme.fs-micro (11px) is the floor.
//
// No continuous animation. The thinking pulse is the only motion and it runs only while
// the companion is actually thinking.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { YantrikMark } from "yantrik_mark.slint";

export component StatusBar inherits Rectangle {
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> companion-status: "idle";       // idle, thinking, listening
    in property <bool> companion-online: true;
    // #30: the one visible line about an assistant with no model. Non-empty only while
    // the backend is unreachable; the chip's click goes to Settings → AI. Set from Rust
    // (`assistant_offline_notice` in bridge.rs), cleared when a model answers again.
    in property <string> assistant-offline-notice: "";
    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <bool> battery-charging: false;
    /// Whether anything is up, and over what. Not `wifi-connected`: the bar's
    /// one network mark meant "am I online", and drawing it from the wireless
    /// flag dimmed it on a wired machine that was online the whole time.
    in property <bool> network-online: false;
    in property <string> network-medium: "";
    in property <int> pending-count: 0;
    in property <int> whisper-hint-count: 0;
    // Unread notifications, from the one notification store. The status bar is the only thing
    // on screen from every app, so it is where "something happened while you were elsewhere"
    // has to be visible.
    in property <int> notification-unread: 0;
    in property <bool> incognito-enabled: false;
    in property <bool> dnd-enabled: false;
    in property <string> active-project: "";
    // V61 — AI privacy indicator
    in property <string> ai-privacy-mode: "local";       // "local", "cloud", "hybrid"
    in property <string> ai-provider-label: "";
    /// True when an attached mind is answering rather than the built-in companion.
    in property <bool> harness-driving: false;
    in property <string> ai-fallback-banner: "";
    // V63 — AI context lane
    in property <string> ai-context-text: "";
    // Load readout — set from Rust on every observer poll, regardless of screen
    in property <int> cpu-percent: 0;
    in property <string> mem-text: "";

    callback anchor-clicked();
    callback queue-clicked();
    callback whisper-hint-clicked();
    callback notifications-clicked();
    callback settings-tapped();
    callback power-pressed();
    callback ai-privacy-clicked();
    callback assistant-offline-clicked();

    // Which mind is answering. Empty or "companion" means the built-in one.
    in property <string> active-harness-id: "";
    in property <string> active-harness-name: "";
    callback active-mind-clicked();

    // What that mind may do without being asked: plan | ask | auto | bypass. The label carries
    // the countdown during a bypass ("Bypass 43m"). See components/mind_mode_menu.slint.
    in property <string> mind-mode: "ask";
    in property <string> mind-mode-label: "Ask";
    callback mind-mode-clicked();

    height: Theme.status-bar-height;
    // Glass, not paint. This bar is drawn over the wallpaper on every screen, and an
    // opaque fill turned the top 32px of the desktop into a lid.
    background: Theme.glass-panel;

    // Bottom border — single subtle line
    Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.separator;
    }

    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;

        // ── LEFT ZONE: AI dot + Project context ──
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.sp-3;
            alignment: start;

            // ── The mark ──
            //
            // The bar said "Yantrik" in 14px semibold beside a 6px dot, and that was the whole
            // of the brand on the one surface drawn over every screen this OS has. The mark
            // goes first, at 20px in a 32px bar, which is where the eye starts on a status bar
            // and where every other desktop puts the thing that names the machine.
            //
            // Order is mark, dot, word — not mark, word, dot — because the dot is the
            // companion's state and it belongs against the name it is the state OF, exactly
            // where it already was. Nothing about the dot changes: same size, same colours,
            // same 24px TouchArea opening the anchor. Reading "Yantrik" now costs one glyph
            // less of work, because the shape in front of it already said it.
            //
            // Cost to the layout: ~32px (mark + one sp-3) added to the left zone. All three
            // zones carry horizontal-stretch: 1, so the centre lane is positioned by the
            // stretch and not by the left zone's content — it does not move. The left zone
            // itself only ever held a dot, a word and an optional project chip, so there is
            // room at every width the bar supports.
            YantrikMark {
                mark-size: 20px;
                y: (parent.height - self.height) / 2;
            }

            // AI status dot — 6px, state-coloured; the only thing on the bar that ever moves
            TouchArea {
                width: 24px;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.anchor-clicked(); }

                Rectangle {
                    x: (parent.width - 6px) / 2;
                    y: (parent.height - 6px) / 2;
                    width: 6px;
                    height: 6px;
                    border-radius: 3px;
                    background: !root.companion-online ? Theme.color-danger
                              : root.companion-status == "thinking" ? Theme.accent
                              : root.companion-status == "listening" ? Theme.accent-light
                              : Theme.text-dim;

                    // The dot breathes while a mind is working. This is what that cost.
                    //
                    // It was an `animate ai-pulse-opacity { duration: 2000ms; }` with a 2000ms
                    // Timer flipping that same opacity between 0.5 and 1.0. Each tick restarted
                    // the animation exactly as it finished, so it was never not animating — and
                    // a window with an animation in flight redraws at the display's rate, which
                    // on this shell is a full-screen repaint costing ~96ms of CPU. For a 6px dot.
                    //
                    // Measured headless on this markup, a mind thinking and the Intent Lens
                    // CLOSED: 236 frames a second before, 5 after. On the machine that was
                    // `yantrik-ui` at 83% of a core with labwc at 20% beside it, for as long as a
                    // job took, against 2.0% four minutes later with the mind idle (#68).
                    //
                    // Stepping the phase draws the same breath: ten steps through a two-second
                    // cycle, five frames a second, and nothing in flight between them.
                    opacity: root.companion-status == "thinking" ? ai-pulse-opacity : 1.0;
                    property <float> ai-pulse-phase: 0;
                    property <float> ai-pulse-opacity: 0.55
                        + 0.45 * sin(ai-pulse-phase * 6.2832 * 1rad);
                    Timer {
                        interval: 200ms;
                        running: root.companion-status == "thinking";
                        triggered => {
                            parent.ai-pulse-phase = mod(parent.ai-pulse-phase + 0.1, 1.0);
                        }
                    }

                    animate background { duration: Theme.dur-normal; }
                }
            }

            Text { text: "Yantrik"; font-size: Theme.fs-body; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; }

            // ── No model to answer with ──
            //
            // #30: the desktop had no model all day and never said so — the bar's only trace
            // was the 6px red dot, and the rest went to 450+ log lines nobody reads. This chip
            // is the one persistent visible line naming the failure and the way out of it:
            // the click goes to Settings → AI, where a model gets set up. It hides itself the
            // moment a model answers again.
            if root.assistant-offline-notice != "" : TouchArea {
                width: min(notice-row.preferred-width + Theme.sp-3, 340px);
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.assistant-offline-clicked(); }

                Rectangle {
                    width: parent.width;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: Theme.r-sm;
                    background: Theme.color-danger-dim;
                    border-width: 1px;
                    border-color: Theme.color-danger;

                    notice-row := HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 5px;
                        alignment: center;

                        Icon {
                            commands: Icons.warning;
                            size: 12px;
                            tint: Theme.color-danger;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.assistant-offline-notice;
                            max-width: 300px; overflow: elide;
                            color: Theme.color-danger;
                            font-size: Theme.fs-micro;
                            font-weight: 700;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Project indicator
            if root.active-project != "" && root.width >= 1000px : Rectangle {
                width: proj-text.preferred-width + Theme.sp-3;
                height: 20px;
                y: (Theme.status-bar-height - self.height) / 2;
                border-radius: self.height / 2;
                background: Theme.tint-accent;
                border-width: 1px;
                border-color: Theme.border-subtle;

                proj-text := Text {
                    text: root.active-project;
                    color: Theme.accent;
                    font-size: Theme.fs-micro;
                    font-weight: Theme.fw-micro;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }

        // ── CENTER ZONE: AI context lane ──
        HorizontalLayout {
            horizontal-stretch: 1;
            alignment: center;

            if root.ai-context-text != "" && root.width >= 1200px : Text {
                text: root.ai-context-text;
                color: Theme.text-dim;
                font-size: Theme.fs-caption;
                font-weight: Theme.fw-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
                overflow: elide;
                max-width: 300px;
            }
        }

        // ── RIGHT ZONE: load | model | network | badges | power | clock ──
        HorizontalLayout {
            horizontal-stretch: 1;
            spacing: Theme.sp-3;
            alignment: end;

            // Detailed telemetry yields to essential controls on compact screens.
            if root.width >= 1100px : HorizontalLayout {
                spacing: Theme.sp-2;
                Text {
                    text: "CPU";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    font-weight: Theme.fw-micro;
                    vertical-alignment: center;
                }
                Text {
                    text: root.cpu-percent + "%";
                    color: root.cpu-percent >= 90 ? Theme.color-warning : Theme.text-secondary;
                    font-size: Theme.fs-micro;
                    font-weight: 500;
                    vertical-alignment: center;
                    min-width: 26px;
                }
                Text {
                    text: "MEM";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    font-weight: Theme.fw-micro;
                    vertical-alignment: center;
                }
                Text {
                    text: root.mem-text;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-micro;
                    font-weight: 500;
                    vertical-alignment: center;
                }
            }

            Rectangle { width: 1px; height: 14px; y: (parent.height - 14px) / 2; background: Theme.separator; }

            // ── What the mind may do without asking ──
            //
            // Always on the bar, unlike the mind chip beside it, and that is the point: the mode
            // is a fact about what this machine will let happen to it, and a person must never be
            // surprised by it. In `plan` they would otherwise only find out when the mind said it
            // could not do anything; in `bypass` they are owed a permanent, unmissable reminder
            // and a countdown, which is why the label carries the time left and this chip goes
            // red rather than accent-tinted.
            //
            // Immediately to the LEFT of the mind chip: the two answer the same question — who
            // is acting, and how freely — and they belong together.
            TouchArea {
                width: mode-row.preferred-width + Theme.sp-3;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.mind-mode-clicked(); }

                Rectangle {
                    width: parent.width;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: Theme.r-sm;
                    background: root.mind-mode == "bypass" ? Theme.color-danger-dim
                        : root.mind-mode == "plan" ? Theme.tint-amber
                        : Theme.hover-fill;
                    border-width: root.mind-mode == "bypass" ? 1px : 0px;
                    border-color: Theme.color-danger;

                    mode-row := HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 5px;
                        alignment: center;

                        Icon {
                            commands: root.mind-mode == "plan" ? Icons.eye : Icons.shield;
                            size: 12px;
                            tint: root.mind-mode == "bypass" ? Theme.color-danger
                                : root.mind-mode == "plan" ? Theme.amber
                                : Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.mind-mode-label;
                            max-width: 120px; overflow: elide;
                            color: root.mind-mode == "bypass" ? Theme.color-danger
                                : root.mind-mode == "plan" ? Theme.amber
                                : Theme.text-secondary;
                            font-size: Theme.fs-micro;
                            font-weight: root.mind-mode == "bypass" ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // ── Which mind is answering ──
            //
            // Shown ONLY when it is not the built-in one. On a machine using the companion this
            // badge would be noise — the companion is what "Yantrik" means here — but the moment
            // something else is answering, it is the most important thing in the bar, because
            // everything typed into the panel is going somewhere else. Costs nothing by default
            // and is impossible to miss when it matters.
            if root.active-harness-id != "" && root.active-harness-id != "companion" : TouchArea {
                width: mind-row.preferred-width + Theme.sp-3;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.active-mind-clicked(); }

                Rectangle {
                    width: parent.width;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: Theme.r-sm;
                    background: Theme.tint-accent;

                    mind-row := HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 5px;
                        alignment: center;

                        Icon {
                            commands: Icons.companion;
                            size: 12px;
                            tint: Theme.accent;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: root.active-harness-name;
                            max-width: 150px; overflow: elide;
                            color: Theme.accent;
                            font-size: Theme.fs-micro;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // AI privacy / model badge
            //
            // Hidden while an attached mind is answering, because every part of it is a
            // statement about the BUILT-IN companion: the lock icon is the shell's privacy
            // mode, the text is the shell's configured provider, and the click opens the
            // shell's provider switcher. With a harness driving, none of that is doing the
            // work — the bar showed "qwen3.5:9b" from a settings file, one chip away from
            // "Yantrik Mind", which was answering on a different model on a different machine.
            // Two badges side by side disagreeing about the model is worse than one badge.
            // The mind's own model is on the machine rail, where it says which mind it belongs
            // to; the chip to the left of this goes to the Harnesses screen.
            if !root.harness-driving : TouchArea {
                width: ai-priv-row.preferred-width + Theme.sp-3;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.ai-privacy-clicked(); }

                Rectangle {
                    width: parent.width;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: Theme.r-sm;
                    background: Theme.hover-fill;

                    ai-priv-row := HorizontalLayout {
                        padding-left: 7px;
                        padding-right: 7px;
                        spacing: 5px;
                        alignment: center;

                        Icon {
                            commands: root.ai-privacy-mode == "local" ? Icons.lock
                                    : root.ai-privacy-mode == "cloud" ? Icons.cloud
                                    : Icons.hybrid;
                            size: 12px;
                            tint: root.ai-privacy-mode == "local" ? Theme.color-success
                                : root.ai-privacy-mode == "cloud" ? Theme.holo-blue
                                : Theme.color-warning;
                            y: (parent.height - self.height) / 2;
                        }
                        // The model name when we know it; the mode when we do not
                        Text {
                            max-width: 150px; overflow: elide;
                            text: root.ai-provider-label != "" ? root.ai-provider-label
                                : root.ai-privacy-mode == "local" ? "Local"
                                : root.ai-privacy-mode == "cloud" ? "Cloud"
                                : "Hybrid";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-micro;
                            font-weight: 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Whisper hint badge
            if root.whisper-hint-count > 0 : TouchArea {
                width: whisper-badge.preferred-width + 4px;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.whisper-hint-clicked(); }

                whisper-badge := Rectangle {
                    width: max(20px, whisper-text.preferred-width + 10px);
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: self.height / 2;
                    background: Theme.accent-dim;

                    whisper-text := Text {
                        text: root.whisper-hint-count;
                        color: Theme.text-on-accent;
                        font-size: Theme.fs-micro;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Unread notifications — opens the notification centre
            if root.notification-unread > 0 : TouchArea {
                width: unread-badge.preferred-width + 4px;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.notifications-clicked(); }

                unread-badge := Rectangle {
                    width: max(20px, unread-text.preferred-width + 10px);
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: self.height / 2;
                    background: Theme.accent;

                    unread-text := Text {
                        text: root.notification-unread > 99 ? "99+" : root.notification-unread;
                        color: Theme.text-on-accent;
                        font-size: Theme.fs-micro;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Incognito badge
            if root.incognito-enabled : Rectangle {
                width: inc-text.preferred-width + 10px;
                height: 20px;
                y: (Theme.status-bar-height - 20px) / 2;
                border-radius: Theme.r-sm;
                background: Theme.color-danger-dim;

                inc-text := Text {
                    text: "INC";
                    color: Theme.color-danger;
                    font-size: Theme.fs-micro;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // DND badge
            if root.dnd-enabled : Rectangle {
                width: dnd-text.preferred-width + 10px;
                height: 20px;
                y: (Theme.status-bar-height - 20px) / 2;
                border-radius: Theme.r-sm;
                background: Theme.color-warning-dim;

                dnd-text := Text {
                    text: "DND";
                    color: Theme.color-warning;
                    font-size: Theme.fs-micro;
                    font-weight: 700;
                    letter-spacing: 0.5px;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }

            // Pending queue badge
            if root.pending-count > 0 : TouchArea {
                width: queue-badge.preferred-width + 4px;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.queue-clicked(); }

                queue-badge := Rectangle {
                    width: max(20px, queue-text.preferred-width + 10px);
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    border-radius: self.height / 2;
                    background: Theme.amber-dim;

                    queue-text := Text {
                        text: root.pending-count;
                        color: Theme.amber;
                        font-size: Theme.fs-micro;
                        font-weight: 700;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // Network + Battery → opens Quick Settings
            TouchArea {
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.settings-tapped(); }

                HorizontalLayout {
                    spacing: Theme.sp-2;

                    Icon {
                        // The mark says which medium as well as whether: the
                        // wireless arcs are wrong on a machine with no radio,
                        // and the Network Manager window already draws the
                        // globe for a wired connection.
                        commands: root.network-medium == "wifi" ? Icons.wifi : Icons.network;
                        size: 13px;
                        tint: root.network-online ? Theme.color-success : Theme.text-dim;
                        y: (parent.height - self.height) / 2;
                    }

                    // Battery (when hardware present)
                    if root.battery-available : HorizontalLayout {
                        spacing: 4px;

                        Rectangle {
                            width: 20px;
                            height: 10px;
                            y: (parent.height - 10px) / 2;
                            border-radius: 2px;
                            border-width: 1px;
                            border-color: root.battery-level <= 20 ? Theme.color-danger : Theme.text-dim;
                            background: transparent;

                            Rectangle {
                                x: 1.5px; y: 1.5px;
                                width: max(0px, (parent.width - 5px) * root.battery-level / 100);
                                height: parent.height - 5px;
                                border-radius: 1px;
                                background: root.battery-charging ? Theme.color-success
                                          : root.battery-level <= 20 ? Theme.color-danger
                                          : root.battery-level <= 50 ? Theme.color-warning
                                          : Theme.text-secondary;
                            }

                            Rectangle {
                                x: parent.width;
                                y: 2.5px;
                                width: 1.5px;
                                height: parent.height - 6px;
                                border-radius: 0.5px;
                                background: Theme.text-dim;
                            }
                        }

                        Text {
                            text: root.battery-level + "%";
                            color: root.battery-level <= 20 ? Theme.color-danger : Theme.text-dim;
                            font-size: Theme.fs-micro;
                            vertical-alignment: center;
                        }
                    }
                }
            }

            // Power
            TouchArea {
                width: 22px;
                height: Theme.status-bar-height;
                mouse-cursor: pointer;
                clicked => { root.power-pressed(); }

                Icon {
                    commands: Icons.power;
                    size: 13px;
                    tint: parent.has-hover ? Theme.text-primary : Theme.text-dim;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            // Clock + date — right-most
            Text {
                text: root.clock-text;
                color: Theme.text-primary;
                font-size: Theme.fs-caption;
                font-weight: Theme.fw-body-strong;
                vertical-alignment: center;
            }
            if root.date-text != "" && root.width >= 1000px : Text {
                text: root.date-text;
                color: Theme.text-dim;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
            }
        }
    }
}
