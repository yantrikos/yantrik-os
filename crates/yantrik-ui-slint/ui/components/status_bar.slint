// StatusBar — the top bar, as in render 01: 36px, opaque, one calm line.
//
//   left    the Yantrik mark, then ONE Minds chip ("● Minds · 2 need you")
//   centre  the clock, centred on the SCREEN
//   right   the mind-mode chip, then the machine's indicators (do-not-disturb when on, network,
//           sound, battery) and Quick Settings, one 18px line-icon family with 8px between
//
// What used to be here and is not: the CPU and memory readouts (Settings and the System monitor
// have them), the companion's thinking dot and the word "Yantrik", the project pill, the provider
// and active-mind chips, the whisper and queue counts, the unread badge and the INC and DND text
// badges, and the power button (Super+Escape and the command palette open the power menu). Every
// one of them drew something on a bar whose only job is "the time, the minds, the machine".
//
// Two things stay that are not in the render, because the render is the healthy desktop: the red
// notices for "no model is answering" and "a mind cannot reach this machine" draw only while that
// is true. A bar that said "Minds" in calm teal over a dead assistant would be a lie.
//
// No timers. The clock text arrives from Rust once a minute; nothing here moves.
import { YIndicator } from "y_indicator.slint";
import { Theme } from "theme.slint";
import { Icons } from "icon.slint";
import { YantrikMark } from "yantrik_mark.slint";
import { NetworkIndicator } from "bar/network_indicator.slint";
import { BatteryIndicator } from "bar/battery_indicator.slint";
import { SoundIndicator } from "bar/sound_indicator.slint";
import { MindsChip } from "bar/minds_chip.slint";
import { ModeChip } from "bar/mode_chip.slint";
import { NoticeChip } from "bar/notice_chip.slint";
import { BarClock } from "bar/bar_clock.slint";

// A layout cell that keeps its child its own height and centres it on the bar. A bare child of the
// bar's HorizontalLayout is stretched to the bar's height, and a 24px chip became a 36px slab.
component BarSlot inherits VerticalLayout {
    alignment: center;
    @children
}

export component StatusBar inherits Rectangle {
    // "14:32" and "Fri 2 Oct": Rust sets both on the minute.
    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <bool> today-open: false;
    callback clock-clicked();

    // The minds: how many have an unresolved request, and how many requests that is.
    in property <int> minds-needing: 0;
    in property <int> minds-requests: 0;
    callback minds-clicked();
    callback anchor-clicked();

    // #30: the one visible line about an assistant with no model. Non-empty only while the
    // backend is unreachable; its click goes to Settings → AI. Set from Rust
    // (`assistant_offline_notice` in bridge.rs), cleared when a model answers again.
    in property <string> assistant-offline-notice: "";
    callback assistant-offline-clicked();
    // Set while another process holds the harness socket (#367): no mind can attach here.
    in property <string> minds-notice: "";
    callback minds-notice-clicked();

    // What the minds may do unasked: plan | ask | auto | bypass | bypass_all. The label carries the
    // countdown during either bypass. See components/mind_mode_menu.slint.
    in property <string> mind-mode: "ask";
    in property <string> mind-mode-label: "Ask";
    in property <bool> private-mode: false;
    callback mind-mode-clicked();

    // Do Not Disturb: a moon, only while it is on, and a click turns it off.
    in property <bool> dnd-enabled: false;
    callback dnd-clicked();

    in property <bool> network-online: false;
    in property <string> network-medium: "";
    // The network mark's centre, window coordinates, so the popover can hang from it.
    in-out property <length> network-anchor-x: 0;
    callback network-tapped();

    in property <bool> volume-available: false;
    in property <bool> volume-muted: false;
    in property <int> volume-level: 0;
    callback volume-changed(int);
    callback volume-mute-toggled();

    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <string> battery-state: "unknown";
    in property <string> battery-status-text: "";
    in property <string> battery-time-text: "";
    in property <bool> battery-popover-open: false;
    /// The battery's centre on the bar, so the shell can hang its popover under it.
    callback battery-clicked(length);

    callback settings-tapped();

    height: Theme.status-bar-height;
    // Opaque. The glass this bar had turned the top of the desktop into a lid over the wallpaper
    // and let a window's title show through it.
    background: Theme.bar-bg;

    Rectangle {
        y: parent.height - Theme.hairline;
        width: 100%;
        height: Theme.hairline;
        background: Theme.bar-border;
    }

    // ── Left ──
    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.bar-gap;
        alignment: start;

        // The mark opens the Lens, where the dot beside it used to.
        Rectangle {
            width: Theme.h-regular;
            YantrikMark {
                mark-size: 20px;
                x: (parent.width - self.width) / 2;
                y: (parent.height - self.height) / 2;
            }
            TouchArea {
                mouse-cursor: pointer;
                clicked => { root.anchor-clicked(); }
            }
            accessible-role: button;
            accessible-label: "Yantrik";
        }
        BarSlot {
            MindsChip {
                needing: root.minds-needing;
                requests: root.minds-requests;
                clicked => { root.minds-clicked(); }
            }
        }
        if root.assistant-offline-notice != "" : BarSlot {
            NoticeChip {
                text: root.assistant-offline-notice;
                clicked => { root.assistant-offline-clicked(); }
            }
        }
        if root.minds-notice != "" : BarSlot {
            NoticeChip {
                text: root.minds-notice;
                clicked => { root.minds-notice-clicked(); }
            }
        }
    }

    // ── Right ──
    HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.bar-gap;
        alignment: end;

        BarSlot {
            ModeChip {
                mode: root.mind-mode;
                mode-label: root.mind-mode-label;
                private-mode: root.private-mode;
                clicked => { root.mind-mode-clicked(); }
            }
        }
        if root.dnd-enabled : BarSlot {
            YIndicator {
                icon: Icons.moon;
                tooltip: "Do Not Disturb is on. Click to turn it off.";
                tooltip-above: false;
                clicked => { root.dnd-clicked(); }
            }
        }
        BarSlot {
            NetworkIndicator {
                clicked => { root.network-tapped(); }
                changed anchor-x => { root.network-anchor-x = self.anchor-x; }
                init => { root.network-anchor-x = self.anchor-x; }
            }
        }
        if root.volume-available : BarSlot {
            SoundIndicator {
                level: root.volume-level;
                muted: root.volume-muted;
                clicked => { root.settings-tapped(); }
                volume-changed(v) => { root.volume-changed(v); }
                mute-toggled => { root.volume-mute-toggled(); }
            }
        }
        if root.battery-available : BarSlot {
            BatteryIndicator {
                level: root.battery-level;
                battery-state: root.battery-state;
                status-text: root.battery-status-text;
                time-text: root.battery-time-text;
                active: root.battery-popover-open;
                clicked => { root.battery-clicked(self.anchor-x); }
            }
        }
        BarSlot {
            YIndicator {
                icon: Icons.settings;
                tooltip: "Quick Settings";
                tooltip-above: false;
                tooltip-end: true;
                clicked => { root.settings-tapped(); }
            }
        }
    }

    // ── Centre ── on the bar's own middle, not on what the two groups leave between them.
    BarClock {
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
        text: root.date-text != "" ? root.date-text + " · " + root.clock-text : root.clock-text;
        active: root.today-open;
        clicked => { root.clock-clicked(); }
    }
}
