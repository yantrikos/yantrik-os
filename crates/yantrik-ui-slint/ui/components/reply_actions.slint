// What a press inside a reply's words asks of the shell. A global, so a link three layers down in
// a bubble reaches the shell's own handlers (wire/reply_actions.rs) without being threaded through
// every component between.
export global ReplyActions {
    // A link in a paragraph, list or table. The shell opens http and https addresses only.
    callback open-link(string);
    // A code block's Copy: the block's exact text. The shell copies it off the UI thread and says how
    // it went: `copied` is the text that was copied, `failed` the text that could not be. The
    // button reads them, and clears `copied` after a moment.
    callback copy-text(string);
    in-out property <string> copied;
    in-out property <string> failed;
}
