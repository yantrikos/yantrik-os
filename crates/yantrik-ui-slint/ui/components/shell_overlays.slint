// The overlays the bar opens: Quick Settings, the power menu and the clipboard panel, and the
// keyboard cheat sheet (Super+/).
//
// They stood inside DesktopScreen, which is only on screen while the desktop is. The bar is the
// shell's and is drawn above every screen, so its network, settings and power buttons toggled a
// flag on any screen -- and from Files, Settings or Agents the flag drew nothing, because the
// panel it opens was not there to draw. They live here now, instantiated once in app.slint
// after the screens, so a click on the bar shows what it promises wherever the person is.
//
// Nothing here owns state: every flag and value is the app's, bound through, so the desktop's
// own keybinds, the control surface and the bar all open the same panels.

import { Theme } from "theme.slint";
import { QuickSettings } from "quick_settings.slint";
import { PowerMenu } from "power_menu.slint";
import { ClipboardPanel, ClipboardEntryData } from "clipboard_panel.slint";
import { CheatSheet, CheatRowData } from "cheat_sheet.slint";
import { BatteryPopover } from "bar/battery_popover.slint";

export component ShellOverlays inherits Rectangle {
    // Quick Settings
    in-out property <bool> quick-settings-open: false;
    in property <bool> battery-available: false;
    in property <int> battery-level: 100;
    in property <bool> battery-charging: false;
    in property <bool> wifi-connected: false;
    // The network's name, for the tile. It once stood as an empty string here, so the tile never
    // had a network to name.
    in property <string> wifi-ssid: "";
    // The machine's real levels (wire/audio.rs, wire/backlight.rs): nothing invented, and a
    // row for hardware that is absent is not drawn.
    in property <bool> brightness-available: false;
    in-out property <int> brightness-level: 0;
    in property <bool> volume-available: false;
    in property <bool> volume-muted: false;
    in-out property <int> volume-level: 0;
    callback toggle-wifi();
    callback brightness-changed(int);
    callback volume-changed(int);
    callback volume-mute-toggled();

    // Battery popover: level, state, time and the power profile, under the bar's battery.
    in-out property <bool> battery-popover-open: false;
    in property <length> battery-anchor-x: 0;
    in property <string> battery-status-text: "";
    in property <string> battery-time-text: "";
    in property <string> power-profile: "";
    in property <bool> power-performance-offered: false;
    callback set-power-profile(string);

    // Power menu
    in-out property <bool> power-menu-open: false;
    callback power-action(string);

    // Clipboard panel
    in-out property <bool> clip-panel-open: false;
    in property <[ClipboardEntryData]> clip-panel-entries: [];
    in-out property <string> clip-search-query: "";
    callback clipboard-paste(int);
    callback clipboard-search(string);

    // Keyboard cheat sheet
    in-out property <bool> cheat-sheet-open: false;
    in property <[CheatRowData]> cheat-sheet-rows: [];
    in-out property <string> cheat-sheet-query: "";
    callback cheat-sheet-search(string);

    width: 100%;
    height: 100%;

    QuickSettings {
        width: 100%;
        height: 100%;
        is-open <=> root.quick-settings-open;
        battery-available: root.battery-available;
        battery-level: root.battery-level;
        battery-charging: root.battery-charging;
        wifi-connected: root.wifi-connected;
        wifi-ssid: root.wifi-ssid;
        brightness-available: root.brightness-available;
        brightness-level <=> root.brightness-level;
        volume-available: root.volume-available;
        volume-muted: root.volume-muted;
        volume-level <=> root.volume-level;
        toggle-wifi => { root.toggle-wifi(); }
        brightness-changed(val) => { root.brightness-changed(val); }
        volume-changed(val) => { root.volume-changed(val); }
        volume-mute-toggled => { root.volume-mute-toggled(); }
        close => { root.quick-settings-open = false; }
    }

    BatteryPopover {
        open: root.battery-popover-open;
        anchor-x: root.battery-anchor-x;
        anchor-y: Theme.status-bar-height;
        level: root.battery-level;
        status-text: root.battery-status-text;
        time-text: root.battery-time-text;
        power-profile: root.power-profile;
        performance-offered: root.power-performance-offered;
        profile-chosen(p) => { root.set-power-profile(p); }
        brightness-available: root.brightness-available;
        brightness-level: root.brightness-level;
        brightness-changed(v) => {
            // The slider shows `value` once the drag ends, so the shared level moves with it.
            root.brightness-level = v;
            root.brightness-changed(v);
        }
        close-requested => { root.battery-popover-open = false; }
    }

    PowerMenu {
        width: 100%;
        height: 100%;
        is-open <=> root.power-menu-open;
        power-action(action) => { root.power-action(action); }
        close => { root.power-menu-open = false; }
    }

    ClipboardPanel {
        width: 100%;
        height: 100%;
        is-open <=> root.clip-panel-open;
        entries: root.clip-panel-entries;
        search-query <=> root.clip-search-query;
        paste-entry(idx) => { root.clipboard-paste(idx); }
        search-changed(query) => { root.clipboard-search(query); }
        close => { root.clip-panel-open = false; }
    }

    CheatSheet {
        width: 100%;
        height: 100%;
        is-open <=> root.cheat-sheet-open;
        rows: root.cheat-sheet-rows;
        search-query <=> root.cheat-sheet-query;
        search-changed(query) => { root.cheat-sheet-search(query); }
        close => { root.cheat-sheet-open = false; }
    }
}
