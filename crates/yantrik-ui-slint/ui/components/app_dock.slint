// AppDock — centered bottom bar with app icons.
// Clean plate with 1px top border. Icons lift on hover with scale.
// Running indicator: 4px accent dot. Active app: brighter plate tint.
// Anchor button at end — calm accent treatment.

import { Theme } from "theme.slint";

export struct DockItem {
    app-id: string,
    label: string,
    icon-char: string,
    // What to draw for it. The shell's apps are keyed one way for launching (`download-manager`)
    // and another for their glyph (`downloads`); an app the shell has no glyph for brings a real
    // icon from the icon theme instead.
    icon-id: string,
    icon: image,
    has-icon: bool,
    is-running: bool,
    // Launched and no window yet. Drawn as "Starting…" so the seconds before a slow app's window
    // arrives do not read as nothing having happened.
    is-starting: bool,
}

// AppDock lived here: the Mac-style auto-hide dock of square tiles bearing LETTERS --
// ">_", "W", "F", "@", "N" -- from a hardcoded list that had drifted out of step with the
// real pinned apps. Taskbar replaced it, and nothing has instantiated it since. DockItem
// below is still the struct the shell passes around, which is why this file remains.
