// The keyboard cheat sheet: every key the compositor binds, grouped, as key caps and a plain
// description. Opened by Super+/ (rc.xml -> `yos act shell open_cheat_sheet`) or the control
// surface; Esc or a click outside puts it away.
//
// Nothing here is written by hand. The rows come from Rust (cheat_sheet.rs), which reads them out
// of rc.xml, so a key added to the compositor shows up here with the words its binding carries.
// A row is either a section heading or a binding; the search box is filtered Rust-side, because
// the matching has to see the key names as well as the words.

import { Theme } from "theme.slint";

export struct CheatRowData {
    // A section heading when true; `text` is then the section's name and `caps` is empty.
    heading: bool,
    text: string,
    // One cap per entry. A row two keys reach has both, with "or" between (`cheat_sheet::OR`),
    // drawn as a word and not a cap.
    caps: [string],
}

component KeyCap inherits Rectangle {
    in property <string> label;
    // The "or" between two keys: the same box and type, with no cap drawn round it.
    in property <bool> word: false;

    height: 24px;
    width: root.word ? cap-text.preferred-width + 8px : max(24px, cap-text.preferred-width + 14px);
    border-radius: Theme.r-sm;
    background: root.word ? transparent : Theme.keycap-fill;
    border-width: root.word ? 0px : 1px;
    border-color: Theme.keycap-border;

    cap-text := Text {
        text: root.label;
        color: root.word ? Theme.text-dim : Theme.text-primary;
        font-size: Theme.font-small;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component CheatSheet inherits Rectangle {
    in-out property <bool> is-open: false;
    in property <[CheatRowData]> rows: [];
    in-out property <string> search-query: "";

    callback search-changed(string);
    callback close();

    width: 100%;
    height: 100%;

    function dismiss() {
        root.search-query = "";
        root.is-open = false;
        root.close();
    }

    // Backdrop (click outside to close)
    if root.is-open : TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.dismiss(); }

        Rectangle {
            width: 100%;
            height: 100%;
            background: Theme.overlay-backdrop;
        }
    }

    if root.is-open : Rectangle {
        property <length> panel-w: 640px;
        width: self.panel-w;
        height: min(parent.height - 80px, 600px);
        x: (parent.width - self.panel-w) / 2;
        y: (parent.height - self.height) / 2;
        background: Theme.panel-solid;
        border-radius: Theme.r-xl;
        border-width: 1px;
        border-color: Theme.border-card;
        drop-shadow-blur: 32px;
        drop-shadow-color: Theme.overlay-shadow;
        clip: true;

        // Swallow clicks so they do not reach the backdrop.
        TouchArea { width: 100%; height: 100%; }

        FocusScope {
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) { root.dismiss(); return accept; }
                reject
            }

            VerticalLayout {
                padding: 16px;
                spacing: 10px;

                HorizontalLayout {
                    height: 32px;
                    spacing: 8px;
                    Text {
                        text: "Keyboard shortcuts";
                        color: Theme.text-primary;
                        font-family: Theme.font-ui;
                        font-size: Theme.font-title;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text {
                        text: "Esc to close";
                        color: Theme.text-dim;
                        font-size: Theme.font-small;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: 36px;
                    border-radius: Theme.r-md;
                    background: Theme.bg-input;
                    border-width: 1px;
                    border-color: search-input.has-focus ? Theme.accent-dim : Theme.border-subtle;

                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;

                        search-input := TextInput {
                            horizontal-stretch: 1;
                            vertical-alignment: center;
                            font-size: Theme.fs-body;
                            color: Theme.text-primary;
                            text <=> root.search-query;
                            init => { self.focus(); }
                            edited => { root.search-changed(root.search-query); }
                        }
                    }

                    if root.search-query == "" : Text {
                        x: 10px;
                        text: "Search shortcuts";
                        color: Theme.text-dim;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        height: 100%;
                    }
                }

                Rectangle { height: 1px; background: Theme.separator; }

                if root.rows.length == 0 : Rectangle {
                    vertical-stretch: 1;
                    Text {
                        text: "No shortcut matches";
                        color: Theme.text-dim;
                        font-size: Theme.font-body;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                if root.rows.length > 0 : Flickable {
                    vertical-stretch: 1;
                    viewport-height: root.rows.length * 34px;
                    for row[i] in root.rows : Rectangle {
                        y: i * 34px;
                        width: parent.width;
                        height: 34px;

                        if row.heading : Text {
                            x: 4px;
                            y: 10px;
                            text: row.text;
                            color: Theme.text-dim;
                            font-size: Theme.font-small;
                            font-weight: 600;
                        }

                        if !row.heading : HorizontalLayout {
                            padding-left: 4px;
                            spacing: 16px;

                            Rectangle {
                                // Wide enough for "Super ← or Super Alt ←".
                                width: 270px;
                                HorizontalLayout {
                                    spacing: 4px;
                                    alignment: start;
                                    for label in row.caps : KeyCap {
                                        label: label;
                                        word: label == "or";
                                        y: (parent.height - self.height) / 2;
                                    }
                                }
                            }
                            Text {
                                text: row.text;
                                color: Theme.text-secondary;
                                font-size: Theme.fs-body;
                                vertical-alignment: center;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
        }
    }
}
