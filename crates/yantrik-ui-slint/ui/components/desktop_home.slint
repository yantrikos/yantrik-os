// The everyday desktop: a quiet place to start, with real pins and recent items.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { AppTile } from "app_tile.slint";
import { DockItem } from "app_dock.slint";
import { LensResult } from "intent_lens.slint";
import { YButton } from "y_button.slint";

export component DesktopHome inherits Rectangle {
    in property <string> greeting;
    in property <string> date;
    in property <string> mind-name;
    in property <bool> online;
    in property <[DockItem]> pins;
    in property <[LensResult]> recents;
    callback search();
    callback all-apps();
    callback launch(string);
    callback open-recent(string);
    callback configure-mind();

    property <int> columns: max(2, min(6, floor((self.width - 48px) / 104px)));

    Flickable {
        width: 100%; height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            alignment: start;
            spacing: 24px;
            padding: 4px;

            VerticalLayout {
                spacing: 8px;
                Text {
                    text: root.date;
                    font-size: Theme.fs-caption;
                    font-weight: 500;
                    color: Theme.text-secondary;
                    letter-spacing: 1px;
                }
                Text {
                    text: root.greeting;
                    font-size: root.width < 600px ? 34px : 46px;
                    font-weight: 600;
                    letter-spacing: -1px;
                    color: Theme.text-primary;
                    overflow: elide;
                }
                Text {
                    text: "A little clarity. Room for everything you do.";
                    font-size: Theme.fs-body;
                    color: Theme.text-secondary;
                    wrap: word-wrap;
                }
            }

            Rectangle {
                height: 64px;
                background: Theme.glass-panel;
                border-radius: Theme.r-xl;
                border-width: 1px;
                border-color: search-touch.has-hover || search-focus.has-focus ? Theme.accent : Theme.glass-border-strong;
                animate border-color { duration: Theme.dur-fast; }
                accessible-role: button;
                accessible-label: "Ask, search, or open anything";
                accessible-action-default => { root.search(); }
                search-focus := FocusScope {
                    key-pressed(e) => {
                        if (e.text == "\n" || e.text == " ") { root.search(); return accept; }
                        reject
                    }
                }
                search-touch := TouchArea { mouse-cursor: pointer; clicked => { root.search(); } }
                HorizontalLayout {
                    padding: 18px;
                    spacing: 14px;
                    Icon { commands: Icons.search; size: 21px; tint: Theme.accent; y: (parent.height - self.height) / 2; }
                    Text { text: "Ask, search, or open anything"; color: Theme.text-primary; font-size: Theme.fs-title-2; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    // The compositor's Super+K (config/labwc/rc.xml) — the key that works from
                    // inside any app; the ask bar chip in desktop.slint says why.
                    if root.width > 440px : Rectangle {
                        width: 58px; height: 25px;
                        y: (parent.height - self.height) / 2;
                        border-radius: Theme.r-sm;
                        background: Theme.hover-fill;
                        border-width: 1px; border-color: Theme.border-strong;
                        Text { text: "Super K"; font-size: Theme.fs-caption; color: Theme.text-secondary; horizontal-alignment: center; vertical-alignment: center; }
                    }
                }
            }

            Rectangle {
                height: pins-body.preferred-height;
                background: Theme.glass-panel;
                border-radius: Theme.r-xl;
                border-width: 1px;
                border-color: Theme.glass-border;
                pins-body := VerticalLayout {
                    padding: 20px;
                    spacing: 16px;
                    HorizontalLayout {
                        Text { text: "Your workspace"; font-size: Theme.fs-headline; font-weight: 600; color: Theme.text-primary; vertical-alignment: center; horizontal-stretch: 1; }
                        YButton { label: "All apps"; icon-path: Icons.chevron-right; icon-trailing: true; variant: 1; clicked => { root.all-apps(); } }
                    }
                    if root.pins.length == 0 : Text {
                        text: "Make this space yours. Open All apps and pin your favourites.";
                        color: Theme.text-secondary; font-size: Theme.fs-body; wrap: word-wrap;
                    }
                    if root.pins.length > 0 : Rectangle {
                        height: ceil(root.pins.length / root.columns) * 98px;
                        for item[i] in root.pins : Rectangle {
                            x: mod(i, root.columns) * (parent.width / root.columns);
                            y: floor(i / root.columns) * 98px;
                            width: parent.width / root.columns;
                            height: 94px;
                            border-radius: Theme.r-lg;
                            background: pin-touch.has-hover ? Theme.hover-fill-strong : transparent;
                            border-width: pin-focus.has-focus ? 2px : 0px;
                            border-color: Theme.accent;
                            accessible-role: button;
                            accessible-label: item.label;
                            accessible-action-default => { root.launch(item.app-id); }
                            pin-focus := FocusScope {
                                key-pressed(e) => {
                                    if (e.text == "\n" || e.text == " ") { root.launch(item.app-id); return accept; }
                                    reject
                                }
                            }
                            pin-touch := TouchArea { mouse-cursor: pointer; clicked => { root.launch(item.app-id); } }
                            VerticalLayout {
                                padding-top: 8px; padding-bottom: 4px;
                                spacing: 6px; alignment: start;
                                // The app's own tile — the same object the launcher and the
                                // taskbar draw, so Files is the same blue square on all three.
                                HorizontalLayout {
                                    alignment: center;
                                    AppTile {
                                        size: 46px;
                                        app-id: item.icon-id;
                                        glyph: Icons.app-or-window(item.icon-id);
                                        has-icon: item.has-icon;
                                        icon: item.icon;
                                        hovered: pin-touch.has-hover;
                                    }
                                }
                                Text { text: item.label; color: Theme.text-primary; font-size: Theme.fs-caption; horizontal-alignment: center; overflow: elide; }
                                Rectangle { width: 12px; height: 3px; x: (parent.width - self.width) / 2; border-radius: 1.5px; background: item.is-running ? Theme.accent : transparent; }
                            }
                        }
                    }
                }
            }

            if root.recents.length > 0 : Rectangle {
                height: recent-body.preferred-height;
                background: Theme.glass-panel;
                border-radius: Theme.r-xl;
                border-width: 1px; border-color: Theme.glass-border;
                recent-body := VerticalLayout {
                    padding: 20px; spacing: 8px;
                    Text { text: "Pick up where you left off"; font-size: Theme.fs-headline; font-weight: 600; color: Theme.text-primary; }
                    for recent[i] in root.recents : Rectangle {
                        visible: i < 4;
                        height: i < 4 ? 40px : 0px;
                        border-radius: Theme.r-md;
                        background: recent-touch.has-hover ? Theme.hover-fill : transparent;
                        border-width: recent-focus.has-focus ? 2px : 0px; border-color: Theme.accent;
                        accessible-role: button; accessible-label: recent.title;
                        accessible-action-default => { root.open-recent(recent.action-id); }
                        recent-focus := FocusScope {
                            enabled: i < 4;
                            key-pressed(e) => {
                                if (e.text == "\n" || e.text == " ") { root.open-recent(recent.action-id); return accept; }
                                reject
                            }
                        }
                        recent-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-recent(recent.action-id); } }
                        HorizontalLayout {
                            padding-left: 8px; padding-right: 8px; spacing: 12px;
                            Icon { commands: Icons.file; size: 17px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                            Text { text: recent.title; font-size: Theme.fs-body; color: Theme.text-primary; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                            if root.width > 540px : Text { text: recent.subtitle; max-width: 190px; font-size: Theme.fs-caption; color: Theme.text-secondary; overflow: elide; vertical-alignment: center; }
                            Icon { commands: Icons.chevron-right; size: 14px; tint: Theme.text-dim; y: (parent.height - self.height) / 2; }
                        }
                    }
                }
            }

            HorizontalLayout {
                spacing: 10px;
                Rectangle { width: 6px; height: 6px; border-radius: 3px; y: (parent.height - self.height) / 2; background: root.online ? Theme.accent : Theme.text-dim; }
                Text {
                    text: root.online ? (root.mind-name != "" ? root.mind-name + " is within reach" : "Your companion is within reach") : "Your workspace is ready. Connect a mind when you need one.";
                    color: Theme.text-secondary; font-size: Theme.fs-caption; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1;
                }
                YButton { label: root.online ? "Open companion" : "Connect a mind"; variant: 1; size: 0; clicked => { root.configure-mind(); } }
            }
        }
    }
}
