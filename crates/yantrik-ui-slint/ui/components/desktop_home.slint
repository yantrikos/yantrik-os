// The desktop's home: a greeting, the ask field and, when there is one, the one thing to pick up.
//
// The art direction of 20 Oct 2026 (design/art-direction-2026-10-20.md, B): let the lake be the
// desktop. It took out the "Your workspace" card, which drew the dock's own apps a second time
// over the photograph's strongest area. It also took out the date (the bar has it), the slogan
// and the "within reach" line. The ask field is an opaque floating surface; the wallpaper through
// a translucent card made it muddier, not richer. What is left sits up and to the left, over the
// quiet sky.
//
// There is one. It had a twin for agent mode, drawn inside desktop.slint with its own search
// field, its own pin tiles and its own spacing; `agent-mode` now only decides which sections this
// shows. Agent mode adds what the mind is proposing and, on a machine nobody has used, a card that
// says what to do first; it leaves out the recent files and the mind's status line, which the
// work rail and the mind panel already say beside it.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { DockItem } from "app_dock.slint";
import { LensResult } from "intent_lens.slint";
import { YButton } from "y_button.slint";
import { UrgeCardData, GlanceCard } from "glance_card.slint";

// A key, as the hints draw it everywhere (the Alt+Tab row's keycaps).
component Keycap inherits Rectangle {
    in property <string> key;
    width: label.preferred-width + 14px;
    height: 24px;
    border-radius: Theme.r-xs;
    background: Theme.bg-surface;
    border-width: 1px;
    border-color: Theme.border-floating;
    label := Text {
        text: root.key;
        color: Theme.text-secondary;
        font-size: Theme.fs-micro;
        font-weight: 500;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

export component DesktopHome inherits Rectangle {
    // The machine's desk rather than a person's: adds suggestions, drops recents and the mind line.
    in property <bool> agent-mode: false;
    in property <string> greeting;
    in property <string> date;
    in property <string> mind-name;
    in property <bool> online;
    in property <[DockItem]> pins;
    in property <[LensResult]> recents;
    in property <[UrgeCardData]> urges: [];
    // Any window is open (agent mode's day-one card goes once there is something to see).
    in property <bool> has-windows: false;
    callback send-message(string);
    callback search();
    callback all-apps();
    callback launch(string);
    callback open-recent(string);
    callback configure-mind();

    property <int> columns: max(2, min(6, floor((self.width - 48px) / 104px)));
    // The box says where its words go: it opens the chat with the mind that answers, and that
    // mind may be an online model. The answering mind by name; "your mind" until the harness host
    // has said who is answering, never a mind that may not be on this machine.
    property <string> ask-words: "Ask "
        + (root.mind-name == "" || root.mind-name == "no mind" ? "your mind" : root.mind-name) + "…";

    Flickable {
        width: 100%; height: 100%;
        viewport-width: self.width;
        viewport-height: body.preferred-height;
        body := VerticalLayout {
            width: parent.width;
            height: self.preferred-height;
            alignment: start;
            spacing: 20px;
            padding: 4px;

            // Straight on the wallpaper, so it wears the wallpaper label's shadow (Theme.label-shadow):
            // a copy of itself 1px lower in black keeps white legible over the photograph's light parts.
            Rectangle {
                height: greeting.preferred-height;
                Text {
                    x: 0;
                    y: 1px;
                    width: parent.width;
                    text: root.greeting;
                    font-size: Theme.fs-greeting;
                    font-weight: 500;
                    color: Theme.label-shadow;
                    overflow: elide;
                }
                greeting := Text {
                    x: 0;
                    y: 0;
                    width: parent.width;
                    text: root.greeting;
                    font-size: Theme.fs-greeting;
                    font-weight: 500;
                    color: Theme.label-on-wallpaper;
                    overflow: elide;
                }
            }

            Rectangle {
                height: 56px;
                background: Theme.bg-card;
                border-radius: Theme.r-xl;
                border-width: 1px;
                border-color: search-touch.has-hover || search-focus.has-focus ? Theme.accent : Theme.border-floating;
                drop-shadow-blur: Theme.shadow-float-blur;
                drop-shadow-offset-y: Theme.shadow-float-dy;
                drop-shadow-color: Theme.shadow-float;
                animate border-color { duration: Theme.dur-fast; }
                accessible-role: button;
                accessible-label: root.ask-words;
                accessible-action-default => { root.search(); }
                search-focus := FocusScope {
                    key-pressed(e) => {
                        if (e.text == "\n" || e.text == " ") { root.search(); return accept; }
                        reject
                    }
                }
                search-touch := TouchArea { mouse-cursor: pointer; clicked => { root.search(); } }
                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: 12px;
                    Icon { commands: Icons.search; size: 18px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                    Text { text: root.ask-words; color: Theme.text-secondary; font-size: Theme.fs-reading; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
                    // The compositor's Super+K (config/labwc/rc.xml) — the key that works from
                    // inside any app; the ask bar chip in desktop.slint says why.
                    if root.width > 440px : VerticalLayout {
                        alignment: center;
                        HorizontalLayout {
                            spacing: 4px;
                            Keycap { key: "Super"; }
                            Keycap { key: "K"; }
                        }
                    }
                }
            }

            // What the mind is proposing. Tapping one sends it to the mind: the suggestion IS a
            // message the mind proposed saying to itself, so the honest action is to say it.
            if root.agent-mode && root.urges.length > 0 : VerticalLayout {
                spacing: 8px;
                Text {
                    text: "SUGGESTIONS";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    font-weight: Theme.fw-micro;
                    letter-spacing: 1px;
                }
                for u in root.urges : GlanceCard {
                    data: u;
                    tapped(msg) => { root.send-message(msg); }
                }
            }

            // One thing to pick up, when there is one: a two-line row, not another dashboard card.
            // Nothing at all when nothing is recent.
            if !root.agent-mode && root.recents.length > 0 : Rectangle {
                height: 60px;
                border-radius: Theme.r-lg;
                background: recent-touch.has-hover ? Theme.bg-elevated : Theme.bg-card;
                border-width: recent-focus.has-focus ? 2px : 1px;
                border-color: recent-focus.has-focus ? Theme.accent : Theme.border-floating;
                drop-shadow-blur: Theme.shadow-float-blur;
                drop-shadow-offset-y: Theme.shadow-float-dy;
                drop-shadow-color: Theme.shadow-float;
                accessible-role: button;
                accessible-label: "Continue " + root.recents[0].title;
                accessible-action-default => { root.open-recent(root.recents[0].action-id); }
                recent-focus := FocusScope {
                    key-pressed(e) => {
                        if (e.text == "\n" || e.text == " ") { root.open-recent(root.recents[0].action-id); return accept; }
                        reject
                    }
                }
                recent-touch := TouchArea { mouse-cursor: pointer; clicked => { root.open-recent(root.recents[0].action-id); } }
                HorizontalLayout {
                    padding-left: 18px; padding-right: 16px; spacing: 12px;
                    Icon { commands: Icons.file; size: 18px; tint: Theme.text-secondary; y: (parent.height - self.height) / 2; }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        horizontal-stretch: 1;
                        Text { text: "Continue " + root.recents[0].title; font-size: Theme.fs-body; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                        if root.recents[0].subtitle != "" : Text { text: root.recents[0].subtitle; font-size: Theme.fs-caption; color: Theme.text-secondary; overflow: elide; }
                    }
                    Icon { commands: Icons.chevron-right; size: 14px; tint: Theme.text-dim; y: (parent.height - self.height) / 2; }
                }
            }

            // Nothing to show on a machine that has never been used, so say what to do first:
            // true on day one and gone by day two.
            if root.agent-mode && root.urges.length == 0 && !root.has-windows : Rectangle {
                height: day-one.preferred-height;
                background: Theme.bg-card;
                border-radius: Theme.r-xl;
                border-width: 1px;
                border-color: Theme.border-floating;
                day-one := VerticalLayout {
                    padding: 20px;
                    spacing: 8px;
                    alignment: start;
                    Text { text: "Ready when you are"; color: Theme.text-primary; font-size: Theme.fs-headline; font-weight: 600; }
                    Text {
                        text: "Open a pinned app to get started, or press Super K to ask a question, find a file, or run a command.";
                        color: Theme.text-secondary; font-size: Theme.fs-body; wrap: word-wrap;
                    }
                }
            }

            // Only when there is no mind to ask: the way to connect one. With a mind connected, the ask
            // field above already is the way to it.
            if !root.agent-mode && !root.online : HorizontalLayout {
                spacing: 12px;
                alignment: start;
                Text {
                    text: "No mind is connected yet.";
                    color: Theme.label-on-wallpaper; font-size: Theme.fs-body; vertical-alignment: center;
                }
                YButton { label: "Connect a mind"; variant: 1; size: 0; clicked => { root.configure-mind(); } }
            }
        }
    }
}
