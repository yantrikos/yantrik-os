// The Review screen's timezone row, and the field that edits it.
//
// The installer starts at UTC and asks the network nothing (#1171), so an install clicked straight
// through would leave a machine in Arkansas five hours out with nobody having been asked. The row
// is therefore amber and says "Is this your timezone?" until the person answers: Yes, or Change.

import { Theme } from "theme.slint";
import { OnboardField } from "onboard_kit.slint";

// What lets Tab reach a control the pointer clicks. The picker, the disk rows and the ticks
// were TouchAreas alone, so Tab went from text field to button past every one of them (13 Oct
// 2026). Space and Enter do what a click does; the arrow keys and Escape go to the controls that
// answer them (`step` and `dismiss` say whether they did), and pass on otherwise. The control
// draws its own ring from `has-focus`.
export component KeyReach inherits FocusScope {
    callback activate();
    callback step(/* -1 up, 1 down */ int) -> bool;
    callback dismiss() -> bool;
    key-pressed(event) => {
        if (event.text == Key.Return || event.text == "\n" || event.text == " ") {
            if (!event.repeat) { root.activate(); }
            return accept;
        }
        if (event.text == Key.UpArrow && root.step(-1)) { return accept; }
        if (event.text == Key.DownArrow && root.step(1)) { return accept; }
        if (event.text == Key.Escape && root.dismiss()) { return accept; }
        reject
    }
}

// A small clickable word: Show password, More, Change. Tab reaches it too.
export component LinkText inherits Rectangle {
    in property <string> text;
    in property <bool> active: false;
    in property <bool> strong: false;
    // A focus stop of its own (Tab, Enter, Space), with a ring. Off for the links that sit
    // beside a field whose own keys already reach them.
    in property <bool> focusable: false;
    // Each change puts focus here: how a screen drawn over this one hands focus back.
    in property <int> focus-when: 0;
    callback clicked();
    width: label.preferred-width + (root.focusable ? 8px : 0);
    height: label.preferred-height + (root.focusable ? 4px : 0);
    border-radius: 4px;
    border-width: fs.has-focus ? Theme.focus-ring-width : 0;
    border-color: Theme.focus-ring;
    accessible-role: button;
    accessible-action-default => { root.clicked(); }
    accessible-label: root.text;
    changed focus-when => { if root.focusable { fs.focus(); } }
    fs := FocusScope {
        enabled: root.focusable;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") { if !event.repeat { root.clicked(); } return accept; }
            reject
        }
    }
    label := Text {
        x: root.focusable ? 4px : 0;
        text: root.text;
        color: root.strong || root.active || touch.has-hover || link-key.has-focus ? Theme.accent : Theme.text-secondary;
        font-size: Theme.fs-caption;
        vertical-alignment: center;
    }
    // The ring sits just outside the word, so the word does not move when it shows.
    if link-key.has-focus : Rectangle {
        x: -4px;
        y: -2px;
        width: parent.width + 8px;
        height: parent.height + 4px;
        border-radius: 4px;
        border-width: 1px;
        border-color: Theme.focus-ring;
    }
    link-key := KeyReach {
        activate => { root.clicked(); }
    }
    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}


export component TimezoneRow inherits VerticalLayout {
    in-out property <string> timezone;
    in property <string> error;
    property <bool> editing: false;
    property <bool> answered: false;
    spacing: Theme.sp-3;

    HorizontalLayout {
        spacing: Theme.sp-3;
        Text {
            text: "Timezone";
            width: 130px;
            color: Theme.text-dim;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        Text {
            text: root.timezone;
            horizontal-stretch: 1;
            color: root.error != "" || !root.answered ? Theme.amber : Theme.text-primary;
            font-size: Theme.fs-body;
            font-weight: 500;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            LinkText {
                text: root.editing ? "Done" : "Change";
                strong: true;
                clicked => {
                    root.editing = !root.editing;
                    root.answered = true;
                }
            }
        }
    }
    if !root.answered : HorizontalLayout {
        spacing: Theme.sp-3;
        Text {
            text: "Is this your timezone?";
            color: Theme.amber;
            font-size: Theme.fs-body;
            horizontal-stretch: 1;
            horizontal-alignment: right;
            vertical-alignment: center;
        }
        LinkText {
            text: "Yes";
            strong: true;
            clicked => { root.answered = true; }
        }
    }
    if root.editing || (root.timezone != "" && root.error != "") : OnboardField {
        width: 428px;
        value <=> root.timezone;
        placeholder: "Region/City, e.g. Europe/Berlin";
        error: root.error;
        accepted => { if root.error == "" { root.editing = false; } }
    }
}
