
// Window overview (Super+Tab; Alt+Tab is labwc's own) — one centred opaque card of the open windows, 8 to a page.
//
// Selection, order and paging all live in Rust (`alt_tab.rs`), so a pointer, a key and a
// `yos act shell` call move the same state; this file draws what Rust hands it and reports
// what the person pressed. Opaque, with no dimming layer: the windows behind stay readable.
//
// There are no live previews. The compositor streams window titles and focus, not pixels, and
// the shell has no capture path for one toplevel, so a cell is what the shell does know: the
// app's tile (the kit's AppTile, the same one the dock draws), the app's name and the window's
// title. It used to be a grey 16:9 box reading "Preview unavailable", four of them on a card,
// which told a person nothing they could switch by (design sign-off, 4 October).

import { Theme } from "theme.slint";
import { Icons } from "icon.slint";
import { AppTile } from "app_tile.slint";
import { AppLabel } from "app_label.slint";
import { YIconButton } from "y_button.slint";

export struct SwitcherCell {
    title: string,
    // The id the tile is drawn for (`window_name::tile_id`): its glyph and its colour.
    tile-id: string,
    app-name: string,
    // A theme icon, for an app the shell draws no glyph for, exactly as the dock decides it.
    has-icon: bool,
    icon: image,
}

component SwitcherCellView inherits Rectangle {
    in property <SwitcherCell> cell;
    in property <bool> selected;
    callback pointer-moved();
    callback activated();

    // 144 wide where the card has room; a card narrower than its columns narrows the cells.
    in property <length> cell-width: Theme.sw-cell-w;
    width: root.cell-width;
    height: Theme.sw-cell-h;
    border-radius: Theme.r-lg;
    // The tile surface, one step lighter than the card; the selected cell is raised a step more
    // and ringed in the accent. The ring is drawn inside the cell, so it never overlaps a neighbour.
    background: root.selected ? Theme.tile-off-hover : Theme.tile-off;
    border-width: root.selected ? Theme.focus-ring-width : Theme.hairline;
    border-color: root.selected ? Theme.accent : Theme.tile-border;

    VerticalLayout {
        padding-top: Theme.sp-3;
        padding-left: Theme.sp-2;
        padding-right: Theme.sp-2;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            AppTile {
                app-id: root.cell.tile-id;
                glyph: Icons.app-or-window(root.cell.tile-id);
                has-icon: root.cell.has-icon;
                icon: root.cell.icon;
                size: Theme.sw-tile;
            }
        }
        Rectangle { height: Theme.sp-2; }
        AppLabel { text: root.cell.app-name; }
        // The title, unless it only says the name again (Calendar's window is titled "Calendar").
        // The row stays, so every cell's name sits at the same height.
        Text {
            text: root.cell.title == root.cell.app-name ? "" : root.cell.title;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            horizontal-alignment: center;
            overflow: elide;
        }
    }

    TouchArea {
        // A move, not a hover: the pointer sitting where the card opened must not override the
        // keyboard's selection, and `has-hover` is true from the first frame.
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
        }
        clicked => { root.activated(); }
    }
}

export component AltTab inherits Rectangle {
    in property <bool> is-open: false;
    in property <[SwitcherCell]> cells: [];
    // Index within `cells` (the current page), or -1.
    in property <int> selected: -1;
    in property <string> status: "";
    in property <int> page: 0;
    in property <int> pages: 1;

    // direction ∈ next, previous, left, right, up, down, page-next, page-prev; the second
    // argument is the column count the card is drawn with, so up and down mean what the person
    // sees.
    callback navigate(string, int);
    callback hover(int);
    callback activate(int);
    callback cancel();

    width: 100%;
    height: 100%;
    visible: root.is-open;

    // The pager row under the grid: a compact icon button's height.
    property <length> pager-h: Theme.h-compact;
    property <int> columns: root.width < Theme.sw-cols-2-below ? 2 : root.width < Theme.sw-cols-3-below ? 3 : 4;
    property <length> card-width: min(Theme.sw-card-max-w, root.width - 2 * Theme.sp-7);
    property <int> rows: max(1, (root.cells.length + root.columns - 1) / root.columns);
    property <length> cell-width: min(Theme.sw-cell-w, (root.card-width - 2 * Theme.sp-4 - (root.columns - 1) * Theme.sp-3) / root.columns);
    property <length> cell-height: Theme.sw-cell-h;
    property <length> grid-width: root.columns * root.cell-width + (root.columns - 1) * Theme.sp-3;
    property <length> card-height: Theme.sp-4 + root.rows * root.cell-height + (root.rows - 1) * Theme.sp-3 + Theme.sp-3 + root.pager-h + Theme.sp-4;
    // The card alone, centred. The plate that used to sit under it gave the selected window's
    // title a second time; the cell carries it now, and `describe shell` the full text.
    // Whole pixels, like every centring offset here, so the names in the cells land on them.
    property <length> block-top: Math.round((root.height - root.card-height) / 2 / 1px) * 1px;

    if root.is-open : FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            if (event.text == Key.Return) { root.activate(-1); return accept; }
            if (event.text == Key.Tab) { root.navigate("next", root.columns); return accept; }
            if (event.text == Key.Backtab) { root.navigate("previous", root.columns); return accept; }
            if (event.text == Key.LeftArrow) { root.navigate("left", root.columns); return accept; }
            if (event.text == Key.RightArrow) { root.navigate("right", root.columns); return accept; }
            if (event.text == Key.UpArrow) { root.navigate("up", root.columns); return accept; }
            if (event.text == Key.DownArrow) { root.navigate("down", root.columns); return accept; }
            if (event.text == Key.PageDown) { root.navigate("page-next", root.columns); return accept; }
            if (event.text == Key.PageUp) { root.navigate("page-prev", root.columns); return accept; }
            return reject;
        }

        // The keys sit on the ancestor of everything below, so a key the page buttons do not use
        // (after a click on one, which takes the focus) still reaches the switcher.

        // Outside the card: a click puts the switcher away and changes nothing.
        if root.is-open : TouchArea {
            width: 100%;
            height: 100%;
            clicked => { root.cancel(); }
        }

        if root.is-open : Rectangle {
            x: Math.round((root.width - root.card-width) / 2 / 1px) * 1px;
            y: root.block-top;
            width: root.card-width;
            height: root.card-height;
            background: Theme.bg-surface;
            border-radius: Theme.r-xl;
            border-width: Theme.hairline;
            border-color: Theme.border-strong;

            // Absorbs clicks and the wheel; the wheel pages.
            TouchArea {
                scroll-event(e) => {
                    if (e.delta-y < 0) { root.navigate("page-next", root.columns); return accept; }
                    if (e.delta-y > 0) { root.navigate("page-prev", root.columns); return accept; }
                    return reject;
                }
            }

            if root.cells.length == 0 : Text {
                text: "No windows open";
                color: Theme.text-dim;
                font-size: Theme.fs-body;
                horizontal-alignment: center;
                vertical-alignment: center;
            }

            for cell[i] in root.cells : SwitcherCellView {
                x: Math.round(((parent.width - root.grid-width) / 2 + Math.mod(i, root.columns) * (root.cell-width + Theme.sp-3)) / 1px) * 1px;
                y: Theme.sp-4 + Math.floor(i / root.columns) * (root.cell-height + Theme.sp-3);
                cell-width: root.cell-width;
                cell: cell;
                selected: i == root.selected;
                pointer-moved => { root.hover(i); }
                activated => { root.activate(i); }
            }

            // "9–16 of 37 windows · Page 2 of 5", with the page arrows when there is another page.
            Text {
                x: Theme.sp-4 + (root.pages > 1 ? root.pager-h + Theme.sp-2 : 0px);
                y: parent.height - Theme.sp-4 - root.pager-h;
                width: parent.width - 2 * Theme.sp-4 - (root.pages > 1 ? 2 * (root.pager-h + Theme.sp-2) : 0px);
                height: root.pager-h;
                text: root.status;
                color: Theme.text-dim;
                font-size: Theme.fs-caption;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            if root.pages > 1 : YIconButton {
                x: Theme.sp-4;
                y: parent.height - Theme.sp-4 - root.pager-h;
                width: root.pager-h;
                height: root.pager-h;
                variant: 2;
                label: "Previous page";
                icon-path: Icons.chevron-left;
                clicked => { root.navigate("page-prev", root.columns); }
            }
            if root.pages > 1 : YIconButton {
                x: parent.width - Theme.sp-4 - root.pager-h;
                y: parent.height - Theme.sp-4 - root.pager-h;
                width: root.pager-h;
                height: root.pager-h;
                variant: 2;
                label: "Next page";
                icon-path: Icons.chevron-right;
                clicked => { root.navigate("page-next", root.columns); }
            }
        }
    }
}
