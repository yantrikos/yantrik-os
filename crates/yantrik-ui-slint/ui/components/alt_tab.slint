// Alt+Tab switcher — one centred opaque card of the open windows, 8 to a page.
//
// Selection, order and paging all live in Rust (`alt_tab.rs`), so a pointer, a key and a
// `yos act shell` call move the same state; this file draws what Rust hands it and reports
// what the person pressed. Opaque, with no dimming layer: the windows behind stay readable.
//
// There are no live previews. The compositor streams window titles and focus, not pixels, and
// the shell has no capture path for one toplevel, so every cell shows its app's icon on a
// neutral tile and says so. A tile never pretends to be the window.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";

export struct SwitcherCell {
    title: string,
    app-id: string,
    app-name: string,
}

component SwitcherCellView inherits Rectangle {
    in property <SwitcherCell> cell;
    in property <bool> selected;
    callback pointer-moved();
    callback activated();

    // 224 wide where the card has room (preview 208×117, cell 224×166); a card that is narrower
    // than three or two of those narrows the cells and keeps the preview's 16:9.
    in property <length> cell-width: 224px;
    property <length> preview-width: root.cell-width - 16px;
    property <length> preview-height: root.preview-width * 9 / 16;
    width: root.cell-width;
    height: 8px + root.preview-height + 41px;
    border-radius: Theme.r-lg;
    background: root.selected ? Theme.bg-elevated : transparent;
    // The outline is drawn inside the cell, so a selected cell never overlaps its neighbour.
    border-width: root.selected ? 2px : 0px;
    border-color: Theme.text-primary;

    // The preview slot: 208×117, 16:9.
    Rectangle {
        x: 8px;
        y: 8px;
        width: root.preview-width;
        height: root.preview-height;
        border-radius: Theme.r-md;
        background: Theme.bg-card;
        border-width: 1px;
        border-color: Theme.border-subtle;

        VerticalLayout {
            alignment: center;
            spacing: Theme.sp-2;
            Icon {
                commands: Icons.app-or-window(root.cell.app-id);
                tint: Theme.text-secondary;
                size: 40px;
                thickness: 1.4px;
                x: (parent.width - self.width) / 2;
            }
            Text {
                text: "Preview unavailable";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                horizontal-alignment: center;
            }
        }
    }

    // Footer: 18px icon, then the app's name.
    Icon {
        x: 16px;
        y: 8px + root.preview-height + 16px;
        commands: Icons.app-or-window(root.cell.app-id);
        tint: Theme.text-primary;
        size: 18px;
        thickness: 1.5px;
    }
    Text {
        x: 42px;
        y: 8px + root.preview-height;
        width: parent.width - 42px - 12px;
        height: 41px;
        text: root.cell.app-name;
        color: Theme.text-primary;
        font-size: Theme.fs-caption;
        font-weight: 600;
        vertical-alignment: center;
        overflow: elide;
    }

    TouchArea {
        // A move, not a hover: the pointer sitting where the card opened must not override the
        // keyboard's selection, and `has-hover` is true from the first frame.
        pointer-event(e) => {
            if (e.kind == PointerEventKind.move) { root.pointer-moved(); }
        }
        clicked => { root.activated(); }
    }
}

export component AltTab inherits Rectangle {
    in property <bool> is-open: false;
    in property <[SwitcherCell]> cells: [];
    // Index within `cells` (the current page), or -1.
    in property <int> selected: -1;
    in property <string> status: "";
    in property <string> plate: "";
    in property <int> page: 0;
    in property <int> pages: 1;

    // direction ∈ next, previous, left, right, up, down, page-next, page-prev; the second
    // argument is the column count the card is drawn with, so up and down mean what the person
    // sees.
    callback navigate(string, int);
    callback hover(int);
    callback activate(int);
    callback cancel();

    width: 100%;
    height: 100%;
    visible: root.is-open;

    property <int> columns: root.width < 560px ? 2 : root.width < 760px ? 3 : 4;
    property <length> card-width: min(1040px, root.width - 64px);
    property <int> rows: max(1, (root.cells.length + root.columns - 1) / root.columns);
    property <length> cell-width: min(224px, (root.card-width - 32px - (root.columns - 1) * 12px) / root.columns);
    property <length> cell-height: 8px + (root.cell-width - 16px) * 9 / 16 + 41px;
    property <length> grid-width: root.columns * root.cell-width + (root.columns - 1) * 12px;
    property <length> card-height: 16px + root.rows * root.cell-height + (root.rows - 1) * 12px + 12px + 24px + 16px;

    if root.is-open : FocusScope {
        width: 100%;
        height: 100%;
        init => { self.focus(); }
        key-pressed(event) => {
            if (event.text == Key.Escape) { root.cancel(); return accept; }
            if (event.text == Key.Return) { root.activate(-1); return accept; }
            if (event.text == Key.Tab) { root.navigate("next", root.columns); return accept; }
            if (event.text == Key.Backtab) { root.navigate("previous", root.columns); return accept; }
            if (event.text == Key.LeftArrow) { root.navigate("left", root.columns); return accept; }
            if (event.text == Key.RightArrow) { root.navigate("right", root.columns); return accept; }
            if (event.text == Key.UpArrow) { root.navigate("up", root.columns); return accept; }
            if (event.text == Key.DownArrow) { root.navigate("down", root.columns); return accept; }
            if (event.text == Key.PageDown) { root.navigate("page-next", root.columns); return accept; }
            if (event.text == Key.PageUp) { root.navigate("page-prev", root.columns); return accept; }
            return reject;
        }
    }

    // Outside the card: a click puts the switcher away and changes nothing.
    if root.is-open : TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.cancel(); }
    }

    if root.is-open : Rectangle {
        x: (root.width - root.card-width) / 2;
        y: (root.height - (root.card-height + 8px + 40px)) / 2;
        width: root.card-width;
        height: root.card-height;
        background: Theme.bg-surface;
        border-radius: Theme.r-xl;
        border-width: 1px;
        border-color: Theme.border-strong;

        // Absorbs clicks and the wheel; the wheel pages.
        TouchArea {
            scroll-event(e) => {
                if (e.delta-y < 0) { root.navigate("page-next", root.columns); return accept; }
                if (e.delta-y > 0) { root.navigate("page-prev", root.columns); return accept; }
                return reject;
            }
        }

        if root.cells.length == 0 : Text {
            text: "No windows open";
            color: Theme.text-dim;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            vertical-alignment: center;
        }

        for cell[i] in root.cells : SwitcherCellView {
            x: (parent.width - root.grid-width) / 2 + Math.mod(i, root.columns) * (root.cell-width + 12px);
            y: 16px + Math.floor(i / root.columns) * (root.cell-height + 12px);
            cell-width: root.cell-width;
            cell: cell;
            selected: i == root.selected;
            pointer-moved => { root.hover(i); }
            activated => { root.activate(i); }
        }

        // "9–16 of 37 windows · Page 2 of 5", with the page arrows when there is another page.
        Text {
            x: 16px + (root.pages > 1 ? 40px : 0px);
            y: parent.height - 16px - 24px;
            width: parent.width - 32px - (root.pages > 1 ? 80px : 0px);
            height: 24px;
            text: root.status;
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
        if root.pages > 1 : Rectangle {
            x: 16px;
            y: parent.height - 16px - 24px;
            width: 32px;
            height: 24px;
            border-radius: Theme.r-sm;
            background: pa.has-hover ? Theme.bg-card : transparent;
            Text { text: "‹"; color: Theme.text-secondary; font-size: Theme.fs-body; horizontal-alignment: center; vertical-alignment: center; }
            pa := TouchArea { clicked => { root.navigate("page-prev", root.columns); } }
        }
        if root.pages > 1 : Rectangle {
            x: parent.width - 16px - 32px;
            y: parent.height - 16px - 24px;
            width: 32px;
            height: 24px;
            border-radius: Theme.r-sm;
            background: pb.has-hover ? Theme.bg-card : transparent;
            Text { text: "›"; color: Theme.text-secondary; font-size: Theme.fs-body; horizontal-alignment: center; vertical-alignment: center; }
            pb := TouchArea { clicked => { root.navigate("page-next", root.columns); } }
        }
    }

    // The selected window's full title, on a plate of its own under the card.
    if root.is-open && root.plate != "" : Rectangle {
        property <length> plate-width: min(720px, root.card-width);
        x: (root.width - self.plate-width) / 2;
        y: (root.height - (root.card-height + 8px + 40px)) / 2 + root.card-height + 8px;
        width: self.plate-width;
        height: 40px;
        background: Theme.bg-surface;
        border-radius: Theme.r-lg;
        border-width: 1px;
        border-color: Theme.border-strong;
        Text {
            x: 16px;
            width: parent.width - 32px;
            text: root.plate;
            color: Theme.text-primary;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
