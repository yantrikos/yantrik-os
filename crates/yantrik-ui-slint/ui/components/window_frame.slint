// WindowFrame — reusable window chrome with glass title bar.
// Holographic glow, glass gradient background, animated controls.
// Semi-transparent body for depth. Use @children to place content inside.
// Supports drag-to-move (title bar) and drag-to-resize (edges/corners).

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { WindowControls } from "window_controls.slint";

// Invisible resize handle — placed on window edges/corners.
// Updates win-x/y/w/h based on which edges are active.
component ResizeHandle inherits TouchArea {
    in property <bool> resize-top: false;
    in property <bool> resize-bottom: false;
    in property <bool> resize-left: false;
    in property <bool> resize-right: false;
    in-out property <length> win-x;
    in-out property <length> win-y;
    in-out property <length> win-w;
    in-out property <length> win-h;
    in property <length> min-w: 400px;
    in property <length> min-h: 300px;

    property <length> press-mx;
    property <length> press-my;

    pointer-event(event) => {
        if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
            press-mx = self.mouse-x;
            press-my = self.mouse-y;
        }
    }

    moved => {
        if self.pressed {
            if root.resize-right {
                root.win-w = max(root.min-w, root.win-w + self.mouse-x - root.press-mx);
            }
            if root.resize-bottom {
                root.win-h = max(root.min-h, root.win-h + self.mouse-y - root.press-my);
            }
            if root.resize-left {
                if root.win-w - (self.mouse-x - root.press-mx) >= root.min-w {
                    root.win-x = root.win-x + (self.mouse-x - root.press-mx);
                    root.win-w = root.win-w - (self.mouse-x - root.press-mx);
                }
            }
            if root.resize-top {
                if root.win-h - (self.mouse-y - root.press-my) >= root.min-h {
                    root.win-y = root.win-y + (self.mouse-y - root.press-my);
                    root.win-h = root.win-h - (self.mouse-y - root.press-my);
                }
            }
        }
    }
}

export component WindowFrame inherits Rectangle {
    in property <string> title: "";
    in property <string> icon-char: "";
    /// Stroke glyph from the Icons global; when set it replaces icon-char.
    in property <string> icon-path: "";
    in property <color> icon-color: Theme.cyan;
    in-out property <bool> is-maximized: true;

    // Window geometry (when not maximized) — bind with <=> from parent
    in-out property <length> win-x: 80px;
    in-out property <length> win-y: 40px;
    in-out property <length> win-w: 1000px;
    in-out property <length> win-h: 650px;

    property <length> min-w: 400px;
    property <length> min-h: 300px;
    property <length> hs: 6px;   // edge handle thickness
    property <length> cs: 14px;  // corner handle size

    callback close();
    callback minimize();

    // Whether the screen inside this frame draws its own window controls.
    //
    // Eight of the shell's screens use AppHeader and can carry them; six still draw a bespoke
    // header row and cannot yet. Hiding this title bar unconditionally when maximized is what
    // left those six with no minimise, no restore and no close at all -- enter Settings and the
    // only way out was a back arrow. So the frame keeps its own bar exactly for the screens
    // that have not taken the job over, and this flag says which those are rather than the
    // answer being an accident of which file somebody edited last.
    in property <bool> content-has-controls: false;

    // Glass body — semi-transparent deep background. Slint's software renderer (GPU-less machines, VM 520) paints a gradient
    // fill as a square inside the rounded border (#172), so a rounded window's fill is solid.
    background: Theme.bg-deep.transparentize(9%);
    border-radius: root.is-maximized ? 0px : 12px;
    clip: true;
    drop-shadow-blur: root.is-maximized ? 0px : 24px;
    drop-shadow-color: root.is-maximized ? transparent : Theme.overlay-shadow;
    border-width: root.is-maximized ? 0px : 1px;
    border-color: root.is-maximized ? transparent : @linear-gradient(180deg,
        Theme.border-strong 0%,
        Theme.separator 50%,
        Theme.border-subtle 100%
    );

    animate border-radius, drop-shadow-blur, border-width { duration: 200ms; easing: ease-out; }

    VerticalLayout {
        spacing: 0px;

        // ── Title bar — glass gradient ──
        //
        // Not drawn when the window is maximized, and that is the whole fix for something every
        // shell screen had: a WindowFrame title bar saying "Memory", directly above the screen's
        // own header saying "Memories". Two title bars, on every screen, one of them redundant.
        //
        // Maximized here means a shell screen filling the display, and a screen filling the
        // display is not a window — it is what the OS is showing you. Its own header, with its
        // own back arrow, is the header. Every screen has one; that was checked against
        // photographs of all ten before this line was written, not assumed.
        //
        // A floating window still gets the bar, because that is where its drag handle and its
        // controls live and there is nothing else to move it by.
        //
        // The frame's `clip: true` does not round what it clips under the software renderer, so
        // the bar rounds its own top corners to match the frame's, and its fill is solid for the
        // same reason as the frame's (#172).
        if !root.is-maximized || !root.content-has-controls : Rectangle {
            height: 36px;
            border-top-left-radius: root.is-maximized ? 0px : 12px;
            border-top-right-radius: root.is-maximized ? 0px : 12px;
            background: Theme.bg-surface.transparentize(44%);

            // Top edge reflection
            Rectangle {
                x: 12px; y: 0;
                width: parent.width - 24px;
                height: 1px;
                background: @linear-gradient(90deg,
                    transparent 0%,
                    Theme.border-default 30%,
                    Theme.border-strong 50%,
                    Theme.border-default 70%,
                    transparent 100%
                );
            }

            // Drag TouchArea — covers entire title bar, behind buttons
            title-drag := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: root.is-maximized ? default : move;

                property <length> press-mx;
                property <length> press-my;

                pointer-event(event) => {
                    if event.button == PointerEventButton.left && event.kind == PointerEventKind.down {
                        press-mx = self.mouse-x;
                        press-my = self.mouse-y;
                    }
                }

                moved => {
                    if self.pressed && !root.is-maximized {
                        root.win-x += self.mouse-x - press-mx;
                        root.win-y += self.mouse-y - press-my;
                    }
                }
            }

            // Visual layout on top of drag area
            HorizontalLayout {
                padding-left: 12px;
                padding-right: 0px;

                // Left: icon + title.
                //
                // Dropped when this bar is only here because the screen below draws no controls
                // of its own -- that screen has its own header one row down, with its own icon
                // and the same word in it. Two bars is the honest transitional state; two bars
                // both captioned "Settings" is just untidy.
                HorizontalLayout {
                    spacing: 8px;
                    alignment: start;
                    horizontal-stretch: 1;
                    visible: !root.is-maximized || !root.content-has-controls;

                    if root.icon-char != "" || root.icon-path != "" : Rectangle {
                        width: 22px;
                        height: 22px;
                        y: (parent.height - 22px) / 2;
                        border-radius: 5px;
                        background: root.icon-color.with-alpha(0.16);

                        if root.icon-path != "" : Icon {
                            commands: root.icon-path;
                            size: 14px;
                            tint: root.icon-color;
                            thickness: 1.7px;
                            x: (parent.width - self.width) / 2;
                            y: (parent.height - self.height) / 2;
                        }
                        if root.icon-path == "" : Text {
                            text: root.icon-char;
                            color: root.icon-color;
                            font-size: Theme.fs-micro;
                            font-weight: 600;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }

                    if root.title != "" : Text {
                        text: root.title;
                        color: Theme.text-secondary;
                        font-size: Theme.fs-body;
                        font-weight: 500;
                        vertical-alignment: center;
                        overflow: elide;
                    }
                }

                // Right: window controls.
                //
                // The same component the shell screens and (later) the standalone apps draw, rather
                // than the three 36x36 TouchAreas that used to be written out here. One control with
                // one hover behaviour, or the OS has two close buttons that look slightly different
                // depending on which surface you are looking at -- which is what it had.
                WindowControls {
                    bar-height: 36px;
                    maximized: root.is-maximized;
                    minimize => { root.minimize(); }
                    toggle-maximize => { root.is-maximized = !root.is-maximized; }
                    close => { root.close(); }
                }
            }
        }

        // Separator — holographic edge
        Rectangle {
            height: 1px;
            background: @linear-gradient(90deg,
                transparent 5%,
                Theme.separator 20%,
                Theme.cyan-glow 50%,
                Theme.separator 80%,
                transparent 95%
            );
            opacity: 0.6;
        }

        // Content area — slightly translucent
        Rectangle {
            vertical-stretch: 1;
            clip: true;
            background: Theme.bg-deep.transparentize(15%);
            @children
        }
    }

    // ── Resize handles (only when not maximized) ──

    // N (top edge)
    if !root.is-maximized : ResizeHandle {
        x: root.cs; y: 0;
        width: root.width - 2 * root.cs; height: root.hs;
        mouse-cursor: n-resize;
        resize-top: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // S (bottom edge)
    if !root.is-maximized : ResizeHandle {
        x: root.cs; y: root.height - root.hs;
        width: root.width - 2 * root.cs; height: root.hs;
        mouse-cursor: s-resize;
        resize-bottom: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // E (right edge)
    if !root.is-maximized : ResizeHandle {
        x: root.width - root.hs; y: root.cs;
        width: root.hs; height: root.height - 2 * root.cs;
        mouse-cursor: e-resize;
        resize-right: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // W (left edge)
    if !root.is-maximized : ResizeHandle {
        x: 0; y: root.cs;
        width: root.hs; height: root.height - 2 * root.cs;
        mouse-cursor: w-resize;
        resize-left: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // NE corner
    if !root.is-maximized : ResizeHandle {
        x: root.width - root.cs; y: 0;
        width: root.cs; height: root.cs;
        mouse-cursor: ne-resize;
        resize-top: true; resize-right: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // SE corner
    if !root.is-maximized : ResizeHandle {
        x: root.width - root.cs; y: root.height - root.cs;
        width: root.cs; height: root.cs;
        mouse-cursor: se-resize;
        resize-bottom: true; resize-right: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // SW corner
    if !root.is-maximized : ResizeHandle {
        x: 0; y: root.height - root.cs;
        width: root.cs; height: root.cs;
        mouse-cursor: sw-resize;
        resize-bottom: true; resize-left: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }

    // NW corner
    if !root.is-maximized : ResizeHandle {
        x: 0; y: 0;
        width: root.cs; height: root.cs;
        mouse-cursor: nw-resize;
        resize-top: true; resize-left: true;
        win-x <=> root.win-x; win-y <=> root.win-y;
        win-w <=> root.win-w; win-h <=> root.win-h;
        min-w: root.min-w; min-h: root.min-h;
    }
}
