// App Grid — the launcher. Everything installed lives here, behind the taskbar's Apps button.
//
// Search on top, categories down the left, a grid of everything on the right. Every tile carries
// a pin: this is the one place every app is listed, so it is the one place a pin can always be
// made or undone, and what is pinned is what START shows. The categories
// come straight from the freedesktop `Categories=` field the scanner already reads, so a new
// .desktop file files itself. Icons are real where the icon theme has one and a stroke glyph
// for the app's category where it does not — a labelled shape, never a letter in a box.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { AppTile } from "app_tile.slint";

// One power button in the launcher's footer; the footer names it on hover.
component PowerButton inherits TouchArea {
    in property <string> icon;
    in property <string> label;
    width: 32px;
    height: 28px;
    Rectangle {
        border-radius: 8px;
        background: root.has-hover ? Theme.hover-fill : transparent;
        Icon {
            commands: root.icon;
            size: 16px;
            tint: root.has-hover ? Theme.text-primary : Theme.text-secondary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

export struct AppGridItem {
    app-id: string,
    name: string,
    icon-char: string,   // legacy single-char badge; kept so older call sites still compile
    // The id to draw an icon FOR, which is not always the id to launch BY. A .desktop file is
    // named yantrik-notes, because a freedesktop entry needs a name unique on the whole
    // machine; the icon set is keyed by "notes", because that is what the rest of this shell
    // calls it. Carrying both is cheaper than making either lie.
    icon-id: string,
    icon: image,         // resolved from the icon theme, when it could be
    has-icon: bool,
    category: string,    // development | office | network | audiovideo | graphics | game | system | settings | utility
    pinned: bool,        // shown on the desktop's START row
    pinnable: bool,      // false for the launcher itself, which already has a button
}

export struct CategoryItem {
    id: string,
    name: string,
    count: int,
}

export component AppGrid inherits Rectangle {
    in-out property <bool> is-open: false;
    in property <[AppGridItem]> apps: [];
    in property <[CategoryItem]> categories: [];
    in property <string> active-category: "all";

    callback launch-app(string);
    callback close();
    callback search-changed(string);
    callback category-selected(string);
    callback toggle-pin(string);
    // Lock, sleep, restart, shut down: where every other desktop keeps them, in the launcher.
    callback power-action(string);

    width: 100%;
    height: 100%;

    property <int> columns: max(1, min(5, floor((root.width - root.rail-w - 72px) / (root.cell-w + root.cell-gap))));
    property <length> cell-w: 118px;
    property <length> cell-h: 106px;
    property <length> cell-gap: 6px;
    property <length> rail-w: root.width < 700px ? 136px : 176px;
    property <length> grid-w: root.columns * root.cell-w + (root.columns - 1) * root.cell-gap;
    property <length> panel-w: root.rail-w + root.grid-w + 16px * 3;
    property <int> selected-index: 0;

    changed apps => { root.selected-index = 0; }
    changed is-open => { if root.is-open { root.selected-index = 0; } }

    // Backdrop (click to close)
    if root.is-open : TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.is-open = false; root.close(); }
        Rectangle { width: 100%; height: 100%; background: Theme.overlay-backdrop; }
    }

    if root.is-open : Rectangle {
        // A fixed frame, deliberately.
        //
        // This used to be sized from the number of apps currently showing, so picking a category
        // changed the row count, which changed the height, which re-centred the panel — the
        // launcher jumped and resized under the pointer every time you filtered it, and the icon
        // you were reaching for moved. The grid inside already scrolls; only its contents should
        // change when you filter, never the frame around them.
        property <length> panel-h: min(parent.height - 80px, 620px);
        x: (parent.width - root.panel-w) / 2;
        y: (parent.height - self.panel-h) / 2;
        width: root.panel-w;
        height: self.panel-h;
        background: Theme.bg-card;
        border-radius: Theme.r-xl;
        border-width: 1px;
        border-color: Theme.glass-border-strong;
        clip: true;

        // Block click-through to the backdrop
        TouchArea { width: 100%; height: 100%; }

        FocusScope {
            // Keep typing in search while arrow keys select a result.
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) { root.is-open = false; root.close(); return accept; }
                if (event.text == Key.Tab && root.apps.length == 0) { return accept; }
                if (root.apps.length > 0) {
                    if (event.text == Key.Tab) { root.selected-index = mod(root.selected-index + (event.modifiers.shift ? root.apps.length - 1 : 1), root.apps.length); return accept; }
                    if (event.text == Key.RightArrow && search-input.text == "") { root.selected-index = min(root.apps.length - 1, root.selected-index + 1); return accept; }
                    if (event.text == Key.LeftArrow && search-input.text == "") { root.selected-index = max(0, root.selected-index - 1); return accept; }
                    if (event.text == Key.DownArrow) { root.selected-index = min(root.apps.length - 1, root.selected-index + root.columns); return accept; }
                    if (event.text == Key.UpArrow) { root.selected-index = max(0, root.selected-index - root.columns); return accept; }
                    if (event.text == "\n") { root.launch-app(root.apps[root.selected-index].app-id); root.is-open = false; root.close(); return accept; }
                }
                reject
            }

        VerticalLayout {
            spacing: 0;

            // ── Search ──
            Rectangle {
                height: 68px;
                background: transparent;
                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.separator; }

                HorizontalLayout {
                    padding-left: 18px;
                    padding-right: 14px;
                    spacing: Theme.sp-3;

                    Icon {
                        commands: Icons.search;
                        size: 16px;
                        thickness: 1.7px;
                        tint: search-input.has-focus ? Theme.accent : Theme.text-dim;
                        y: (parent.height - self.height) / 2;
                    }
                    search-input := TextInput {
                        init => { self.focus(); }
                        single-line: true;
                        vertical-alignment: center;
                        font-size: Theme.fs-body;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        edited => { root.selected-index = 0; root.search-changed(self.text); }
                    }
                    Rectangle {
                        width: esc.preferred-width + 12px;
                        height: 20px;
                        y: (parent.height - 20px) / 2;
                        border-radius: Theme.r-xs;
                        background: Theme.hover-fill;
                        esc := Text {
                            text: "esc";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if search-input.text == "" : Text {
                    x: 18px + 16px + Theme.sp-3;
                    height: 100%;
                    text: "Find an app…";
                    color: Theme.text-dim;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                }
            }

            HorizontalLayout {
                vertical-stretch: 1;
                spacing: 0;

                // ── Categories ──
                Rectangle {
                    width: root.rail-w;
                    background: Theme.glass-panel;
                    Rectangle { x: parent.width - 1px; width: 1px; height: 100%; background: Theme.separator; }

                    VerticalLayout {
                        padding: 10px;
                        spacing: 1px;
                        alignment: start;

                        for c in root.categories : cat := TouchArea {
                            height: 36px;
                            mouse-cursor: pointer;
                            property <bool> active: c.id == root.active-category;
                            clicked => { root.category-selected(c.id); }

                            Rectangle {
                                width: 100%; height: 100%;
                                border-radius: Theme.r-md;
                                background: cat.active ? Theme.tint-accent
                                          : cat.has-hover ? Theme.hover-fill
                                          : transparent;
                                HorizontalLayout {
                                    padding-left: 10px;
                                    padding-right: 10px;
                                    spacing: 8px;
                                    Text {
                                        text: c.name;
                                        color: cat.active ? Theme.accent : Theme.text-secondary;
                                        font-size: Theme.font-label;
                                        font-weight: cat.active ? 500 : 400;
                                        vertical-alignment: center;
                                        horizontal-stretch: 1;
                                    }
                                    Text {
                                        text: c.count;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }
                    }
                }

                // ── Grid ──
                VerticalLayout {
                    horizontal-stretch: 1;
                    padding: 16px;
                    spacing: 10px;

                    if root.apps.length == 0 : VerticalLayout {
                        vertical-stretch: 1;
                        alignment: center;
                        spacing: Theme.sp-2;
                        Text {
                            text: "Nothing matches";
                            color: Theme.text-secondary;
                            font-size: Theme.fs-headline;
                            font-weight: Theme.fw-headline;
                            horizontal-alignment: center;
                        }
                        Text {
                            text: "Try another word, or a different category.";
                            color: Theme.text-dim;
                            font-size: Theme.fs-caption;
                            horizontal-alignment: center;
                        }
                    }

                    if root.apps.length > 0 : Flickable {
                        vertical-stretch: 1;
                        viewport-width: self.width;
                        viewport-height: ceil(root.apps.length / root.columns) * (root.cell-h + root.cell-gap);
                        // Selection stays visible even when the result list is longer than a page.
                        viewport-y: -max(0px, min(self.viewport-height - self.height,
                            floor(root.selected-index / root.columns) * (root.cell-h + root.cell-gap) - self.height + root.cell-h + root.cell-gap));

                        for app[idx] in root.apps : cell := TouchArea {
                            x: Math.mod(idx, root.columns) * (root.cell-w + root.cell-gap);
                            y: Math.floor(idx / root.columns) * (root.cell-h + root.cell-gap);
                            width: root.cell-w;
                            height: root.cell-h;
                            mouse-cursor: pointer;
                            accessible-role: button;
                            accessible-label: app.name;
                            accessible-action-default => { root.launch-app(app.app-id); root.is-open = false; root.close(); }
                            clicked => {
                                root.launch-app(app.app-id);
                                root.is-open = false;
                                root.close();
                            }

                            Rectangle {
                                width: 100%; height: 100%;
                                border-radius: Theme.r-md;
                                background: idx == root.selected-index ? Theme.tint-accent : cell.has-hover ? Theme.hover-fill : transparent;
                                border-width: 1px;
                                border-color: idx == root.selected-index ? Theme.accent.transparentize(55%) : transparent;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 7px;
                                    padding: 8px;

                                    // The app's own tile, the same object the desktop's workspace
                                    // row and the taskbar draw (AppTile). These were all
                                    // Theme.text-secondary once — thirty-three applications in
                                    // one grey — and then a faint tint with a coloured stroke,
                                    // which still read as grey squares at a glance.
                                    HorizontalLayout {
                                        alignment: center;
                                        AppTile {
                                            size: 44px;
                                            app-id: app.icon-id;
                                            glyph: Icons.app-or-category(app.icon-id, app.category);
                                            has-icon: app.has-icon;
                                            icon: app.icon;
                                            hovered: cell.has-hover;
                                        }
                                    }

                                    Text {
                                        text: app.name;
                                        color: Theme.text-primary;
                                        font-size: Theme.fs-caption;
                                        horizontal-alignment: center;
                                        overflow: elide;
                                    }
                                }

                                // ── Pin ──
                                //
                                // A badge on the icon's corner, the way Windows marks a pinned tile and
                                // macOS badges a Dock icon. Shown on hover so forty tiles are not forty
                                // buttons, and always shown once pinned, so the grid answers "which of
                                // these are on my desktop" at a glance.
                                //
                                // On the ICON, not the cell. It first sat at the cell's top-right, which
                                // is 40px from the icon and 6px from the next tile — so Calendar's pin
                                // read as belonging to Chromium, and Chromium's to Containers. A badge
                                // that could be anybody's is not a badge.
                                //
                                // Placed from the cell's centre because the icon box is centred: the box
                                // is 44px wide, so its right edge is centre + 22px, and a 22px badge
                                // starting at centre + 12px straddles that corner. Vertically the tile's
                                // content is centred in 96px, which puts the box's top edge at ~14px.
                                //
                                // Declared after the tile's content, so it sits on top and takes the
                                // click: pinning must not also launch the app and close the grid.
                                pin-hit := TouchArea {
                                    x: parent.width / 2 + 12px;
                                    y: 3px;
                                    width: 22px;
                                    height: 22px;
                                    visible: app.pinnable && (cell.has-hover || app.pinned);
                                    mouse-cursor: pointer;
                                    clicked => { root.toggle-pin(app.app-id); }

                                    Rectangle {
                                        width: 100%; height: 100%;
                                        border-radius: self.width / 2;
                                        // Opaque, with an edge, so it reads as sitting ON the icon box
                                        // rather than as a smudge beside it.
                                        background: pin-hit.has-hover ? Theme.bg-elevated : Theme.bg-card;
                                        border-width: 1px;
                                        border-color: app.pinned ? Theme.accent.transparentize(40%)
                                                    : Theme.border-strong;
                                        Icon {
                                            commands: Icons.pushpin;
                                            size: 12px;
                                            thickness: 1.7px;
                                            tint: app.pinned ? Theme.accent
                                                : pin-hit.has-hover ? Theme.text-primary
                                                : Theme.text-dim;
                                            x: (parent.width - self.width) / 2;
                                            y: (parent.height - self.height) / 2;
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }
            Rectangle {
                height: 34px;
                background: Theme.glass-panel;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 12px;
                    spacing: 4px;
                    footer-text := Text {
                        property <string> power-hint: lock-btn.has-hover ? "Lock the screen" : sleep-btn.has-hover ? "Sleep" : restart-btn.has-hover ? "Restart" : shutdown-btn.has-hover ? "Shut down" : "";
                        text: self.power-hint != "" ? self.power-hint : root.apps.length + " applications";
                        font-size: Theme.fs-caption;
                        color: self.power-hint != "" ? Theme.text-primary : Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text { text: "Tab / ↑ ↓  Select     Enter  Open     Esc  Close"; font-size: Theme.fs-caption; color: Theme.text-secondary; vertical-alignment: center; }
                    Rectangle { width: 14px; }
                    lock-btn := PowerButton {
                        icon: Icons.lock; label: "Lock";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("lock"); root.is-open = false; root.close(); }
                    }
                    sleep-btn := PowerButton {
                        icon: Icons.moon; label: "Sleep";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("suspend"); root.is-open = false; root.close(); }
                    }
                    restart-btn := PowerButton {
                        icon: Icons.refresh; label: "Restart";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("restart"); root.is-open = false; root.close(); }
                    }
                    shutdown-btn := PowerButton {
                        icon: Icons.power; label: "Shut down";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("shutdown"); root.is-open = false; root.close(); }
                    }
                }
            }
        }
        }
    }
}
