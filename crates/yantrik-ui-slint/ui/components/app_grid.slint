// App Grid — the launcher. The one place every app is listed, behind the dock's Apps button
// and Super+Space (design/minds-surfaces-spec §3).
//
// An opaque centred panel. The search field has the keyboard when it opens. Two sections:
//   Running    the apps that have a window, with how many (the same snapshot the dock draws from)
//   All apps   everything installed
// Both are grids of the dock's own tile (AppTile, full colour, rounded square), only bigger, so
// Files is the same blue square here as on the dock. Typing filters both; Enter opens the top
// match; the arrows move; Esc closes. An app a mind opened is never in Running: the model is the
// person's window list, which leaves those out.
//
// Every All-apps tile carries a pin: this is the one place every app is listed, so it is the one
// place a pin can always be made or undone, and what is pinned is what START shows. Icons are
// real where the icon theme has one and a stroke glyph for the app's category where it does not
// — a labelled shape, never a letter in a box.
//
// There used to be a category rail beside the grid. Search finds an app faster than a rail does
// and a second filter that composed with the first had its own bugs, so the rail went; the
// freedesktop category still picks the glyph of an app with no icon.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { AppTile } from "app_tile.slint";
import { AppLabel } from "app_label.slint";
import { DockButton } from "grounded_dock.slint";

// One power button in the launcher's footer; the footer names it on hover.
component PowerButton inherits TouchArea {
    in property <string> icon;
    in property <string> label;
    width: 32px;
    height: 28px;
    Rectangle {
        border-radius: 8px;
        background: root.has-hover ? Theme.hover-fill : transparent;
        Icon {
            commands: root.icon;
            size: 16px;
            tint: root.has-hover ? Theme.text-primary : Theme.text-secondary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

export struct AppGridItem {
    app-id: string,
    name: string,
    icon-char: string,   // legacy single-char badge; kept so older call sites still compile
    // The id to draw an icon FOR, which is not always the id to launch BY. A .desktop file is
    // named yantrik-notes, because a freedesktop entry needs a name unique on the whole
    // machine; the icon set is keyed by "notes", because that is what the rest of this shell
    // calls it. Carrying both is cheaper than making either lie.
    icon-id: string,
    icon: image,         // resolved from the icon theme, when it could be
    has-icon: bool,
    category: string,    // development | office | network | audiovideo | graphics | game | system | settings | utility
    pinned: bool,        // shown on the desktop's START row
    pinnable: bool,      // false for the launcher itself, which already has a button
}

// One tile of the launcher: the dock's AppTile at launcher size, the name under it, and a
// numeral when the app has several windows. The two grids share it so a running app and the
// same app under All apps look like one thing.
component LauncherCell inherits Rectangle {
    in property <string> name;
    in property <string> icon-id;
    in property <string> glyph;
    in property <bool> has-icon: false;
    in property <image> icon;
    in property <bool> selected: false;
    in property <int> windows: 0;
    in property <bool> pinnable: false;
    in property <bool> pinned: false;
    callback clicked();
    callback toggle-pin();

    border-radius: Theme.r-md;
    background: root.selected ? Theme.dock-raised : touch.has-hover ? Theme.hover-fill : transparent;
    border-width: root.selected ? 1px : 0px;
    border-color: Theme.focus-ring;
    accessible-role: button;
    accessible-label: root.windows > 1 ? root.name + ", " + root.windows + " windows" : root.name;
    accessible-action-default => { root.clicked(); }

    touch := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    // The tile and its name, centred in the cell by a whole-pixel offset. `alignment: center`
    // put them 13.5px down a 112px cell, and the name with them.
    property <length> content-h: 48px + 7px + 2 * Theme.lh-label;
    VerticalLayout {
        alignment: start;
        spacing: 7px;
        padding-left: 8px;
        padding-right: 8px;
        padding-top: Math.round((root.height - root.content-h) / 2 / 1px) * 1px;

        HorizontalLayout {
            alignment: center;
            AppTile {
                size: 48px;
                app-id: root.icon-id;
                glyph: root.glyph;
                has-icon: root.has-icon;
                icon: root.icon;
                hovered: touch.has-hover;
            }
        }
        AppLabel { text: root.name; lines: 2; }
    }

    // Several windows: the dock's neutral numeral, on the tile's corner.
    if root.windows > 1 : Rectangle {
        x: parent.width / 2 + 12px;
        y: 4px;
        width: max(Theme.dock-numeral, num.preferred-width + 6px);
        height: Theme.dock-numeral;
        border-radius: Theme.dock-numeral / 2;
        background: Theme.dock-bar;
        border-width: 1px;
        border-color: Theme.dock-raised-line;
        num := Text {
            text: root.windows;
            color: Theme.text-secondary;
            font-size: Theme.fs-micro;
            font-weight: 600;
            horizontal-alignment: center;
            vertical-alignment: center;
        }
    }

    // A bare pin on the icon's corner, shown on hover so forty tiles are not forty buttons, and
    // always once pinned, so the grid answers "which of these are on my desktop" at a glance.
    // It sits ON the icon (centre + 12px starts it inside the 48px tile's right edge), not at
    // the cell's corner, where it read as belonging to the next tile. Declared last so it takes
    // the click: pinning must not also launch the app and close the launcher.
    //
    // A 10px glyph at 60%, with no disc behind it. It was a dark round badge, and a dark round
    // badge on an app's corner is where a desktop puts an unread count. The press area stays
    // 22px, so the smaller glyph is not a smaller target.
    pin-hit := TouchArea {
        x: parent.width / 2 + 14px;
        y: 3px;
        width: 22px;
        height: 22px;
        visible: root.pinnable && (touch.has-hover || pin-hit.has-hover || root.pinned);
        mouse-cursor: pointer;
        accessible-role: button;
        accessible-label: root.pinned ? "Unpin " + root.name : "Pin " + root.name;
        clicked => { root.toggle-pin(); }

        Icon {
            commands: Icons.pushpin;
            size: 10px;
            thickness: 1.7px;
            opacity: pin-hit.has-hover ? 1.0 : 0.6;
            tint: root.pinned ? Theme.accent : Theme.text-primary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component AppGrid inherits Rectangle {
    in-out property <bool> is-open: false;
    // All apps, already filtered by the search (wire/app_grid.rs).
    in property <[AppGridItem]> apps: [];
    // Running apps, already filtered: the dock's rows for the apps that have a window.
    in property <[DockButton]> running: [];

    callback launch-app(string);
    callback close();
    callback search-changed(string);
    callback toggle-pin(string);
    // Lock, sleep, restart, shut down: where every other desktop keeps them, in the launcher.
    callback power-action(string);

    width: 100%;
    height: 100%;

    property <length> cell-w: 104px;
    // Room for a name on two lines under the 48px tile.
    property <length> cell-h: 112px;
    property <length> cell-gap: 6px;
    property <length> head-h: 30px;
    property <length> section-gap: 10px;
    property <length> panel-w: min(root.width - 64px, 760px);
    property <int> columns: max(1, floor((root.panel-w - 40px + root.cell-gap) / (root.cell-w + root.cell-gap)));
    property <length> grid-w: root.columns * root.cell-w + (root.columns - 1) * root.cell-gap;
    property <int> run-count: root.running.length;
    property <int> total: root.running.length + root.apps.length;
    property <length> run-h: root.run-count == 0 ? 0px
        : root.head-h + ceil(root.run-count / root.columns) * (root.cell-h + root.cell-gap) + root.section-gap;
    property <length> apps-top: root.run-h;
    property <length> content-h: root.apps-top + root.head-h + ceil(root.apps.length / root.columns) * (root.cell-h + root.cell-gap) + 8px;
    property <int> selected-index: 0;
    // The panel is a fixed frame; the list is what is left of it under the search row and over the footer.
    property <length> panel-h: min(root.height - 80px, 640px);
    property <length> list-h: root.panel-h - 60px - 36px;
    property <length> scroll-y: 0px;

    changed apps => { root.selected-index = 0; root.scroll-y = 0px; }
    changed running => { root.selected-index = min(root.selected-index, max(0, root.total - 1)); }
    changed is-open => { if root.is-open { root.selected-index = 0; root.scroll-y = 0px; } }
    changed selected-index => { root.reveal(); }

    // The top of the selected tile, in the scrolled content.
    pure function top-of(idx: int) -> length {
        return idx < root.run-count
            ? root.head-h + floor(idx / root.columns) * (root.cell-h + root.cell-gap)
            : root.apps-top + root.head-h + floor((idx - root.run-count) / root.columns) * (root.cell-h + root.cell-gap);
    }

    // Keep the selected tile in view: the arrows can walk off the bottom of a long list.
    function reveal() {
        if (root.total == 0) { return; }
        // The header of the first tile's section is part of what scrolls to the top with it.
        if (root.top-of(root.selected-index) < -root.scroll-y + root.head-h) {
            root.scroll-y = min(0px, -(root.top-of(root.selected-index) - root.head-h));
        } else if (root.top-of(root.selected-index) + root.cell-h > -root.scroll-y + root.list-h) {
            root.scroll-y = -(root.top-of(root.selected-index) + root.cell-h - root.list-h + 8px);
        }
    }

    function open-selected() {
        if (root.total == 0) { return; }
        if (root.selected-index < root.run-count) {
            root.launch-app(root.running[root.selected-index].app-id);
        } else {
            root.launch-app(root.apps[root.selected-index - root.run-count].app-id);
        }
        root.is-open = false;
        root.close();
    }

    // Down and up cross from Running into All apps by column, not by index: the two sections
    // have rows of their own, and a linear step would land on whatever happened to be next.
    function step-down() {
        let sel = root.selected-index;
        if (sel < root.run-count && sel + root.columns >= root.run-count) {
            if (root.apps.length > 0) { root.selected-index = root.run-count + min(mod(sel, root.columns), root.apps.length - 1); }
        } else {
            root.selected-index = min(root.total - 1, sel + root.columns);
        }
    }
    function step-up() {
        let sel = root.selected-index;
        if (sel >= root.run-count && sel - root.columns < root.run-count) {
            if (root.run-count > 0) {
                root.selected-index = min(root.run-count - 1, floor((root.run-count - 1) / root.columns) * root.columns + mod(sel - root.run-count, root.columns));
            }
        } else {
            root.selected-index = max(0, sel - root.columns);
        }
    }

    // Backdrop (click to close)
    if root.is-open : TouchArea {
        width: 100%;
        height: 100%;
        clicked => { root.is-open = false; root.close(); }
        Rectangle { width: 100%; height: 100%; background: Theme.overlay-backdrop; }
    }

    if root.is-open : Rectangle {
        // A fixed frame, deliberately. It used to be sized from the number of apps showing, so
        // filtering changed the row count, which re-centred the panel: the launcher jumped under
        // the pointer and the icon you were reaching for moved. Only the contents change.
        // Centred on whole pixels, so every name in it is too.
        x: Math.round((parent.width - root.panel-w) / 2 / 1px) * 1px;
        y: Math.round((parent.height - root.panel-h) / 2 / 1px) * 1px;
        width: root.panel-w;
        height: root.panel-h;
        background: Theme.panel-solid;
        border-radius: Theme.r-xl;
        border-width: 1px;
        border-color: Theme.border-card;
        clip: true;

        // Block click-through to the backdrop
        TouchArea { width: 100%; height: 100%; }

        FocusScope {
            // Keep typing in search while the arrow keys move the selection.
            capture-key-pressed(event) => {
                if (event.text == Key.Escape) { root.is-open = false; root.close(); return accept; }
                if (root.total > 0) {
                    if (event.text == Key.Tab) { root.selected-index = mod(root.selected-index + (event.modifiers.shift ? root.total - 1 : 1), root.total); return accept; }
                    if (event.text == Key.RightArrow) { root.selected-index = min(root.total - 1, root.selected-index + 1); return accept; }
                    if (event.text == Key.LeftArrow) { root.selected-index = max(0, root.selected-index - 1); return accept; }
                    if (event.text == Key.DownArrow) { root.step-down(); return accept; }
                    if (event.text == Key.UpArrow) { root.step-up(); return accept; }
                    if (event.text == "\n") { root.open-selected(); return accept; }
                }
                reject
            }

        VerticalLayout {
            spacing: 0;

            // ── Search ──
            Rectangle {
                height: 60px;
                background: transparent;
                Rectangle { y: parent.height - 1px; width: 100%; height: 1px; background: Theme.separator; }

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: Theme.sp-3;

                    Icon {
                        commands: Icons.search;
                        size: 16px;
                        thickness: 1.7px;
                        tint: search-input.has-focus ? Theme.text-primary : Theme.text-dim;
                        y: (parent.height - self.height) / 2;
                    }
                    search-input := TextInput {
                        init => { self.focus(); }
                        single-line: true;
                        vertical-alignment: center;
                        font-size: Theme.fs-body;
                        color: Theme.text-primary;
                        horizontal-stretch: 1;
                        edited => { root.selected-index = 0; root.search-changed(self.text); }
                    }
                    Rectangle {
                        width: esc.preferred-width + 12px;
                        height: 20px;
                        y: (parent.height - 20px) / 2;
                        border-radius: Theme.r-xs;
                        background: Theme.keycap-fill;
                        border-width: 1px;
                        border-color: Theme.keycap-border;
                        esc := Text {
                            text: "esc";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                if search-input.text == "" : Text {
                    x: 20px + 16px + Theme.sp-3;
                    height: 100%;
                    text: "Find an app or a running window…";
                    color: Theme.text-dim;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                }
            }

            Flickable {
                vertical-stretch: 1;
                viewport-y <=> root.scroll-y;
                viewport-width: self.width;
                viewport-height: root.content-h;

                // Centred: the grid is as wide as its columns, not the panel.
                Rectangle {
                    x: Math.round((parent.width - root.grid-w) / 2 / 1px) * 1px;
                    width: root.grid-w;
                    height: root.content-h;

                    if root.run-count > 0 : Text {
                        y: 0px;
                        height: root.head-h;
                        text: "RUNNING";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: Theme.fw-micro;
                        letter-spacing: 1px;
                        vertical-alignment: bottom;
                    }
                    for app[idx] in root.running : LauncherCell {
                        x: mod(idx, root.columns) * (root.cell-w + root.cell-gap);
                        y: root.head-h + floor(idx / root.columns) * (root.cell-h + root.cell-gap);
                        width: root.cell-w;
                        height: root.cell-h;
                        name: app.label;
                        icon-id: app.icon-id;
                        glyph: Icons.app-or-window(app.icon-id);
                        has-icon: app.has-icon;
                        icon: app.icon;
                        windows: app.windows;
                        selected: idx == root.selected-index;
                        clicked => { root.launch-app(app.app-id); root.is-open = false; root.close(); }
                    }

                    Text {
                        y: root.apps-top;
                        height: root.head-h;
                        text: "ALL APPS";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: Theme.fw-micro;
                        letter-spacing: 1px;
                        vertical-alignment: bottom;
                    }
                    for app[idx] in root.apps : LauncherCell {
                        x: mod(idx, root.columns) * (root.cell-w + root.cell-gap);
                        y: root.apps-top + root.head-h + floor(idx / root.columns) * (root.cell-h + root.cell-gap);
                        width: root.cell-w;
                        height: root.cell-h;
                        name: app.name;
                        icon-id: app.icon-id;
                        glyph: Icons.app-or-category(app.icon-id, app.category);
                        has-icon: app.has-icon;
                        icon: app.icon;
                        pinnable: app.pinnable;
                        pinned: app.pinned;
                        selected: root.run-count + idx == root.selected-index;
                        clicked => { root.launch-app(app.app-id); root.is-open = false; root.close(); }
                        toggle-pin => { root.toggle-pin(app.app-id); }
                    }

                    if root.total == 0 : Text {
                        y: root.head-h + 30px;
                        width: 100%;
                        text: "No app or window matches. Try another word.";
                        color: Theme.text-secondary;
                        font-size: Theme.fs-body;
                        horizontal-alignment: center;
                    }
                }
            }

            Rectangle {
                height: 36px;
                background: Theme.bg-surface;
                // The panel's clip does not round what it clips under the software renderer, so
                // the footer rounds its own bottom corners to match.
                border-bottom-left-radius: Theme.r-xl;
                border-bottom-right-radius: Theme.r-xl;
                HorizontalLayout {
                    padding-left: 20px; padding-right: 12px;
                    spacing: 4px;
                    footer-text := Text {
                        property <string> power-hint: lock-btn.has-hover ? "Lock the screen" : sleep-btn.has-hover ? "Sleep" : restart-btn.has-hover ? "Restart" : shutdown-btn.has-hover ? "Shut down" : "";
                        text: self.power-hint != "" ? self.power-hint : root.apps.length == 1 ? "1 app" : root.apps.length + " apps";
                        font-size: Theme.fs-caption;
                        color: self.power-hint != "" ? Theme.text-primary : Theme.text-secondary;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                    }
                    Text { text: "Arrows  Move     Enter  Open     Esc  Close"; font-size: Theme.fs-caption; color: Theme.text-secondary; vertical-alignment: center; }
                    Rectangle { width: 14px; }
                    lock-btn := PowerButton {
                        icon: Icons.lock; label: "Lock";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("lock"); root.is-open = false; root.close(); }
                    }
                    sleep-btn := PowerButton {
                        icon: Icons.moon; label: "Sleep";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("suspend"); root.is-open = false; root.close(); }
                    }
                    restart-btn := PowerButton {
                        icon: Icons.refresh; label: "Restart";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("restart"); root.is-open = false; root.close(); }
                    }
                    shutdown-btn := PowerButton {
                        icon: Icons.power; label: "Shut down";
                        y: (parent.height - self.height) / 2;
                        clicked => { root.power-action("shutdown"); root.is-open = false; root.close(); }
                    }
                }
            }
        }
        }
    }
}
