// Glance card — shows a proactive urge from an instinct.
// Left border glow indicates the instinct type.

import { Theme } from "theme.slint";
import { ChoiceLink } from "chat_message.slint";

export struct UrgeCardData {
    urge-id: string,
    instinct-name: string,
    reason: string,
    urgency: float,
    suggested-message: string,
    time-ago: string,
    border-color: color,
    // The kind's key, its plain why, and the memories it was made from (comma-separated), as the
    // message would carry them (#756).
    kind: string,
    why: string,
    memory-ids: string,
    // False for a safety signal: nothing to back off.
    offers-choices: bool,
}

export component GlanceCard inherits Rectangle {
    in property <UrgeCardData> data;
    callback tapped(string); // passes suggested-message
    // One of the three choices behind "Less of this": (choice, urge-id, kind, memory-ids).
    callback choice(string, string, string, string);
    property <bool> choices-open: false;

    min-height: 64px;
    border-radius: Theme.radius-card;
    background: Theme.bg-card;
    border-width: 1px;
    border-color: Theme.border-subtle;
    clip: true;

    // Left border glow accent
    Rectangle {
        x: 0; y: 0;
        width: 3px;
        height: parent.height;
        border-radius: 1.5px;
        background: data.border-color;
        drop-shadow-blur: 8px;
        drop-shadow-color: data.border-color;
    }

    TouchArea {
        clicked => { root.tapped(data.suggested-message); }
    }

    HorizontalLayout {
        padding: 14px;
        padding-left: 16px;
        spacing: 12px;

        // Urgency indicator (glowing dot)
        Rectangle {
            width: 8px;
            height: 8px;
            y: 6px;
            border-radius: 4px;
            background: data.border-color;
            opacity: 0.4 + data.urgency * 0.6;
            drop-shadow-blur: 6px;
            drop-shadow-color: data.border-color;
        }

        // Body
        VerticalLayout {
            horizontal-stretch: 1;
            spacing: 6px;

            Text {
                text: data.reason;
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                wrap: word-wrap;
                overflow: elide;
            }

            // Why the mind wants to say this, in plain words.
            if data.why != "" : Text {
                text: data.why;
                color: Theme.text-dim;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: 8px;

                Rectangle {
                    height: 18px;
                    width: instinct-text.preferred-width + 12px;
                    border-radius: 9px;
                    background: Theme.hover-fill;

                    instinct-text := Text {
                        text: data.instinct-name;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Text {
                    text: data.time-ago;
                    color: Theme.text-dim;
                    font-size: Theme.font-small;
                    vertical-alignment: center;
                }

                if data.offers-choices && data.kind != "" && !root.choices-open : ChoiceLink {
                    label: "Less of this";
                    clicked => { root.choices-open = true; }
                }
            }

            if data.offers-choices && root.choices-open : HorizontalLayout {
                alignment: start;
                spacing: 12px;
                ChoiceLink {
                    label: "Not now";
                    clicked => { root.choice("not_now", data.urge-id, data.kind, data.memory-ids); }
                }
                ChoiceLink {
                    label: "Stop this kind";
                    clicked => { root.choice("stop_kind", data.urge-id, data.kind, data.memory-ids); }
                }
                if data.memory-ids != "" : ChoiceLink {
                    label: "Don't use this memory";
                    clicked => { root.choice("forget_memory", data.urge-id, data.kind, data.memory-ids); }
                }
            }
        }
    }
}
