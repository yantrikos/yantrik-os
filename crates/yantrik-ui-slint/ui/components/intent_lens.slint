// Intent Lens — the primary interaction primitive of Yantrik OS.
// Centered 720px panel. Single input + unified ranked result feed.
// Replaces chat panel, app launcher, search, and settings access.
//
// States:
//   closed → open (input + results) → chat (multi-turn conversation)
//
// Invoke: Super key or click anchor dot / orb.
// Dismiss: Escape or click outside.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { MessageData, MessageBubble } from "message_bubble.slint";
import { ListView } from "std-widgets.slint";

// A single result in the Intent Feed.
export struct LensResult {
    result-type: string,     // "do", "find", "ask", "memory", "setting", "tool",
                             // "clipboard", "divider", "context", "recent", "answer"
    title: string,           // Main display text
    subtitle: string,        // "Why" rationale line
    icon-char: string,       // Single-char badge
    action-id: string,       // Identifier for callback
    score: float,            // 0.0-1.0 ranking confidence
    is-loading: bool,        // When true, render as skeleton shimmer
    inline-value: string,    // For "answer" type: computed value shown prominently
}

// ── Asking the person ───────────────────────────────────────────────
//
// A mind found the dentist appointment, called `calendar.delete_event`, and the bridge refused
// it: the action is graded `sensitive` and the bridge's ceiling is `standard`. The mind then
// told the person to "approve it right here in the chat panel" — there was nothing to approve
// with — "or raise YOS_MCP_MAX_PERMISSION in the settings". This is the card that should have
// been there. See `crates/yantrik-ui/src/approvals.rs` and design/approvals-2026-09-21.md.
//
// Everything the person needs to decide is on the card: who is asking, what the action does in
// the app's own words, every argument, and the grade. Not a summary of the arguments — the
// arguments — because the grant is bound to exactly these, and a card that showed a paraphrase
// would be asking them to approve something they had not read.
export struct ApprovalRequest {
    id: string,
    // Which of the person's agents is asking (`pi:c-7f3a91`), or "" for a caller that is no agent.
    // Established by the shell from the agent token beside the request, checked against the
    // caller's process — never from the request's words. The same card is drawn in that agent's
    // pane on the Agents screen, under the same id (design/agents-workspace-2026-09-23.md, 4).
    agent: string,
    // Who that agent works for, when not simply the person: "Council recipe → Reviewer" for a
    // recipe's agent, "Reviewer" for a role. The shell's own record of how it started the agent,
    // never the request's words.
    on-behalf: string,
    // What the caller CALLS itself. Nothing authenticates it; the card says so underneath.
    requester: string,
    // What this MACHINE knows: the program the kernel says opened the socket, resolved through
    // /proc to the first ancestor a person would recognise. Never empty — `caller_identity`
    // answers "could not be identified" rather than leaving a blank where a fact should be.
    verified: string,
    // What does not add up about this request, one already-bounded sentence per entry — the
    // claimed name names an attached mind the ancestry contradicts, or the claimed grade is not
    // the one the app publishes. Drawn in the same red as `warning`, because they are the same
    // kind of thing: a reason to stop reading the name and start reading the lines under it.
    // A list, so a third of these later costs no markup and no new height arithmetic.
    discrepancies: [string],
    app: string,
    action: string,
    // The action's own first sentence — one person-facing line (#218). The paragraph below is
    // what the protocol detail looks like to a person: `run_recipe`'s card led with "A formation
    // — Council, Red team, Build, Writers' room; `describe shell` → `recipes` → `formations`
    // lists each with its `inputs`…". Picked out of the published description in approvals.rs
    // (`summary_of`), so it is the app's own words and not a third name for the action. Empty
    // when the app publishes nothing; the card then hides this row rather than inventing one.
    summary: string,
    purpose: string,        // the action's own published description
    grade: string,          // safe | standard | sensitive | dangerous
    args: [string],         // one `key: value` per entry, each already cut to fit one line
    // What one of those arguments stands for, in the app's own words:
    // `id 01a0c718… is "Dentist, Fri 25 Sep 13:00"` (#54). The card for a delete asked BY ID
    // showed only the uuid, which is nothing a person can answer a question about. This is a
    // sentence about the arguments, drawn beside them — never one more thing the grant binds
    // to — and empty when the app publishes no name index or names none of these values, in
    // which case the card hides the row rather than drawing a blank.
    target: string,
    warning: string,        // "" unless there is something that cannot be undone
    // Whether "Allow for this session" may be offered at all. False for `dangerous` and for any
    // action whose own published sentence says it cannot be undone — the same predicate that
    // draws `warning`, so the card can never offer to stop asking about the thing it is warning
    // about. Decided in approvals.rs from the UNCLIPPED purpose.
    can-session: bool,
    decision: string,       // "" while waiting; then allowed | denied | expired
    record: string,         // the one line that stays in the conversation afterwards
    age-text: string,       // "94s left", while waiting
}

// One request, or — once it has been answered — the line it leaves behind.
//
// ── Why the body is wrapped in a layout that does nothing else ──
//
// The first build of this drew the card with its top off the top of the screen: the person saw
// the arguments and the buttons and not the header, the action name or what the action does.
//
// The cause was here, on the root element. Both branches below are conditional, and a Rectangle
// whose only children are conditional reports a `preferred-height` of zero — Slint computes a
// non-layout element's preferred size from its unconditional children, and there were none. So
// `height: self.preferred-height` resolved to zero, the enclosing VerticalLayout in app.slint
// sized the row at zero, and the real content — which sets its own height and is not clipped —
// spilled out of a box that had no room for it.
//
// The fix is structural rather than a number: one unconditional VerticalLayout holds both
// branches, and the root takes ITS preferred height. `if` inside a layout does contribute to
// that layout's preferred size, which is the whole difference. This is the same idiom
// `message_bubble.slint` uses (`height: msg-layout.preferred-height`), and the rule it teaches is
// worth keeping: never ask a bare Rectangle how tall it would like to be when everything in it
// is behind an `if`.
//
// Keyboard: there is deliberately NO default action. Both buttons are TouchAreas, which take no
// keyboard focus in Slint, so Enter cannot reach either of them. A person allowing something
// has to move the pointer and press the word Allow. That is the entire mechanism by which a
// grant exists, and it should cost a deliberate movement.
export component ApprovalCard inherits Rectangle {
    in property <ApprovalRequest> data;
    callback allow();
    callback allow-session();
    callback deny();

    property <bool> waiting: root.data.decision == "";

    // ── The card fits the panel it is drawn in, or it does not answer (#218) ──
    //
    // The Lens card for `shell.run_recipe` — the app's paragraph of a description, an agent
    // row, two arguments, the session row — came out taller than the Lens panel at 1280×800.
    // The card sets its own height and a layout cannot shrink it below that, so the panel's
    // VerticalLayout simply ran out of room at the bottom: the reply box went off the edge and
    // the Deny/Allow row showed as a 3px sliver above it. Scrolling could not help — the Lens
    // was already at its bottom — and a person could not answer the card at all.
    //
    // So whoever draws the card says how tall it may be, and the card keeps that promise by
    // making ONE part of itself yield: the details in the middle scroll, while the identity
    // rows above (who is asking, what the action is) and the buttons below stay pinned where
    // the layout put them. The default asks for more than any screen has, which leaves the
    // card exactly as tall as it likes in a pane that scrolls itself (the Agents screen).
    // Not called `max-height`: that name belongs to the Rectangle this inherits from, where it
    // is a layout constraint, and Slint refuses to let a component shadow a built-in property.
    in property <length> height-limit: 10000px;

    // How much of the purpose block shows before "show more" takes over: three caption lines,
    // at their 14px line pitch — a rounder number clips the fourth line mid-glyph.
    // The summary row above already carries the description's first sentence, so the clamped
    // paragraph is for whoever wants the rest of it — and they ask, instead of the card
    // spending a sixth of the screen on protocol detail (#218, item 3). It used to be 160px
    // with a scroll of its own, which is what made the card too tall for the Lens; a scroll
    // inside the scrolling details section would also fight the outer one for the gesture.
    property <length> purpose-clamp: 42px;
    property <bool> purpose-open: false;

    height: body.preferred-height;
    background: transparent;

    body := VerticalLayout {

    // Decided: one line in the transcript, and nothing else. The card is gone; the record of
    // what was decided is not, because "did I allow that?" is a question people ask afterwards.
    if !root.waiting : HorizontalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;
        padding-top: Theme.sp-1;
        padding-bottom: Theme.sp-1;
        spacing: Theme.sp-2;

        Rectangle {
            width: 3px;
            background: root.data.decision == "allowed" ? Theme.color-success
                : root.data.decision == "denied" ? Theme.color-danger
                : Theme.text-dim;
        }
        Text {
            text: root.data.record;
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
        }
    }

    if root.waiting : Rectangle {
        border-radius: Theme.r-lg;
        // Opaque, not glass: this card is drawn over whatever screen is up, and a question about
        // something that cannot be undone must not have another window's words showing through it.
        background: Theme.bg-card;
        border-width: 1px;
        // The grade colours the edge of the card rather than a badge in the corner, so the one
        // thing that changes how hard you should look is visible before you start reading.
        border-color: root.data.grade == "dangerous" ? Theme.color-danger
            : root.data.grade == "sensitive" ? Theme.color-warning
            : Theme.glass-border-strong;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.overlay-shadow;
        // The promise to the panel: never taller than it was told it may be. What yields is the
        // details section in the middle (see its height below); the rows above it and the
        // buttons under it keep their arithmetic heights, so the buttons are the one thing on
        // the card that is always where the layout put them (#218).
        height: min(card-body.preferred-height, root.height-limit);

        card-body := VerticalLayout {
            padding: Theme.sp-3;
            spacing: Theme.sp-2;

            // Pinned top: who is asking, and what the action is in one line. Everything here is
            // fixed single-line rows (or the summary's bounded sentence), so this section's
            // height is arithmetic and the details below can be sized by subtracting it.
            identity := VerticalLayout {
                spacing: Theme.sp-2;

            // Who is asking — said twice, on purpose, because the two answers are not the same
            // kind of thing and the card must not let one pass for the other.
            //
            // The first pair is the CLAIM: whatever the caller called itself, with the label
            // `says the caller` under it. Hermes declares this on the MCP handshake and the
            // bridge passes it through; anything that can open the shell's socket can put any
            // string there. It cannot raise privilege (the machine ceiling is enforced from the
            // app's real grade, not from anything on this card) but it can flatter.
            //
            // The second pair is what the MACHINE established, and it is not a rewording of the
            // first: the kernel stamps the peer's pid on the socket at connect (SO_PEERCRED —
            // the caller cannot write it), and `caller_identity.rs` walks /proc up from there,
            // past our own `yos`/`yos-mcp` plumbing, to the first program a person would
            // recognise. It says `could not be identified` rather than guessing.
            //
            // Four fixed single-line rows rather than anything that wraps, so the card's height
            // stays arithmetic — see the geometry table in design/approvals-2026-09-21.md.
            HorizontalLayout {
                spacing: Theme.sp-2;

                Rectangle {
                    width: 6px; height: 6px;
                    y: 5px;
                    border-radius: 3px;
                    background: Theme.amber;
                }
                Text {
                    text: root.data.requester;
                    color: Theme.text-primary;
                    font-size: Theme.fs-micro;
                    font-weight: 600;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
                Text {
                    text: root.data.age-text;
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                }
            }
            Text {
                text: "says the caller · nothing on this machine checked that name";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                wrap: no-wrap;
                overflow: elide;
            }

            // What the machine knows, in the same value-over-label shape, so the eye reads the
            // pair rather than a sentence. Spacing 0 inside: the two belong together and the
            // gap belongs between the pairs, not inside one.
            VerticalLayout {
                spacing: 0px;

                Text {
                    text: root.data.verified;
                    color: Theme.text-primary;
                    font-size: Theme.fs-micro;
                    font-weight: 600;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Text {
                    text: "verified by this machine · the kernel said so, not the caller";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            // Which agent — one row, only when there is one, in the same value-over-label shape.
            // From the token the shell issued that agent, checked against the process above, so it
            // sits with the machine's facts rather than with the caller's claim.
            if root.data.agent != "" : VerticalLayout {
                spacing: 0px;

                Text {
                    text: "agent " + (root.data.on-behalf == "" ? "" : root.data.on-behalf + " · ") + root.data.agent;
                    color: Theme.text-primary;
                    font-size: Theme.fs-micro;
                    font-weight: 600;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Text {
                    text: "named by the token the desktop gave it · also asked in its pane";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            // What the caller said and what the machine found do not agree — the kind of
            // disagreement a person cannot catch by reading, because the claim will look exactly
            // right. Same red bar as "cannot be undone" below; one line each, elided, and the
            // sentences are bounded where they are made (caller_identity.rs, control_approvals.rs)
            // so the card's height stays arithmetic.
            for said in root.data.discrepancies : HorizontalLayout {
                spacing: Theme.sp-2;
                Rectangle {
                    width: 3px;
                    background: Theme.color-danger;
                }
                Text {
                    text: said;
                    color: Theme.color-danger;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                    horizontal-stretch: 1;
                }
            }

            // What it is. The app and action by their exact names, because those are the names
            // in every other surface on this machine and a friendly rewording would be a third.
            Text {
                text: root.data.app + "." + root.data.action;
                color: Theme.text-primary;
                font-size: Theme.fs-body-strong;
                font-weight: 600;
                wrap: word-wrap;
            }

            // What it does, in one line a person can read (#218): the app's own first sentence,
            // picked out of the published description in approvals.rs. Pinned with the identity
            // rows rather than down in the details, because the line that says what this call
            // does is the one thing on the card that must never be what a person has to scroll
            // or press "show more" for. The label says where the line came from, in the same
            // voice as the labels around it — it is the app's words, not a third name for the
            // action beside `app.action` and the paragraph below.
            // Not behind an `if`: conditional, the pair's last line never reached this
            // section's preferred height, and the details below started on top of the label.
            // An empty summary collapses the box to zero height instead, and the clip keeps
            // the collapsed box from spilling whatever it still draws.
            Rectangle {
                height: root.data.summary != "" ? summary-pair.preferred-height : 0px;
                clip: true;

                summary-pair := VerticalLayout {
                    spacing: 0px;

                    Text {
                        text: root.data.summary;
                        color: Theme.text-primary;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                    }
                    Text {
                        text: "what it does · the app's own first sentence";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
            }

            }   // identity — pinned; everything under here gives way first

            // The scrolling middle: the app's whole paragraph, every argument, the warning and
            // the grade line.
            //
            // This is the one part of the card that yields when the card may not be as tall as
            // it likes (#218): its height is what is left of `height-limit` once the pinned rows
            // above, the pinned buttons below and the card's own padding and spacing are
            // subtracted — the 2×sp-3 and 2×sp-2 are exactly those, two paddings and the two
            // gaps between the three sections. When the details fit — every card on a full
            // screen, and all of them in a pane that scrolls itself, where `height-limit` is
            // left at its out-of-reach default — the section is precisely as tall as its
            // content and nothing scrolls anywhere.
            Rectangle {
                height: min(details.preferred-height,
                            max(0px, root.height-limit - identity.preferred-height
                                - decide.preferred-height
                                - 2 * Theme.sp-3 - 2 * Theme.sp-2));
                clip: true;

                // A Flickable has no preferred height of its own, so the sizing Rectangle is
                // around it and the layout inside is what gets measured.
                Flickable {
                    // Only the vertical scrolls, and the viewport's width has to be said so:
                    // left at its default it follows the content's minimum width, and the
                    // wrapping purpose text measures its height from the width it is given —
                    // width into height into width, which Slint rejects as a binding loop.
                    viewport-width: self.width;
                    viewport-height: details.preferred-height;

                    details := VerticalLayout {
                        spacing: Theme.sp-2;

            // What it does, in the app's own sentence — the whole sentence, all of it readable.
            //
            // This used to be a bare wrapping Text fed a purpose cut to 240 characters, and
            // Studio's `set_backend` publishes 585: the card read "…naming a hosted service means
            // the sentences typed into this app will leav… (585 characters in full)", cut
            // mid-word at the clause that said why the grade is what it is, with no way to read
            // the rest. So the text is no longer cut to fit the card (see `PURPOSE_CHARS` in
            // approvals.rs). It is still clamped, though — to three lines under "show more"
            // (#218) — because `run_recipe`'s paragraph is protocol detail for minds, and on
            // the card it pushed the buttons under the edge of the Lens. What changed since
            // 22 September is that nothing is lost by the clamp any more: the summary line
            // above carries the first sentence, "show more" opens the rest in full, and the
            // section scrolls once the card is at the height its panel allows.
            //
            // The label under it says what kind of thing the sentence is, because the two cards
            // of 22 September were read as the OS warning about THIS call when the sentence is
            // the app's description of the ACTION and reads the same for `kind: fake` as for a
            // hosted service. The arguments underneath are what change; their label says so.
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    height: root.purpose-open ? purpose-text.preferred-height
                        : min(purpose-text.preferred-height, root.purpose-clamp);
                    clip: true;

                    purpose-text := Text {
                        width: parent.width;
                        // Pinned to the box's top edge, both axes: left to its own geometry the
                        // paragraph centers itself on the clamped box, and the window then
                        // shows the middle lines of it instead of the first ones.
                        y: 0px;
                        text: root.data.purpose;
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
                // "show more" rather than a scroll of its own: a second Flickable inside the
                // scrolling details section would fight the outer one for the same gesture, and
                // a scrollbar-less clamp gives no sign that there is more. Same shape as the
                // small hit areas in the Lens header — a TouchArea sized to its label.
                if purpose-text.preferred-height > root.purpose-clamp : more-hit := TouchArea {
                    width: more-label.preferred-width + 16px;
                    height: 20px;
                    mouse-cursor: pointer;
                    clicked => { root.purpose-open = !root.purpose-open; }

                    more-label := Text {
                        width: parent.width;
                        height: parent.height;
                        text: root.purpose-open ? "show less" : "show more";
                        color: more-hit.has-hover ? Theme.amber-light : Theme.text-dim;
                        font-size: Theme.fs-micro;
                        vertical-alignment: center;
                    }
                }
                Text {
                    text: "says the app about the action · the same for every call of it";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            // The arguments, exactly as the grant is bound to them.
            //
            // One Text per argument, `no-wrap` and elided, so the box is exactly as many lines
            // as there are arguments and the card's height is arithmetic rather than a
            // measurement. The values arrive already cut to fit (see `ARG_VALUE_CHARS` in
            // approvals.rs), each cut one naming its true length, and a list longer than eight
            // arrives with a line saying how many more the grant covers — so the bound is
            // visible in the text rather than being a silent truncation by the layout.
            VerticalLayout {
                spacing: 0px;

                Rectangle {
                    border-radius: Theme.r-sm;
                    background: Theme.bg-input;
                    height: args-body.preferred-height;

                    args-body := VerticalLayout {
                        padding: Theme.sp-2;

                        for line in root.data.args : Text {
                            text: line;
                            color: Theme.text-primary;
                            font-size: Theme.fs-mono;
                            wrap: no-wrap;
                            overflow: elide;
                        }
                    }
                }
                Text {
                    text: "asked for in this call · the grant is bound to exactly these";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            // What the handle in the box above means, in the words of the app that owns it
            // (#54) — a line for each handle the app names, so a delete asked by id reads as
            // the event itself. One Text, `no-wrap` and elided, like every other row: the
            // card's height is arithmetic, and the line arrives already cut to fit (see
            // `TARGET_CHARS` in approvals.rs). Hidden when empty, which is the ordinary case.
            if root.data.target != "" : VerticalLayout {
                spacing: 0px;
                Text {
                    text: root.data.target;
                    color: Theme.text-primary;
                    font-size: Theme.fs-caption;
                    wrap: no-wrap;
                    overflow: elide;
                }
                Text {
                    text: "says the app what its handle means · the grant binds to the arguments above, not to this line";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            if root.data.warning != "" : HorizontalLayout {
                spacing: Theme.sp-2;
                Rectangle {
                    width: 3px;
                    background: Theme.color-danger;
                }
                Text {
                    text: root.data.warning;
                    color: Theme.color-danger;
                    font-size: Theme.fs-caption;
                    wrap: word-wrap;
                    horizontal-stretch: 1;
                }
            }

            Text {
                text: "Graded " + root.data.grade + ". Allowing covers this one action, once.";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                wrap: word-wrap;
            }

                    }   // details
                }   // Flickable
            }   // the scrolling middle

            // Pinned bottom: the answer. Below the scroll, outside it, at a height the card's
            // arithmetic already reserved — the buttons are the one thing that cannot end up
            // somewhere a person has to look for it (#218).
            decide := VerticalLayout {
                spacing: Theme.sp-2;

            // Deny first, and neither button dressed up as the obvious one.
            //
            // The failure this guards against is approval fatigue: a prominent, accent-filled
            // Allow next to a grey Deny trains a person to click the bright one without
            // reading, which is exactly how the one request that mattered gets waved through.
            // So Deny is the ordinary filled button and Allow is an outline you have to aim at.
            HorizontalLayout {
                spacing: Theme.sp-2;
                padding-top: Theme.sp-1;

                Rectangle {
                    height: Theme.h-regular;
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: deny-ta.has-hover ? Theme.hover-fill-strong : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    deny-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.deny(); }
                    }
                    Text {
                        text: "Deny";
                        color: Theme.text-primary;
                        font-size: Theme.fs-body-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: Theme.h-regular;
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: allow-ta.has-hover ? Theme.amber-glow : transparent;
                    border-width: 1px;
                    border-color: Theme.amber;

                    allow-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.allow(); }
                    }
                    Text {
                        text: "Allow once";
                        color: Theme.amber-light;
                        font-size: Theme.fs-body-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            // "Stop asking me about this one" — the third choice, and deliberately the least
            // inviting thing on the card.
            //
            // It exists because approval fatigue is the failure this design is most afraid of,
            // and forty identical cards for one long job is how it arrives. A person who can say
            // "yes to file moves, keep asking about everything else" never has to reach for
            // bypass, which is the blunt instrument this is trying to make unnecessary.
            //
            // Below the button row rather than beside it, at caption size, in dim text with a
            // subtle border: Deny is still the ordinary filled button and the easy default, and
            // the standing yes costs the most deliberate aim of the three. Not drawn at all for
            // `dangerous`, or for an action the app says cannot be undone — see `can-session`.
            if root.data.can-session : Rectangle {
                height: 30px;
                border-radius: Theme.r-md;
                background: session-ta.has-hover ? Theme.hover-fill : transparent;
                border-width: 1px;
                border-color: Theme.border-subtle;

                session-ta := TouchArea {
                    mouse-cursor: pointer;
                    clicked => { root.allow-session(); }
                }
                Text {
                    text: "Allow " + root.data.app + "." + root.data.action + " for this session";
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            }   // decide
        }
    }

    }   // body — see the note at the top of this component about why it is here
}

/// What the desktop is asking for the vault passphrase about.
///
/// `reason` is written by the shell, never by whatever provoked it: a mind asking for a credential
/// gets its request turned into one of a handful of fixed sentences before it reaches here, so
/// nothing a caller composed is ever drawn as the explanation for a password box.
export struct VaultUnlockRequest {
    /// Why this is on screen, in the person's words. Empty means nothing is being asked.
    reason: string,
    /// What was wrong with the last attempt, or empty.
    error: string,
    /// True when answering this will protect the vault for the first time rather than open it.
    first-time: bool,
}

/// The only way a vault passphrase gets into this machine.
///
/// Deliberately the same shape, glass and border language as `ApprovalCard` above, because it is
/// the same kind of moment: the machine has stopped and is waiting for a person, and the person
/// should recognise on sight that this is one of those and not a form an app drew. It is a
/// stronger claim than the approval card makes, though — an approval is a click, and a click can
/// be described; this is a secret, and there is no control-surface action, no tool argument and no
/// RPC method that can supply one. `no_published_action_can_carry_a_passphrase` in
/// `control_approvals.rs` is what keeps that true as the surface grows.
export component VaultUnlockCard inherits Rectangle {
    in property <VaultUnlockRequest> data;
    /// The typed passphrase, on its way to `vault_unlock::adopt` and nowhere else.
    callback submit(string);
    callback dismiss();

    // Same reason as ApprovalCard: a plain Rectangle whose children are all behind `if` reports a
    // preferred height of zero, and the card then draws outside whatever box was sized from it.
    // One unconditional layout owns the height; everything conditional lives inside it.
    height: body.preferred-height;
    background: transparent;

    body := VerticalLayout {

    Rectangle {
        border-radius: Theme.r-lg;
        // Opaque for the same reason ApprovalCard is: this is drawn over whatever screen is up,
        // and a box asking for the passphrase to every credential on the machine must not have
        // another window's words showing through it.
        background: Theme.bg-card;
        border-width: 1px;
        // Warning-edged, always. There is no "routine" version of being asked for the passphrase
        // that protects every credential on the machine.
        border-color: Theme.color-warning;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.overlay-shadow;
        height: card-body.preferred-height;

        card-body := VerticalLayout {
            padding: Theme.sp-3;
            spacing: Theme.sp-2;

            HorizontalLayout {
                spacing: Theme.sp-2;

                Rectangle {
                    width: 6px; height: 6px;
                    y: 5px;
                    border-radius: 3px;
                    background: Theme.color-warning;
                }
                Text {
                    text: root.data.first-time ? "Choose a passphrase for your vault"
                        : "Your vault passphrase";
                    color: Theme.text-primary;
                    font-size: Theme.fs-body-strong;
                    horizontal-stretch: 1;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            Text {
                text: root.data.reason;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }

            // What it is actually for, said once. A person being asked for a password by their own
            // desktop deserves to know what it unlocks and what it does not, and the honest answer
            // is short: the file, not the running session.
            Text {
                text: root.data.first-time
                    ? "It wraps the key to your saved credentials. Nothing already saved is lost. If you forget it, they cannot be recovered."
                    : "Nobody else can supply this — not an app, not an assistant. Only what you type here.";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                wrap: word-wrap;
            }

            // The field. `input-type: password` is not a security control — it stops a shoulder,
            // not a process — but the shell is the process, and this string leaves it only for
            // `vault::unlock`'s key derivation.
            Rectangle {
                height: Theme.h-regular;
                border-radius: Theme.r-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: pass-input.has-focus ? Theme.cyan : Theme.border-default;

                HorizontalLayout {
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;

                    pass-input := TextInput {
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        input-type: password;
                        single-line: true;
                        accepted => {
                            root.submit(self.text);
                            // Cleared on the way out, whatever happens next. A wrong passphrase
                            // must not be left sitting in a widget for the next person at the
                            // keyboard to reveal.
                            self.text = "";
                        }
                    }
                }
            }

            if root.data.error != "" : Text {
                text: root.data.error;
                color: Theme.color-danger;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.sp-2;
                padding-top: Theme.sp-1;

                Rectangle {
                    height: Theme.h-regular;
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: later-ta.has-hover ? Theme.hover-fill-strong : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    later-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            pass-input.text = "";
                            root.dismiss();
                        }
                    }
                    Text {
                        text: "Not now";
                        color: Theme.text-primary;
                        font-size: Theme.fs-body-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: Theme.h-regular;
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: unlock-ta.has-hover ? Theme.amber-glow : transparent;
                    border-width: 1px;
                    border-color: Theme.amber;

                    unlock-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.submit(pass-input.text);
                            pass-input.text = "";
                        }
                    }
                    Text {
                        text: root.data.first-time ? "Lock the vault" : "Unlock";
                        color: Theme.amber-light;
                        font-size: Theme.fs-body-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    }   // body — see the note at the top of this component about why it is here
}

export component IntentLens inherits Rectangle {
    in property <bool> is-open: false;
    in property <bool> is-thinking: false;
    in property <[LensResult]> results: [];
    in property <string> companion-status: "idle";
    in property <bool> companion-online: true;

    // Contextual suggestions (shown when query is empty)
    in property <[LensResult]> suggestions: [];
    in property <[LensResult]> recents: [];

    // Chat mode (multi-turn conversation within the Lens)
    in property <bool> chat-mode: false;
    /// The mind answering, shown in the chat header. A conversation should say who it is with.
    in property <string> mind-name: "";
    /// Whether the conversation is one of the mind's agents — an attached mind's `<id>:main` — and
    /// so has the whole of itself, every card and command, on the Agents screen.
    in property <bool> can-open-in-agents: false;
    in property <[MessageData]> messages: [];
    in property <bool> is-generating: false;

    /// What they recently decided, and the one request waiting on them.
    ///
    /// The card sits at the end of the list, under the records of the ones already answered, so
    /// the thing waiting on you is closest to where your hands are. The same list is drawn at
    /// desktop level in `app.slint` when the Lens is not showing it — a request must never sit
    /// invisibly until it expires.
    in property <[ApprovalRequest]> approvals: [];
    /// How many further requests are queued behind the card on screen.
    ///
    /// Up to three can be waiting; only one is ever shown. Three stacked cards do not fit on an
    /// 800px screen — the third one's buttons land under the taskbar — and a person facing a
    /// stack reads none of them properly, which is the failure the design is most afraid of.
    in property <int> approvals-waiting: 0;

    // Callbacks
    callback approval-allow(string);   // request id — a click, and nothing else, creates a grant
    // request id — the same grant, plus a standing rule for that (app, action) until the shell
    // restarts. Still a click and nothing else. See `mind_mode.rs`.
    callback approval-allow-session(string);
    callback approval-deny(string);    // request id
    callback query-changed(string);
    callback submit-query(string);
    callback result-selected(string);    // action-id
    callback close-lens();
    callback send-message(string);
    callback mic-pressed();
    // "open in Agents": the Agents screen, with this conversation's agent selected.
    callback open-in-agents();
    // "History": every conversation, on the Agents screen's All tab (#246).
    callback open-history();

    // Internal state
    in-out property <string> input-text: "";
    in-out property <int> selected-index: 0;   // keyboard-navigable cursor

    // The least the conversation transcript keeps in chat mode. While a card is waiting the
    // transcript gives up most of its floor and the card gets the room instead: the card is the
    // thing the panel is waiting on, and its buttons have to fit (#218). One number, used twice
    // — as the ListView's floor and in the card's own height-limit arithmetic below — so the two
    // cannot drift apart and leave either an overlap or a gap.
    property <length> transcript-min: root.approvals.length > 0 ? 96px : 200px;

    /// Move the highlight through the result feed, stepping over divider rows.
    ///
    /// A function rather than a block inside one key handler, because two places need it now:
    /// the text field, which is where the cursor actually is while you are typing, and the
    /// keyboard scope below.
    function move-selection(delta: int) {
        if (root.results.length > 0) {
            root.selected-index = clamp(root.selected-index + delta, 0, root.results.length - 1);
            if (root.results[root.selected-index].result-type == "divider") {
                root.selected-index = clamp(root.selected-index + delta, 0, root.results.length - 1);
            }
        }
    }

    // Right-side panel — no full-screen overlay, desktop stays visible
    width: 100%;
    height: 100%;
    background: transparent;

    // Put the cursor in the field when the Lens opens.
    //
    // `forward-focus: lens-input` at the foot of this file only redirects focus that arrives AT
    // this component, and nothing sent it any: every way of opening the Lens — the ask bar, the
    // orb, the taskbar anchor, the palette's AI rows — sets `lens-open` and stops. So the panel
    // slid in with an empty field, a blinking-less caret and no way to type into it without
    // clicking the field first. One handler on the state change covers all of those openers at
    // once, which is why it lives here and not in each of them.
    //
    // Chat mode has its own field and collapses the search row to zero height behind it; Slint
    // cannot focus an element with no size, so this handler covers the search field and the chat
    // panel focuses its own (it is inside an `if`, and an id in a conditional cannot be named
    // from out here — see the `changed lens-open` beside `chat-input`).
    changed is-open => {
        if (root.is-open && !root.chat-mode) {
            lens-input.focus();
            // Whatever the field already holds — the last ask, or text `open_lens` prefilled —
            // comes up selected. The cursor otherwise sits at position 0, so the first thing
            // typed was spliced onto the front of the old text ("hello keyswhat is using my
            // disk" is what the machine showed). Selected, typing replaces it and the arrow
            // keys keep it, which is what every ask bar does.
            lens-input.select-all();
        }
    }

    // The pulse under the SUGGESTED rows' ambient dot, and nothing else.
    //
    // It used to be called the holographic scan phase and run at 16 ms for as long as the panel
    // was open, which read as "the panel glows". It does not: the only property that has ever
    // read this phase is the 5px dot on a suggestion row (search this file for
    // `suggestion-dot-phase` — one use). Those rows are on screen in one state, and a sixty-a-
    // second repaint of the whole desktop for a dot that is not being drawn is the shape of #68.
    //
    // So the gate is the condition the rows themselves are behind, spelled out once here, and the
    // rate is what a pulse needs. 160 ms a step at 0.03 keeps the 5.3 s cycle the dot always had.
    property <bool> suggestion-dots-visible: root.is-open && !root.chat-mode
        && root.results.length == 0 && root.input-text == "" && root.suggestions.length > 0;
    property <float> suggestion-dot-phase: 0;
    Timer {
        interval: 160ms;
        running: root.suggestion-dots-visible;
        triggered => {
            suggestion-dot-phase = mod(suggestion-dot-phase + 0.03, 1.0);
        }
    }

    // Click-outside area (left side only, not covering the panel)
    // Wrapped in `if` so the TouchArea is removed from the tree when closed,
    // preventing it from swallowing clicks meant for the dock/desktop.
    if root.is-open : TouchArea {
        x: 0;
        y: 0;
        width: root.width - Theme.chat-panel-width;
        height: root.height;
        clicked => { root.close-lens(); }
    }

    // The Lens panel — right-docked side panel, between the two bars
    //
    // It used to run the full height of the screen, and the shell draws the status bar and the
    // taskbar OVER the desktop — so the top 32px of this panel lived under the status bar and
    // the bottom 40px under the taskbar. The bottom 40px is the chat input: you could read an
    // answer and had no way to reply, with only the corner of the mic button showing past the
    // dock to hint that something was there. Nothing in the layout said "full height" on
    // purpose; it simply never subtracted the chrome it was underneath.
    Rectangle {
        x: root.is-open ? root.width - Theme.chat-panel-width : root.width;
        y: Theme.status-bar-height;
        width: Theme.chat-panel-width;
        height: root.height - Theme.status-bar-height - Theme.taskbar-height;
        border-radius: 0;
        clip: true;
        visible: root.is-open;

        animate x { duration: 200ms; easing: ease-out; }

        // Glass, but barely — this one holds prose.
        //
        // At 9-12% the machine rail behind it read straight through the answers: "Model
        // ollama-local:qwen3.5:9b-8k" and a column of service names sat in the middle of a
        // paragraph. The theme file already states the rule this broke — the rails are the
        // transparent surfaces BECAUSE what they hold is labels and numbers, "which stay
        // legible over a pre-blurred photograph in a way a paragraph would not". This panel
        // holds paragraphs. It keeps a suggestion of glass at 3% and stops competing with
        // itself for the reader's eye.
        // Glass while it is a list of short rows; solid once it is holding paragraphs.
        //
        // This is the theme file's own rule applied honestly rather than uniformly: the rails
        // are transparent BECAUSE what they hold is "labels and numbers, which stay legible over
        // a pre-blurred photograph in a way a paragraph would not". Search results are labels.
        // A conversation is paragraphs, and at 9% the machine rail behind this panel put
        // "Model ollama-local:qwen3.5:9b-8k" and a column of service names inside the answer.
        // Same panel, two jobs, two treatments.
        background: @linear-gradient(180deg,
            Theme.bg-deep.transparentize(root.chat-mode ? 0% : 9%) 0%,
            Theme.bg-deep.transparentize(root.chat-mode ? 0% : 12%) 50%,
            Theme.bg-deep.transparentize(root.chat-mode ? 0% : 9%) 100%
        );

        // Left edge glow (panel border)
        Rectangle {
            x: 0; y: 0;
            width: 1px;
            height: 100%;
            background: @linear-gradient(180deg,
                Theme.cyan-glow 0%,
                Theme.cyan.transparentize(87%) 30%,
                Theme.amber.transparentize(87%) 70%,
                Theme.cyan-glow 100%
            );
        }

        // Deep shadow on left side
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.overlay-backdrop;
        drop-shadow-offset-x: -8px;

        // Block click-through to the outside TouchArea
        TouchArea { width: 100%; height: 100%; }

        lens-content := VerticalLayout {
            padding: 0;

            // ── Header (chat mode) ──
            //
            // In chat mode the search row below was still drawn, so the panel carried TWO text
            // fields — one at the top that ran the app-launcher and one at the bottom that
            // continued the conversation — and they did different things with the same Return
            // key. Half the time the top one was hidden under the status bar, which is the only
            // reason it had not been noticed. A conversation gets a header instead: who is
            // answering, and a way out.
            if root.chat-mode : Rectangle {
                height: Theme.lens-input-height;
                background: Theme.bg-surface;

                HorizontalLayout {
                    padding-left: 16px;
                    padding-right: 8px;
                    spacing: 10px;

                    Icon {
                        commands: Icons.companion;
                        size: 16px;
                        tint: Theme.accent;
                        y: (parent.height - self.height) / 2;
                    }
                    Text {
                        text: root.mind-name != "" ? root.mind-name : "Conversation";
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        overflow: elide;
                    }
                    // The Lens is the quick question; the whole of the conversation — every call as
                    // a card, every command with its output — is this mind's agent on the Agents
                    // screen (design/agents-workspace-2026-09-23.md, "The shape").
                    // Every earlier conversation, with any mind: the Agents screen's All tab, where
                    // each opens with its whole session and can be carried on (#246).
                    if root.can-open-in-agents : history-hit := TouchArea {
                        width: history-label.preferred-width + 16px;
                        height: 28px;
                        y: (parent.height - 28px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.open-history(); }

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: 6px;
                            background: history-hit.has-hover ? Theme.hover-fill : transparent;
                        }
                        history-label := Text {
                            width: parent.width;
                            height: parent.height;
                            text: "History";
                            color: history-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                            font-size: Theme.fs-caption;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    if root.can-open-in-agents : agents-hit := TouchArea {
                        width: agents-label.preferred-width + 16px;
                        height: 28px;
                        y: (parent.height - 28px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.open-in-agents(); }

                        Rectangle {
                            width: parent.width;
                            height: parent.height;
                            border-radius: 6px;
                            background: agents-hit.has-hover ? Theme.hover-fill : transparent;
                        }
                        agents-label := Text {
                            width: parent.width;
                            height: parent.height;
                            text: "open in Agents";
                            color: agents-hit.has-hover ? Theme.text-primary : Theme.accent;
                            font-size: Theme.fs-caption;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                    close-hit := TouchArea {
                        width: 28px;
                        height: 28px;
                        y: (parent.height - 28px) / 2;
                        mouse-cursor: pointer;
                        clicked => { root.close-lens(); }

                        Rectangle {
                            width: 28px;
                            height: 28px;
                            border-radius: 6px;
                            // Named rather than walked up to: `parent.parent` is not a thing
                            // in Slint, and the id reads better anyway.
                            background: close-hit.has-hover ? Theme.hover-fill : transparent;
                            Icon {
                                commands: Icons.close;
                                size: 14px;
                                tint: close-hit.has-hover ? Theme.text-primary : Theme.text-dim;
                                x: (parent.width - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                            }
                        }
                    }
                }

                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            // ── Input area (search mode) ──
            //
            // Collapsed rather than removed: the component ends with
            // `forward-focus: lens-input`, which is what puts the cursor in this field the
            // moment the Lens opens. An element inside an `if` cannot be the target of that,
            // so taking the row out of the tree would cost the Lens its typing focus — the
            // primary interaction of this desktop — to tidy up a layout.
            Rectangle {
                height: root.chat-mode ? 0px : Theme.lens-input-height;
                visible: !root.chat-mode;
                clip: true;
                background: Theme.bg-surface;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 12px;

                    // Thinking indicator / search icon
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: (parent.height - 20px) / 2;

                        // Search circle
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            border-width: 2px;
                            border-color: root.is-thinking ? Theme.amber : Theme.text-dim;
                            background: transparent;

                            animate border-color { duration: 300ms; }
                        }

                        // Search handle
                        Rectangle {
                            x: 12px;
                            y: 12px;
                            width: 6px;
                            height: 2px;
                            background: root.is-thinking ? Theme.amber : Theme.text-dim;
                            // Rotated 45deg approximation
                            border-radius: 1px;

                            animate background { duration: 300ms; }
                        }
                    }

                    // Text input
                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.lens-input-height;
                        // The field below is now as wide as its own text, so without a minimum
                        // of its own this box would ask the row for that width and a long
                        // question would push the Escape hint off the panel. One pixel, the same
                        // floor Slint's own LineEditBase sets, and for the same second reason it
                        // gives: a TextInput narrower than a pixel cannot be focused.
                        min-width: 1px;
                        forward-focus: lens-input;
                        clip: true;

                        lens-input := TextInput {
                            // ── Long questions scroll instead of vanishing ──────────────────
                            //
                            // This was `width: parent.width` inside a clipping box, which is the
                            // one combination that cannot scroll: the text is laid out at the
                            // width of the field, so everything past the edge — around 32
                            // characters at this font size — was drawn outside and clipped away,
                            // caret included. You went on typing with no idea what you had
                            // written, and could not see the end of your own question before
                            // pressing Enter on it. The ask bar is the primary interaction of
                            // this desktop and it could not hold a sentence.
                            //
                            // The fix is Slint's own, lifted from `LineEditBase` in the widget
                            // set (i-slint-compiler/widgets/common/lineedit-base.slint): let the
                            // field be as wide as its text, keep a private offset, and move that
                            // offset just far enough to keep the caret inside the visible box
                            // whenever it moves. `min`/`max` pin it so the text never scrolls
                            // past either end.
                            property <length> computed-x;
                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            cursor-position-changed(cursor-position) => {
                                if (cursor-position.x + self.computed-x < 0px) {
                                    self.computed-x = -cursor-position.x;
                                } else if (cursor-position.x + self.computed-x > parent.width - self.text-cursor-width) {
                                    self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                                }
                            }

                            y: (parent.height - self.preferred-height) / 2;
                            color: Theme.text-primary;
                            font-size: Theme.fs-title-1;
                            // single-line: true is REQUIRED for `accepted` to fire.
                            // With single-line: false, Slint treats Return as "insert
                            // newline" and never invokes accepted — which made the
                            // Intent Lens (the shell's primary interaction) impossible
                            // to submit with Enter.
                            single-line: true;
                            text <=> root.input-text;

                            // Escape and the arrows, handled where the focus actually is.
                            //
                            // `key-handler` at the foot of this file has held this logic for as
                            // long as it has existed and has never run: it is a 0x0 FocusScope
                            // beside the panel, so it is neither focused nor an ancestor of
                            // anything that is, and a key event reaches neither. Now that the
                            // field takes the cursor when the Lens opens, that matters — Escape
                            // has to close the panel from inside the field, or the Lens is a trap
                            // you can only leave with the mouse.
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.close-lens();
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    return accept;
                                }
                                return reject;
                            }

                            accepted => {
                                if root.input-text != "" {
                                    // Active search: Enter selects the highlighted result.
                                    if root.results.length > 0 {
                                        root.result-selected(
                                            root.results[clamp(root.selected-index, 0, root.results.length - 1)].action-id
                                        );
                                    } else {
                                        root.submit-query(root.input-text);
                                    }
                                } else {
                                    // Idle state: Enter executes first suggestion
                                    if root.suggestions.length > 0 {
                                        root.result-selected(root.suggestions[0].action-id);
                                    }
                                }
                            }
                        }

                        // Placeholder
                        if root.input-text == "" : Text {
                            y: (parent.height - self.preferred-height) / 2;
                            text: "Search, ask, or do anything...";
                            color: Theme.text-dim;
                            font-size: Theme.fs-title-1;
                        }
                    }

                    // Escape hint
                    Rectangle {
                        width: 36px;
                        height: 22px;
                        y: (parent.height - 22px) / 2;
                        border-radius: 4px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        Text {
                            text: "esc";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Bottom divider
                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            // ── Thinking indicator bar ──
            //
            // This cost the machine three quarters of a core for as long as a mind was working,
            // with the panel closed (#68: `yantrik-ui` at 83 % against 2.0 % four minutes later,
            // from /proc task stat deltas). Two mistakes, and the second is the expensive one.
            //
            // It was gated on `is-thinking` alone. The panel it lives in is `visible: root.is-open`
            // — visible, not conditional — so with the Lens closed this element still existed, its
            // timer still ticked, and every tick wrote a property the scene depends on. Slint does
            // not care that the item is invisible: a changed property is a dirty scene and a frame
            // is requested. Thinking is minutes for a real job, and a mind at work is exactly when
            // the person is doing something else on this machine.
            //
            // And it swept at 16 ms — sixty full-screen repaints a second, the compositor paying
            // again for each, to move a 2px gradient. A pulse says the same thing. 160 ms a step
            // at 0.08 keeps the 2 s cycle the sweep had, at a tenth of the frames.
            if root.is-open && root.is-thinking : Rectangle {
                height: 2px;
                width: 100%;

                property <float> pulse-phase: 0;
                Timer {
                    interval: 160ms;
                    running: root.is-open && root.is-thinking;
                    triggered => { parent.pulse-phase = mod(parent.pulse-phase + 0.08, 1.0); }
                }

                Rectangle {
                    width: 100%;
                    height: 2px;
                    background: @linear-gradient(90deg,
                        transparent 0%,
                        Theme.amber 35%,
                        Theme.cyan 75%,
                        transparent 100%
                    );
                    opacity: 0.35 + 0.45 * (0.5 + 0.5 * sin(pulse-phase * 6.2832 * 1rad));
                }
            }

            // ── Results feed (non-chat mode) ──
            if !root.chat-mode : VerticalLayout {
                padding: 4px;
                padding-bottom: 8px;

                // ── Active search results (when user has typed something) ──
                for result[idx] in root.results : Rectangle {
                    height: result.is-loading ? Theme.lens-result-height
                        : result.result-type == "divider" ? 24px
                        : result.result-type == "answer" ? Theme.lens-answer-height
                        : Theme.lens-result-height;
                    property <bool> row-selected: idx == root.selected-index;

                    // ── Skeleton shimmer row (loading placeholder) ──
                    if result.is-loading : Rectangle {
                        width: 100%;
                        height: Theme.lens-result-height;
                        border-radius: 8px;

                        // Same two corrections as the thinking bar above: a skeleton row behind a
                        // closed panel is a row nobody can see, and a shimmer is a pulse. 160 ms
                        // at 0.1 keeps the 1.6 s cycle.
                        property <float> shimmer-phase: 0;
                        Timer {
                            interval: 160ms;
                            running: root.is-open && result.is-loading;
                            triggered => {
                                parent.shimmer-phase = mod(parent.shimmer-phase + 0.1, 1.0);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            // Shimmer badge
                            Rectangle {
                                width: 28px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                border-radius: 4px;
                                background: Theme.color-skeleton;
                                opacity: 0.4 + 0.3 * sin(shimmer-phase * 6.2832 * 1rad);
                            }

                            // Shimmer text bars
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 6px;

                                Rectangle {
                                    width: 60%;
                                    height: 12px;
                                    border-radius: 3px;
                                    background: Theme.color-skeleton;
                                    opacity: 0.3 + 0.3 * sin(shimmer-phase * 6.2832 * 1rad);
                                }
                                Rectangle {
                                    width: 40%;
                                    height: 8px;
                                    border-radius: 2px;
                                    background: Theme.color-skeleton;
                                    opacity: 0.2 + 0.2 * sin((shimmer-phase + 0.15) * 6.2832 * 1rad);
                                }
                            }
                        }
                    }

                    // ── Divider row ──
                    if result.result-type == "divider" && !result.is-loading : Rectangle {
                        width: 100%;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.separator; }
                            Text {
                                text: result.title;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                            }
                            Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.separator; }
                        }
                    }

                    // ── Answer row (inline computed result, e.g. math, time) ──
                    if result.result-type == "answer" && !result.is-loading : TouchArea {
                        height: Theme.lens-answer-height;
                        property <bool> hovered: self.has-hover;
                        clicked => {
                            root.selected-index = idx;
                            if result.action-id != "" {
                                root.result-selected(result.action-id);
                            }
                        }

                        Rectangle {
                            width: 100%;
                            height: Theme.lens-answer-height;
                            border-radius: 8px;
                            background: row-selected ? Theme.bg-selected
                                : parent.hovered ? Theme.bg-card
                                : transparent;

                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;

                                // Answer badge (holographic blue with glow)
                                Rectangle {
                                    width: 32px;
                                    height: 24px;
                                    y: (parent.height - 24px) / 2;
                                    border-radius: 6px;
                                    background: Theme.color-answer;
                                    opacity: 0.2;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: Theme.holo-blue.transparentize(81%);

                                    Text {
                                        text: result.icon-char;
                                        color: Theme.color-answer;
                                        font-size: Theme.fs-body;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Title + large inline value
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: result.title;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        letter-spacing: 1px;
                                    }

                                    Text {
                                        text: result.inline-value;
                                        color: Theme.color-answer;
                                        font-size: Theme.fs-display;
                                        font-weight: 600;
                                    }
                                }
                            }
                        }
                    }

                    // ── Normal result row ──
                    if result.result-type != "divider" && result.result-type != "answer" && !result.is-loading : TouchArea {
                        height: Theme.lens-result-height;
                        property <bool> hovered: self.has-hover;
                        clicked => {
                            root.selected-index = idx;
                            root.result-selected(result.action-id);
                        }

                    Rectangle {
                        property <bool> is-hovered: parent.hovered;
                        property <bool> is-sel: row-selected;
                        width: 100%;
                        height: Theme.lens-result-height;
                        border-radius: 8px;
                        background: is-sel ? Theme.bg-selected
                            : is-hovered ? Theme.bg-card
                            : transparent;
                        border-width: is-sel ? 1px : 0;
                        border-color: is-sel ? Theme.hover-fill-strong : transparent;

                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            // Type badge
                            Rectangle {
                                width: 28px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                border-radius: 4px;
                                background:
                                    result.result-type == "do"        ? Theme.color-do :
                                    result.result-type == "find"      ? Theme.color-find :
                                    result.result-type == "ask"       ? Theme.color-ask :
                                    result.result-type == "memory"    ? Theme.color-memory :
                                    result.result-type == "tool"      ? Theme.color-tool :
                                    result.result-type == "clipboard" ? Theme.color-clipboard :
                                    result.result-type == "context"   ? Theme.color-context :
                                    result.result-type == "recent"    ? Theme.color-recent :
                                    Theme.color-setting;
                                opacity: 0.15;

                                Text {
                                    text: result.icon-char;
                                    color:
                                        result.result-type == "do"        ? Theme.color-do :
                                        result.result-type == "find"      ? Theme.color-find :
                                        result.result-type == "ask"       ? Theme.color-ask :
                                        result.result-type == "memory"    ? Theme.color-memory :
                                        result.result-type == "tool"      ? Theme.color-tool :
                                        result.result-type == "clipboard" ? Theme.color-clipboard :
                                        result.result-type == "context"   ? Theme.color-context :
                                        result.result-type == "recent"    ? Theme.color-recent :
                                        Theme.color-setting;
                                    font-size: Theme.fs-micro;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Title + subtitle
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: result.title;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    overflow: elide;
                                }

                                if result.subtitle != "" : Text {
                                    text: result.subtitle;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                }
                            }

                            // Score indicator bar (3px on right side)
                            if result.score > 0.0 : Rectangle {
                                width: 3px;
                                height: parent.height * 0.6;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.5px;
                                background: Theme.cyan;
                                opacity: result.score;
                            }

                            // "Enter" hint on selected result
                            if row-selected : Rectangle {
                                width: 36px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                border-radius: 4px;
                                background: Theme.hover-fill;

                                Text {
                                    text: "↵";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        } // HorizontalLayout
                    } // Rectangle (result card)
                    } // TouchArea (normal result)
                } // for loop container

                // Offline banner — shown when AI backend is unreachable
                if !root.companion-online : Rectangle {
                    height: 32px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-left: 16px;

                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            y: (parent.height - 6px) / 2;
                            background: Theme.color-emotional;
                        }
                        Text {
                            text: "AI offline — apps and tools still work";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                        }
                    }
                }

                // ── Idle state: Suggestions + Recents (empty query, no results) ──
                if root.results.length == 0 && root.input-text == "" : VerticalLayout {
                    spacing: 4px;

                    // ── SUGGESTED section ──
                    if root.suggestions.length > 0 : VerticalLayout {
                        spacing: 0;

                        // Section header
                        Rectangle {
                            height: Theme.section-header-height;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: "SUGGESTED";
                                        color: Theme.color-context;
                                        font-size: Theme.fs-micro;
                                        font-weight: 700;
                                        letter-spacing: 2px;
                                    }
                                    // Animated underline
                                    Rectangle {
                                        width: 60px;
                                        height: 1px;
                                        background: Theme.color-context;
                                        opacity: 0.4;
                                    }
                                }
                            }
                        }

                        for sg[sg-idx] in root.suggestions : TouchArea {
                            height: Theme.lens-result-height;
                            property <bool> hovered: self.has-hover;
                            clicked => { root.result-selected(sg.action-id); }

                            Rectangle {
                                width: 100%;
                                height: Theme.lens-result-height;
                                border-radius: 8px;
                                background: parent.hovered ? Theme.bg-card : transparent;
                                animate background { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;

                                    // Context badge with pulsing dot
                                    Rectangle {
                                        width: 28px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 4px;
                                        background: Theme.color-context;
                                        opacity: 0.12;

                                        // Pulsing ambient dot
                                        Rectangle {
                                            x: 20px;
                                            y: 0;
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: Theme.color-context;
                                            opacity: 0.5 + 0.5 * sin(root.suggestion-dot-phase * 6.2832 * 1rad);
                                        }

                                        Text {
                                            text: sg.icon-char;
                                            color: Theme.color-context;
                                            font-size: Theme.fs-micro;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: sg.title;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            overflow: elide;
                                        }
                                        if sg.subtitle != "" : Text {
                                            text: sg.subtitle;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── RECENT section ──
                    if root.recents.length > 0 : VerticalLayout {
                        spacing: 0;

                        // Section header
                        Rectangle {
                            height: Theme.section-header-height;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: "RECENT";
                                        color: Theme.color-recent;
                                        font-size: Theme.fs-micro;
                                        font-weight: 700;
                                        letter-spacing: 2px;
                                    }
                                    Rectangle {
                                        width: 44px;
                                        height: 1px;
                                        background: Theme.color-recent;
                                        opacity: 0.3;
                                    }
                                }
                            }
                        }

                        for rc[rc-idx] in root.recents : TouchArea {
                            height: Theme.lens-result-height;
                            property <bool> hovered: self.has-hover;
                            clicked => { root.result-selected(rc.action-id); }

                            Rectangle {
                                width: 100%;
                                height: Theme.lens-result-height;
                                border-radius: 8px;
                                background: parent.hovered ? Theme.bg-card : transparent;
                                animate background { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;

                                    // Recent badge (dimmer steel)
                                    Rectangle {
                                        width: 28px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 4px;
                                        background: Theme.color-recent;
                                        opacity: 0.12;

                                        Text {
                                            text: rc.icon-char;
                                            color: Theme.color-recent;
                                            font-size: Theme.fs-micro;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: rc.title;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            overflow: elide;
                                            opacity: 0.8;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Fallback empty state (no suggestions, no recents)
                    if root.suggestions.length == 0 && root.recents.length == 0 : Rectangle {
                        height: 64px;
                        VerticalLayout {
                            alignment: center;
                            padding-left: 20px;

                            Text {
                                text: root.companion-online
                                    ? "Type to search, ask, or command"
                                    : "Type to search apps and tools";
                                color: Theme.text-dim;
                                font-size: Theme.fs-body;
                            }
                        }
                    }
                }
            }

            // ── Chat mode (multi-turn conversation) ──
            if root.chat-mode : VerticalLayout {
                // The cursor goes in the reply box when the Lens opens in chat mode — which is
                // most of the time, because the Lens restores chat mode whenever the
                // conversation has messages in it.
                //
                // The obvious place for this is the `changed is-open` handler on the component
                // root, beside the one that focuses the search field. It cannot go there:
                // `chat-input` is inside this `if`, and Slint will not let an id inside a
                // conditional be named from outside it. Mirroring `is-open` onto a property of
                // this element puts the change where the field is visible, which is the same
                // handler in the only scope that can write it.
                property <bool> lens-open: root.is-open;
                changed lens-open => {
                    if (self.lens-open) { chat-input.focus(); }
                }
                // ...and when this block is CREATED already open, which is the usual way in: the
                // ask bar sets `is-open`, and only then does `open_lens` notice the conversation
                // has messages and switch chat mode on. This element comes into being with
                // `lens-open` true, a property that starts true has not changed, and the handler
                // above never ran — the panel opened with the cursor nowhere, and a sentence
                // typed straight after clicking the ask bar went to nothing at all. One tick
                // later rather than in `init`, because a field cannot take focus before it has
                // been laid out.
                property <bool> focus-owed: true;
                Timer {
                    interval: 30ms;
                    running: parent.focus-owed;
                    triggered => {
                        parent.focus-owed = false;
                        if (parent.lens-open) { chat-input.focus(); }
                    }
                }

                // Messages — fills available panel height, down to `transcript-min` while a
                // card is waiting (see the property at the top of the component).
                ListView {
                    vertical-stretch: 1;
                    min-height: root.transcript-min;

                    for msg[idx] in root.messages : MessageBubble {
                        data: msg;
                    }
                }

                // Approval cards and their records, between the conversation and the reply box.
                //
                // Here rather than interleaved in the ListView above because a request is not a
                // message: it arrives while the person is reading, it has to stay put while they
                // decide, and a card that scrolls away with the transcript is a card that gets
                // missed. It reads as the newest thing in the conversation, which is what it is.
                if root.approvals.length > 0 : VerticalLayout {
                    spacing: Theme.sp-1;
                    padding-top: Theme.sp-2;
                    padding-bottom: Theme.sp-2;
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;

                    for item[idx] in root.approvals : ApprovalCard {
                        data: item;
                        // The tallest the card may be and still leave the panel showing
                        // everything else it owes: the header, the transcript sliver above and
                        // the reply box below — the reply box was what went off the bottom edge
                        // in #218, with the card's buttons a 3px sliver above it. The panel is
                        // the window between the two bars; from it go the header row, the reply
                        // bar at whatever height it has grown to, the transcript's floor, this
                        // block's padding with its "N more waiting" line (40px), and one row
                        // (32px) per decided record sharing this block with the card. The floor
                        // keeps a card's identity rows and buttons on any panel tall enough to
                        // hold them at all.
                        height-limit: max(240px, root.height - Theme.status-bar-height
                            - Theme.taskbar-height - Theme.lens-input-height - chat-bar.height
                            - root.transcript-min - 40px - 32px * root.approvals.length);
                        allow => { root.approval-allow(item.id); }
                        allow-session => { root.approval-allow-session(item.id); }
                        deny => { root.approval-deny(item.id); }
                    }

                    if root.approvals-waiting > 0 : Text {
                        text: root.approvals-waiting + " more waiting — this one first";
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }

                // Typing indicator
                //
                // Generating runs as long as thinking does, and this had the same gate and the
                // same 16 ms as the bar above — three 5px dots holding the display at its frame
                // rate whether or not the conversation was on screen. 160 ms at 0.05 keeps the
                // 3.2 s cycle, and the offsets between the dots are unchanged.
                if root.is-open && root.is-generating : HorizontalLayout {
                    padding-left: 20px;
                    padding-bottom: 8px;
                    spacing: 6px;

                    property <float> dot-phase: 0;
                    Timer {
                        interval: 160ms;
                        running: root.is-open && root.is-generating;
                        triggered => {
                            parent.dot-phase = mod(parent.dot-phase + 0.05, 1.0);
                        }
                    }

                    Rectangle {
                        width: 5px; height: 5px; border-radius: 2.5px;
                        background: Theme.cyan;
                        opacity: 0.3 + 0.7 * sin(dot-phase * 6.2832 * 1rad);
                    }
                    Rectangle {
                        width: 5px; height: 5px; border-radius: 2.5px;
                        background: Theme.cyan;
                        opacity: 0.3 + 0.7 * sin((dot-phase + 0.12) * 6.2832 * 1rad);
                    }
                    Rectangle {
                        width: 5px; height: 5px; border-radius: 2.5px;
                        background: Theme.cyan;
                        opacity: 0.3 + 0.7 * sin((dot-phase + 0.24) * 6.2832 * 1rad);
                    }
                }

                // Input bar for chat mode. Grows with the field inside it (see `chat-input`),
                // and named because the approval card's height-limit above subtracts what it is
                // actually holding, not a guess at it.
                chat-bar := Rectangle {
                    height: max(48px, min(118px, chat-input.preferred-height + 14px) + 16px);
                    background: Theme.bg-deep;

                    Rectangle {
                        y: 0; width: 100%; height: 1px;
                        background: Theme.separator;
                    }

                    HorizontalLayout {
                        padding: 8px;
                        padding-left: 12px;
                        padding-right: 12px;
                        spacing: 8px;

                        // Mic button
                        TouchArea {
                            width: 32px;
                            height: 32px;
                            clicked => { root.mic-pressed(); }

                            Rectangle {
                                width: 32px; height: 32px;
                                border-radius: 16px;
                                background: Theme.bg-card;
                                border-width: 1px;
                                border-color: Theme.cyan-dim;

                                Rectangle {
                                    x: (parent.width - 8px) / 2;
                                    y: 8px;
                                    width: 8px; height: 10px;
                                    border-radius: 4px;
                                    background: Theme.cyan;
                                }
                            }
                        }

                        // Chat input
                        Rectangle {
                            horizontal-stretch: 1;
                            // As tall as what has been typed, up to five lines or so. It was a
                            // fixed 32px around a field that wraps, so the second line of a
                            // sentence pushed the first one out through the top of the box.
                            height: max(32px, min(118px, chat-input.preferred-height + 14px));
                            border-radius: 16px;
                            background: Theme.bg-input;
                            border-width: 1px;
                            border-color: chat-input.has-focus ? Theme.cyan-dim : Theme.border-subtle;
                            forward-focus: chat-input;
                            clip: true;

                            animate border-color { duration: 200ms; }

                            chat-input := TextInput {
                                property <string> chat-text: "";
                                x: 12px;
                                // Centred while it fits; past the box's limit the LAST line is
                                // the one kept in view, because that is where the cursor is.
                                y: self.preferred-height + 14px <= parent.height
                                    ? (parent.height - self.preferred-height) / 2
                                    : parent.height - self.preferred-height - 7px;
                                width: parent.width - 24px;
                                color: Theme.text-primary;
                                font-size: Theme.fs-body;
                                wrap: word-wrap;
                                single-line: false;
                                text <=> chat-text;
                                // The same reason as the search field: this one takes the cursor
                                // when the Lens opens in chat mode, and a panel you cannot close
                                // from the keyboard once you are typing in it is a trap.
                                key-pressed(event) => {
                                    if (event.text == Key.Escape) {
                                        root.close-lens();
                                        return accept;
                                    }
                                    // Enter sends; Shift+Enter is a new line. A multi-line
                                    // TextInput never fires `accepted` — Enter is a character to
                                    // it — so the handler below had not run since this field was
                                    // made multi-line, and the only way to send a second message
                                    // was to reach for the mouse and press `>`.
                                    if (event.text == Key.Return && !event.modifiers.shift) {
                                        if (self.chat-text != "") {
                                            root.send-message(self.chat-text);
                                            self.chat-text = "";
                                        }
                                        return accept;
                                    }
                                    return reject;
                                }
                                accepted => {
                                    if chat-text != "" {
                                        root.send-message(chat-text);
                                        chat-text = "";
                                    }
                                }
                            }

                            if chat-input.chat-text == "" : Text {
                                x: 12px;
                                y: (parent.height - self.preferred-height) / 2;
                                text: "Continue conversation...";
                                color: Theme.text-dim;
                                font-size: Theme.fs-body;
                            }
                        }

                        // Send
                        TouchArea {
                            width: 32px;
                            height: 32px;
                            clicked => {
                                if chat-input.chat-text != "" {
                                    root.send-message(chat-input.chat-text);
                                    chat-input.chat-text = "";
                                }
                            }

                            Rectangle {
                                width: 32px; height: 32px;
                                border-radius: 16px;
                                background: chat-input.chat-text != "" ? Theme.amber : Theme.bg-card;

                                animate background { duration: 150ms; }

                                Text {
                                    text: ">";
                                    color: chat-input.chat-text != "" ? Theme.bg-deep : Theme.text-dim;
                                    font-size: Theme.fs-title-2;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        }
                    }
                }
            }
        }
    }

    // Reset selection when results change
    changed results => { root.selected-index = 0; }

    // Keyboard navigation — Up/Down/Tab move selection, Escape closes.
    //
    // Kept, and no longer the only copy. This is a 0x0 FocusScope standing beside the panel: it
    // is not focused and it is not an ancestor of the field that is, so Slint has never had a
    // path to deliver a key to it, and Escape and the arrows did nothing for as long as the Lens
    // has existed. The field carries the same three keys now (see `lens-input.key-pressed`);
    // this stays for the case where something else inside the panel has focus and rejects a key,
    // which does reach it by bubbling.
    key-handler := FocusScope {
        width: 0; height: 0;
        key-pressed(event) => {
            if event.text == Key.DownArrow || event.text == Key.Tab {
                root.move-selection(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-selection(-1);
                return accept;
            }
            if event.text == Key.Escape {
                root.close-lens();
                return accept;
            }
            return reject;
        }
    }

    // Auto-focus input when lens opens
    forward-focus: lens-input;
}
