// Intent Lens — the primary interaction primitive of Yantrik OS.
// Centered 720px panel. Single input + unified ranked result feed.
// Replaces chat panel, app launcher, search, and settings access.
//
// States:
//   closed → open (input + results) → chat (multi-turn conversation)
//
// Invoke: Super key or click anchor dot / orb.
// Dismiss: Escape or click outside.

import { Theme } from "theme.slint";
import { QuestionRequest, QuestionCard } from "question_card.slint";
import { Icon, Icons } from "icon.slint";
import { MessageData } from "message_bubble.slint";
import { WorkCardData, WorkCard, WorkStrip } from "work_card.slint";
import { ChatMessage } from "chat_message.slint";
import { ChatTranscript } from "chat_transcript.slint";
import { ChatComposer } from "chat_composer.slint";
import { ChatHeader, ChatEmpty } from "chat_chrome.slint";
export { WorkCardData } from "work_card.slint";
import { YButton } from "y_button.slint";

// A single result in the Intent Feed.
export struct LensResult {
    result-type: string,     // "do", "find", "ask", "memory", "setting", "tool",
                             // "clipboard", "divider", "context", "recent", "answer"
    title: string,           // Main display text
    subtitle: string,        // "Why" rationale line
    icon-char: string,       // Single-char badge
    action-id: string,       // Identifier for callback
    score: float,            // 0.0-1.0 ranking confidence
    is-loading: bool,        // When true, render as skeleton shimmer
    inline-value: string,    // For "answer" type: computed value shown prominently
}

// ── Asking the person ───────────────────────────────────────────────
//
// A mind found the dentist appointment, called `calendar.delete_event`, and the bridge refused
// it: the action is graded `sensitive` and the bridge's ceiling is `standard`. The mind then
// told the person to "approve it right here in the chat panel" — there was nothing to approve
// with — "or raise YOS_MCP_MAX_PERMISSION in the settings". This is the card that should have
// been there. See `crates/yantrik-ui/src/approvals.rs` and design/approvals-2026-09-21.md.
//
// Everything the person needs to decide is on the card: who is asking, what the action does in
// the app's own words, every argument, and the grade. Not a summary of the arguments — the
// arguments — because the grant is bound to exactly these, and a card that showed a paraphrase
// would be asking them to approve something they had not read.
export struct ApprovalRequest {
    id: string,
    // Which of the person's agents is asking (`pi:c-7f3a91`), or "" for a caller that is no agent.
    // Established by the shell from the agent token beside the request, checked against the
    // caller's process — never from the request's words. The same card is drawn in that agent's
    // pane on the Agents screen, under the same id (design/agents-workspace-2026-09-23.md, 4).
    agent: string,
    // Who that agent works for, when not simply the person: "Council recipe → Reviewer" for a
    // recipe's agent, "Reviewer" for a role. The shell's own record of how it started the agent,
    // never the request's words.
    on-behalf: string,
    // What the caller CALLS itself. Nothing authenticates it; the card says so underneath.
    requester: string,
    // What this MACHINE knows: the program the kernel says opened the socket, resolved through
    // /proc to the first ancestor a person would recognise. Never empty — `caller_identity`
    // answers "could not be identified" rather than leaving a blank where a fact should be.
    verified: string,
    // The card's first identity line: the walk's structured findings in words, "Caller process
    // confirmed: sshd-session · PID 2290461 · from a terminal", with `identity-tag` ("not verified"
    // when nothing could be established, else empty) drawn beside it and never cut — and under it
    // `claim`, "Claimed name: “design-sweep”", in amber with "· not verified" beside it. Worded
    // in approval_wording.rs (review by GPT-6 Astra, B); the fact always comes first (design
    // sign-off, 4 October, item 2), and neither is read from the caller's argv.
    identity: string,
    identity-tag: string,
    claim: string,
    // What does not add up about this request, one already-bounded sentence per entry — the
    // claimed name names an attached mind the ancestry contradicts, or the claimed grade is not
    // the one the app publishes. Drawn in the same red as `warning`, because they are the same
    // kind of thing: a reason to stop reading the name and start reading the lines under it.
    // A list, so a third of these later costs no markup and no new height arithmetic.
    discrepancies: [string],
    app: string,
    action: string,
    // The action's own first sentence — one person-facing line (#218). The paragraph below is
    // what the protocol detail looks like to a person: `run_recipe`'s card led with "A formation
    // — Council, Red team, Build, Writers' room; `describe shell` → `recipes` → `formations`
    // lists each with its `inputs`…". Picked out of the published description in approvals.rs
    // (`summary_of`), so it is the app's own words and not a third name for the action. Empty
    // when the app publishes nothing; the card then hides this row rather than inventing one.
    summary: string,
    purpose: string,        // the action's own published description — never the caller's
    // What the CALLER says the call is for: nothing checks it. Its own block, under its own
    // label, after the app's sentence — never joined to it (re-review of #504: joined and cut
    // together, a padded caller purpose pushed the app's sentence off the card and drew a fake
    // "in the app's own words" line in its place). One paragraph, bounded, with the phrases the
    // card uses for the app's voice marked as the caller's. Empty when it said nothing new.
    caller-says: string,
    grade: string,          // safe | standard | sensitive | dangerous
    args: [string],         // one `key: value` per entry, each already cut to fit one line
    // What one of those arguments stands for, in the app's own words:
    // `id 01a0c718… is "Dentist, Fri 25 Sep 13:00"` (#54). The card for a delete asked BY ID
    // showed only the uuid, which is nothing a person can answer a question about. This is a
    // sentence about the arguments, drawn beside them — never one more thing the grant binds
    // to — and empty when the app publishes no name index or names none of these values, in
    // which case the card hides the row rather than drawing a blank.
    target: string,
    // What the app says about THIS call, with these arguments (#137): Studio's card for
    // `set_backend kind=fake` can say "after this, prompts stay on this machine", where its
    // published purpose — the same paragraph for every call of the action — could only say
    // that naming a hosted service sends prompts away. One already-bounded sentence, drawn
    // under the argument box, and empty for an app that explains nothing per call, in which
    // case the card hides the block and is exactly what it was. Like `target`, a sentence
    // ABOUT the arguments, never one more thing the grant binds to — and while the card
    // carries one, it offers no "Allow for this session" (`can_session` below).
    explained: string,
    warning: string,        // "" unless there is something that cannot be undone
    // What changes (sign-off item 4), worded in approval_wording.rs with every argument and the
    // target escaped before they were joined (review of #639, B1):
    //   what     "Deletes: <target>", else "Deletes: <the arguments>" — one pinned line;
    //   exactly  every argument as the grant binds it, `; ` between — in full on the card's face
    //            when the pinned line names a target or is cut at the card's edge;
    //   undo     "Undo: not possible, the app says so", the caller-only form, or "".
    what: string,
    exactly: string,
    undo: string,
    // Graded dangerous, or the app says it cannot be undone: the affirmative button is the kit's
    // filled red and says the action (sign-off item 1). The same reading as `warning`.
    destructive: bool,
    // The affirmative button's words: the action from the APP's published id or description —
    // "Delete event" — on a destructive card, else "Allow once". Never the caller's purpose
    // (approval_wording::confirm_label is not handed it).
    confirm-label: string,
    // Whether "Allow for this session" may be offered at all. False for `dangerous` and for any
    // action whose own published sentence says it cannot be undone — the same predicate that
    // draws `warning`, so the card can never offer to stop asking about the thing it is warning
    // about — and false while the card carries an `explained` sentence (#137): that sentence
    // explained ONE call, and the session rule would stand in for every later one. Decided in
    // approvals.rs from the UNCLIPPED purpose.
    can-session: bool,
    decision: string,       // "" while waiting; then allowed | denied | expired
    record: string,         // the one line that stays in the conversation afterwards
    age-text: string,       // "Expires in 2 min, then declined", while waiting
    decided-at: string,     // "10:42" once decided: the resolved line's time
    // Once allowed: whether it was "for this session" (a standing rule) rather than once. The
    // resolved line says which, because the two are different promises.
    session: bool,
}

// One request, or — once it has been answered — the line it leaves behind.
//
// ── Why the body is wrapped in a layout that does nothing else ──
//
// The first build of this drew the card with its top off the top of the screen: the person saw
// the arguments and the buttons and not the header, the action name or what the action does.
//
// The cause was here, on the root element. Both branches below are conditional, and a Rectangle
// whose only children are conditional reports a `preferred-height` of zero — Slint computes a
// non-layout element's preferred size from its unconditional children, and there were none. So
// `height: self.preferred-height` resolved to zero, the enclosing VerticalLayout in app.slint
// sized the row at zero, and the real content — which sets its own height and is not clipped —
// spilled out of a box that had no room for it.
//
// The fix is structural rather than a number: one unconditional VerticalLayout holds both
// branches, and the root takes ITS preferred height. `if` inside a layout does contribute to
// that layout's preferred size, which is the whole difference. This is the same idiom
// `message_bubble.slint` uses (`height: msg-layout.preferred-height`), and the rule it teaches is
// worth keeping: never ask a bare Rectangle how tall it would like to be when everything in it
// is behind an `if`.
//
// Keyboard: there is deliberately NO default action. Both buttons are TouchAreas, which take no
// keyboard focus in Slint, so Enter cannot reach either of them. A person allowing something
// has to move the pointer and press the word Allow. That is the entire mechanism by which a
// grant exists, and it should cost a deliberate movement.
export component ApprovalCard inherits Rectangle {
    in property <ApprovalRequest> data;
    callback allow();
    callback allow-session();
    callback deny();
    // The resolved line's "View action": the run of the agent that asked.
    callback view-action();

    property <bool> waiting: root.data.decision == "";

    // How hard to look, said by the card's edge before a word is read: a `dangerous` request is
    // red, a `sensitive` one amber with its name on the heading, and a `standard` one neutral
    // (it is still a question that waits for the person, and the heading says so). When every
    // request was amber the grade was only in the small print and the cue was gone (review of
    // #580). Tokens only, so the colour system can restyle them.
    property <color> grade-edge: root.data.grade == "dangerous" ? Theme.color-danger
        : root.data.grade == "sensitive" ? Theme.chat-needs-you : Theme.chat-border;
    property <color> grade-ink: root.data.grade == "dangerous" ? Theme.color-danger
        : root.data.grade == "sensitive" ? Theme.chat-needs-you : Theme.chat-text;
    property <string> grade-label: root.data.grade == "dangerous" ? "Dangerous"
        : root.data.grade == "sensitive" ? "Sensitive" : "";

    // ── The card fits the panel it is drawn in, or it does not answer (#218) ──
    //
    // The Lens card for `shell.run_recipe` — the app's paragraph of a description, an agent
    // row, two arguments, the session row — came out taller than the Lens panel at 1280×800.
    // The card sets its own height and a layout cannot shrink it below that, so the panel's
    // VerticalLayout simply ran out of room at the bottom: the reply box went off the edge and
    // the Deny/Allow row showed as a 3px sliver above it. Scrolling could not help — the Lens
    // was already at its bottom — and a person could not answer the card at all.
    //
    // So whoever draws the card says how tall it may be, and the card keeps that promise by
    // making ONE part of itself yield: the middle — the whole sentence and the whole of the app's
    // word about this call when their pinned lines were cut, the exact name, the agent, Details
    // and source — which scrolls. Above it a floor is pinned, each line elided rather than
    // scrolled away: who is asking (the fact and the claim), any discrepancy, and the action's
    // sentence. Below it are pinned what changes — with every argument the grant binds, in full,
    // whenever the one-line summary of them cannot carry it — the first line of the app's word
    // about the call, the undo line, the warning and the buttons (review of #639; on main the
    // pinned identity rows alone outgrew the Lens's 240px and pushed the buttons out of the
    // card, over the transcript). The card is never taller than this limit and the buttons are
    // always inside it: when even the pinned lines do not fit, everything above the buttons
    // scrolls as one and Allow waits until its end has been in view (fourth review of #639; see
    // `allow-ready`). Every host passes a limit: the Lens its panel's arithmetic, the top-right
    // corner the screen between the bars (about 684px at 1280×800, 484px at 800×600), an
    // agent's pane the visible height of its own scroller (agents.slint, `card-limit`). The
    // out-of-reach default is for a host that has none of these.
    // Not called `max-height`: that name belongs to the Rectangle this inherits from, where it
    // is a layout constraint, and Slint refuses to let a component shadow a built-in property.
    in property <length> height-limit: 10000px;

    // Details and source: closed by default for a sensitive request, open for a dangerous one
    // (sign-off item 4). A press is remembered for the request it was made on, so a card that
    // takes this one's place starts at its own grade's default.
    // The request whose whole content has been in view: set when the section above the buttons,
    // having had to scroll, reaches its end. Allow waits for it (see `allow-ready`). Per request
    // id, like the disclosure below, so the next card in this place starts over.
    property <string> read-id: "";
    property <string> toggled-id: "";
    property <bool> toggled-open: false;
    property <bool> details-open: root.toggled-id == root.data.id ? root.toggled-open
        : root.data.grade == "dangerous";
    // The type size under Details: 13px, secondary (the sign-off's floor is 12px).
    property <length> details-type: 13px;

    // How much of the app's paragraph shows under Details before "show more" takes over: three
    // lines at the 13px type's 16px pitch — a rounder number clips the fourth line mid-glyph.
    // The 18px line already carries the description's first sentence, so the clamped paragraph
    // is for whoever wants the rest of it, and they ask (#218, item 3). A scroll of its own
    // inside the scrolling section would fight the outer one for the gesture.
    property <length> purpose-clamp: 48px;
    property <bool> purpose-open: false;
    // The caller's words get two lines before "show more": they are a claim, not the action.
    property <length> caller-clamp: 32px;
    property <bool> caller-open: false;

    height: body.preferred-height;
    background: transparent;

    body := VerticalLayout {

    // Decided: one collapsed line in the transcript, and nothing else. The card is gone; the
    // record of what was decided is not, because "did I allow that?" is a question people ask
    // afterwards. "Approved" is what the person did, not what happened next: whether the action
    // then ran is the run's business, and "View action" opens the run where it is recorded. The
    // whole record sentence stays one hover away as the line's accessible description.
    if !root.waiting : HorizontalLayout {
        padding-left: Theme.sp-4;
        padding-right: Theme.sp-4;
        padding-top: Theme.sp-1;
        padding-bottom: Theme.sp-1;
        spacing: Theme.sp-2;
        accessible-role: text;
        accessible-description: root.data.record;

        Text {
            text: root.data.decision == "allowed" ? "Approved by you"
                : root.data.decision == "denied" ? "Declined by you"
                : root.data.record;
            color: Theme.chat-text-2;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            horizontal-stretch: root.data.decision == "expired" ? 1 : 0;
            overflow: root.data.decision == "expired" ? elide : clip;
        }
        if root.data.decision != "expired" && root.data.decided-at != "" : Text {
            text: "\u{00b7} " + root.data.decided-at;
            color: Theme.chat-text-2;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            wrap: no-wrap;
        }
        // Which action, and for how long. A standing "for this session" rule and a one-off both
        // read "Approved by you · 10:42" before, so a person scrolling back could not tell that
        // a rule still stood or what it covered (review of #580). The end of the line is what
        // gets elided in a narrow panel, never these facts: they are the line's own stretch.
        if root.data.decision != "expired" && root.data.app != "" : Text {
            text: "\u{00b7} " + root.data.app + "." + root.data.action
                + (root.data.decision == "allowed" ? (root.data.session ? " (this session)" : " (once)") : "");
            color: Theme.chat-text-2;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.data.decision != "expired" && root.data.app == "" && root.data.decided-at == "" : Text {
            text: "\u{00b7} " + root.data.record;
            color: Theme.chat-text-2;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
            wrap: no-wrap;
            overflow: elide;
            horizontal-stretch: 1;
        }
        if root.data.agent != "" : view-ta := TouchArea {
            width: view-text.preferred-width;
            mouse-cursor: pointer;
            clicked => { root.view-action(); }
            view-text := Text {
                text: "\u{2014} View action";
                color: view-ta.has-hover ? Theme.chat-text : Theme.chat-text-2;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
                wrap: no-wrap;
            }
        }
        Rectangle { horizontal-stretch: 1; }
    }

    if root.waiting : card := Rectangle {
        border-radius: Theme.chat-radius;
        // Opaque, not glass: this card is drawn over whatever screen is up, and a question about
        // something that cannot be undone must not have another window's words showing through it.
        // The card's own ground (`chat-card`), so Decline reads as an outline in both modes.
        background: Theme.chat-card;
        border-width: 1px;
        // The edge carries the grade (`grade-edge` above).
        border-color: root.grade-edge;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.overlay-shadow;

        // ── Never taller than its host allows, and the buttons always inside it ──
        //
        // Fourth review of #639: at 800×600 the largest card a request may make put its buttons
        // under the window's edge — a card nobody can answer, held in front by card_watch until it
        // expires. Whatever the size, Decline and Allow are pinned at the foot, and everything
        // above them gets the room that is left (`above-room`).
        //
        // Three cases. Everything fits: nothing scrolls and Allow is live at once. The pinned lines
        // fit and the middle does not: the middle scrolls, as it always has, and Allow is live —
        // every argument the grant binds is on screen. Even the pinned lines do not fit: all of it
        // scrolls as one, and Allow stays disabled until that scroll has been to its end, so the
        // person has had every argument in view before they can allow it (`allow-ready`). Decline
        // is always live.
        property <length> above-room: max(0px, root.height-limit - decide.preferred-height
            - 2 * Theme.sp-2 - Theme.sp-2);
        // Measured on the pinned lines alone — the middle is what yields — so whether the card
        // overflows never depends on how tall the middle is drawn.
        property <bool> overflowing: pinned-floor.preferred-height + changes.preferred-height
            + 2 * Theme.sp-2 > self.above-room + 0.5px;
        // What the gate checks, and all it checks: that the section above the buttons has been at
        // its end at least once for this request id. A fling or a dragged scrollbar reaches the
        // end as surely as reading does; it proves every line was put in view, not that it was
        // read. And only a click on this card's own Allow reaches `allow()`, the one path to
        // `approval-allow` / `on_approval_allow` in the shell: nothing else on the card, and
        // nothing a caller sends, can press it.
        property <bool> allow-ready: !self.overflowing || root.read-id == root.data.id;
        // A new request in this card starts at its top, however far the last one was scrolled.
        property <string> card-id: root.data.id;
        changed card-id => { above-flick.viewport-y = 0px; }
        height: card-body.preferred-height;

        card-body := VerticalLayout {
            padding-left: Theme.sp-3;
            padding-right: Theme.sp-3;
            padding-top: Theme.sp-2;
            padding-bottom: Theme.sp-2;
            spacing: Theme.sp-2;

            // Everything above the buttons. As tall as it likes up to `above-room`, past which it
            // scrolls; reaching its end is what makes Allow live when it had to scroll.
            Rectangle {
                height: min(above-content.preferred-height, card.above-room);
                clip: true;

                above-flick := Flickable {
                    viewport-width: self.width;
                    viewport-height: above-content.preferred-height;
                    changed viewport-y => {
                        if (self.viewport-y <= self.height - self.viewport-height + 1px) {
                            root.read-id = root.data.id;
                        }
                    }

                    above-content := VerticalLayout {
                        spacing: Theme.sp-2;

            // ── The floor: who is asking and what the action is ──
            //
            // Each one line, cut at the card's edge when it must be — never scrolled away while the
            // pinned lines fit (review of #639, S1). The labels that say what kind of line each is
            // ("not verified") are their own Texts beside the cut one, so the cut can
            // only ever eat the caller's words or the program's name, never the label.
            pinned-floor := VerticalLayout {
                spacing: Theme.sp-1;

                HorizontalLayout {
                    spacing: Theme.sp-2;
                    Text {
                        text: "Approval needed";
                        color: root.grade-ink;
                        font-size: Theme.fs-body-strong;
                        font-weight: 600;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }
                    if root.grade-label != "" : Text {
                        text: "\u{00b7} " + root.grade-label;
                        color: root.grade-ink;
                        font-size: Theme.fs-body-strong;
                        font-weight: 600;
                        vertical-alignment: center;
                        wrap: no-wrap;
                    }
                    // How long it waits, in whole minutes, and what happens then (sign-off item 5).
                    Text {
                        text: root.data.age-text;
                        color: Theme.text-secondary;
                        font-size: Theme.fs-caption;
                        horizontal-alignment: right;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                // Who is asking — the fact first, the claim under it (sign-off item 2). The first
                // line is what this MACHINE established: the kernel stamps the peer's pid on the
                // socket at connect (SO_PEERCRED — the caller cannot write it) and
                // `caller_identity.rs` walks /proc up from there; the words come from that walk's
                // fields, never from the caller's argv. The second is whatever the caller called
                // itself, in amber and marked unverified: anything that can open the shell's socket
                // can put any string there.
                HorizontalLayout {
                    spacing: Theme.sp-1;
                    Text {
                        text: root.data.identity;
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        wrap: no-wrap;
                        overflow: elide;
                        // Shrinks, eliding, when the row is short of room; never grows past its
                        // words, so the tag sits right after them.
                        horizontal-stretch: 1;
                        max-width: self.preferred-width;
                    }
                    // Only when there is one: a confirmed caller's line says so itself.
                    if root.data.identity-tag != "" : Text {
                        text: "\u{00b7} " + root.data.identity-tag;
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        font-weight: 600;
                        wrap: no-wrap;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }
                HorizontalLayout {
                    spacing: Theme.sp-1;
                    Text {
                        text: root.data.claim;
                        color: Theme.chat-needs-you;
                        font-size: Theme.fs-caption;
                        wrap: no-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                        max-width: self.preferred-width;
                    }
                    Text {
                        text: "\u{00b7} not verified";
                        color: Theme.chat-needs-you;
                        font-size: Theme.fs-caption;
                        wrap: no-wrap;
                    }
                    Rectangle { horizontal-stretch: 1; }
                }

                // What the caller said and what the machine found do not agree — the kind of
                // disagreement a person cannot catch by reading, because the claim will look exactly
                // right. Same red bar as the warning; one line each, bounded where they are made.
                for said in root.data.discrepancies : HorizontalLayout {
                    spacing: Theme.sp-2;
                    Rectangle {
                        width: 3px;
                        background: Theme.color-danger;
                    }
                    Text {
                        text: said;
                        color: Theme.color-danger;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                        horizontal-stretch: 1;
                    }
                }

                // The action in words, at 18px (sign-off item 3): the app's own first sentence,
                // picked out of its published description in approvals.rs (`summary_of`) — never
                // the caller's words. One line here; when it is cut, the whole sentence is the first
                // thing in the section below.
                sentence-line := Text {
                    text: root.data.summary != "" ? root.data.summary
                        : "The app publishes no description of this action.";
                    color: Theme.text-primary;
                    font-size: Theme.fs-title-1;
                    font-weight: Theme.fw-body-strong;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            // ── The middle: everything that may yield ──
            //
            // The part that gives way first: its height is what is left of `above-room` once the
            // floor and what changes are subtracted, with the two gaps between them, and it
            // scrolls on its own. Where the card has room it is precisely as tall as its content
            // and nothing scrolls. When even the pinned lines do not fit, the whole section above
            // the buttons scrolls as one instead (see `overflowing`), and then the middle takes its
            // natural height inside it — the exact name, the agent, the whole sentence, the app's
            // word about the call and Details stay reachable by that one scroll, rather than
            // shrunk to nothing (fifth review of #639). Its own scroll is off then, so the wheel
            // over it moves the section the gate is watching.
            Rectangle {
                height: card.overflowing ? mid.preferred-height
                    : min(mid.preferred-height,
                          max(0px, card.above-room - pinned-floor.preferred-height
                              - changes.preferred-height - 2 * Theme.sp-2));
                clip: true;

                // A Flickable has no preferred height of its own, so the sizing Rectangle is
                // around it and the layout inside is what gets measured. Its viewport width is
                // said so that wrapping text measures its height from the card's width (left to
                // its default, width into height into width is a binding loop Slint rejects).
                Flickable {
                    viewport-width: self.width;
                    viewport-height: mid.preferred-height;
                    interactive: !card.overflowing;

                    mid := VerticalLayout {
                        spacing: Theme.sp-2;

            // The whole sentence, when the pinned line above had to cut it.
            if sentence-line.preferred-width > sentence-line.width : Text {
                width: parent.width;
                text: sentence-line.text;
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                wrap: word-wrap;
            }

            // The exact name: every other surface on this machine uses it, and a friendly
            // rewording would be a third. And which agent, from the token the shell issued it.
            VerticalLayout {
                spacing: 0px;
                Text {
                    text: root.data.app + "." + root.data.action;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    wrap: no-wrap;
                    overflow: elide;
                }
                if root.data.agent != "" : Text {
                    text: "agent " + (root.data.on-behalf == "" ? "" : root.data.on-behalf + " · ") + root.data.agent;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            // The whole of what the app says about THIS call (#137), when its pinned first line
            // below had to cut it.
            if root.data.explained != "" && explained-line.preferred-width > explained-line.width : Text {
                width: parent.width;
                text: explained-line.text;
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                wrap: word-wrap;
            }

            // ── Details and source ──
            //
            // Where each line came from, and the app's and the caller's words in full (sign-off
            // item 4). Closed by default for a sensitive request, open for a dangerous one. A
            // TouchArea, like every hit area on this card: nothing here takes keyboard focus.
            // The open state is kept per request id, so a card that replaces the one a person
            // closed starts in its own grade's default rather than inheriting the last one's.
            details-hit := TouchArea {
                height: 22px;
                mouse-cursor: pointer;
                clicked => {
                    root.toggled-open = !root.details-open;
                    root.toggled-id = root.data.id;
                }
                Text {
                    x: 0px;
                    width: parent.width;
                    height: parent.height;
                    text: (root.details-open ? "\u{25be} " : "\u{25b8} ") + "Details and source";
                    color: details-hit.has-hover ? Theme.text-primary : Theme.text-secondary;
                    font-size: root.details-type;
                    vertical-alignment: center;
                    wrap: no-wrap;
                }
            }

            if root.details-open : VerticalLayout {
                spacing: Theme.sp-2;

                // The provenance labels the rows above used to carry, each beside what it says.
                Text {
                    width: parent.width;
                    text: "Who is asking: the first line is what the kernel and this machine's own records said about the caller, not what the caller said; the name under it is the caller's own, and nothing on this machine checked it."
                        + (root.data.agent != "" ? " The agent is named by the token the desktop gave it, and it is also asked in its pane." : "");
                    color: Theme.text-secondary;
                    font-size: root.details-type;
                    wrap: word-wrap;
                }
                Text {
                    width: parent.width;
                    text: "The process the kernel's pid resolved to, by its command line (which the program writes itself): " + root.data.verified;
                    color: Theme.text-secondary;
                    font-size: root.details-type;
                    wrap: word-wrap;
                }

                // The app's whole description of the action — the same for every call of it.
                // Clamped to three lines under "show more", because `run_recipe`'s paragraph is
                // protocol detail for minds (#218); the 18px line already carries its first
                // sentence, and "show more" opens the rest in full.
                VerticalLayout {
                    spacing: 0px;
                    Text {
                        text: "What the app says about the action (its own first sentence is the line above):";
                        color: Theme.text-secondary;
                        font-size: root.details-type;
                        wrap: word-wrap;
                        width: parent.width;
                    }
                    Rectangle {
                        height: root.purpose-open ? purpose-text.preferred-height
                            : min(purpose-text.preferred-height, root.purpose-clamp);
                        clip: true;

                        purpose-text := Text {
                            width: parent.width;
                            // Pinned to the box's top edge: left to its own geometry the
                            // paragraph centers itself on the clamped box, and the window then
                            // shows the middle lines of it instead of the first ones.
                            y: 0px;
                            text: root.data.purpose;
                            color: Theme.text-secondary;
                            font-size: root.details-type;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                    if purpose-text.preferred-height > root.purpose-clamp : more-hit := TouchArea {
                        width: more-label.preferred-width + 16px;
                        height: 20px;
                        mouse-cursor: pointer;
                        clicked => { root.purpose-open = !root.purpose-open; }

                        more-label := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.purpose-open ? "show less" : "show more";
                            color: more-hit.has-hover ? Theme.amber-light : Theme.text-secondary;
                            font-size: Theme.fs-caption;
                            vertical-alignment: center;
                        }
                    }
                }

                // What the caller says the call is for, labelled as the caller's words: nothing
                // checks it, it is never the label on a button, and approvals.rs gives it as one
                // neutralized paragraph that cannot start a line reading as this card's own.
                if root.data.caller-says != "" : VerticalLayout {
                    spacing: 0px;
                    Text {
                        width: parent.width;
                        text: "What the caller says this call is for (its own words; nothing checks them):";
                        color: Theme.text-secondary;
                        font-size: root.details-type;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        height: root.caller-open ? caller-text.preferred-height
                            : min(caller-text.preferred-height, root.caller-clamp);
                        clip: true;

                        caller-text := Text {
                            width: parent.width;
                            y: 0px;
                            text: root.data.caller-says;
                            color: Theme.text-secondary;
                            font-size: root.details-type;
                            font-italic: true;
                            wrap: word-wrap;
                            vertical-alignment: top;
                        }
                    }
                    if caller-text.preferred-height > root.caller-clamp : caller-more := TouchArea {
                        width: caller-more-label.preferred-width + 16px;
                        height: 20px;
                        mouse-cursor: pointer;
                        clicked => { root.caller-open = !root.caller-open; }

                        caller-more-label := Text {
                            width: parent.width;
                            height: parent.height;
                            text: root.caller-open ? "show less" : "show more";
                            color: caller-more.has-hover ? Theme.amber-light : Theme.text-secondary;
                            font-size: Theme.fs-caption;
                            vertical-alignment: center;
                        }
                    }
                }

                // The arguments, exactly as the grant is bound to them: one Text per argument,
                // `no-wrap` and elided, the values cut to fit in approvals.rs with each cut naming
                // its true length, and escaped in the shell so none can draw a line of its own.
                VerticalLayout {
                    spacing: 0px;
                    Text {
                        width: parent.width;
                        text: "The arguments in this call; the grant is bound to exactly these:";
                        color: Theme.text-secondary;
                        font-size: root.details-type;
                        wrap: word-wrap;
                    }
                    Rectangle {
                        border-radius: Theme.r-sm;
                        background: Theme.bg-input;
                        height: args-body.preferred-height;

                        args-body := VerticalLayout {
                            padding: Theme.sp-2;

                            for line in root.data.args : Text {
                                text: line;
                                color: Theme.text-primary;
                                font-size: Theme.fs-mono;
                                wrap: no-wrap;
                                overflow: elide;
                            }
                        }
                    }
                }

                if root.data.explained != "" : Text {
                    width: parent.width;
                    text: "\"The app says about this call\" is the app's sentence about these arguments; the grant binds to the arguments, not to the sentence.";
                    color: Theme.text-secondary;
                    font-size: root.details-type;
                    wrap: word-wrap;
                }

                // What a handle in the arguments names, in the words of the app that owns it (#54).
                if root.data.target != "" : Text {
                    width: parent.width;
                    text: "The name of the target is the app's own, from its describe; the grant binds to the arguments, not to the name.";
                    color: Theme.text-secondary;
                    font-size: root.details-type;
                    wrap: word-wrap;
                }

                Text {
                    width: parent.width;
                    text: "Graded " + root.data.grade + ". Allowing covers this one action, once.";
                    color: Theme.text-secondary;
                    font-size: root.details-type;
                    wrap: word-wrap;
                }
            }

                    }   // mid
                }   // Flickable
            }   // the section that yields

            // ── What changes: pinned above the buttons ──
            //
            // One line that says what the call acts on; when that line names a target, or is cut
            // at the card's edge, every argument the grant binds, in full and wrapped — never in
            // the part that scrolls, so nothing the grant covers is out of reach while Allow can be
            // pressed (re-review of #639: "…temporary files now &…" over a red Run command, with
            // "rm -rf ~/x" scrolled to nowhere). The arguments are bounded in the shell and
            // escaped value by value; when even these lines do not fit, the whole section scrolls
            // and Allow waits until its end has been in view. Then the first line of
            // the app's word about this call, the undo line in the warning's red, and the warning
            // when there is one the undo line does not already say.
            changes := VerticalLayout {
                spacing: Theme.sp-1;

                what-line := Text {
                    text: root.data.what;
                    color: Theme.text-primary;
                    font-size: Theme.fs-body;
                    wrap: no-wrap;
                    overflow: elide;
                    visible: root.data.what != "";
                    height: root.data.what != "" ? self.preferred-height : 0px;
                }
                if root.data.exactly != "" && (root.data.target != "" || what-line.preferred-width > what-line.width) : Text {
                    width: parent.width;
                    text: "Exactly: " + root.data.exactly;
                    color: Theme.text-primary;
                    font-size: Theme.fs-body;
                    wrap: word-wrap;
                }
                // What the app says about THIS call, with these arguments (#137), in the app's
                // name: some calls cannot be judged from their arguments alone (review of #639,
                // S2). Its first line, pinned; the whole of it is in the section above when cut.
                explained-line := Text {
                    text: "The app says about this call: " + root.data.explained;
                    color: Theme.text-primary;
                    font-size: Theme.fs-body;
                    wrap: no-wrap;
                    overflow: elide;
                    visible: root.data.explained != "";
                    height: root.data.explained != "" ? self.preferred-height : 0px;
                }
                if root.data.undo != "" : Text {
                    text: root.data.undo;
                    color: root.data.undo == "Undo: not possible, the app says so"
                        || root.data.undo == "Undo: not possible, says the caller" ? Theme.color-danger : Theme.text-primary;
                    font-size: Theme.fs-body;
                    wrap: no-wrap;
                    overflow: elide;
                }

                // The bar and the sentence placed by hand rather than in a HorizontalLayout: a
                // wrapping Text in a horizontal layout is measured at its unwrapped width, so the
                // open-ended warning — four lines — was given one and cut mid-sentence. Here the
                // Text is told its width, and the box takes the height that width needs.
                if root.data.warning != "" : Rectangle {
                    height: warning-text.preferred-height;
                    Rectangle {
                        x: 0px;
                        width: 3px;
                        height: parent.height;
                        background: Theme.color-danger;
                    }
                    warning-text := Text {
                        x: 3px + Theme.sp-2;
                        y: 0px;
                        width: parent.width - 3px - Theme.sp-2;
                        text: root.data.warning;
                        color: Theme.color-danger;
                        font-size: Theme.fs-caption;
                        wrap: word-wrap;
                        vertical-alignment: top;
                    }
                }
            }

                    }   // above-content
                }   // above-flick
            }   // everything above the buttons

            // Pinned bottom: the answer.
            decide := VerticalLayout {
                spacing: Theme.sp-2;

            // Decline first, outlined; then the affirmative (sign-off item 1). For what cannot be
            // undone, or is graded dangerous, it is the kit's filled red with the red's own ink,
            // and it says the action — "Delete event" — in words taken from the app's published
            // action, never from the caller's purpose (approval_wording::confirm_label). For
            // anything else it is "Allow once" on the accent fill. The look says which button is
            // the action, and never chooses for the person.
            //
            // Both are `pointer-only`: neither takes keyboard focus, so nothing is focused when
            // the card appears, Tab cannot land on them and Enter or Space can never press
            // either. A click is the only way to answer. The press guard in card_watch.rs and
            // the tests in control_approvals.rs still apply to what the click does.
            HorizontalLayout {
                spacing: Theme.sp-2;

                YButton {
                    label: "Decline";
                    variant: 1;
                    pointer-only: true;
                    horizontal-stretch: 1;
                    clicked => { root.deny(); }
                }

                // Disabled — dimmed, and pressing it does nothing — while the request has had to
                // scroll and its end has not yet been in view (`allow-ready`, fourth review of
                // #639). Decline never is.
                YButton {
                    label: root.data.confirm-label != "" ? root.data.confirm-label : "Allow once";
                    variant: root.data.destructive ? 3 : 0;
                    pointer-only: true;
                    disabled: !card.allow-ready;
                    tooltip: card.allow-ready ? "" : "Scroll to read the whole request first";
                    horizontal-stretch: 1;
                    clicked => { root.allow(); }
                }
            }

            // "Stop asking me about this one" — the third choice, and deliberately the least
            // inviting thing on the card.
            //
            // It exists because approval fatigue is the failure this design is most afraid of,
            // and forty identical cards for one long job is how it arrives. A person who can say
            // "yes to file moves, keep asking about everything else" never has to reach for
            // bypass, which is the blunt instrument this is trying to make unnecessary.
            //
            // Below the button row rather than beside it, at caption size, in dim text with a
            // subtle border: Deny is still the secondary button beside the primary, and
            // the standing yes costs the most deliberate aim of the three. Not drawn at all for
            // `dangerous`, or for an action the app says cannot be undone — see `can-session`.
            //
            // The line under the button is there because the rule it mints is desktop-wide
            // (#182): a session rule is an (app, action) pair in the mode file, every door reads
            // the same file, and no door asks which agent the rule was minted for — so it covers
            // every mind on this desktop, and the card must say so plainly rather than let "for
            // this session" read as "for this agent's session". Scoping the rule to the asking
            // agent means changing the decision table in every implementation that replays it —
            // the shell, the Python SDK, the bridge, the Blender addon — and the vectors they
            // all replay; until then, the honest sentence is the fix. One fixed single-line
            // row, like every caption above, so the card's height stays arithmetic (#218).
            if root.data.can-session : VerticalLayout {
                spacing: Theme.sp-1;

                Rectangle {
                    height: 30px;
                    border-radius: Theme.r-md;
                    background: session-ta.has-hover && card.allow-ready ? Theme.hover-fill : transparent;
                    border-width: 1px;
                    border-color: Theme.border-subtle;
                    opacity: card.allow-ready ? 1.0 : 0.45;

                    // A standing yes is a yes: held back with Allow until the whole request has
                    // been in view.
                    session-ta := TouchArea {
                        enabled: card.allow-ready;
                        mouse-cursor: card.allow-ready ? pointer : default;
                        clicked => { root.allow-session(); }
                    }
                    Text {
                        text: "Allow " + root.data.app + "." + root.data.action + " for this session";
                        color: Theme.text-dim;
                        font-size: Theme.fs-caption;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }
                Text {
                    text: "covers every mind and caller, until restart or the mode is lowered";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            }   // decide
        }
    }

    }   // body — see the note at the top of this component about why it is here
}

/// What the desktop is asking for the vault passphrase about.
///
/// `reason` is written by the shell, never by whatever provoked it: a mind asking for a credential
/// gets its request turned into one of a handful of fixed sentences before it reaches here, so
/// nothing a caller composed is ever drawn as the explanation for a password box.
export struct VaultUnlockRequest {
    /// Why this is on screen, in the person's words. Empty means nothing is being asked.
    reason: string,
    /// What was wrong with the last attempt, or empty.
    error: string,
    /// True when answering this will protect the vault for the first time rather than open it.
    first-time: bool,
}

/// The only way a vault passphrase gets into this machine.
///
/// Deliberately the same shape, glass and border language as `ApprovalCard` above, because it is
/// the same kind of moment: the machine has stopped and is waiting for a person, and the person
/// should recognise on sight that this is one of those and not a form an app drew. It is a
/// stronger claim than the approval card makes, though — an approval is a click, and a click can
/// be described; this is a secret, and there is no control-surface action, no tool argument and no
/// RPC method that can supply one. `no_published_action_can_carry_a_passphrase` in
/// `control_approvals.rs` is what keeps that true as the surface grows.
export component VaultUnlockCard inherits Rectangle {
    in property <VaultUnlockRequest> data;
    /// The typed passphrase, on its way to `vault_unlock::adopt` and nowhere else.
    callback submit(string);
    callback dismiss();

    // Same reason as ApprovalCard: a plain Rectangle whose children are all behind `if` reports a
    // preferred height of zero, and the card then draws outside whatever box was sized from it.
    // One unconditional layout owns the height; everything conditional lives inside it.
    height: body.preferred-height;
    background: transparent;

    body := VerticalLayout {

    Rectangle {
        border-radius: Theme.r-lg;
        // Opaque for the same reason ApprovalCard is: this is drawn over whatever screen is up,
        // and a box asking for the passphrase to every credential on the machine must not have
        // another window's words showing through it.
        background: Theme.bg-card;
        border-width: 1px;
        // Warning-edged, always. There is no "routine" version of being asked for the passphrase
        // that protects every credential on the machine.
        border-color: Theme.color-warning;
        drop-shadow-blur: 18px;
        drop-shadow-color: Theme.overlay-shadow;
        height: card-body.preferred-height;

        card-body := VerticalLayout {
            padding: Theme.sp-3;
            spacing: Theme.sp-2;

            HorizontalLayout {
                spacing: Theme.sp-2;

                Rectangle {
                    width: 6px; height: 6px;
                    y: 5px;
                    border-radius: 3px;
                    background: Theme.color-warning;
                }
                Text {
                    text: root.data.first-time ? "Choose a passphrase for your vault"
                        : "Your vault passphrase";
                    color: Theme.text-primary;
                    font-size: Theme.fs-body-strong;
                    horizontal-stretch: 1;
                    wrap: no-wrap;
                    overflow: elide;
                }
            }

            Text {
                text: root.data.reason;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }

            // What it is actually for, said once. A person being asked for a password by their own
            // desktop deserves to know what it unlocks and what it does not, and the honest answer
            // is short: the file, not the running session.
            Text {
                text: root.data.first-time
                    ? "It wraps the key to your saved credentials. Nothing already saved is lost. If you forget it, they cannot be recovered."
                    : "Nobody else can supply this — not an app, not an assistant. Only what you type here.";
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                wrap: word-wrap;
            }

            // The field. `input-type: password` is not a security control — it stops a shoulder,
            // not a process — but the shell is the process, and this string leaves it only for
            // `vault::unlock`'s key derivation.
            Rectangle {
                height: Theme.h-regular;
                border-radius: Theme.r-md;
                background: Theme.bg-elevated;
                border-width: 1px;
                border-color: pass-input.has-focus ? Theme.accent : Theme.border-default;

                HorizontalLayout {
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;

                    pass-input := TextInput {
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        horizontal-stretch: 1;
                        input-type: password;
                        single-line: true;
                        accepted => {
                            root.submit(self.text);
                            // Cleared on the way out, whatever happens next. A wrong passphrase
                            // must not be left sitting in a widget for the next person at the
                            // keyboard to reveal.
                            self.text = "";
                        }
                    }
                }
            }

            if root.data.error != "" : Text {
                text: root.data.error;
                color: Theme.color-danger;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
            }

            HorizontalLayout {
                spacing: Theme.sp-2;
                padding-top: Theme.sp-1;

                Rectangle {
                    height: Theme.h-regular;
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: later-ta.has-hover ? Theme.hover-fill-strong : Theme.bg-elevated;
                    border-width: 1px;
                    border-color: Theme.border-default;

                    later-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            pass-input.text = "";
                            root.dismiss();
                        }
                    }
                    Text {
                        text: "Not now";
                        color: Theme.text-primary;
                        font-size: Theme.fs-body-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }

                Rectangle {
                    height: Theme.h-regular;
                    horizontal-stretch: 1;
                    border-radius: Theme.r-md;
                    background: unlock-ta.has-hover ? Theme.amber-glow : transparent;
                    border-width: 1px;
                    border-color: Theme.amber;

                    unlock-ta := TouchArea {
                        mouse-cursor: pointer;
                        clicked => {
                            root.submit(pass-input.text);
                            pass-input.text = "";
                        }
                    }
                    Text {
                        text: root.data.first-time ? "Lock the vault" : "Unlock";
                        color: Theme.amber-light;
                        font-size: Theme.fs-body-strong;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    }   // body — see the note at the top of this component about why it is here
}

export component IntentLens inherits Rectangle {
    in property <bool> is-open: false;
    in property <bool> is-thinking: false;
    in property <[LensResult]> results: [];
    in property <string> companion-status: "idle";
    in property <bool> companion-online: true;

    // Contextual suggestions (shown when query is empty)
    in property <[LensResult]> suggestions: [];
    in property <[LensResult]> recents: [];

    // Chat mode (multi-turn conversation within the Lens)
    in property <bool> chat-mode: false;
    /// The mind answering, shown in the chat header. A conversation should say who it is with.
    in property <string> mind-name: "";
    /// Whether the conversation is one of the mind's agents — an attached mind's `<id>:main` — and
    /// so has the whole of itself, every card and command, on the Agents screen.
    in property <bool> can-open-in-agents: false;
    in property <[MessageData]> messages: [];
    in property <bool> is-generating: false;

    /// What they recently decided, and the one request waiting on them.
    ///
    /// The card sits at the end of the list, under the records of the ones already answered, so
    /// the thing waiting on you is closest to where your hands are. The same list is drawn at
    /// desktop level in `app.slint` when the Lens is not showing it — a request must never sit
    /// invisibly until it expires.
    in property <[ApprovalRequest]> approvals: [];
    /// How many further requests are queued behind the card on screen.
    ///
    /// Up to three can be waiting; only one is ever shown. Three stacked cards do not fit on an
    /// 800px screen — the third one's buttons land under the taskbar — and a person facing a
    /// stack reads none of them properly, which is the failure the design is most afraid of.
    in property <int> approvals-waiting: 0;
    /// Questions the mind this conversation is with asked and is waiting on (#25), oldest first.
    in property <[QuestionRequest]> questions: [];
    callback question-answer(string, string, string, bool);   // agent id, request id, answer, pressed
    // The run's row id (`mind:main#n`), from a work card's Details or Review changes, or an agent's
    // id from a resolved approval's "View action" — both land in the Agents screen. Also the
    // desktop's own offer, while private, to leave Private mode (`private:leave`).
    callback open-run(string);

    // ── Chat v2 ──
    //
    // What the shell knows of the runs this chat started, from the Agents store: one card per
    // run, found by the id a reply carries. Nothing here is composed by the mind.
    in property <[WorkCardData]> work-cards: [];
    // The run the strip describes (the live one that most needs the person), and how many runs are
    // live in this chat, and how many of those wait on the person. `strip.run == ""` is none.
    in property <WorkCardData> strip;
    in property <int> live-runs: 0;
    in property <int> waiting-runs: 0;
    // The composer's mode chip: the mind-mode label ("Ask"). The chip opens the existing choice.
    in property <string> mode-label: "Ask";
    // Where the mind runs, as the header says it: "Built-in mind" or "Attached mind".
    in property <string> identity: "";
    // Where the composer's words go ("Yantrik Mind · deepseek-v4.1-flash · online, via Ollama
    // Cloud"), drawn under it; "" when the shell does not know, and then nothing is drawn.
    in property <string> destination: "";
    callback mode-clicked();
    callback mind-clicked();
    // "View desk": bring Mind View, the mind's own desk, in front.
    callback view-desk(string);
    // The panel's width: 440px until the person drags its left edge, then between 380 and 560.
    // It is kept for this session only.
    in-out property <length> panel-width: Theme.chat-panel-width;
    // The panel's own height, between the two bars and inside its margins.
    out property <length> panel-height: root.height - Theme.status-bar-height - Theme.taskbar-height
        - 2 * Theme.chat-panel-gap;
    // What the transcript is doing, for `describe` and for the preview checks (the transcript is
    // inside the chat-mode block, whose ids cannot be named from out here): following the newest
    // line, something arrived while reading further up, and how far down it is scrolled.
    out property <bool> transcript-following: true;
    out property <bool> transcript-missed: false;
    out property <length> transcript-y: 0px;
    // Whether the current-work strip is on screen.
    out property <bool> strip-shown: root.chat-mode && root.strip.run != "";

    // Callbacks
    callback approval-allow(string);   // request id — a click, and nothing else, creates a grant
    // request id — the same grant, plus a standing rule for that (app, action) until the shell
    // restarts. Still a click and nothing else. See `mind_mode.rs`.
    callback approval-allow-session(string);
    callback approval-deny(string);    // request id
    callback query-changed(string);
    callback submit-query(string);
    callback result-selected(string);    // action-id
    callback close-lens();
    callback send-message(string);
    callback mic-pressed();
    // "open in Agents": the Agents screen, with this conversation's agent selected.
    callback open-in-agents();
    // "History": every conversation, on the Agents screen's All tab (#246).
    callback open-history();
    // "New chat": the conversation starts again, for whichever mind is answering (#246).
    callback new-chat();

    // Internal state
    in-out property <string> input-text: "";
    in-out property <int> selected-index: 0;   // keyboard-navigable cursor

    // The least the conversation transcript keeps in chat mode. While a card is waiting the
    // transcript gives up most of its floor and the card gets the room instead: the card is the
    // thing the panel is waiting on, and its buttons have to fit (#218). One number, used twice
    // — as the ListView's floor and in the card's own height-limit arithmetic below — so the two
    // cannot drift apart and leave either an overlap or a gap.
    property <length> transcript-min: root.approvals.length > 0 ? 96px : 200px;

    /// Move the highlight through the result feed, stepping over divider rows.
    ///
    /// A function rather than a block inside one key handler, because two places need it now:
    /// the text field, which is where the cursor actually is while you are typing, and the
    /// keyboard scope below.
    function move-selection(delta: int) {
        if (root.results.length > 0) {
            root.selected-index = clamp(root.selected-index + delta, 0, root.results.length - 1);
            if (root.results[root.selected-index].result-type == "divider") {
                root.selected-index = clamp(root.selected-index + delta, 0, root.results.length - 1);
            }
        }
    }

    // Right-side panel — no full-screen overlay, desktop stays visible
    width: 100%;
    height: 100%;
    background: transparent;

    // Put the cursor in the field when the Lens opens.
    //
    // `forward-focus: lens-input` at the foot of this file only redirects focus that arrives AT
    // this component, and nothing sent it any: every way of opening the Lens — the ask bar, the
    // orb, the taskbar anchor, the palette's AI rows — sets `lens-open` and stops. So the panel
    // slid in with an empty field, a blinking-less caret and no way to type into it without
    // clicking the field first. One handler on the state change covers all of those openers at
    // once, which is why it lives here and not in each of them.
    //
    // Chat mode has its own field and collapses the search row to zero height behind it; Slint
    // cannot focus an element with no size, so this handler covers the search field and the chat
    // panel focuses its own (it is inside an `if`, and an id in a conditional cannot be named
    // from out here — see the `changed lens-open` beside `chat-input`).
    changed is-open => {
        if (root.is-open && !root.chat-mode) {
            lens-input.focus();
            // Whatever the field already holds — the last ask, or text `open_lens` prefilled —
            // comes up selected. The cursor otherwise sits at position 0, so the first thing
            // typed was spliced onto the front of the old text ("hello keyswhat is using my
            // disk" is what the machine showed). Selected, typing replaces it and the arrow
            // keys keep it, which is what every ask bar does.
            lens-input.select-all();
        }
    }

    // The pulse under the SUGGESTED rows' ambient dot, and nothing else.
    //
    // It used to be called the holographic scan phase and run at 16 ms for as long as the panel
    // was open, which read as "the panel glows". It does not: the only property that has ever
    // read this phase is the 5px dot on a suggestion row (search this file for
    // `suggestion-dot-phase` — one use). Those rows are on screen in one state, and a sixty-a-
    // second repaint of the whole desktop for a dot that is not being drawn is the shape of #68.
    //
    // So the gate is the condition the rows themselves are behind, spelled out once here, and the
    // rate is what a pulse needs. 160 ms a step at 0.03 keeps the 5.3 s cycle the dot always had.
    property <bool> suggestion-dots-visible: root.is-open && !root.chat-mode
        && root.results.length == 0 && root.input-text == "" && root.suggestions.length > 0;
    property <float> suggestion-dot-phase: 0;
    Timer {
        interval: 160ms;
        running: root.suggestion-dots-visible;
        triggered => {
            suggestion-dot-phase = mod(suggestion-dot-phase + 0.03, 1.0);
        }
    }

    // Click-outside area (left side only, not covering the panel)
    // Wrapped in `if` so the TouchArea is removed from the tree when closed,
    // preventing it from swallowing clicks meant for the dock/desktop.
    if root.is-open : TouchArea {
        x: 0;
        y: 0;
        width: root.width - root.panel-width - Theme.chat-panel-gap;
        height: root.height;
        clicked => { root.close-lens(); }
    }

    // The Lens panel — right-docked side panel, between the two bars
    //
    // It used to run the full height of the screen, and the shell draws the status bar and the
    // taskbar OVER the desktop — so the top 32px of this panel lived under the status bar and
    // the bottom 40px under the taskbar. The bottom 40px is the chat input: you could read an
    // answer and had no way to reply, with only the corner of the mic button showing past the
    // dock to hint that something was there. Nothing in the layout said "full height" on
    // purpose; it simply never subtracted the chrome it was underneath.
    Rectangle {
        x: root.is-open ? root.width - root.panel-width - Theme.chat-panel-gap : root.width;
        y: Theme.status-bar-height + Theme.chat-panel-gap;
        width: root.panel-width;
        height: root.panel-height;
        border-radius: Theme.chat-radius;
        clip: true;
        visible: root.is-open;

        animate x { duration: 200ms; easing: ease-out; }

        // Glass, but barely — this one holds prose.
        //
        // At 9-12% the machine rail behind it read straight through the answers: "Model
        // ollama-local:qwen3.5:9b-8k" and a column of service names sat in the middle of a
        // paragraph. The theme file already states the rule this broke — the rails are the
        // transparent surfaces BECAUSE what they hold is labels and numbers, "which stay
        // legible over a pre-blurred photograph in a way a paragraph would not". This panel
        // holds paragraphs. It keeps a suggestion of glass at 3% and stops competing with
        // itself for the reader's eye.
        // Glass while it is a list of short rows; solid once it is holding paragraphs.
        //
        // This is the theme file's own rule applied honestly rather than uniformly: the rails
        // are transparent BECAUSE what they hold is "labels and numbers, which stay legible over
        // a pre-blurred photograph in a way a paragraph would not". Search results are labels.
        // A conversation is paragraphs, and at 9% the machine rail behind this panel put
        // "Model ollama-local:qwen3.5:9b-8k" and a column of service names inside the answer.
        // Same panel, two jobs, two treatments.
        //
        // Chat v2: the conversation is one opaque charcoal panel with a 1px border, which is what
        // a surface holding paragraphs and a decision should be. The search rows keep their
        // 10% glass, as a solid fill: the panel is rounded now, and a rounded element with a
        // gradient fill draws square corners under the software renderer (#172).
        background: root.chat-mode ? Theme.chat-panel : Theme.bg-deep.transparentize(10%);
        border-width: root.chat-mode ? 1px : 0px;
        border-color: Theme.chat-border;

        // Left edge glow (panel border). The conversation has its own 1px border instead.
        Rectangle {
            visible: !root.chat-mode;
            x: 0; y: 0;
            width: 1px;
            height: 100%;
            background: @linear-gradient(180deg,
                Theme.cyan-glow 0%,
                Theme.cyan.transparentize(87%) 30%,
                Theme.amber.transparentize(87%) 70%,
                Theme.cyan-glow 100%
            );
        }

        // Deep shadow on left side
        drop-shadow-blur: 30px;
        drop-shadow-color: Theme.overlay-backdrop;
        drop-shadow-offset-x: -8px;

        // Block click-through to the outside TouchArea
        TouchArea { width: 100%; height: 100%; }

        lens-content := VerticalLayout {
            padding: 0;

            // ── Header (chat mode) ──
            //
            // In chat mode the search row below was still drawn, so the panel carried TWO text
            // fields — one at the top that ran the app-launcher and one at the bottom that
            // continued the conversation — and they did different things with the same Return
            // key. A conversation gets a header instead: who is answering, and what a person does
            // with the conversation as a whole. The Lens is the quick question; the whole of the
            // conversation, every call as a card, is this mind's agent on the Agents screen.
            if root.chat-mode : ChatHeader {
                mind-name: root.mind-name;
                identity: root.identity;
                can-new-chat: root.messages.length > 0;
                can-open-in-agents: root.can-open-in-agents;
                mind-clicked => { root.mind-clicked(); }
                new-chat => { root.new-chat(); }
                history => { root.open-history(); }
                open-in-agents => { root.open-in-agents(); }
                close => { root.close-lens(); }
            }

            // ── Input area (search mode) ──
            //
            // Collapsed rather than removed: the component ends with
            // `forward-focus: lens-input`, which is what puts the cursor in this field the
            // moment the Lens opens. An element inside an `if` cannot be the target of that,
            // so taking the row out of the tree would cost the Lens its typing focus — the
            // primary interaction of this desktop — to tidy up a layout.
            Rectangle {
                height: root.chat-mode ? 0px : Theme.lens-input-height;
                visible: !root.chat-mode;
                clip: true;
                background: Theme.bg-surface;

                HorizontalLayout {
                    padding-left: 20px;
                    padding-right: 16px;
                    spacing: 12px;

                    // Thinking indicator / search icon
                    Rectangle {
                        width: 20px;
                        height: 20px;
                        y: (parent.height - 20px) / 2;

                        // Search circle
                        Rectangle {
                            width: 14px;
                            height: 14px;
                            border-radius: 7px;
                            border-width: 2px;
                            border-color: root.is-thinking ? Theme.amber : Theme.text-dim;
                            background: transparent;

                            animate border-color { duration: 300ms; }
                        }

                        // Search handle
                        Rectangle {
                            x: 12px;
                            y: 12px;
                            width: 6px;
                            height: 2px;
                            background: root.is-thinking ? Theme.amber : Theme.text-dim;
                            // Rotated 45deg approximation
                            border-radius: 1px;

                            animate background { duration: 300ms; }
                        }
                    }

                    // Text input
                    Rectangle {
                        horizontal-stretch: 1;
                        height: Theme.lens-input-height;
                        // The field below is now as wide as its own text, so without a minimum
                        // of its own this box would ask the row for that width and a long
                        // question would push the Escape hint off the panel. One pixel, the same
                        // floor Slint's own LineEditBase sets, and for the same second reason it
                        // gives: a TextInput narrower than a pixel cannot be focused.
                        min-width: 1px;
                        forward-focus: lens-input;
                        clip: true;

                        lens-input := TextInput {
                            // ── Long questions scroll instead of vanishing ──────────────────
                            //
                            // This was `width: parent.width` inside a clipping box, which is the
                            // one combination that cannot scroll: the text is laid out at the
                            // width of the field, so everything past the edge — around 32
                            // characters at this font size — was drawn outside and clipped away,
                            // caret included. You went on typing with no idea what you had
                            // written, and could not see the end of your own question before
                            // pressing Enter on it. The ask bar is the primary interaction of
                            // this desktop and it could not hold a sentence.
                            //
                            // The fix is Slint's own, lifted from `LineEditBase` in the widget
                            // set (i-slint-compiler/widgets/common/lineedit-base.slint): let the
                            // field be as wide as its text, keep a private offset, and move that
                            // offset just far enough to keep the caret inside the visible box
                            // whenever it moves. `min`/`max` pin it so the text never scrolls
                            // past either end.
                            property <length> computed-x;
                            x: min(0px, max(parent.width - self.width - self.text-cursor-width, self.computed-x));
                            width: max(parent.width - self.text-cursor-width, self.preferred-width);
                            cursor-position-changed(cursor-position) => {
                                if (cursor-position.x + self.computed-x < 0px) {
                                    self.computed-x = -cursor-position.x;
                                } else if (cursor-position.x + self.computed-x > parent.width - self.text-cursor-width) {
                                    self.computed-x = parent.width - cursor-position.x - self.text-cursor-width;
                                }
                            }

                            y: (parent.height - self.preferred-height) / 2;
                            color: Theme.text-primary;
                            font-size: Theme.fs-title-1;
                            // single-line: true is REQUIRED for `accepted` to fire.
                            // With single-line: false, Slint treats Return as "insert
                            // newline" and never invokes accepted — which made the
                            // Intent Lens (the shell's primary interaction) impossible
                            // to submit with Enter.
                            single-line: true;
                            text <=> root.input-text;

                            // Escape and the arrows, handled where the focus actually is.
                            //
                            // `key-handler` at the foot of this file has held this logic for as
                            // long as it has existed and has never run: it is a 0x0 FocusScope
                            // beside the panel, so it is neither focused nor an ancestor of
                            // anything that is, and a key event reaches neither. Now that the
                            // field takes the cursor when the Lens opens, that matters — Escape
                            // has to close the panel from inside the field, or the Lens is a trap
                            // you can only leave with the mouse.
                            key-pressed(event) => {
                                if (event.text == Key.Escape) {
                                    root.close-lens();
                                    return accept;
                                }
                                if (event.text == Key.DownArrow) {
                                    root.move-selection(1);
                                    return accept;
                                }
                                if (event.text == Key.UpArrow) {
                                    root.move-selection(-1);
                                    return accept;
                                }
                                return reject;
                            }

                            accepted => {
                                if root.input-text != "" {
                                    // Active search: Enter selects the highlighted result.
                                    if root.results.length > 0 {
                                        root.result-selected(
                                            root.results[clamp(root.selected-index, 0, root.results.length - 1)].action-id
                                        );
                                    } else {
                                        root.submit-query(root.input-text);
                                    }
                                } else {
                                    // Idle state: Enter executes first suggestion
                                    if root.suggestions.length > 0 {
                                        root.result-selected(root.suggestions[0].action-id);
                                    }
                                }
                            }
                        }

                        // Placeholder
                        if root.input-text == "" : Text {
                            y: (parent.height - self.preferred-height) / 2;
                            text: "Search, ask, or do anything...";
                            color: Theme.text-dim;
                            font-size: Theme.fs-title-1;
                        }
                    }

                    // Escape hint
                    Rectangle {
                        width: 36px;
                        height: 22px;
                        y: (parent.height - 22px) / 2;
                        border-radius: 4px;
                        background: Theme.bg-card;
                        border-width: 1px;
                        border-color: Theme.border-subtle;

                        Text {
                            text: "esc";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                            horizontal-alignment: center;
                            vertical-alignment: center;
                        }
                    }
                }

                // Bottom divider
                Rectangle {
                    y: parent.height - 1px;
                    width: 100%;
                    height: 1px;
                    background: Theme.separator;
                }
            }

            // ── Thinking indicator bar ──
            //
            // This cost the machine three quarters of a core for as long as a mind was working,
            // with the panel closed (#68: `yantrik-ui` at 83 % against 2.0 % four minutes later,
            // from /proc task stat deltas). Two mistakes, and the second is the expensive one.
            //
            // It was gated on `is-thinking` alone. The panel it lives in is `visible: root.is-open`
            // — visible, not conditional — so with the Lens closed this element still existed, its
            // timer still ticked, and every tick wrote a property the scene depends on. Slint does
            // not care that the item is invisible: a changed property is a dirty scene and a frame
            // is requested. Thinking is minutes for a real job, and a mind at work is exactly when
            // the person is doing something else on this machine.
            //
            // And it swept at 16 ms — sixty full-screen repaints a second, the compositor paying
            // again for each, to move a 2px gradient. A pulse says the same thing. 160 ms a step
            // at 0.08 keeps the 2 s cycle the sweep had, at a tenth of the frames.
            if root.is-open && root.is-thinking : Rectangle {
                height: 2px;
                width: 100%;

                property <float> pulse-phase: 0;
                Timer {
                    interval: 160ms;
                    running: root.is-open && root.is-thinking;
                    triggered => { parent.pulse-phase = mod(parent.pulse-phase + 0.08, 1.0); }
                }

                Rectangle {
                    width: 100%;
                    height: 2px;
                    background: @linear-gradient(90deg,
                        transparent 0%,
                        Theme.amber 35%,
                        Theme.cyan 75%,
                        transparent 100%
                    );
                    opacity: 0.35 + 0.45 * (0.5 + 0.5 * sin(pulse-phase * 6.2832 * 1rad));
                }
            }

            // ── Results feed (non-chat mode) ──
            if !root.chat-mode : VerticalLayout {
                padding: 4px;
                padding-bottom: 8px;

                // ── Active search results (when user has typed something) ──
                for result[idx] in root.results : Rectangle {
                    height: result.is-loading ? Theme.lens-result-height
                        : result.result-type == "divider" ? 24px
                        : result.result-type == "answer" ? Theme.lens-answer-height
                        : Theme.lens-result-height;
                    property <bool> row-selected: idx == root.selected-index;

                    // ── Skeleton shimmer row (loading placeholder) ──
                    if result.is-loading : Rectangle {
                        width: 100%;
                        height: Theme.lens-result-height;
                        border-radius: 8px;

                        // Same two corrections as the thinking bar above: a skeleton row behind a
                        // closed panel is a row nobody can see, and a shimmer is a pulse. 160 ms
                        // at 0.1 keeps the 1.6 s cycle.
                        property <float> shimmer-phase: 0;
                        Timer {
                            interval: 160ms;
                            running: root.is-open && result.is-loading;
                            triggered => {
                                parent.shimmer-phase = mod(parent.shimmer-phase + 0.1, 1.0);
                            }
                        }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            // Shimmer badge
                            Rectangle {
                                width: 28px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                border-radius: 4px;
                                background: Theme.color-skeleton;
                                opacity: 0.4 + 0.3 * sin(shimmer-phase * 6.2832 * 1rad);
                            }

                            // Shimmer text bars
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 6px;

                                Rectangle {
                                    width: 60%;
                                    height: 12px;
                                    border-radius: 3px;
                                    background: Theme.color-skeleton;
                                    opacity: 0.3 + 0.3 * sin(shimmer-phase * 6.2832 * 1rad);
                                }
                                Rectangle {
                                    width: 40%;
                                    height: 8px;
                                    border-radius: 2px;
                                    background: Theme.color-skeleton;
                                    opacity: 0.2 + 0.2 * sin((shimmer-phase + 0.15) * 6.2832 * 1rad);
                                }
                            }
                        }
                    }

                    // ── Divider row ──
                    if result.result-type == "divider" && !result.is-loading : Rectangle {
                        width: 100%;
                        height: 24px;

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 8px;
                            alignment: center;

                            Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.separator; }
                            Text {
                                text: result.title;
                                color: Theme.text-dim;
                                font-size: Theme.fs-micro;
                                letter-spacing: 1px;
                            }
                            Rectangle { horizontal-stretch: 1; height: 1px; background: Theme.separator; }
                        }
                    }

                    // ── Answer row (inline computed result, e.g. math, time) ──
                    if result.result-type == "answer" && !result.is-loading : TouchArea {
                        height: Theme.lens-answer-height;
                        property <bool> hovered: self.has-hover;
                        clicked => {
                            root.selected-index = idx;
                            if result.action-id != "" {
                                root.result-selected(result.action-id);
                            }
                        }

                        Rectangle {
                            width: 100%;
                            height: Theme.lens-answer-height;
                            border-radius: 8px;
                            background: row-selected ? Theme.bg-selected
                                : parent.hovered ? Theme.bg-card
                                : transparent;

                            animate background { duration: 100ms; }

                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                spacing: 12px;

                                // Answer badge (holographic blue with glow)
                                Rectangle {
                                    width: 32px;
                                    height: 24px;
                                    y: (parent.height - 24px) / 2;
                                    border-radius: 6px;
                                    background: Theme.color-answer;
                                    opacity: 0.2;
                                    drop-shadow-blur: 8px;
                                    drop-shadow-color: Theme.holo-blue.transparentize(81%);

                                    Text {
                                        text: result.icon-char;
                                        color: Theme.color-answer;
                                        font-size: Theme.fs-body;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                }

                                // Title + large inline value
                                VerticalLayout {
                                    horizontal-stretch: 1;
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: result.title;
                                        color: Theme.text-dim;
                                        font-size: Theme.fs-micro;
                                        letter-spacing: 1px;
                                    }

                                    Text {
                                        text: result.inline-value;
                                        color: Theme.color-answer;
                                        font-size: Theme.fs-display;
                                        font-weight: 600;
                                    }
                                }
                            }
                        }
                    }

                    // ── Normal result row ──
                    if result.result-type != "divider" && result.result-type != "answer" && !result.is-loading : TouchArea {
                        height: Theme.lens-result-height;
                        property <bool> hovered: self.has-hover;
                        clicked => {
                            root.selected-index = idx;
                            root.result-selected(result.action-id);
                        }

                    Rectangle {
                        property <bool> is-hovered: parent.hovered;
                        property <bool> is-sel: row-selected;
                        width: 100%;
                        height: Theme.lens-result-height;
                        border-radius: 8px;
                        background: is-sel ? Theme.bg-selected
                            : is-hovered ? Theme.bg-card
                            : transparent;
                        border-width: is-sel ? 1px : 0;
                        border-color: is-sel ? Theme.hover-fill-strong : transparent;

                        animate background { duration: 100ms; }

                        HorizontalLayout {
                            padding-left: 16px;
                            padding-right: 16px;
                            spacing: 12px;

                            // Type badge
                            Rectangle {
                                width: 28px;
                                height: 20px;
                                y: (parent.height - 20px) / 2;
                                border-radius: 4px;
                                background:
                                    result.result-type == "do"        ? Theme.color-do :
                                    result.result-type == "find"      ? Theme.color-find :
                                    result.result-type == "ask"       ? Theme.color-ask :
                                    result.result-type == "memory"    ? Theme.color-memory :
                                    result.result-type == "tool"      ? Theme.color-tool :
                                    result.result-type == "clipboard" ? Theme.color-clipboard :
                                    result.result-type == "context"   ? Theme.color-context :
                                    result.result-type == "recent"    ? Theme.color-recent :
                                    Theme.color-setting;
                                opacity: 0.15;

                                Text {
                                    text: result.icon-char;
                                    color:
                                        result.result-type == "do"        ? Theme.color-do :
                                        result.result-type == "find"      ? Theme.color-find :
                                        result.result-type == "ask"       ? Theme.color-ask :
                                        result.result-type == "memory"    ? Theme.color-memory :
                                        result.result-type == "tool"      ? Theme.color-tool :
                                        result.result-type == "clipboard" ? Theme.color-clipboard :
                                        result.result-type == "context"   ? Theme.color-context :
                                        result.result-type == "recent"    ? Theme.color-recent :
                                        Theme.color-setting;
                                    font-size: Theme.fs-micro;
                                    font-weight: 700;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            // Title + subtitle
                            VerticalLayout {
                                horizontal-stretch: 1;
                                alignment: center;
                                spacing: 2px;

                                Text {
                                    text: result.title;
                                    color: Theme.text-primary;
                                    font-size: Theme.fs-body;
                                    overflow: elide;
                                }

                                if result.subtitle != "" : Text {
                                    text: result.subtitle;
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-micro;
                                    overflow: elide;
                                }
                            }

                            // Score indicator bar (3px on right side). A result's score is
                            // data, so the accent; teal is only for minds (colour system).
                            if result.score > 0.0 : Rectangle {
                                width: 3px;
                                height: parent.height * 0.6;
                                y: (parent.height - self.height) / 2;
                                border-radius: 1.5px;
                                background: Theme.accent;
                                opacity: result.score;
                            }

                            // "Enter" hint on selected result
                            if row-selected : Rectangle {
                                width: 36px;
                                height: 18px;
                                y: (parent.height - 18px) / 2;
                                border-radius: 4px;
                                background: Theme.hover-fill;

                                Text {
                                    text: "↵";
                                    color: Theme.text-dim;
                                    font-size: Theme.fs-caption;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }
                        } // HorizontalLayout
                    } // Rectangle (result card)
                    } // TouchArea (normal result)
                } // for loop container

                // Offline banner — shown when AI backend is unreachable
                if !root.companion-online : Rectangle {
                    height: 32px;

                    HorizontalLayout {
                        alignment: center;
                        spacing: 8px;
                        padding-left: 16px;

                        Rectangle {
                            width: 6px; height: 6px; border-radius: 3px;
                            y: (parent.height - 6px) / 2;
                            background: Theme.color-emotional;
                        }
                        Text {
                            text: "AI offline — apps and tools still work";
                            color: Theme.text-dim;
                            font-size: Theme.fs-micro;
                        }
                    }
                }

                // ── Idle state: Suggestions + Recents (empty query, no results) ──
                if root.results.length == 0 && root.input-text == "" : VerticalLayout {
                    spacing: 4px;

                    // ── SUGGESTED section ──
                    if root.suggestions.length > 0 : VerticalLayout {
                        spacing: 0;

                        // Section header
                        Rectangle {
                            height: Theme.section-header-height;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: "SUGGESTED";
                                        color: Theme.color-context;
                                        font-size: Theme.fs-micro;
                                        font-weight: 700;
                                        letter-spacing: 2px;
                                    }
                                    // Animated underline
                                    Rectangle {
                                        width: 60px;
                                        height: 1px;
                                        background: Theme.color-context;
                                        opacity: 0.4;
                                    }
                                }
                            }
                        }

                        for sg[sg-idx] in root.suggestions : TouchArea {
                            height: Theme.lens-result-height;
                            property <bool> hovered: self.has-hover;
                            clicked => { root.result-selected(sg.action-id); }

                            Rectangle {
                                width: 100%;
                                height: Theme.lens-result-height;
                                border-radius: 8px;
                                background: parent.hovered ? Theme.bg-card : transparent;
                                animate background { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;

                                    // Context badge with pulsing dot
                                    Rectangle {
                                        width: 28px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 4px;
                                        background: Theme.color-context;
                                        opacity: 0.12;

                                        // Pulsing ambient dot
                                        Rectangle {
                                            x: 20px;
                                            y: 0;
                                            width: 5px;
                                            height: 5px;
                                            border-radius: 2.5px;
                                            background: Theme.color-context;
                                            opacity: 0.5 + 0.5 * sin(root.suggestion-dot-phase * 6.2832 * 1rad);
                                        }

                                        Text {
                                            text: sg.icon-char;
                                            color: Theme.color-context;
                                            font-size: Theme.fs-micro;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: sg.title;
                                            color: Theme.text-primary;
                                            font-size: Theme.fs-body;
                                            overflow: elide;
                                        }
                                        if sg.subtitle != "" : Text {
                                            text: sg.subtitle;
                                            color: Theme.text-dim;
                                            font-size: Theme.fs-micro;
                                            overflow: elide;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ── RECENT section ──
                    if root.recents.length > 0 : VerticalLayout {
                        spacing: 0;

                        // Section header
                        Rectangle {
                            height: Theme.section-header-height;
                            HorizontalLayout {
                                padding-left: 16px;
                                padding-right: 16px;
                                alignment: start;

                                VerticalLayout {
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: "RECENT";
                                        color: Theme.color-recent;
                                        font-size: Theme.fs-micro;
                                        font-weight: 700;
                                        letter-spacing: 2px;
                                    }
                                    Rectangle {
                                        width: 44px;
                                        height: 1px;
                                        background: Theme.color-recent;
                                        opacity: 0.3;
                                    }
                                }
                            }
                        }

                        for rc[rc-idx] in root.recents : TouchArea {
                            height: Theme.lens-result-height;
                            property <bool> hovered: self.has-hover;
                            clicked => { root.result-selected(rc.action-id); }

                            Rectangle {
                                width: 100%;
                                height: Theme.lens-result-height;
                                border-radius: 8px;
                                background: parent.hovered ? Theme.bg-card : transparent;
                                animate background { duration: 100ms; }

                                HorizontalLayout {
                                    padding-left: 16px;
                                    padding-right: 16px;
                                    spacing: 12px;

                                    // Recent badge (dimmer steel)
                                    Rectangle {
                                        width: 28px;
                                        height: 20px;
                                        y: (parent.height - 20px) / 2;
                                        border-radius: 4px;
                                        background: Theme.color-recent;
                                        opacity: 0.12;

                                        Text {
                                            text: rc.icon-char;
                                            color: Theme.color-recent;
                                            font-size: Theme.fs-micro;
                                            font-weight: 700;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }

                                    VerticalLayout {
                                        horizontal-stretch: 1;
                                        alignment: center;
                                        spacing: 2px;

                                        Text {
                                            text: rc.title;
                                            color: Theme.text-secondary;
                                            font-size: Theme.fs-body;
                                            overflow: elide;
                                            opacity: 0.8;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // Fallback empty state (no suggestions, no recents)
                    if root.suggestions.length == 0 && root.recents.length == 0 : Rectangle {
                        height: 64px;
                        VerticalLayout {
                            alignment: center;
                            padding-left: 20px;

                            Text {
                                text: root.companion-online
                                    ? "Type to search, ask, or command"
                                    : "Type to search apps and tools";
                                color: Theme.text-dim;
                                font-size: Theme.fs-body;
                            }
                        }
                    }
                }
            }

            // ── Chat mode (multi-turn conversation) ──
            if root.chat-mode : VerticalLayout {
                // The cursor goes in the reply box when the Lens opens in chat mode — which is
                // most of the time, because the Lens restores chat mode whenever the
                // conversation has messages in it.
                //
                // The obvious place for this is the `changed is-open` handler on the component
                // root, beside the one that focuses the search field. It cannot go there: the
                // composer is inside this `if`, and Slint will not let an id inside a
                // conditional be named from outside it. Mirroring `is-open` onto a property of
                // this element puts the change where the field is visible, which is the same
                // handler in the only scope that can write it.
                property <bool> lens-open: root.is-open;
                changed lens-open => {
                    if (self.lens-open) { composer.focus-input(); }
                }
                // ...and when this block is CREATED already open, which is the usual way in: the
                // ask bar sets `is-open`, and only then does `open_lens` notice the conversation
                // has messages and switch chat mode on. This element comes into being with
                // `lens-open` true, a property that starts true has not changed, and the handler
                // above never ran — the panel opened with the cursor nowhere, and a sentence
                // typed straight after clicking the ask bar went to nothing at all. One tick
                // later rather than in `init`, because a field cannot take focus before it has
                // been laid out.
                property <bool> focus-owed: true;
                Timer {
                    interval: 30ms;
                    running: parent.focus-owed;
                    triggered => {
                        parent.focus-owed = false;
                        if (parent.lens-open) { composer.focus-input(); }
                    }
                }

                // Approval cards and their records, pinned under the header, above the conversation.
                //
                // Here rather than interleaved in the transcript because a request is not a
                // message: it arrives while the person is reading, it has to stay put while they
                // decide, and a card that scrolls away with the transcript is a card that gets
                // missed.
                //
                // Under the header and not above the reply box, which is where it was, because
                // everything between this block and the bottom of the panel changes while a
                // person is aiming at a button: the current-work strip appears when a run goes
                // live (which is when requests arrive) and the reply box grows as they type, and
                // each moved the card by 48px or more between the press and the release of a
                // click (review of #580). The only thing above the card now is the header, which
                // is one fixed height, so the card's top edge is a constant of the panel, and its
                // height limit below reserves the worst case for what is under it, so its bottom
                // edge — where the buttons are — is one too.
                if root.approvals.length > 0 : VerticalLayout {
                    spacing: Theme.sp-1;
                    padding-top: Theme.sp-2;
                    padding-bottom: Theme.sp-2;
                    padding-left: Theme.sp-2;
                    padding-right: Theme.sp-2;

                    for item[idx] in root.approvals : ApprovalCard {
                        data: item;
                        // The tallest the card may be and still leave the panel showing
                        // everything else it owes: the header, the transcript sliver below and
                        // the strip and reply box under that — the reply box was what went off the
                        // bottom edge in #218, with the card's buttons a 3px sliver above it. The
                        // panel is the window between the two bars, less its margins; from it go
                        // the header, the composer at its tallest, the
                        // current-work strip, the transcript's floor, this
                        // block's padding with its "N more waiting" line (40px), and one row
                        // (32px) per decided record sharing this block with the card. The floor
                        // keeps a card's identity rows and buttons on any panel tall enough to
                        // hold them at all.
                        //
                        // The composer and the strip are counted at their LARGEST, whether or
                        // not they are drawn now: a limit that read their current heights would
                        // resize the card, and move its buttons, when either changed.
                        height-limit: max(240px, root.panel-height - Theme.chat-header-height
                            - composer.bar-height-max - Theme.chat-strip-height
                            - root.transcript-min - 40px - 32px * root.approvals.length);
                        allow => { root.approval-allow(item.id); }
                        allow-session => { root.approval-allow-session(item.id); }
                        deny => { root.approval-deny(item.id); }
                        view-action => { root.open-run(item.agent); }
                    }

                    if root.approvals-waiting > 0 : Text {
                        text: root.approvals-waiting + " more waiting — this one first";
                        color: Theme.chat-text-2;
                        font-size: Theme.fs-micro;
                        horizontal-alignment: center;
                        wrap: no-wrap;
                        overflow: elide;
                    }
                }

                // The conversation — fills the panel's height, down to `transcript-min` while a
                // card is waiting (see the property at the top of the component). It follows the
                // newest line only while the person is at the bottom; scrolled up, it stays put
                // and says "New reply" (ChatTranscript).
                Rectangle {
                    vertical-stretch: 1;
                    min-height: root.transcript-min;

                    if root.messages.length == 0 : ChatEmpty {
                        mind-name: root.mind-name;
                        starter(words) => { composer.fill(words); }
                    }

                    transcript := ChatTranscript {
                        width: 100%;
                        height: 100%;
                        visible: root.messages.length > 0;
                        init => {
                            root.transcript-following = true;
                            root.transcript-missed = false;
                        }
                        changed following => { root.transcript-following = self.following; }
                        changed missed => { root.transcript-missed = self.missed; }
                        changed scroll-y => { root.transcript-y = self.scroll-y; }

                        for msg[idx] in root.messages : VerticalLayout {
                            ChatMessage {
                                data: msg;
                                mind-name: root.mind-name;
                                group-start: idx == 0 || root.messages[idx - 1].role != msg.role;
                                open-run(run) => { root.open-run(run); }
                            }
                            // The run this reply started, as one card, kept in step with the
                            // store: the loop finds it by id, so it is updated in place and
                            // never drawn twice. Plain talk has no run and so no card.
                            for card in root.work-cards : VerticalLayout {
                                if card.run == msg.run && msg.run != "" : Rectangle {
                                    height: work-card.height + Theme.sp-1;
                                    work-card := WorkCard {
                                        x: Theme.sp-3 + 16px + Theme.sp-2;
                                        y: 0;
                                        width: parent.width - self.x - Theme.sp-4;
                                        data: card;
                                        view-desk(run) => { root.view-desk(run); }
                                        details(run) => { root.open-run(run); }
                                    }
                                }
                            }
                        }
                    }
                }

                // The mind's questions, where approvals sit and for the same reason: waiting on the
                // person, they must stay put rather than scroll away with the transcript.
                if root.questions.length > 0 : VerticalLayout {
                    spacing: Theme.sp-1;
                    padding: Theme.sp-2;
                    for q in root.questions : QuestionCard {
                        mind: q.mind;
                        prompt: q.prompt;
                        options: q.options;
                        asked: q.asked;
                        removes: q.removes;
                        answered(a, pressed) => { root.question-answer(q.agent, q.request, a, pressed); }
                    }
                }

                // The current-work strip: only while a run in this chat is live.
                if root.strip-shown : WorkStrip {
                    mind: root.strip.mind;
                    state-label: root.strip.label;
                    needs-you: root.strip.state == "needs-you";
                    live-runs: root.live-runs;
                    waiting-runs: root.waiting-runs;
                    can-view-desk: root.strip.can-view-desk;
                    view-desk => { root.view-desk(root.strip.run); }
                    view-work => { root.open-in-agents(); }
                }

                composer := ChatComposer {
                    mind-name: root.mind-name;
                    mode-label: root.mode-label;
                    destination: root.destination;
                    run-active: root.is-generating || root.live-runs > 0;
                    mic => { root.mic-pressed(); }
                    mode-clicked => { root.mode-clicked(); }
                    escape => { root.close-lens(); }
                    send(text) => {
                        transcript.jump();
                        root.send-message(text);
                        composer.clear();
                    }
                }
            }
        }


        // Drag the left edge to resize, between 380 and 560px. The panel's own left edge moves
        // as it grows, so the drag is measured against the pointer's place on the screen, not
        // against the handle it is dragging: measured against the handle, every step would
        // change what the next one was measured from and the edge would shudder.
        if root.chat-mode : resize-handle := TouchArea {
            x: 0;
            width: 8px;
            height: parent.height;
            mouse-cursor: ew-resize;
            property <length> start-width;
            property <length> start-pointer;
            pointer-event(event) => {
                if (event.button == PointerEventButton.left && event.kind == PointerEventKind.down) {
                    self.start-width = root.panel-width;
                    self.start-pointer = self.absolute-position.x + self.mouse-x;
                }
            }
            moved => {
                if (self.pressed) {
                    root.panel-width = clamp(
                        self.start-width - (self.absolute-position.x + self.mouse-x - self.start-pointer),
                        Theme.chat-panel-min, Theme.chat-panel-max);
                }
            }
        }
    }

    // Reset selection when results change
    changed results => { root.selected-index = 0; }

    // Keyboard navigation — Up/Down/Tab move selection, Escape closes.
    //
    // Kept, and no longer the only copy. This is a 0x0 FocusScope standing beside the panel: it
    // is not focused and it is not an ancestor of the field that is, so Slint has never had a
    // path to deliver a key to it, and Escape and the arrows did nothing for as long as the Lens
    // has existed. The field carries the same three keys now (see `lens-input.key-pressed`);
    // this stays for the case where something else inside the panel has focus and rejects a key,
    // which does reach it by bubbling.
    key-handler := FocusScope {
        width: 0; height: 0;
        key-pressed(event) => {
            if event.text == Key.DownArrow || event.text == Key.Tab {
                root.move-selection(1);
                return accept;
            }
            if event.text == Key.UpArrow {
                root.move-selection(-1);
                return accept;
            }
            if event.text == Key.Escape {
                root.close-lens();
                return accept;
            }
            return reject;
        }
    }

    // Auto-focus input when lens opens
    forward-focus: lens-input;
}
