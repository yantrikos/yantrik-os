// MindPanel — the right edge of every screen: which mind is answering and on what, what it may
// do, what is working, and what it did.
//
// The OS holds the desk; the mind is at its edge. This is shell furniture: it is declared in
// app.slint, beside the status bar and the taskbar, so it is on every screen that has them — and
// the space it takes is taken from every screen that draws it, which is the other half of that
// rule (see `mind-panel-reserve` in app.slint).
//
// Two shapes. Expanded, a card with four parts — Now, Context, Working, Recent actions — and, in
// agent mode, the machine's load and services, which lived in the rail this replaces. Collapsed, a
// slim strip: the answering mind's initial, a dot per agent at work, and a ring that pulses while
// one of them is waiting for the person.
//
// Everything drawn here comes from `MindPanelState`, which `crates/yantrik-ui/src/mind_panel.rs`
// fills from the harness host, the Agents store, the companion's recipes and the mind audit. The
// mode and the ceiling are the chip's own properties, passed in by app.slint rather than copied.
// Nothing here is a placeholder: what is not known says so.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";

// One of the machine's out-of-process services. Moved here from the machine rail, whose LOAD and
// SERVICES sections this panel now holds (agent mode only, as they were).
export struct ServiceItem {
    id: string,
    status: string,   // running | starting | stopped | failed
    note: string,     // short right-hand detail: "up", "autostart", an error
}

// An agent at work, as the Agents store has it.
export struct MindPanelAgent {
    id: string,        // <harness>:<conversation> — what the Agents screen selects
    mind: string,
    title: string,
    state: string,     // the store's key: thinking | running_tool | waiting_for_you | …
    label: string,     // "running a tool"
    since: string,     // "2m"
}

// A recipe in flight, one line.
export struct MindPanelRecipe {
    id: string,
    name: string,
    step: string,      // "step 3 of 7 · running web_search"
    status: string,    // running | waiting
}

// One thing the mind did, from the mind audit (the ledger, #148, when it lands).
export struct MindPanelAct {
    what: string,      // "files.move"
    when: string,      // "4m ago"
    outcome: string,   // ok | failed | whatever the reporter said
}

// Everything on the panel that is one value rather than a list.
export struct MindPanelNow {
    known: bool,          // false until the harness host has been read once
    mind: string,
    initial: string,
    builtin: bool,
    model: string,        // what it runs on — or why that is not known
    model-named: bool,    // `model` is a model, not a sentence about one
    state: string,        // ready | thinking | offline | attached | unknown
    project: string,      // "" when nothing has detected one
    memory: string,       // "YantrikDB · 1,234 memories"
    memory-known: bool,
    minds: string,        // "3 minds · 2 keep memory"
    running: int,         // agents at work, including those waiting for the person
    needs-you: int,
    more-agents: int,     // at work but not listed here
    recipes-known: bool,
    services: string,     // "6 running · perception failed"
    services-trouble: bool,
}

export global MindPanelState {
    // Expanded or not, per place. The desktop defaults to open and everything else to the strip;
    // Rust replaces both with what the person last chose (~/.config/yantrik/mind-panel.json).
    in-out property <bool> desktop-expanded: true;
    in-out property <bool> elsewhere-expanded: false;
    in-out property <MindPanelNow> now;
    in-out property <[MindPanelAgent]> agents;
    in-out property <[MindPanelRecipe]> recipes;
    in-out property <[MindPanelAct]> acts;
    // The person asked for the panel open (true) or closed, at "desktop" or "elsewhere".
    callback set-expanded(string, bool);
}

component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-size: Theme.fs-micro;
    font-weight: Theme.fw-micro;
    letter-spacing: 1px;
    vertical-alignment: center;
}

component Separator inherits VerticalLayout {
    vertical-stretch: 0;
    Rectangle { height: 11px; }
    Rectangle { height: 1px; background: Theme.separator; }
    Rectangle { height: 11px; }
}

component KeyValue inherits HorizontalLayout {
    vertical-stretch: 0;
    in property <string> key;
    in property <string> value;
    in property <bool> dim: false;
    height: 22px;
    spacing: Theme.sp-2;
    Text {
        text: root.key;
        color: Theme.text-secondary;
        font-size: Theme.fs-caption;
        vertical-alignment: center;
        width: 62px;
    }
    Text {
        text: root.value;
        color: root.dim ? Theme.text-dim : Theme.text-primary;
        font-size: Theme.fs-caption;
        font-weight: root.dim ? 400 : 500;
        horizontal-alignment: right;
        vertical-alignment: center;
        horizontal-stretch: 1;
        overflow: elide;
    }
}

// The answering mind's mark: its initial on a disc. A harness brings no icon of its own, and a
// letter is true of every mind that has a name.
component MindMark inherits Rectangle {
    in property <string> initial;
    in property <bool> builtin;
    in property <bool> online: true;
    in property <length> size: 34px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.online ? Theme.tint-accent : Theme.hover-fill;
    border-width: 1px;
    border-color: root.online ? Theme.accent-dim : Theme.border-strong;
    if root.builtin : Icon {
        commands: Icons.companion;
        size: root.size * 0.52;
        thickness: 1.7px;
        tint: root.online ? Theme.accent : Theme.text-dim;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if !root.builtin : Text {
        text: root.initial;
        color: root.online ? Theme.accent : Theme.text-dim;
        font-size: root.size * 0.44;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StateDot inherits Rectangle {
    in property <string> state;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: root.state == "waiting_for_you" ? Theme.amber
        : root.state == "thinking" || root.state == "running_tool" || root.state == "running" ? Theme.accent
        : root.state == "ready" || root.state == "attached" ? Theme.color-success
        : root.state == "offline" || root.state == "failed" ? Theme.color-danger
        : Theme.text-dim;
}

component MiniMeter inherits VerticalLayout {
    in property <string> name;
    in property <string> value-text;
    in property <int> percent;
    in property <color> tone: Theme.accent;
    horizontal-stretch: 1;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.name; color: Theme.text-secondary; font-size: Theme.fs-micro; horizontal-stretch: 1; }
        Text { text: root.value-text; color: Theme.text-primary; font-size: Theme.fs-micro; font-weight: 500; horizontal-alignment: right; overflow: elide; }
    }
    Rectangle {
        height: 3px;
        border-radius: 1.5px;
        background: Theme.border-strong;
        Rectangle {
            x: 0;
            height: 3px;
            width: parent.width * max(0, min(100, root.percent)) / 100;
            border-radius: 1.5px;
            background: root.tone;
        }
    }
}

// A row that can be pressed, with the hover every other list in the shell has.
component Row inherits TouchArea {
    in property <bool> link: true;
    enabled: root.link;
    mouse-cursor: root.link ? pointer : default;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-sm;
        background: root.link && root.has-hover ? Theme.hover-fill : transparent;
        @children
    }
}

// ── Expanded ────────────────────────────────────────────────────────

component MindCard inherits Rectangle {
    in property <bool> agent-mode;
    in property <length> height-ceiling;
    in property <string> mode;
    in property <string> mode-label;
    // Either bypass is drawn red, as the status bar's chip is.
    property <bool> in-bypass: root.mode == "bypass" || root.mode == "bypass_all";
    in property <string> ceiling;
    in property <int> recipes-screen;
    in property <int> cpu-percent;
    in property <int> mem-percent;
    in property <string> mem-text;
    in property <int> swap-percent;
    in property <string> swap-text;
    in property <int> disk-percent;
    in property <string> disk-text;

    callback collapse();
    callback open-agent(string);
    callback open-agents();
    callback open-recipe(string);
    callback open-mind();
    callback open-mode();
    callback open-audit();

    property <MindPanelNow> now: MindPanelState.now;

    width: 302px;
    // As tall as what it holds, like the rail it replaces: a card that ran to the taskbar over
    // nothing would be a dark rectangle claiming something lived there.
    height: Math.min(body.preferred-height, root.height-ceiling);
    // A panel on the scale (r-lg), with the hairline every card and panel carries now: one pixel a
    // little lighter than the surface, the edge that catches the light.
    border-radius: Theme.r-lg;
    background: Theme.glass-rail;
    border-width: 1px;
    border-color: Theme.border-card;
    clip: true;

    // Clicks between the rows stay on the card.
    TouchArea { width: 100%; height: 100%; }

    body := VerticalLayout {
        padding: Theme.sp-4;
        spacing: 0;

        // ── Now: who is answering, on what, under which mode ──
        HorizontalLayout {
            spacing: 10px;
            height: 40px;
            mind-row := Row {
                horizontal-stretch: 1;
                clicked => { root.open-mind(); }
                HorizontalLayout {
                    padding-left: 2px;
                    spacing: 10px;
                    MindMark {
                        initial: root.now.initial;
                        builtin: root.now.builtin;
                        online: root.now.state != "offline" && root.now.known;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 1px;
                        Text {
                            text: root.now.known ? root.now.mind : "Mind not known yet";
                            color: Theme.text-primary;
                            font-size: Theme.fs-headline;
                            font-weight: Theme.fw-headline;
                            overflow: elide;
                        }
                        HorizontalLayout {
                            spacing: 6px;
                            StateDot { state: root.now.state; y: (parent.height - self.height) / 2; }
                            Text {
                                text: root.now.known ? root.now.state + " · " + root.now.model : "the host has not said yet";
                                color: root.now.model-named ? Theme.text-secondary : Theme.text-dim;
                                font-size: Theme.fs-caption;
                                overflow: elide;
                                horizontal-stretch: 1;
                            }
                        }
                    }
                }
            }
            collapse-ta := TouchArea {
                width: 28px;
                mouse-cursor: pointer;
                clicked => { root.collapse(); }
                Rectangle {
                    width: 28px;
                    height: 28px;
                    y: (parent.height - self.height) / 2;
                    border-radius: Theme.r-sm;
                    background: collapse-ta.has-hover ? Theme.hover-fill : transparent;
                    Icon {
                        commands: Icons.chevron-right;
                        size: 14px;
                        thickness: 1.8px;
                        tint: collapse-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                        x: (parent.width - self.width) / 2;
                        y: (parent.height - self.height) / 2;
                    }
                }
            }
        }
        Rectangle { height: 10px; }
        // The mode and the machine's ceiling, side by side because neither means much alone.
        HorizontalLayout {
            height: 24px;
            spacing: Theme.sp-2;
            mode-ta := TouchArea {
                width: mode-row.preferred-width;
                mouse-cursor: pointer;
                clicked => { root.open-mode(); }
                Rectangle {
                    width: 100%;
                    height: 100%;
                    border-radius: Theme.r-sm;
                    background: root.in-bypass ? Theme.color-danger-dim
                        : root.mode == "plan" ? Theme.tint-amber
                        : mode-ta.has-hover ? Theme.hover-fill-strong : Theme.hover-fill;
                    border-width: root.in-bypass ? 1px : 0px;
                    border-color: Theme.color-danger;
                    mode-row := HorizontalLayout {
                        padding-left: 8px;
                        padding-right: 9px;
                        spacing: 5px;
                        Icon {
                            commands: root.mode == "plan" ? Icons.eye : Icons.shield;
                            size: 12px;
                            tint: root.in-bypass ? Theme.color-danger
                                : root.mode == "plan" ? Theme.amber : Theme.text-secondary;
                            y: (parent.height - self.height) / 2;
                        }
                        Text {
                            text: "Mode " + root.mode-label;
                            color: root.in-bypass ? Theme.color-danger
                                : root.mode == "plan" ? Theme.amber : Theme.text-primary;
                            font-size: Theme.fs-micro;
                            font-weight: root.in-bypass ? 700 : 500;
                            vertical-alignment: center;
                        }
                    }
                }
            }
            Text {
                text: root.ceiling != "" ? "ceiling " + root.ceiling : "ceiling not known";
                color: Theme.text-secondary;
                font-size: Theme.fs-micro;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
        }

        Separator {}

        // ── Context ──
        SectionLabel { text: "CONTEXT"; height: 16px; }
        Rectangle { height: 4px; }
        KeyValue {
            key: "Project";
            value: root.now.project != "" ? root.now.project : "not detected";
            dim: root.now.project == "";
        }
        KeyValue { key: "Memory"; value: root.now.memory; dim: !root.now.memory-known; }
        KeyValue { key: "Minds"; value: root.now.minds; dim: !root.now.known; }

        Separator {}

        // ── Working: agents at work, the ones waiting for the person first; recipes in flight ──
        working-ta := TouchArea {
            height: 18px;
            mouse-cursor: pointer;
            clicked => { root.open-agents(); }
            HorizontalLayout {
                spacing: 6px;
                SectionLabel {
                    text: "WORKING";
                    color: working-ta.has-hover ? Theme.text-secondary : Theme.text-dim;
                    horizontal-stretch: 1;
                }
                if root.now.needs-you > 0 : Text {
                    text: root.now.needs-you + " need" + (root.now.needs-you == 1 ? "s" : "") + " you";
                    color: Theme.amber;
                    font-size: Theme.fs-micro;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.now.running > 0 : Text {
                    text: root.now.running + " at work";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 4px; }
        if MindPanelState.agents.length == 0 && MindPanelState.recipes.length == 0 : Text {
            text: root.now.recipes-known ? "Nothing at work." : "No agents at work. Recipes not known yet.";
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            height: 22px;
            vertical-alignment: center;
        }
        for a in MindPanelState.agents : Row {
            height: 40px;
            clicked => { root.open-agent(a.id); }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    padding-top: 9px;
                    alignment: start;
                    StateDot { state: a.state; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: a.mind;
                            color: Theme.text-primary;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: a.title;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-caption;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: a.since == "" ? a.label : a.label + " · " + a.since;
                        color: a.state == "waiting_for_you" ? Theme.amber : Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: a.state == "waiting_for_you" ? 600 : 400;
                        overflow: elide;
                    }
                }
            }
        }
        if root.now.more-agents > 0 : Row {
            height: 22px;
            clicked => { root.open-agents(); }
            Text {
                x: 6px;
                text: "+" + root.now.more-agents + " more in Agents";
                color: Theme.text-secondary;
                font-size: Theme.fs-micro;
                vertical-alignment: center;
            }
        }
        // A recipe is a link only once there is a Recipes screen to open it on.
        for r in MindPanelState.recipes : Row {
            height: 22px;
            link: root.recipes-screen >= 0;
            clicked => { root.open-recipe(r.id); }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                Icon {
                    commands: Icons.template;
                    size: 11px;
                    tint: r.status == "waiting" ? Theme.amber : Theme.accent;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: r.name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-caption;
                    font-weight: 500;
                    vertical-alignment: center;
                    max-width: 110px;
                    overflow: elide;
                }
                Text {
                    text: r.step;
                    color: r.status == "waiting" ? Theme.amber : Theme.text-dim;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        Separator {}

        // ── Recent actions: from the mind audit today, the ledger (#148) later ──
        audit-ta := TouchArea {
            height: 18px;
            mouse-cursor: pointer;
            clicked => { root.open-audit(); }
            HorizontalLayout {
                SectionLabel {
                    text: "RECENT ACTIONS";
                    color: audit-ta.has-hover ? Theme.text-secondary : Theme.text-dim;
                    horizontal-stretch: 1;
                }
                // Which record this is, so nobody takes it for everything the mind did: the audit
                // keeps what ran without anyone being asked.
                Text {
                    text: "unasked · mind audit";
                    color: Theme.text-dim;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 4px; }
        if MindPanelState.acts.length == 0 : Text {
            text: "Nothing has run without asking.";
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            height: 22px;
            vertical-alignment: center;
        }
        for act in MindPanelState.acts : HorizontalLayout {
            height: 22px;
            padding-left: 6px;
            padding-right: 6px;
            spacing: 8px;
            Icon {
                commands: act.outcome == "ok" ? Icons.check : act.outcome == "failed" ? Icons.warning : Icons.clock;
                size: 11px;
                thickness: 1.8px;
                tint: act.outcome == "ok" ? Theme.color-success : act.outcome == "failed" ? Theme.color-danger : Theme.text-dim;
                y: (parent.height - self.height) / 2;
            }
            Text {
                text: act.what;
                color: Theme.text-primary;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
                horizontal-stretch: 1;
                overflow: elide;
            }
            if act.outcome != "ok" : Text {
                text: act.outcome;
                color: act.outcome == "failed" ? Theme.color-danger : Theme.text-secondary;
                font-size: Theme.fs-micro;
                vertical-alignment: center;
                max-width: 70px;
                overflow: elide;
            }
            Text {
                text: act.when;
                color: Theme.text-dim;
                font-size: Theme.fs-micro;
                horizontal-alignment: right;
                vertical-alignment: center;
            }
        }

        // ── Machine: the rail's LOAD and SERVICES, where agent mode had them ──
        if root.agent-mode : VerticalLayout {
            Separator {}
            SectionLabel { text: "MACHINE"; height: 16px; }
            Rectangle { height: 6px; }
            HorizontalLayout {
                spacing: Theme.sp-3;
                MiniMeter { name: "CPU"; value-text: root.cpu-percent + "%"; percent: root.cpu-percent;
                            tone: root.cpu-percent >= 90 ? Theme.color-warning : Theme.accent; }
                MiniMeter { name: "Memory"; value-text: root.mem-text; percent: root.mem-percent;
                            tone: root.mem-percent >= 90 ? Theme.color-warning : Theme.accent; }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: Theme.sp-3;
                MiniMeter { name: "Swap"; value-text: root.swap-text; percent: root.swap-percent;
                            tone: root.swap-percent > 0 ? Theme.color-warning : Theme.color-success; }
                MiniMeter { name: "Disk"; value-text: root.disk-text; percent: root.disk-percent;
                            tone: root.disk-percent >= 90 ? Theme.color-danger : Theme.text-secondary; }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                height: 20px;
                spacing: 8px;
                Rectangle {
                    width: 6px; height: 6px;
                    y: (parent.height - 6px) / 2;
                    border-radius: 3px;
                    background: root.now.services-trouble ? Theme.color-danger : Theme.color-success;
                }
                Text {
                    text: "Services: " + root.now.services;
                    color: root.now.services-trouble ? Theme.color-danger : Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
}

// ── Collapsed ───────────────────────────────────────────────────────

component MindStrip inherits Rectangle {
    in property <int> ambient-interval-ms: 16;
    callback expand();

    property <MindPanelNow> now: MindPanelState.now;
    // A ring that breathes while someone is waiting on the person. Driven by a timer only while it
    // is needed; with animation off (a headless or unattended machine) the ring simply stays lit.
    property <bool> breathing: root.now.needs-you > 0 && root.ambient-interval-ms > 0;
    property <bool> lit: true;
    property <int> dots: min(root.now.running, 6);
    Timer {
        interval: 700ms;
        running: root.breathing;
        triggered => { root.lit = !root.lit; }
    }

    width: 44px;
    background: Theme.glass-rail;

    // The strip's one edge, the same hairline as the card's.
    Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Theme.border-card;
    }

    strip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.expand(); }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: strip-ta.has-hover ? Theme.hover-fill : transparent;
    }

    VerticalLayout {
        padding-top: 10px;
        padding-bottom: 10px;
        spacing: 10px;
        alignment: start;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 34px;
                height: 34px;
                MindMark {
                    initial: root.now.initial;
                    builtin: root.now.builtin;
                    online: root.now.state != "offline" && root.now.known;
                    size: 28px;
                    x: 3px;
                    y: 3px;
                }
                // The pulse: somebody at work is waiting for the person.
                Rectangle {
                    width: 34px;
                    height: 34px;
                    border-radius: 17px;
                    border-width: 2px;
                    border-color: Theme.amber;
                    background: transparent;
                    opacity: root.now.needs-you == 0 ? 0 : root.lit ? 1 : 0.2;
                    animate opacity { duration: 650ms; easing: ease-in-out; }
                }
            }
        }

        // A dot per agent at work; the ones waiting for the person first, and amber.
        for i in root.dots : HorizontalLayout {
            alignment: center;
            height: 8px;
            Rectangle {
                width: 7px;
                height: 7px;
                border-radius: 3.5px;
                background: i < root.now.needs-you ? Theme.amber : Theme.accent;
            }
        }
        if root.now.running > 6 : Text {
            text: "+" + (root.now.running - 6);
            color: Theme.text-secondary;
            font-size: Theme.fs-micro;
            horizontal-alignment: center;
        }
        if MindPanelState.recipes.length > 0 : HorizontalLayout {
            alignment: center;
            Icon {
                commands: Icons.template;
                size: 12px;
                tint: Theme.text-secondary;
            }
        }
    }

    Icon {
        commands: Icons.chevron-left;
        size: 14px;
        thickness: 1.8px;
        tint: strip-ta.has-hover ? Theme.text-primary : Theme.text-dim;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 12px;
    }
}

// ── The panel, in whichever shape it is in ──────────────────────────

export component MindPanel inherits Rectangle {
    // Expanded now. app.slint decides it from the place and the person's choice.
    in property <bool> open;
    in property <bool> agent-mode;
    in property <int> ambient-interval-ms: 16;
    in property <string> mode: "ask";
    in property <string> mode-label: "Ask";
    in property <string> ceiling: "";
    // Where a recipe row opens. There is no Recipes screen yet: -1, and the rows are not links.
    in property <int> recipes-screen: -1;
    in property <int> cpu-percent;
    in property <int> mem-percent;
    in property <string> mem-text;
    in property <int> swap-percent;
    in property <string> swap-text;
    in property <int> disk-percent;
    in property <string> disk-text;

    callback toggle(bool);
    callback open-agent(string);
    callback open-agents();
    callback open-recipe(string);
    callback open-mind();
    callback open-mode();
    callback open-audit();

    background: transparent;

    if root.open : MindCard {
        x: parent.width - self.width - Theme.sp-4;
        y: Theme.sp-4;
        height-ceiling: parent.height - Theme.sp-4 * 2;
        agent-mode: root.agent-mode;
        mode: root.mode;
        mode-label: root.mode-label;
        ceiling: root.ceiling;
        recipes-screen: root.recipes-screen;
        cpu-percent: root.cpu-percent;
        mem-percent: root.mem-percent;
        mem-text: root.mem-text;
        swap-percent: root.swap-percent;
        swap-text: root.swap-text;
        disk-percent: root.disk-percent;
        disk-text: root.disk-text;
        collapse => { root.toggle(false); }
        open-agent(id) => { root.open-agent(id); }
        open-agents => { root.open-agents(); }
        open-recipe(id) => { root.open-recipe(id); }
        open-mind => { root.open-mind(); }
        open-mode => { root.open-mode(); }
        open-audit => { root.open-audit(); }
    }

    if !root.open : MindStrip {
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        ambient-interval-ms: root.ambient-interval-ms;
        expand => { root.toggle(true); }
    }
}
