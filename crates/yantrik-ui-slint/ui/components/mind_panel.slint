// MindPanel — the Mind at the right edge: who is answering and what it may do, what this is,
// what is running, and what it did lately.
//
// Hidden until the person keeps it (Pranab, 20 Oct 2026; design/art-direction-2026-10-20.md, C):
// it had taken width from every screen and filled it with a status report about the software.
// Three shapes per place, kept across restarts: hidden (no room taken), a 40px strip, or pinned
// (a 304px pane beside the screen). The mode menu's "Show what the Mind is doing" brings it up
// over the screen for a look, as a floating card with a Pin button.
//
// What it says is what is useful now: the mind and what it may do, which project this is (or
// that it is not known), what is running ("Nothing running." when nothing is), and at most two
// things done in the last two hours. The models, the count of memories and of minds, and the
// pickers that are in the ask bar anyway went.
//
// The OS holds the desk; the mind is at its edge. This is shell furniture: it is declared in
// app.slint, beside the status bar and the taskbar, so it is on every screen that has them — and
// the space it takes is taken from every screen that draws it, which is the other half of that
// rule (see `mind-panel-reserve` in app.slint).
//
// Two shapes. Expanded, a card with four parts — Now, Context, Working, Recent actions — and, in
// agent mode, the machine's load and services, which lived in the rail this replaces. Collapsed, a
// slim strip: the answering mind's initial, a dot per agent at work, and a ring that pulses while
// one of them is waiting for the person.
//
// Everything drawn here comes from `MindPanelState`, which `crates/yantrik-ui/src/mind_panel.rs`
// fills from the harness host, the Agents store, the companion's recipes and the mind audit. The
// mode and the ceiling are the chip's own properties, passed in by app.slint rather than copied.
// Nothing here is a placeholder: what is not known says so.

import { Theme } from "theme.slint";
import { BoundPicker } from "picker_state.slint";
import { Icon, Icons } from "icon.slint";
import { YTooltip } from "y_tooltip.slint";

// One of the machine's out-of-process services. Moved here from the machine rail, whose LOAD and
// SERVICES sections this panel now holds (agent mode only, as they were).
export struct ServiceItem {
    id: string,
    status: string,   // running | starting | stopped | failed
    note: string,     // short right-hand detail: "up", "autostart", an error
}

// An agent at work, as the Agents store has it.
export struct MindPanelAgent {
    id: string,        // <harness>:<conversation> — what the Agents screen selects
    mind: string,
    title: string,
    state: string,     // the store's key: thinking | running_tool | waiting_for_you | …
    label: string,     // "running a tool"
    since: string,     // "2m"
}

// A recipe in flight, one line.
export struct MindPanelRecipe {
    id: string,
    name: string,
    step: string,      // "step 3 of 7 · running web_search"
    status: string,    // running | waiting
}

// One thing the mind did, from the mind audit (the ledger, #148, when it lands).
export struct MindPanelAct {
    what: string,      // "Ran a command": the plain sentence (mind_panel_words.rs)
    detail: string,    // "terminal.run · ok": the raw id, shown only in the row's tooltip
    when: string,      // "4m ago"
    outcome: string,   // ok | failed | whatever the reporter said
}

// Everything on the panel that is one value rather than a list.
export struct MindPanelNow {
    known: bool,          // false until the harness host has been read once
    mind: string,
    initial: string,
    builtin: bool,
    model: string,        // what it runs on — or why that is not known
    model-named: bool,    // `model` is a model, not a sentence about one
    state: string,        // connected | checking | not-set-up | key-missing | unreachable | not-allowed | own | thinking | offline | unknown
    project: string,      // "" when nothing has detected one
    memory: string,       // "Remembers 1,234 things"
    memory-known: bool,
    minds: string,        // "3 can answer · 2 remember"
    running: int,         // agents at work, including those waiting for the person
    needs-you: int,
    more-agents: int,     // at work but not listed here
    recipes-known: bool,
    services: string,     // "6 running · perception failed"
    services-trouble: bool,
}

export global MindPanelState {
    // Per place: kept there at all (shown), and if so open or the strip (expanded). Hidden by
    // default; Rust replaces these with what the person last chose (~/.config/yantrik/mind-panel.json).
    in-out property <bool> desktop-shown: false;
    in-out property <bool> elsewhere-shown: false;
    in-out property <bool> desktop-expanded: true;
    in-out property <bool> elsewhere-expanded: false;
    // Up over the screen for a look, from the mode menu. Not kept: gone on Pin, on close, or on a
    // click outside it.
    in-out property <bool> peek: false;
    in-out property <MindPanelNow> now;
    in-out property <[MindPanelAgent]> agents;
    in-out property <[MindPanelRecipe]> recipes;
    in-out property <[MindPanelAct]> acts;
    // The person pinned it open (true) or folded it to the strip (false), at "desktop" or "elsewhere".
    callback set-expanded(string, bool);
    // The person unpinned it (false): hidden at that place again.
    callback set-shown(string, bool);
}

// A section's name: sentence case, quiet (the art direction's eyebrow, 12/500).
component SectionLabel inherits Text {
    color: Theme.text-dim;
    font-size: Theme.fs-caption;
    font-weight: 500;
    letter-spacing: 0.4px;
    vertical-alignment: center;
}

// A square button with one icon: Pin, Unpin, Close, Fold.
component IconButton inherits TouchArea {
    in property <string> icon;
    in property <string> tip;
    width: 28px;
    height: 28px;
    mouse-cursor: pointer;
    accessible-role: button;
    accessible-label: root.tip;
    Rectangle {
        border-radius: Theme.r-md;
        background: root.pressed ? Theme.hover-fill-strong : root.has-hover ? Theme.hover-fill : transparent;
        Icon {
            commands: root.icon;
            size: 15px;
            thickness: 1.6px;
            tint: root.has-hover ? Theme.text-primary : Theme.text-secondary;
            x: (parent.width - self.width) / 2;
            y: (parent.height - self.height) / 2;
        }
    }
    YTooltip { text: root.tip; hovered: root.has-hover; x: parent.width - self.width; y: parent.height + 4px; }
}

component Separator inherits VerticalLayout {
    vertical-stretch: 0;
    Rectangle { height: 14px; }
    Rectangle { height: 1px; background: Theme.separator; }
    Rectangle { height: 14px; }
}

component KeyValue inherits HorizontalLayout {
    vertical-stretch: 0;
    in property <string> key;
    in property <string> value;
    in property <bool> dim: false;
    // At least a line, and taller when the value needs two: the sweep of 17 October found values
    // cut mid-word on every screen, and a value is a sentence now, not a code.
    min-height: 22px;
    spacing: Theme.sp-2;
    Text {
        text: root.key;
        color: Theme.text-secondary;
        font-size: Theme.fs-caption;
        vertical-alignment: center;
        width: 62px;
    }
    Text {
        text: root.value;
        color: root.dim ? Theme.text-dim : Theme.text-primary;
        font-size: Theme.fs-caption;
        font-weight: root.dim ? 400 : 500;
        horizontal-alignment: right;
        vertical-alignment: center;
        horizontal-stretch: 1;
        wrap: word-wrap;
    }
}

// The answering mind's mark: its initial on a disc. A harness brings no icon of its own, and a
// letter is true of every mind that has a name.
component MindMark inherits Rectangle {
    in property <string> initial;
    in property <bool> builtin;
    in property <bool> online: true;
    in property <length> size: 34px;
    width: root.size;
    height: root.size;
    border-radius: root.size / 2;
    background: root.online ? Theme.tint-accent : Theme.hover-fill;
    border-width: 1px;
    border-color: root.online ? Theme.accent-dim : Theme.border-strong;
    if root.builtin : Icon {
        commands: Icons.companion;
        size: root.size * 0.52;
        thickness: 1.7px;
        tint: root.online ? Theme.accent : Theme.text-dim;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
    if !root.builtin : Text {
        text: root.initial;
        color: root.online ? Theme.accent : Theme.text-dim;
        font-size: root.size * 0.44;
        font-weight: 700;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
}

component StateDot inherits Rectangle {
    in property <string> state;
    width: 7px;
    height: 7px;
    border-radius: 3.5px;
    background: root.state == "waiting_for_you" ? Theme.amber
        : root.state == "thinking" || root.state == "running_tool" || root.state == "running" ? Theme.accent
        : root.state == "connected" || root.state == "ready" || root.state == "attached" ? Theme.color-success
        : root.state == "offline" || root.state == "failed" ? Theme.color-danger
        : root.state == "key-missing" || root.state == "unreachable" || root.state == "not-set-up" || root.state == "not-allowed" ? Theme.amber
        : Theme.text-dim;
}

component MiniMeter inherits VerticalLayout {
    in property <string> name;
    in property <string> value-text;
    in property <int> percent;
    in property <color> tone: Theme.accent;
    horizontal-stretch: 1;
    spacing: 3px;
    HorizontalLayout {
        Text { text: root.name; color: Theme.text-secondary; font-size: Theme.fs-micro; horizontal-stretch: 1; }
        Text { text: root.value-text; color: Theme.text-primary; font-size: Theme.fs-micro; font-weight: 500; horizontal-alignment: right; overflow: elide; }
    }
    Rectangle {
        height: 3px;
        border-radius: 1.5px;
        background: Theme.border-strong;
        Rectangle {
            x: 0;
            height: 3px;
            width: parent.width * max(0, min(100, root.percent)) / 100;
            border-radius: 1.5px;
            background: root.tone;
        }
    }
}

// A row that can be pressed, with the hover every other list in the shell has.
component Row inherits TouchArea {
    in property <bool> link: true;
    enabled: root.link;
    mouse-cursor: root.link ? pointer : default;
    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: Theme.r-sm;
        background: root.link && root.has-hover ? Theme.hover-fill : transparent;
        @children
    }
}

// ── Expanded ────────────────────────────────────────────────────────

component MindCard inherits Rectangle {
    // Up for a look, over the screen (a floating card with Pin), or pinned beside it (a pane).
    in property <bool> peeking;
    in property <bool> agent-mode;
    in property <length> height-ceiling;
    in property <string> mode;
    in property <string> mode-label;
    // Either bypass is drawn red, as the status bar's chip is.
    property <bool> in-bypass: root.mode == "bypass" || root.mode == "bypass_all";
    in property <string> ceiling;
    in property <int> recipes-screen;
    in property <int> cpu-percent;
    in property <int> mem-percent;
    in property <string> mem-text;
    in property <int> swap-percent;
    in property <string> swap-text;
    in property <int> disk-percent;
    in property <string> disk-text;

    callback collapse();
    callback pin();
    callback unpin();
    callback close();
    callback open-agent(string);
    callback open-agents();
    callback open-recipe(string);
    callback open-mind();
    callback open-mode();
    callback open-audit();

    property <MindPanelNow> now: MindPanelState.now;

    // What the mode means, said as what the mind will do. The machine's ceiling bounds every mode,
    // so a ceiling of `safe` (look, never change) is said instead of a mode it would contradict.
    // The ceiling itself is in the tooltip and in Settings > Privacy; `ceiling sensitive` on every
    // screen was a finding on every screen in the sweep of 17 October.
    pure function mode-meaning(mode: string, ceiling: string) -> string {
        if (ceiling == "safe") { return "Only looks; it cannot change anything"; }
        if (mode == "plan") { return "Looks and proposes; changes nothing"; }
        if (mode == "ask") { return "Asks before anything that matters"; }
        if (mode == "auto") { return "Asks only before risky things"; }
        if (mode == "bypass") { return "Runs most things without asking"; }
        if (mode == "bypass_all") { return "Runs everything allowed without asking"; }
        return "Mode not known yet";
    }
    pure function ceiling-meaning(ceiling: string) -> string {
        if (ceiling == "safe") { return "The most it may ever do: look"; }
        if (ceiling == "standard") { return "The most it may ever do: changes that can be undone"; }
        if (ceiling == "sensitive") { return "The most it may ever do: change settings, never destroy"; }
        if (ceiling == "dangerous") { return "The most it may ever do: anything, deleting included"; }
        return "The most it may do is not known yet";
    }

    width: 304px;
    // Looked at: as tall as what it holds, floating (level 2, its shadow and a 16px radius).
    // Pinned: the full height beside the screen, a structural pane (level 1), its one edge a hairline.
    height: root.peeking ? Math.min(body.preferred-height, root.height-ceiling) : root.height-ceiling;
    border-radius: root.peeking ? Theme.r-xl : 0px;
    background: root.peeking ? Theme.bg-card : Theme.bg-surface;
    border-width: root.peeking ? 1px : 0px;
    border-color: Theme.border-floating;
    drop-shadow-blur: root.peeking ? Theme.shadow-float-blur : 0px;
    drop-shadow-offset-y: root.peeking ? Theme.shadow-float-dy : 0px;
    drop-shadow-color: Theme.shadow-float;
    clip: !root.peeking;
    if !root.peeking : Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Theme.border-structural;
    }

    // Clicks between the rows stay on the card.
    TouchArea { width: 100%; height: 100%; }

    body := VerticalLayout {
        padding: Theme.sp-4;
        spacing: 0;
        // Pinned, the pane is the full height: what it holds stays at the top, not spread down it.
        alignment: start;

        // ── Who is answering, and what it may do ──
        HorizontalLayout {
            spacing: 10px;
            height: 44px;
            mind-row := Row {
                horizontal-stretch: 1;
                clicked => { root.open-mind(); }
                HorizontalLayout {
                    padding-left: 2px;
                    spacing: 10px;
                    MindMark {
                        initial: root.now.initial;
                        builtin: root.now.builtin;
                        online: root.now.state != "offline" && root.now.known;
                        size: 32px;
                        y: (parent.height - self.height) / 2;
                    }
                    VerticalLayout {
                        alignment: center;
                        spacing: 2px;
                        Text {
                            text: root.now.known ? root.now.mind : "Mind not known yet";
                            color: Theme.text-primary;
                            font-size: Theme.fs-title-2;
                            font-weight: 600;
                            overflow: elide;
                        }
                        // What it may do, in the words the bar's chip uses. A click opens the mode menu.
                        mode-ta := TouchArea {
                            height: meaning.preferred-height;
                            mouse-cursor: pointer;
                            clicked => { root.open-mode(); }
                            meaning := Text {
                                width: 100%;
                                text: root.mode-meaning(root.mode, root.ceiling);
                                color: root.in-bypass ? Theme.color-danger
                                    : mode-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                font-weight: root.in-bypass ? 600 : 400;
                                overflow: elide;
                            }
                        }
                    }
                }
            }
            if root.peeking : VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    IconButton { icon: Icons.pushpin; tip: "Pin beside the screen"; clicked => { root.pin(); } }
                    IconButton { icon: Icons.close; tip: "Close"; clicked => { root.close(); } }
                }
            }
            if !root.peeking : VerticalLayout {
                alignment: center;
                HorizontalLayout {
                    spacing: 2px;
                    IconButton { icon: Icons.chevron-right; tip: "Fold to the strip"; clicked => { root.collapse(); } }
                    IconButton { icon: Icons.close; tip: "Unpin: hide it here"; clicked => { root.unpin(); } }
                }
            }
        }
        // Only when something is wrong with the mind's model: what, in its own words (#673). A
        // model that works is not news.
        if root.now.known && root.now.state != "connected" && root.now.state != "own" && root.now.state != "thinking" && root.now.state != "unknown" : HorizontalLayout {
            spacing: 6px;
            padding-top: 6px;
            StateDot { state: root.now.state; y: (parent.height - self.height) / 2; }
            Text {
                text: root.now.model;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                wrap: word-wrap;
                horizontal-stretch: 1;
            }
        }

        Separator {}

        // ── Here ──
        SectionLabel { text: "Here"; height: 18px; }
        Rectangle { height: 6px; }
        Text {
            text: root.now.project != "" ? root.now.project : "It doesn't know which project this is.";
            color: root.now.project != "" ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.fs-body;
            font-weight: root.now.project != "" ? 600 : 400;
            wrap: word-wrap;
        }

        Separator {}

        // ── Working: agents at work, the ones waiting for the person first; recipes in flight ──
        working-ta := TouchArea {
            height: 18px;
            accessible-role: button;
            accessible-label: "Now: open Agents";
            mouse-cursor: pointer;
            clicked => { root.open-agents(); }
            HorizontalLayout {
                spacing: 6px;
                SectionLabel {
                    text: "Now";
                    color: working-ta.has-hover ? Theme.text-secondary : Theme.text-dim;
                    horizontal-stretch: 1;
                }
                if root.now.needs-you > 0 : Text {
                    text: root.now.needs-you + " need" + (root.now.needs-you == 1 ? "s" : "") + " you";
                    color: Theme.amber;
                    font-size: Theme.fs-caption;
                    font-weight: 600;
                    vertical-alignment: center;
                }
                if root.now.running > 0 : Text {
                    text: root.now.running + " at work";
                    color: Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }
            }
        }
        Rectangle { height: 6px; }
        if MindPanelState.agents.length == 0 && MindPanelState.recipes.length == 0 : Text {
            text: root.now.recipes-known ? "Nothing running." : "Nothing running that it can see.";
            color: Theme.text-secondary;
            font-size: Theme.fs-body;
            height: 22px;
            vertical-alignment: center;
        }
        for a in MindPanelState.agents : Row {
            height: 40px;
            clicked => { root.open-agent(a.id); }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                VerticalLayout {
                    padding-top: 9px;
                    alignment: start;
                    StateDot { state: a.state; }
                }
                VerticalLayout {
                    alignment: center;
                    spacing: 1px;
                    HorizontalLayout {
                        spacing: 6px;
                        Text {
                            text: a.mind;
                            color: Theme.text-primary;
                            font-size: Theme.fs-caption;
                            font-weight: 600;
                            vertical-alignment: center;
                        }
                        Text {
                            text: a.title;
                            color: Theme.text-secondary;
                            font-size: Theme.fs-caption;
                            vertical-alignment: center;
                            horizontal-stretch: 1;
                            overflow: elide;
                        }
                    }
                    Text {
                        text: a.since == "" ? a.label : a.label + " · " + a.since;
                        color: a.state == "waiting_for_you" ? Theme.amber : Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: a.state == "waiting_for_you" ? 600 : 400;
                        overflow: elide;
                    }
                }
            }
        }
        if root.now.more-agents > 0 : Row {
            height: 22px;
            clicked => { root.open-agents(); }
            Text {
                x: 6px;
                text: "+" + root.now.more-agents + " more in Agents";
                color: Theme.text-secondary;
                font-size: Theme.fs-micro;
                vertical-alignment: center;
            }
        }
        // A recipe is a link only once there is a Recipes screen to open it on.
        for r in MindPanelState.recipes : Row {
            height: 22px;
            link: root.recipes-screen >= 0;
            clicked => { root.open-recipe(r.id); }
            HorizontalLayout {
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                Icon {
                    commands: Icons.template;
                    size: 11px;
                    tint: r.status == "waiting" ? Theme.amber : Theme.accent;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: r.name;
                    color: Theme.text-primary;
                    font-size: Theme.fs-caption;
                    font-weight: 500;
                    vertical-alignment: center;
                    max-width: 110px;
                    overflow: elide;
                }
                Text {
                    text: r.step;
                    color: r.status == "waiting" ? Theme.amber : Theme.text-dim;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }

        // ── Recent: the last two hours from the mind audit (what ran without anyone being asked; its
        // tooltip and the audit view say so), only when there is something ──
        if MindPanelState.acts.length > 0 : Separator {}
        if MindPanelState.acts.length > 0 : audit-ta := TouchArea {
            height: 18px;
            mouse-cursor: pointer;
            clicked => { root.open-audit(); }
            accessible-role: button;
            accessible-label: "Recent: open the audit";
            HorizontalLayout {
                SectionLabel {
                    text: "Recent";
                    color: audit-ta.has-hover ? Theme.text-secondary : Theme.text-dim;
                    horizontal-stretch: 1;
                }
                Text {
                    text: "All activity";
                    color: audit-ta.has-hover ? Theme.text-primary : Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                }
            }
        }
        if MindPanelState.acts.length > 0 : Rectangle { height: 6px; }
        // Each row is a sentence ("Ran a command"); its raw id is in the tooltip, and the whole record,
        // older failures included, is one click away in the audit view.
        for act in MindPanelState.acts : Rectangle {
            min-height: act-row.preferred-height;
            act-ta := TouchArea {}
            YTooltip { text: act.detail; hovered: act-ta.has-hover; x: parent.width - self.width; y: -self.height - 2px; }
            act-row := HorizontalLayout {
                min-height: 22px;
                padding-left: 6px;
                padding-right: 6px;
                spacing: 8px;
                Icon {
                    commands: act.outcome == "ok" ? Icons.check : act.outcome == "failed" ? Icons.warning : Icons.clock;
                    size: 11px;
                    thickness: 1.8px;
                    tint: act.outcome == "ok" ? Theme.color-success : act.outcome == "failed" ? Theme.color-danger : Theme.text-dim;
                    y: (parent.height - self.height) / 2;
                }
                Text {
                    text: act.what;
                    color: act.outcome == "failed" ? Theme.color-danger : Theme.text-primary;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    wrap: word-wrap;
                }
                // A failure says so in its sentence ("Couldn't run a command"); anything else that is
                // not plainly ok is said as reported.
                if act.outcome != "ok" && act.outcome != "failed" : Text {
                    text: act.outcome;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-micro;
                    vertical-alignment: center;
                    max-width: 70px;
                    overflow: elide;
                }
                Text {
                    text: act.when;
                    color: Theme.text-dim;
                    font-size: Theme.fs-caption;
                    horizontal-alignment: right;
                    vertical-alignment: center;
                }
            }
        }

        // ── Machine: the rail's LOAD and SERVICES, where agent mode had them ──
        if root.agent-mode : VerticalLayout {
            Separator {}
            SectionLabel { text: "Machine"; height: 18px; }
            Rectangle { height: 6px; }
            HorizontalLayout {
                spacing: Theme.sp-3;
                MiniMeter { name: "CPU"; value-text: root.cpu-percent + "%"; percent: root.cpu-percent;
                            tone: root.cpu-percent >= 90 ? Theme.color-warning : Theme.accent; }
                MiniMeter { name: "Memory"; value-text: root.mem-text; percent: root.mem-percent;
                            tone: root.mem-percent >= 90 ? Theme.color-warning : Theme.accent; }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                spacing: Theme.sp-3;
                MiniMeter { name: "Swap"; value-text: root.swap-text; percent: root.swap-percent;
                            tone: root.swap-percent > 0 ? Theme.color-warning : Theme.color-success; }
                MiniMeter { name: "Disk"; value-text: root.disk-text; percent: root.disk-percent;
                            tone: root.disk-percent >= 90 ? Theme.color-danger : Theme.text-secondary; }
            }
            Rectangle { height: 8px; }
            HorizontalLayout {
                height: 20px;
                spacing: 8px;
                Rectangle {
                    width: 6px; height: 6px;
                    y: (parent.height - 6px) / 2;
                    border-radius: 3px;
                    background: root.now.services-trouble ? Theme.color-danger : Theme.color-success;
                }
                Text {
                    text: "Services: " + root.now.services;
                    color: root.now.services-trouble ? Theme.color-danger : Theme.text-secondary;
                    font-size: Theme.fs-caption;
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    overflow: elide;
                }
            }
        }
    }
}

// ── Collapsed ───────────────────────────────────────────────────────

component MindStrip inherits Rectangle {
    in property <int> ambient-interval-ms: 16;
    callback expand();

    property <MindPanelNow> now: MindPanelState.now;

    width: 40px;
    background: Theme.bg-surface;
    accessible-role: button;
    accessible-label: "Open the Mind panel";

    // The strip's one edge, the structural hairline.
    Rectangle {
        x: 0;
        width: 1px;
        height: 100%;
        background: Theme.border-structural;
    }

    strip-ta := TouchArea {
        mouse-cursor: pointer;
        clicked => { root.expand(); }
    }
    Rectangle {
        width: 100%;
        height: 100%;
        background: strip-ta.has-hover ? Theme.hover-fill : transparent;
    }

    VerticalLayout {
        padding-top: 10px;
        spacing: 10px;
        alignment: start;
        HorizontalLayout {
            alignment: center;
            MindMark {
                initial: root.now.initial;
                builtin: root.now.builtin;
                online: root.now.state != "offline" && root.now.known;
                size: 28px;
            }
        }
        // How many are waiting for the person: a number, in the colour that means it. Nothing
        // breathes and nothing is drawn when nobody is waiting.
        if root.now.needs-you > 0 : HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 22px;
                height: 18px;
                border-radius: 9px;
                background: Theme.amber;
                Text {
                    text: root.now.needs-you;
                    color: Theme.bg-deep;
                    font-size: Theme.fs-caption;
                    font-weight: 700;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                }
            }
        }
    }

    Icon {
        commands: Icons.chevron-left;
        size: 14px;
        thickness: 1.8px;
        tint: strip-ta.has-hover ? Theme.text-primary : Theme.text-dim;
        x: (parent.width - self.width) / 2;
        y: parent.height - self.height - 12px;
    }
}

// ── The panel, in whichever shape it is in ──────────────────────────

export component MindPanel inherits Rectangle {
    // Expanded now, and whether that is a look (over the screen) rather than pinned. app.slint
    // decides both from the place, the person's choice and MindPanelState.peek.
    in property <bool> open;
    in property <bool> peeking;
    in property <bool> agent-mode;
    in property <int> ambient-interval-ms: 16;
    in property <string> mode: "ask";
    in property <string> mode-label: "Ask";
    in property <string> ceiling: "";
    // Where a recipe row opens. There is no Recipes screen yet: -1, and the rows are not links.
    in property <int> recipes-screen: -1;
    in property <int> cpu-percent;
    in property <int> mem-percent;
    in property <string> mem-text;
    in property <int> swap-percent;
    in property <string> swap-text;
    in property <int> disk-percent;
    in property <string> disk-text;

    callback toggle(bool);
    callback pin();
    callback unpin();
    callback close();
    callback open-agent(string);
    callback open-agents();
    callback open-recipe(string);
    callback open-mind();
    callback open-mode();
    callback open-audit();

    background: transparent;

    if root.open : MindCard {
        x: root.peeking ? parent.width - self.width - Theme.sp-3 : parent.width - self.width;
        y: root.peeking ? Theme.sp-3 : 0;
        height-ceiling: root.peeking ? parent.height - Theme.sp-3 * 2 : parent.height;
        peeking: root.peeking;
        agent-mode: root.agent-mode;
        mode: root.mode;
        mode-label: root.mode-label;
        ceiling: root.ceiling;
        recipes-screen: root.recipes-screen;
        cpu-percent: root.cpu-percent;
        mem-percent: root.mem-percent;
        mem-text: root.mem-text;
        swap-percent: root.swap-percent;
        swap-text: root.swap-text;
        disk-percent: root.disk-percent;
        disk-text: root.disk-text;
        collapse => { root.toggle(false); }
        pin => { root.pin(); }
        unpin => { root.unpin(); }
        close => { root.close(); }
        open-agent(id) => { root.open-agent(id); }
        open-agents => { root.open-agents(); }
        open-recipe(id) => { root.open-recipe(id); }
        open-mind => { root.open-mind(); }
        open-mode => { root.open-mode(); }
        open-audit => { root.open-audit(); }
    }

    if !root.open : MindStrip {
        x: parent.width - self.width;
        y: 0;
        height: parent.height;
        ambient-interval-ms: root.ambient-interval-ms;
        expand => { root.toggle(true); }
    }
}
