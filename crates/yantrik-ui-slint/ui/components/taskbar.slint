// Taskbar — launcher, open windows, the companion.
//
// Replaces the centred dock on the desktop. The difference that matters is what the bar
// COUNTS: a dock grows with applications installed (49 .desktop files scanned at boot, and
// climbing), a taskbar grows with windows open. One of those is bounded by what the person
// is actually doing; the other is not. Everything installed lives behind the launcher button.
//
// Layout, left to right:
//   [⊞ Apps] │ window │ window │ window …                    │ [● Chat · Hermes 2] │ ▕
//
// The last strip, in the corner, is Show desktop (#241): the place a thrown pointer lands.
//
// Windows come from the compositor (wlrctl toplevel list via windows.rs) already refreshed on
// the 3s poll; the first entry is the most recently focused, and is drawn as active.
//
// No pins. They used to sit here as the first six of a hardcoded app list — the same apps the
// desktop's START row showed in full, and the launcher showed a third time. The taskbar now does
// the one job only it can do: say what is running, on every screen. What you keep to hand lives
// on START and at the top of the launcher.
//
// Deliberately no hover-lift, no glow, no per-item animation: this bar is looked at hundreds
// of times a day and should be still.

import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { AppTile } from "app_tile.slint";
import { WindowItem } from "window_switcher.slint";

export component Taskbar inherits Rectangle {
    // ── The minimised shell screen ──
    //
    // Settings, Files and the rest are not real toplevels -- they are screens inside this
    // process -- so wlrctl never sees them and `windows` above cannot contain them. Without
    // this the shell's own minimise button was a trapdoor: the screen went away and the only
    // route back was the launcher, which is not what minimise means anywhere.
    in property <int> minimized-screen: 0;
    in property <string> minimized-title: "";
    in property <string> minimized-app-id: "";
    callback restore-screen();

    in property <[WindowItem]> windows: [];
    in property <string> launcher-label: "Apps";
    in property <int> companion-count: 0;
    in property <bool> companion-online: true;
    in property <string> companion-status: "idle";
    // The mind the chat talks to, named on the Chat button: "Chat · Hermes". Empty: just "Chat".
    in property <string> chat-with: "";

    callback open-launcher();
    callback activate-window(string);
    callback open-companion();
    callback show-desktop();
    // A right-click — or the Menu key — on a window entry (#232). The shell answers with what
    // the menu holds, because which rows there are depends on state only Rust can read (is the
    // app pinned), and asks for it at the entry's corner. The coordinates are the entry's
    // position in the WINDOW: the menu is drawn by app.slint over everything, not inside this
    // 40px bar, where a menu could only open off the edge of the screen.
    callback window-menu(string, string, length, length);

    height: Theme.taskbar-height;
    // Glass, for the same reason the status bar is: the wallpaper should carry on
    // underneath rather than stopping at the bar.
    background: Theme.glass-panel;

    // Top edge
    Rectangle { y: 0; width: 100%; height: 1px; background: Theme.separator; }

    HorizontalLayout {
        padding-left: Theme.sp-2;
        // Room on the right for Show desktop, which is outside this layout so it can reach the
        // very corner (below).
        padding-right: 12px + Theme.sp-2;
        padding-top: 4px;
        padding-bottom: 4px;
        spacing: Theme.sp-2;

        // ── Launcher ──
        launcher := TouchArea {
            width: launcher-row.preferred-width + 20px;
            mouse-cursor: pointer;
            clicked => { root.open-launcher(); }

            Rectangle {
                width: 100%; height: 100%;
                border-radius: Theme.r-sm;
                background: launcher.pressed ? Theme.accent-button-pressed
                          : launcher.has-hover ? Theme.accent-button-hover
                          : Theme.accent;

                launcher-row := HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    Icon { commands: Icons.apps; tint: Theme.text-on-accent; thickness: 1.8px; y: (parent.height - self.height) / 2; }
                    Text {
                        text: root.launcher-label;
                        color: Theme.text-on-accent;
                        font-size: Theme.font-label;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }

        Rectangle { width: 1px; height: 20px; y: (parent.height - 20px) / 2; background: Theme.separator; }

        // ── Open windows ──
        Flickable {
            horizontal-stretch: 1;
            viewport-width: max(self.width, window-row.preferred-width);
            viewport-height: self.height;
            window-row := HorizontalLayout {
                height: parent.height;
                alignment: start;
                spacing: 5px;

                // Drawn first, because it was the first thing put away.
                if root.minimized-screen != 0 : mini := TouchArea {
                    width: min(220px, mini-row.preferred-width + 22px);
                    mouse-cursor: pointer;
                    clicked => { root.restore-screen(); }

                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.r-sm;
                        background: mini.has-hover ? Theme.hover-fill : transparent;
                        clip: true;

                        mini-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            AppTile {
                                size: 22px;
                                app-id: root.minimized-app-id;
                                glyph: Icons.app-or-window(root.minimized-app-id);
                                dimmed: true;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                text: root.minimized-title;
                                color: Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 170px;
                            }
                        }
                    }
                }

                // Three children, in the pairing file_browser.slint's sidebar uses: what the
                // entry draws, a FocusScope for its keyboard half, and the TouchArea ON TOP for
                // the pointer half. The order matters — a FocusScope over a TouchArea swallows
                // its clicks — so the scope sits under and the TouchArea hands it the focus
                // when the entry is pressed.
                for w[i] in root.windows : win := Rectangle {
                    property <bool> is-active: i == 0;
                    // A right press opens the menu and must not ALSO act as the entry's own
                    // click, which brings the window forward under the menu being opened for
                    // it. TouchArea's `clicked` does not say which button released it, so the
                    // pointer-event that sees the right press leaves this note, and the next
                    // `clicked` reads it. A left press clears it: a right press dragged off
                    // the entry releases elsewhere and never reaches `clicked`, and the note
                    // must not outlive the press that left it.
                    property <bool> menu-press: false;
                    width: min(220px, win-row.preferred-width + 22px);

                    Rectangle {
                        width: 100%; height: 100%;
                        border-radius: Theme.r-sm;
                        background: win.is-active ? Theme.hover-fill-strong
                                  : win-touch.has-hover ? Theme.hover-fill
                                  : transparent;
                        clip: true;

                        // Active underline — the one piece of state on the bar
                        Rectangle {
                            x: (parent.width - 24px) / 2;
                            y: parent.height - 3px;
                            width: 24px; height: 3px;
                            border-radius: 1.5px;
                            background: win.is-active ? Theme.accent : transparent;
                        }

                        win-row := HorizontalLayout {
                            padding-left: 10px;
                            padding-right: 10px;
                            spacing: 8px;
                            // The app's own tile, small: colour says which app, and the
                            // tile dims when its window does not have focus, so the active
                            // state survives them no longer all being grey.
                            AppTile {
                                size: 22px;
                                app-id: w.app-id;
                                glyph: Icons.app-or-window(w.app-id);
                                dimmed: !win.is-active;
                                hovered: win-touch.has-hover;
                                y: (parent.height - self.height) / 2;
                            }
                            Text {
                                // Mind View's title is whatever its compositor wrote
                                // ("labwc - WL-1"), kept because it is what the window is
                                // found by; the strip shows what it is instead.
                                text: w.app-id == "mind-view" ? w.subtitle : w.title;
                                color: win.is-active ? Theme.text-primary : Theme.text-secondary;
                                font-size: Theme.fs-caption;
                                font-weight: win.is-active ? 500 : 400;
                                vertical-alignment: center;
                                overflow: elide;
                                max-width: 170px;
                            }
                        }
                    }

                    win-key := FocusScope {
                        width: 100%; height: 100%;
                        key-pressed(e) => {
                            // The Menu key and Shift+F10 are what a keyboard calls a
                            // right-click; both open the entry's menu (#232). Escape is not
                            // handled here — it belongs to the shell's global scope, which
                            // closes whatever menu is open.
                            if (e.text == Key.Menu || (e.text == Key.F10 && e.modifiers.shift)) {
                                root.window-menu(w.title, w.app-id, win.absolute-position.x, win.absolute-position.y);
                                return accept;
                            }
                            // A tab stop that cannot be pressed is a trap, so Enter and Space
                            // do what a left-click does.
                            if (e.text == Key.Return || e.text == " ") {
                                root.activate-window(w.title);
                                return accept;
                            }
                            reject
                        }
                    }

                    win-touch := TouchArea {
                        width: 100%; height: 100%;
                        mouse-cursor: pointer;
                        clicked => {
                            if (win.menu-press) { win.menu-press = false; return; }
                            win-key.focus();
                            root.activate-window(w.title);
                        }
                        // The same press that opens the desktop's own menu opens this one.
                        pointer-event(e) => {
                            if (e.kind == PointerEventKind.down) {
                                if (e.button == PointerEventButton.right) {
                                    win.menu-press = true;
                                    win-key.focus();
                                    root.window-menu(w.title, w.app-id, win.absolute-position.x, win.absolute-position.y);
                                } else {
                                    win.menu-press = false;
                                }
                            }
                        }
                    }
                }
            }

        }

        Rectangle { width: 1px; height: 20px; y: (parent.height - 20px) / 2; background: Theme.separator; }

        // ── Companion ──
        comp := TouchArea {
            width: comp-row.preferred-width + 22px;
            mouse-cursor: pointer;
            clicked => { root.open-companion(); }

            Rectangle {
                width: 100%; height: 100%;
                border-radius: Theme.r-sm;
                border-width: 1px;
                border-color: comp.has-hover ? Theme.border-strong : Theme.border-default;
                background: comp.has-hover ? Theme.hover-fill : transparent;

                comp-row := HorizontalLayout {
                    alignment: center;
                    spacing: 7px;
                    Rectangle {
                        width: 6px; height: 6px;
                        y: (parent.height - 6px) / 2;
                        border-radius: 3px;
                        background: !root.companion-online ? Theme.color-danger
                                  : root.companion-status == "thinking" ? Theme.accent-light
                                  : Theme.accent;
                    }
                    // "Chat", not "Companion": the Lens talks to whichever mind is answering, and
                    // a person looking for the chat looks for that word (#241).
                    Text {
                        text: root.chat-with == "" ? "Chat" : "Chat · " + root.chat-with;
                        color: Theme.text-primary;
                        font-size: Theme.fs-caption;
                        vertical-alignment: center;
                    }
                    if root.companion-count > 0 : Text {
                        text: root.companion-count;
                        color: Theme.accent;
                        font-size: Theme.fs-micro;
                        font-weight: 600;
                        vertical-alignment: center;
                    }
                }
            }
        }
    }

    // ── Show desktop ──
    //
    // The bottom-right corner, where a pointer thrown at the edge lands: every app window away
    // and the desktop shown, and pressed again, the same windows back (#241). Outside the layout
    // above, which is padded, so it reaches the last pixel on both edges; a narrow strip with a
    // hairline on its left, the shape Windows gave the same button, found by aim, not by reading.
    desk := TouchArea {
        x: parent.width - self.width;
        y: 0;
        width: 12px;
        height: parent.height;
        mouse-cursor: pointer;
        clicked => { root.show-desktop(); }
        Rectangle {
            width: 100%; height: 100%;
            background: desk.has-hover ? Theme.hover-fill : transparent;
            Rectangle { x: 0; width: 1px; height: 60%; y: parent.height * 0.2; background: Theme.separator; }
        }
    }
}
