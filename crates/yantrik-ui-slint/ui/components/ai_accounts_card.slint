// Settings → AI & Intelligence → AI accounts (#673).
//
// Every account the person added — saved providers, custom endpoints and the free tiers switched
// on — with how many models each has and what they can do. The one list the picker and the local
// model gateway read. No key ever reaches this file: Rust sends names, counts and sentences
// (crates/yantrik-ui/src/wire/ai_accounts_card.rs).

import { Theme } from "theme.slint";
import { YButton } from "y_button.slint";

export struct AiAccountRow {
    id: string,            // the gateway's account id: "ollama-cloud", "free-groq"
    name: string,
    summary: string,       // "41 models · 12 think · 8 see images"
    state: string,         // "ready" · "failed" · "pending"
    detail: string,        // where the list came from, or why it did not come
    local: bool,           // on this machine or the local network
    sharing: string,       // "share" · "lane" · "off": where what minds know about the person goes
    share-words: string,   // "Share what your minds know about you with OpenAI"
    private-words: string, // what happens now, in one plain sentence
    switchable: bool,      // the three choices are offered: not local
    offers-share: bool,    // Share is one of them: not a free tier that may train on prompts
    lane-model: string,    // a local account: the model it would keep personal things on
    is-lane: bool,         // a local account that keeps personal things now
}

// One of the three choices, as a line the person presses.
component Choice inherits Rectangle {
    in property <string> text;
    in property <bool> chosen;
    callback pressed();
    height: line.preferred-height + 4px;
    line := HorizontalLayout {
        spacing: Theme.sp-2;
        Text {
            text: root.chosen ? "●" : "○";
            color: root.chosen ? Theme.color-success : Theme.text-dim;
            font-size: Theme.fs-caption;
            vertical-alignment: center;
        }
        Text {
            text: root.text;
            color: root.chosen ? Theme.text-primary : Theme.text-secondary;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
            horizontal-stretch: 1;
            vertical-alignment: center;
        }
    }
    TouchArea {
        mouse-cursor: pointer;
        clicked => { root.pressed(); }
    }
}

export global AiAccountsState {
    in-out property <[AiAccountRow]> rows;
    in-out property <string> summary;      // "4 accounts · 63 models"
    in-out property <string> gateway;      // "Gateway: 127.0.0.1:7460 · 3 minds use it"
    in-out property <bool> refreshing;
    in-out property <string> lane;         // where personal things are kept on this computer
    callback refresh();
    // The person's choice for an account: "share", "lane" or "off".
    callback set-sharing(string, string);
    // Keep personal things on this local model (`<account>/<model>`).
    callback use-as-lane(string);
}

component Row inherits Rectangle {
    in property <AiAccountRow> item;
    height: col.preferred-height;
    col := VerticalLayout {
        spacing: 2px;
        padding-top: Theme.sp-2;
        padding-bottom: Theme.sp-2;
        HorizontalLayout {
            spacing: Theme.sp-2;
            Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - self.height) / 2;
                border-radius: 3.5px;
                background: root.item.state == "ready" ? Theme.color-success
                    : root.item.state == "failed" ? Theme.amber : Theme.text-dim;
            }
            Text {
                text: root.item.name;
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                font-weight: 600;
                horizontal-stretch: 1;
                overflow: elide;
            }
            Text {
                text: root.item.summary;
                color: Theme.text-secondary;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
            }
        }
        Text {
            text: root.item.detail;
            color: root.item.state == "failed" ? Theme.amber : Theme.text-dim;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        Text {
            text: root.item.private-words;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        if root.item.switchable : VerticalLayout {
            spacing: 0px;
            if root.item.offers-share : Choice {
                text: root.item.share-words;
                chosen: root.item.sharing == "share";
                pressed => { AiAccountsState.set-sharing(root.item.id, "share"); }
            }
            Choice {
                text: "Keep personal things on this computer";
                chosen: root.item.sharing == "lane";
                pressed => { AiAccountsState.set-sharing(root.item.id, "lane"); }
            }
            Choice {
                text: "Don't share";
                chosen: root.item.sharing == "off";
                pressed => { AiAccountsState.set-sharing(root.item.id, "off"); }
            }
        }
        if root.item.local && root.item.lane-model != "" : HorizontalLayout {
            alignment: start;
            if root.item.is-lane : Text {
                text: "Keeps personal things on this computer";
                color: Theme.color-success;
                font-size: Theme.fs-caption;
            }
            if !root.item.is-lane : YButton {
                label: "Keep personal things here";
                variant: 1;
                size: 0;
                clicked => { AiAccountsState.use-as-lane(root.item.lane-model); }
            }
        }
    }
}

export component AiAccountsCard inherits Rectangle {
    max-width: 600px;
    background: Theme.bg-card;
    border-radius: Theme.r-lg;
    border-width: 1px;
    border-color: Theme.border-subtle;
    height: layout.preferred-height;

    layout := VerticalLayout {
        padding: Theme.sp-4;
        spacing: Theme.sp-2;
        HorizontalLayout {
            spacing: Theme.sp-2;
            Text {
                text: AiAccountsState.summary;
                color: Theme.text-primary;
                font-size: Theme.fs-body;
                font-weight: 700;
                horizontal-stretch: 1;
                vertical-alignment: center;
            }
            YButton {
                label: AiAccountsState.refreshing ? "Listing…" : "List models again";
                variant: 1;
                size: 0;
                clicked => { AiAccountsState.refresh(); }
            }
        }
        Text {
            // How a mind reaches these accounts without a key (a token for the desktop's gateway on
            // 127.0.0.1:7460) was this sentence, and read as jargon in the sweep of 17 October; the
            // address is in each mind's Details under What runs on what.
            text: "Add an account once and every mind can use its models, through the picker in the ask bar. Keys are kept in this computer\u{2019}s vault; a mind is never given one.";
            color: Theme.text-dim;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        if AiAccountsState.gateway != "" : Text {
            text: AiAccountsState.gateway;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
        }
        if AiAccountsState.lane != "" : Text {
            text: AiAccountsState.lane;
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
            wrap: word-wrap;
        }
        for r in AiAccountsState.rows : Row { item: r; }
        if AiAccountsState.rows.length == 0 : Text {
            text: "No accounts yet. Add a provider below, or switch on a free one.";
            color: Theme.text-secondary;
            font-size: Theme.fs-caption;
        }
    }
}
