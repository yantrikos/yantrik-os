// File browser — full-featured file navigation with sidebar, status bar.
// Screen 8. Sidebar (Places/Devices) + breadcrumb + list + details panel.
// Wrapped in WindowFrame by app.slint — no internal header needed.
// Native workbench: virtualized content, explicit actions, on-demand previews.
// Enterprise features: multi-select, context menu, detail panel toggle,
// create file/folder, status bar with selection info.
//
// The redesign (design/desk-and-mind-2026-09-23.md, section 2): a places sidebar, a
// breadcrumb, large folder tiles in the app's blue with the real item count and when each
// changed, a row of the folder's most recent files under the grid, and a grid/list switch.
// Every number on a tile is read off the disk by the Rust side (filebrowser.rs); one that
// could not be read says so ("Items unknown"), because an unreadable folder is not an empty one.

import { Theme } from "theme.slint";
import { AppColor, AppIdentity } from "components/app_color.slint";
import { Icon, Icons } from "components/icon.slint";
import { YEmptyState } from "components/y_empty_state.slint";
import { AppHeader } from "app_header.slint";
import { YButton } from "y_button.slint";
import { ListView } from "std-widgets.slint";
import { YInput } from "components/y_input.slint";

export struct FileEntry {
    name: string,
    is-dir: bool,
    size-text: string,
    modified-text: string,
    icon-char: string,
    selected: bool,
    // A folder's entries, meaningful only when `count-known`. False with `count-reason` set
    // means the folder could not be read (permission, a budget) — drawn as unknown, never 0.
    item-count: int,
    count-known: bool,
    count-reason: string,
    // "2 h ago", from the entry's modification time; "" when that time could not be read.
    changed-text: string,
}

/// One place in the sidebar. `id` picks the icon: home, documents, downloads, pictures,
/// music, videos, projects. Only places that exist on this machine are sent.
export struct FilePlaceData {
    id: string,
    label: string,
    path: string,
}

/// One file in the recent row under the grid: the folder's most recently changed files.
export struct FileRecentData {
    name: string,
    size-text: string,
    changed-text: string,
    icon-char: string,
}

/// One app in the "Open with" menu: what the shell offers for the selected file. `id` is the
/// desktop entry id the launch and the written default both name; `is-default` marks the app a
/// plain double-click uses (#233).
export struct OpenWithItem {
    name: string,
    id: string,
    is-default: bool,
}

// The words on a tile, in one place so the grid, the list and the recent row agree.
global FileText {
    public pure function items(e: FileEntry) -> string {
        return !e.count-known ? "Items unknown"
             : e.item-count == 1 ? "1 item"
             : "\{e.item-count} items";
    }
    public pure function with-time(first: string, time: string) -> string {
        return time == "" ? first : first == "" ? time : first + " · " + time;
    }
    /// "12 items · 2 h ago" for a folder, "2.4 KB · 3 h ago" for a file.
    public pure function meta(e: FileEntry, trash: bool) -> string {
        return trash ? (e.is-dir ? root.items(e) : e.size-text)
             : e.is-dir ? root.with-time(root.items(e), e.changed-text)
             : root.with-time(e.size-text, e.changed-text);
    }
    public pure function place-icon(id: string) -> string {
        return id == "home" ? Icons.home
             : id == "documents" ? Icons.doc
             : id == "downloads" ? Icons.download
             : id == "pictures" ? Icons.image
             : id == "music" ? Icons.music
             : id == "videos" ? Icons.play
             : id == "projects" ? Icons.code
             : Icons.folder;
    }
    /// A file's glyph colour, by kind. A stroke on a surface, never a fill: the loud colour
    /// in this OS belongs to app tiles.
    public pure function kind-tint(c: string) -> color {
        return c == "\u{25A3}" ? AppColor.magenta     // image
             : c == "\u{266A}" ? AppColor.pink        // audio
             : c == "\u{25B6}" ? AppColor.orange      // video
             : c == "\u{25C7}" ? AppColor.violet      // code
             : c == "\u{25A4}" ? AppColor.amber       // archive
             : c == "\u{25A7}" ? AppColor.red         // pdf
             : c == "\u{2261}" ? AppColor.sky         // text
             : Theme.text-secondary;
    }
}

// A folder, drawn filled in the Files blue: a back panel with its tab and a lighter front.
// The tile colour rather than the glyph tone, and the same in both themes, because a folder
// icon is an object — the mockup the owner liked draws them this way in light and dark alike.
component FolderGlyph inherits Rectangle {
    in property <length> size: 56px;
    width: root.size;
    height: root.size * 40 / 48;
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 48; viewbox-height: 40;
        commands: "M3 9Q3 5 7 5L17 5Q19 5 20.4 6.4L23 9L41 9Q45 9 45 13L45 33Q45 37 41 37L7 37Q3 37 3 33Z";
        fill: AppColor.tile-sky.darker(18%);
        stroke-width: 0px;
    }
    Path {
        width: 100%; height: 100%;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 48; viewbox-height: 40;
        commands: "M3 16Q3 13 6 13L42 13Q45 13 45 16L45 33Q45 37 41 37L7 37Q3 37 3 33Z";
        fill: @linear-gradient(180deg, AppColor.tile-sky.brighter(22%) 0%, AppColor.tile-sky 100%);
        stroke-width: 0px;
    }
}

// A file on a tile: a page with its kind's glyph on it.
component FilePage inherits Rectangle {
    in property <string> kind;
    in property <length> size: 46px;
    width: root.size * 0.82;
    height: root.size;
    border-radius: Theme.r-md;
    background: Theme.bg-elevated;
    border-width: 1px;
    border-color: Theme.border-card;
    Icon {
        commands: Icons.file-kind(root.kind);
        size: root.size * 0.46;
        tint: FileText.kind-tint(root.kind);
        thickness: 1.8px;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;
    }
}

component ViewToggle inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <bool> active;
    callback clicked();
    width: 30px; height: 26px;
    border-radius: Theme.r-sm;
    background: root.active ? Theme.bg-elevated : touch.has-hover ? Theme.hover-fill : transparent;
    border-width: root.active ? 1px : 0px;
    border-color: Theme.border-card;
    accessible-role: button; accessible-label: root.label; accessible-action-default => { root.clicked(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.clicked(); } }
    Icon {
        commands: root.icon; size: 15px; thickness: 1.7px;
        tint: root.active ? AppIdentity.accent : Theme.text-secondary;
        x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
    }
}

// One step of the breadcrumb: a chevron before every step but the first, and the folder's
// name, the current one in full weight.
component Crumb inherits Rectangle {
    in property <string> label;
    in property <bool> first;
    in property <bool> current;
    in property <bool> disabled;
    callback clicked();
    // How wide this step wants to be; the breadcrumb caps it and hides the steps that do not fit.
    out property <length> natural: crumb-text.preferred-width + 16px + (root.first ? 0px : 18px);
    height: 32px;
    accessible-role: button; accessible-label: root.label;
    accessible-action-default => { if !root.disabled { root.clicked(); } }
    HorizontalLayout {
        spacing: 2px;
        if !root.first : Icon {
            commands: Icons.chevron-right; size: 12px; thickness: 1.7px; tint: Theme.text-dim;
            y: (parent.height - self.height) / 2;
        }
        Rectangle {
            border-radius: Theme.r-sm;
            background: touch.has-hover && !root.disabled && !root.current ? Theme.hover-fill : transparent;
            touch := TouchArea { enabled: !root.disabled; mouse-cursor: pointer; clicked => { root.clicked(); } }
            crumb-text := Text {
                x: 8px; width: parent.width - 16px;
                text: root.label;
                font-size: 13px;
                font-weight: root.current ? 600 : 400;
                color: root.current ? Theme.text-primary : Theme.text-secondary;
                vertical-alignment: center;
                overflow: elide;
            }
        }
    }
}

// A file in the recent row: its glyph, its name, its size and when it changed.
component RecentCard inherits Rectangle {
    in property <FileRecentData> file;
    callback activate();
    height: 54px;
    border-radius: Theme.r-lg;
    background: touch.has-hover ? Theme.bg-elevated : Theme.bg-card;
    border-width: 1px;
    border-color: touch.has-hover ? Theme.border-strong : Theme.border-card;
    accessible-role: button; accessible-label: "Open " + root.file.name;
    accessible-action-default => { root.activate(); }
    touch := TouchArea { mouse-cursor: pointer; clicked => { root.activate(); } }
    HorizontalLayout {
        padding-left: 10px; padding-right: 12px; spacing: 10px;
        Rectangle {
            width: 34px; height: 34px; y: (parent.height - self.height) / 2;
            border-radius: Theme.r-md;
            background: FileText.kind-tint(root.file.icon-char).transparentize(0.86);
            Icon {
                commands: Icons.file-kind(root.file.icon-char); size: 18px; thickness: 1.7px;
                tint: FileText.kind-tint(root.file.icon-char);
                x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            }
        }
        VerticalLayout {
            alignment: center; spacing: 2px; horizontal-stretch: 1; min-width: 0px;
            Text { text: root.file.name; color: Theme.text-primary; font-size: 12.5px; font-weight: 500; overflow: elide; }
            Text { text: FileText.with-time(root.file.size-text, root.file.changed-text); color: Theme.text-dim; font-size: 11px; overflow: elide; }
        }
    }
}

export struct BreadcrumbSegment {
    label: string,
    full-path: string,
}

export struct FileDetailData {
    name: string,
    file-type: string,
    size-text: string,
    modified-text: string,
    path-text: string,
    permissions: string,
    preview-text: string,
    is-text-file: bool,
    icon-char: string,
}

export struct FileTabData {
    path: string,
    label: string,
    is-active: bool,
}

export struct FileOpItem {
    operation: string,  // "Copying", "Moving", "Deleting"
    filename: string,
    progress: float,    // 0.0-1.0
    status: string,     // "in_progress", "done", "error"
}

// A place in the sidebar. The selected one wears the Files blue, as the app's identity (see
// AppIdentity): which app you are in, not which control is primary.
component FilePlace inherits Rectangle {
    in property <string> label;
    in property <string> icon;
    in property <bool> active;
    callback clicked();
    height: 34px; border-radius: Theme.r-md;
    background: root.active ? AppIdentity.tint : touch.has-hover ? Theme.hover-fill : transparent;
    accessible-role: button; accessible-label: root.label; accessible-action-default => { root.clicked(); }
    focus := FocusScope { key-pressed(e) => { if e.text == Key.Return || e.text == " " { root.clicked(); return accept; } reject } }
    touch := TouchArea { mouse-cursor: pointer; clicked => { focus.focus(); root.clicked(); } }
    HorizontalLayout { padding-left: 10px; padding-right: 8px; spacing: 10px;
        Icon { commands: root.icon; size: 16px; thickness: 1.7px; tint: root.active ? AppIdentity.accent : Theme.text-secondary; y: (parent.height - self.height)/2; }
        Text { text: root.label; font-size: 13px; font-weight: root.active ? 600 : 400; color: root.active ? Theme.text-primary : Theme.text-secondary; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
    }
    border-width: focus.has-focus ? 1px : 0px; border-color: AppIdentity.accent;
}
component FileRow inherits Rectangle {
    in property <FileEntry> entry;
    in property <bool> selected;
    in property <bool> focused;
    in property <bool> trash;
    callback clicked(); callback activate(); callback context();
    accessible-role: list-item; accessible-label: root.entry.name; accessible-action-default => { root.activate(); }
    touch := TouchArea { clicked => { root.clicked(); } double-clicked => { root.activate(); } pointer-event(e) => { if e.button == PointerEventButton.right && e.kind == PointerEventKind.down { root.context(); } } }
    // The highlight is inset from the list's edges and rounded, so a selected row reads as a
    // thing you picked rather than a stripe across the window.
    Rectangle {
        x: 8px; width: parent.width - 16px; y: 2px; height: parent.height - 4px;
        border-radius: Theme.r-md;
        background: root.selected ? AppIdentity.tint : touch.has-hover ? Theme.hover-fill : transparent;
        border-width: root.focused ? 1px : 0px; border-color: AppIdentity.accent.transparentize(0.45);
    }
    HorizontalLayout { padding-left: 20px; padding-right: 20px; spacing: 14px;
        Rectangle {
            width: 24px;
            if root.entry.is-dir : FolderGlyph { size: 24px; y: (parent.height - self.height) / 2; }
            if !root.entry.is-dir : Icon { commands: Icons.file-kind(root.entry.icon-char); tint: FileText.kind-tint(root.entry.icon-char); size: 19px; thickness: 1.7px; x: 2px; y: (parent.height - self.height) / 2; }
        }
        Text { text: root.entry.name; color: Theme.text-primary; font-size: 13px; font-weight: root.entry.is-dir ? 500 : 400; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
        if root.width >= 420px : Text {
            text: root.entry.is-dir ? FileText.items(root.entry) : root.entry.size-text;
            color: root.entry.is-dir && !root.entry.count-known ? Theme.text-dim : Theme.text-secondary;
            font-size: 12px; width: 96px; vertical-alignment: center; horizontal-alignment: right;
        }
        if root.width >= 680px : Text {
            text: root.trash ? root.entry.modified-text : root.entry.changed-text;
            color: Theme.text-dim; font-size: 12px; width: 88px; vertical-alignment: center; horizontal-alignment: right;
        }
    }
}
// A tile in the grid: a folder in the Files blue with its item count and when it changed, or a
// file as a page with its kind, size and time.
component FileTile inherits Rectangle {
    in property <FileEntry> entry;
    in property <bool> focused;
    in property <bool> trash;
    callback clicked(); callback activate();
    border-radius: Theme.r-lg;
    background: root.entry.selected ? AppIdentity.tint : touch.has-hover ? Theme.hover-fill : transparent;
    border-width: root.focused || root.entry.selected ? 1px : 0px;
    border-color: root.focused ? AppIdentity.accent.transparentize(0.3) : AppIdentity.accent.transparentize(0.6);
    accessible-role: list-item; accessible-label: root.entry.name; accessible-action-default => { root.activate(); }
    touch := TouchArea { clicked => { root.clicked(); } double-clicked => { root.activate(); } }
    VerticalLayout { padding: 10px; padding-top: 14px; spacing: 3px; alignment: start;
        Rectangle { height: 62px;
            if root.entry.is-dir : FolderGlyph { size: 62px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2 + 2px; }
            if !root.entry.is-dir : FilePage { kind: root.entry.icon-char; size: 52px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; }
        }
        Rectangle { height: 6px; }
        Text { text: root.entry.name; color: Theme.text-primary; font-size: 13px; font-weight: 500; horizontal-alignment: center; overflow: elide; height: 18px; }
        Text {
            text: FileText.meta(root.entry, root.trash);
            color: root.entry.is-dir && !root.entry.count-known ? Theme.text-dim : Theme.text-secondary;
            font-size: 11.5px; horizontal-alignment: center; overflow: elide; height: 16px;
        }
    }
}

export component FileBrowser inherits Rectangle {
    // This screen draws its own header rather than AppHeader, so it has to say what
    // it is: AppIdentity is otherwise left holding whichever app was opened before it.




    in property <string> current-path: "~";
    in property <[FileEntry]> entries: [];
    in property <bool> is-loading: false;
    in property <[BreadcrumbSegment]> breadcrumbs: [];
    in property <bool> has-clipboard: false;
    in-out property <bool> show-hidden: false;
    in-out property <bool> grid-view: false;
    in-out property <int> selected-index: -1;
    in property <FileDetailData> file-details;
    in property <string> free-space-text: "";
    in property <bool> can-go-back: false;
    in property <bool> can-go-forward: false;

    // The sidebar's places, only those that exist here (filebrowser.rs `places`). Empty until
    // the shell has looked, when the standard four are drawn so the sidebar is never blank.
    in property <[FilePlaceData]> places: [];
    property <[FilePlaceData]> standard-places: [
        {id: "home", label: "Home", path: "~"},
        {id: "documents", label: "Documents", path: "~/Documents"},
        {id: "downloads", label: "Downloads", path: "~/Downloads"},
        {id: "pictures", label: "Pictures", path: "~/Pictures"}
    ];
    // The folder's most recently changed files, newest first, for the row under the grid.
    in property <[FileRecentData]> recent: [];

    // AI features
    in property <string> ai-summary: "";
    in property <bool> is-summarizing: false;
    in property <string> dir-type-badge: "";
    callback request-summarize();
    callback request-ask-ai();

    // Multi-select
    in-out property <int> selection-count: 0;
    in property <string> selection-size-text: "";
    callback multi-select-clicked(int, bool, bool);  // index, ctrl-held, shift-held
    callback select-all();
    callback clear-selection();
    callback delete-selected();
    callback copy-selected();
    callback cut-selected();

    // Detail panel toggle
    in-out property <bool> detail-panel-visible: false;

    // Context menu
    property <bool> show-context-menu: false;
    // Where the menu opens. Lengths, not ints: these are a position on screen, and the menu was
    // ignoring them entirely and opening in the middle of the window instead.
    property <length> context-menu-x: 0;
    property <length> context-menu-y: 0;
    property <int> context-menu-index: -1;
    callback context-copy-path(string);
    callback context-open-terminal();
    callback context-compress(string);

    // Create new file
    callback create-file(string);

    // Dialog state
    property <bool> show-rename-dialog: false;
    property <string> rename-old-name: "";
    property <string> rename-new-name: "";
    property <bool> show-delete-dialog: false;
    property <string> delete-target-name: "";
    property <bool> show-new-folder-dialog: false;
    property <string> new-folder-name: "";
    property <bool> show-new-file-dialog: false;
    property <string> new-file-name: "";
    property <bool> show-summary-dialog: false;

    callback navigate-dir(string);
    callback open-file(string);
    callback go-up();
    callback go-back();
    callback go-forward();
    callback navigate-to-path(string);
    callback toggle-hidden();
    callback file-delete(string);
    callback file-rename(string, string);
    callback file-copy(string);
    callback file-cut(string);
    callback file-paste();
    callback create-folder(string);
    callback file-selection-changed(string);
    callback file-sort-changed(string, bool);
    callback file-filter-changed(string);

    // Tab management
    in property <[FileTabData]> file-tabs: [];
    in property <int> file-active-tab: 0;
    callback file-new-tab();
    callback file-close-tab(int);
    callback file-switch-tab(int);

    // File operations queue
    in property <[FileOpItem]> file-op-queue: [];
    in-out property <bool> file-op-queue-visible: false;

    // Batch rename
    in-out property <bool> file-batch-rename-open: false;
    in-out property <string> file-batch-rename-pattern: "";
    in-out property <string> file-batch-rename-replace: "";
    callback file-batch-rename-execute();

    // Quick Look
    in-out property <bool> file-quick-look-open: false;
    in property <string> file-quick-look-content: "";
    in property <string> file-quick-look-name: "";
    callback file-quick-look(int);
    callback file-close-quick-look();

    // Trash
    in-out property <bool> file-trash-mode: false;
    in property <int> file-trash-count: 0;
    callback file-toggle-trash();
    callback file-empty-trash();
    callback file-restore-from-trash(int);

    // Sort state
    property <string> sort-field: "name";
    property <bool> sort-ascending: true;

    // Search state
    property <bool> search-active: false;
    property <string> search-text: "";

    // Address bar state
    property <bool> address-editing: false;

    // Helper: sort order display text
    pure function sort-order-text() -> string {
        if root.sort-field == "name" && root.sort-ascending { return "Name A-Z"; }
        if root.sort-field == "name" && !root.sort-ascending { return "Name Z-A"; }
        if root.sort-field == "size" && root.sort-ascending { return "Size (small first)"; }
        if root.sort-field == "size" && !root.sort-ascending { return "Size (large first)"; }
        if root.sort-field == "modified" && root.sort-ascending { return "Oldest first"; }
        if root.sort-field == "modified" && !root.sort-ascending { return "Newest first"; }
        return "Name A-Z";
    }

    in property <string> notice;
    // When the notice is about something just created (files.rs `set_notice`), these carry
    // its name and whether it is a folder, so the footer can offer Open and Rename for it.
    in property <string> notice-created: "";
    in property <bool> notice-created-dir: false;
    in property <bool> operation-busy;
    in property <string> operation-text;
    in property <float> operation-progress;
    in property <bool> can-undo;
    // The dialog panel's height, mirrored out so the ui-preview checks can see that a
    // naming dialog hugs its contents instead of holding the old fixed height with an
    // empty band in it. The dialog lives inside an `if`, so it reports its own height
    // from a changed handler instead of being referenced from out here.
    out property <length> dialog-height: 0px;
    callback refresh();
    callback cancel-operation();
    callback undo-trash();
    callback open-with(string);
    // "Always use this app": the desktop id and the name on screen, so the notice that says
    // it was remembered can use the same words as the row that was clicked (#233).
    callback open-with-always(string, string);
    // Asked for the list behind the "Open with" menu, which is rebuilt per opening.
    callback open-with-requested();
    // The apps offered for the selected file, first row the one a double-click uses (#233).
    in property <[OpenWithItem]> open-with-apps: [];
    callback dismiss-notice();
    property <bool> ctrl-held;
    property <bool> shift-held;
    property <string> dialog-kind;
    property <string> dialog-value;
    property <string> dialog-old;
    property <bool> open-with-visible;
    // The grid's cell: large enough for a folder drawn at 62px with two lines under it.
    property <length> tile-w: 160px;
    property <length> tile-h: 148px;
    property <int> columns: max(1, floor(list-area.width / root.tile-w));
    // The grid's tile rows; the recent strip, when it shows, rides along as one more row.
    property <int> grid-rows: ceil(root.entries.length / root.columns);
    // How many recent files fit across the row under the grid.
    property <length> recent-card-w: 214px;
    // The width the listing gets, worked out from the screen's own width rather than read
    // back from list-area: anything inside list-area's layout that sized itself from
    // list-area.width would be a binding loop (its width is what the layout is solving for).
    property <length> content-w: root.width
        - (root.width >= 900px ? 200px : root.width >= 620px ? 140px : 0px)
        - (root.detail-panel-visible && root.width >= 1050px && root.selected-index >= 0 ? 250px : 0px);
    property <int> recent-fit: max(1, floor((root.content-w - 32px + 10px) / (root.recent-card-w + 10px)));
    property <bool> show-recent: root.grid-view && !root.file-trash-mode && !root.is-loading
        && root.search-text == "" && root.recent.length > 0 && root.entries.length > 0;
    property <string> selected-name: root.selected-index >= 0 && root.selected-index < root.entries.length ? root.entries[root.selected-index].name : "";
    public function focus-list() { listing.focus(); }
    function open-selected() {
        if root.selected-index >= 0 && !root.file-trash-mode {
            if root.entries[root.selected-index].is-dir { root.navigate-dir(root.selected-name); }
            else { root.open-file(root.selected-name); }
        }
    }
    function command(id: string) {
        if id == "new-folder" { root.dialog-kind = "New folder"; root.dialog-value = ""; }
        else if id == "new-file" { root.dialog-kind = "New file"; root.dialog-value = ""; }
        else if id == "rename" && root.selected-name != "" { root.dialog-kind = "Rename"; root.dialog-old = root.selected-name; root.dialog-value = root.selected-name; }
        else if id == "copy" { root.copy-selected(); }
        else if id == "copy-path" { root.context-copy-path(root.selected-name); }
        else if id == "cut" { root.cut-selected(); }
        else if id == "paste" { root.file-paste(); }
        else if id == "trash" { root.delete-selected(); }
        else if id == "preview" && root.selected-index >= 0 { root.file-quick-look(root.selected-index); }
        else if id == "details" { root.detail-panel-visible = !root.detail-panel-visible; if root.detail-panel-visible { root.file-selection-changed(root.selected-name); } }
        else if id == "terminal" { root.context-open-terminal(); }
        else if id == "refresh" { root.refresh(); }
        else if id == "hidden" { root.toggle-hidden(); }
        else if id == "new-tab" { root.file-new-tab(); }
        else if id == "open-with" { root.open-with-requested(); root.open-with-visible = true; }
        else if id == "restore" { root.file-restore-from-trash(root.selected-index); }
        else if id == "empty-trash" { root.dialog-kind = "Empty Trash"; }
    }
    function submit-dialog() {
        if root.dialog-kind == "New folder" { root.create-folder(root.dialog-value); }
        else if root.dialog-kind == "New file" { root.create-file(root.dialog-value); }
        else if root.dialog-kind == "Rename" { root.file-rename(root.dialog-old, root.dialog-value); }
        else if root.dialog-kind == "Empty Trash" { root.file-empty-trash(); }
        root.dialog-kind = ""; listing.focus();
    }
    function reveal-selection() {
        if root.selected-index < 0 { return; }
        if root.grid-view {
            let y = floor(root.selected-index / root.columns) * root.tile-h;
            if y + grid-list.viewport-y < 0px { grid-list.viewport-y = -y; }
            if y + root.tile-h + grid-list.viewport-y > grid-list.visible-height { grid-list.viewport-y = grid-list.visible-height - y - root.tile-h; }
        } else {
            let y = root.selected-index * 46px;
            if y + list-view.viewport-y < 0px { list-view.viewport-y = -y; }
            if y + 46px + list-view.viewport-y > list-view.visible-height { list-view.viewport-y = list-view.visible-height - y - 46px; }
        }
    }
    changed selected-index => { root.reveal-selection(); }
    changed grid-view => { root.reveal-selection(); }
    changed is-loading => { if !root.is-loading { listing.focus(); } }
    changed current-path => { root.search-text = ""; }
    init => { AppIdentity.id = "files"; listing.focus(); }
    background: Theme.bg-deep;
    min-width: 0px; min-height: 0px;
    preferred-width: 0px; preferred-height: 0px;
    horizontal-stretch: 1; vertical-stretch: 1;
    FocusScope {
        enabled: root.dialog-kind == "" && !root.file-quick-look-open && !root.open-with-visible;
        capture-key-pressed(e) => {
            root.ctrl-held = e.modifiers.control; root.shift-held = e.modifiers.shift;
            if e.modifiers.control && (e.text == "l" || e.text == "L") { root.address-editing = true; return accept; }
            if e.modifiers.control && (e.text == "f" || e.text == "F") { search-input.focus(); return accept; }
            if e.modifiers.alt && e.text == Key.LeftArrow { root.go-back(); return accept; }
            if e.modifiers.alt && e.text == Key.RightArrow { root.go-forward(); return accept; }
            if e.modifiers.alt && e.text == Key.UpArrow { root.go-up(); return accept; }
            if e.text == Key.F5 { root.refresh(); return accept; }
            if e.text == Key.Escape {
                root.address-editing = false; root.show-context-menu = false;
                if root.search-text != "" { root.search-text = ""; root.file-filter-changed(""); }
                listing.focus(); return accept;
            }
            reject
        }
        key-released(e) => { root.ctrl-held = e.modifiers.control; root.shift-held = e.modifiers.shift; reject }
        VerticalLayout {
            spacing: 0px;
            AppHeader {
                app-id: "files"; title: "Files"; icon: Icons.files;
                subtitle: root.file-trash-mode ? "Recover deleted items" : root.dir-type-badge != "" ? root.dir-type-badge : "Your files, in place";
                actions: [
                    {id: root.file-trash-mode ? "empty-trash" : "new-folder", label: root.file-trash-mode ? "Empty Trash" : "New folder", icon: root.file-trash-mode ? Icons.trash : Icons.plus, emphasis: 2, disabled: root.operation-busy || root.is-loading || (root.file-trash-mode && root.entries.length == 0)},
                    {id: "preview", label: "Preview", icon: Icons.eye, disabled: root.selected-index < 0 || root.file-trash-mode},
                    {id: "new-file", label: "New file", icon: Icons.file, disabled: root.file-trash-mode || root.operation-busy},
                    {id: "new-tab", label: "New tab", icon: Icons.plus, disabled: root.file-trash-mode || root.file-tabs.length >= 8},
                    {separator: true},
                    {id: "copy", label: "Copy", icon: Icons.copy, disabled: root.selection-count == 0 || root.file-trash-mode},
                    {id: "copy-path", label: "Copy path", icon: Icons.link, disabled: root.selection-count != 1 || root.file-trash-mode},
                    {id: "cut", label: "Cut", icon: Icons.arrow-right, disabled: root.selection-count == 0 || root.file-trash-mode},
                    {id: "paste", label: "Paste", icon: Icons.clipboard, disabled: !root.has-clipboard || root.operation-busy || root.file-trash-mode},
                    {id: "rename", label: "Rename", icon: Icons.editor, disabled: root.selection-count != 1 || root.operation-busy || root.file-trash-mode},
                    {id: "trash", label: "Move to Trash", icon: Icons.trash, disabled: root.selection-count == 0 || root.operation-busy || root.file-trash-mode},
                    {id: "open-with", label: "Open with…", icon: Icons.link, disabled: root.selection-count != 1 || root.file-trash-mode},
                    {separator: true},
                    {id: "details", label: "Details", icon: Icons.file, active: root.detail-panel-visible, disabled: root.selected-index < 0 || root.file-trash-mode},
                    {id: "hidden", label: "Show hidden files", icon: Icons.eye, active: root.show-hidden},
                    {id: "terminal", label: "Open Terminal here", icon: Icons.terminal, disabled: root.file-trash-mode},
                    {id: "refresh", label: "Refresh", icon: Icons.refresh}
                ];
                action(id) => { root.command(id); }
            }
            if root.file-tabs.length > 1 : Rectangle {
                height: 36px; background: Theme.bg-surface;
                HorizontalLayout { padding-left: 10px; spacing: 3px; alignment: start;
                    for tab[index] in root.file-tabs : Rectangle {
                        width: min(180px, (root.width - 20px) / root.file-tabs.length); height: 36px;
                        background: tab.is-active ? Theme.bg-deep : transparent;
                        TouchArea { clicked => { root.file-switch-tab(index); listing.focus(); } }
                        Text { x: 12px; width: parent.width - 42px; height: parent.height; vertical-alignment: center; text: tab.label; color: tab.is-active ? Theme.text-primary : Theme.text-secondary; font-size: 12px; overflow: elide; }
                        YButton { x: parent.width - 27px; y: 5px; width: 24px; height: 24px; icon-only: true; label: "Close tab"; icon-path: Icons.close; variant: 2; size: 0; clicked => { root.file-close-tab(index); } }
                        Rectangle { y: parent.height - 2px; height: 2px; background: tab.is-active ? Theme.accent : transparent; }
                    }
                }
            }
            // ── Toolbar: history, the breadcrumb, search, and the view switch ──
            Rectangle {
                height: 54px; background: Theme.bg-surface;
                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
                HorizontalLayout { padding: 10px; spacing: 5px;
                    YButton { label: "Back"; icon-path: Icons.arrow-left; icon-only: true; variant: 2; disabled: !root.can-go-back || root.file-trash-mode; clicked => { root.go-back(); } }
                    YButton { label: "Forward"; icon-path: Icons.arrow-right; icon-only: true; variant: 2; disabled: !root.can-go-forward || root.file-trash-mode; clicked => { root.go-forward(); } }
                    YButton { label: "Parent folder"; icon-path: Icons.arrow-up; icon-only: true; variant: 2; disabled: root.file-trash-mode || root.current-path == "/"; clicked => { root.go-up(); } }
                    Rectangle { width: 6px; }
                    path-area := Rectangle { horizontal-stretch: 1; min-width: 80px; clip: true;
                        if root.address-editing : YInput { init => { self.focus(); } value: root.current-path; placeholder: "Enter a folder path"; accepted(path) => { root.navigate-to-path(path); root.address-editing = false; listing.focus(); } }
                        // The breadcrumb: Home › Documents › Reports. The last three steps
                        // (one when narrow), each as wide as its name up to a cap; the steps
                        // before them are hidden rather than squeezed into unreadable stubs.
                        if !root.address-editing : HorizontalLayout { spacing: 0px; alignment: start;
                            for crumb[index] in root.breadcrumbs : Crumb {
                                property <int> keep: root.width < 800px ? 1 : 3;
                                property <int> count: root.breadcrumbs.length;
                                property <bool> shown: index >= self.count - self.keep;
                                visible: self.shown;
                                width: self.shown ? min(170px, self.natural) : 0px;
                                label: crumb.label;
                                first: index == max(0, self.count - self.keep);
                                current: index == self.count - 1;
                                disabled: root.file-trash-mode;
                                clicked => { root.navigate-to-path(crumb.full-path); }
                            }
                            YButton { width: 28px; label: "Edit location · Ctrl L"; icon-path: Icons.pencil; icon-only: true; variant: 2; size: 0; disabled: root.file-trash-mode; clicked => { root.address-editing = true; } }
                        }
                    }
                    search-input := YInput { width: root.width >= 1000px ? 240px : 180px; mode: 1; value <=> root.search-text; placeholder: "Search this folder"; edited(text) => { root.file-filter-changed(text); } }
                    // Grid or list, as a two-way switch so the current one is visible.
                    Rectangle {
                        width: 70px; height: 32px;
                        border-radius: Theme.r-md;
                        background: Theme.bg-input;
                        border-width: 1px; border-color: Theme.border-default;
                        HorizontalLayout { padding: 2px; spacing: 4px; padding-left: 3px;
                            ViewToggle { icon: Icons.grid; label: "Grid view"; active: root.grid-view; y: 2px; clicked => { root.grid-view = true; listing.focus(); } }
                            ViewToggle { icon: Icons.list; label: "List view"; active: !root.grid-view; y: 2px; clicked => { root.grid-view = false; listing.focus(); } }
                        }
                    }
                }
            }
            // Notices and the running operation used to be bands here, above the listing.
            // Each band appearing pushed the whole grid down under the pointer, so the next
            // double-click landed on the neighbour tile (issue #208). They live in the
            // footer now, which never changes height.
            HorizontalLayout { spacing: 0px;
                // ── Places ──
                if root.width >= 620px : Rectangle {
                    width: root.width >= 900px ? 200px : 140px; background: Theme.bg-surface;
                    Rectangle { x: parent.width - 1px; width: 1px; background: Theme.border-subtle; }
                    VerticalLayout { padding: 10px; padding-top: 12px; spacing: 2px;
                        for place in (root.places.length > 0 ? root.places : root.standard-places) : FilePlace {
                            label: place.label; icon: FileText.place-icon(place.id);
                            active: root.current-path == place.path && !root.file-trash-mode;
                            clicked => { root.navigate-to-path(place.path); listing.focus(); }
                        }
                        Rectangle { height: 12px; }
                        FilePlace { label: "File system"; icon: Icons.disk; active: root.current-path == "/" && !root.file-trash-mode; clicked => { root.navigate-to-path("/"); listing.focus(); } }
                        FilePlace { label: "Trash"; icon: Icons.trash; active: root.file-trash-mode; clicked => { if !root.file-trash-mode { root.file-toggle-trash(); } } }
                        Rectangle { vertical-stretch: 1; }
                        Text { text: root.free-space-text; color: Theme.text-dim; font-size: 11px; overflow: elide; height: 28px; vertical-alignment: center; }
                    }
                }
                list-area := Rectangle {
                    horizontal-stretch: 1; min-width: 0px; background: Theme.bg-deep;
                    VerticalLayout { spacing: 0px;
                        // ── The folder's name, what it holds, and how it is sorted ──
                        Rectangle { height: 56px;
                            HorizontalLayout { padding-left: 20px; padding-right: 12px; spacing: 6px;
                                VerticalLayout { alignment: center; spacing: 1px; horizontal-stretch: 1; min-width: 0px;
                                    Text { text: root.file-trash-mode ? "Trash" : root.breadcrumbs.length > 0 ? root.breadcrumbs[root.breadcrumbs.length - 1].label : "Files"; font-size: 20px; font-weight: 600; color: Theme.text-primary; overflow: elide; }
                                    Text {
                                        text: root.is-loading ? "Reading…"
                                            : root.selection-count > 0 ? root.selection-size-text != "" ? root.selection-size-text : "\{root.selection-count} selected"
                                            : root.entries.length == 1 ? "1 item" : "\{root.entries.length} items";
                                        color: Theme.text-secondary; font-size: 12px; overflow: elide;
                                    }
                                }
                                if root.selection-count > 0 && !root.file-trash-mode : YButton { y: 14px; label: "Copy"; icon-path: Icons.copy; icon-only: root.width < 950px; size: 0; variant: 2; clicked => { root.copy-selected(); } }
                                if root.selection-count > 0 && !root.file-trash-mode : YButton { y: 14px; label: "Move to Trash"; icon-path: Icons.trash; icon-only: true; size: 0; variant: 2; disabled: root.operation-busy; clicked => { root.delete-selected(); } }
                                if root.selection-count > 0 : YButton { y: 14px; label: "Clear selection"; icon-path: Icons.close; icon-only: true; size: 0; variant: 2; clicked => { root.clear-selection(); listing.focus(); } }
                                if root.file-trash-mode : YButton { y: 14px; label: "Restore"; size: 0; variant: 1; disabled: root.selection-count != 1 || root.operation-busy; clicked => { root.command("restore"); } }
                                if root.file-trash-mode && root.width >= 900px : YButton { y: 14px; label: "Empty Trash"; size: 0; variant: 2; disabled: root.entries.length == 0 || root.operation-busy; clicked => { root.command("empty-trash"); } }
                                if !root.file-trash-mode : YButton { y: 14px; label: root.sort-field == "name" ? "Name" : root.sort-field == "size" ? "Size" : "Modified"; icon-path: Icons.sort; size: 0; variant: 2; clicked => { root.sort-field = root.sort-field == "name" ? "size" : root.sort-field == "size" ? "modified" : "name"; root.file-sort-changed(root.sort-field, root.sort-ascending); } }
                                if !root.file-trash-mode : YButton { y: 14px; label: "Reverse sort order"; icon-path: root.sort-ascending ? Icons.arrow-up : Icons.arrow-down; icon-only: true; size: 0; variant: 2; clicked => { root.sort-ascending = !root.sort-ascending; root.file-sort-changed(root.sort-field, root.sort-ascending); } }
                            }
                        }
                        // ── Column heads, in the list ──
                        if !root.grid-view && !root.is-loading && root.entries.length > 0 : Rectangle { height: 30px;
                            Rectangle { x: 16px; width: parent.width - 32px; y: parent.height - 1px; height: 1px; background: Theme.border-subtle; }
                            HorizontalLayout { padding-left: 20px; padding-right: 20px; spacing: 14px;
                                Rectangle { width: 24px; }
                                Text { text: "Name"; color: Theme.text-dim; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; vertical-alignment: center; horizontal-stretch: 1; }
                                if root.content-w >= 420px : Text { text: "Items · Size"; color: Theme.text-dim; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; width: 96px; vertical-alignment: center; horizontal-alignment: right; }
                                if root.content-w >= 680px : Text { text: root.file-trash-mode ? "Where" : "Changed"; color: Theme.text-dim; font-size: 11px; font-weight: 600; letter-spacing: 0.4px; width: 88px; vertical-alignment: center; horizontal-alignment: right; }
                            }
                        }
                        listing := FocusScope {
                            enabled: !root.is-loading;
                            vertical-stretch: 1;
                            key-pressed(e) => {
                                if e.modifiers.control && (e.text == "a" || e.text == "A") { root.select-all(); return accept; }
                                if e.modifiers.control && (e.text == "c" || e.text == "C") && !root.file-trash-mode { root.copy-selected(); return accept; }
                                if e.modifiers.control && (e.text == "x" || e.text == "X") && !root.file-trash-mode { root.cut-selected(); return accept; }
                                if e.modifiers.control && (e.text == "v" || e.text == "V") && !root.file-trash-mode { root.file-paste(); return accept; }
                                if e.modifiers.control && (e.text == "t" || e.text == "T") { root.file-new-tab(); return accept; }
                                if e.modifiers.control && (e.text == "w" || e.text == "W") { root.file-close-tab(root.file-active-tab); return accept; }
                                if e.text == Key.F2 && root.selection-count == 1 { root.command("rename"); return accept; }
                                if e.text == Key.Delete && !root.file-trash-mode { root.delete-selected(); return accept; }
                                if e.text == Key.Return { root.open-selected(); return accept; }
                                if e.text == " " && root.selected-index >= 0 { root.file-quick-look(root.selected-index); return accept; }
                                if root.entries.length > 0 && (e.text == Key.DownArrow || e.text == Key.UpArrow || e.text == Key.LeftArrow || e.text == Key.RightArrow || e.text == Key.Home || e.text == Key.End) {
                                    let delta = e.text == Key.UpArrow ? -(root.grid-view ? root.columns : 1) : e.text == Key.DownArrow ? (root.grid-view ? root.columns : 1) : e.text == Key.LeftArrow ? -1 : 1;
                                    let next = e.text == Key.Home ? 0 : e.text == Key.End ? root.entries.length - 1 : max(0, min(root.entries.length - 1, root.selected-index + delta));
                                    root.multi-select-clicked(next, false, e.modifiers.shift); root.reveal-selection(); return accept;
                                }
                                reject
                            }
                            list-view := ListView {
                                visible: !root.is-loading && !root.grid-view;
                                for entry[index] in (root.grid-view || root.is-loading ? [] : root.entries) : FileRow {
                                    entry: entry; height: 46px; trash: root.file-trash-mode;
                                    selected: entry.selected; focused: listing.has-focus && index == root.selected-index;
                                    clicked => { listing.focus(); root.multi-select-clicked(index, root.ctrl-held, root.shift-held); }
                                    activate => { root.selected-index = index; root.open-selected(); }
                                    context => { root.multi-select-clicked(index, false, false); root.open-with-requested(); root.open-with-visible = true; }
                                }
                            }
                            // The recent strip is the grid's last row, so the two scroll as
                            // one: outside the scroll area it took a fixed 104px off the
                            // viewport and cut the third row's labels in half on a 1280x800
                            // screen (issue #208). The grid stays a ListView — only the rows
                            // on screen are built, which matters in folders like /usr/lib
                            // with thousands of entries — and a ListView accepts only a
                            // single `for`, so the strip is one more row of it, taller than
                            // a tile row, rather than a second child.
                            grid-list := ListView {
                                visible: !root.is-loading && root.grid-view;
                                for row in (root.grid-view && !root.is-loading ? root.grid-rows + (root.show-recent ? 1 : 0) : 0) : Rectangle {
                                    height: row < root.grid-rows ? root.tile-h : 104px;
                                    if row < root.grid-rows : HorizontalLayout { spacing: 0px; alignment: start;
                                        for col in root.columns : cell := Rectangle {
                                            width: list-area.width / root.columns; height: root.tile-h;
                                            property <int> index: row * root.columns + col;
                                            if cell.index < root.entries.length : FileTile {
                                                x: 5px; y: 4px; width: parent.width - 10px; height: parent.height - 8px;
                                                entry: root.entries[cell.index]; trash: root.file-trash-mode;
                                                focused: listing.has-focus && cell.index == root.selected-index;
                                                clicked => { listing.focus(); root.multi-select-clicked(cell.index, root.ctrl-held, root.shift-held); }
                                                activate => { root.selected-index = cell.index; root.open-selected(); }
                                            }
                                        }
                                    }
                                    // ── Recent: the files in this folder that changed last ──
                                    //
                                    // Under the grid and scrolling with it, as the design has
                                    // it. Real files by their real times (filebrowser.rs
                                    // `most_recent`); hidden while a search narrows the view,
                                    // in Trash, and when the folder holds no files at all.
                                    if row >= root.grid-rows : Rectangle {
                                        width: 100%; height: 100%;
                                        Rectangle { x: 16px; width: parent.width - 32px; y: 0px; height: 1px; background: Theme.border-subtle; }
                                        VerticalLayout { padding-left: 16px; padding-right: 16px; padding-top: 12px; padding-bottom: 14px; spacing: 10px;
                                            Text { text: "Recent in this folder"; color: Theme.text-secondary; font-size: 12px; font-weight: 600; }
                                            HorizontalLayout { spacing: 10px; alignment: start;
                                                for file[i] in root.recent : RecentCard {
                                                    visible: i < root.recent-fit;
                                                    width: i < root.recent-fit ? root.recent-card-w : 0px;
                                                    file: file;
                                                    activate => { root.open-file(file.name); }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                            if root.is-loading || root.entries.length == 0 : YEmptyState {
                                icon-path: root.is-loading ? Icons.folder : root.file-trash-mode ? Icons.trash : root.search-text != "" ? Icons.search : Icons.folder;
                                title: root.is-loading ? "Opening folder…" : root.search-text != "" ? "No matching files" : root.file-trash-mode ? "Trash is empty" : "This folder is empty";
                                description: root.is-loading ? "Reading this folder’s contents." : root.search-text != "" ? "Try another name. Search stays in this folder." : root.file-trash-mode ? "Items moved to Trash can be restored here." : "Create a folder or paste files to get started.";
                            }
                        }
                    }
                }
                if root.detail-panel-visible && root.width >= 1050px && root.selected-index >= 0 : Rectangle {
                    width: 250px; background: Theme.bg-surface;
                    VerticalLayout { padding: 18px; spacing: 12px;
                        HorizontalLayout { Text { text: "Details"; color: Theme.text-primary; font-size: 14px; font-weight: 600; horizontal-stretch: 1; } YButton { label: "Close details"; icon-path: Icons.close; icon-only: true; variant: 2; size: 0; clicked => { root.detail-panel-visible = false; } } }
                        Icon { commands: Icons.file-kind(root.file-details.icon-char); size: 42px; tint: Theme.accent; }
                        Text { text: root.file-details.name; color: Theme.text-primary; font-size: 17px; font-weight: 600; wrap: word-wrap; }
                        Text { text: root.file-details.file-type + "\n" + root.file-details.size-text + "\n" + root.file-details.modified-text; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
                        Text { text: root.file-details.path-text; color: Theme.text-dim; font-size: 12px; wrap: word-wrap; }
                        YButton { label: "Open preview"; icon-path: Icons.eye; variant: 1; clicked => { root.file-quick-look(root.selected-index); } }
                        HorizontalLayout { spacing: 5px;
                            YButton { label: "Summarize"; icon-path: Icons.spark; size: 0; variant: 1; disabled: root.is-summarizing || !root.file-details.is-text-file; clicked => { root.request-summarize(); } }
                            YButton { label: "Ask AI"; size: 0; variant: 2; disabled: root.is-summarizing || !root.file-details.is-text-file; clicked => { root.request-ask-ai(); } }
                        }
                        if root.is-summarizing || root.ai-summary != "" : Flickable {
                            min-height: 80px; vertical-stretch: 1; viewport-width: self.width; viewport-height: answer.preferred-height;
                            answer := Text { width: parent.width; text: root.ai-summary != "" ? root.ai-summary : "Thinking…"; color: Theme.text-secondary; font-size: 12px; wrap: word-wrap; }
                        }
                        if !root.is-summarizing && root.ai-summary == "" : Rectangle { vertical-stretch: 1; }
                    }
                }
            }
            // ── Footer ──
            //
            // One line that never changes height: the running operation, else any notice,
            // else the plain status. A notice about something just created names it and
            // offers Open and Rename (issue #208) — they act on `notice-created`, which the
            // Rust side sets together with the message.
            Rectangle {
                height: 30px; background: Theme.bg-surface;
                if root.operation-busy : Rectangle { y: 0px; height: 2px; width: max(4px, parent.width * root.operation-progress); background: Theme.accent; }
                if root.operation-busy : HorizontalLayout {
                    padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Text { text: root.operation-text; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                    YButton { label: "Cancel"; variant: 1; size: 0; clicked => { root.cancel-operation(); } }
                }
                if !root.operation-busy && root.notice != "" : HorizontalLayout {
                    padding-left: 16px; padding-right: 8px; spacing: 8px;
                    Text { text: root.notice; color: Theme.text-primary; font-size: 11px; vertical-alignment: center; horizontal-stretch: 1; min-width: 0px; overflow: elide; }
                    if root.notice-created != "" : YButton { label: "Open"; variant: 1; size: 0; clicked => {
                        if root.notice-created-dir { root.navigate-dir(root.notice-created); }
                        else { root.open-file(root.notice-created); }
                    } }
                    if root.notice-created != "" : YButton { label: "Rename"; variant: 2; size: 0; clicked => {
                        root.dialog-kind = "Rename"; root.dialog-old = root.notice-created; root.dialog-value = root.notice-created;
                    } }
                    if root.can-undo : YButton { label: "Undo trash"; variant: 1; size: 0; disabled: root.operation-busy; clicked => { root.undo-trash(); } }
                    YButton { label: "Dismiss message"; icon-path: Icons.close; icon-only: true; variant: 2; size: 0; clicked => { root.dismiss-notice(); } }
                }
                if !root.operation-busy && root.notice == "" : HorizontalLayout {
                    padding-left: 16px; padding-right: 16px; spacing: 16px;
                    Text { text: root.is-loading ? "Loading…" : "\{root.entries.length} items"; color: Theme.text-secondary; font-size: 11px; vertical-alignment: center; }
                    Text { text: root.selection-count > 0 ? root.selection-size-text : root.current-path; color: Theme.text-dim; font-size: 11px; overflow: elide; vertical-alignment: center; horizontal-stretch: 1; }
                    if root.width >= 850px : Text { text: "Enter  Open   ·   Space  Preview   ·   Ctrl L  Location"; color: Theme.text-dim; font-size: 11px; vertical-alignment: center; }
                }
            }
        }
    }
    if root.dialog-kind != "" || root.file-quick-look-open || root.open-with-visible : FocusScope {
        key-pressed(e) => { if e.text == Key.Escape { root.dialog-kind = ""; root.file-close-quick-look(); root.open-with-visible = false; listing.focus(); return accept; } reject }
        Rectangle { background: #00000088; TouchArea {} }
        dlg := Rectangle {
            width: root.file-quick-look-open ? min(680px, root.width - 48px) : min(430px, root.width - 48px);
            // Sized to what it holds. A fixed 200px left the layout slack, and the layout
            // spent it stretching the title's cell: the empty band between "New folder" and
            // the name field (issue #208). The body layout's preferred height already counts
            // its padding, its spacing and whichever of the conditional rows are showing.
            height: root.file-quick-look-open ? min(480px, root.height - 48px)
                // The "Open with" list has as many rows as this machine has apps for the
                // type, so the dialog hugs the rows it actually got, up to the screen (#233).
                : root.open-with-visible ? min(dlg-body.preferred-height, root.height - 48px)
                : dlg-body.preferred-height;
            changed height => { root.dialog-height = self.height; }
            x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
            background: Theme.bg-elevated; border-radius: 12px; border-width: 1px; border-color: Theme.border-strong;
            dlg-body := VerticalLayout { padding: 20px; spacing: 14px;
                Text { text: root.file-quick-look-open ? root.file-quick-look-name : root.open-with-visible ? root.selected-name : root.dialog-kind; color: Theme.text-primary; font-size: 18px; font-weight: 600; overflow: elide; }
                if root.dialog-kind != "" && root.dialog-kind != "Empty Trash" : YInput { init => { self.focus(); } value <=> root.dialog-value; placeholder: "Name"; accepted(_) => { if root.dialog-value != "" { root.submit-dialog(); } } }
                if root.dialog-kind == "Empty Trash" : Text { text: "Permanently remove all items in Trash? This cannot be undone."; color: Theme.text-secondary; font-size: 13px; wrap: word-wrap; }
                if root.file-quick-look-open : Flickable { viewport-width: self.width; viewport-height: preview.preferred-height;
                    preview := Text { width: parent.width; text: root.file-quick-look-content; color: Theme.text-secondary; font-family: Theme.font-mono; font-size: 13px; wrap: word-wrap; }
                }
                if root.open-with-visible : VerticalLayout { spacing: 8px;
                    // The apps this machine has for the selected file, the one a double-click
                    // uses first and marked as it. Folders and the Trash get no list, so they
                    // get the empty state instead of a row that cannot launch (#233).
                    if root.open-with-apps.length == 0 : Text { text: "No app is offered for this item."; color: Theme.text-secondary; font-size: 13px; wrap: word-wrap; }
                    for app[index] in root.open-with-apps : HorizontalLayout { spacing: 8px;
                        YButton {
                            init => { if index == 0 { self.focus(); } }
                            label: app.is-default ? "Open with " + app.name + " (default)" : "Open with " + app.name;
                            icon-path: Icons.link; variant: 1; horizontal-stretch: 1;
                            clicked => { root.open-with-visible = false; root.open-with(app.id); }
                        }
                        YButton { label: "Always use"; variant: 2; size: 0; disabled: root.file-trash-mode;
                            clicked => { root.open-with-visible = false; root.open-with-always(app.id, app.name); } }
                    }
                    YButton { label: "Rename"; icon-path: Icons.editor; variant: 2; disabled: root.file-trash-mode || root.operation-busy; clicked => { root.open-with-visible = false; root.command("rename"); } }
                    YButton { label: "Move to Trash"; icon-path: Icons.trash; variant: 2; disabled: root.file-trash-mode || root.operation-busy; clicked => { root.open-with-visible = false; root.delete-selected(); } }
                }
                HorizontalLayout { alignment: end; spacing: 8px;
                    YButton { init => { if root.file-quick-look-open || root.dialog-kind == "Empty Trash" { self.focus(); } } label: root.file-quick-look-open || root.open-with-visible ? "Close" : "Cancel"; variant: 2; clicked => { root.dialog-kind = ""; root.file-close-quick-look(); root.open-with-visible = false; listing.focus(); } }
                    if root.dialog-kind != "" : YButton { label: root.dialog-kind == "Empty Trash" ? "Empty Trash" : root.dialog-kind == "Rename" ? "Rename" : "Create"; variant: root.dialog-kind == "Empty Trash" ? 3 : 0; disabled: root.dialog-kind != "Empty Trash" && root.dialog-value == ""; clicked => { root.submit-dialog(); } }
                }
            }
        }
    }
}
