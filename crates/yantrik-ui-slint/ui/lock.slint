// Lock Screen — the shell's own lock screen: the wallpaper, a large clock, who is locked in,
// the field, and a quiet status line. Shown on idle timeout or manual lock (Super+L) where the
// compositor has no session lock; with one, `yantrik-lock` draws the same picture on the
// compositor's surfaces (#313) and this is the fallback. The picture is `YLockView` in the kit;
// this file owns only how keys reach it.
//
// It asks for what lock.rs checks — the login password, or the PIN on an account without one
// (#414) — and says so in `prompt-text`, set by the shell: a label fixed in markup once asked for
// one secret while another was checked (#215).
//
// Nothing here moves. The breathing glows this screen used to draw are gone with the photograph:
// the lock screen is what is on the glass whenever the machine is idle, and a window that draws
// nothing between clock ticks asks for no frames at all.

import { Theme } from "theme.slint";
import { YLockView } from "components/lock_view.slint";

export component LockScreen inherits Rectangle {
    background: Theme.lock-ground;

    in property <string> clock-text: "00:00";
    in property <string> date-text: "";
    in property <string> user-name: "";
    in property <string> initial: "";
    in property <string> error-text: "";
    in property <string> prompt-text: "";
    in property <image> wallpaper;
    in property <bool> has-wallpaper: false;
    in property <string> network-text: "";
    in property <int> battery-percent: -1;
    in property <bool> battery-charging: false;
    in property <int> notification-count: 0;
    in property <bool> can-restart: true;

    callback try-unlock(string);
    callback suspend();
    callback restart();
    callback shutdown();

    // Beneath the picture, so a click on the picture's buttons reaches them: a FocusScope laid
    // over it took the click for itself, and the eye, the arrow and the power buttons never
    // heard it. Any key press hands the keyboard to the input below. (That first key is spent
    // on the handing over, as it always was; the input is not focused from the start because a
    // focused text input blinks its cursor, and this screen is what is up while nobody is here.)
    FocusScope {
        init => { self.focus(); }
        key-pressed(event) => {
            pin-input.focus();
            accept
        }
    }

    YLockView {
        width: 100%;
        height: 100%;
        wallpaper: root.wallpaper;
        has-wallpaper: root.has-wallpaper;
        clock-text: root.clock-text;
        date-text: root.date-text;
        user-name: root.user-name;
        initial: root.initial;
        prompt-text: root.prompt-text;
        error-text: root.error-text;
        // The field the view draws is a picture of this one: dots for what was typed, the text
        // itself only while the eye is open.
        digits: pin-input.text.character-count;
        revealed-text: pin-input.text;
        network-text: root.network-text;
        battery-percent: root.battery-percent;
        battery-charging: root.battery-charging;
        notification-count: root.notification-count;
        can-restart: root.can-restart;
        submit => {
            root.try-unlock(pin-input.text);
            pin-input.text = "";
        }
        suspend => { root.suspend(); }
        restart => { root.restart(); }
        shutdown => { root.shutdown(); }
    }

    // The real input. It takes the keys and holds the text; the view above only draws it, so it
    // is made not to show: no colour (a text cursor takes its colour from the text's) and a
    // 1px face, so what is left of a cursor is a transparent dot. Merely clipping it or fading it
    // was not enough: the software renderer still painted its cursor, a white line, at the top
    // left of the screen, and `visible: false` stops it taking keys at all.
    pin-input := TextInput {
        x: 0;
        y: 0;
        width: 1px;
        height: 2px;
        color: transparent;
        font-size: 1px;
        input-type: InputType.password;
        accepted => {
            root.try-unlock(self.text);
            self.text = "";
        }
    }
}
