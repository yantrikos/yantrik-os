// Yantrik Design System — Calm Graphite
// "A quiet, precise desktop OS with an always-available intelligence layer."
// Supports dark (default) and light modes via ThemeMode.dark toggle.
// Community themes can override key tokens via ThemeOverrides global.
// Accent color presets via AccentPreset global (index-based).

// ─── Typefaces ────────────────────────────────────────────────────────
// Embedded so every window — shell and apps — renders the same face on any box. Barlow for
// UI text (three weights, normalised into one family), JetBrains Mono for anything tabular.
// Windows opt in with `default-font-family: Theme.font-ui;`.
import "fonts/Barlow-Regular.ttf";
import "fonts/Barlow-Medium.ttf";
import "fonts/Barlow-SemiBold.ttf";
import "fonts/JetBrainsMono-Regular.ttf";
import "fonts/JetBrainsMono-Medium.ttf";

export global ThemeMode {
    in-out property <bool> dark: true;
}

// Accent color presets — index selects which accent palette is active.
// 0 = soft blue (default), 1 = amber, 2 = purple, 3 = green, 4 = pink
//
// Crisp, not louder (desk-and-mind, "bright and sharp"). Each preset keeps its hue and gains
// saturation: the old cyan #4ecdc4 sat at 56% saturation, which on a near-black ground reads as
// a pastel wash rather than an edge. The light-mode values stay dark enough to carry white text
// on a primary button (the cyan is 5.5:1 against #ffffff, up from 5.2).
export global AccentPreset {
    in-out property <int> index: 0;

    // The dark-theme value of each preset, once. `accent` below and the Settings swatches both
    // read these, so the picker cannot show one colour and apply another (it did, #583).
    out property <color> swatch-0: #8fb4e3;
    out property <color> swatch-1: #f2b73e;
    out property <color> swatch-2: #b98aef;
    out property <color> swatch-3: #5ede78;
    out property <color> swatch-4: #f27aa0;

    // Resolved accent colors — reactive to index + dark mode.
    out property <color> accent:
        index == 0 ? (ThemeMode.dark ? swatch-0 : #2b64a8)   // soft blue, the system accent
      : index == 1 ? (ThemeMode.dark ? swatch-1 : #8f6512)   // amber
      : index == 2 ? (ThemeMode.dark ? swatch-2 : #7338b4)   // purple
      : index == 3 ? (ThemeMode.dark ? swatch-3 : #1f7d30)   // green
      :               (ThemeMode.dark ? swatch-4 : #bd3563);  // pink

    out property <color> accent-light:
        index == 0 ? (ThemeMode.dark ? #a9c5ec : #4a82c2)
      : index == 1 ? (ThemeMode.dark ? #f6cd75 : #b88838)
      : index == 2 ? (ThemeMode.dark ? #d0a8f6 : #9060c8)
      : index == 3 ? (ThemeMode.dark ? #8eeba2 : #48a858)
      :               (ThemeMode.dark ? #f69cbb : #d06080);

    out property <color> accent-dim:
        index == 0 ? (ThemeMode.dark ? #6f95c4 : #9dbbe0)
      : index == 1 ? (ThemeMode.dark ? #a87c28 : #c8a860)
      : index == 2 ? (ThemeMode.dark ? #7c4fae : #b090d0)
      : index == 3 ? (ThemeMode.dark ? #33854a : #80c090)
      :               (ThemeMode.dark ? #aa4570 : #d898b0);

    out property <color> accent-glow:
        index == 0 ? (ThemeMode.dark ? #8fb4e340 : #2b64a830)
      : index == 1 ? (ThemeMode.dark ? #f2b73e40 : #8f651230)
      : index == 2 ? (ThemeMode.dark ? #b98aef40 : #7338b430)
      : index == 3 ? (ThemeMode.dark ? #5ede7840 : #1f7d3030)
      :               (ThemeMode.dark ? #f27aa040 : #bd356330);

    out property <color> accent-glow-strong:
        index == 0 ? (ThemeMode.dark ? #8fb4e370 : #2b64a850)
      : index == 1 ? (ThemeMode.dark ? #f2b73e70 : #8f651250)
      : index == 2 ? (ThemeMode.dark ? #b98aef70 : #7338b450)
      : index == 3 ? (ThemeMode.dark ? #5ede7870 : #1f7d3050)
      :               (ThemeMode.dark ? #f27aa070 : #bd356350);

    out property <color> tint:
        index == 0 ? (ThemeMode.dark ? #8fb4e31c : #2b64a817)
      : index == 1 ? (ThemeMode.dark ? #f2b73e1c : #8f651217)
      : index == 2 ? (ThemeMode.dark ? #b98aef1c : #7338b417)
      : index == 3 ? (ThemeMode.dark ? #5ede781c : #1f7d3017)
      :               (ThemeMode.dark ? #f27aa01c : #bd356317);

    // Label for current accent (for settings display)
    out property <string> label:
        index == 0 ? "Soft blue"
      : index == 1 ? "Amber"
      : index == 2 ? "Purple"
      : index == 3 ? "Green"
      :              "Pink";
}

// Community theme overrides — set from ~/.config/yantrik/theme-override.yaml.
// When enabled, these override the 10 key color tokens in Theme.
export global ThemeOverrides {
    in-out property <bool> enabled: false;
    // The defaults a theme file falls back to for any key it leaves out: the stock palette.
    in-out property <color> bg-deep-override:     #0e1117;
    in-out property <color> bg-surface-override:   #161b23;
    in-out property <color> bg-card-override:      #212937;
    in-out property <color> bg-elevated-override:  #2c3545;
    in-out property <color> amber-override:        #d4a574;
    in-out property <color> cyan-override:         #38d8cd;
    in-out property <color> text-primary-override: #f4f6fa;
    in-out property <color> text-secondary-override: #c0c8d6;
    in-out property <color> text-dim-override:     #95a1b4;
    in-out property <color> accent-override:       #8fb4e3;
}

// The person's "reduce motion" choice. Components that move something across the screen (a
// popover arriving, an OSD sliding) read `Theme.dur-pop` and friends, which collapse to 0ms
// while this is on; hover and focus colour fades are not motion in that sense and stay.
// The shell sets it from the system setting; nothing here animates on a timer either way.
export global MotionPrefs {
    in-out property <bool> reduced: false;
}

// ─── Bright and sharp (design/desk-and-mind-2026-09-23.md, section 1) ─────
//
// The desktop read muddy: grey text on grey cards on a grey ground, each step a few percent
// from the next, so nothing had an edge. The pass that fixed it changed values here, not call
// sites, and every name below still answers exactly as before:
//
//   * Text. Primary is near-white (#f4f6fa, 13.5:1 on a card, was 12.5), secondary is a clear
//     light grey rather than a mid one (#c0c8d6, 8.7:1, was 6.8), dim stays readable for
//     metadata (#95a1b4, 5.6:1, was 5.1). Light mode mirrors it: near-black (18.9:1 on white),
//     then two readable greys that are actually two (8.4:1 and 5.7:1; they were 6.0 and 5.9,
//     the same grey twice).
//   * Surfaces. The ground went a step deeper and the card a step lighter, so a card sits OFF
//     the background instead of on it.
//   * Hairlines. A card or panel carries a one-pixel border a little lighter than itself
//     (`border-card`), the edge that catches the light. Lighter, because a border darker than
//     its fill reads as a hole rather than a pane.
//   * One radius scale (below), with the legacy names pointed into it.
//   * The accent is the same hue, more saturated (AccentPreset).
//
// No blur anywhere: Slint has none and the VM renders in software. Panels over the wallpaper
// stay the glass tokens below, an alpha blend over a wallpaper that is already soft; see the
// Glass section.
export global Theme {
    // ─── Surface hierarchy (4-tier depth) ─────────────────────────
    // base → default → raised → floating
    // Each tier a clear step in luminance for depth without blur.
    out property <color> bg-deep:     ThemeOverrides.enabled ? ThemeOverrides.bg-deep-override
        : (ThemeMode.dark ? #0e1117 : #eef1f6);
    out property <color> bg-surface:  ThemeOverrides.enabled ? ThemeOverrides.bg-surface-override
        : (ThemeMode.dark ? #161b23 : #e6eaf1);
    out property <color> bg-card:     ThemeOverrides.enabled ? ThemeOverrides.bg-card-override
        : (ThemeMode.dark ? #212937 : #ffffff);
    out property <color> bg-elevated: ThemeOverrides.enabled ? ThemeOverrides.bg-elevated-override
        : (ThemeMode.dark ? #2c3545 : #ffffff);
    out property <color> bg-input:    ThemeMode.dark ? #10141b : #f5f7fa;
    out property <color> bg-selected: ThemeMode.dark ? #243a52 : #dce7f7;

    // ─── Glass ────────────────────────────────────────────────────
    //
    // Surfaces that sit OVER the wallpaper rather than replacing it.
    //
    // Every panel on this desktop used an opaque fill, so the desktop was a flat plane with
    // rectangles painted on it and the wallpaper was scenery you could only see between them.
    // These are the same colours with alpha, which on a software rasteriser costs one blend —
    // real backdrop blur would cost a full-screen filter per frame, and this OS already fought
    // its idle cost from 9.7% of a core down to 2.1%. The softness lives in the wallpaper PNG
    // instead, blurred once at render time.
    //
    // Light mode stays nearly opaque on purpose: white glass over a photograph is haze, not
    // depth, and the text on it has to stay readable.
    //
    // Bright and sharp raised the opacity a notch (c8 → d6 on a card): at the old value a
    // bright stretch of wallpaper came through far enough to pull white text down to the
    // contrast of grey on grey. A pre-blurred copy of the wallpaper behind each panel was
    // considered and not done: it needs a decoder and blur in the shell (no `image` crate
    // here), a full-screen RGBA copy in memory per wallpaper, and every glass panel tracking
    // its own screen position to crop it — for a wallpaper that is already soft.
    out property <color> glass-card:    ThemeMode.dark ? #212937d6 : #fffffff2;
    out property <color> glass-panel:   ThemeMode.dark ? #161b23e0 : #f8f9fcf0;
    out property <color> glass-raised:  ThemeMode.dark ? #2c3545dc : #fffffff5;
    // The hairline that gives a glass edge its shape. Slightly lighter than the fill, because
    // a border darker than what it contains reads as a hole rather than a pane.
    // The two full-height rails. More transparent than a card, because they are the only
    // surfaces large enough for the wallpaper behind them to read as a scene rather than as a
    // sliver -- and because what they hold is labels and numbers, which stay legible over a
    // pre-blurred photograph in a way a paragraph would not.
    out property <color> glass-rail:    ThemeMode.dark ? #12151ca8 : #f4f5f8ef;
    out property <color> glass-border:  ThemeMode.dark ? #ffffff21 : #0000001a;
    out property <color> glass-border-strong: ThemeMode.dark ? #ffffff36 : #00000026;

    // ─── Amber palette ────────────────────────────────────────────
    out property <color> amber:             ThemeOverrides.enabled ? ThemeOverrides.amber-override
        : (ThemeMode.dark ? #d4a574 : #8a6030);
    out property <color> amber-light:       ThemeMode.dark ? #e8c496 : #a07840;
    out property <color> amber-dim:         ThemeMode.dark ? #a07a50 : #c4a070;
    out property <color> amber-glow:        ThemeMode.dark ? #d4a57450 : #d4a57430;
    out property <color> amber-glow-strong: ThemeMode.dark ? #d4a574a0 : #d4a57460;

    // ─── Mind teal ────────────────────────────────────────────────
    // Marks a mind and its presence, and nothing else: not selection, not success, not the
    // person's accent. Fixed, so a mind reads the same whichever accent preset is chosen
    // (design/minds-surfaces-spec-2026-10-02.md, "Colour roles"). Amber, above, is the other
    // half of the rule: a response from the person is pending.
    out property <color> mind:              ThemeMode.dark ? #69c8bc : #1d7a70;

    // ─── Cyan palette ─────────────────────────────────────────────
    // The same crisp cyan as the default accent: most of what reads "cyan" here is the accent
    // written before AccentPreset existed, and the two must not drift apart.
    out property <color> cyan:             ThemeOverrides.enabled ? ThemeOverrides.cyan-override
        : (ThemeMode.dark ? #38d8cd : #08747e);
    out property <color> cyan-light:       ThemeMode.dark ? #74e6de : #3aa9b4;
    out property <color> cyan-dim:         ThemeMode.dark ? #1fa89b : #80c8d0;
    out property <color> cyan-glow:        ThemeMode.dark ? #38d8cd40 : #08747e30;
    out property <color> cyan-glow-strong: ThemeMode.dark ? #38d8cd70 : #08747e50;

    // ─── Holographic blue palette (kept for legacy, alias to accent) ──
    out property <color> holo-blue:       ThemeOverrides.enabled ? ThemeOverrides.accent-override
        : (ThemeMode.dark ? #4ab8f0 : #2080c0);
    out property <color> holo-blue-light: ThemeMode.dark ? #6ed0ff : #50a0d0;
    out property <color> holo-blue-dim:   ThemeMode.dark ? #2a7ab0 : #80c0e0;
    out property <color> holo-blue-glow:  ThemeMode.dark ? #4ab8f040 : #4ab8f030;
    out property <color> holo-core:       ThemeMode.dark ? #80e0ff : #40b0d0;
    out property <color> holo-edge:       ThemeMode.dark ? #2060a030 : #2060a018;

    // ─── Accent palette (resolved from AccentPreset) ──────────────
    out property <color> accent:             AccentPreset.accent;
    out property <color> accent-light:       AccentPreset.accent-light;
    out property <color> accent-dim:         AccentPreset.accent-dim;
    out property <color> accent-glow:        AccentPreset.accent-glow;
    out property <color> accent-glow-strong: AccentPreset.accent-glow-strong;
    out property <color> tint-accent:        AccentPreset.tint;

    // ─── Semantic status colors ───────────────────────────────────
    out property <color> color-success:      ThemeMode.dark ? #26a69a : #2e7d32;
    out property <color> color-success-dim:  ThemeMode.dark ? #26a69a28 : #2e7d3220;
    out property <color> color-danger:       ThemeMode.dark ? #ef9a9a : #c62828;
    // The destructive button's fill: the one red, for what cannot be undone (delete, erase,
    // power off). A filled button, so it is a stronger red than color-danger, which is a text
    // and badge colour. White label on it in both themes.
    out property <color> destructive:        #e5484d;
    out property <color> text-on-destructive: #ffffff;
    out property <color> destructive-hover:  #ec6064;
    out property <color> destructive-pressed: #c93a3f;
    out property <color> color-danger-dim:   ThemeMode.dark ? #ef9a9a28 : #c6282820;
    // The close button's hover fill, with white on it. Deliberately the same in both themes:
    // it is not a surface that adapts, it is the one colour in the OS that means "this
    // discards what is on screen", and every desktop agrees on it.
    //
    // config/labwc/themerc carries this same value for the compositor's own titlebars. If it
    // changes here it changes there; there is no import between Slint and a themerc.
    out property <color> color-close-hover:  #e05263;
    out property <color> color-warning:      ThemeMode.dark ? #ffb74d : #e65100;
    out property <color> color-warning-dim:  ThemeMode.dark ? #ffb74d28 : #e6510020;
    out property <color> color-purple:       ThemeMode.dark ? #b084e0 : #7840b0;
    out property <color> color-purple-dim:   ThemeMode.dark ? #b084e028 : #7840b020;

    // Text on colored backgrounds (accent buttons, status badges)
    out property <color> text-on-accent: ThemeMode.dark ? #0e1215 : #ffffff;
    out property <color> accent-button-hover: ThemeMode.dark ? Theme.accent-light : Theme.accent.darker(8%);
    out property <color> accent-button-pressed: ThemeMode.dark ? Theme.accent-dim : Theme.accent.darker(16%);

    // AI/overlay panel background
    out property <color> bg-overlay-panel: ThemeMode.dark ? #1a2230 : #e8eef4;

    // ─── Instinct colors ──────────────────────────────────────────
    out property <color> color-pattern:   ThemeMode.dark ? #c48bd4 : #9040a0;
    out property <color> color-reminder:  ThemeMode.dark ? #8be86b : #40a020;
    out property <color> color-emotional: ThemeMode.dark ? #e86b6b : #c04040;
    out property <color> color-check-in:  ThemeMode.dark ? #d4a03c : #a07020;
    out property <color> color-follow-up: ThemeMode.dark ? #6bb8e8 : #2080b0;
    out property <color> color-conflict:  ThemeMode.dark ? #e8a06b : #c07030;

    // ─── Text hierarchy ───────────────────────────────────────────
    // Primary near-white, secondary a clear light grey, dim for metadata — every one readable
    // on bg-card, which is where text mostly sits (ratios in the note above Theme).
    out property <color> text-primary:   ThemeOverrides.enabled ? ThemeOverrides.text-primary-override
        : (ThemeMode.dark ? #f4f6fa : #0e1116);
    out property <color> text-secondary: ThemeOverrides.enabled ? ThemeOverrides.text-secondary-override
        : (ThemeMode.dark ? #c0c8d6 : #444e5e);
    out property <color> text-dim:       ThemeOverrides.enabled ? ThemeOverrides.text-dim-override
        : (ThemeMode.dark ? #95a1b4 : #5c6778);

    // ─── Borders & overlays ───────────────────────────────────────
    out property <color> overlay-backdrop:  ThemeMode.dark ? #00000060 : #00000030;
    out property <color> overlay-shadow:    ThemeMode.dark ? #00000080 : #00000040;
    // border-subtle is what a hundred and fifty cards across the apps already draw their edge
    // with, so it is where the hairline had to land for them to get one: at 3.5% white it was
    // there in the markup and invisible on screen. Now 7%, visible as an edge and still quiet as
    // a divider inside a list.
    out property <color> border-subtle:     ThemeMode.dark ? #ffffff12 : #0000000f;
    out property <color> border-default:    ThemeMode.dark ? #ffffff1a : #00000017;
    out property <color> border-strong:     ThemeMode.dark ? #ffffff29 : #00000024;
    // The hairline on a card or a panel drawn from now on: one pixel, a little lighter than the
    // surface it edges, so the surface has an outline in dark mode and a crisp rim in light
    // mode. New with bright-and-sharp.
    out property <color> border-card:       ThemeMode.dark ? #ffffff1f : #00000017;
    // The solid charcoal of a panel that must read cleanly over any wallpaper: opaque, so
    // nothing behind it shows through the text. The key cheat sheet is the first; a key cap is a
    // small raised chip on it.
    out property <color> panel-solid:       ThemeMode.dark ? #151a1e : #ffffff;
    out property <color> keycap-fill:       ThemeMode.dark ? #1f262c : #eef1f5;
    out property <color> keycap-border:     ThemeMode.dark ? #ffffff24 : #0000001f;
    out property <color> separator:         ThemeMode.dark ? #ffffff0e : #0000000f;
    out property <color> hover-fill:        ThemeMode.dark ? #ffffff0a : #0000000a;
    out property <color> hover-fill-strong: ThemeMode.dark ? #ffffff14 : #00000012;
    out property <color> tint-cyan:         ThemeMode.dark ? #38d8cd1c : #08747e17;
    out property <color> tint-amber:        ThemeMode.dark ? #d4a57414 : #b0784014;

    // ─── Typefaces ────────────────────────────────────────────────
    out property <string> font-ui: "Barlow";
    out property <string> font-mono: "JetBrains Mono";

    // ─── Typography scale ─────────────────────────────────────────
    // 6 named roles: display, heading, body, label, caption, micro
    // Legacy aliases (kept for backward compatibility)
    out property <length> font-page-title: 20px;
    out property <length> font-body: 14px;
    out property <length> font-small: 12px;
    out property <length> font-title: 16px;
    out property <length> font-label: 13px;
    out property <length> font-caption: 11px;
    out property <length> font-logo: 20px;
    out property <length> font-boot: 35px;

    // V63 — 6-role typography scale (tuned for 1080p)
    //
    // fs-hero is the one moment this OS raises its voice: the greeting on the desktop. The
    // scale topped out at 20px, which is a panel title, so there was no size available for
    // "say one thing, large, and nothing else near it" — and a desktop whose largest text is
    // the same size as a section header has no focal point at all.
    out property <length> fs-hero: 44px;
    out property <int>    fw-hero: 600;
    out property <length> fs-hero-sub: 17px;
    out property <int>    fw-hero-sub: 400;
    out property <length> fs-page: 24px;         // A screen's own title: Agents, History
    out property <length> fs-display: 20px;      // Panel titles, major headers
    out property <int>    fw-display: 600;
    out property <length> fs-title-1: 18px;      // App titles, large section headers
    out property <int>    fw-title-1: 600;
    out property <length> fs-title-2: 16px;      // Sub-section headers
    out property <int>    fw-title-2: 600;
    out property <length> fs-headline: 15px;     // Toolbar titles, emphasized text
    out property <int>    fw-headline: 600;
    out property <length> fs-body: 14px;         // Primary UI text
    out property <int>    fw-body: 400;
    out property <length> fs-body-strong: 14px;  // Emphasized body text, buttons
    out property <int>    fw-body-strong: 500;
    out property <length> fs-caption: 12px;      // Status bar, metadata, timestamps
    out property <int>    fw-caption: 400;
    out property <length> fs-micro: 11px;        // Badges, fine detail
    out property <int>    fw-micro: 500;
    out property <length> fs-mono: 13px;         // Terminal, code, IDs

    // ─── Spacing scale (8px base grid) ────────────────────────────
    out property <length> sp-1: 4px;
    out property <length> sp-2: 8px;
    out property <length> sp-3: 12px;
    out property <length> sp-4: 16px;
    out property <length> sp-5: 20px;
    out property <length> sp-6: 24px;
    out property <length> sp-7: 32px;
    out property <length> sp-8: 40px;
    out property <length> sp-9: 48px;

    // Half-steps between the spacing scale's rungs, for the few places a layout sits between two
    // of them (a badge's inset, a row's gap). Prefer sp-1 to sp-9; reach for these only to keep
    // an existing look.
    out property <length> sp-half: 2px;
    out property <length> sp-1h: 6px;
    out property <length> sp-2h: 10px;
    out property <length> sp-3h: 14px;

    // Touch targets
    out property <length> touch-target: 44px;

    // ─── Radius scale ─────────────────────────────────────────────
    //
    // ONE scale. Five steps, and every radius in the kit is one of them:
    //
    //   r-xs   4px   marks inside a control: a tab underline, a chip, a checkbox
    //   r-sm   6px   badges, small controls, a list row's highlight
    //   r-md   8px   buttons, inputs, menu rows, sidebar items
    //   r-lg  12px   cards, panels, tiles, dialogs
    //   r-xl  16px   windows, the launcher, modals, the command palette
    //
    // The legacy names point into it rather than holding numbers of their own, so they can no
    // longer drift from it. An app icon tile is not on the scale on purpose: its radius is a
    // fraction of its size (AppTile), because a 20px taskbar tile and a 46px desktop tile have
    // to be the same SHAPE, and one length cannot give both.
    //
    // Standard radius scale
    out property <length> r-xs: 4px;
    out property <length> r-sm: 6px;
    out property <length> r-md: 8px;
    out property <length> r-lg: 12px;
    out property <length> r-xl: 16px;
    // Legacy aliases (kept for backward compatibility)
    out property <length> radius-bubble: root.r-xl;
    out property <length> radius-card: root.r-lg;
    out property <length> radius-pill: root.r-xl;
    out property <length> radius-round: 50px;
    // A stadium is `self.height / 2`, written at the element. Do NOT use a constant for it.
    //
    // This was 999px, on the CSS assumption that an over-large radius clamps to half the
    // height. Slint's software renderer does not clamp: it draws the corner arcs at the radius
    // given, and on a wide, short element they overshoot and cross, which turns a search field
    // into a pointed lens. That is what the Downloads search box looked like, and the same
    // token was on thirty-five other controls waiting to do it.
    out property <length> r-pill: 999px;

    // ─── Motion tokens ────────────────────────────────────────────
    // fast = hover/focus, base = panel/state, slow = modal/large
    out property <duration> dur-fast: 120ms;
    out property <duration> dur-normal: 200ms;
    out property <duration> dur-slow: 300ms;
    // A popover or other moving surface arriving: dur-fast, or nothing under reduce-motion.
    out property <duration> dur-pop: MotionPrefs.reduced ? 0ms : root.dur-fast;
    // How long the pointer rests on a bar indicator before its tooltip appears.
    out property <duration> dur-tooltip: 600ms;
    // The one curve for things that arrive: quick out of the blocks, long soft landing. Use it
    // as `easing: Theme.ease-standard;` on any animate that moves or reveals something.
    out property <easing> ease-standard: cubic-bezier(0.2, 0.0, 0.0, 1.0);

    // ─── Control height tokens ────────────────────────────────────
    out property <length> h-compact: 28px;
    out property <length> h-regular: 32px;
    out property <length> h-prominent: 36px;

    // The app header. One number, because every app wears the same frame: AppFrame in the UI
    // kit reads it, and nothing else is allowed to decide how tall an app's top edge is. It was
    // 28, 32, 36, 44, 48, 56 and 64 across sixteen apps when each of them drew its own.
    out property <length> h-app-header: 48px;

    // ─── Desktop layout sizes ─────────────────────────────────────
    out property <length> status-bar-height: 36px;
    /// The bar along the bottom of the screen.
    ///
    /// Written as a bare `40px` in fifteen places — the taskbar itself and every maximised
    /// window's height arithmetic — and NOT written at all in the one place that needed it
    /// most: the Intent Lens ran the full height of the screen, so the taskbar covered its
    /// chat input and the status bar covered its header. A chrome dimension that is not a
    /// token is a dimension the next panel will forget to subtract.
    ///
    /// The grounded dock (design/minds-surfaces-spec §3) is this tall, flush with the bottom edge,
    /// and config/labwc/rc.xml reserves exactly this much (`<margin bottom>`). Change one, change
    /// both: the compositor keeps maximised windows above it by that number alone.
    out property <length> taskbar-height: 48px;
    out property <length> orb-desktop-size: 80px;

    // ─── The grounded dock (spec §3) ──────────────────────────────
    // Sizes. 48px = 4px padding + a 40px button + 4px padding.
    out property <length> dock-button: 40px;
    out property <length> dock-pad: 4px;
    out property <length> dock-gap: 4px;
    out property <length> dock-icon: 24px;       // the tile inside a button: spec §3, "40×40 buttons with 24px icons"
    out property <length> dock-pager-w: 32px;
    out property <length> dock-max-w: 880px;     // min(this, viewport - dock-side-margin)
    out property <length> dock-side-margin: 32px;
    out property <length> dock-marker-w: 12px;
    out property <length> dock-marker-h: 3px;
    out property <length> dock-dot: 6px;         // the needs-you dot on the mind button
    out property <length> dock-list-w: 320px;
    out property <length> dock-list-row: 56px;
    out property <length> dock-list-max-h: 400px;
    out property <length> dock-label-h: 28px;      // the hover label
    out property <length> dock-list-head: 40px;    // the window list's header
    out property <length> dock-numeral: 14px;      // the several-windows count plate
    out property <length> dock-desk-strip: 12px;   // the show-desktop corner
    out property <length> dock-divider-inset: 8px;
    out property <length> dock-check: 16px;
    out property <float> dock-tile-radius-ratio: 0.26;
    out property <float> dock-mind-glyph-ratio: 0.6;
    out property <length> dock-label-gap: 8px;   // a label or a list opens this far above the dock
    // Delays, written out in grounded_dock.slint too: the idle-window test reads a Timer's rate from its
    // text and cannot resolve a token.
    out property <duration> dock-label-delay: 500ms;
    out property <duration> dock-list-delay: 250ms;
    // Colours (shared contract, 2 Oct). Neutral surfaces first; the only two hues in the dock are
    // the mind's teal and the amber of "a person's response is pending".
    out property <color> dock-bar:        ThemeMode.dark ? #101417 : #eef1f3;
    out property <color> dock-border:     ThemeMode.dark ? #343B41 : #c9d0d5;
    out property <color> dock-raised:     ThemeMode.dark ? #1E252B : #ffffff;       // focused / hovered button
    out property <color> dock-raised-line: ThemeMode.dark ? #2C343B : #d5dbe0;
    out property <color> dock-marker:     ThemeMode.dark ? #ffffff : #1b2126;       // running: static, white
    out property <color> dock-popover:    ThemeMode.dark ? #151A1E : #ffffff;       // opaque panel for labels and the list
    out property <color> mind-teal:       #69C8BC;   // minds and their presence, nothing else
    out property <color> mind-teal-ink:   #0c1a18;   // the glyph on the teal tile
    out property <color> needs-you:       #E7B567;   // a person's response is pending, nothing else

    // Intent Lens
    out property <length> lens-width: 640px;
    out property <length> lens-input-height: 48px;
    out property <length> lens-result-height: 44px;

    // Chat side panel (Chat v2, design/minds-surfaces-spec-2026-10-02.md §1)
    //
    // 440px by default; the person can drag its left edge between the two bounds. The panel is
    // opaque charcoal because it holds paragraphs and a decision, and anything showing through
    // it makes both harder to read (design/ui-review-gpt6-astra-2026-10-02.md, rule 1).
    out property <length> chat-panel-width: 440px;
    out property <length> chat-panel-min: 380px;
    out property <length> chat-panel-max: 560px;
    out property <length> chat-panel-gap: 12px;
    out property <length> chat-header-height: 64px;
    out property <length> chat-strip-height: 48px;
    out property <length> chat-radius: 16px;
    // The panel, its bars and insets, its border, and the two colours with a meaning: teal is a
    // mind (never a selection or a success), amber is "your answer is waiting" (nothing else).
    out property <color> chat-panel:     ThemeMode.dark ? #151a1e : #f6f7f8;
    out property <color> chat-bar:       ThemeMode.dark ? #101417 : #eceef0;
    out property <color> chat-border:    ThemeMode.dark ? #343b41 : #cdd2d6;
    out property <color> chat-text:      ThemeMode.dark ? #f2f4f5 : #151a1e;
    out property <color> chat-text-2:    ThemeMode.dark ? #a8b0b6 : #4d565c;
    out property <color> chat-mind:      ThemeMode.dark ? #69c8bc : #1f7f74;
    out property <color> chat-needs-you: ThemeMode.dark ? #e7b567 : #9a6a14;
    // A person's message: a light bubble with dark text, in either mode.
    out property <color> chat-user-bubble: ThemeMode.dark ? #f2f4f5 : #20272c;
    out property <color> chat-user-text:   ThemeMode.dark ? #151a1e : #f2f4f5;
    out property <color> chat-raised:    ThemeMode.dark ? #1d2429 : #ffffff;

    // ─── Kit controls: slider, popover, toggle tile, bar indicator ─
    // Sizes. Each is the one number the control draws with, so a later screen that has to line
    // something up with a slider's thumb or a tile's edge reads it here instead of guessing.
    //
    // The glyph size for every icon that lives on the top/bottom bar (YIndicator).
    out property <length> bar-icon-size: 18px;
    // The attention dot on a bar indicator (a thing here needs a look).
    out property <length> bar-dot: 7px;
    // The top bar (render 01): an opaque #101417 strip, 36px tall, with a 1px neutral edge under it.
    // The same two colours as the dock, because they are one family of chrome.
    out property <color> bar-bg:     root.dock-bar;
    out property <color> bar-border: root.dock-border;
    // The gap between neighbours on the bar's right: indicators, the mode chip, Quick Settings.
    out property <length> bar-gap: 8px;
    // The Minds chip and the mode chip: 24px tall, a pill-ish corner, a 6px dot.
    out property <length> bar-chip-h: 24px;
    out property <length> bar-chip-radius: 6px;
    out property <length> bar-chip-dot: 6px;
    // Today (the clock's popover) is wider than a list popover: it holds a month.
    out property <length> today-width: 380px;
    out property <length> today-cell-h: 30px;
    // A popover (Quick Settings, Sound, Network, Today) is this wide, and sits this far from
    // what opened it and from the screen edge. The radius is the window/modal step of the scale.
    out property <length> popover-width: 360px;
    out property <length> popover-radius: root.r-xl;
    out property <length> popover-gap: root.sp-2;
    out property <length> popover-margin: root.sp-2;
    // Slider: a 6px track under an 18px thumb. The halo is the soft ring that appears around the
    // thumb on hover and while dragging; it is 5px proud of the thumb on every side.
    out property <length> slider-track-h: 6px;
    out property <length> slider-thumb: 18px;
    out property <length> slider-halo: 28px;
    // Toggle tile (Wi-Fi, Bluetooth, Night light ...).
    out property <length> tile-h: 56px;
    // On-screen display (volume, brightness, mic, Caps Lock): a 240x64 pill, centred, 80px above
    // the taskbar. Opaque charcoal in both modes, because it floats over whatever is on screen,
    // a photograph or a white document, and has to read the same on either.
    out property <length> osd-w: 240px;
    out property <length> osd-h: 64px;
    out property <length> osd-gap: 80px;
    out property <color> osd-bg: #151a1e;
    out property <color> osd-border: #ffffff1f;
    out property <color> osd-text: #f4f6fa;
    out property <color> osd-track: #ffffff26;
    // Window overview (Super+Tab card): cell, footer, icon sizes, the card's and plate's widest
    // size, the plate's height, and the card widths below which it draws three and two columns.
    out property <length> sw-cell-w: 224px;
    out property <length> sw-footer-h: 41px;
    out property <length> sw-icon-lg: 40px;
    out property <length> sw-icon-sm: 18px;
    out property <length> sw-card-max-w: 1040px;
    out property <length> sw-plate-max-w: 720px;
    out property <length> sw-plate-h: 40px;
    out property <length> sw-cols-3-below: 760px;
    out property <length> sw-cols-2-below: 560px;
    // Agents workroom (agents*.slint). The spec's numbers (design/minds-surfaces-spec-2026-10-02.md
    // section 2) live here so a density or scale change reaches every screen of it at once.
    // Marks: the mind's disc at four sizes.
    out property <length> wr-mark-xs: 18px;
    out property <length> wr-mark-s: 22px;
    out property <length> wr-mark-m: 24px;
    out property <length> wr-mark-l: 28px;
    // The mind mark's inner dot, as a fraction of the mark.
    out property <float>  wr-mark-core: 0.36;
    out property <float>  wr-mark-ring-div: 12;     // the ring is size / this, at least the focus ring
    out property <length> wr-glyph: 14px;           // small line icon beside text
    out property <length> wr-fade-h: 14px;          // the "more below" fade under a scrolling list
    out property <length> wr-dot-gap: 3px;          // gap between a run's progress dots; scrollbar width
    // Nav: a mind's row, a section row, the indent of a mind's sub-rows, the count badge.
    out property <length> wr-nav-row-h: 64px;
    out property <length> wr-nav-item-h: 40px;
    out property <length> wr-nav-indent: 52px;
    out property <length> wr-badge-h: 20px;
    // Decision shelf and desks.
    out property <length> wr-shelf-card-h: 84px;
    out property <length> wr-header-h: 44px;        // a desk's header; the screen's header row
    out property <length> wr-row-h: 56px;
    out property <length> wr-desk-min-w: 320px;
    out property <length> wr-desk-h: 248px;
    out property <length> wr-desk-preview-h: 104px;
    out property <length> wr-desk-line-h: 48px;
    out property <length> wr-desk-acts-h: 52px;
    // Start-work sheet and task detail.
    out property <length> wr-sheet-w: 480px;
    out property <length> wr-detail-w: 440px;
    out property <length> wr-task-field-h: 120px;
    out property <length> wr-role-row-h: 50px;
    out property <length> wr-roles-max-h: 200px;
    out property <length> wr-btn-w: 120px;
    out property <length> wr-btn-w-wide: 140px;
    // One-pixel edge of a control, and the stroke weights an icon is drawn with (regular beside
    // text, a touch heavier on a filled tile where it sits on the accent).
    out property <length> hairline: 1px;
    out property <length> icon-stroke: 1.6px;
    out property <length> icon-stroke-bold: 1.7px;
    // Three drop-shadow depths for things that float: a thumb, a tooltip, a popover.
    out property <length> shadow-sm-blur: 3px;
    out property <length> shadow-sm-dy: 1px;
    out property <length> shadow-md-blur: 8px;
    out property <length> shadow-md-dy: 2px;
    out property <length> shadow-lg-blur: 24px;
    out property <length> shadow-lg-dy: 6px;
    // The keyboard-focus ring on a control that has no border of its own to thicken.
    out property <length> focus-ring-width: 2px;
    out property <color> focus-ring: ThemeMode.dark ? #f4f6fa : #0e1116;
    // The groove behind a slider fill. Stronger than border-strong so an empty track still reads
    // on a popover (bg-elevated) in both themes.
    out property <color> track-bg: ThemeMode.dark ? #343b41 : #00000026;
    // The slider thumb: the one near-white surface in the kit, so it reads as a thing you hold.
    out property <color> knob: ThemeMode.dark ? #f4f6fa : #ffffff;
    out property <color> knob-border: ThemeMode.dark ? #00000040 : #00000030;
    // A toggle tile that is off, then a step lighter on hover and press (neutral steps, not new
    // colours).
    // (Pranab, 2 Oct: tiles disappeared into the panels.) An opaque tile one step lighter than
    // the #151A1E panel it sits on, with its own 1px border, so it stands out from the panel.
    out property <color> tile-off:         ThemeMode.dark ? #1e252b : #e6eaef;
    out property <color> tile-off-hover:   ThemeMode.dark ? #262e35 : #dce1e7;
    out property <color> tile-off-pressed: ThemeMode.dark ? #2d363e : #d2d8df;
    out property <color> tile-border:      ThemeMode.dark ? #2c343b : #c5ccd4;
    // Secondary button: transparent with this outline and a white label.
    out property <color> outline-border:   ThemeMode.dark ? #4a535b : #8a949e;

    // ─── Result type colors ───────────────────────────────────────
    out property <color> color-do:        ThemeMode.dark ? #d4a574 : #8a6030;
    out property <color> color-find:      ThemeMode.dark ? #38d8cd : #08747e;
    out property <color> color-ask:       ThemeMode.dark ? #c4a050 : #8a7020;
    out property <color> color-memory:    ThemeMode.dark ? #a07a50 : #806030;
    out property <color> color-setting:   ThemeMode.dark ? #a5afbf : #5a6474;
    out property <color> color-tool:      ThemeMode.dark ? #d4a574 : #8a6030;
    out property <color> color-clipboard: ThemeMode.dark ? #a5afbf : #5a6474;
    out property <color> color-context:   ThemeMode.dark ? #38d8cd : #08747e;
    out property <color> color-recent:    ThemeMode.dark ? #4a5464 : #8a9aa4;
    out property <color> color-answer:    ThemeMode.dark ? #4ab8f0 : #2080c0;

    // Skeleton shimmer
    out property <color> color-skeleton:  ThemeMode.dark ? #1a1a28 : #e0e0e4;
    out property <color> shimmer-peak:    ThemeMode.dark ? #24243a : #d0d0d8;

    // Section headers
    out property <length> section-header-height: 28px;

    // Answer row height
    out property <length> lens-answer-height: 64px;
}
