// Alt+Tab, drawn (#867). labwc owns the session; this draws what it is told: the windows as a
// stack in time, the selected one in front, older ones stepping back up and to the right, a time
// line of when each was last used, and a caption. Positions, sizes and fades are computed in
// model.rs and scaled in main.rs, so this file only paints.
//
// The art direction (GPT-6 Astra, 20 Oct 2026): the screenshot is the material, and everything
// else helps you recognise it, place it in time or choose it. So a card is its window's picture,
// edge to edge, in its own shape, with no frame or title bar of ours round it; the ground is an
// opaque navy, so nothing of the desktop competes; the accent blue marks only the selection, and
// the gold of the emblem stays out of it.
//
// The software renderer draws `opacity` through an extra layer the size of the element, so it is
// 1 everywhere but the one card fading out in front (or in at the back) and the caption's icon.
// Deeper cards are darkened by a navy veil, which is a plain blend, not a layer.
import { Theme } from "theme.slint";
import { AppTile } from "app_tile.slint";
export { AppInitial } from "app_tile.slint";

// A part of a card that shows (model.rs `uncovered`), in the card's coordinates.
export struct Pane {
    x: length,
    y: length,
    w: length,
    h: length,
}

export struct Card {
    x: length,
    y: length,
    w: length,
    h: length,
    // How much of the ground's navy is laid over it, for its depth (0 = none).
    dim: float,
    // Its opacity: 1 except for a card fading in or out at either end of the stack.
    fade: float,
    // In front (or leaving it): it casts the contact shadow and wears the halo.
    front: bool,
    edge-width: length,
    edge: color,
    // Its app's icon, drawn on a card with no picture yet. A picture needs none: our windows
    // carry their own icon in their header, and a badge of ours sat on top of it (520, 20 Oct).
    icon-id: string,
    name: string,
    // Said on a card with no picture: minimized, on another desktop.
    note: string,
    picture: image,
    has-picture: bool,
    // Where it shows past the card in front of it: only there is it drawn.
    panes: [Pane],
}

export struct Dot {
    // The window's place on the line: its time, moved apart from its neighbours' just enough that
    // no two names touch (two windows used "now" read as two dots, not one).
    y: length,
    label: string,
    on: bool,
}

export struct Tick {
    y: length,
    label: string,
}

// The colours of this one surface. The accent is the theme's; the rest are its navy family.
global Ink {
    out property <color> primary: #edf2f8;
    out property <color> secondary: #a8b5c6;
    out property <color> quiet: #7d8fa6;
    out property <color> rail: #334257;
    out property <color> dot: #8294aa;
    out property <color> card: #151e2b;
    out property <color> veil: #0b1422;
    out property <color> shadow: #050a12;
    out property <color> key: #152133;
    out property <color> key-edge: #35465e;
}

component Keycap inherits HorizontalLayout {
    in property <string> key;
    in property <string> does;
    in property <float> scale;
    spacing: 7px * root.scale;
    Rectangle {
        width: label.preferred-width + 14px * root.scale;
        height: 24px * root.scale;
        border-radius: 5px * root.scale;
        background: Ink.key;
        border-width: 1px;
        border-color: Ink.key-edge;
        label := Text {
            text: root.key;
            color: Ink.primary;
            font-size: 12px * root.scale;
            font-weight: 600;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
    }
    Text {
        text: root.does;
        color: Ink.secondary;
        font-size: 12px * root.scale;
        vertical-alignment: center;
    }
}

export component SwitcherView inherits Window {
    in property <[Card]> cards;
    in property <[Dot]> dots;
    in property <[Tick]> ticks;
    // The design frame (1280×800) to the output: across, down, and for sizes the smaller of the two.
    in property <float> sx: 1.0;
    in property <float> sy: 1.0;
    in property <float> scale: 1.0;
    in property <length> marker-y: 140px;
    in property <string> caption-title;
    in property <string> caption-where;
    in property <string> caption-icon;
    // The caption fades out and in again as the selection changes; it never slides.
    in property <float> caption-alpha: 1.0;
    in property <string> typed;

    default-font-family: "Barlow";
    background: #080e18;

    // Opaque: the desktop under the stack is noise exactly where the stack needs quiet. A lift of
    // light behind the top of the stack, nothing more. (On a Rectangle: the software renderer
    // paints a Window's gradient background as one flat colour.)
    Rectangle {
        background: @linear-gradient(180deg, #101d30 0%, #080e18 100%);
    }

    // Deepest card first, so the selected one is drawn last, on top.
    for card in root.cards: Rectangle {
        x: card.x;
        y: card.y;
        width: card.w;
        height: card.h;
        opacity: card.fade;

        // A crisp contact shadow, not an imitation blur: one rounded shape, offset down.
        if card.front: Rectangle {
            x: -2px * root.scale;
            y: 4px * root.scale;
            width: parent.width + 4px * root.scale;
            height: parent.height + 2px * root.scale;
            border-radius: 14px * root.scale;
            background: Ink.shadow;
        }
        // A faint halo: a ring, never a translucent fill.
        if card.front: Rectangle {
            x: -3px * root.scale;
            y: -3px * root.scale;
            width: parent.width + 6px * root.scale;
            height: parent.height + 6px * root.scale;
            border-radius: 15px * root.scale;
            border-width: 2px * root.scale;
            border-color: Theme.accent.with-alpha(0.12);
        }

        Rectangle {
            border-radius: 12px * root.scale;
            background: card.has-picture ? transparent : Ink.card;
            clip: true;

            // The window as labwc last drew it, and the depth's veil over it, in the parts that
            // show. The card is already the picture's shape, and the front one is its exact size
            // at rest, so it is drawn 1:1.
            if card.has-picture: Rectangle {
                for pane in card.panes: Rectangle {
                    x: pane.x;
                    y: pane.y;
                    width: pane.w;
                    height: pane.h;
                    clip: true;
                    Image {
                        x: -pane.x;
                        y: -pane.y;
                        width: card.w;
                        height: card.h;
                        source: card.picture;
                        image-fit: fill;
                    }
                    if card.dim > 0.005: Rectangle {
                        background: Ink.veil.with-alpha(card.dim);
                    }
                }
            }
            // Until a picture arrives (or for a window with none): the app, by its icon and name.
            if !card.has-picture: VerticalLayout {
                alignment: center;
                spacing: 10px * root.scale;
                HorizontalLayout {
                    alignment: center;
                    AppTile {
                        app-id: card.icon-id;
                        size: round(min(card.w, card.h) * 0.22 / 1px) * 1px;
                    }
                }
                Text {
                    text: card.name;
                    color: Ink.secondary;
                    font-size: 14px * root.scale * card.w / (640px * root.scale);
                    horizontal-alignment: center;
                    overflow: elide;
                }
                if card.note != "": Text {
                    text: card.note;
                    color: Ink.quiet;
                    font-size: 12px * root.scale * card.w / (640px * root.scale);
                    horizontal-alignment: center;
                }
            }
            // Deeper, darker: the ground's own navy over the card (a picture's is in its panes).
            if card.dim > 0.005 && !card.has-picture: Rectangle {
                background: Ink.veil.with-alpha(card.dim);
            }
        }

        // The edge, inside the picture: the accent on the selected card, a quiet grey behind.
        Rectangle {
            border-radius: 12px * root.scale;
            border-width: card.edge-width;
            border-color: card.edge;
        }
    }

    // The time line: when each window was last used. A fine instrument, not a second list.
    Text {
        x: 980px * root.sx;
        y: 96px * root.sy;
        text: "HOW LONG AGO";
        color: Ink.secondary;
        font-size: 11px * root.scale;
        font-weight: 600;
        letter-spacing: 1px * root.scale;
    }
    Rectangle {
        x: 1020px * root.sx;
        y: 140px * root.sy;
        width: max(1px, round(root.scale) * 1px);
        height: 480px * root.sy;
        background: Ink.rail;
    }
    for tick in root.ticks: Text {
        x: 1006px * root.sx - self.width;
        y: tick.y - 9px * root.scale;
        width: 80px * root.scale;
        height: 18px * root.scale;
        horizontal-alignment: right;
        vertical-alignment: center;
        text: tick.label;
        color: Ink.quiet;
        font-size: 12px * root.scale;
    }
    for dot in root.dots: Rectangle {
        Rectangle {
            x: 1020px * root.sx + 0.5px * root.scale - 3px * root.scale;
            y: dot.y - 3px * root.scale;
            width: 6px * root.scale;
            height: 6px * root.scale;
            border-radius: 3px * root.scale;
            background: Ink.dot;
        }
        Text {
            x: 1036px * root.sx;
            y: dot.y - 10px * root.scale;
            width: 180px * root.scale;
            height: 20px * root.scale;
            vertical-alignment: center;
            text: dot.label;
            color: dot.on ? Ink.primary : Ink.secondary;
            font-size: (dot.on ? 14px : 13px) * root.scale;
            font-weight: dot.on ? 600 : 400;
            overflow: elide;
        }
    }
    // The selected window's marker, gliding between its dot and the next (main.rs eases it).
    Rectangle {
        x: 1020px * root.sx + 0.5px * root.scale - 8px * root.scale;
        y: root.marker-y - 8px * root.scale;
        width: 16px * root.scale;
        height: 16px * root.scale;
        border-radius: 8px * root.scale;
        border-width: 1px;
        border-color: Theme.accent.with-alpha(0.3);
        Rectangle {
            x: 3px * root.scale;
            y: 3px * root.scale;
            width: 10px * root.scale;
            height: 10px * root.scale;
            border-radius: 5px * root.scale;
            background: Theme.accent;
        }
    }

    // The caption, fixed under the front card's place: the app, what the window is, where, when.
    Rectangle {
        x: 80px * root.sx;
        y: 682px * root.sy;
        width: 24px * root.scale;
        height: 24px * root.scale;
        opacity: root.caption-alpha;
        AppTile {
            size: 24px * root.scale;
            app-id: root.caption-icon;
        }
    }
    Text {
        x: 116px * root.sx;
        y: 676px * root.sy;
        width: 680px * root.scale;
        height: 32px * root.scale;
        vertical-alignment: center;
        text: root.caption-title;
        color: Ink.primary.with-alpha(root.caption-alpha);
        font-size: 24px * root.scale;
        font-weight: 600;
        overflow: elide;
    }
    Text {
        x: 116px * root.sx;
        y: 712px * root.sy;
        width: 680px * root.scale;
        height: 20px * root.scale;
        vertical-alignment: center;
        text: root.caption-where;
        color: Ink.secondary.with-alpha(root.caption-alpha);
        font-size: 14px * root.scale;
        overflow: elide;
    }

    if root.typed != "": Rectangle {
        x: 80px * root.sx;
        y: 64px * root.sy;
        width: jump.preferred-width + 32px * root.scale;
        height: 40px * root.scale;
        border-radius: 8px * root.scale;
        background: Ink.key;
        border-width: 1px;
        border-color: Theme.accent;
        jump := Text {
            x: 16px * root.scale;
            height: parent.height;
            vertical-alignment: center;
            text: "Jump to  " + root.typed;
            color: Ink.primary;
            font-size: 16px * root.scale;
        }
    }

    // What the keys do. Arrows and Escape are labwc's, as they always were.
    HorizontalLayout {
        x: 0;
        y: 754px * root.sy;
        width: root.width;
        height: 24px * root.scale;
        alignment: center;
        spacing: 24px * root.scale;
        Keycap { key: "Tab"; does: "Next"; scale: root.scale; }
        Keycap { key: "Shift Tab"; does: "Previous"; scale: root.scale; }
        Keycap { key: "Alt"; does: "Release to open"; scale: root.scale; }
        Keycap { key: "A–Z"; does: "Find"; scale: root.scale; }
        Keycap { key: "Esc"; does: "Cancel"; scale: root.scale; }
    }
}
