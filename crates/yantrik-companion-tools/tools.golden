# Every tool `register_all` registers, as `name grade spawn-class` (golden_tests.rs holds it).
#
# spawn-class: none | fixed | safe_command | mind_command | browser | open_app
#   none          starts no program
#   fixed         starts fixed utilities named by a string literal, or by a `// fixed-program:` list
#   safe_command  starts allowlisted utilities through safe_command, with protected paths
#   mind_command  starts a program a Mind steers, in the outside view (spawn::mind_command)
#   browser       starts a browser in the browser view (browser_spawn)
#   open_app      asks the shell to start an app (open_app, or start_app for a framework app)
#
# A tool that is added, missing or regraded fails the test: read its spawn, then change its line.
# Plugin tools (the person's plugin files) are not listed; each starts through spawn::mind_command.
analyze_disk safe none
antivirus_quarantine safe none
antivirus_scan safe fixed
antivirus_status safe fixed
antivirus_update standard fixed
app_action standard open_app
apply_workspace_template standard open_app
