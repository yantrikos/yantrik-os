// GENERATED by design/icons/generate.py from AppColor's table (app_color.slint) and the glyphs in
// design/icons/. Do not edit: change those and run the generator; the kit's tests fail until it
// has been run (src/app_icons.rs).
//
// The pre-rendered app tiles AppTile draws, as images Slint embeds in the binary. `px` is the
// size a tile is drawn at in PHYSICAL pixels, and the art is the smallest at or above it: a 32px
// tile on a 1x display is drawn from the 32px art pixel for pixel, and on a 2x display from the
// 64px art, never a smaller picture stretched.

export global AppIcons {
    /// The colour of an unknown app's initial on the neutral plate, in either theme.
    public pure function plate-ink(dark: bool) -> color {
        return dark ? #ffffff : #4a5160;
    }

    /// Whether there is art for this app id: every app AppColor gives a colour.
    public pure function has(id: string) -> bool {
        return id == "notes"
            || id == "editor"
            || id == "documents"
            || id == "spreadsheet"
            || id == "presentation"
            || id == "snippets"
            || id == "email"
            || id == "calendar"
            || id == "notifications"
            || id == "music"
            || id == "media"
            || id == "image"
            || id == "studio"
            || id == "blender"
            || id == "arcade"
            || id == "files"
            || id == "terminal"
            || id == "system"
            || id == "sysmonitor"
            || id == "htop"
            || id == "network"
            || id == "containers"
            || id == "packages"
            || id == "devices"
            || id == "downloads"
            || id == "browser"
            || id == "weather"
            || id == "memory"
            || id == "agents"
            || id == "recipes"
            || id == "bond"
            || id == "personality"
            || id == "skills"
            || id == "permissions"
            || id == "settings"
            || id == "about"
            || id == "launchpad";
    }

    /// An app's tile at `px` physical pixels.
    public pure function art(id: string, px: int) -> image {
        return px <= 32 ? root.art-32(id)
             : px <= 48 ? root.art-48(id)
             : px <= 64 ? root.art-64(id)
             : px <= 96 ? root.art-96(id)
             : px <= 128 ? root.art-128(id)
             : root.art-256(id);
    }

    /// The neutral plate: the same squircle and light with no colour and no glyph, for an
    /// app we have no art for (its initial goes on it) and behind a theme's own icon. Pale
    /// in the light theme, a dim graphite in the dark one.
    public pure function plate(px: int, dark: bool) -> image {
        return dark ? root.plate-dark(px) : root.plate-light(px);
    }

    pure function plate-light(px: int) -> image {
        return px <= 32 ? @image-url("../assets/app-icons/32/_plate-light.png")
             : px <= 48 ? @image-url("../assets/app-icons/48/_plate-light.png")
             : px <= 64 ? @image-url("../assets/app-icons/64/_plate-light.png")
             : px <= 96 ? @image-url("../assets/app-icons/96/_plate-light.png")
             : px <= 128 ? @image-url("../assets/app-icons/128/_plate-light.png")
             : @image-url("../assets/app-icons/256/_plate-light.png");
    }

    pure function plate-dark(px: int) -> image {
        return px <= 32 ? @image-url("../assets/app-icons/32/_plate-dark.png")
             : px <= 48 ? @image-url("../assets/app-icons/48/_plate-dark.png")
             : px <= 64 ? @image-url("../assets/app-icons/64/_plate-dark.png")
             : px <= 96 ? @image-url("../assets/app-icons/96/_plate-dark.png")
             : px <= 128 ? @image-url("../assets/app-icons/128/_plate-dark.png")
             : @image-url("../assets/app-icons/256/_plate-dark.png");
    }

    /// The squircle in white, laid over a tile at low opacity for hover.
    public pure function mask(px: int) -> image {
        return px <= 32 ? @image-url("../assets/app-icons/32/_mask.png")
             : px <= 48 ? @image-url("../assets/app-icons/48/_mask.png")
             : px <= 64 ? @image-url("../assets/app-icons/64/_mask.png")
             : px <= 96 ? @image-url("../assets/app-icons/96/_mask.png")
             : px <= 128 ? @image-url("../assets/app-icons/128/_mask.png")
             : @image-url("../assets/app-icons/256/_mask.png");
    }

