// YInput — text, search and password fields.
//
// One height (32px), one radius, a quiet border that becomes the accent on focus. The clear
// and password-reveal controls are stroke glyphs; the search glyph comes from the shared set.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";

export component YInput inherits Rectangle {
    // 0=text, 1=search, 2=password
    in property <int> mode: 0;
    in property <string> placeholder: "";
    in property <string> leading-icon: "";
    in property <string> leading-icon-path: "";
    in property <string> error-text: "";
    in property <string> help-text: "";
    in property <bool> disabled: false;
    in property <bool> has-error: false;
    in property <bool> has-success: false;
    in-out property <string> value: "";
    in-out property <bool> password-visible: false;
    callback edited(string);
    callback accepted(string);
    callback cleared();

    property <bool> hovered: ta.has-hover;
    property <bool> focused: input.has-focus;
    property <string> lead: root.leading-icon-path != "" ? root.leading-icon-path
                          : root.mode == 1 ? Icons.search : "";

    height: Theme.h-regular + (root.error-text != "" || root.help-text != "" ? 18px : 0px);
    min-width: 180px;

    VerticalLayout {
        spacing: 3px;

        Rectangle {
            height: Theme.h-regular;
            border-radius: Theme.r-md;
            background: root.disabled ? Theme.bg-surface : Theme.bg-input;
            border-width: 1px;
            border-color: root.has-error ? Theme.color-danger
                        : root.has-success ? Theme.color-success
                        : root.focused ? Theme.accent-dim
                        : root.hovered ? Theme.border-strong
                        : Theme.border-default;
            opacity: root.disabled ? 0.5 : 1.0;
            clip: true;

            animate border-color { duration: Theme.dur-fast; }

            ta := TouchArea {
                clicked => { input.focus(); }
            }

            HorizontalLayout {
                padding-left: 10px;
                padding-right: 8px;
                spacing: 8px;

                if root.lead != "" : Icon {
                    commands: root.lead;
                    size: 14px;
                    thickness: 1.7px;
                    tint: root.focused ? Theme.accent : Theme.text-dim;
                    y: (parent.height - self.height) / 2;
                }
                if root.lead == "" && root.leading-icon != "" : Text {
                    text: root.leading-icon;
                    color: Theme.text-dim;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                    width: 18px;
                }

                input := TextInput {
                    vertical-alignment: center;
                    horizontal-stretch: 1;
                    font-size: Theme.fs-body;
                    color: root.disabled ? Theme.text-dim : Theme.text-primary;
                    input-type: root.mode == 2 && !root.password-visible ? password : text;
                    text: root.value;
                    enabled: !root.disabled;
                    edited => {
                        root.value = self.text;
                        root.edited(self.text);
                    }
                    accepted => { root.accepted(self.text); }
                }

                if root.value != "" && root.mode != 2 : TouchArea {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    mouse-cursor: pointer;
                    clicked => {
                        root.value = "";
                        root.cleared();
                        root.edited("");
                    }
                    Icon {
                        commands: "M5 5L15 15 M15 5L5 15";
                        size: 12px;
                        tint: parent.has-hover ? Theme.text-primary : Theme.text-dim;
                        x: 4px; y: 4px;
                    }
                }

                if root.mode == 2 : TouchArea {
                    width: 20px;
                    height: 20px;
                    y: (parent.height - 20px) / 2;
                    mouse-cursor: pointer;
                    clicked => { root.password-visible = !root.password-visible; }
                    Icon {
                        commands: root.password-visible
                            ? "M2 10C4 6 7 4 10 4S16 6 18 10C16 14 13 16 10 16S4 14 2 10Z M7.5 10A2.5 2.5 0 1 0 12.5 10A2.5 2.5 0 1 0 7.5 10Z"
                            : "M2 10C4 6 7 4 10 4S16 6 18 10C16 14 13 16 10 16S4 14 2 10Z M3 3L17 17";
                        size: 14px;
                        tint: Theme.text-dim;
                        x: 3px; y: 3px;
                    }
                }
            }

            // Placeholder overlay, offset past the leading glyph
            if root.value == "" : Text {
                x: 10px + (root.lead != "" || root.leading-icon != "" ? 14px + 8px : 0px);
                height: 100%;
                text: root.placeholder;
                color: Theme.text-dim;
                font-size: Theme.fs-body;
                vertical-alignment: center;
            }
        }

        if root.error-text != "" : Text {
            text: root.error-text;
            color: Theme.color-danger;
            font-size: Theme.fs-micro;
        }
        if root.error-text == "" && root.help-text != "" : Text {
            text: root.help-text;
            color: Theme.text-dim;
            font-size: Theme.fs-micro;
        }
    }
}
