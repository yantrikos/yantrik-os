// Chat message bubble.
// User messages: dark pill, right-aligned.
// Yantrik messages: left-aligned with glowing cyan dot + rich block rendering.

import { Theme } from "theme.slint";
import { ToolCallData, ToolCallCard } from "tool_call.slint";

// A single rendered block in a message (parsed from markdown).
export struct ContentBlock {
    block-type: string,  // "text", "code", "heading", "bullet", "tool"
    text: string,
    // A "tool" block's call — name, arguments, status, output — drawn by ToolCallCard. Empty
    // for every other kind of block.
    call: ToolCallData,
}

export struct MessageData {
    role: string,       // "user" or "assistant"
    content: string,
    is-streaming: bool,
    blocks: [ContentBlock],
}

export component MessageBubble inherits Rectangle {
    in property <MessageData> data;

    property <bool> is-user: data.role == "user";
    property <bool> has-blocks: data.blocks.length > 0 && !data.is-streaming;

    height: self.preferred-height;
    background: transparent;

    HorizontalLayout {
        padding-left: is-user ? 60px : 16px;
        padding-right: is-user ? 16px : 40px;
        padding-top: 4px;
        padding-bottom: 4px;
        alignment: is-user ? end : start;

        if !is-user : HorizontalLayout {
            spacing: 10px;
            alignment: start;

            // Glowing cyan dot (companion indicator)
            Rectangle {
                width: 8px;
                height: 8px;
                y: 7px;
                border-radius: 4px;
                background: Theme.cyan;
                drop-shadow-blur: 8px;
                drop-shadow-color: Theme.cyan-glow;
            }

            // Content area — plain text during streaming, rich blocks after
            VerticalLayout {
                horizontal-stretch: 1;
                spacing: 4px;

                // Plain text fallback (streaming or no parsed blocks)
                if !has-blocks : Text {
                    text: data.content;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }

                // Rich block rendering (after stream completes)
                for block in data.blocks : Rectangle {
                    property <bool> is-tool: block.block-type == "tool";
                    property <bool> is-code: block.block-type == "code";

                    // Every kind of block sits in this layout, not straight in the Rectangle: a
                    // Rectangle takes no size from an `if` child, so with them bare (#125) every
                    // block measured zero high. The Lens drew a turn's tool cards on top of one
                    // another and gave its answer a box with no height (#211).
                    VerticalLayout {
                        // A list sits in from the paragraphs around it.
                        padding-left: block.block-type == "bullet" ? 8px : 0px;

                        // A tool call: the card every view of a mind's calls shares — one line
                        // with the arguments on it, the whole of them on a click.
                        if is-tool : ToolCallCard {
                            call: block.call;
                        }

                        // A direct child of the layout, as in the Agents pane: a wrapping text
                        // inside a nested layout is measured at its unwrapped width, and every
                        // line past the first is cut off.
                        if !is-tool && !is-code : Text {
                            text: block.text;
                            color: block.block-type == "heading" ? Theme.amber-light : Theme.text-primary;
                            font-size: block.block-type == "heading" ? Theme.font-title : Theme.font-body;
                            font-weight: block.block-type == "heading" ? 600 : 400;
                            wrap: word-wrap;
                        }

                        // Sized from its own text, for the same reason.
                        if is-code : Rectangle {
                            background: Theme.bg-card;
                            border-radius: 6px;
                            border-width: 1px;
                            border-color: Theme.border-subtle;
                            height: code.preferred-height + 16px;

                            code := Text {
                                x: 10px;
                                y: 8px;
                                width: parent.width - 20px;
                                text: block.text;
                                color: Theme.cyan-light;
                                font-size: Theme.font-small;
                                wrap: word-wrap;
                            }
                        }
                    }
                }
            }
        }

        if is-user : Rectangle {
            border-radius: 18px;
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-subtle;
            height: msg-layout.preferred-height;

            msg-layout := HorizontalLayout {
                padding: 10px;
                padding-left: 14px;
                padding-right: 14px;

                Text {
                    text: data.content;
                    color: Theme.text-primary;
                    font-size: Theme.font-body;
                    wrap: word-wrap;
                }
            }
        }
    }
}
