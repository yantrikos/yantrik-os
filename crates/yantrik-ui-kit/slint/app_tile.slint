// AppTile — an app's icon, as a solid tile in the app's own colour.
//
// The one place an app's colour is loud (desk-and-mind, "Colour per app"): the launcher, the
// desktop's workspace row and the taskbar all draw an app through this, so a tile is the same
// object on all three and only its size changes. Before this each surface drew its own — a
// faint tint behind a coloured stroke — and at a glance they read as three grey squares with
// a thread of colour in them. A solid tile with a white glyph is what an app icon looks like
// on every desktop a person has used, and it is what lets the colour do its job: you find
// Files by its blue before you have read the word.
//
// The shape scales: the corner is a fraction of the size, not a token, because a 32px dock
// tile and a 48px desktop tile have to be the same shape and one length cannot give both.
//
// Three cases, decided here once:
//   * our app, known to AppColor: the solid tile, the glyph in the colour that reads on it;
//   * an app with a real icon from the icon theme: a quiet surface tile with that image, since
//     painting a third-party logo onto one of our colours would be claiming it;
//   * anything else: the same quiet tile with the glyph in secondary grey — no colour, because
//     we do not know what it is, and a guessed hue would imply a category.
import { Theme, ThemeMode } from "theme.slint";
import { AppColor } from "app_color.slint";
import { Icon } from "icon.slint";

export component AppTile inherits Rectangle {
    /// The shell's app id (the icon id: `files`, `email`, `sysmonitor` …).
    in property <string> app-id;
    /// The glyph, as path commands from Icons (`Icons.app-or-window(id)` and friends).
    in property <string> glyph;
    /// A real icon image resolved from the icon theme; wins over the glyph when present.
    in property <bool> has-icon: false;
    in property <image> icon;
    in property <length> size: 44px;
    in property <bool> hovered: false;
    /// Drawn quieter: the taskbar's windows that do not have focus.
    in property <bool> dimmed: false;

    property <string> hue: AppColor.hue-for-app(root.app-id);
    property <bool> coloured: root.hue != "" && !root.has-icon;
    property <color> fill: root.hovered ? AppColor.tile-for-app(root.app-id).brighter(8%)
                                        : AppColor.tile-for-app(root.app-id);

    width: root.size;
    height: root.size;
    border-radius: root.size * 0.26;
    // Solid, not a gradient: the software renderer this OS runs on draws a gradient fill
    // without its corner radius, so a gradient tile came out as a square with a rounded rim
    // (photographed, preview harness, 23 September). The rim below does the lifting instead.
    background: root.coloured ? root.fill
        : root.hovered ? Theme.bg-elevated.brighter(6%) : Theme.bg-elevated;
    // The hairline. On a coloured tile it is a light rim in the dark theme — the edge that
    // catches the light — and a faint dark one in the light theme, where a white rim on a
    // white page would vanish.
    border-width: 1px;
    border-color: root.coloured ? (ThemeMode.dark ? #ffffff30 : #00000024) : Theme.border-card;
    opacity: root.dimmed ? 0.7 : 1.0;

    // Whole pixels, always. The glyphs are drawn on a 20-unit grid with their lines on the
    // half-unit, so they land on the pixel grid at 20px and blur at any fraction of it; and a
    // glyph centred at a fractional offset smears every edge it has. On VM 520 (3 October) the
    // dock drew 13px glyphs at 0.6x and the desktop 24.8px ones at 1.24x with 2px strokes, and
    // Pranab called the icons "not crisp but blunt". Small tiles get the exact 20px glyph; larger
    // ones half their size, rounded; strokes are 1.5px everywhere, which reads as a line rather
    // than a blob at every size the shell uses.
    property <length> glyph-size: root.size <= 36px ? 20px : round(root.size / 2 / 1px) * 1px;
    property <length> image-size: round(root.size * 0.66 / 1px) * 1px;

    if root.has-icon : Image {
        source: root.icon;
        width: root.image-size;
        height: root.image-size;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
        image-fit: contain;
    }
    if !root.has-icon : Icon {
        commands: root.glyph;
        size: root.glyph-size;
        tint: root.coloured ? AppColor.on-tile(root.hue) : Theme.text-secondary;
        thickness: 1.5px;
        x: round((parent.width - self.width) / 2 / 1px) * 1px;
        y: round((parent.height - self.height) / 2 / 1px) * 1px;
    }
}
