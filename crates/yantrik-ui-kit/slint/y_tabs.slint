// YTabs — a tab strip with a 2px accent underline on the active tab.
import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export struct YTabItem {
    id: string,
    label: string,
    icon: string,
    icon-path: string,
    badge-count: int,
}

export component YTabs inherits Rectangle {
    in property <[YTabItem]> tabs: [];
    in property <string> active-id: "";
    callback tab-clicked(string);

    height: 40px;
    background: transparent;

    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        width: 100%;
        background: Theme.separator;
    }

    HorizontalLayout {
        alignment: start;
        spacing: 2px;
        padding-left: Theme.sp-3;

        for tab[idx] in root.tabs : Rectangle {
            property <bool> is-active: tab.id == root.active-id;
            property <bool> hovered: tab-ta.has-hover;

            min-width: 56px;
            width: tab-layout.preferred-width + Theme.sp-5;
            height: 100%;

            tab-ta := TouchArea {
                mouse-cursor: pointer;
                clicked => { root.tab-clicked(tab.id); }
            }

            tab-layout := HorizontalLayout {
                alignment: center;
                spacing: 6px;

                if tab.icon-path != "" : Icon {
                    commands: tab.icon-path;
                    size: 14px;
                    tint: is-active ? Theme.accent : Theme.text-secondary;
                    y: (parent.height - self.height) / 2;
                }
                if tab.icon-path == "" && tab.icon != "" : Text {
                    text: tab.icon;
                    color: is-active ? Theme.accent : Theme.text-secondary;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                }

                Text {
                    text: tab.label;
                    color: is-active ? Theme.text-primary
                         : hovered ? Theme.text-secondary
                         : Theme.text-dim;
                    font-size: Theme.font-label;
                    font-weight: is-active ? 500 : Theme.fw-body;
                    vertical-alignment: center;
                }

                if tab.badge-count > 0 : Rectangle {
                    width: cnt.preferred-width + 10px;
                    min-width: 18px;
                    height: 18px;
                    y: (parent.height - 18px) / 2;
                    border-radius: 4px;
                    background: is-active ? Theme.tint-accent : Theme.hover-fill;
                    cnt := Text {
                        text: tab.badge-count;
                        color: is-active ? Theme.accent : Theme.text-secondary;
                        font-size: Theme.fs-micro;
                        font-weight: 600;
                        horizontal-alignment: center;
                        vertical-alignment: center;
                    }
                }
            }

            Rectangle {
                y: parent.height - 2px;
                height: 2px;
                width: is-active ? parent.width - Theme.sp-3 : 0;
                x: (parent.width - self.width) / 2;
                border-radius: 1px;
                background: Theme.accent;
                animate width { duration: Theme.dur-fast; easing: ease-out; }
            }
        }
    }
}
