// YSidebar — navigation rail with sections, items, counts.
//
// Each item is a YNavRow, the one row every sidebar draws. Section titles use the same small
// letter-spaced label the shell's rails use, so an app's sidebar reads as part of the OS.
import { Theme } from "theme.slint";
import { YNavRow } from "y_nav_row.slint";

export struct YSidebarItem {
    id: string,
    icon: string,
    icon-path: string,
    label: string,
    badge: string,
    badge-count: int,
}

export struct YSidebarSection {
    title: string,
    collapsed: bool,
    items: [YSidebarItem],
}

export component YSidebar inherits Rectangle {
    in property <[YSidebarSection]> sections: [];
    in property <string> active-id: "";
    in property <int> width-px: 220;
    callback item-clicked(string);

    width: root.width-px * 1px;
    background: Theme.bg-surface;

    Rectangle {
        x: parent.width - 1px;
        width: 1px;
        height: 100%;
        background: Theme.seam;
    }

    Flickable {
        width: 100%;
        height: 100%;

        VerticalLayout {
            padding: Theme.sp-2;
            padding-top: Theme.sp-3;
            spacing: Theme.sp-2;

            for section[si] in root.sections : VerticalLayout {
                spacing: 2px;

                if section.title != "" : Rectangle {
                    height: 26px;
                    Text {
                        x: Theme.sp-3;
                        text: section.title;
                        color: Theme.text-dim;
                        font-size: Theme.fs-micro;
                        font-weight: Theme.fw-micro;
                        letter-spacing: 1px;
                        vertical-alignment: center;
                    }
                }

                for item[ii] in section.items : YNavRow {
                    icon: item.icon-path;
                    label: item.label;
                    active: item.id == root.active-id;
                    badge: item.badge-count > 99 ? "99+" : item.badge-count > 0 ? item.badge-count : item.badge;
                    clicked => { root.item-clicked(item.id); }
                }
            }
        }
    }
}
