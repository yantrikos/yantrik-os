// ═══════════════════════════════════════════════════════════════════════════════════════
// app_header.slint — the top edge every Yantrik app wears
// ═══════════════════════════════════════════════════════════════════════════════════════
//
// Sixteen apps, sixteen hand-rolled headers, sixteen heights: 28, 32, 36, 44, 48, 56, 64.
// Download Manager had no app header at all — a row of statistics sat where every other app
// puts its name. That is why the top edge of this OS did not line up with itself.
//
// It was not for lack of a shared component. Two already existed and neither was used ONCE:
//
//   YToolbar  spent Slint's `@children` on the slot LEFT of the title and offered nothing on
//             the right — so an app with trailing buttons, which is every app, could not use it.
//   AppShell  spent its `@children` on nothing at all: the sidebar and detail panes were empty
//             Rectangles with no way to put anything inside them.
//
// A Slint component has exactly one `@children`. An app header wants three regions — glyph and
// title, search, actions — so any header built from child elements must lose two of them. Both
// components lost the region apps actually needed, so all sixteen went and drew their own, and
// consistency was left to sixteen authors agreeing on a number. They did not.
//
// So header content is DATA here, not children. `actions` is a model of AppAction; the frame
// renders them, at its own size, with its own spacing, and an app can no more make a header
// button of a different shape than it can make a different mouse cursor. The one `@children`
// then goes where arbitrary content genuinely belongs: the body.
//
// That is the whole idea. Consistency stops being a convention someone has to remember and
// becomes the only thing the API is able to express.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { YButton } from "y_button.slint";
import { YSegmented } from "y_segmented.slint";
import { YTooltip } from "y_tooltip.slint";
import { WindowControls } from "window_controls.slint";
import { AppColor, AppIdentity } from "app_color.slint";
import { WindowChrome } from "window_chrome.slint";

// ── One action in an app's header ───────────────────────────────────────────────────────
//
// Every field defaults to the common case, because a default that is wrong is how sixteen
// headers drifted apart to begin with. An action carrying only `id` and `label` is a quiet,
// enabled, labelled button — which is what most of them are.
export struct AppAction {
    // Handed back through `action(id)`. The app switches on it.
    id: string,
    // Empty label ⇒ icon-only. Empty icon ⇒ text-only. Both ⇒ icon and text.
    label: string,
    icon: string,
    // 0 quiet (default), 1 raised, 2 primary, 3 danger.
    //
    // Deliberately NOT YButton's numbering, which puts primary at 0. In a toolbar the common
    // button is the quiet one, so the quiet one is what you get for saying nothing. The mapping
    // onto YButton happens below, once, in a place where it can be read and checked.
    emphasis: int,
    // A pressed toggle — meeting mode on, sidebar showing, muted. Drawn as primary.
    active: bool,
    disabled: bool,
    // Draw a divider in this slot instead of a button. id/label/icon are ignored.
    //
    // Notes' toolbar is eleven controls in one undifferentiated run -- a people icon, Export,
    // Import, a clock icon, Structure, Summarize, New, Template, Save, a bin and a cross --
    // and nothing in it says which of those belong together. Every toolbar worth copying
    // groups: file things, then document things, then the destructive ones off on their own.
    // A separator is how a row says that without a word.
    separator: bool,
    // The icon goes after the label. For menu buttons, where it is a chevron.
    trailing-icon: bool,
    // Work in flight — YButton draws its spinner and swallows the click.
    loading: bool,
    // What the button says on hover, under the header; on a disabled one, why it is off. It hangs
    // below the bar, so an owner whose next row is opaque raises the header with `z: 1`.
    tooltip: string,
}

// ── The header ──────────────────────────────────────────────────────────────────────────
//
// Every app instantiates this directly, in place of the bar it used to draw itself.
export component AppHeader inherits Rectangle {
    in property <string> title: "";
    in property <string> subtitle: "";
    // App glyph, drawn in the tinted square. A path from the Icons global.
    in property <string> icon: "";
    // Which app this is, for the colour of that square. Empty means the house accent, which is
    // what every header used to get — sixteen apps wearing one tint, distinguishable only by
    // reading the word next to it.
    in property <string> app-id: "";

    // Tell the rest of the window what it is. Every app already passes app-id here, so this is
    // the one place it can be picked up without twenty-two apps each repeating themselves.
    init => {
        if (root.app-id != "") { AppIdentity.id = root.app-id; }
    }
    // Unsaved-changes dot, beside the title.
    in property <bool> modified: false;
    // A transient word from the app — "Exported", "Saving…" — in the accent colour.
    in property <string> status: "";
    // Actions left of the spacer, beside the title. Mode switches, not verbs.
    in property <[AppAction]> leading-actions: [];
    // One choice among a few, beside the mode switches: °C / °F. Drawn as a segmented control,
    // not as an action, because an action labelled with the current choice reads as a verb, and
    // drawn active it took the primary's filled accent. Empty draws nothing.
    in property <[string]> segments: [];
    in property <int> segment: 0;
    // What the choice is about, for assistive tech: "Temperature unit".
    in property <string> segments-label: "";
    callback segment-chosen(int);
    // Actions at the right edge. The usual place.
    in property <[AppAction]> actions: [];
    in property <bool> show-search: false;
    in property <string> search-placeholder: "Search";
    in-out property <string> search-text: "";
    in property <bool> show-divider: true;
    // A leading back arrow, before the glyph. Several apps had one and it is the one control
    // that must never move, so it is the frame's job rather than an action the app can place.
    in property <bool> show-back: false;

    // ── Window controls ──
    //
    // Off by default. On for a shell screen filling the display, where this header is the only
    // chrome the surface has, with the frame's own callbacks below. An app window does not use
    // this: its bar is `window-bar` (further down), which brings the same buttons and sends them
    // to the window itself.
    in property <bool> show-window-controls: false;
    in property <bool> maximized: true;
    in property <bool> can-minimize: true;
    callback minimize();
    callback toggle-maximize();
    callback close-window();

    // ── Moving the window by its bar ──
    //
    // On when this header IS the window's title bar — `AppWindow`, where the compositor draws no
    // bar of its own (#256). Pressing on the bar and moving asks for a move, which the window
    // hands to the compositor; double-clicking maximises or restores, as every desktop's title
    // bar does. Buttons, the search field and the actions sit above the area that listens, so
    // only the bar's empty space and its title move the window.
    in property <bool> draggable: false;
    callback drag();

    // This header IS the window's title bar (#256): its buttons, its drag and its double-click
    // go to the window through WindowChrome, and the maximise button shows the window's own
    // state. For an app whose screen draws this header, so that the screen's header is the one
    // bar and nothing is drawn twice; AppWindow's own bar is one too. The in-shell frames still
    // use `show-window-controls` with callbacks of their own.
    in property <bool> window-bar: false;
    property <bool> controls-shown: root.show-window-controls || root.window-bar;

    callback back();
    callback action(string);
    callback search-edited(string);
    callback search-accepted(string);

    // Keep frequent actions on the bar; every remaining action has a named,
    // keyboard-accessible menu entry. Never hide commands in a horizontal scroll.
    property <int> inline-count: root.actions.length > 4 || root.width < 900px ? min(2, root.actions.length) : root.actions.length;
    property <bool> has-overflow: root.actions.length > root.inline-count;
    property <int> menu-index: root.inline-count;
    // The inline action the pointer is on, and its centre within the header, for its tooltip.
    // The tooltip is drawn by the header and not the button: the button clips, and so does the
    // Flickable the header's row sits in, and a tooltip under the bar is outside both.
    property <int> tip-index: -1;
    property <length> tip-x: 0px;

    // Not negotiable, and not a default an app can quietly override: this is the number.
    height: Theme.h-app-header;
    // The containing pane allocates our width. Do not feed responsive child
    // constraints back into a split pane's intrinsic width calculation.
    min-width: 0px;
    preferred-width: 0px;
    horizontal-stretch: 1;
    background: Theme.bg-surface;
    vertical-stretch: 0;

    if root.show-divider : Rectangle {
        y: parent.height - 1px;
        width: 100%;
        height: 1px;
        background: Theme.separator;
    }

    // A viewport isolates intrinsic child sizes from the containing split pane.
    // The header itself never scrolls; only its bounded action strip can scroll.
    Flickable {
        width: 100%; height: 100%;
        viewport-width: self.width;
        viewport-height: self.height;
        interactive: false;

        // Behind the row, so anything in the row that takes a press takes it first. The move
        // starts once the pointer has travelled a few pixels, not on the press itself: a press
        // handed to the compositor at once would never arrive here as the second half of a
        // double-click.
        bar-drag := TouchArea {
            enabled: root.draggable || root.window-bar;
            width: parent.width;
            height: parent.height;
            moved => {
                if (self.pressed
                    && (abs(self.mouse-x - self.pressed-x) > 4px
                        || abs(self.mouse-y - self.pressed-y) > 4px)) {
                    if (root.window-bar) { WindowChrome.drag(); } else { root.drag(); }
                }
            }
            double-clicked => {
                if (root.window-bar) { WindowChrome.toggle-maximize(); } else { root.toggle-maximize(); }
            }
        }

        HorizontalLayout {
            padding-left: root.show-back ? Theme.sp-2 : Theme.sp-4;
            padding-right: root.controls-shown ? 0px : Theme.sp-3;
            spacing: root.width < 1000px ? Theme.sp-2 : Theme.sp-3;

            // ── Back ──
            if root.show-back : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                YButton {
                    icon-path: Icons.arrow-left;
                    icon-only: true;
                    size: 0;
                    variant: 1;
                    clicked => { root.back(); }
                }
            }

            // ── App glyph ──
            if root.icon != "" : Rectangle {
                width: 32px;
                height: 32px;
                y: (parent.height - 32px) / 2;
                border-radius: Theme.r-sm;
                background: root.app-id != "" ? AppColor.tint-for-app(root.app-id) : Theme.tint-accent;
                Icon {
                    commands: root.icon;
                    size: 16px;
                    tint: root.app-id != "" ? AppColor.for-app(root.app-id) : Theme.accent;
                    thickness: 1.7px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }

            // ── Title ──
            //
            // horizontal-stretch: 0 so the spacer further down takes the slack. Without it the title
            // block and the spacer split it, and the modified dot drifts away from the word it marks.
            VerticalLayout {
                alignment: center;
                spacing: 1px;
                horizontal-stretch: 0;
                width: min(180px, root.width * 0.20);

                Text {
                    text: root.title;
                    color: Theme.text-primary;
                    font-size: Theme.fs-title-2;
                    font-weight: Theme.fw-title-2;
                    letter-spacing: -0.2px;
                    overflow: elide;
                    min-width: 0px;
                    max-width: 180px;
                }

                if root.subtitle != "" : Text {
                    text: root.subtitle;
                    color: Theme.text-secondary;
                    font-size: Theme.fs-micro;
                    overflow: elide;
                    min-width: 0px;
                    max-width: 180px;
                }
            }

            if root.modified : Rectangle {
                width: 7px;
                height: 7px;
                y: (parent.height - 7px) / 2;
                border-radius: 3.5px;
                background: Theme.amber;
                horizontal-stretch: 0;
            }

            if root.status != "" : Text {
                text: root.status;
                color: Theme.accent;
                font-size: Theme.fs-caption;
                vertical-alignment: center;
                overflow: elide;
                max-width: 160px;
                horizontal-stretch: 0;
            }

            if root.leading-actions.length > 0 : HorizontalLayout {
                alignment: start;
                spacing: Theme.sp-1;
                horizontal-stretch: 0;
                // Centred by arithmetic rather than a hardcoded 10px, so the row stays centred if
                // the header height token ever moves.
                padding-top: (root.height - Theme.h-compact) / 2;
                padding-bottom: (root.height - Theme.h-compact) / 2;

                for a in root.leading-actions : YButton {
                    label: a.label != "" ? a.label : a.id;
                    icon-path: a.icon;
                    icon-only: a.label == "";
                    size: 0;
                    disabled: a.disabled;
                    loading: a.loading;
                    variant: a.active ? 0
                           : a.emphasis == 3 ? 3
                           : a.emphasis == 2 ? 0
                           : a.emphasis == 1 ? 1
                           : 2;
                    clicked => { root.action(a.id); }
                }
            }

            if root.segments.length > 0 : VerticalLayout {
                alignment: center;
                horizontal-stretch: 0;
                YSegmented {
                    label: root.segments-label;
                    items: root.segments;
                    selected: root.segment;
                    chosen(i) => { root.segment-chosen(i); }
                }
            }

            Rectangle { horizontal-stretch: 1; }

            // ── Search ──
            if root.show-search : Rectangle {
                width: max(140px, min(240px, root.width * 0.18));
                height: Theme.h-regular;
                y: (parent.height - Theme.h-regular) / 2;
                horizontal-stretch: 0;
                border-radius: Theme.r-md;
                background: Theme.bg-input;
                border-width: 1px;
                border-color: search-input.has-focus ? Theme.accent-dim : Theme.border-default;
                clip: true;
                animate border-color { duration: Theme.dur-fast; }

                HorizontalLayout {
                    padding-left: 10px;
                    padding-right: 8px;
                    spacing: 8px;

                    Icon {
                        commands: Icons.search;
                        size: 14px;
                        tint: Theme.text-dim;
                        thickness: 1.6px;
                        y: (parent.height - self.height) / 2;
                    }

                    search-input := TextInput {
                        text <=> root.search-text;
                        color: Theme.text-primary;
                        font-size: Theme.fs-body;
                        vertical-alignment: center;
                        single-line: true;
                        edited => { root.search-edited(self.text); }
                        accepted => { root.search-accepted(self.text); }
                    }
                }

                if root.search-text == "" && !search-input.has-focus : Text {
                    x: 32px;
                    text: root.search-placeholder;
                    color: Theme.text-dim;
                    font-size: Theme.fs-body;
                    vertical-alignment: center;
                    height: 100%;
                }
            }

            // ── Actions ──
            if root.actions.length > 0 : HorizontalLayout {
                height: root.height;
                horizontal-stretch: 0;
                spacing: Theme.sp-1;
                action-row := HorizontalLayout {
                    height: root.height;
                    alignment: end;
                    spacing: 0px;
                    horizontal-stretch: 0;
                    padding-top: (root.height - Theme.h-compact) / 2;
                    padding-bottom: (root.height - Theme.h-compact) / 2;

                    for a[idx] in root.actions : VerticalLayout {
                        alignment: center;
                        horizontal-stretch: 0;
                        padding-right: idx < root.inline-count ? Theme.sp-1 : 0px;
                        // A separator is a slot in the same list rather than a second property, so the
                        // order of a toolbar is still one readable array in the app.
                        if idx < root.inline-count && a.separator : Rectangle {
                            width: 1px;
                            height: 18px;
                            // border-strong, not separator: Theme.separator is 3% white, which is right
                            // for a hairline between two large surfaces and invisible as an 18px tick
                            // between two buttons. Measured off a screenshot, not guessed -- at 3% the
                            // groups read as uneven spacing rather than as groups.
                            background: Theme.border-strong;
                        }
                        if idx < root.inline-count && !a.separator : YButton {
                            label: a.label != "" ? a.label : a.id;
                            icon-path: a.icon;
                            icon-trailing: a.trailing-icon;
                            icon-only: a.label == "" || (root.width < 720px && a.icon != "");
                            size: 0;
                            disabled: a.disabled;
                            loading: a.loading;
                            tooltip: a.tooltip;
                            variant: a.active ? 0
                                   : a.emphasis == 3 ? 3
                                   : a.emphasis == 2 ? 0
                                   : a.emphasis == 1 ? 1
                                   : 2;
                            clicked => { root.action(a.id); }
                            // Cleared only by the button that set it: moving straight from one
                            // button to the next may report the arrival before the departure.
                            changed pointer-over => {
                                if (self.pointer-over && a.tooltip != "") {
                                    root.tip-index = idx;
                                    root.tip-x = self.anchor-x - bar-drag.absolute-position.x;
                                } else if (root.tip-index == idx) {
                                    root.tip-index = -1;
                                }
                            }
                        }
                    }
                }
                if root.has-overflow : VerticalLayout {
                    alignment: center;
                    YButton {
                        label: "More";
                        icon-path: Icons.chevron-down;
                        icon-trailing: true;
                        variant: 1;
                        size: 0;
                        clicked => {
                            root.menu-index = root.inline-count;
                            if (root.actions[root.menu-index].separator) { root.menu-index += 1; }
                            overflow-menu.show();
                        }
                    }
                }
            }

            // -- Window controls --
            //
            // Last, and hard against the corner: no padding, no gap, because the top-right corner
            // of a screen is an infinitely large target and giving it away to an 8px margin is the
            // one mistake a titlebar cannot afford. The layout's own padding-right is dropped for
            // the same reason when these are shown.
            if root.controls-shown : VerticalLayout {
                alignment: start;
                horizontal-stretch: 0;
                WindowControls {
                    bar-height: Theme.h-app-header;
                    maximized: root.window-bar ? WindowChrome.maximized : root.maximized;
                    show-minimize: root.can-minimize;
                    minimize => { if (root.window-bar) { WindowChrome.minimize(); } else { root.minimize(); } }
                    toggle-maximize => { if (root.window-bar) { WindowChrome.toggle-maximize(); } else { root.toggle-maximize(); } }
                    close => { if (root.window-bar) { WindowChrome.close(); } else { root.close-window(); } }
                }
            }
        }
    }

    YTooltip {
        text: root.tip-index >= 0 ? root.actions[root.tip-index].tooltip : "";
        hovered: root.tip-index >= 0;
        // Centred under its button, and kept inside the header's width.
        x: max(0px, min(root.width - self.width, root.tip-x - self.width / 2));
        y: root.height + Theme.sp-1;
    }

    overflow-menu := PopupWindow {
        forward-focus: menu-keys;
        x: max(0px, root.width - self.width - (root.controls-shown ? 120px : 12px));
        y: root.height - 2px;
        width: 252px;
        height: min(420px, menu-items.preferred-height);
        close-policy: close-on-click-outside;
        Rectangle {
            background: Theme.bg-elevated;
            border-width: 1px;
            border-color: Theme.border-strong;
            border-radius: Theme.r-lg;
            clip: true;
            menu-keys := FocusScope {
                key-pressed(e) => {
                    if (e.text == Key.DownArrow || e.text == Key.UpArrow || e.text == Key.Tab) {
                        root.menu-index = max(root.inline-count, min(root.actions.length - 1, root.menu-index + (e.text == Key.UpArrow || e.modifiers.shift ? -1 : 1)));
                        if (root.actions[root.menu-index].separator) {
                            root.menu-index = max(root.inline-count, min(root.actions.length - 1, root.menu-index + (e.text == Key.UpArrow || e.modifiers.shift ? -1 : 1)));
                        }
                        return accept;
                    }
                    if (e.text == "\n" || e.text == " ") {
                        if (!root.actions[root.menu-index].disabled && !root.actions[root.menu-index].loading && !root.actions[root.menu-index].separator) {
                            root.action(root.actions[root.menu-index].id);
                            overflow-menu.close();
                        }
                        return accept;
                    }
                    reject
                }
            }
            Flickable {
                width: 100%; height: 100%;
                viewport-width: self.width;
                viewport-height: menu-items.preferred-height;
                viewport-y: -min(max(0px, self.viewport-height - self.height), max(0, root.menu-index - root.inline-count - 5) * 34px);
                menu-items := VerticalLayout {
                    width: parent.width;
                    padding: 6px;
                    spacing: 0px;
                    for a[idx] in root.actions : Rectangle {
                        height: idx < root.inline-count ? 0px : a.separator ? 9px : 34px;
                        visible: idx >= root.inline-count;
                        border-radius: Theme.r-sm;
                        background: !a.separator && (row-touch.has-hover || root.menu-index == idx) ? Theme.hover-fill-strong : transparent;
                        accessible-role: button;
                        accessible-label: a.label != "" ? a.label : a.id;
                        accessible-enabled: !a.disabled && !a.loading && !a.separator;
                        accessible-action-default => {
                            if (!a.disabled && !a.loading && !a.separator) { root.action(a.id); overflow-menu.close(); }
                        }
                        if a.separator : Rectangle { x: 8px; y: 4px; width: parent.width - 16px; height: 1px; background: Theme.separator; }
                        if !a.separator : HorizontalLayout {
                            padding-left: 10px; padding-right: 10px; spacing: 10px;
                            opacity: a.disabled || a.loading ? 0.4 : 1;
                            Icon { commands: a.icon; size: 16px; y: (parent.height - self.height) / 2; tint: a.emphasis == 3 ? Theme.color-danger : Theme.text-secondary; }
                            Text { text: a.label != "" ? a.label : a.id; color: a.emphasis == 3 ? Theme.color-danger : Theme.text-primary; font-size: Theme.fs-body; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                            if a.active : Icon { commands: Icons.check; size: 14px; y: (parent.height - self.height) / 2; tint: Theme.accent; }
                        }
                        row-touch := TouchArea {
                            enabled: !a.disabled && !a.loading && !a.separator;
                            mouse-cursor: pointer;
                            clicked => { root.action(a.id); overflow-menu.close(); }
                        }
                    }
                }
            }
        }
    }
}
