// YBarChip — a pressable chip on the top bar: a coloured dot and a short line of words.
//
// The bar's chips say one live thing each and open the place it is about: "Hermes is working"
// opens Mind View (#1347). The dot carries the colour role (mind-teal for a mind's presence, as
// MindsChip documents; amber stays for "needs you"), and the words carry the meaning, so colour is
// never the only signal. Pressing it is the person's own act. Tab reaches it, Space and Enter
// press it, and a pointer press shows no focus ring.
//
//     YBarChip { text: WorkingState.text; dot: Theme.mind-teal; opens: "Mind View"; clicked => { … } }
//
// The bar's older chips (Minds, mode, notice, recording) still draw their own; they move here next.
import { Theme } from "theme.slint";

export component YBarChip inherits Rectangle {
    in property <string> text: "";
    in property <color> dot: Theme.mind-teal;
    in property <string> opens: "";
    callback clicked();

    property <bool> pointer-focus: false;
    property <bool> ring: keys.has-focus && !root.pointer-focus;

    height: Theme.bar-chip-h;
    width: min(row.preferred-width, 340px);
    border-radius: Theme.bar-chip-radius;
    background: area.pressed ? Theme.hover-fill-strong : area.has-hover ? Theme.hover-fill : transparent;
    animate background { duration: Theme.dur-fast; }
    border-width: root.ring ? Theme.focus-ring-width : Theme.hairline;
    border-color: root.ring ? Theme.focus-ring : Theme.bar-border;
    forward-focus: keys;
    accessible-role: button;
    accessible-label: root.opens == "" ? root.text : root.text + ". Opens " + root.opens;

    keys := FocusScope {
        key-pressed(event) => {
            root.pointer-focus = false;
            if ((event.text == " " || event.text == "\n") && !event.repeat) { root.clicked(); return accept; }
            reject
        }
    }

    area := TouchArea {
        mouse-cursor: pointer;
        pointer-event(event) => {
            if (event.kind == PointerEventKind.down) {
                root.pointer-focus = true;
                keys.focus();
            }
        }
        clicked => { root.clicked(); }
    }

    row := HorizontalLayout {
        padding-left: Theme.sp-3;
        padding-right: Theme.sp-3;
        spacing: Theme.sp-2;
        alignment: center;

        Rectangle {
            width: Theme.bar-chip-dot;
            Rectangle {
                y: (parent.height - self.height) / 2;
                width: Theme.bar-chip-dot;
                height: Theme.bar-chip-dot;
                border-radius: self.height / 2;
                background: root.dot;
            }
        }
        Text {
            text: root.text;
            color: Theme.text-primary;
            font-size: Theme.fs-caption;
            font-weight: Theme.fw-body-strong;
            vertical-alignment: center;
            overflow: elide;
        }
    }
}
