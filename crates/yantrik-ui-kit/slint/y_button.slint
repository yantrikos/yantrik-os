// YButton — the one button.
//
// Kinds (`variant`), exactly three:
//   0 primary      filled accent, dark label. One per group at most.
//   1 secondary    an outline: transparent, 1px outline-border, white label.
//   3 destructive  filled red, white label. Only for what cannot be undone: delete, erase,
//                  power off.
// Any other value draws as secondary, so a stale call site (2 was a quiet "tertiary" kind,
// now retired) still draws something valid. Hover and pressed are neutral steps (a lighter or
// darker fill, a brighter outline), never new colours. Focus keeps the 2px white ring.
// Sizes: 0 compact 28px, 1 regular 32px, 2 prominent 36px.
//
// Icons are stroke paths (`icon-path`, an SVG path on the 20×20 grid from the Icons global),
// drawn by the shared Icon component so they scale and recolour with the label. The old
// single-character `icon` still works for call sites that have not moved yet, but a letter in
// a box is exactly the look this kit exists to retire — prefer the path.
import { Theme } from "theme.slint";
import { Icon } from "icon.slint";

export component YButton inherits Rectangle {
    in property <int> variant: 0;
    in property <int> size: 1;
    in property <string> label: "Button";
    in property <string> icon: "";
    in property <string> icon-path: "";
    // Draw the icon AFTER the label. For the one case that means something: a control that
    // opens a menu, where the chevron is a promise about what happens next rather than a
    // picture of the thing.
    in property <bool> icon-trailing: false;
    in property <bool> disabled: false;
    in property <bool> loading: false;
    in property <bool> icon-only: false;
    // Pointer-only: never takes keyboard focus, so Tab cannot land on it and Enter or Space can
    // never press it, and the accessibility default action (AT-SPI DoDefaultAction, which a
    // screen reader or any same-session process can send with no pointer at all) does nothing
    // either. For the approval card, where the look says which button is the action but nothing
    // may press it except a deliberate click. The cost is that a keyboard-only person cannot
    // answer such a card; that is the spec's choice, and the only non-pointer way to press one
    // used to be the accessibility action, which is closed here on purpose.
    in property <bool> pointer-only: false;
    callback clicked();
    forward-focus: keyboard;
    accessible-role: button;
    accessible-label: root.label;
    accessible-enabled: !root.disabled && !root.loading && !root.pointer-only;
    accessible-action-default => { if (!root.disabled && !root.loading && !root.pointer-only) { root.clicked(); } }

    property <bool> hovered: ta.has-hover && !root.disabled;
    property <bool> pressed: ta.pressed && !root.disabled;
    property <color> fg: root.variant == 0 ? Theme.text-on-accent : root.variant == 3 ? Theme.text-on-destructive : Theme.text-primary;
    property <length> glyph: root.size == 0 ? 13px : 15px;

    height: root.size == 0 ? Theme.h-compact : root.size == 2 ? Theme.h-prominent : Theme.h-regular;
    min-width: root.icon-only ? self.height : 64px;
    // A button is as wide as its label. Rectangle stretches by default, which in a toolbar row
    // makes one button swallow the spare space.
    horizontal-stretch: 0;
    border-radius: Theme.r-md;
    opacity: root.disabled ? 0.4 : 1.0;
    clip: true;

    background:
        root.variant == 3 ? (root.pressed ? Theme.destructive-pressed : root.hovered ? Theme.destructive-hover : Theme.destructive)
      : root.variant != 0 ? (root.pressed ? Theme.hover-fill-strong : root.hovered ? Theme.hover-fill : transparent)
      :                     (root.pressed ? Theme.accent-button-pressed : root.hovered ? Theme.accent-button-hover : Theme.accent);

    border-width: keyboard.has-focus ? 2px : root.variant != 0 && root.variant != 3 ? 1px : 0;
    border-color: keyboard.has-focus ? Theme.focus-ring : root.pressed ? Theme.text-secondary : root.hovered ? Theme.text-dim : Theme.outline-border;

    animate background { duration: Theme.dur-fast; }
    animate opacity { duration: Theme.dur-fast; }

    keyboard := FocusScope {
        enabled: !root.disabled && !root.loading && !root.pointer-only;
        key-pressed(event) => {
            if (event.text == "\n" || event.text == " ") {
                if (!event.repeat && !root.disabled && !root.loading) { root.clicked(); }
                return accept;
            }
            reject
        }
    }

    ta := TouchArea {
        enabled: !root.disabled && !root.loading;
        mouse-cursor: root.disabled ? default : pointer;
        clicked => {
            if (!root.disabled && !root.loading) { if (!root.pointer-only) { keyboard.focus(); } root.clicked(); }
        }
    }

    HorizontalLayout {
        alignment: center;
        spacing: 7px;
        padding-left: root.icon-only ? 0 : (root.size == 0 ? 10px : 12px);
        padding-right: root.icon-only ? 0 : (root.size == 0 ? 10px : 12px);

        if root.loading : Icon {
            commands: "M10 3A7 7 0 0 1 17 10 M17 10A7 7 0 0 1 10 17";
            size: root.glyph;
            tint: root.fg;
            y: (parent.height - self.height) / 2;
        }

        if root.icon-path != "" && !root.icon-trailing && !root.loading : Icon {
            commands: root.icon-path;
            size: root.glyph;
            tint: root.fg;
            thickness: 1.7px;
            y: (parent.height - self.height) / 2;
        }

        if root.icon-path == "" && root.icon != "" && !root.loading : Text {
            text: root.icon;
            color: root.fg;
            font-size: root.size == 0 ? Theme.fs-caption : Theme.fs-body;
            vertical-alignment: center;
        }

        if !root.icon-only : Text {
            text: root.label;
            color: root.fg;
            font-size: root.size == 0 ? Theme.fs-caption : Theme.fs-body;
            font-weight: 500;
            letter-spacing: 0.2px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }

        if root.icon-path != "" && root.icon-trailing && !root.loading : Icon {
            commands: root.icon-path;
            size: root.glyph;
            tint: root.fg;
            thickness: 1.7px;
            y: (parent.height - self.height) / 2;
        }
    }
}

export component YIconButton inherits YButton {
    icon-only: true;
    size: 0;
}
