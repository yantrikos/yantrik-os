// LineChart — reusable real-time chart component.
// Renders a series of data points as a filled area chart with a glowing top edge.
// Uses positioned rectangles (one per data point) since Slint doesn't support
// dynamic Path construction from model data.
//
// Usage:
//   LineChart {
//       title: "CPU";
//       values: [...];  // 0.0-1.0 normalized, last 60 points
//       current-text: "42%";
//       accent-color: Theme.accent;
//   }

import { Theme } from "theme.slint";

export component LineChart inherits Rectangle {
    in property <string> title: "CPU";
    in property <[float]> values: [];
    in property <string> current-text: "0%";
    // The trace's colour: neutral unless the reading is in trouble (the caller passes the danger
    // colour then). `accent-glow` is kept so callers need not change; nothing glows now.
    in property <color> accent-color: Theme.text-secondary;
    in property <color> accent-glow: transparent;

    // On the ground, not in a box of its own (art direction, 20 Oct 2026, G): the label and the
    // value above, the plot under them, three faint gridlines, one 2px trace and a 6% fill. One
    // plain rectangle per sample per layer and no opacity, so it is cheap on software GL.
    property <length> chart-left: 0px;
    property <length> chart-top: 40px;
    property <length> chart-width: root.width;
    property <length> chart-height: root.height - 40px;

    min-height: 140px;
    background: transparent;

    HorizontalLayout {
        x: 0;
        y: 0;
        width: root.width;
        height: 32px;
        alignment: space-between;
        Text {
            text: root.title;
            color: Theme.text-secondary;
            font-size: Theme.fs-body;
            vertical-alignment: center;
        }
        Text {
            text: root.current-text;
            color: root.accent-color == Theme.text-secondary ? Theme.text-primary : root.accent-color;
            font-size: 24px;
            font-weight: 500;
            vertical-alignment: center;
        }
    }

    for f in [0.0, 0.5, 1.0] : Rectangle {
        x: root.chart-left;
        y: root.chart-top + root.chart-height * f - (f == 1.0 ? 1px : 0px);
        width: root.chart-width;
        height: 1px;
        background: Theme.border-structural;
    }

    for val[idx] in root.values : Rectangle {
        x: root.chart-left + (root.chart-width * idx / max(1, root.values.length));
        width: max(1px, root.chart-width / max(1, root.values.length));
        height: max(0px, root.chart-height * clamp(val, 0.0, 1.0));
        y: root.chart-top + root.chart-height - self.height;
        background: root.accent-color.with-alpha(0.06);
    }

    for val[idx] in root.values : Rectangle {
        x: root.chart-left + (root.chart-width * idx / max(1, root.values.length));
        width: max(1px, root.chart-width / max(1, root.values.length));
        height: 2px;
        y: root.chart-top + root.chart-height - max(2px, root.chart-height * clamp(val, 0.0, 1.0));
        background: root.accent-color;
    }
}
