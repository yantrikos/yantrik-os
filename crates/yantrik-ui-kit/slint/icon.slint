    out property <string> compass:    "M3 10A7 7 0 1 0 17 10A7 7 0 1 0 3 10Z M13 7L11.5 11.5L7 13L8.5 8.5Z";

    // Shell / system
    out property <string> home:       "M3 9.5L10 3.5L17 9.5V17H12V12H8V17H3Z";
    out property <string> grid:       "M3 3H8.5V8.5H3Z M11.5 3H17V8.5H11.5Z M3 11.5H8.5V17H3Z M11.5 11.5H17V17H11.5Z";
    out property <string> bolt:       "M11 2.5L4.5 11H9.5L8.5 17.5L15.5 9H10.5Z";
    out property <string> disk:       "M3 10A7 7 0 1 0 17 10A7 7 0 1 0 3 10Z M8 10A2 2 0 1 0 12 10A2 2 0 1 0 8 10Z M10 12V17";
    out property <string> plug:       "M7 3V7 M13 3V7 M5 7H15V10A5 5 0 0 1 5 10Z M10 15V17.5";
    out property <string> shuffle:    "M3 5H6L13 15H17 M3 15H6L8 12 M12 8L13 5H17 M15 3L17 5L15 7 M15 13L17 15L15 17";
    out property <string> skip-back:  "M5 4V16 M16 4L7.5 10L16 16Z";
    out property <string> skip-forward: "M15 4V16 M4 4L12.5 10L4 16Z";
    out property <string> repeat:     "M4 8.5V7A2 2 0 0 1 6 5H15 M13 3L15 5L13 7 M16 11.5V13A2 2 0 0 1 14 15H5 M7 17L5 15L7 13";
    out property <string> volume-off: "M3 7.5H6.5L11 4V16L6.5 12.5H3Z M14 8L18 12 M18 8L14 12";
    out property <string> moon:       "M16 12.5A6.5 6.5 0 0 1 7.5 4A6.5 6.5 0 1 0 16 12.5Z";

    // Map a shell app-id (dock ids, and the ids windows.rs derives from titles) to a glyph.
    // Unknown ids return "" so callers can choose their own fallback; see app-or-window
    // (taskbar: a plain window is honest) and app-or-category (launcher: the category's
    // shape says more about an unknown app than a window does).
    /// The file browser's Rust side classifies entries with one character; map it to a glyph.
    public pure function file-kind(c: string) -> string {
        c == "\u{1F4C1}" ? root.folder
        : c == "\u{25C7}" ? root.code
        : c == "\u{2261}" ? root.doc
        : c == "\u{25A3}" ? root.image
        : c == "\u{266A}" ? root.music
        : c == "\u{25B6}" ? root.play
        : c == "\u{25A4}" ? root.archive
        : c == "\u{25A7}" ? root.doc
        : c == "\u{2699}" ? root.settings
        : root.file
    }

    public pure function app(id: string) -> string {
        return id == "terminal"      ? self.terminal
             : id == "browser"       ? self.browser
             : id == "files"         ? self.files
             : id == "editor"        ? self.editor
             : id == "email"         ? self.mail
             : id == "notes"         ? self.notes
             : id == "system"        ? self.monitor
             : id == "network"       ? self.network
             : id == "packages"      ? self.packages
             : id == "memory"        ? self.chip
             : id == "media"         ? self.media
             : id == "music"         ? self.music
             : id == "weather"       ? self.weather
             : id == "settings"      ? self.settings
             : id == "calendar"      ? self.calendar
             : id == "bond"          ? self.bond
             : id == "notifications" ? self.alerts
             : id == "spreadsheet"   ? self.sheets
             : id == "documents"     ? self.doc
             : id == "presentation"  ? self.present
             : id == "launchpad"     ? self.apps
             : id == "yantrik"       ? self.companion
             // built-in shell screens (ids from shell-core apps.rs)
             : id == "about"         ? self.companion
             : id == "containers"    ? self.packages
             : id == "devices"       ? self.chip
             : id == "downloads"     ? self.download
             : id == "permissions"   ? self.lock
             : id == "personality"   ? self.bond
             : id == "skills"        ? self.skill
             : id == "snippets"      ? self.doc
             : id == "sysmonitor"    ? self.monitor
             : "";
    }

    public pure function app-or-window(id: string) -> string {
        return self.app(id) == "" ? self.window : self.app(id);
    }

    // Category glyphs: one shape per freedesktop main category, for apps the icon theme
    // has nothing for. Ids match icons.rs::CATEGORY_TABLE.
    public pure function category(id: string) -> string {
        return id == "development" ? self.terminal
             : id == "office"      ? self.doc
             : id == "network"     ? self.network
             : id == "audiovideo"  ? self.media
             : id == "graphics"    ? self.window
             : id == "game"        ? self.media
             : id == "system"      ? self.monitor
             : id == "settings"    ? self.settings
             : self.packages;
    }

    public pure function app-or-category(id: string, cat: string) -> string {
        return self.app(id) == "" ? self.category(cat) : self.app(id);
    }
}

export component Icon inherits Path {
    in property <length> size: 16px;
    in property <color> tint: Theme.text-secondary;
    in property <length> thickness: 1.6px;

    width: root.size;
    height: root.size;
    viewbox-x: 0;
    viewbox-y: 0;
    viewbox-width: 20;
    viewbox-height: 20;
    stroke: root.tint;
    stroke-width: root.thickness;
    fill: transparent;
}
