// Icon — stroke icons drawn as native Paths.
//
// The shell has been drawing its icons as single characters ("W", "YS", "◈") because nothing
// in the data model ever carried a real one. This is the cheapest correct fix for the shell's
// OWN chrome: every icon is an SVG path string on a 20×20 grid, rendered by Slint's Path
// element. No image files, no decoder, no icon theme to resolve, and each one recolours from
// a single property. Application launchers still need a real icon theme — that is a data
// model change (AppGridItem / DesktopEntry carry only `icon-char`) and is not solved here.
//
// Draw rules, so the set reads as one family: 20×20 viewbox, 1.6px stroke, no fills, round
// shapes as two arcs, and nothing closer than 2px to the edge.

import { Theme } from "theme.slint";

export global Icons {
    // ── shell / taskbar ──
    out property <string> apps:     "M2.5 2.5H8.5V8.5H2.5Z M11.5 2.5H17.5V8.5H11.5Z M2.5 11.5H8.5V17.5H2.5Z M11.5 11.5H17.5V17.5H11.5Z";
    out property <string> search:   "M3 9A6 6 0 1 0 15 9A6 6 0 1 0 3 9Z M13.5 13.5L17 17";
    out property <string> window:   "M2.5 3.5H17.5V16.5H2.5Z M2.5 7H17.5";
