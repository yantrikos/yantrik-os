// YEmptyState — what a view says when it has nothing to show.
//
// A stroke glyph in a tinted circle, a title, one sentence, and at most two actions. No emoji:
// an empty inbox is not a party.
import { Theme } from "theme.slint";
import { Icon, Icons } from "icon.slint";
import { YButton } from "y_button.slint";

export component YEmptyState inherits Rectangle {
    in property <string> icon: "";
    in property <string> icon-path: Icons.packages;
    in property <string> title: "Nothing here yet";
    in property <string> description: "";
    in property <string> action-label: "";
    in property <string> secondary-label: "";
    callback action-clicked();
    callback secondary-clicked();

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: Theme.sp-3;
        padding: Theme.sp-9;

        HorizontalLayout {
            alignment: center;
            Rectangle {
                width: 56px;
                height: 56px;
                border-radius: 28px;
                background: Theme.tint-accent;
                Icon {
                    commands: root.icon-path;
                    size: 26px;
                    tint: Theme.accent;
                    thickness: 1.5px;
                    x: (parent.width - self.width) / 2;
                    y: (parent.height - self.height) / 2;
                }
            }
        }

        Text {
            text: root.title;
            color: Theme.text-primary;
            font-size: Theme.fs-title-2;
            font-weight: Theme.fw-title-2;
            horizontal-alignment: center;
        }

        if root.description != "" : Text {
            text: root.description;
            color: Theme.text-secondary;
            font-size: Theme.fs-body;
            horizontal-alignment: center;
            wrap: word-wrap;
            max-width: 360px;
        }

        if root.action-label != "" : HorizontalLayout {
            alignment: center;
            spacing: Theme.sp-2;
            padding-top: Theme.sp-1;

            YButton {
                label: root.action-label;
                variant: 0;
                clicked => { root.action-clicked(); }
            }

            if root.secondary-label != "" : YButton {
                label: root.secondary-label;
                variant: 2;
                clicked => { root.secondary-clicked(); }
            }
        }
    }
}
