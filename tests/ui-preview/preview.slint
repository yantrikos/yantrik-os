    }
}

import { JumpToPresent } from "jump_to_present.slint";
import { ListView } from "std-widgets.slint";
// A transcript under JumpToPresent, for verify-jump-to-present.
export component JumpProbe inherits Window {
    width: 480px; height: 400px; background: Theme.bg-deep;
    in property <int> rows: 5;
    in-out property <length> list-y <=> list.viewport-y;
    out property <length> list-h: list.viewport-height;
    out property <bool> following: follow.following;
    out property <bool> missed: follow.missed;
    out property <bool> at-bottom: follow.at-bottom;
    list := ListView {
        width: 100%;
        height: 100%;
        for i in root.rows : Rectangle {
            height: 40px;
            Text { text: "line " + i; color: Theme.text-primary; x: 12px; vertical-alignment: center; }
        }
    }
    follow := JumpToPresent {
        width: 100%;
        height: 100%;
        viewport-y <=> list.viewport-y;
        viewport-height: list.viewport-height;
        visible-height: list.visible-height;
    }
}

// The context rail beside an app body, the way every app lays it out: a long context list must
// scroll inside the rail, never make the window lay out taller than it is.
import { AgentRail } from "components/agent_rail.slint";
export component RailProbe inherits Window {
    width: 900px; height: 500px; background: Theme.bg-deep;
    in property <[AgentContextItem]> context: [];
    in property <[AgentSuggestion]> next: [];
    out property <length> body-h: body.height;
    out property <length> rail-h: rail.height;
    VerticalLayout {
        Rectangle { height: 40px; background: Theme.bg-surface; }
        HorizontalLayout {
            body := Rectangle { horizontal-stretch: 1; background: Theme.bg-card; }
            rail := AgentRail { context-items: root.context; suggestions: root.next; }
        }
    }
}

