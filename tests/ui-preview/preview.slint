}

// The System Monitor screen (#220), filled with fixture data by src/monitor_tests.rs: bars whose
// fills must start at the left edge of their track, a process list that must not move when a row
// is selected, what the list says when a filter matched nothing, and what the AI card says when
// nothing feeds it. Callbacks are recorded there, never acted on.
import { SystemMonitor, CpuCoreData, DiskData, MonitorProcessData } from "system_monitor.slint";
export { CpuCoreData, DiskData, MonitorProcessData } from "system_monitor.slint";
export component SystemMonitorProbe inherits Window {
    in property <length> canvas-width: 1280px;
    in property <length> canvas-height: 800px;
    width: root.canvas-width;
    height: root.canvas-height;
    default-font-family: Theme.font-ui;
    background: Theme.bg-deep;
    in property <[CpuCoreData]> cores;
    in property <[DiskData]> disks;
    in property <[MonitorProcessData]> procs;
    in-out property <string> search;
    in-out property <int> selected-pid: -1;
    in-out property <string> ai-model-name;
    // Mirrored out of the screen so the test can see the geometry the person sees.
    out property <length> health-fill-x: monitor.health-fill-x;
    out property <length> swap-fill-x: monitor.swap-fill-x;
    out property <length> swap-fill-width: monitor.swap-fill-width;
    out property <length> core-fill-x: monitor.core-fill-x;
    out property <length> core-fill-width: monitor.core-fill-width;
    out property <length> disk-fill-x: monitor.disk-fill-x;
    out property <length> disk-fill-width: monitor.disk-fill-width;
    out property <length> proc-header-height: monitor.proc-header-height;
    out property <length> proc-search-y: monitor.proc-search-y;
    out property <string> process-empty-text: monitor.process-empty-text;
    out property <string> ai-no-source-text: monitor.ai-no-source-text;
    monitor := SystemMonitor {
        width: 100%;
        height: 100%;
        show-back: false;
        cpu-usage: 62.0;
        cpu-model: "Fixture CPU @ 3.6 GHz";
        cpu-cores: root.cores;
        memory-usage: 55.0;
        memory-used-text: "8.4 GB";
        memory-total-text: "16.0 GB";
        memory-available-text: "7.6 GB";
        swap-usage: 42.0;
        swap-used-text: "0.9 GB";
        swap-total-text: "2.0 GB";
        disks: root.disks;
        processes: root.procs;
        process-search <=> root.search;
        selected-process-pid <=> root.selected-pid;
        ai-model-name: root.ai-model-name;
        health-score: 60.0;
        health-status: "Degraded";
        health-summary: "High CPU usage";
        uptime-text: "3 h 12 m";
        kill-process(pid) => { root.selected-pid = pid; }
        force-kill-process(pid) => { root.selected-pid = pid; }
    }
}

// The Weather dashboard at the app's own default window size (#220), filled with fixture data by
// src/weather_tests.rs. The running app fills the agent rail's context, so the rail is open —
// 280px — at 1000×720, which is exactly where the hero's stat tiles used to run under it.
import { WeatherDashboard, WeatherCurrent, WeatherHourly, WeatherDaily } from "weather.slint";
export { WeatherCurrent, WeatherHourly, WeatherDaily } from "weather.slint";
import { AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
export { AgentContextItem, AgentSuggestion } from "components/agent_rail.slint";
export component WeatherProbe inherits Window {
    in property <length> canvas-width: 1000px;
    in property <length> canvas-height: 720px;
    width: root.canvas-width;
    height: root.canvas-height;
    default-font-family: Theme.font-ui;
    background: Theme.bg-deep;
    in property <WeatherCurrent> current;
    in property <[WeatherHourly]> hourly;
    in property <[WeatherDaily]> daily;
    in property <[AgentContextItem]> agent-context;
    in property <string> hourly-tz-label;
    // The hero geometry, mirrored out of the dashboard for the same reason.
    out property <length> hero-row-width: dash.hero-row-width;
    out property <length> hero-tiles-x: dash.hero-tiles-x;
    out property <length> hero-tiles-width: dash.hero-tiles-width;
    out property <length> hero-tiles-abs-right: dash.hero-tiles-abs-right;
    out property <length> content-space-right: dash.content-space-right;
    out property <length> hourly-tz-width: dash.hourly-tz-width;
    out property <length> hero-tile-width: dash.hero-tile-width;
    out property <bool> rail-shown: dash.rail-shown;
    dash := WeatherDashboard {
        width: 100%;
        height: 100%;
        show-back: false;
        current: root.current;
        hourly: root.hourly;
        daily: root.daily;
        agent-context: root.agent-context;
        hourly-tz-label: root.hourly-tz-label;
        weather-last-updated: "Updated 4 min ago";
    }
}

// ── Text Editor (#328) ──────────────────────────────────────────────────────

import { TextEditorApp } from "../../apps/text-editor/ui/app.slint";

// The production editor window with the very document from the crash report on it: the
// software renderer casts every glyph coordinate to i16, and this file — plus the bigger
// ones the VM had open beside it — used to abort the window mid-draw. It must render, not
// panic. The runner fills `content`, `numbers` and `line-count` from the repro fixture.
export component EditorProbe inherits TextEditorApp {
    title: "build_briefing.py — Editor";
    tabs: [{ title: "build_briefing.py", active: true, modified: false }];
    document-title: "build_briefing.py";
    path-label: "/tmp/build_briefing.py";
    language: "Python";
    // Declared here, not inherited: the Rust API of a derived component exposes the properties
    // it declares itself, so the runner fills these and they feed the editor's own inputs.
    in property <string> repro-content;
    in property <string> repro-numbers;
    in property <int> repro-lines;
    content: root.repro-content;
    numbers: root.repro-numbers;
    line-count: root.repro-lines;
}

// ── Installer (#400) ────────────────────────────────────────────────────────

import { InstallerScreen, InstallerDisk, KeyboardChoice } from "installer.slint";

// The production installer screens with fixture disks and layouts. The rules behind every
// field are the production ones: the runner wires these callbacks to installer_rules.rs,
// included by path. What the screens hand the shell is recorded instead of installing.
export component InstallerProbe inherits Window {
    in property <length> canvas-width: 1280px;
    in property <length> canvas-height: 800px;
    width: root.canvas-width; height: root.canvas-height;
    default-font-family: Theme.font-ui;
    background: Theme.bg-deep;

    in-out property <int> step: 0;
    in property <[KeyboardChoice]> keyboards;
    in-out property <string> keyboard: "us";
    in-out property <bool> keyboard-open: false;
    in-out property <string> full-name;
    in-out property <string> username;
    in-out property <string> password;
    in-out property <string> password-confirm;
    in-out property <string> hostname: "yantrik";
    in-out property <bool> username-touched;
    in-out property <bool> hostname-touched;
    in property <[InstallerDisk]> disks;
    in property <bool> disks-scanned: true;
    in-out property <string> selected-disk;
    in-out property <string> timezone;
    in-out property <bool> installing;
    in-out property <int> install-progress;
    in-out property <string> install-status;
    in-out property <string> install-error;
    out property <bool> you-ok: screen.you-ok;
    out property <bool> can-install: screen.can-install;

    // What the screens asked of the shell.
    in-out property <string> chosen-layout;
    in-out property <bool> tried;
    in-out property <string> installed-with;
    in-out property <int> reboots;

    pure callback derive-username(string) -> string;
    pure callback hostname-for(string) -> string;
    pure callback check-full-name(string) -> string;
    pure callback check-username(string) -> string;
    pure callback check-hostname(string) -> string;
    pure callback check-password(string, string) -> string;
    pure callback check-timezone(string) -> string;

    screen := InstallerScreen {
        width: 100%; height: 100%;
        step <=> root.step;
        keyboards: root.keyboards;
        keyboard <=> root.keyboard;
        keyboard-open <=> root.keyboard-open;
        keyboard-chosen(code) => { root.chosen-layout = code; }
        try-first => { root.tried = true; }
        full-name <=> root.full-name;
        username <=> root.username;
        password <=> root.password;
        password-confirm <=> root.password-confirm;
        hostname <=> root.hostname;
        username-touched <=> root.username-touched;
        hostname-touched <=> root.hostname-touched;
        disks: root.disks;
        disks-scanned: root.disks-scanned;
        selected-disk <=> root.selected-disk;
        timezone <=> root.timezone;
        installing <=> root.installing;
        install-progress <=> root.install-progress;
        install-status <=> root.install-status;
        install-error <=> root.install-error;
        install-to-disk(u, p, f, h, k, t, d) => {
            root.installed-with = u + "|" + f + "|" + h + "|" + k + "|" + t + "|" + d;
        }
        reboot => { root.reboots += 1; }
        derive-username(n) => { return root.derive-username(n); }
        hostname-for(u) => { return root.hostname-for(u); }
        check-full-name(n) => { return root.check-full-name(n); }
        check-username(u) => { return root.check-username(u); }
        check-hostname(h) => { return root.check-hostname(h); }
        check-password(p, c) => { return root.check-password(p, c); }
        check-timezone(t) => { return root.check-timezone(t); }
    }
}

// Settings → Decision model (components/decision_model.slint), filled with fixture data by
