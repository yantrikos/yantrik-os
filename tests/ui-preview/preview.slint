import { DecisionModelCard, DecisionPreset, DecisionUse } from "components/decision_model.slint";
export component DecisionProbe inherits Window {
    in property <length> canvas-width: 720px;
    in property <length> canvas-height: 780px;
    width: root.canvas-width; height: root.canvas-height; background: Theme.bg-deep;
    in property <[DecisionPreset]> presets;
    in property <[DecisionUse]> uses;
    in-out property <string> provider: "kev";
    in property <string> endpoint: "http://192.168.4.20:8009";
    in property <string> model: "kev-latest";
    in property <string> status;
    in property <bool> status-good;
    in property <string> where-note;
    in property <bool> leaves;
    in-out property <string> action;
    VerticalLayout {
        padding: 24px;
        alignment: start;
        DecisionModelCard {
            presets: root.presets; provider: root.provider; endpoint: root.endpoint; model: root.model;
            key-env: ""; uses: root.uses;
            where-note: root.where-note; leaves-machine: root.leaves;
            status: root.status; status-good: root.status-good;
            choose(id) => { root.action = "choose:" + id; }
            save(e, m, k) => { root.action = "save:" + e; }
            test => { root.action = "test"; }
            toggle-use(id) => { root.action = "use:" + id; }
        }
    }
}

