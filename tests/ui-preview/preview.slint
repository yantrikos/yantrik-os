import { RecipesScreen } from "recipes.slint";
export { RecipesState, RecipeTabData, RecipeRowData, RecipeStageData, RecipeStepData } from "recipes.slint";
export component RecipesProbe inherits Window {
    in property <length> canvas-width: 1280px;
    in property <length> canvas-height: 800px;
    width: root.canvas-width;
    height: root.canvas-height;
    default-font-family: Theme.font-ui;
    background: Theme.bg-deep;
