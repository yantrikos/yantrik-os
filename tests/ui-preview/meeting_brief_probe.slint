// The meeting brief card (components/meeting_brief_card.slint) on a plain ground, for
// verify-meeting-brief: one card by itself at the width the desktop gives it, at text scale 1.0 and
// 1.5, and the stack the desktop draws, inside a box of fixed height. src/meeting_brief_tests.rs
// drives it.
import { Theme, TextScale } from "theme.slint";
import { MeetingBriefCard, MeetingBriefData, MeetingBriefStack } from "components/meeting_brief_card.slint";

export component MeetingBriefProbe inherits Window {
    width: 420px;
    height: 900px;
    background: #204060;
    default-font-family: Theme.font-ui;
    in property <float> scale: 1.0;
    changed scale => { TextScale.factor = root.scale; }
    in property <MeetingBriefData> data;
    out property <length> card-height: one.height;
    out property <length> buttons-bottom: one.buttons-bottom;
    one := MeetingBriefCard { x: 20px; y: 20px; width: 340px; data: root.data; }
    MeetingBriefStack { x: 20px; y: 640px; width: 340px; height: 240px; }
}

// The stack alone, in the box the desktop gives it (560px), for the check that its title and its
// buttons are inside the box at any text scale, and that two cards are drawn only when both fit.
export component MeetingBriefStackProbe inherits Window {
    width: 420px;
    height: 900px;
    background: #204060;
    default-font-family: Theme.font-ui;
    in property <float> scale: 1.0;
    changed scale => { TextScale.factor = root.scale; }
    out property <length> title-y: stack.title-y;
    out property <length> buttons-bottom: stack.buttons-bottom;
    out property <bool> two: stack.two;
    stack := MeetingBriefStack { x: 20px; y: 100px; width: 340px; height: 560px; }
}
