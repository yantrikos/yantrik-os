// The real email client with the composer open over a prepared draft that carries a file, for
// verify-email-compose. The header alone in a pane of its own width did not test what the person
// sees: the compose pane is what is left of the window after the 220px folder column and the 340px
// list, so Send is measured in that pane.
import { EmailClient } from "email.slint";

export component EmailComposeProbe inherits Window {
    width: 1280px;
    height: 800px;
    in property <string> status: "";
    out property <length> pane-right: client.compose-pane-right;
    out property <length> buttons-right: client.compose-buttons-right;
    // The least width the window can be made, as the layout says it.
    out property <length> least-width: root.min-width;
    client := EmailClient {
        width: root.width;
        height: root.height;
        is-composing: true;
        composing-prepared: true;
        prepared-file: "/home/user/Documents/Q4-deck.ydeck";
        email-draft-status: root.status;
    }
}
